---
// src/pages/admin/prices.astro (Instant Sub-second Price Update Portal)
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Admin Live Price Manager — GulshanHotels">
  <div class="min-h-screen bg-slate-900 text-slate-100 py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-xl mx-auto bg-slate-800 border border-slate-700 rounded-3xl p-6 sm:p-8 shadow-2xl space-y-6 text-left">
      
      <!-- Header -->
      <div class="border-b border-slate-700 pb-4">
        <span class="text-xs font-black uppercase text-emerald-400 tracking-widest block">Instant Cloudflare KV Sync</span>
        <h1 class="text-2xl sm:text-3xl font-black font-serif text-white mt-1">Live Price Manager</h1>
        <p class="text-xs text-slate-400 mt-1">Update hotel rates in 0.1 seconds globally without rebuilding site.</p>
      </div>

      <!-- Form -->
      <form id="priceManagerForm" class="space-y-4 text-xs sm:text-sm">
        
        <!-- Secret Admin Passcode -->
        <div>
          <label class="block text-slate-300 font-extrabold uppercase text-[11px] mb-1">Admin Passcode</label>
          <input 
            type="password" 
            id="adminPasscode" 
            required 
            placeholder="Enter passcode (default: admin2026)" 
            class="w-full bg-slate-900 border border-slate-700 rounded-xl p-3 text-white focus:outline-none focus:border-emerald-500 transition"
          />
        </div>

        <!-- Hotel Name -->
        <div>
          <label class="block text-slate-300 font-extrabold uppercase text-[11px] mb-1">Hotel Name / Title</label>
          <input 
            type="text" 
            id="targetHotel" 
            required 
            placeholder="e.g. The Westin Dhaka or The Midori by Lakeshore" 
            class="w-full bg-slate-900 border border-slate-700 rounded-xl p-3 text-white focus:outline-none focus:border-emerald-500 transition"
          />
        </div>

        <!-- Currency -->
        <div>
          <label class="block text-slate-300 font-extrabold uppercase text-[11px] mb-1">Currency Symbol</label>
          <select id="priceCurrency" class="w-full bg-slate-900 border border-slate-700 rounded-xl p-3 text-white focus:outline-none focus:border-emerald-500 font-bold">
            <option value="$">$ (USD Dollars)</option>
            <option value="৳">৳ (BDT Taka)</option>
          </select>
        </div>

        <!-- Price Inputs Grid -->
        <div class="grid grid-cols-2 gap-3 pt-2">
          <div>
            <label class="block text-slate-300 font-bold text-[11px] mb-1 text-emerald-400">🔴 Agoda Price</label>
            <input type="number" id="priceAgoda" placeholder="e.g. 114" class="w-full bg-slate-900 border border-slate-700 rounded-xl p-3 text-white focus:outline-none focus:border-emerald-500" />
          </div>

          <div>
            <label class="block text-slate-300 font-bold text-[11px] mb-1 text-blue-400">🔵 Booking.com Price</label>
            <input type="number" id="priceBooking" placeholder="e.g. 120" class="w-full bg-slate-900 border border-slate-700 rounded-xl p-3 text-white focus:outline-none focus:border-emerald-500" />
          </div>

          <div>
            <label class="block text-slate-300 font-bold text-[11px] mb-1 text-yellow-400">🟡 Expedia Price</label>
            <input type="number" id="priceExpedia" placeholder="e.g. 125" class="w-full bg-slate-900 border border-slate-700 rounded-xl p-3 text-white focus:outline-none focus:border-emerald-500" />
          </div>

          <div>
            <label class="block text-slate-300 font-bold text-[11px] mb-1 text-emerald-300">🏨 Direct Hotel Price</label>
            <input type="number" id="priceDirect" placeholder="e.g. 110" class="w-full bg-slate-900 border border-slate-700 rounded-xl p-3 text-white focus:outline-none focus:border-emerald-500" />
          </div>
        </div>

        <!-- Submit Button -->
        <div class="pt-4">
          <button 
            type="submit" 
            id="savePriceBtn" 
            class="w-full bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-black uppercase tracking-wider py-3.5 rounded-xl shadow-lg transition cursor-pointer text-xs"
          >
            Save Live Prices ⚡ (Instant Sync)
          </button>
        </div>

      </form>

      <!-- Status Alert -->
      <div id="statusAlert" class="hidden p-4 rounded-xl text-xs font-bold text-center"></div>

    </div>
  </div>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const form = document.getElementById('priceManagerForm');
      const passcodeEl = document.getElementById('adminPasscode');
      const hotelEl = document.getElementById('targetHotel');
      const currencyEl = document.getElementById('priceCurrency');
      const agodaEl = document.getElementById('priceAgoda');
      const bookingEl = document.getElementById('priceBooking');
      const expediaEl = document.getElementById('priceExpedia');
      const directEl = document.getElementById('priceDirect');
      const saveBtn = document.getElementById('savePriceBtn');
      const alertEl = document.getElementById('statusAlert');

      // Remember passcode locally in browser
      if (passcodeEl) {
        passcodeEl.value = localStorage.getItem('gh_admin_passcode') || 'admin2026';
      }

      if (form) {
        form.addEventListener('submit', async (e) => {
          e.preventDefault();
          
          const passcode = passcodeEl.value.trim();
          localStorage.setItem('gh_admin_passcode', passcode);

          if (saveBtn) {
            saveBtn.disabled = true;
            saveBtn.innerText = 'Syncing Cloudflare KV...';
          }

          if (alertEl) alertEl.className = 'hidden';

          try {
            const res = await fetch('https://gatlin.rmollah394.workers.dev/api/admin/update-prices', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                passcode: passcode,
                hotel: hotelEl.value.trim(),
                currency: currencyEl.value,
                agoda: agodaEl.value,
                booking: bookingEl.value,
                expedia: expediaEl.value,
                direct: directEl.value
              })
            });

            const json = await res.json();

            if (res.ok && json.success) {
              if (alertEl) {
                alertEl.textContent = '✅ ' + json.message;
                alertEl.className = 'p-4 rounded-xl text-xs font-bold text-center bg-emerald-950 border border-emerald-500/50 text-emerald-300 block';
              }
            } else {
              if (alertEl) {
                alertEl.textContent = '❌ Error: ' + (json.error || 'Failed to update price');
                alertEl.className = 'p-4 rounded-xl text-xs font-bold text-center bg-rose-950 border border-rose-500/50 text-rose-300 block';
              }
            }
          } catch (err) {
            if (alertEl) {
              alertEl.textContent = '❌ Network Error: ' + err.message;
              alertEl.className = 'p-4 rounded-xl text-xs font-bold text-center bg-rose-950 border border-rose-500/50 text-rose-300 block';
            }
          } finally {
            if (saveBtn) {
              saveBtn.disabled = false;
              saveBtn.innerText = 'Save Live Prices ⚡ (Instant Sync)';
            }
          }
        });
      }
    });
  </script>
</Layout>
