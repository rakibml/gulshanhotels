---
// src/layouts/PageLayout.astro (Clean & Readable Standard Page Template)
import Layout from './Layout.astro';

interface Props {
  title: string;
  description?: string;
  date?: string;
}

const { 
  title, 
  description = "Official information, legal terms, and policies of GulshanHotels.com", 
  date = "Oct 2026" 
} = Astro.props;

// Google WebPage Schema
const pageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": title,
  "description": description,
  "url": Astro.url.href
};
---

<Layout title={`${title} — GulshanHotels.com`} description={description}>
  
  <script type="application/ld+json" set:html={JSON.stringify(pageSchema)} />

  <main class="w-full bg-white text-slate-900 pt-8 pb-20">
    <div class="max-w-[760px] mx-auto px-4 sm:px-6 space-y-8 text-left">
      
      <!-- BREADCRUMBS -->
      <nav class="flex items-center gap-2 text-xs font-semibold text-slate-400">
        <a href="/" class="hover:text-emerald-800 transition">Home</a>
        <span>/</span>
        <span class="text-slate-800 truncate">{title}</span>
      </nav>

      <!-- PAGE HEADER -->
      <header class="space-y-3 border-b border-slate-100 pb-6">
        <h1 class="font-serif text-3xl sm:text-4xl lg:text-[42px] font-black text-slate-900 tracking-tight leading-tight">
          {title}
        </h1>
        {description && (
          <p class="text-sm sm:text-base text-slate-600 font-normal leading-relaxed">
            {description}
          </p>
        )}
        <div class="text-[11px] font-semibold text-slate-400 pt-1">
          Last Updated: <span class="text-slate-700">{date}</span>
        </div>
      </header>

      <!-- PAGE CONTENT (18px Golden Ratio Typography) -->
      <div class="prose prose-slate max-w-none text-[17px] sm:text-[18px] leading-[1.8] font-normal text-slate-700 prose-headings:font-serif prose-headings:font-black prose-headings:text-slate-900 prose-p:mb-6 prose-a:text-emerald-800 prose-a:font-bold hover:prose-a:underline">
        <slot />
      </div>

    </div>
  </main>

</Layout>
