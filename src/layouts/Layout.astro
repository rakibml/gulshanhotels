---
// src/components/Logo.astro
// <Logo animate uid="hd" size={42} />  -> header (plays intro once per browser session)
// <Logo uid="ft" size={48} />          -> footer (always static)
interface Props {
  animate?: boolean;
  uid?: string;      // must be unique per instance on the page (SVG gradient ids)
  size?: number;     // icon height in px; text scales with it
  subtitle?: boolean;
}
const { animate = false, uid = 'gh', size = 44, subtitle = true } = Astro.props;
const arch = "M13.6 77 V42 C13.6 23 24 14 42 14 H68 C75 14 80 14.2 82 16 C77 23 68 27 58 27 H44 C33 27 27.2 33 27.2 46 V78.5 Z";
const wins = [
  [40.3, 44.5, 4.5, 7], [48, 41.5, 4, 7], [40.3, 54.5, 4.5, 7],
  [48, 51.5, 4, 7], [55.8, 51.5, 4, 7], [48, 62.5, 4, 7],
  [70.3, 52, 3, 5.5], [70.3, 62, 3, 5.5],
];
---

<span class:list={['gh-logo', { 'gh-anim': animate }]} style={`--s:${size}px`}>
  <svg class="gh-mark" viewBox="0 0 100 100" aria-hidden="true" focusable="false">
    <defs>
      <linearGradient id={`${uid}-r`} x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#f6454b" /><stop offset="1" stop-color="#d6212b" />
      </linearGradient>
      <linearGradient id={`${uid}-n`} x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#34478f" /><stop offset="1" stop-color="#1a2552" />
      </linearGradient>
    </defs>
    <rect class="t" width="100" height="100" rx="22" fill={`url(#${uid}-r)`} />
    <path class="ol" pathLength="1" d={arch} />
    <path class="ar" d={arch} fill={`url(#${uid}-n)`} />
    <g class="bd">
      <path d="M35.7 78.5V42.4L54 34L66 40V78.5Z M67.5 40L76 43.5V78.5H67.5Z" fill={`url(#${uid}-n)`} />
      <rect x="31" y="77.4" width="50" height="1.8" fill={`url(#${uid}-n)`} />
      {wins.map(([x, y, w, h], i) => (
        <rect class="w" x={x} y={y} width={w} height={h} style={`--i:${i}`} />
      ))}
    </g>
    <circle class="dt" cx="85" cy="71" r="7" fill={`url(#${uid}-n)`} />
  </svg>
  <span class="gh-text">
    <span class="gh-word">Gulshan<b>Hotels</b>.com</span>
    {subtitle && <span class="gh-sub">Dhaka • Bangladesh</span>}
  </span>
</span>

<style is:global>
  .gh-logo{display:inline-flex;align-items:center;gap:calc(var(--s)*.26);line-height:1;white-space:nowrap}
  .gh-mark{width:var(--s);height:var(--s);flex:none;overflow:visible}
  .gh-text{display:flex;flex-direction:column;align-items:flex-start;text-align:left}
  .gh-word{font-weight:800;font-size:calc(var(--s)*.5);letter-spacing:-.03em;color:#0f172a}
  .gh-word b{color:#e8333a;font-weight:800}
  .gh-sub{font-size:calc(var(--s)*.2);letter-spacing:.2em;font-weight:800;color:#475569;margin-top:calc(var(--s)*.12);text-transform:uppercase}
  .gh-mark .w{fill:#e8333a}
  .gh-mark .ol{fill:none;stroke:#34478f;stroke-width:1;stroke-dasharray:1;opacity:0}
  .gh-mark .t,.gh-mark .ar,.gh-mark .bd,.gh-mark .dt{transform-box:fill-box}
  .gh-mark .t{transform-origin:50% 50%}
  .gh-mark .bd{transform-origin:50% 100%}
  @media (max-width:420px){.gh-logo{--s:34px!important}}

  /* intro: only when <html class="gh-intro"> was set by the head script (first view of the session) */
  .gh-intro .gh-anim .ol{animation:ghDraw 1.3s ease-in-out .1s both}
  .gh-intro .gh-anim .ar{animation:ghFade .5s ease .8s both}
  .gh-intro .gh-anim .bd{animation:ghRise .8s cubic-bezier(.16,1,.3,1) 1s both}
  .gh-intro .gh-anim .w{animation:ghWin 1.2s ease calc(1.5s + var(--i)*.08s) both}
  .gh-intro .gh-anim .t{animation:ghPop .7s cubic-bezier(.16,1,.3,1) 2s both}
  .gh-intro .gh-anim .dt{animation:ghDrop .7s cubic-bezier(.3,1.6,.5,1) 2.8s both}
  .gh-intro .gh-anim .gh-word{animation:ghWipe .9s cubic-bezier(.16,1,.3,1) 2.2s both}
  .gh-intro .gh-anim .gh-sub{animation:ghFade .6s ease 3s both}

  @keyframes ghDraw{0%{opacity:1;stroke-dashoffset:1}70%{opacity:1;stroke-dashoffset:0}100%{opacity:0;stroke-dashoffset:0}}
  @keyframes ghFade{from{opacity:0}to{opacity:1}}
  @keyframes ghRise{from{transform:scaleY(0)}to{transform:scaleY(1)}}
  @keyframes ghWin{0%{fill:#fff}35%{fill:#ffd27a}100%{fill:#e8333a}}
  @keyframes ghPop{from{opacity:0;transform:scale(.2)}to{opacity:1;transform:scale(1)}}
  @keyframes ghDrop{from{opacity:0;transform:translateY(-40px)}to{opacity:1;transform:translateY(0)}}
  @keyframes ghWipe{from{clip-path:inset(0 100% 0 0)}to{clip-path:inset(0 0 0 0)}}

  @media (prefers-reduced-motion:reduce){.gh-intro .gh-anim *{animation:none!important}}
</style>
