---
// src/layouts/Layout.astro
import '../styles/global.css';

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body class="bg-[#090E13] font-sans text-slate-100 antialiased min-h-screen flex flex-col justify-between pt-16">
		
		<!-- Section 1: Smart Hide-on-Scroll Header -->
		<header id="main-header" class="bg-[#0C1217]/95 backdrop-blur-md text-white fixed top-0 left-0 right-0 z-50 border-b border-[#D4AF37]/25 shadow-xl transition-transform duration-300">
			<div class="max-w-[1550px] mx-auto px-4 sm:px-8 lg:px-12 py-3 flex justify-between items-center">
				
				<!-- Logo -->
				<a href="/" class="flex items-center space-x-3 group">
					<div class="shrink-0 p-0.5">
						<svg class="w-8 h-8 sm:w-10 sm:h-10 text-[#D4AF37] group-hover:scale-105 transition-transform" viewBox="0 0 100 100" fill="none" stroke="currentColor">
							<path d="M50 6 L88 27 L88 73 L50 94 L12 73 L12 27 Z" stroke-width="6" stroke-linecap="round" stroke-linejoin="round"/>
							<path d="M50 20 L76 35 L76 65 L50 80 L24 65 L24 35 Z" stroke-width="5" stroke-linecap="round" stroke-linejoin="round"/>
							<path d="M76 50 L50 50 L50 65 L65 65" stroke-width="5" stroke-linecap="round" stroke-linejoin="round"/>
						</svg>
					</div>
					<div class="flex flex-col">
						<span class="text-xl sm:text-2xl font-black tracking-tight text-white leading-none">
							GULSHAN<span class="text-[#D4AF37]">HOTELS</span>
						</span>
						<span class="text-[9px] sm:text-[10px] text-[#E8D8B0]/70 tracking-[0.2em] font-extrabold uppercase mt-1">
							DHAKA • BANGLADESH
						</span>
					</div>
				</a>

				<!-- Desktop Navigation Menu -->
				<nav class="hidden lg:flex items-center space-x-8 text-xs font-black tracking-wider uppercase text-[#E8D8B0]">
					<a href="/" class="text-[#D4AF37] font-extrabold transition border-b-2 border-[#D4AF37] pb-0.5">HOME</a>
					<a href="/#hotels" class="hover:text-[#D4AF37] transition">HOTELS IN GULSHAN</a>
					<a href="/#hotels" class="hover:text-[#D4AF37] transition">HOTEL DEALS</a>
					<a href="/about" class="hover:text-[#D4AF37] transition">AREAS GUIDE</a>
					<a href="/about" class="hover:text-[#D4AF37] transition">BLOG</a>
					<a href="/about" class="hover:text-[#D4AF37] transition">CONTACT</a>
				</nav>

				<!-- Right Options -->
				<div class="flex items-center space-x-3">
					<button id="wishlist-btn" class="relative text-[#E8D8B0] hover:text-[#D4AF37] transition p-2 rounded-full hover:bg-slate-900 focus:outline-none cursor-pointer">
						<svg class="w-5 h-5 sm:w-6 sm:h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path></svg>
						<span id="wishlist-count" class="absolute -top-1 -right-1 bg-red-600 text-white text-[10px] font-black w-4 h-4 rounded-full flex items-center justify-center hidden">0</span>
					</button>

					<button id="mobile-menu-btn" class="lg:hidden text-[#E8D8B0] hover:text-[#D4AF37] p-2 rounded-lg focus:outline-none cursor-pointer">
						<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path></svg>
					</button>
				</div>

			</div>

			<!-- Mobile Menu Drawer -->
			<div id="mobile-menu" class="hidden lg:hidden bg-[#0C1217] border-t border-[#D4AF37]/20 px-6 py-5 space-y-3 font-black text-xs uppercase tracking-wider text-[#E8D8B0]">
				<a href="/" class="block text-[#D4AF37] py-1">HOME</a>
				<a href="/#hotels" class="block py-1 hover:text-[#D4AF37]">HOTELS IN GULSHAN</a>
				<a href="/#hotels" class="block py-1 hover:text-[#D4AF37]">HOTEL DEALS</a>
				<a href="/about" class="block py-1 hover:text-[#D4AF37]">AREAS GUIDE</a>
				<a href="/about" class="block py-1 hover:text-[#D4AF37]">BLOG</a>
				<a href="/about" class="block py-1 hover:text-[#D4AF37]">CONTACT</a>
			</div>
		</header>

		<!-- Interactive Wishlist Modal Drawer -->
		<div id="wishlist-modal" class="fixed inset-0 bg-slate-950/80 backdrop-blur-sm z-50 hidden transition-opacity">
			<div class="fixed right-0 top-0 bottom-0 w-full max-w-md bg-[#0C1217] border-l border-[#D4AF37]/30 p-6 shadow-2xl overflow-y-auto flex flex-col justify-between text-slate-100">
				<div>
					<div class="flex justify-between items-center border-b border-slate-800 pb-4">
						<h3 class="text-lg font-black text-[#D4AF37] uppercase tracking-wider flex items-center space-x-2">
							<svg class="w-5 h-5 text-red-500 fill-red-500" viewBox="0 0 24 24"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>
							<span>Saved Favorites</span>
						</h3>
						<button id="close-wishlist" class="text-slate-400 hover:text-white p-1 text-2xl font-bold cursor-pointer">&times;</button>
					</div>

					<div id="wishlist-items" class="py-6 space-y-4 text-xs text-slate-300">
						<p class="text-center text-slate-400 py-8">No saved hotels yet. Click the heart icon on any hotel card to add it to your favorites!</p>
					</div>
				</div>

				<div class="border-t border-slate-800 pt-4">
					<a href="/#hotels" class="block w-full bg-[#D4AF37] hover:bg-amber-400 text-slate-950 font-black text-xs uppercase tracking-wider py-3 rounded-xl text-center transition">
						Explore Gulshan Hotels
					</a>
				</div>
			</div>
		</div>

		<!-- Scripts -->
		<script is:inline>
			document.addEventListener('DOMContentLoaded', () => {
				let lastScrollY = window.scrollY;
				const header = document.getElementById('main-header');

				window.addEventListener('scroll', () => {
					if (!header) return;
					const currentScrollY = window.scrollY;

					if (currentScrollY > lastScrollY && currentScrollY > 80) {
						header.classList.add('-translate-y-full');
					} else {
						header.classList.remove('-translate-y-full');
					}
					lastScrollY = currentScrollY;
				});

				const btn = document.getElementById('mobile-menu-btn');
				const menu = document.getElementById('mobile-menu');
				if (btn && menu) {
					btn.addEventListener('click', () => {
						menu.classList.toggle('hidden');
					});
				}

				const wishlistBtn = document.getElementById('wishlist-btn');
				const wishlistModal = document.getElementById('wishlist-modal');
				const closeWishlist = document.getElementById('close-wishlist');

				if (wishlistBtn && wishlistModal) {
					wishlistBtn.addEventListener('click', () => {
						wishlistModal.classList.remove('hidden');
					});
				}

				if (closeWishlist && wishlistModal) {
					closeWishlist.addEventListener('click', () => {
						wishlistModal.classList.add('hidden');
					});
				}
			});
		</script>

		<!-- Page Main Content -->
		<div class="flex-grow">
			<slot />
		</div>

		<!-- Footer -->
		<footer class="bg-[#06090D] text-slate-400 pt-16 pb-8 border-t border-[#D4AF37]/20 mt-16">
			<div class="max-w-[1550px] mx-auto px-4 sm:px-8 lg:px-12 space-y-12">
				
				<div class="bg-gradient-to-r from-[#0C1217] via-[#0C1217] to-emerald-950/40 p-8 sm:p-10 rounded-3xl border border-[#D4AF37]/30 shadow-2xl flex flex-col md:flex-row justify-between items-center gap-6 text-center md:text-left">
					<div class="space-y-2">
						<div class="flex items-center justify-center md:justify-start space-x-2 text-[#D4AF37]">
							<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
							<span class="text-xs font-black uppercase tracking-widest">Newsletter</span>
						</div>
						<h3 class="text-2xl sm:text-3xl font-black text-white">Get Deals & Updates</h3>
						<p class="text-xs text-slate-300 max-w-md">Subscribe to our newsletter and never miss an exclusive hotel offer in Gulshan.</p>
					</div>

					<div class="w-full md:w-auto flex flex-col sm:flex-row gap-2.5">
						<input 
							type="email" 
							placeholder="Enter your email" 
							class="bg-[#06090D] border border-slate-800 text-white px-5 py-3.5 rounded-xl text-xs focus:outline-none focus:border-[#D4AF37] w-full sm:w-80" 
						/>
						<button class="bg-[#D4AF37] hover:bg-amber-400 text-slate-950 font-black px-8 py-3.5 rounded-xl text-xs uppercase tracking-wider shadow-lg transition cursor-pointer">
							Subscribe
						</button>
					</div>
				</div>

				<div class="grid grid-cols-1 md:grid-cols-4 gap-8 text-center sm:text-left pt-4">
					<div class="space-y-4">
						<a href="/" class="flex items-center justify-center sm:justify-start space-x-3">
							<svg class="w-8 h-8 text-[#D4AF37]" viewBox="0 0 100 100" fill="none" stroke="currentColor">
								<path d="M50 6 L88 27 L88 73 L50 94 L12 73 L12 27 Z" stroke-width="6" stroke-linecap="round" stroke-linejoin="round"/>
								<path d="M50 20 L76 35 L76 65 L50 80 L24 65 L24 35 Z" stroke-width="5" stroke-linecap="round" stroke-linejoin="round"/>
								<path d="M76 50 L50 50 L50 65 L65 65" stroke-width="5" stroke-linecap="round" stroke-linejoin="round"/>
							</svg>
							<span class="text-xl font-black tracking-tight text-white">GULSHAN<span class="text-[#D4AF37]">HOTELS</span></span>
						</a>
						<p class="text-xs text-slate-400 leading-relaxed">
							Your trusted platform to discover, compare, and book the finest luxury and boutique hotels in Gulshan, Dhaka.
						</p>
					</div>

					<div>
						<h4 class="font-black text-white text-xs uppercase tracking-widest mb-4">Quick Links</h4>
						<ul class="space-y-2.5 text-xs text-slate-400">
							<li><a href="/" class="hover:text-[#D4AF37] transition">Home</a></li>
							<li><a href="/#hotels" class="hover:text-[#D4AF37] transition">Hotels in Gulshan</a></li>
							<li><a href="/about" class="hover:text-[#D4AF37] transition">About Us</a></li>
							<li><a href="/about" class="hover:text-[#D4AF37] transition">Contact Us</a></li>
						</ul>
					</div>

					<div>
						<h4 class="font-black text-white text-xs uppercase tracking-widest mb-4">Top Categories</h4>
						<ul class="space-y-2.5 text-xs text-slate-400">
							<li><a href="/#hotels" class="hover:text-[#D4AF37] transition">5-Star Luxury Hotels</a></li>
							<li><a href="/#hotels" class="hover:text-[#D4AF37] transition">Boutique Stays</a></li>
							<li><a href="/#hotels" class="hover:text-[#D4AF37] transition">Business Accommodations</a></li>
							<li><a href="/#hotels" class="hover:text-[#D4AF37] transition">Serviced Apartments</a></li>
						</ul>
					</div>

					<div>
						<h4 class="font-black text-white text-xs uppercase tracking-widest mb-4">Affiliate Disclosure</h4>
						<p class="text-[11px] text-slate-500 leading-relaxed">
							GulshanHotels.com is a participant in official hotel affiliate programs. We earn a small commission when you book through our links at no extra cost to you.
						</p>
					</div>
				</div>

				<div class="pt-8 border-t border-slate-900 text-center text-slate-500 text-[11px] flex flex-col sm:flex-row justify-between items-center gap-2">
					<p>© 2026 Gulshan Hotels. All Rights Reserved.</p>
					<p class="flex items-center gap-1 justify-center">
						<span>Made with</span>
						<svg class="w-3.5 h-3.5 text-red-500 fill-red-500 inline" viewBox="0 0 24 24"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>
						<span>in Bangladesh</span>
					</p>
				</div>

			</div>
		</footer>

	</body>
</html>
