---
// src/layouts/Layout.astro (Redesigned: Quiet Luxury & Modern Architectural Pattern)
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import Header from '../components/Header.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
}

const { 
  title, 
  description = "Discover, compare, and book verified luxury and business hotels in Gulshan, Banani, and Dhaka, Bangladesh.",
  image = "https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&w=1200&q=80"
} = Astro.props;

const currentPath = Astro.url.pathname;
const siteUrl = Astro.url.origin + currentPath;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <script is:inline>
      try { if (!sessionStorage.getItem('gh_intro')) { document.documentElement.classList.add('gh-intro'); sessionStorage.setItem('gh_intro','1'); } } catch(e) {}
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Playfair+Display:ital,wght@0,600;0,700;1,400&display=swap" rel="stylesheet">
    
    <meta name="robots" content="noindex, nofollow" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- PRIMARY SEO META TAGS -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={siteUrl} />

    <!-- OPEN GRAPH -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />

    <!-- TWITTER CARDS -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={siteUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
  </head>

  <body class="bg-[#fafaf8] font-sans text-slate-800 antialiased min-h-screen flex flex-col justify-between selection:bg-[#0d3b23] selection:text-emerald-100">    
    
    <!-- ================= 1. GLOBAL HEADER ================= -->
    <Header currentPath={currentPath} />

    <!-- ================= 2. WISHLIST MODAL DRAWER ================= -->
    <div id="wishlist-modal" role="dialog" aria-modal="true" class="fixed inset-0 bg-slate-950/70 backdrop-blur-md z-50 hidden transition-all duration-300">
      <div class="fixed right-0 top-0 bottom-0 w-full max-w-md bg-white border-l border-stone-200 p-6 sm:p-8 shadow-2xl overflow-y-auto flex flex-col justify-between text-slate-900">
        <div>
          <div class="flex justify-between items-center border-b border-stone-200/80 pb-5">
            <div class="flex items-center gap-2.5">
              <span class="w-8 h-8 rounded-full bg-rose-50 flex items-center justify-center text-rose-500">
                <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>
              </span>
              <div>
                <h3 class="text-base font-extrabold text-[#071910] uppercase tracking-wider">Shortlisted Stays</h3>
                <p class="text-[11px] text-stone-500 font-medium">Saved hotels for your Gulshan trip</p>
              </div>
            </div>
            <button id="close-wishlist" aria-label="Close Favorites" class="w-8 h-8 rounded-full hover:bg-stone-100 flex items-center justify-center text-stone-400 hover:text-stone-900 text-xl font-semibold transition cursor-pointer">&times;</button>
          </div>

          <div id="wishlist-items" class="py-6 space-y-3.5 text-xs text-stone-600">
            <p class="text-center text-stone-400 py-12 text-xs font-medium">No saved hotels yet. Click the heart icon on any hotel card to add it to your shortlist.</p>
          </div>
        </div>

        <div class="border-t border-stone-100 pt-5">
          <a href="/#hotels" class="block w-full bg-[#071910] hover:bg-[#0d3b23] text-white font-bold text-xs uppercase tracking-widest py-3.5 rounded-xl text-center transition-all shadow-lg active:scale-[0.99]">
            Explore Hotel Catalog
          </a>
        </div>
      </div>
    </div>

    <!-- ================= 3. PAGE MAIN CONTENT ================= -->
    <main class="flex-grow">
      <slot />
    </main>

    <!-- ================= 4. NEW ARCHITECTURAL LUXURY FOOTER ================= -->
    <footer class="w-full bg-[#071910] text-stone-300 pt-16 pb-8 border-t border-emerald-950">
      <div class="max-w-[1440px] mx-auto px-6 sm:px-10 lg:px-14">
        
        <!-- TOP ROW: Sleek Minimalist Newsletter Section -->
        <div class="pb-14 border-b border-emerald-900/40 flex flex-col lg:flex-row lg:items-center lg:justify-between gap-8">
          <div class="max-w-xl space-y-2">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-950/70 border border-emerald-800/60 text-[11px] font-bold text-emerald-400 uppercase tracking-widest">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
              Diplomatic Concierge Dispatch
            </div>
            <h3 class="text-2xl sm:text-3xl font-bold text-stone-100 font-serif tracking-tight">
              Curated Hotel Offers in Dhaka’s Diplomatic Core
            </h3>
            <p class="text-xs sm:text-sm text-stone-400 leading-relaxed font-normal">
              Receive embassy stay discounts, long-stay executive suite privileges, and unlisted weekend rates directly in your inbox.
            </p>
          </div>

          <!-- Seamless Newsletter Input -->
          <div class="w-full lg:w-auto min-w-[340px] sm:min-w-[420px]">
            <form id="newsletterForm" class="relative flex items-center bg-stone-900/80 border border-stone-700/70 focus-within:border-emerald-500 rounded-2xl p-1.5 transition-all shadow-inner">
              <input 
                type="email" 
                id="newsletterEmail"
                required
                placeholder="Enter corporate or personal email..." 
                class="bg-transparent text-stone-100 placeholder-stone-500 px-4 py-2.5 text-xs sm:text-sm font-medium focus:outline-none w-full" 
              />
              <button 
                type="submit" 
                id="newsletterBtn" 
                class="bg-emerald-600 hover:bg-emerald-500 text-white font-bold px-6 py-2.5 rounded-xl text-xs uppercase tracking-wider transition-all duration-200 cursor-pointer shrink-0 shadow-md active:scale-95"
              >
                Join
              </button>
            </form>

            <div id="newsletterSuccess" class="hidden text-emerald-300 font-medium text-xs bg-emerald-950/50 p-3 rounded-xl border border-emerald-800 text-center mt-2 flex items-center justify-center gap-2">
              <svg class="w-4 h-4 text-emerald-400 fill-none stroke-current stroke-2 shrink-0" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
              </svg>
              <span>Welcome to our private Gulshan hotel network.</span>
            </div>
            <p class="text-[10px] text-stone-500 mt-2 px-2 text-center lg:text-left">Strictly confidential. No promotional spam. Instant unsubscribe.</p>
          </div>
        </div>

        <!-- MIDDLE ROW: Structured 4-Column Luxury Navigation -->
        <div class="py-14 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-12 gap-10 text-xs sm:text-sm">
          
          <!-- Col 1: Brand & Identity (4 Cols) -->
          <div class="lg:col-span-4 space-y-4 pr-0 lg:pr-6">
            <a href="/" aria-label="GulshanHotels.com" class="inline-block brightness-125">
              <Logo uid="ft-modern" size={44} />
            </a>
            <p class="text-stone-400 text-xs leading-relaxed font-normal">
              Dhaka's dedicated digital directory for verified 5-star, boutique, and diplomatic-grade hospitality across Gulshan, Banani, and Baridhara Enclaves.
            </p>
            <div class="flex items-center gap-3 pt-2 text-stone-400 text-[11px] font-semibold">
              <span class="flex items-center gap-1.5 bg-stone-900 px-2.5 py-1 rounded-md border border-stone-800">
                <svg class="w-3.5 h-3.5 text-emerald-500" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/></svg>
                Verified Listings
              </span>
              <span class="flex items-center gap-1.5 bg-stone-900 px-2.5 py-1 rounded-md border border-stone-800">
                <svg class="w-3.5 h-3.5 text-emerald-500" viewBox="0 0 24 24" fill="currentColor"><path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4z"/></svg>
                Diplomatic Safety
              </span>
            </div>
          </div>

          <!-- Col 2: Districts / Locations (3 Cols) -->
          <div class="lg:col-span-3 space-y-3">
            <h4 class="font-bold text-stone-100 uppercase tracking-widest text-[11px] text-emerald-500 pb-1">
              Prime Enclaves
            </h4>
            <ul class="space-y-2.5 text-stone-300 font-medium text-xs">
              <li>
                <a href="/#hotels" class="hover:text-emerald-400 transition flex items-center justify-between group">
                  <span>Gulshan 1 (Commercial Circle)</span>
                  <span class="text-[10px] text-stone-500 group-hover:text-stone-300">Hub</span>
                </a>
              </li>
              <li>
                <a href="/#hotels" class="hover:text-emerald-400 transition flex items-center justify-between group">
                  <span>Gulshan 2 (Diplomatic Zone)</span>
                  <span class="text-[10px] text-stone-500 group-hover:text-stone-300">Suites</span>
                </a>
              </li>
              <li>
                <a href="/#hotels" class="hover:text-emerald-400 transition flex items-center justify-between group">
                  <span>Near US & German Embassy</span>
                  <span class="text-[10px] text-stone-500 group-hover:text-stone-300">Secure</span>
                </a>
              </li>
              <li>
                <a href="/#hotels" class="hover:text-emerald-400 transition flex items-center justify-between group">
                  <span>Banani Road 11 Boutique Hotels</span>
                  <span class="text-[10px] text-stone-500 group-hover:text-stone-300">Dining</span>
                </a>
              </li>
              <li>
                <a href="/#hotels" class="hover:text-emerald-400 transition flex items-center justify-between group">
                  <span>Baridhara Lakefront Residencies</span>
                  <span class="text-[10px] text-stone-500 group-hover:text-stone-300">Quiet</span>
                </a>
              </li>
            </ul>
          </div>

          <!-- Col 3: Categories & Curations (3 Cols) -->
          <div class="lg:col-span-3 space-y-3">
            <h4 class="font-bold text-stone-100 uppercase tracking-widest text-[11px] text-emerald-500 pb-1">
              Stay Collections
            </h4>
            <ul class="space-y-2.5 text-stone-300 font-medium text-xs">
              <li><a href="/#hotels" class="hover:text-emerald-400 transition">5-Star International Luxury</a></li>
              <li><a href="/#hotels" class="hover:text-emerald-400 transition">Executive Long-Stay Apartments</a></li>
              <li><a href="/#hotels" class="hover:text-emerald-400 transition">Business Transit & Conference Stays</a></li>
              <li><a href="/#hotels" class="hover:text-emerald-400 transition">Rooftop Pool & Infinity Suites</a></li>
              <li><a href="/#hotels" class="hover:text-emerald-400 transition">Verified Visa Interview Stays (IVAC)</a></li>
            </ul>
          </div>

          <!-- Col 4: Corporate & Transparency (2 Cols) -->
          <div class="lg:col-span-2 space-y-3">
            <h4 class="font-bold text-stone-100 uppercase tracking-widest text-[11px] text-emerald-500 pb-1">
              Directory Legal
            </h4>
            <ul class="space-y-2.5 text-stone-300 font-medium text-xs">
              <li><a href="/about" class="hover:text-emerald-400 transition">About Editorial</a></li>
              <li><a href="/about" class="hover:text-emerald-400 transition">Partner With Us</a></li>
              <li><a href="/privacy" class="hover:text-emerald-400 transition">Privacy Statement</a></li>
              <li><a href="/disclaimer" class="hover:text-emerald-400 transition">Disclaimer</a></li>
              <li><a href="/sitemap-index.xml" class="hover:text-emerald-400 transition">XML Sitemap</a></li>
            </ul>
          </div>

        </div>

        <!-- BOTTOM ROW: Clean Metadata & Legal Bar -->
        <div class="pt-8 border-t border-emerald-950 flex flex-col sm:flex-row items-center justify-between gap-4 text-center sm:text-left text-stone-500 text-xs">
          <p>© 2026 GulshanHotels.com. Independently curated for Dhaka diplomatic & executive visitors.</p>
          
          <div class="flex items-center gap-4 text-[11px]">
            <span class="flex items-center gap-1.5">
              <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
              Rates Updated: 2026
            </span>
            <span>•</span>
            <span>Gulshan-2, Dhaka 1212</span>
          </div>
        </div>

      </div>
    </footer>

    <!-- ================= 5. INTERACTIVE CLIENT SCRIPTS ================= -->
    <script is:inline>
      const initLayoutScript = () => {
        let lastScrollY = window.scrollY;
        const header = document.getElementById('main-header');

        window.addEventListener('scroll', () => {
          if (!header) return;
          const currentScrollY = window.scrollY;

          if (currentScrollY > lastScrollY && currentScrollY > 90) {
            header.classList.add('-translate-y-full');
          } else {
            header.classList.remove('-translate-y-full');
          }
          lastScrollY = currentScrollY;
        }, { passive: true });

        const btn = document.getElementById('mobile-menu-btn');
        const menu = document.getElementById('mobile-menu');
        if (btn && menu) {
          btn.addEventListener('click', () => {
            menu.classList.toggle('hidden');
          });
        }

        // Realtime Wishlist LocalStorage Logic
        const wishlistBtn = document.getElementById('wishlist-btn');
        const wishlistModal = document.getElementById('wishlist-modal');
        const closeWishlist = document.getElementById('close-wishlist');
        const wishlistCountEl = document.getElementById('wishlist-count');
        const wishlistItemsEl = document.getElementById('wishlist-items');

        function updateWishlistUI() {
          let list = [];
          try {
            list = JSON.parse(localStorage.getItem('gh_wishlist') || '[]');
          } catch (e) {
            list = [];
          }

          if (wishlistCountEl) {
            if (list.length > 0) {
              wishlistCountEl.textContent = list.length.toString();
              wishlistCountEl.classList.remove('hidden');
            } else {
              wishlistCountEl.classList.add('hidden');
            }
          }

          if (wishlistItemsEl) {
            if (list.length > 0) {
              wishlistItemsEl.innerHTML = list.map((item, idx) => `
                <div class="flex items-center justify-between p-3 rounded-xl border border-stone-200 bg-stone-50/70 hover:bg-stone-50 transition">
                  <div class="flex items-center gap-3">
                    <img src="${item.image || 'https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&w=120&q=80'}" alt="${item.title}" class="w-12 h-12 object-cover rounded-lg shadow-sm" />
                    <div>
                      <h4 class="font-bold text-slate-900 text-xs">${item.title || 'Hotel'}</h4>
                      <span class="text-[10px] font-bold text-emerald-800">${item.price || 'Rates on inquiry'}</span>
                    </div>
                  </div>
                  <div class="flex items-center gap-2">
                    <a href="${item.url || '#'}" class="bg-[#071910] text-white text-[10px] font-bold px-3 py-1.5 rounded-lg hover:bg-emerald-800 transition">View</a>
                    <button class="remove-wishlist-item text-stone-400 hover:text-rose-600 font-bold text-base px-1.5 cursor-pointer" data-index="${idx}">&times;</button>
                  </div>
                </div>
              `).join('');

              wishlistItemsEl.querySelectorAll('.remove-wishlist-item').forEach(btn => {
                btn.addEventListener('click', () => {
                  const idx = parseInt(btn.getAttribute('data-index') || '0', 10);
                  list.splice(idx, 1);
                  localStorage.setItem('gh_wishlist', JSON.stringify(list));
                  updateWishlistUI();
                });
              });
            } else {
              wishlistItemsEl.innerHTML = `<p class="text-center text-stone-400 py-12 text-xs font-medium">No saved hotels yet. Click the heart icon on any hotel card to add it to your shortlist.</p>`;
            }
          }
        }

        if (wishlistBtn && wishlistModal) {
          wishlistBtn.addEventListener('click', () => {
            updateWishlistUI();
            wishlistModal.classList.remove('hidden');
          });
        }

        if (closeWishlist && wishlistModal) {
          closeWishlist.addEventListener('click', () => {
            wishlistModal.classList.add('hidden');
          });
        }

        // Newsletter API Interactivity
        const newsForm = document.getElementById('newsletterForm');
        const newsSuccess = document.getElementById('newsletterSuccess');
        if (newsForm && newsSuccess) {
          newsForm.addEventListener('submit', async (e) => {
            e.preventDefault();
            const email = document.getElementById('newsletterEmail')?.value || '';
            
            try {
              await fetch('https://gatlin.rmollah394.workers.dev/api/newsletter', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ email: email })
              });
            } catch (err) {}

            newsForm.classList.add('hidden');
            newsSuccess.classList.remove('hidden');
          });
        }

        updateWishlistUI();
      };

      document.addEventListener('DOMContentLoaded', initLayoutScript);
      document.addEventListener('astro:page-load', initLayoutScript);
    </script>
  </body>
</html>
