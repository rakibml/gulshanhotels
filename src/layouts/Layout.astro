---
// src/layouts/Layout.astro
import '../styles/global.css';

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
	<head>
<script>
  (function (s, t, a, y, twenty, two) {
    s.Stay22 = s.Stay22 || {};
    s.Stay22.params = { lmaID: '6a6f2f890ba4510dcd28ab5c' };
    twenty = t.createElement(a);
    two = t.getElementsByTagName(a)[0];
    twenty.async = 1;
    twenty.src = y;
    two.parentNode.insertBefore(twenty, two);
  })(window, document, 'script', 'https://scripts.stay22.com/letmeallez.js');
</script>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>

    <!-- Google Luxury & Sans Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,300..800;1,300..800&family=Playfair+Display:ital,wght@0,400..900;1,400..900&display=swap" rel="stylesheet">
	</head>
	<body class="bg-[#f8f9fa] font-['Plus_Jakarta_Sans'] text-slate-800 antialiased min-h-screen flex flex-col justify-between selection:bg-[#d4af37] selection:text-slate-950">
		
		<!-- Slot for Main Page -->
		<div class="flex-grow">
			<slot />
		</div>

		<!-- Footer -->
		<footer class="bg-[#081220] text-slate-400 py-12 border-t border-slate-800 text-sm">
			<div class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
				
				<!-- Logo & Socials -->
				<div class="flex flex-col md:flex-row items-center justify-between gap-6 pb-8 border-b border-slate-800">
					<a href="/" class="flex items-center gap-3">
						<div class="w-10 h-10 rounded-full border border-[#d4af37] flex items-center justify-center text-[#d4af37] font-serif font-black text-xl">
							G
						</div>
						<div class="flex flex-col text-left">
							<span class="text-xl font-black font-serif tracking-widest text-white leading-none">GULSHAN</span>
							<span class="text-[9px] text-[#d4af37] tracking-[0.25em] font-bold uppercase mt-1">HOTELS</span>
						</div>
					</a>

					<p class="text-xs text-slate-400 max-w-md text-center md:text-left">
						Your trusted platform to discover and book the finest hotels in Gulshan, Dhaka.
					</p>

					<!-- Social Icons -->
					<div class="flex items-center gap-3">
						<a href="#" class="w-9 h-9 rounded-full bg-slate-900 border border-slate-700 hover:border-[#d4af37] text-slate-300 hover:text-[#d4af37] flex items-center justify-center text-xs transition">f</a>
						<a href="#" class="w-9 h-9 rounded-full bg-slate-900 border border-slate-700 hover:border-[#d4af37] text-slate-300 hover:text-[#d4af37] flex items-center justify-center text-xs transition">📷</a>
						<a href="#" class="w-9 h-9 rounded-full bg-slate-900 border border-slate-700 hover:border-[#d4af37] text-slate-300 hover:text-[#d4af37] flex items-center justify-center text-xs transition">▶</a>
						<a href="#" class="w-9 h-9 rounded-full bg-slate-900 border border-slate-700 hover:border-[#d4af37] text-slate-300 hover:text-[#d4af37] flex items-center justify-center text-xs transition">in</a>
						<a href="#" class="w-9 h-9 rounded-full bg-slate-900 border border-slate-700 hover:border-[#d4af37] text-slate-300 hover:text-[#d4af37] flex items-center justify-center text-xs transition">🐦</a>
					</div>
				</div>

				<!-- Quick Links -->
				<div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-xs text-slate-400 text-left">
					<div>
						<h4 class="font-bold text-white uppercase tracking-wider mb-3">Quick Links</h4>
						<ul class="space-y-2">
							<li><a href="#all-hotels" class="hover:text-[#d4af37] transition">All Hotels</a></li>
							<li><a href="#featured" class="hover:text-[#d4af37] transition">Featured Stays</a></li>
							<li><a href="#attractions" class="hover:text-[#d4af37] transition">Gulshan Attractions</a></li>
						</ul>
					</div>
					<div>
						<h4 class="font-bold text-white uppercase tracking-wider mb-3">Top Destinations</h4>
						<ul class="space-y-2">
							<li><a href="#all-hotels" class="hover:text-[#d4af37] transition">Gulshan 1</a></li>
							<li><a href="#all-hotels" class="hover:text-[#d4af37] transition">Gulshan 2</a></li>
							<li><a href="#all-hotels" class="hover:text-[#d4af37] transition">Diplomatic Zone</a></li>
						</ul>
					</div>
					<div>
						<h4 class="font-bold text-white uppercase tracking-wider mb-3">Support</h4>
						<ul class="space-y-2">
							<li><a href="/contact" class="hover:text-[#d4af37] transition">24/7 Concierge</a></li>
							<li><a href="/contact" class="hover:text-[#d4af37] transition">FAQ</a></li>
							<li><a href="/contact" class="hover:text-[#d4af37] transition">Privacy Policy</a></li>
						</ul>
					</div>
					<div>
						<h4 class="font-bold text-white uppercase tracking-wider mb-3">Contact Us</h4>
						<p class="text-slate-400 leading-relaxed">Gulshan Avenue, Gulshan 2, Dhaka, Bangladesh.</p>
					</div>
				</div>

				<!-- Bottom Copyright -->
				<div class="pt-8 border-t border-slate-800/80 flex flex-col sm:flex-row items-center justify-between text-[11px] text-slate-500 gap-2">
					<p>© 2026 Gulshan Hotels. All Rights Reserved.</p>
					<p>Made with ❤️ in Bangladesh</p>
				</div>

			</div>
		</footer>

	</body>
</html>
