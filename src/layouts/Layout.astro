---
// src/layouts/Layout.astro (Global Layout — 100% SEO & Indexing Ready)
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import Header from '../components/Header.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
  canonical?: string;
  noindex?: boolean;
}

const { 
  title, 
  description = "Discover, compare, and book luxury and business hotels in Gulshan, Banani, and Dhaka, Bangladesh.",
  image = "https://media.gulshanhotels.com/hotels%20in%20gulsha-1.webp",
  canonical,
  noindex = false // ডিফল্টভাবে ইনডেক্সিং চালু থাকবে (false = index allowed)
} = Astro.props;

// নিশ্চিত সাইট অরিজিন ও ক্যানোনিকাল URL
const siteOrigin = Astro.site ? Astro.site.origin : 'https://gulshanhotels.com';
const canonicalUrl = canonical || new URL(Astro.url.pathname, siteOrigin).href;

// সোশ্যাল প্রিভিউ ইমেজের জন্য সম্পূর্ণ নিরাপদ অ্যাবসোলিউট URL
const ogImage = image.startsWith('http') ? image : new URL(image, siteOrigin).href;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
<script async src="https://www.googletagmanager.com/gtm.js?id=GTM-T6T96S6H"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
</script>
    <meta charset="UTF-8" />
    <script is:inline>
      try { 
        if (!sessionStorage.getItem('gh_intro')) { 
          document.documentElement.classList.add('gh-intro'); 
          sessionStorage.setItem('gh_intro','1'); 
        } 
      } catch(e) {}
    </script>
    
    <!-- ফন্ট ও ইমেজ CDN প্রিকানেক্ট (Speed & Web Vitals Optimization) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="preconnect" href="https://media.gulshanhotels.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    
    <!-- 🎯 গুগল ইনডেক্সিং ওপেন করা হলো (স্বাভাবিকভাবে সব পেজ ইনডেক্স হবে) -->
    {noindex ? (
      <meta name="robots" content="noindex, nofollow" />
    ) : (
      <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    )}
    
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- PRIMARY SEO META TAGS -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- OPEN GRAPH / FACEBOOK / WHATSAPP PREVIEW -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content="GulshanHotels.com" />

    <!-- TWITTER CARDS -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
  </head>
  <body class="bg-white font-sans text-slate-800 antialiased min-h-screen flex flex-col justify-between selection:bg-emerald-800 selection:text-white">    
    
    <!-- GLOBAL HEADER -->
    <Header currentPath={Astro.url.pathname} />

    <!-- INTERACTIVE WISHLIST MODAL DRAWER -->
    <div id="wishlist-modal" role="dialog" aria-modal="true" aria-labelledby="wishlistModalTitle" class="fixed inset-0 bg-slate-950/80 backdrop-blur-sm z-50 hidden transition-opacity">
      <div id="wishlistDrawerContent" class="fixed right-0 top-0 bottom-0 w-full max-w-md bg-white border-l border-slate-200 p-6 shadow-2xl overflow-y-auto flex flex-col justify-between text-slate-900 text-left">
        <div>
          <div class="flex justify-between items-center border-b border-slate-100 pb-4">
            <h3 id="wishlistModalTitle" class="text-lg font-black text-[#0d3b23] uppercase tracking-wider flex items-center space-x-2">
              <svg aria-hidden="true" class="w-5 h-5 text-rose-500 fill-rose-500" viewBox="0 0 24 24"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>
              <span>Saved Favorites</span>
            </h3>
            <button id="close-wishlist" type="button" aria-label="Close Favorites" class="text-slate-400 hover:text-slate-900 p-1 text-2xl font-bold cursor-pointer transition active:scale-90">&times;</button>
          </div>

          <div id="wishlist-items" class="py-6 space-y-4 text-xs text-slate-600">
            <p class="text-center text-slate-500 py-8">No saved hotels yet. Click the heart icon on any hotel card to add it to your favorites!</p>
          </div>
        </div>

        <div class="border-t border-slate-100 pt-4">
          <a href="/#hotels" class="block w-full bg-[#0d3b23] hover:bg-emerald-900 text-white font-black text-xs uppercase tracking-wider py-3.5 rounded-xl text-center transition shadow-md">
            Explore Gulshan Hotels
          </a>
        </div>
      </div>
    </div>

    <!-- PAGE MAIN CONTENT -->
    <main id="main-content" class="flex-grow">
      <slot />
    </main>

    <!-- GLOBAL MODERN FOOTER -->
    <footer class="w-full bg-white text-slate-900 pt-4 pb-8 text-center sm:text-left text-xs sm:text-sm">
      <div class="max-w-[1550px] mx-auto px-4 sm:px-8 lg:px-12 space-y-12">
        
        <!-- NEWSLETTER BANNER (100% WCAG Accessible & Google E-E-A-T Compliant) -->
        <div class="bg-[#0d3b23] p-7 sm:p-10 rounded-3xl border border-emerald-800/80 flex flex-col md:flex-row justify-between items-center gap-6 text-center md:text-left text-white shadow-sm">
          <div class="space-y-2">
            <div class="flex items-center justify-center md:justify-start gap-2 text-emerald-300">
              <svg aria-hidden="true" class="w-4 h-4 fill-current shrink-0" viewBox="0 0 24 24">
                <path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/>
              </svg>
              <span class="text-[11px] font-black uppercase tracking-[0.2em]">VIP Travel Dispatch</span>
            </div>

            <h3 class="text-2xl sm:text-3xl font-black text-white font-serif tracking-tight">
              Get Exclusive Deals & Updates
            </h3>

            <p class="text-xs sm:text-sm text-emerald-100/85 max-w-md leading-relaxed font-normal">
              Subscribe to receive secret price drops, embassy stay alerts, and diplomatic hotel offers in Gulshan.
            </p>
          </div>

          <div class="w-full md:w-auto">
            <form id="newsletterForm" class="flex flex-col sm:flex-row gap-2.5">
              <input 
                type="email" 
                name="email"
                id="newsletterEmail" 
                required
                autocomplete="email"
                aria-label="Email address for hotel deals newsletter"
                placeholder="Enter your email address..." 
                class="bg-black/25 border border-white/20 text-white placeholder-emerald-100/50 px-5 py-3.5 rounded-xl text-xs sm:text-sm font-medium focus:outline-none focus:border-white w-full sm:w-80 transition" 
              />
              
              <button 
                type="submit" 
                id="newsletterBtn" 
                class="bg-white hover:bg-emerald-50 text-slate-950 font-black px-7 py-3.5 rounded-xl text-xs sm:text-sm uppercase tracking-wider transition cursor-pointer shrink-0 active:scale-95"
              >
                Subscribe
              </button>
            </form>

            <!-- E-E-A-T ট্রাস্ট মাইক্রোকপি -->
            <p class="text-[11px] text-emerald-200/70 mt-2 text-center md:text-left">
              Zero spam. Unsubscribe anytime. Read our <a href="/privacy/" class="underline hover:text-white">Privacy Policy</a>.
            </p>

            <div id="newsletterSuccess" class="hidden text-emerald-200 font-bold text-xs sm:text-sm bg-black/30 p-3.5 rounded-xl border border-emerald-400/40 text-center mt-2.5 flex items-center justify-center gap-2">
              <svg aria-hidden="true" class="w-4 h-4 text-emerald-400 fill-none stroke-current stroke-[2.5] shrink-0" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
              </svg>
              <span>Thank you! You have been subscribed to exclusive Gulshan hotel deals.</span>
            </div>
          </div>
        </div>

        <!-- 4-Column Modern SEO Footer Links -->
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-8 text-center sm:text-left pt-2">
          
          <!-- Col 1: Brand -->
          <div class="space-y-3">
            <a href="/" aria-label="GulshanHotels.com home" class="inline-block">
              <Logo uid="ft" size={48} />
            </a>
            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed font-medium pt-1">
              An independent guide to hotels in Gulshan, Dhaka. Find hotel details, approximate prices and area tips to plan your stay. Bookings are made directly with the hotel or its booking partners.
            </p>
          </div>

          <!-- Col 2: Area Guides -->
          <div class="space-y-3">
            <h4 class="font-black text-slate-900 uppercase tracking-wider text-xs sm:text-sm border-b border-slate-200 pb-2">Area Guides</h4>
            <ul class="space-y-2 text-slate-600 text-xs sm:text-sm font-semibold">
              <li><a href="/hotels-in-gulshan-1/" class="hover:text-emerald-800 transition">Hotels in Gulshan 1</a></li>
              <li><a href="/hotels-in-gulshan-2/" class="hover:text-emerald-800 transition">Hotels in Gulshan 2</a></li>
              <li><a href="/blog/" class="hover:text-emerald-800 transition">Travel Guides & Tips</a></li>
            </ul>
          </div>

          <!-- Col 3: Direct Concierge & Partner Desk -->
          <div class="space-y-3">
            <h4 class="font-black text-slate-900 uppercase tracking-wider text-xs sm:text-sm border-b border-slate-200 pb-2">Direct Concierge</h4>
            <ul class="space-y-2 text-slate-600 text-xs sm:text-sm font-semibold">
              <li><a href="/contact/" rel="nofollow" class="hover:text-emerald-800 transition">List Your Hotel Property</a></li>
              <li><a href="/contact/" class="hover:text-emerald-800 transition">Rate Verification Request</a></li>
              <li><a href="/#faq" class="hover:text-emerald-800 transition">Traveler FAQs</a></li>
            </ul>
          </div>

          <!-- Col 4: Important & Legal Pages -->
          <div class="space-y-3">
            <h4 class="font-black text-slate-900 uppercase tracking-wider text-xs sm:text-sm border-b border-slate-200 pb-2">Important Pages</h4>
            <ul class="space-y-2 text-slate-600 text-xs sm:text-sm font-semibold">
              <li><a href="/about/" class="hover:text-emerald-800 transition">About Us</a></li>
              <li><a href="/contact/" class="hover:text-emerald-800 transition">Contact Concierge</a></li>
              <li><a href="/privacy/" class="hover:text-emerald-800 transition">Privacy Policy</a></li>
              <li><a href="/disclaimer/" class="hover:text-emerald-800 transition">Disclaimer & Disclosures</a></li>
              <li><a href="/sitemap.xml" class="hover:text-emerald-800 transition">XML Sitemap</a></li>
            </ul>
          </div>

        </div>

        <!-- Copyright Bar -->
        <div class="pt-8 border-t border-slate-200 text-center text-slate-500 text-xs sm:text-sm font-medium">
          <p>© 2026 GulshanHotels.com. All Rights Reserved. Independent Gulshan hotels directory and travel guide.</p>
        </div>

      </div>
    </footer>

    <!-- CLIENT SCRIPTS -->
    <script is:inline>
      const initLayoutScript = () => {
        let lastScrollY = window.scrollY;
        const header = document.getElementById('main-header');

        window.addEventListener('scroll', () => {
          if (!header) return;
          const currentScrollY = window.scrollY;

          if (currentScrollY > lastScrollY && currentScrollY > 80) {
            header.classList.add('-translate-y-full');
          } else {
            header.classList.remove('-translate-y-full');
          }
          lastScrollY = currentScrollY;
        }, { passive: true });

        const btn = document.getElementById('mobile-menu-btn');
        const menu = document.getElementById('mobile-menu');
        if (btn && menu && !btn.dataset.bound) {
          btn.dataset.bound = 'true';
          btn.addEventListener('click', () => {
            const isHidden = menu.classList.toggle('hidden');
            btn.setAttribute('aria-expanded', String(!isHidden));
          });
        }

        // WISHLIST LOGIC
        const wishlistBtn = document.getElementById('wishlist-btn');
        const wishlistModal = document.getElementById('wishlist-modal');
        const closeWishlist = document.getElementById('close-wishlist');
        const wishlistCountEl = document.getElementById('wishlist-count');
        const wishlistItemsEl = document.getElementById('wishlist-items');

        function updateWishlistUI() {
          let list = [];
          try {
            list = JSON.parse(localStorage.getItem('gh_wishlist') || '[]');
          } catch (e) {
            list = [];
          }

          if (wishlistCountEl) {
            if (list.length > 0) {
              wishlistCountEl.textContent = list.length.toString();
              wishlistCountEl.classList.remove('hidden');
            } else {
              wishlistCountEl.classList.add('hidden');
            }
          }

          if (wishlistItemsEl) {
            if (list.length > 0) {
              wishlistItemsEl.innerHTML = list.map((item, idx) => `
                <div class="flex items-center justify-between p-3 rounded-2xl border border-slate-200 bg-slate-50">
                  <div class="flex items-center gap-3">
                    <img src="${item.image || 'https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&w=120&q=80'}" alt="${item.title || 'Hotel'}" width="48" height="48" class="w-12 h-12 object-cover rounded-xl" />
                    <div>
                      <h4 class="font-bold text-slate-900 text-xs">${item.title || 'Hotel'}</h4>
                      <span class="text-[10px] font-bold text-emerald-800">${item.price || 'Check Rates'}</span>
                    </div>
                  </div>
                  <div class="flex items-center gap-2">
                    <a href="${item.url || '#'}" class="bg-[#0d3b23] text-white text-[10px] font-bold px-3 py-1.5 rounded-lg">View</a>
                    <button type="button" class="remove-wishlist-item text-slate-400 hover:text-rose-600 font-bold text-base px-1 cursor-pointer" data-index="${idx}" aria-label="Remove ${item.title}">&times;</button>
                  </div>
                </div>
              `).join('');

              wishlistItemsEl.querySelectorAll('.remove-wishlist-item').forEach(btn => {
                btn.addEventListener('click', () => {
                  const idx = parseInt(btn.getAttribute('data-index') || '0', 10);
                  list.splice(idx, 1);
                  localStorage.setItem('gh_wishlist', JSON.stringify(list));
                  updateWishlistUI();
                  window.dispatchEvent(new CustomEvent('wishlist-updated'));
                });
              });
            } else {
              wishlistItemsEl.innerHTML = `<p class="text-center text-slate-500 py-8">No saved hotels yet. Click the heart icon on any hotel card to add it to your favorites!</p>`;
            }
          }
        }

        const openWishlist = () => {
          updateWishlistUI();
          wishlistModal?.classList.remove('hidden');
          document.body.style.overflow = 'hidden';
        };

        const closeWishlistModal = () => {
          wishlistModal?.classList.add('hidden');
          document.body.style.overflow = '';
        };

        if (wishlistBtn && !wishlistBtn.dataset.bound) {
          wishlistBtn.dataset.bound = 'true';
          wishlistBtn.addEventListener('click', openWishlist);
        }

        if (closeWishlist && !closeWishlist.dataset.bound) {
          closeWishlist.dataset.bound = 'true';
          closeWishlist.addEventListener('click', closeWishlistModal);
        }

        wishlistModal?.addEventListener('click', (e) => {
          if (e.target === wishlistModal) closeWishlistModal();
        });

        window.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && wishlistModal && !wishlistModal.classList.contains('hidden')) {
            closeWishlistModal();
          }
        });

        // NEWSLETTER SUBMISSION
        const newsForm = document.getElementById('newsletterForm');
        const newsSuccess = document.getElementById('newsletterSuccess');
        const newsBtn = document.getElementById('newsletterBtn');

        if (newsForm && !newsForm.dataset.bound) {
          newsForm.dataset.bound = 'true';
          newsForm.addEventListener('submit', async (e) => {
            e.preventDefault();
            const emailInput = document.getElementById('newsletterEmail');
            const email = emailInput?.value || '';
            if (!email) return;

            if (newsBtn) {
              newsBtn.disabled = true;
              newsBtn.innerText = 'Subscribing...';
            }

            try {
              await fetch('https://gatlin.rmollah394.workers.dev/api/newsletter', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ email: email })
              });
            } catch (err) {}

            newsForm.classList.add('hidden');
            newsSuccess?.classList.remove('hidden');
          });
        }

        updateWishlistUI();
      };

      document.addEventListener('DOMContentLoaded', initLayoutScript);
      document.addEventListener('astro:page-load', initLayoutScript);
    </script>
  </body>
</html>
