---
// src/layouts/Layout.astro
import '../styles/global.css';

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body class="bg-slate-50 font-sans text-slate-800 antialiased min-h-screen flex flex-col justify-between">
		
		<!-- Section 1: Fully Responsive Navbar (Desktop + Mobile) -->
		<header class="bg-[#0B1813] text-white sticky top-0 z-50 shadow-lg border-b border-emerald-900/40">
			<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3 flex justify-between items-center">
				
				<!-- Logo -->
				<a href="/" class="flex flex-col">
					<span class="text-xl sm:text-2xl font-black tracking-tight text-white">
						Gulshan<span class="text-emerald-400">Hotels</span>.com
					</span>
					<span class="text-[9px] sm:text-[10px] text-slate-400 tracking-wider -mt-1 font-medium">Find The Best Hotels in Gulshan, Dhaka</span>
				</a>

				<!-- Desktop Navigation Menu -->
				<nav class="hidden lg:flex items-center space-x-7 text-sm font-medium text-slate-200">
					<a href="/" class="text-emerald-400 font-semibold hover:text-emerald-300 transition">Home</a>
					
					<!-- Dropdown: Hotels in Gulshan -->
					<div class="relative group cursor-pointer py-1">
						<span class="flex items-center hover:text-emerald-400 transition">
							Hotels in Gulshan
							<svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
						</span>
						<div class="absolute left-0 mt-2 w-48 bg-slate-900 border border-slate-800 rounded-xl shadow-xl py-2 hidden group-hover:block transition-all">
							<a href="/#hotels" class="block px-4 py-2 text-xs hover:bg-emerald-950 hover:text-emerald-400">5-Star Luxury Hotels</a>
							<a href="/#hotels" class="block px-4 py-2 text-xs hover:bg-emerald-950 hover:text-emerald-400">Boutique Stays</a>
							<a href="/#hotels" class="block px-4 py-2 text-xs hover:bg-emerald-950 hover:text-emerald-400">Budget Accommodations</a>
						</div>
					</div>

					<a href="/#hotels" class="hover:text-emerald-400 transition">Hotel Deals</a>
					
					<!-- Dropdown: Areas Guide -->
					<div class="relative group cursor-pointer py-1">
						<span class="flex items-center hover:text-emerald-400 transition">
							Areas Guide
							<svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
						</span>
						<div class="absolute left-0 mt-2 w-48 bg-slate-900 border border-slate-800 rounded-xl shadow-xl py-2 hidden group-hover:block transition-all">
							<a href="/about" class="block px-4 py-2 text-xs hover:bg-emerald-950 hover:text-emerald-400">Gulshan 1 Guide</a>
							<a href="/about" class="block px-4 py-2 text-xs hover:bg-emerald-950 hover:text-emerald-400">Gulshan 2 Guide</a>
							<a href="/about" class="block px-4 py-2 text-xs hover:bg-emerald-950 hover:text-emerald-400">Diplomatic Zone</a>
						</div>
					</div>

					<a href="/about" class="hover:text-emerald-400 transition">Blog</a>
					<a href="/about" class="hover:text-emerald-400 transition">Contact</a>
				</nav>

				<!-- Right Options & Mobile Toggle Button -->
				<div class="flex items-center space-x-2 sm:space-x-4">
					<!-- Wishlist Heart Icon -->
					<button class="text-slate-300 hover:text-emerald-400 transition p-1.5 rounded-full hover:bg-slate-800">
						<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path></svg>
					</button>

					<!-- Browse Map Button (Desktop) -->
					<a href="/#hotels" class="hidden sm:flex bg-emerald-950 hover:bg-emerald-900 text-emerald-300 border border-emerald-700/60 font-semibold text-xs px-3.5 py-2 rounded-lg transition items-center space-x-1.5">
						<svg class="w-3.5 h-3.5 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7"></path></svg>
						<span>Browse Map</span>
					</a>

					<!-- Mobile 3-Line Hamburger Menu Toggle Button -->
					<button id="mobile-menu-btn" class="lg:hidden text-slate-200 hover:text-emerald-400 p-2 rounded-lg focus:outline-none hover:bg-slate-800">
						<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path></svg>
					</button>
				</div>

			</div>

			<!-- Mobile Menu Drawer with Expandable Accordions -->
			<div id="mobile-menu" class="hidden lg:hidden bg-[#07120E] border-t border-emerald-900/40 px-4 py-4 space-y-2">
				<a href="/" class="block text-emerald-400 font-semibold py-1.5">Home</a>

				<!-- Hotels in Gulshan (Mobile Accordion) -->
				<div class="space-y-1 border-b border-slate-900 pb-1">
					<button id="mobile-hotels-btn" class="w-full flex justify-between items-center text-slate-200 hover:text-emerald-400 py-1.5 text-left font-medium">
						<span>Hotels in Gulshan</span>
						<svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
					</button>
					<div id="mobile-hotels-sub" class="hidden pl-3 space-y-1.5 border-l-2 border-emerald-800 ml-1 py-1">
						<a href="/#hotels" class="block text-xs text-slate-300 hover:text-emerald-400 py-1">➔ 5-Star Luxury Hotels</a>
						<a href="/#hotels" class="block text-xs text-slate-300 hover:text-emerald-400 py-1">➔ Boutique Stays</a>
						<a href="/#hotels" class="block text-xs text-slate-300 hover:text-emerald-400 py-1">➔ Budget Accommodations</a>
					</div>
				</div>

				<a href="/#hotels" class="block text-slate-200 hover:text-emerald-400 py-1.5">Hotel Deals</a>

				<!-- Areas Guide (Mobile Accordion) -->
				<div class="space-y-1 border-b border-slate-900 pb-1">
					<button id="mobile-areas-btn" class="w-full flex justify-between items-center text-slate-200 hover:text-emerald-400 py-1.5 text-left font-medium">
						<span>Areas Guide</span>
						<svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
					</button>
					<div id="mobile-areas-sub" class="hidden pl-3 space-y-1.5 border-l-2 border-emerald-800 ml-1 py-1">
						<a href="/about" class="block text-xs text-slate-300 hover:text-emerald-400 py-1">➔ Gulshan 1 Guide</a>
						<a href="/about" class="block text-xs text-slate-300 hover:text-emerald-400 py-1">➔ Gulshan 2 Guide</a>
						<a href="/about" class="block text-xs text-slate-300 hover:text-emerald-400 py-1">➔ Diplomatic Zone</a>
					</div>
				</div>

				<a href="/about" class="block text-slate-200 hover:text-emerald-400 py-1.5">Blog</a>
				<a href="/about" class="block text-slate-200 hover:text-emerald-400 py-1.5">Contact</a>
				
				<div class="pt-3 border-t border-slate-800">
					<a href="/#hotels" class="w-full bg-emerald-950 hover:bg-emerald-900 text-emerald-300 border border-emerald-700/60 font-semibold text-xs py-2.5 rounded-lg transition flex items-center justify-center space-x-1.5">
						<svg class="w-3.5 h-3.5 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7"></path></svg>
						<span>Browse Map</span>
					</a>
				</div>
			</div>
		</header>

		<!-- Toggle Script for Mobile Hamburger & Submenus -->
		<script is:inline>
			document.addEventListener('DOMContentLoaded', () => {
				const btn = document.getElementById('mobile-menu-btn');
				const menu = document.getElementById('mobile-menu');
				if (btn && menu) {
					btn.addEventListener('click', () => {
						menu.classList.toggle('hidden');
					});
				}

				// Mobile Hotels Submenu Toggle
				const hotelsBtn = document.getElementById('mobile-hotels-btn');
				const hotelsSub = document.getElementById('mobile-hotels-sub');
				if (hotelsBtn && hotelsSub) {
					hotelsBtn.addEventListener('click', () => {
						hotelsSub.classList.toggle('hidden');
					});
				}

				// Mobile Areas Submenu Toggle
				const areasBtn = document.getElementById('mobile-areas-btn');
				const areasSub = document.getElementById('mobile-areas-sub');
				if (areasBtn && areasSub) {
					areasBtn.addEventListener('click', () => {
						areasSub.classList.toggle('hidden');
					});
				}
			});
		</script>

		<!-- Page Main Content -->
		<div class="flex-grow">
			<slot />
		</div>

		<!-- Footer -->
		<footer class="bg-slate-950 text-slate-400 py-8 border-t border-slate-800 text-center text-sm">
			<div class="max-w-7xl mx-auto px-4">
				<p>© 2026 GulshanHotels.com — The Ultimate Accommodation Directory for Gulshan, Dhaka.</p>
			</div>
		</footer>

	</body>
</html>