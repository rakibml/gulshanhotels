---
// src/pages/contact.astro
import Layout from '../layouts/Layout.astro';

const SITE_URL = 'https://gulshanhotels.com';

// about.astro-এর সাথে মিল রেখে একই ইমেইল ও তথ্য ব্যবহার করুন
const CONTACT_EMAIL = 'info@gulshanhotels.com';
const WHATSAPP_NUMBER: string = ''; // ব্যবহার করতে চাইলে about.astro এবং এখানে দু'জায়গাতেই দিন
const COVERAGE_AREA = 'Gulshan 1 & Gulshan 2, Dhaka, Bangladesh';
const LAST_REVIEWED = '2026-11-20';

// Form backend: Web3Forms key (.env ফাইলে PUBLIC_WEB3FORMS_KEY=xxxxxxxx দিন)
const WEB3FORMS_KEY = import.meta.env.PUBLIC_WEB3FORMS_KEY ?? '';

const canonicalUrl = `${SITE_URL}/contact/`;
const pageDescription =
  'Contact GulshanHotels.com to submit a hotel listing, report a rate or detail correction, or ask a question about staying in Gulshan 1 and Gulshan 2, Dhaka.';

const contactSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${SITE_URL}/#website`,
      url: `${SITE_URL}/`,
      name: 'GulshanHotels.com',
      inLanguage: 'en',
      publisher: { '@id': `${SITE_URL}/#organization` },
    },
    {
      '@type': 'Organization',
      '@id': `${SITE_URL}/#organization`,
      name: 'GulshanHotels.com',
      url: `${SITE_URL}/`,
      email: CONTACT_EMAIL,
      contactPoint: {
        '@type': 'ContactPoint',
        contactType: 'customer support',
        email: CONTACT_EMAIL,
        url: canonicalUrl,
        availableLanguage: ['English', 'Bengali'],
      },
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${SITE_URL}/contact/#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE_URL}/` },
        { '@type': 'ListItem', position: 2, name: 'Contact Us', item: canonicalUrl },
      ],
    },
    {
      '@type': 'ContactPage',
      '@id': `${SITE_URL}/contact/#webpage`,
      url: canonicalUrl,
      name: 'Contact Us | GulshanHotels.com',
      description: pageDescription,
      inLanguage: 'en',
      isPartOf: { '@id': `${SITE_URL}/#website` },
      mainEntity: { '@id': `${SITE_URL}/#organization` },
      about: { '@id': `${SITE_URL}/#organization` },
      breadcrumb: { '@id': `${SITE_URL}/contact/#breadcrumb` },
      lastReviewed: LAST_REVIEWED,
      dateModified: LAST_REVIEWED,
    },
  ],
};

const faqs = [
  {
    q: 'How do I list a hotel on GulshanHotels.com?',
    a: 'Select "List My Hotel" in the form above or email us with your hotel name, exact road/block in Gulshan 1 or Gulshan 2, and official website. Listing a hotel is free, and we review submitted details before publishing.',
  },
  {
    q: 'Can I book a hotel directly through this contact form?',
    a: 'No. GulshanHotels.com is an independent hotel directory and guide—we do not process room bookings or take payments. Please book directly with the hotel or through our booking partner (such as Agoda).',
  },
  {
    q: 'How can I report wrong hotel info or outdated rates?',
    a: 'Choose "Report Rate or Info Correction" in the form or send us an email with the hotel name and the detail that needs updating. We will verify it against the hotel’s official information and update the listing.',
  },
  {
    q: 'Is asking a question about Gulshan free?',
    a: 'Yes. If you have a general question about comparing Gulshan 1 and Gulshan 2 areas for your stay, feel free to write to us. Please note we are an informational guide, not a travel agency or transport operator.',
  },
];
---

<Layout
  title="Contact Us | GulshanHotels.com — Hotel Listings & Inquiries"
  description={pageDescription}
>
  <script type="application/ld+json" set:html={JSON.stringify(contactSchema)} />

  <main>
    <!-- Header (about.astro-এর সাথে সামঞ্জস্যপূর্ণ) -->
    <section class="bg-gradient-to-b from-emerald-50/70 to-white">
      <div class="mx-auto max-w-4xl px-4 py-14 text-center sm:px-8 sm:py-20">
        <nav aria-label="Breadcrumb" class="mb-5 flex justify-center text-xs font-medium text-slate-600">
          <ol class="flex items-center gap-2">
            <li><a href="/" class="hover:text-emerald-800 hover:underline">Home</a></li>
            <li aria-hidden="true">/</li>
            <li class="font-semibold text-slate-800" aria-current="page">Contact Us</li>
          </ol>
        </nav>

        <h1 class="text-3xl font-extrabold tracking-tight text-slate-900 sm:text-5xl">
          Contact GulshanHotels.com
        </h1>
        <p class="mx-auto mt-5 max-w-2xl text-base leading-relaxed text-slate-600 sm:text-lg">
          Have a hotel listing to submit, spotted outdated information, or have a general question about staying in Gulshan 1 or Gulshan 2? Write to us below.
        </p>
      </div>
    </section>

    <!-- Contact Channels + Form -->
    <section class="mx-auto max-w-[1150px] px-4 py-12 sm:px-8 sm:py-16">
      <div class="grid grid-cols-1 items-start gap-8 lg:grid-cols-12 lg:gap-12">

        <!-- Left Info Cards -->
        <div class="space-y-4 lg:col-span-5">
          <h2 class="text-xl font-extrabold tracking-tight text-slate-900 sm:text-2xl">
            Direct Contact Details
          </h2>

          {WHATSAPP_NUMBER && (
            <div class="space-y-3 rounded-3xl border border-emerald-900/10 bg-[#f7faf8] p-6">
              <h3 class="text-lg font-bold text-slate-900">WhatsApp</h3>
              <p class="text-sm leading-relaxed text-slate-600">
                For quick listing updates or general inquiries about Gulshan 1 and Gulshan 2 hotels.
              </p>
              <a
                href={`https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent('Hi! I am writing from GulshanHotels.com.')}`}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 rounded-full bg-[#0d3b23] px-5 py-2.5 text-xs font-bold uppercase tracking-wider text-white transition hover:bg-[#061e14]"
              >
                <span>Message on WhatsApp</span>
                <span aria-hidden="true">&rarr;</span>
              </a>
            </div>
          )}

          <div class="space-y-2 rounded-3xl border border-slate-200 bg-white p-6">
            <h3 class="text-base font-bold text-slate-900">Editorial &amp; Support Email</h3>
            <p class="text-sm leading-relaxed text-slate-600">
              For hotel submissions, rate or detail corrections, and general inquiries.
            </p>
            <a
              href={`mailto:${CONTACT_EMAIL}`}
              class="mt-1 inline-block text-sm font-bold text-emerald-800 underline-offset-2 hover:underline"
            >
              {CONTACT_EMAIL}
            </a>
          </div>

          <div class="space-y-2 rounded-3xl border border-slate-200 bg-white p-6">
            <h3 class="text-base font-bold text-slate-900">Guide Coverage</h3>
            <p class="text-sm leading-relaxed text-slate-600">{COVERAGE_AREA}</p>
            <p class="text-xs font-medium text-slate-600">
              Typical email reply time: within 24–48 hours.
            </p>
            <p class="pt-1 text-xs text-slate-600">
              Want to know how we verify listings and earn affiliate commissions? Read our{' '}
              <a href="/about/#how-we-work" class="font-semibold text-emerald-800 underline-offset-2 hover:underline">
                About &amp; Editorial Process
              </a>.
            </p>
          </div>
        </div>

        <!-- Right Form -->
        <div class="rounded-3xl border border-slate-200 bg-white p-6 sm:p-10 lg:col-span-7">
          <div class="mb-6 space-y-1 border-b border-slate-100 pb-4">
            <h2 class="text-2xl font-extrabold tracking-tight text-slate-900">Send a Message</h2>
            <p class="text-sm text-slate-600">
              Select a topic below so we can review your message quickly.
            </p>
          </div>

          <form
            id="contactInquiryForm"
            class="space-y-4"
            novalidate
            data-key={WEB3FORMS_KEY}
            data-email={CONTACT_EMAIL}
            data-whatsapp={WHATSAPP_NUMBER}
          >
            <!-- Honeypot -->
            <input type="text" name="botcheck" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />

            <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
              <div>
                <label for="contactName" class="mb-1.5 block text-xs font-bold uppercase tracking-wider text-slate-700">
                  Your Name
                </label>
                <input
                  type="text"
                  id="contactName"
                  name="name"
                  required
                  autocomplete="name"
                  placeholder="Your full name"
                  class="w-full rounded-xl border border-slate-200 bg-slate-50 p-3 text-sm font-medium text-slate-900 outline-none focus:border-emerald-700"
                />
              </div>

              <div>
                <label for="contactEmail" class="mb-1.5 block text-xs font-bold uppercase tracking-wider text-slate-700">
                  Email Address
                </label>
                <input
                  type="email"
                  id="contactEmail"
                  name="email"
                  required
                  autocomplete="email"
                  placeholder="you@example.com"
                  class="w-full rounded-xl border border-slate-200 bg-slate-50 p-3 text-sm font-medium text-slate-900 outline-none focus:border-emerald-700"
                />
              </div>
            </div>

            <div>
              <label for="contactTopic" class="mb-1.5 block text-xs font-bold uppercase tracking-wider text-slate-700">
                Inquiry Type
              </label>
              <select
                id="contactTopic"
                name="topic"
                class="w-full rounded-xl border border-slate-200 bg-slate-50 p-3 text-sm font-semibold text-slate-800 outline-none focus:border-emerald-700"
              >
                <option value="Hotel Listing">List My Hotel on GulshanHotels.com (Free)</option>
                <option value="Data Correction">Report Rate or Info Correction</option>
                <option value="Traveler Question">General Question About Staying in Gulshan</option>
                <option value="General Inquiry">Partnership or Other Inquiry</option>
              </select>
            </div>

            <div>
              <label for="contactPhone" class="mb-1.5 block text-xs font-bold uppercase tracking-wider text-slate-700">
                Phone / WhatsApp (Optional)
              </label>
              <input
                type="tel"
                id="contactPhone"
                name="phone"
                autocomplete="tel"
                placeholder="+8801..."
                class="w-full rounded-xl border border-slate-200 bg-slate-50 p-3 text-sm font-medium text-slate-900 outline-none focus:border-emerald-700"
              />
            </div>

            <div>
              <label for="contactMessage" class="mb-1.5 block text-xs font-bold uppercase tracking-wider text-slate-700">
                Your Message
              </label>
              <textarea
                id="contactMessage"
                name="message"
                rows="4"
                required
                placeholder="Share your hotel details, the correction needed, or your question..."
                class="w-full rounded-xl border border-slate-200 bg-slate-50 p-3 text-sm font-medium leading-relaxed text-slate-900 outline-none focus:border-emerald-700"
              ></textarea>
            </div>

            <p
              id="contactErrorMsg"
              class="hidden rounded-xl border border-red-200 bg-red-50 p-4 text-xs font-semibold text-red-800"
              role="alert"
            ></p>

            <button
              type="submit"
              id="submitContactBtn"
              class="flex w-full cursor-pointer items-center justify-center gap-2 rounded-full bg-[#0d3b23] py-3.5 text-sm font-bold text-white shadow-sm transition hover:bg-[#061e14] disabled:cursor-not-allowed disabled:opacity-60"
            >
              <span id="submitBtnLabel">Send Message</span>
              <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M13 6l6 6-6 6" />
              </svg>
            </button>

            <p class="text-center text-xs text-slate-600">
              We only use your contact details to reply to your message. Read our{' '}
              <a href="/privacy/" class="font-semibold text-emerald-800 underline-offset-2 hover:underline">Privacy Policy</a>
              {' '}and{' '}
              <a href="/disclaimer/" class="font-semibold text-emerald-800 underline-offset-2 hover:underline">Disclaimer</a>.
            </p>
          </form>

          <div
            id="contactSuccessMsg"
            class="mt-4 hidden space-y-1 rounded-2xl border border-emerald-200 bg-emerald-50 p-6 text-center text-sm text-emerald-950"
            role="status"
          >
            <p class="text-2xl font-bold text-emerald-800">&#10003;</p>
            <p class="font-bold text-emerald-900">Message Sent Successfully</p>
            <p class="text-xs text-slate-700">
              Thank you for writing to GulshanHotels.com. We will review your message and reply by email soon.
            </p>
          </div>
        </div>

      </div>
    </section>

    <!-- FAQ Section (সঠিক H2 > H3 কাঠামো ও সৎ উত্তর) -->
    <section class="bg-slate-50">
      <div class="mx-auto max-w-[1150px] px-4 py-14 sm:px-8 sm:py-16">
        <div class="mb-8 space-y-1">
          <p class="text-xs font-bold uppercase tracking-widest text-emerald-800">Frequently Asked</p>
          <h2 class="text-2xl font-extrabold tracking-tight text-slate-900 sm:text-3xl">
            Contact &amp; Listing Questions
          </h2>
        </div>

        <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
          {faqs.map((item) => (
            <div class="space-y-2 rounded-3xl border border-slate-200 bg-white p-6">
              <h3 class="text-base font-bold text-slate-900">{item.q}</h3>
              <p class="text-sm leading-relaxed text-slate-600">{item.a}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  </main>

  <script>
    function initContactForm() {
      const form = document.getElementById('contactInquiryForm') as HTMLFormElement | null;
      if (!form || form.dataset.bound === 'true') return;
      form.dataset.bound = 'true';

      const successMsg = document.getElementById('contactSuccessMsg');
      const errorMsg = document.getElementById('contactErrorMsg');
      const submitBtn = document.getElementById('submitContactBtn') as HTMLButtonElement | null;
      const btnLabel = document.getElementById('submitBtnLabel');

      function showError(html: string) {
        if (!errorMsg) return;
        errorMsg.innerHTML = html;
        errorMsg.classList.remove('hidden');
      }

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        errorMsg?.classList.add('hidden');

        if (!form.checkValidity()) {
          form.reportValidity();
          return;
        }

        const data = new FormData(form);

        if (data.get('botcheck')) {
          form.classList.add('hidden');
          successMsg?.classList.remove('hidden');
          return;
        }

        const accessKey = form.dataset.key;
        const email = form.dataset.email || '';
        const whatsapp = form.dataset.whatsapp || '';

        const summary =
          `Inquiry type: ${data.get('topic')}\n` +
          `Name: ${data.get('name')}\n` +
          `Email: ${data.get('email')}\n` +
          `Phone: ${data.get('phone') || '-'}\n\n` +
          `${data.get('message')}`;

        const mailLink = `mailto:${email}?subject=${encodeURIComponent('Inquiry: ' + data.get('topic'))}&body=${encodeURIComponent(summary)}`;
        const waLink = whatsapp ? `https://wa.me/${whatsapp}?text=${encodeURIComponent(summary)}` : '';

        const fallbackHtml = waLink
          ? `Could not send automatically. Please contact us directly via <a class="underline font-bold" href="${waLink}" target="_blank" rel="noopener noreferrer">WhatsApp</a> or <a class="underline font-bold" href="${mailLink}">Email</a>.`
          : `Could not send automatically. Please send your message directly via <a class="underline font-bold" href="${mailLink}">Email (${email})</a>.`;

        if (!accessKey) {
          showError(fallbackHtml);
          return;
        }

        if (submitBtn) submitBtn.disabled = true;
        if (btnLabel) btnLabel.textContent = 'Sending...';

        try {
          const res = await fetch('https://api.web3forms.com/submit', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
            body: JSON.stringify({
              access_key: accessKey,
              subject: `GulshanHotels.com — ${data.get('topic')}`,
              from_name: 'GulshanHotels.com Contact Form',
              name: data.get('name'),
              email: data.get('email'),
              phone: data.get('phone'),
              topic: data.get('topic'),
              message: data.get('message'),
            }),
          });
          const json = await res.json();

          if (res.ok && json.success) {
            form.classList.add('hidden');
            successMsg?.classList.remove('hidden');
          } else {
            throw new Error(json.message || 'Request failed');
          }
        } catch {
          showError(fallbackHtml);
          if (submitBtn) submitBtn.disabled = false;
          if (btnLabel) btnLabel.textContent = 'Send Message';
        }
      });
    }

    initContactForm();
    document.addEventListener('astro:page-load', initContactForm);
  </script>
</Layout>
