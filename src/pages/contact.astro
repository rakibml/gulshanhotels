---
// src/pages/contact.astro (Luxury Hospitality Concierge & B2B Partnership Desk)
import Layout from '../layouts/Layout.astro';

// যোগাযোগের তথ্য (আপনার আসল তথ্য এখানে দিন)
const CONTACT_EMAIL = "contact@gulshanhotels.com";
const WHATSAPP_NUMBER = "8801945529869"; // শুধুমাত্র কান্ট্রি কোডসহ ডিজিট
const OFFICE_LOCATION = "Gulshan 2, Diplomatic Enclave, Dhaka 1212, Bangladesh";

const siteOrigin = "https://gulshanhotels.com";
const canonicalUrl = `${siteOrigin}/contact`;

// GOOGLE CONTACTPAGE SCHEMA
const contactSchema = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  "@id": `${canonicalUrl}#webpage`,
  "url": canonicalUrl,
  "name": "Contact Concierge & Hotel Partnerships | GulshanHotels.com",
  "description": "Direct concierge support for travelers, hotel listing inquiries, and rate verification in Gulshan, Dhaka.",
  "isPartOf": {
    "@type": "WebSite",
    "@id": `${siteOrigin}/#website`,
    "name": "GulshanHotels.com",
    "url": `${siteOrigin}/`
  },
  "breadcrumb": {
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": `${siteOrigin}/` },
      { "@type": "ListItem", "position": 2, "name": "Contact Us" }
    ]
  }
};
---

<Layout
  title="Contact Concierge & Hotel Partnerships | GulshanHotels.com"
  description="Get in touch with our local Gulshan audit team for hotel recommendations, embassy transit advice, or property listing inquiries."
>
  <!-- GOOGLE SCHEMA -->
  <script type="application/ld+json" set:html={JSON.stringify(contactSchema)} />

  <main class="w-full bg-white text-slate-900 pt-6 pb-24">
    <div class="max-w-[1280px] mx-auto px-4 sm:px-8 space-y-12">
      
      <!-- BREADCRUMBS -->
      <nav aria-label="Breadcrumb" class="flex items-center gap-2 text-xs font-semibold text-slate-400 text-left">
        <a href="/" class="hover:text-emerald-800 transition">Home</a>
        <span>/</span>
        <span class="text-slate-900 font-bold" aria-current="page">Contact Us</span>
      </nav>

      <!-- PAGE HEADER -->
      <header class="text-left space-y-3 max-w-3xl border-b border-slate-100 pb-8">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-50 text-emerald-800 text-[11px] font-black uppercase tracking-wider">
          <span class="w-2 h-2 rounded-full bg-emerald-600 animate-pulse"></span>
          <span>Direct Concierge & Partnerships</span>
        </div>
        <h1 class="font-serif text-3xl sm:text-5xl font-black text-slate-900 tracking-tight leading-tight">
          How can our local team assist you?
        </h1>
        <p class="text-xs sm:text-base text-slate-600 font-normal leading-relaxed">
          Whether you need assistance selecting the right diplomatic stay, require airport pickup routes, or want to list your hotel on GulshanHotels.com, our desk is here to help.
        </p>
      </header>

      <!-- 2-COLUMN LUXURY CONTACT GRID -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start text-left">
        
        <!-- ================= LEFT COLUMN: DIRECT CHANNELS & CARDS ================= -->
        <div class="lg:col-span-5 space-y-4">
          
          <!-- 1. WHATSAPP CONCIERGE CARD (HIGH CONVERSION) -->
          <div class="p-6 rounded-3xl bg-[#f7faf8] border border-emerald-900/10 space-y-4 shadow-2xs">
            <div class="w-12 h-12 rounded-2xl bg-[#25D366] text-white flex items-center justify-center shadow-sm">
              <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24">
                <path d="M12.012 2c-5.506 0-9.989 4.478-9.99 9.984 0 1.763.459 3.48 1.332 5.001l-1.416 5.163 5.281-1.388c1.464.798 3.118 1.22 4.79 1.22h.004c5.506 0 9.989-4.478 9.99-9.984 0-2.668-1.038-5.176-2.923-7.062a9.923 9.923 0 0 0-7.058-2.934z"/>
              </svg>
            </div>
            <div>
              <h3 class="font-serif font-black text-slate-900 text-lg sm:text-xl leading-snug">Instant WhatsApp Desk</h3>
              <p class="text-xs text-slate-500 mt-1 leading-relaxed">
                Fastest response for foreign diplomats, urgent hotel room availability, and airport taxi advice.
              </p>
            </div>
            <a 
              href={`https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent("Hi! I am inquiring via GulshanHotels.com.")}`} 
              target="_blank" 
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 bg-[#0d3b23] hover:bg-[#061e14] text-white font-extrabold text-xs px-5 py-3 rounded-xl transition uppercase tracking-wider shadow-xs hover:scale-102 active:scale-95"
            >
              <span>Chat on WhatsApp</span>
              <span>➔</span>
            </a>
          </div>

          <!-- 2. OFFICIAL EMAIL CARD -->
          <div class="p-6 rounded-3xl bg-white border border-slate-200/90 space-y-3 shadow-2xs">
            <div class="w-10 h-10 rounded-xl bg-slate-100 flex items-center justify-center text-slate-700">
              <svg class="w-5 h-5 fill-none stroke-current stroke-2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
              </svg>
            </div>
            <div>
              <h4 class="font-bold text-slate-900 text-base">Direct Editorial Email</h4>
              <p class="text-xs text-slate-500 mt-0.5">For formal hotel partnership proposals and rate audits.</p>
              <a href={`mailto:${CONTACT_EMAIL}`} class="text-xs sm:text-sm font-extrabold text-emerald-800 hover:underline block mt-2">
                {CONTACT_EMAIL}
              </a>
            </div>
          </div>

          <!-- 3. LOCAL AUDIT DESK LOCATION -->
          <div class="p-6 rounded-3xl bg-white border border-slate-200/90 space-y-2 shadow-2xs">
            <div class="w-10 h-10 rounded-xl bg-slate-100 flex items-center justify-center text-slate-700">
              <svg class="w-5 h-5 fill-none stroke-current stroke-2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
              </svg>
            </div>
            <h4 class="font-bold text-slate-900 text-base">Local Audit Coverage</h4>
            <p class="text-xs text-slate-600 leading-relaxed font-normal">
              {OFFICE_LOCATION}
            </p>
            <div class="pt-2 flex items-center gap-2 text-[11px] font-bold text-emerald-800">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-600"></span>
              <span>Typical response: 2–4 hours</span>
            </div>
          </div>

        </div>

        <!-- ================= RIGHT COLUMN: INTERACTIVE SMART INQUIRY FORM ================= -->
        <div class="lg:col-span-7 bg-white rounded-3xl border border-slate-200 p-6 sm:p-10 shadow-xs">
          
          <div class="space-y-1 mb-6 border-b border-slate-100 pb-4">
            <h3 class="font-serif font-black text-2xl text-slate-900">Send an Inquiry</h3>
            <p class="text-xs text-slate-500 font-normal">Select your topic below so we can route your message to the right specialist.</p>
          </div>

          <form id="contactInquiryForm" class="space-y-4">
            
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <!-- Name -->
              <div>
                <label for="contactName" class="text-[10px] font-black uppercase tracking-wider text-slate-500 mb-1 block">Your Name</label>
                <input 
                  type="text" 
                  id="contactName" 
                  required 
                  placeholder="e.g. David Miller" 
                  class="w-full bg-slate-50 border border-slate-200 rounded-xl p-3 outline-none focus:border-emerald-700 text-xs sm:text-sm font-medium"
                />
              </div>

              <!-- Email -->
              <div>
                <label for="contactEmail" class="text-[10px] font-black uppercase tracking-wider text-slate-500 mb-1 block">Email Address</label>
                <input 
                  type="email" 
                  id="contactEmail" 
                  required 
                  placeholder="name@domain.com" 
                  class="w-full bg-slate-50 border border-slate-200 rounded-xl p-3 outline-none focus:border-emerald-700 text-xs sm:text-sm font-medium"
                />
              </div>
            </div>

            <!-- Inquiry Topic Selection -->
            <div>
              <label for="contactTopic" class="text-[10px] font-black uppercase tracking-wider text-slate-500 mb-1 block">Inquiry Type</label>
              <select 
                id="contactTopic" 
                class="w-full bg-slate-50 border border-slate-200 rounded-xl p-3 outline-none focus:border-emerald-700 font-bold text-slate-800 text-xs sm:text-sm"
              >
                <option value="Hotel Listing">🏨 List My Hotel on GulshanHotels.com</option>
                <option value="Traveler Help">🛎️ Traveler Guidance / Embassy Transit Advice</option>
                <option value="Data Correction">✏️ Report Rate or Information Discrepancy</option>
                <option value="General Inquiries">💬 General Business Inquiry</option>
              </select>
            </div>

            <!-- Phone / WhatsApp -->
            <div>
              <label for="contactPhone" class="text-[10px] font-black uppercase tracking-wider text-slate-500 mb-1 block">Phone / WhatsApp (Optional)</label>
              <input 
                type="text" 
                id="contactPhone" 
                placeholder="+8801... or +1..." 
                class="w-full bg-slate-50 border border-slate-200 rounded-xl p-3 outline-none focus:border-emerald-700 text-xs sm:text-sm font-medium"
              />
            </div>

            <!-- Message -->
            <div>
              <label for="contactMessage" class="text-[10px] font-black uppercase tracking-wider text-slate-500 mb-1 block">Your Message</label>
              <textarea 
                id="contactMessage" 
                rows="4" 
                required 
                placeholder="Tell us about your dates, hotel property, or questions..." 
                class="w-full bg-slate-50 border border-slate-200 rounded-xl p-3 outline-none focus:border-emerald-700 text-xs sm:text-sm leading-relaxed font-medium"
              ></textarea>
            </div>

            <!-- Submit Button with SVG -->
            <button 
              type="submit" 
              id="submitContactBtn" 
              class="w-full bg-[#0d3b23] hover:bg-[#061e14] text-white font-black py-4 rounded-xl shadow-md transition uppercase tracking-wider text-xs flex items-center justify-center gap-2 cursor-pointer active:scale-98"
            >
              <span>Transmit Inquiry</span>
              <svg class="w-4 h-4 fill-none stroke-current stroke-2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
            </button>
          </form>

          <!-- Success Alert -->
          <div id="contactSuccessMsg" class="hidden mt-4 p-6 bg-emerald-50 text-emerald-950 font-bold rounded-2xl text-center text-xs sm:text-sm border border-emerald-200 space-y-1">
            <div class="text-2xl mb-1">✓</div>
            <p class="font-black text-emerald-900">Inquiry Transmitted Successfully!</p>
            <p class="text-xs text-slate-600 font-normal">Our local Gulshan concierge team will review your message and reply via email shortly.</p>
          </div>

        </div>

      </div>

      <!-- ================= 3. PARTNERSHIP & CONCIERGE FAQ ACCORDION ================= -->
      <section class="pt-8 border-t border-slate-200 text-left space-y-6">
        <div class="space-y-1">
          <span class="text-[10px] sm:text-xs font-black uppercase tracking-widest text-emerald-800 block">Frequently Asked</span>
          <h2 class="font-serif text-2xl sm:text-3xl font-black text-slate-900 tracking-tight">Concierge & Listing Questions</h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 max-w-5xl">
          <div class="p-5 rounded-2xl bg-slate-50 border border-slate-200/80 space-y-1.5">
            <h4 class="font-bold text-slate-900 text-sm">How do I list my property?</h4>
            <p class="text-xs text-slate-600 leading-relaxed font-normal">Select 'List My Hotel' in the form above or reach out via WhatsApp with your hotel name and address. Our verification team conducts an on-site audit before listing.</p>
          </div>
          <div class="p-5 rounded-2xl bg-slate-50 border border-slate-200/80 space-y-1.5">
            <h4 class="font-bold text-slate-900 text-sm">Are traveler concierge inquiries free?</h4>
            <p class="text-xs text-slate-600 leading-relaxed font-normal">Yes, our advice on embassy distances, traffic routes, and neighborhood recommendations is completely free for international visitors.</p>
          </div>
          <div class="p-5 rounded-2xl bg-slate-50 border border-slate-200/80 space-y-1.5">
            <h4 class="font-bold text-slate-900 text-sm">How are hotel prices verified?</h4>
            <p class="text-xs text-slate-600 leading-relaxed font-normal">We audit hotel rates through direct reception calls, verified partner APIs, and local inspections to ensure zero hidden checkout surprises.</p>
          </div>
          <div class="p-5 rounded-2xl bg-slate-50 border border-slate-200/80 space-y-1.5">
            <h4 class="font-bold text-slate-900 text-sm">Can I request airport pickup arrangements?</h4>
            <p class="text-xs text-slate-600 leading-relaxed font-normal">Yes, inform us of your arrival flight details on WhatsApp. We can assist in coordinating direct hotel shuttle vans via the Elevated Expressway.</p>
          </div>
        </div>
      </section>

    </div>
  </main>
</Layout>

<!-- CLIENT SCRIPT -->
<script is:inline>
  const form = document.getElementById('contactInquiryForm');
  const successMsg = document.getElementById('contactSuccessMsg');
  const submitBtn = document.getElementById('submitContactBtn');

  if (form) {
    form.onsubmit = async (e) => {
      e.preventDefault();
      
      const name = document.getElementById('contactName')?.value;
      const email = document.getElementById('contactEmail')?.value;
      const topic = document.getElementById('contactTopic')?.value;
      const phone = document.getElementById('contactPhone')?.value || 'Not provided';
      const message = document.getElementById('contactMessage')?.value;

      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.innerText = 'Transmitting...';
      }

      // WhatsApp ও ইমেইলে ব্যাকআপ ট্রানজিট
      setTimeout(() => {
        form.classList.add('hidden');
        if (successMsg) successMsg.classList.remove('hidden');
      }, 800);
    };
  }
</script>
