---
// src/pages/privacy.astro
// Privacy Policy & Data Protection with Canonical Trailing Slash
import Layout from '../layouts/Layout.astro';

const LAST_UPDATED = "November 2026";
const CONTACT_EMAIL = "privacy@gulshanhotels.com";
const siteOrigin = "https://gulshanhotels.com";
// Canonical URL matched to route name with trailing slash
const canonicalUrl = `${siteOrigin}/privacy/`;

const pageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": `${canonicalUrl}#webpage`,
  "url": canonicalUrl,
  "name": "Privacy Policy | GulshanHotels.com",
  "description": "Official Privacy Policy and Data Protection standards of GulshanHotels.com.",
  "inLanguage": "en-US",
  "isPartOf": {
    "@type": "WebSite",
    "@id": `${siteOrigin}/#website`,
    "name": "GulshanHotels.com",
    "url": `${siteOrigin}/`
  },
  "breadcrumb": {
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": `${siteOrigin}/` },
      { "@type": "ListItem", "position": 2, "name": "Privacy Policy", "item": canonicalUrl }
    ]
  }
};
---

<Layout
  title="Privacy Policy | GulshanHotels.com"
  description="Learn how GulshanHotels.com collects, safeguards, and processes visitor data, verified reviews, and booking partner interactions."
>
  <script type="application/ld+json" set:html={JSON.stringify(pageSchema)} />

  <main class="w-full bg-white text-slate-900 pt-6 pb-24">
    <div class="max-w-[880px] mx-auto px-4 sm:px-6 space-y-10 text-left">
      
      <nav aria-label="Breadcrumb" class="flex items-center gap-2 text-xs font-semibold text-slate-400">
        <a href="/" class="hover:text-emerald-800 transition">Home</a>
        <span>/</span>
        <span class="text-slate-900 font-bold" aria-current="page">Privacy Policy</span>
      </nav>

      <header class="space-y-4 border-b border-slate-200 pb-8">
        <div class="flex flex-wrap items-center gap-3">
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-50 text-emerald-800 border border-emerald-200 text-[11px] font-black uppercase tracking-wider">
            <svg class="w-3.5 h-3.5 fill-emerald-700 shrink-0" viewBox="0 0 24 24">
              <path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm-2 16l-4-4 1.41-1.41L10 14.17l6.59-6.59L18 9l-8 8z"/>
            </svg>
            <span>Official Legal Notice</span>
          </span>

          <span class="text-xs text-slate-400 font-medium">
            Effective Date: <strong class="text-slate-700">{LAST_UPDATED}</strong>
          </span>
        </div>

        <h1 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-black text-slate-900 tracking-tight leading-tight">
          Privacy Policy & Data Protection
        </h1>

        <p class="text-base sm:text-lg text-slate-600 font-normal leading-relaxed">
          At GulshanHotels.com, we prioritize the confidentiality and security of our guests, international travelers, and hotel partners. This statement outlines our transparent data practices.
        </p>

        <div class="p-4 sm:p-5 rounded-2xl bg-[#f7faf8] border border-emerald-900/10 flex items-start gap-3.5">
          <div class="w-8 h-8 rounded-xl bg-white border border-emerald-200 flex items-center justify-center text-emerald-800 shrink-0 shadow-2xs">
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
              <path d="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z"/>
            </svg>
          </div>
          <div class="text-xs sm:text-sm text-slate-700 leading-relaxed">
            <strong class="font-bold text-slate-900 block mb-0.5">Zero Data Sale Commitment</strong>
            We do not sell, rent, or trade your personal information or browsing history to third-party data brokers under any circumstances.
          </div>
        </div>
      </header>

      <div class="flex items-center gap-2 overflow-x-auto pb-1 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
        <a href="#collect" class="shrink-0 px-3 py-1.5 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-bold transition">1. Information Collected</a>
        <a href="#usage" class="shrink-0 px-3 py-1.5 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-bold transition">2. Usage of Data</a>
        <a href="#partners" class="shrink-0 px-3 py-1.5 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-bold transition">3. Booking Partners</a>
        <a href="#cookies" class="shrink-0 px-3 py-1.5 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-bold transition">4. Cookies & Storage</a>
        <a href="#rights" class="shrink-0 px-3 py-1.5 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-bold transition">5. Your Rights</a>
      </div>

      <div 
        id="policyBody" 
        class="prose prose-slate max-w-none text-[16px] sm:text-[17px] leading-[1.85] font-normal text-slate-700
               prose-headings:font-serif prose-headings:font-black prose-headings:text-slate-900 prose-headings:tracking-tight 
               prose-h2:text-2xl sm:prose-h2:text-3xl prose-h2:mt-10 prose-h2:mb-4 prose-h2:pt-6 prose-h2:border-t prose-h2:border-slate-100
               prose-h3:text-lg sm:prose-h3:text-xl prose-h3:mt-6 prose-h3:mb-3 
               prose-ul:my-4 prose-ul:list-disc prose-ul:pl-6 prose-li:my-1.5
               [&_a]:text-emerald-800 [&_a]:font-bold [&_a]:underline [&_a]:decoration-emerald-500/80 [&_a]:underline-offset-4 hover:[&_a]:text-emerald-950 transition-colors"
      >
        <section id="collect">
          <h2>1. Information We Collect</h2>
          <p>
            GulshanHotels.com operates as an independent hotel directory and curated reservation guide. We collect minimal information strictly necessary to provide accurate lodging details:
          </p>
          <ul>
            <li>
              <strong>Voluntarily Submitted Information:</strong> When you submit a guest review, contact our concierge desk, or subscribe to our newsletter, we store details such as your name, email address, rating score, and feedback text.
            </li>
            <li>
              <strong>Technical Device Logs:</strong> For security monitoring and DDoS mitigation, our edge hosting infrastructure (Cloudflare) automatically processes standard web server logs (including truncated IP addresses, browser types, and visited page paths).
            </li>
            <li>
              <strong>Direct Hotel Inquiries:</strong> Communications initiated via our WhatsApp concierge links transfer directly to the respective hotel or concierge team under end-to-end encryption.
            </li>
          </ul>
        </section>

        <section id="usage">
          <h2>2. How We Use Your Information</h2>
          <p>
            Information collected through our platform is utilized solely for legitimate operational purposes:
          </p>
          <ul>
            <li>To display verified stay experiences and authentic guest ratings across our hotel profiles.</li>
            <li>To dispatch hotel availability confirmations and response inquiries initiated via our contact forms.</li>
            <li>To audit and prevent fraudulent reviews, rate manipulation, or automated web scraping.</li>
            <li>To maintain Core Web Vitals performance and technical stability across global content delivery networks.</li>
          </ul>
        </section>

        <section id="partners">
          <h2>3. Third-Party Booking Partners & Affiliate Disclosure</h2>
          <p>
            GulshanHotels.com aggregates verified reservation channels, including direct hotel reception desks and global booking platforms (such as Agoda, Booking.com, and Expedia).
          </p>
          <p>
            When you click an external reservation link (e.g., "Book Now" or "Official Website"), you are directed to an external third-party domain. These partner websites operate under their own independent privacy policies and tracking protocols. We recommend reviewing their respective privacy statements before completing transactions.
          </p>
          <p class="text-sm bg-slate-50 p-4 rounded-xl border border-slate-200">
            <strong>Disclosure:</strong> Some reservation buttons on this portal contain partner referral links. If you complete a hotel booking through these links, we may receive a referral commission at zero additional cost to you.
          </p>
        </section>

        <section id="cookies">
          <h2>4. Cookies & Local Browser Storage</h2>
          <p>
            We adhere to privacy-friendly principles and do not deploy invasive cross-site profiling trackers:
          </p>
          <ul>
            <li>
              <strong>Local Browser Storage (LocalStorage):</strong> Used strictly on your local device to remember your saved hotels ("Wishlist Heart" feature) so you can review your shortlisted accommodations upon returning.
            </li>
            <li>
              <strong>Essential Infrastructure Cookies:</strong> Deployed by Cloudflare strictly for SSL security verification, bot management, and speed caching.
            </li>
          </ul>
        </section>

        <section id="rights">
          <h2>5. Data Retention & Your Rights (GDPR / Global Standards)</h2>
          <p>
            Regardless of your geographic location, you retain full rights over any personal information submitted to our platform:
          </p>
          <ul>
            <li><strong>Right to Access:</strong> You may request a summary of any personal data linked to your email address.</li>
            <li><strong>Right to Erasure / Deletion:</strong> You may request the immediate removal of any guest review, comment, or email subscription you previously submitted.</li>
            <li><strong>Right to Correction:</strong> If you represent a listed hotel property and notice inaccurate rate details or contact coordinates, you may request an immediate audit update.</li>
          </ul>
        </section>
      </div>

      <div class="mt-12 bg-slate-50 border border-slate-200 rounded-3xl p-6 sm:p-8 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6">
        <div class="space-y-1">
          <h3 class="font-serif font-bold text-slate-900 text-lg">Have Questions or Data Removal Requests?</h3>
          <p class="text-xs sm:text-sm text-slate-500 font-normal">
            Our data privacy team reviews and processes all user requests within 48 business hours.
          </p>
        </div>
        <a 
          href={`mailto:${CONTACT_EMAIL}`}
          class="bg-[#0d3b23] hover:bg-[#061e14] text-white font-extrabold text-xs px-5 py-3 rounded-xl uppercase tracking-wider transition shrink-0 shadow-xs flex items-center gap-2"
        >
          <span>Contact Privacy Desk</span>
          <svg class="w-3.5 h-3.5 fill-none stroke-current stroke-2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
          </svg>
        </a>
      </div>

    </div>
  </main>
</Layout>

<script is:inline>
  const initPrivacyLinks = () => {
    const links = document.querySelectorAll('#policyBody a');
    links.forEach(link => {
      const href = link.getAttribute('href');
      if (href && !href.startsWith('#')) {
        link.setAttribute('target', '_blank');
        link.setAttribute('rel', 'noopener noreferrer');
      }
    });
  };
  document.addEventListener('DOMContentLoaded', initPrivacyLinks);
  document.addEventListener('astro:page-load', initPrivacyLinks);
</script>
