---
// src/pages/blog/[slug].astro (Full-Width Balanced Layout matching 1550px Header)
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  let posts: any[] = [];
  try {
    const postCol = await getCollection('posts');
    if (Array.isArray(postCol) && postCol.length > 0) posts = postCol;
  } catch (e) {}

  if (posts.length === 0) {
    try {
      const rawGlob = import.meta.glob('../../content/posts/*.md', { eager: true });
      posts = Object.entries(rawGlob).map(([filePath, item]: [string, any]) => ({
        slug: filePath.split('/').pop()?.replace('.md', ''),
        data: item.frontmatter || {},
        render: async () => ({ Content: item.Content || item.default })
      }));
    } catch (e) {}
  }

  // সব হোটেল ডাটা লোড
  let allHotels: any[] = [];
  try {
    const hotelCol = await getCollection('hotels');
    if (Array.isArray(hotelCol)) allHotels = hotelCol;
  } catch (e) {}

  if (allHotels.length === 0) {
    try {
      const rawHotels = import.meta.glob('../../content/hotels/*.md', { eager: true });
      allHotels = Object.entries(rawHotels).map(([filePath, item]: [string, any]) => ({
        slug: filePath.split('/').pop()?.replace('.md', ''),
        data: item.frontmatter || {}
      }));
    } catch (e) {}
  }

  return posts.map(post => ({
    params: { slug: post.slug || post.id?.replace(/\.md$/, '') },
    props: { post, allPosts: posts, allHotels }
  }));
}

const { post, allPosts = [], allHotels = [] } = Astro.props;
const data = post?.data || {};

const title = data.title || "Gulshan Hotel & Travel Guide";
const description = data.description || "In-depth local guide for diplomats and luxury travelers.";
const publishDate = data.date || "Oct 2026";
const category = data.category || "Travel Guide";
const readTime = data.readTime || "4 min read";
const image = data.image || "https://images.unsplash.com/photo-1542314831-068cd1dbfeeb?auto=format&fit=crop&w=1400&q=80";
const author = data.author || "Gulshan Concierge Team";

// এম্বেড করার জন্য বাছাই করা হোটেলসমূহ
const recommendedSlugs = Array.isArray(data.recommended_hotels) ? data.recommended_hotels : [];
const matchedHotels = allHotels.filter(h => {
  const s = (h.slug || h.id || h.data?.slug || '').replace(/\.md$/, '').toLowerCase();
  return recommendedSlugs.some((r: any) => {
    const target = (typeof r === 'object' ? r.hotel_slug : String(r)).toLowerCase();
    return target === s || s.includes(target);
  });
});

const displayHotels = matchedHotels.length > 0 ? matchedHotels : allHotels.slice(0, 3);

const takeaways = Array.isArray(data.takeaways) && data.takeaways.length > 0 
  ? data.takeaways 
  : [
      "Gulshan 2 offers maximum diplomatic security and proximity to US/UK embassies.",
      "18-minute express connection to Dhaka Airport (DAC) via Elevated Expressway.",
      "Top luxury 5-star properties include The Westin, Renaissance, and Amari Dhaka."
    ];

const currentSlug = post.slug || post.id?.replace(/\.md$/, '');
const relatedPosts = allPosts
  .filter((p: any) => (p.slug || p.id?.replace(/\.md$/, '')) !== currentSlug)
  .slice(0, 3);

const { Content } = post.render ? await post.render() : { Content: null };
const siteUrl = Astro.url.href;
---

<Layout title={`${title} — GulshanHotels Guide`} description={description} image={image}>

  <!-- 1. TOP READING PROGRESS BAR -->
  <div class="fixed top-0 left-0 w-full h-1 bg-transparent z-[100] pointer-events-none">
    <div id="readingProgressBar" class="h-full bg-emerald-700 w-0 transition-all duration-100 ease-out"></div>
  </div>

  <article class="w-full bg-white text-slate-900 pt-6 pb-20">
    <!-- হেডারের সাথে ১০০% মেলানো কন্টেইনার (max-w-[1550px]) -->
    <div class="max-w-[1550px] mx-auto px-4 sm:px-8 lg:px-12 space-y-8 text-left">
      
      <!-- BREADCRUMBS (হেডার লোগোর সমান বাম দিক থেকে শুরু) -->
      <nav class="flex items-center gap-2 text-xs font-semibold text-slate-400">
        <a href="/" class="hover:text-emerald-800 transition">Home</a>
        <span>/</span>
        <a href="/blog" class="hover:text-emerald-800 transition">Travel Guides</a>
        <span>/</span>
        <span class="text-slate-800 truncate max-w-md">{title}</span>
      </nav>

      <!-- ARTICLE HEADER (চওড়া ও দৃষ্টিনন্দন) -->
      <header class="max-w-5xl space-y-4">
        
        <div class="flex flex-wrap items-center gap-2.5">
          <span class="bg-emerald-50 text-emerald-800 text-[11px] font-black uppercase tracking-wider px-3 py-1 rounded-full border border-emerald-200">
            {category}
          </span>
          <span class="text-xs text-slate-400 font-medium">
            Updated: <strong class="text-slate-700">{publishDate}</strong>
          </span>
          <span class="text-xs text-slate-400 font-medium">• ⏱️ {readTime}</span>
          <span class="text-[11px] font-bold text-emerald-700 bg-emerald-50/70 px-2.5 py-0.5 rounded-md border border-emerald-100">
            ✓ Fact-Checked
          </span>
        </div>

        <!-- Headline (এখন চওড়া হয়ে সুন্দর ২ লাইনে বসবে) -->
        <h1 class="font-serif text-3xl sm:text-5xl lg:text-6xl font-black text-slate-900 tracking-tight leading-tight">
          {title}
        </h1>

        <p class="text-base sm:text-xl text-slate-600 font-normal leading-relaxed max-w-4xl">
          {description}
        </p>

        <!-- AUTHOR & SHARE BAR ROW -->
        <div class="pt-4 border-t border-slate-100 flex flex-col sm:flex-row sm:items-center justify-between gap-4 max-w-4xl">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-full bg-[#0d3b23] text-white flex items-center justify-center font-black text-sm shrink-0">
              {author.charAt(0)}
            </div>
            <div class="text-xs">
              <span class="font-bold text-slate-900 block">{author}</span>
              <span class="text-slate-400">Gulshan Hospitality Specialist</span>
            </div>
          </div>

          <!-- Share Icons -->
          <div class="flex items-center gap-2">
            <a href={`https://api.whatsapp.com/send?text=${encodeURIComponent(title + ' ' + siteUrl)}`} target="_blank" rel="noopener noreferrer" class="w-8 h-8 rounded-full bg-[#25D366] text-white flex items-center justify-center hover:opacity-90 transition shadow-xs" title="Share on WhatsApp">
              <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M12.012 2c-5.506 0-9.989 4.478-9.99 9.984 0 1.763.459 3.48 1.332 5.001l-1.416 5.163 5.281-1.388c1.464.798 3.118 1.22 4.79 1.22h.004c5.506 0 9.989-4.478 9.99-9.984 0-2.668-1.038-5.176-2.923-7.062a9.923 9.923 0 0 0-7.058-2.934z"/></svg>
            </a>
            <button id="copyLinkBtn" type="button" class="h-8 px-3 rounded-full bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-xs flex items-center gap-1.5 transition cursor-pointer">
              <span id="copyLinkText">Copy Link</span>
            </button>
          </div>
        </div>

      </header>

      <!-- FEATURED COVER PHOTO (চওড়া সিনেমাটিক ওয়াইড ব্যানার) -->
      <div class="w-full">
        <div class="relative aspect-[21/9] sm:aspect-[21/9] w-full rounded-3xl overflow-hidden bg-slate-100 border border-slate-200/80">
          <img src={image} alt={title} width="1550" height="660" fetchpriority="high" decoding="async" class="w-full h-full object-cover" />
        </div>
      </div>

      <!-- KEY TAKEAWAYS (লম্বা না হয়ে পাশাপাশি ৩ কলামে সাজানো স্লিম বক্স) -->
      <div class="bg-[#f5f8f6] border border-emerald-200/90 rounded-3xl p-6 sm:p-7 space-y-3">
        <div class="flex items-center gap-2 text-slate-900 font-bold text-xs uppercase tracking-wider">
          <span class="text-emerald-800 text-base">📌</span>
          <span class="text-emerald-950 font-black">Key Takeaways at a Glance</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 pt-1">
          {takeaways.map((item: string) => (
            <div class="flex items-start gap-2.5 bg-white p-3.5 rounded-xl border border-emerald-100 shadow-2xs">
              <span class="text-emerald-700 font-black text-sm shrink-0">✓</span>
              <span class="text-xs sm:text-[13px] text-slate-700 font-semibold leading-snug">{item}</span>
            </div>
          ))}
        </div>
      </div>

      <!-- ARTICLE CONTENT BODY (পড়ার সুবিধার জন্য অপটিমাল ও আরামদায়ক উইডথ) -->
      <div class="max-w-4xl pt-2">
        <div 
          id="articleBodyContent" 
          class="prose prose-slate max-w-none text-base sm:text-lg prose-headings:font-serif prose-headings:font-black prose-headings:text-slate-900 prose-p:text-slate-700 prose-p:leading-relaxed prose-a:text-emerald-800 prose-a:font-bold hover:prose-a:underline prose-img:rounded-2xl"
        >
          {Content ? <Content /> : <p>Article content loading...</p>}
        </div>
      </div>

      <!-- RECOMMENDED HOTELS (লম্বা না হয়ে চওড়া ৩ কলামের গ্রিডে সাজানো) -->
      {displayHotels.length > 0 && (
        <div class="pt-10 border-t border-slate-200 space-y-5">
          <div class="space-y-1">
            <span class="text-[10px] font-black uppercase tracking-wider text-emerald-800">Featured Accommodations</span>
            <h3 class="font-serif text-2xl sm:text-3xl font-black text-slate-900">Recommended Hotels Mentioned in this Guide</h3>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 pt-2">
            {displayHotels.map((h: any) => {
              const hd = h.data || {};
              const hTitle = hd.title || hd.name || "Hotel";
              const hSlug = (h.slug || h.id || hd.slug || '').replace(/\.md$/, '');
              const hImg = hd.image || "https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&w=500&q=75";
              const hPrice = hd.price || "$120";

              return (
                <div class="bg-white rounded-2xl border border-slate-200 hover:border-slate-400 p-4 flex flex-col justify-between transition-colors text-left space-y-4">
                  <div class="space-y-3">
                    <div class="aspect-[16/10] w-full rounded-xl overflow-hidden bg-slate-100 relative">
                      <img src={hImg} alt={hTitle} width="400" height="250" loading="lazy" class="w-full h-full object-cover" />
                      <span class="absolute top-2.5 left-2.5 bg-[#0d3b23] text-white text-[9px] font-black uppercase px-2.5 py-0.5 rounded-md">
                        Verified Stay
                      </span>
                    </div>
                    <div>
                      <h4 class="font-bold text-slate-900 text-base leading-tight capitalize truncate">{hTitle}</h4>
                      <p class="text-xs text-slate-500 truncate mt-1">{hd.location || "Gulshan, Dhaka"}</p>
                    </div>
                  </div>

                  <div class="pt-3 border-t border-slate-100 flex items-center justify-between">
                    <div>
                      <span class="text-[10px] text-slate-400 block leading-none">Starting from</span>
                      <span class="text-base font-black text-slate-900">{hPrice.startsWith('$') || hPrice.startsWith('৳') ? hPrice : '$' + hPrice}</span>
                    </div>
                    <a href={`/${hSlug}`} class="bg-[#0d3b23] hover:bg-[#061e14] text-white font-extrabold text-xs px-4 py-2 rounded-xl uppercase tracking-wider transition">
                      View Hotel ➔
                    </a>
                  </div>
                </div>
              );
            })}
          </div>
        </div>
      )}

      <!-- CONCIERGE CALLOUT BANNER (চওড়া ও দৃষ্টিনন্দন) -->
      <div class="bg-[#0d3b23] text-white p-8 sm:p-10 rounded-3xl flex flex-col md:flex-row justify-between items-start md:items-center gap-6 mt-8">
        <div class="space-y-2 max-w-2xl">
          <span class="text-emerald-300 text-xs font-black uppercase tracking-widest block">Direct Concierge</span>
          <h3 class="font-serif text-2xl sm:text-3xl font-black">Need Advice for Your Gulshan Visit?</h3>
          <p class="text-xs sm:text-sm text-emerald-100 font-normal leading-relaxed">
            Our local audit team verifies rates, embassy distances, and checkout policies daily. Contact our desk for hotel recommendations and airport pickups.
          </p>
        </div>
        <div class="shrink-0">
          <a href="/about" class="inline-block bg-white hover:bg-emerald-50 text-slate-950 font-black text-xs px-6 py-3.5 rounded-xl uppercase tracking-wider transition">
            Ask Our Concierge ➔
          </a>
        </div>
      </div>

      <!-- RELATED GUIDES (৩ কলামে গ্রিড) -->
      {relatedPosts.length > 0 && (
        <div class="pt-10 border-t border-slate-200 space-y-5">
          <h3 class="font-serif text-2xl sm:text-3xl font-black text-slate-900">More Gulshan Travel Guides</h3>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
            {relatedPosts.map((rel: any) => {
              const rData = rel.data || {};
              const rSlug = rel.slug || rel.id?.replace(/\.md$/, '');
              return (
                <a href={`/blog/${rSlug}`} class="group block space-y-2.5 cursor-pointer">
                  <div class="aspect-[16/10] w-full rounded-2xl overflow-hidden bg-slate-100 border border-slate-200/80">
                    <img src={rData.image || "https://images.unsplash.com/photo-1542314831-068cd1dbfeeb?auto=format&fit=crop&w=500&q=75"} alt={rData.title} loading="lazy" decoding="async" class="w-full h-full object-cover group-hover:scale-104 transition duration-300" />
                  </div>
                  <span class="text-[10px] font-black uppercase text-emerald-800 tracking-wider block">{rData.category || "Guide"}</span>
                  <h4 class="font-bold text-slate-900 text-sm sm:text-base leading-snug group-hover:text-emerald-800 transition line-clamp-2">{rData.title}</h4>
                </a>
              );
            })}
          </div>
        </div>
      )}

    </div>
  </article>

</Layout>

<script is:inline>
  const initArticleInteractions = () => {
    const progressBar = document.getElementById('readingProgressBar');
    if (progressBar) {
      window.addEventListener('scroll', () => {
        const scrollTop = window.scrollY;
        const docHeight = document.documentElement.scrollHeight - window.innerHeight;
        const scrollPercent = docHeight > 0 ? (scrollTop / docHeight) * 100 : 0;
        progressBar.style.width = Math.min(Math.max(scrollPercent, 0), 100) + '%';
      }, { passive: true });
    }

    const copyBtn = document.getElementById('copyLinkBtn');
    const copyText = document.getElementById('copyLinkText');
    if (copyBtn && copyText && !copyBtn.dataset.bound) {
      copyBtn.dataset.bound = 'true';
      copyBtn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(window.location.href);
          copyText.innerText = 'Copied! ✓';
          setTimeout(() => { copyText.innerText = 'Copy Link'; }, 2500);
        } catch (err) { copyText.innerText = 'Error'; }
      });
    }
  };

  document.addEventListener('DOMContentLoaded', initArticleInteractions);
  document.addEventListener('astro:page-load', initArticleInteractions);
</script>
