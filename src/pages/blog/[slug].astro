---
// src/pages/blog/[slug].astro (Brand Tint Background + 100% SVG Icons - No Emojis)
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  let posts: any[] = [];
  try {
    const postCol = await getCollection('posts');
    if (Array.isArray(postCol) && postCol.length > 0) posts = postCol;
  } catch (e) {}

  if (posts.length === 0) {
    try {
      const rawGlob = import.meta.glob('../../content/posts/*.md', { eager: true });
      posts = Object.entries(rawGlob).map(([filePath, item]: [string, any]) => ({
        slug: filePath.split('/').pop()?.replace('.md', ''),
        data: item.frontmatter || {},
        render: async () => ({ Content: item.Content || item.default })
      }));
    } catch (e) {}
  }

  // সব হোটেল ডাটা লোড
  let allHotels: any[] = [];
  try {
    const hotelCol = await getCollection('hotels');
    if (Array.isArray(hotelCol)) allHotels = hotelCol;
  } catch (e) {}

  if (allHotels.length === 0) {
    try {
      const rawHotels = import.meta.glob('../../content/hotels/*.md', { eager: true });
      allHotels = Object.entries(rawHotels).map(([filePath, item]: [string, any]) => ({
        slug: filePath.split('/').pop()?.replace('.md', ''),
        data: item.frontmatter || {}
      }));
    } catch (e) {}
  }

  return posts.map(post => ({
    params: { slug: post.slug || post.id?.replace(/\.md$/, '') },
    props: { post, allPosts: posts, allHotels }
  }));
}

const { post, allPosts = [], allHotels = [] } = Astro.props;
const data = post?.data || {};

const title = data.title || "Gulshan Hotel & Travel Guide";
const description = data.description || "In-depth local guide for diplomats and luxury travelers.";
const publishDate = data.date || "Oct 2026";
const category = data.category || "Travel Guide";
const readTime = data.readTime || "4 min read";
const image = data.image || "https://images.unsplash.com/photo-1542314831-068cd1dbfeeb?auto=format&fit=crop&w=1200&q=80";
const author = data.author || "Gulshan Concierge Team";

// এম্বেড করার জন্য বাছাই করা হোটেলসমূহ
const recommendedSlugs = Array.isArray(data.recommended_hotels) ? data.recommended_hotels : [];
const matchedHotels = allHotels.filter(h => {
  const s = (h.slug || h.id || h.data?.slug || '').replace(/\.md$/, '').toLowerCase();
  return recommendedSlugs.some((r: any) => {
    const target = (typeof r === 'object' ? r.hotel_slug : String(r)).toLowerCase();
    return target === s || s.includes(target);
  });
});

const displayHotels = matchedHotels.length > 0 ? matchedHotels : allHotels.slice(0, 3);

const takeaways = Array.isArray(data.takeaways) && data.takeaways.length > 0 
  ? data.takeaways 
  : [
      "Gulshan 2 offers maximum diplomatic security and proximity to US/UK embassies.",
      "18-minute express connection to Dhaka Airport (DAC) via Elevated Expressway.",
      "Top luxury 5-star properties include The Westin, Renaissance, and Amari Dhaka."
    ];

// ৪টি সম্পর্কিত আর্টিকেল
const currentSlug = post.slug || post.id?.replace(/\.md$/, '');
const relatedPosts = allPosts
  .filter((p: any) => (p.slug || p.id?.replace(/\.md$/, '')) !== currentSlug)
  .slice(0, 4);

// DISCOVER MORE ক্যাটাগরি ডাটা
const discoverCategories = [
  {
    name: "Food & Drink",
    image: "https://images.unsplash.com/photo-1517248135467-4c7edcad34c4?auto=format&fit=crop&w=600&q=75",
    link: "/#gulshan-lifestyle"
  },
  {
    name: "Shopping & DCC",
    image: "https://images.unsplash.com/photo-1441986300917-64674bd600d8?auto=format&fit=crop&w=600&q=75",
    link: "/#gulshan-lifestyle"
  },
  {
    name: "5-Star Luxury Stays",
    image: "https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&w=600&q=75",
    link: "/#hotels"
  },
  {
    name: "Parks & Wellness Spas",
    image: "https://images.unsplash.com/photo-1540555700478-4be289fbecef?auto=format&fit=crop&w=600&q=75",
    link: "/#gulshan-lifestyle"
  }
];

const { Content } = post.render ? await post.render() : { Content: null };
const siteUrl = Astro.url.href;
---

<Layout title={`${title} — GulshanHotels Guide`} description={description} image={image}>

  <!-- 1. TOP READING PROGRESS BAR -->
  <div class="fixed top-0 left-0 w-full h-1 bg-transparent z-[100] pointer-events-none">
    <div id="readingProgressBar" class="h-full bg-[#0d3b23] w-0 transition-all duration-100 ease-out"></div>
  </div>

  <article class="w-full bg-white text-slate-900 pt-6 pb-12">
    
    <!-- 🎯 GOLDEN RATIO READING COLUMN -->
    <div class="max-w-[760px] mx-auto px-4 sm:px-6 space-y-7 text-left">
      
      <!-- BREADCRUMBS -->
      <nav class="flex items-center gap-2 text-xs font-semibold text-slate-400">
        <a href="/" class="hover:text-emerald-800 transition">Home</a>
        <span>/</span>
        <a href="/blog" class="hover:text-emerald-800 transition">Travel Guides</a>
        <span>/</span>
        <span class="text-slate-700 truncate max-w-xs">{title}</span>
      </nav>

      <!-- ARTICLE HEADER -->
      <header class="space-y-4">
        <div class="flex flex-wrap items-center gap-2.5">
          <span class="bg-emerald-50 text-emerald-800 text-[11px] font-black uppercase tracking-wider px-3 py-1 rounded-full border border-emerald-200">
            {category}
          </span>

          <span class="text-xs text-slate-400 font-medium">
            Updated: <strong class="text-slate-700">{publishDate}</strong>
          </span>

          <!-- Clock SVG Icon (No Emoji) -->
          <span class="text-xs text-slate-400 font-medium flex items-center gap-1">
            <svg class="w-3.5 h-3.5 text-slate-400 fill-none stroke-current stroke-2" viewBox="0 0 24 24">
              <circle cx="12" cy="12" r="10"></circle>
              <polyline points="12 6 12 12 16 14"></polyline>
            </svg>
            <span>{readTime}</span>
          </span>

          <!-- Checkmark SVG Icon (No Emoji) -->
          <span class="text-[11px] font-bold text-emerald-700 bg-emerald-50/70 px-2.5 py-0.5 rounded-md border border-emerald-100 flex items-center gap-1">
            <svg class="w-3 h-3 text-emerald-700 fill-none stroke-current stroke-[2.5]" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
            </svg>
            <span>Fact-Checked</span>
          </span>
        </div>

        <h1 class="font-serif text-3xl sm:text-4xl lg:text-[42px] font-black text-slate-900 tracking-tight leading-[1.2]">
          {title}
        </h1>

        <p class="text-base sm:text-lg text-slate-600 font-normal leading-relaxed">
          {description}
        </p>

        <!-- AUTHOR & SHARE BAR ROW -->
        <div class="pt-4 border-t border-slate-100 flex items-center justify-between gap-4">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-full bg-[#0d3b23] text-white flex items-center justify-center font-black text-sm shrink-0">
              {author.charAt(0)}
            </div>
            <div class="text-xs">
              <span class="font-bold text-slate-900 block">{author}</span>
              <span class="text-slate-400">Gulshan Hospitality Specialist</span>
            </div>
          </div>

          <div class="flex items-center gap-2">
            <!-- WhatsApp SVG -->
            <a href={`https://api.whatsapp.com/send?text=${encodeURIComponent(title + ' ' + siteUrl)}`} target="_blank" rel="noopener noreferrer" class="w-8 h-8 rounded-full bg-[#25D366] text-white flex items-center justify-center hover:opacity-90 transition shadow-xs" title="Share on WhatsApp">
              <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M12.012 2c-5.506 0-9.989 4.478-9.99 9.984 0 1.763.459 3.48 1.332 5.001l-1.416 5.163 5.281-1.388c1.464.798 3.118 1.22 4.79 1.22h.004c5.506 0 9.989-4.478 9.99-9.984 0-2.668-1.038-5.176-2.923-7.062a9.923 9.923 0 0 0-7.058-2.934z"/></svg>
            </a>
            
            <!-- Copy Link Button with SVG -->
            <button id="copyLinkBtn" type="button" class="h-8 px-3 rounded-full bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-xs flex items-center gap-1.5 transition cursor-pointer">
              <svg class="w-3.5 h-3.5 text-slate-600 fill-none stroke-current stroke-2" viewBox="0 0 24 24">
                <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
              </svg>
              <span id="copyLinkText">Copy Link</span>
            </button>
          </div>
        </div>
      </header>

      <!-- FEATURED COVER PHOTO -->
      <div class="w-full">
        <div class="relative aspect-[16/10] rounded-2xl overflow-hidden bg-slate-100 border border-slate-200/80 shadow-xs">
          <img src={image} alt={title} width="1200" height="750" fetchpriority="high" decoding="async" class="w-full h-full object-cover" />
        </div>
      </div>

      <!-- KEY TAKEAWAYS (Bookmark SVG instead of Emoji) -->
      <div class="bg-[#f5f8f6] border-l-4 border-[#0d3b23] rounded-r-2xl p-5 sm:p-6 space-y-3">
        <div class="flex items-center gap-2 text-slate-900 font-bold text-xs uppercase tracking-wider">
          <svg class="w-4 h-4 text-[#0d3b23] fill-current" viewBox="0 0 24 24">
            <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path>
          </svg>
          <span class="text-emerald-950 font-black">Key Takeaways at a Glance</span>
        </div>
        <ul class="space-y-2 text-xs sm:text-[14px] text-slate-700 font-medium">
          {takeaways.map((item: string) => (
            <li class="flex items-start gap-2.5 leading-snug">
              <svg class="w-4 h-4 text-emerald-700 fill-none stroke-current stroke-[2.5] shrink-0 mt-0.5" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
              </svg>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </div>

      <!-- 18px GOLDEN RATIO BODY TEXT -->
      <div 
        id="articleBodyContent" 
        class="prose prose-slate max-w-none text-[17px] sm:text-[18px] leading-[1.8] font-normal text-slate-700 prose-headings:font-serif prose-headings:font-black prose-headings:text-slate-900 prose-headings:tracking-tight prose-h2:text-2xl sm:prose-h2:text-3xl prose-h2:mt-10 prose-h2:mb-4 prose-p:mb-6 prose-a:text-emerald-800 prose-a:font-bold hover:prose-a:underline prose-img:rounded-2xl"
      >
        {Content ? <Content /> : <p>Article content loading...</p>}
      </div>

      <!-- RECOMMENDED HOTELS -->
      {displayHotels.length > 0 && (
        <div class="pt-8 border-t border-slate-200 space-y-4">
          <div class="space-y-0.5">
            <span class="text-[10px] font-black uppercase tracking-wider text-emerald-800">Featured Accommodations</span>
            <h3 class="font-serif text-2xl font-black text-slate-900">Recommended Hotels in this Guide</h3>
          </div>

          <div class="space-y-3 pt-2">
            {displayHotels.map((h: any) => {
              const hd = h.data || {};
              const hTitle = hd.title || hd.name || "Hotel";
              const hSlug = (h.slug || h.id || hd.slug || '').replace(/\.md$/, '');
              const hImg = hd.image || "https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&w=400&q=75";
              const hPrice = hd.price || "$120";

              return (
                <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 p-4 rounded-2xl border border-slate-200 hover:border-slate-400 bg-white transition-colors">
                  <div class="flex items-center gap-4 min-w-0">
                    <img src={hImg} alt={hTitle} width="160" height="100" loading="lazy" class="w-24 sm:w-28 h-20 rounded-xl object-cover shrink-0 border border-slate-100" />
                    <div class="min-w-0">
                      <span class="text-[9px] font-black uppercase text-emerald-800 bg-emerald-50 px-2 py-0.5 rounded border border-emerald-200 inline-block mb-1">Verified Stay</span>
                      <h4 class="font-bold text-slate-900 text-base leading-tight capitalize truncate">{hTitle}</h4>
                      <p class="text-xs text-slate-500 truncate mt-0.5">{hd.location || "Gulshan, Dhaka"}</p>
                    </div>
                  </div>

                  <div class="flex items-center justify-between sm:justify-end gap-4 w-full sm:w-auto pt-2 sm:pt-0 border-t sm:border-t-0 border-slate-100 shrink-0">
                    <div>
                      <span class="text-[10px] text-slate-400 block leading-none">Starting from</span>
                      <span class="text-base font-black text-slate-900">{hPrice.startsWith('$') || hPrice.startsWith('৳') ? hPrice : '$' + hPrice}</span>
                    </div>
                    <a href={`/${hSlug}`} class="inline-flex items-center gap-1.5 bg-[#0d3b23] hover:bg-[#061e14] text-white font-extrabold text-xs px-4 py-2.5 rounded-xl uppercase tracking-wider transition">
                      <span>View Hotel</span>
                      <svg class="w-3.5 h-3.5 fill-none stroke-current stroke-[2.5]" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
                    </a>
                  </div>
                </div>
              );
            })}
          </div>
        </div>
      )}

      <!-- CONCIERGE CALLOUT BANNER -->
      <div class="bg-[#0d3b23] text-white p-6 sm:p-8 rounded-3xl space-y-3 mt-8">
        <span class="text-emerald-300 text-xs font-black uppercase tracking-widest block">Direct Concierge</span>
        <h3 class="font-serif text-2xl font-black">Need Advice for Your Gulshan Visit?</h3>
        <p class="text-xs sm:text-sm text-emerald-100 font-normal leading-relaxed">
          Our local audit team verifies rates, embassy distances, and checkout policies daily. Contact our desk for hotel recommendations and airport pickups.
        </p>
        <div class="pt-2">
          <a href="/about" class="inline-flex items-center gap-2 bg-white hover:bg-emerald-50 text-slate-950 font-black text-xs px-6 py-3 rounded-xl uppercase tracking-wider transition">
            <span>Ask Our Concierge</span>
            <svg class="w-3.5 h-3.5 fill-none stroke-current stroke-[2.5]" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
          </a>
        </div>
      </div>

    </div>

    <!-- ======================================================== -->
    <!-- 🎯 ১. YOU MAY ALSO LIKE... (SVG Arrows & No Emojis) -->
    <!-- ======================================================== -->
    {relatedPosts.length > 0 && (
      <section class="w-full bg-[#fbfbfa] border-t border-slate-200/80 mt-16 pt-12 pb-14 text-slate-900">
        <div class="max-w-[1550px] mx-auto px-4 sm:px-8 lg:px-12 space-y-8">
          
          <div class="text-center">
            <h2 class="font-serif text-2xl sm:text-3xl lg:text-4xl font-black text-slate-800 tracking-tight">
              You may also like...
            </h2>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 text-left">
            {relatedPosts.map((rel: any) => {
              const rData = rel.data || {};
              const rSlug = rel.slug || rel.id?.replace(/\.md$/, '');
              const rImg = rData.image || "https://images.unsplash.com/photo-1542314831-068cd1dbfeeb?auto=format&fit=crop&w=600&q=75";

              return (
                <article class="group flex flex-col justify-between space-y-3">
                  <a href={`/blog/${rSlug}`} class="block space-y-3">
                    <div class="relative aspect-[16/10] w-full rounded-2xl overflow-hidden bg-slate-200">
                      <img 
                        src={rImg} 
                        alt={rData.title || "Related Guide"} 
                        loading="lazy" 
                        decoding="async" 
                        class="w-full h-full object-cover group-hover:scale-104 transition duration-500 ease-out" 
                      />
                    </div>

                    <h3 class="font-bold text-slate-900 text-base sm:text-lg leading-snug group-hover:text-emerald-800 transition-colors line-clamp-2">
                      {rData.title || "Gulshan Travel Guide"}
                    </h3>

                    <p class="text-xs text-slate-600 font-normal leading-relaxed line-clamp-2">
                      {rData.description || "Expert recommendations, embassy interview guides, and diplomatic stays."}
                    </p>
                  </a>

                  <!-- READ MORE Link with SVG Arrow -->
                  <div class="pt-1">
                    <a 
                      href={`/blog/${rSlug}`} 
                      class="inline-flex items-center gap-1 font-black text-xs uppercase tracking-wider text-[#b45d2a] hover:text-[#8c4318] transition-colors"
                    >
                      <span>READ MORE</span>
                      <svg class="w-3.5 h-3.5 fill-none stroke-current stroke-[3]" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
                    </a>
                  </div>
                </article>
              );
            })}
          </div>

        </div>
      </section>
    )}

    <!-- ======================================================== -->
    <!-- 🎯 ২. DISCOVER MORE (হালকা ব্র্যান্ড কালার শেড ব্যাকগ্রাউন্ড) -->
    <!-- ======================================================== -->
    <section class="w-full bg-[#edf4ef] py-12 text-slate-900 border-t border-b border-[#d5e4d8]">
      <div class="max-w-[1550px] mx-auto px-4 sm:px-8 lg:px-12 space-y-6">
        
        <!-- Big Bold Heading in Brand Color -->
        <div class="text-left">
          <h2 class="font-['Bebas_Neue',Impact,sans-serif] text-4xl sm:text-5xl lg:text-6xl text-[#0d3b23] tracking-wider">
            DISCOVER MORE
          </h2>
        </div>

        <!-- 4-Column Category Grid -->
        <div class="grid grid-cols-2 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6 text-left">
          {discoverCategories.map((cat) => (
            <a 
              href={cat.link} 
              class="group block space-y-2.5 cursor-pointer"
            >
              <div class="relative aspect-[16/10] w-full rounded-2xl overflow-hidden bg-slate-200 border border-emerald-950/10">
                <img 
                  src={cat.image} 
                  alt={cat.name} 
                  loading="lazy" 
                  decoding="async" 
                  class="w-full h-full object-cover group-hover:scale-105 transition duration-500 ease-out" 
                />
              </div>

              <h3 class="font-bold text-slate-900 text-sm sm:text-base group-hover:text-emerald-800 transition-colors">
                {cat.name}
              </h3>
            </a>
          ))}
        </div>

      </div>
    </section>

  </article>

</Layout>

<script is:inline>
  const initArticleInteractions = () => {
    const progressBar = document.getElementById('readingProgressBar');
    if (progressBar) {
      window.addEventListener('scroll', () => {
        const scrollTop = window.scrollY;
        const docHeight = document.documentElement.scrollHeight - window.innerHeight;
        const scrollPercent = docHeight > 0 ? (scrollTop / docHeight) * 100 : 0;
        progressBar.style.width = Math.min(Math.max(scrollPercent, 0), 100) + '%';
      }, { passive: true });
    }

    const copyBtn = document.getElementById('copyLinkBtn');
    const copyText = document.getElementById('copyLinkText');
    if (copyBtn && copyText && !copyBtn.dataset.bound) {
      copyBtn.dataset.bound = 'true';
      copyBtn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(window.location.href);
          copyText.innerText = 'Copied!';
          setTimeout(() => { copyText.innerText = 'Copy Link'; }, 2500);
        } catch (err) { copyText.innerText = 'Error'; }
      });
    }
  };

  document.addEventListener('DOMContentLoaded', initArticleInteractions);
  document.addEventListener('astro:page-load', initArticleInteractions);
</script>
