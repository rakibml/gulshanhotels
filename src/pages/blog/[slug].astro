---
// src/pages/blog/[slug].astro (World-Class Editorial Travel Guide Template)
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  let posts: any[] = [];
  try {
    const postCol = await getCollection('posts');
    if (Array.isArray(postCol) && postCol.length > 0) {
      posts = postCol;
    }
  } catch (e) {}

  if (posts.length === 0) {
    try {
      const rawGlob = import.meta.glob('../../content/posts/*.md', { eager: true });
      posts = Object.entries(rawGlob).map(([filePath, item]: [string, any]) => ({
        slug: filePath.split('/').pop()?.replace('.md', ''),
        data: item.frontmatter || {},
        render: async () => ({ Content: item.Content || item.default })
      }));
    } catch (e) {}
  }

  return posts.map(post => ({
    params: { slug: post.slug || post.id?.replace(/\.md$/, '') },
    props: { post, allPosts: posts }
  }));
}

const { post, allPosts = [] } = Astro.props;
const data = post?.data || {};

// মেটাডাটা
const title = data.title || "Gulshan Hotel & Travel Guide";
const description = data.description || "In-depth local guide for diplomats, corporate leaders, and luxury travelers in Gulshan, Dhaka.";
const publishDate = data.date || "Oct 2026";
const category = data.category || "Travel Guide";
const readTime = data.readTime || "4 min read";
const image = data.image || "https://images.unsplash.com/photo-1542314831-068cd1dbfeeb?auto=format&fit=crop&w=1200&q=80";
const author = data.author || "Gulshan Concierge Team";

// কি টেক-অ্যাওয়েস (যদি ফাইলে থাকে অথবা অটো ফলব্যাক)
const takeaways = Array.isArray(data.takeaways) && data.takeaways.length > 0 
  ? data.takeaways 
  : [
      "Gulshan 2 offers the highest diplomatic security and proximity to US/UK embassies.",
      "18-minute express connection to Dhaka Airport (DAC) via the Elevated Expressway.",
      "Top luxury 5-star properties include The Westin, Renaissance, and Amari Dhaka."
    ];

// সম্পর্কিত পোস্ট ফিল্টার
const currentSlug = post.slug || post.id?.replace(/\.md$/, '');
const relatedPosts = allPosts
  .filter((p: any) => (p.slug || p.id?.replace(/\.md$/, '')) !== currentSlug)
  .slice(0, 3);

// মার্কডাউন কনটেন্ট
const { Content } = post.render ? await post.render() : { Content: null };

// GOOGLE ARTICLE & BREADCRUMB SCHEMA
const siteUrl = Astro.url.href;
const schemaData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": Astro.url.origin },
        { "@type": "ListItem", "position": 2, "name": "Guides", "item": `${Astro.url.origin}/blog` },
        { "@type": "ListItem", "position": 3, "name": title, "item": siteUrl }
      ]
    },
    {
      "@type": "BlogPosting",
      "headline": title,
      "description": description,
      "image": image,
      "datePublished": publishDate,
      "dateModified": publishDate,
      "author": {
        "@type": "Person",
        "name": author,
        "jobTitle": "Local Hospitality Specialist"
      },
      "publisher": {
        "@type": "Organization",
        "name": "GulshanHotels.com",
        "url": Astro.url.origin
      }
    }
  ]
};
---

<Layout title={`${title} — GulshanHotels Guide`} description={description} image={image}>
  
  <!-- SCHEMA JSON-LD -->
  <script type="application/ld+json" set:html={JSON.stringify(schemaData)} />

  <!-- 1. TOP READING PROGRESS BAR (STICKY AT TOP) -->
  <div class="fixed top-0 left-0 w-full h-1 bg-transparent z-[100] pointer-events-none">
    <div id="readingProgressBar" class="h-full bg-emerald-700 w-0 transition-all duration-100 ease-out"></div>
  </div>

  <article class="w-full bg-white text-slate-900 pt-6 pb-20">
    <div class="max-w-[1550px] mx-auto px-4 sm:px-8 lg:px-12">
      
      <!-- BREADCRUMBS -->
      <nav class="flex items-center gap-2 text-xs font-semibold text-slate-400 py-3 text-left">
        <a href="/" class="hover:text-emerald-800 transition">Home</a>
        <span>/</span>
        <a href="/#hotels" class="hover:text-emerald-800 transition">Travel Guides</a>
        <span>/</span>
        <span class="text-slate-800 truncate max-w-xs">{title}</span>
      </nav>

      <!-- EDITORIAL ARTICLE HEADER -->
      <header class="max-w-4xl mx-auto text-left pt-3 pb-6 space-y-4">
        
        <!-- Tags & Meta -->
        <div class="flex flex-wrap items-center gap-2.5 sm:gap-3">
          <span class="bg-emerald-50 text-emerald-800 text-[11px] font-black uppercase tracking-wider px-3 py-1 rounded-full border border-emerald-200">
            {category}
          </span>
          <span class="text-xs text-slate-400 font-medium flex items-center gap-1">
            <span>📅 Updated:</span>
            <span class="text-slate-700 font-bold">{publishDate}</span>
          </span>
          <span class="text-xs text-slate-400 font-medium">
            • ⏱️ {readTime}
          </span>
          <span class="inline-flex items-center gap-1 text-[11px] font-bold text-emerald-700 bg-emerald-50/70 px-2.5 py-0.5 rounded-md border border-emerald-100">
            ✓ Fact-Checked
          </span>
        </div>

        <!-- Headline -->
        <h1 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-black text-slate-900 tracking-tight leading-tight">
          {title}
        </h1>

        <!-- Subtitle / Excerpt -->
        <p class="text-base sm:text-lg text-slate-600 font-normal leading-relaxed">
          {description}
        </p>

        <!-- AUTHOR & SHARE BAR ROW -->
        <div class="pt-3 border-t border-slate-100 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
          
          <!-- Author Info -->
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-full bg-[#0d3b23] text-white flex items-center justify-center font-black text-sm shrink-0">
              {author.charAt(0)}
            </div>
            <div class="text-xs text-left">
              <span class="font-bold text-slate-900 block">{author}</span>
              <span class="text-slate-400">Gulshan Local Inspection Specialist</span>
            </div>
          </div>

          <!-- Quick Social Share Buttons -->
          <div class="flex items-center gap-2 text-xs">
            <span class="text-slate-400 font-bold text-[11px] uppercase mr-1">Share:</span>
            
            <!-- WhatsApp -->
            <a 
              href={`https://api.whatsapp.com/send?text=${encodeURIComponent(title + ' ' + siteUrl)}`} 
              target="_blank" 
              rel="noopener noreferrer"
              class="w-8 h-8 rounded-full bg-[#25D366] text-white flex items-center justify-center hover:opacity-90 transition shadow-xs cursor-pointer"
              title="Share on WhatsApp"
            >
              <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M12.012 2c-5.506 0-9.989 4.478-9.99 9.984 0 1.763.459 3.48 1.332 5.001l-1.416 5.163 5.281-1.388c1.464.798 3.118 1.22 4.79 1.22h.004c5.506 0 9.989-4.478 9.99-9.984 0-2.668-1.038-5.176-2.923-7.062a9.923 9.923 0 0 0-7.058-2.934z"/></svg>
            </a>

            <!-- Facebook -->
            <a 
              href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(siteUrl)}`} 
              target="_blank" 
              rel="noopener noreferrer"
              class="w-8 h-8 rounded-full bg-[#1877F2] text-white flex items-center justify-center hover:opacity-90 transition shadow-xs cursor-pointer"
              title="Share on Facebook"
            >
              <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 3.865 10.99 9.1 11.823v-8.367h-3.04v-3.456h3.04v-2.636c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953h-1.513c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.456h-2.796v8.367c5.235-.833 9.1-5.833 9.1-11.823z"/></svg>
            </a>

            <!-- Copy Link Button with Toast Feedback -->
            <button 
              id="copyLinkBtn"
              type="button" 
              class="h-8 px-3 rounded-full bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-xs flex items-center gap-1.5 transition cursor-pointer"
            >
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
              <span id="copyLinkText">Copy Link</span>
            </button>
          </div>

        </div>

      </header>

      <!-- FEATURED HERO IMAGE -->
      <div class="max-w-4xl mx-auto my-6">
        <div class="relative aspect-[16/9] rounded-3xl overflow-hidden bg-slate-100 border border-slate-200/80">
          <img 
            src={image} 
            alt={title}
            width="1200"
            height="675"
            fetchpriority="high"
            decoding="async"
            class="w-full h-full object-cover"
          />
        </div>
        <p class="text-[11px] text-slate-400 text-left mt-2 italic">
          Featured: Accommodations and surroundings in the Diplomatic Enclave, Gulshan, Dhaka.
        </p>
      </div>

      <!-- KEY TAKEAWAYS / EXECUTIVE SUMMARY (GOOGLE FEATURED SNIPPET GOLDMINE) -->
      <div class="max-w-3xl mx-auto my-8 bg-slate-50 border border-slate-200/90 rounded-2xl p-5 sm:p-6 text-left space-y-3">
        <div class="flex items-center gap-2 text-slate-900 font-bold text-sm uppercase tracking-wider">
          <span class="text-emerald-700 text-base">📌</span>
          <span>Key Takeaways at a Glance:</span>
        </div>
        <ul class="space-y-2 text-xs sm:text-sm text-slate-700 font-medium">
          {takeaways.map((item: string) => (
            <li class="flex items-start gap-2.5">
              <span class="text-emerald-700 font-bold text-sm shrink-0">✓</span>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </div>

      <!-- 2-COLUMN MAIN ARTICLE LAYOUT (LEFT: ARTICLE, RIGHT: STICKY TOC / CONCIERGE) -->
      <div class="max-w-4xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 text-left pt-2">
        
        <!-- ARTICLE MAIN TEXT (lg:col-span-8) -->
        <div class="lg:col-span-8 space-y-6">
          <div 
            id="articleBodyContent" 
            class="prose prose-slate max-w-none prose-headings:font-serif prose-headings:font-black prose-headings:text-slate-900 prose-p:text-slate-700 prose-p:leading-relaxed prose-a:text-emerald-800 prose-a:font-bold hover:prose-a:underline prose-img:rounded-2xl prose-strong:text-slate-900"
          >
            {Content ? <Content /> : (
              <div>
                <h2>Why Gulshan is Dhaka's Premier Stay Destination</h2>
                <p>
                  For international business executives, foreign diplomats, and non-resident Bangladeshis, Gulshan offers an unparalleled combination of 24/7 diplomatic security, peaceful lakefront walkways, and world-class 5-star hospitality.
                </p>

                <!-- CONCIERGE TIP CALLOUT BOX -->
                <div class="not-prose my-6 p-4 rounded-xl bg-amber-50/80 border-l-4 border-amber-500 text-amber-950 text-xs sm:text-sm space-y-1">
                  <div class="font-black flex items-center gap-1.5">
                    <span>💡 Local Concierge Secret:</span>
                  </div>
                  <p class="font-medium text-slate-700 leading-relaxed">
                    Always arrange your airport pickup directly with your hotel in advance. With the Dhaka Elevated Expressway, transit takes only 18 minutes directly from the terminal to Gulshan 2.
                  </p>
                </div>

                <h2>Navigating Gulshan 1 vs Gulshan 2</h2>
                <p>
                  When selecting your property, consider the unique characteristics of each circle: Gulshan 1 is the commercial hub close to multinational corporate headquarters and shopping centers like DCC Market, while Gulshan 2 is the quiet diplomatic haven home to luxury lakeside properties and premier embassies.
                </p>
              </div>
            )}
          </div>

          <!-- ARTICLE END CONCIERGE CALLOUT -->
          <div class="bg-[#0d3b23] text-white p-6 sm:p-8 rounded-3xl space-y-3 mt-10">
            <span class="text-emerald-300 text-xs font-black uppercase tracking-widest block">Direct Booking Concierge</span>
            <h3 class="font-serif text-2xl sm:text-3xl font-black">Planning Your Visit to Gulshan?</h3>
            <p class="text-xs sm:text-sm text-emerald-100 font-normal leading-relaxed">
              Our local audit team verifies rates, embassy distances, and checkout policies daily. Explore handpicked 5-star hotels and boutique stays with zero booking markups.
            </p>
            <div class="pt-2">
              <a href="/#hotels" class="inline-block bg-white hover:bg-emerald-50 text-slate-950 font-black text-xs px-6 py-3 rounded-xl uppercase tracking-wider transition">
                Explore Verified Hotels ➔
              </a>
            </div>
          </div>
        </div>

        <!-- RIGHT SIDEBAR: STICKY QUICK NAVIGATION & RECOMMENDATION (lg:col-span-4) -->
        <aside class="lg:col-span-4 space-y-6 lg:sticky lg:top-24">
          
          <!-- Quick Jump Box -->
          <div class="p-5 rounded-2xl bg-slate-50 border border-slate-200/90 space-y-3">
            <span class="text-xs font-black uppercase tracking-wider text-slate-900 block border-b border-slate-200 pb-2">
              🧭 Quick Travel Navigation
            </span>
            <ul class="space-y-2 text-xs font-bold text-slate-700">
              <li><a href="/#hotels" class="hover:text-emerald-800 transition flex items-center justify-between"><span>🏨 Popular Gulshan Hotels</span> <span>➔</span></a></li>
              <li><a href="/#deals" class="hover:text-emerald-800 transition flex items-center justify-between"><span>🔥 Top Price Drop Deals</span> <span>➔</span></a></li>
              <li><a href="/#gulshan-lifestyle" class="hover:text-emerald-800 transition flex items-center justify-between"><span>🌳 Parks & Wellness Spas</span> <span>➔</span></a></li>
              <li><a href="/#faq" class="hover:text-emerald-800 transition flex items-center justify-between"><span>❓ Gulshan Stay FAQs</span> <span>➔</span></a></li>
            </ul>
          </div>

          <!-- Fast Assistance Widget -->
          <div class="p-5 rounded-2xl bg-emerald-50/70 border border-emerald-200 text-left space-y-2">
            <div class="flex items-center gap-2 text-emerald-900 font-bold text-xs uppercase">
              <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
              <span>Need Quick Assistance?</span>
            </div>
            <p class="text-xs text-slate-600 leading-relaxed font-normal">
              Have questions about foreign embassy appointments or airport pickups?
            </p>
            <a href="/about" class="inline-block text-xs font-black text-emerald-900 underline hover:text-emerald-700">
              Contact Local Concierge Team ➔
            </a>
          </div>

        </aside>

      </div>

      <!-- RELATED GUIDES & ARTICLES SECTION -->
      {relatedPosts.length > 0 && (
        <div class="max-w-4xl mx-auto mt-16 pt-10 border-t border-slate-200 text-left space-y-6">
          <div class="space-y-1">
            <h3 class="font-serif text-2xl sm:text-3xl font-black text-slate-900">Related Gulshan Travel Guides</h3>
            <p class="text-xs text-slate-500">Continue exploring recommendations from our local hospitality team.</p>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-3 gap-5">
            {relatedPosts.map((rel: any) => {
              const rData = rel.data || {};
              const rSlug = rel.slug || rel.id?.replace(/\.md$/, '');
              const rImg = rData.image || "https://images.unsplash.com/photo-1542314831-068cd1dbfeeb?auto=format&fit=crop&w=500&q=75";

              return (
                <a href={`/blog/${rSlug}`} class="group block space-y-2 cursor-pointer">
                  <div class="relative aspect-[16/10] w-full rounded-2xl overflow-hidden bg-slate-100 border border-slate-200/80">
                    <img 
                      src={rImg} 
                      alt={rData.title || "Related Guide"} 
                      loading="lazy" 
                      decoding="async" 
                      class="w-full h-full object-cover group-hover:scale-104 transition duration-300"
                    />
                  </div>
                  <span class="text-[10px] font-black uppercase text-emerald-800 tracking-wider block">{rData.category || "Guide"}</span>
                  <h4 class="font-bold text-slate-900 text-sm leading-snug group-hover:text-emerald-800 transition line-clamp-2">
                    {rData.title || "Gulshan Hotel Guide"}
                  </h4>
                </a>
              );
            })}
          </div>
        </div>
      )}

    </div>
  </article>

</Layout>

<!-- READING PROGRESS & COPY LINK INTERACTION SCRIPT -->
<script is:inline>
  const initArticleInteractions = () => {
    // 1. Reading Progress Bar
    const progressBar = document.getElementById('readingProgressBar');
    if (progressBar) {
      window.addEventListener('scroll', () => {
        const scrollTop = window.scrollY;
        const docHeight = document.documentElement.scrollHeight - window.innerHeight;
        const scrollPercent = docHeight > 0 ? (scrollTop / docHeight) * 100 : 0;
        progressBar.style.width = Math.min(Math.max(scrollPercent, 0), 100) + '%';
      }, { passive: true });
    }

    // 2. Copy Link Button with Temporary Feedback
    const copyBtn = document.getElementById('copyLinkBtn');
    const copyText = document.getElementById('copyLinkText');
    if (copyBtn && copyText && !copyBtn.dataset.bound) {
      copyBtn.dataset.bound = 'true';
      copyBtn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(window.location.href);
          copyText.innerText = 'Copied! ✓';
          setTimeout(() => { copyText.innerText = 'Copy Link'; }, 2500);
        } catch (err) {
          copyText.innerText = 'Error';
        }
      });
    }
  };

  document.addEventListener('DOMContentLoaded', initArticleInteractions);
  document.addEventListener('astro:page-load', initArticleInteractions);
</script>
