---
// src/pages/blog/index.astro (Magazine-Grade Travel Guides & Blog Hub - Cloudflare Safe & Pure SVGs)
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

// ১. ক্লাউডফ্লেয়ার ও লোকাল সেফ ব্লগ ডাটা লোডার
let allPosts: any[] = [];
try {
  const postCol = await getCollection('posts');
  if (Array.isArray(postCol) && postCol.length > 0) {
    allPosts = postCol.map(p => ({
      slug: (p.slug || p.id || '').replace(/\.(md|mdx)$/, '').split('/').pop()?.toLowerCase(),
      data: p.data || {}
    }));
  }
} catch (e) {
  allPosts = [];
}

if (allPosts.length === 0) {
  try {
    const rawGlob = import.meta.glob(['/src/content/posts/*.{md,mdx}', '../../content/posts/*.{md,mdx}'], { eager: true });
    allPosts = Object.entries(rawGlob).map(([filePath, item]: [string, any]) => ({
      slug: filePath.split('/').pop()?.replace(/\.(md|mdx)$/, '')?.toLowerCase(),
      data: item?.frontmatter || item?.data || {}
    }));
  } catch (e) {
    allPosts = [];
  }
}

// ২. তারিখ অনুযায়ী সর্টিং (নতুন পোস্ট সবার আগে)
const sortedPosts = allPosts.sort((a, b) => {
  const dateA = new Date(a.data?.date || 0).getTime();
  const dateB = new Date(b.data?.date || 0).getTime();
  return dateB - dateA;
});

// ৩. ১ম পোস্ট ফিচার্ড, বাকিগুলো নিয়মিত গ্রিডে (ডুপ্লিকেট বন্ধ)
const featuredPost = sortedPosts[0] || null;
const regularPosts = sortedPosts.slice(1);

// ৪. শুধুমাত্র যেসব ক্যাটাগরিতে আসল পোস্ট আছে সেগুলোই স্বয়ংক্রিয়ভাবে ফিল্টারে আসবে
const dynamicCategories = Array.from(
  new Set(
    sortedPosts
      .map(p => (p.data?.category || "").trim())
      .filter(Boolean)
  )
);
const categories = ["All", ...dynamicCategories];

const siteOrigin = "https://gulshanhotels.com";
---

<Layout 
  title="Gulshan Travel Guides & Local Insights — GulshanHotels.com"
  description="Expert local guides, foreign embassy stay advice, airport expressway transit tips, and luxury hotel reviews in Gulshan, Dhaka."
>

  <!-- BLOG HUB MAIN CONTAINER -->
  <div class="w-full bg-white text-slate-900 pt-6 pb-20">
    <div class="max-w-[1550px] mx-auto px-3 sm:px-8 lg:px-12 space-y-8 sm:space-y-10">
      
      <!-- BREADCRUMB -->
      <nav aria-label="Breadcrumb" class="flex items-center gap-2 text-xs font-semibold text-slate-400 text-left">
        <a href="/" class="hover:text-emerald-800 transition">Home</a>
        <span>/</span>
        <span class="text-slate-800" aria-current="page">Travel Guides & Insights</span>
      </nav>

      <!-- PAGE HEADER & LIVE SEARCH -->
      <header class="flex flex-col md:flex-row justify-between items-start md:items-end gap-6 text-left border-b border-slate-100 pb-8">
        <div class="space-y-2 max-w-2xl">
          <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-50 text-emerald-800 text-[11px] font-black uppercase tracking-wider">
            <svg class="w-3.5 h-3.5 fill-emerald-700 shrink-0" viewBox="0 0 24 24">
              <path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-5 14H7v-2h7v2zm3-4H7v-2h10v2zm0-4H7V7h10v2z"/>
            </svg>
            <span>Editorial Travel Hub</span>
          </div>
          <h1 class="text-2xl sm:text-4xl lg:text-5xl font-serif font-black text-slate-900 tracking-tight leading-tight">
            Gulshan Travel Guides & Insights
          </h1>
          <p class="text-xs sm:text-sm text-slate-500 font-medium">
            Verified local advice on embassy routes, airport elevated expressway transit, and 5-star lodging.
          </p>
        </div>

        <!-- SEARCH INPUT WITH VECTOR SVG ICON -->
        <div class="w-full md:w-80 relative">
          <input 
            type="text" 
            id="blogSearchInput"
            placeholder="Search guides, tips, areas..."
            class="w-full bg-slate-50 border border-slate-200 focus:border-emerald-700 rounded-full pl-5 pr-11 py-3 text-xs sm:text-sm font-semibold text-slate-800 placeholder-slate-400 outline-none transition shadow-2xs"
          />
          <button type="button" aria-label="Search" class="absolute right-4 top-1/2 -translate-y-1/2 text-slate-400 hover:text-emerald-800 transition">
            <svg class="w-4 h-4 fill-current shrink-0" viewBox="0 0 24 24">
              <path d="M15.5 14h-.79l-.28-.27A6.471 6.471 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/>
            </svg>
          </button>
        </div>
      </header>

      <!-- DYNAMIC CATEGORY FILTER PILLS -->
      {categories.length > 1 && (
        <div class="flex items-center gap-2 overflow-x-auto scroll-smooth pb-1 text-left [scrollbar-width:none] [-ms-overflow-style:none] [&::-webkit-scrollbar]:hidden">
          {categories.map((cat, idx) => (
            <button 
              type="button"
              data-cat={cat.toLowerCase()}
              class={`blog-cat-btn shrink-0 px-4 py-2 rounded-full text-xs font-bold transition-all cursor-pointer border select-none ${
                idx === 0 
                  ? 'bg-[#0d3b23] text-white border-[#0d3b23] shadow-xs' 
                  : 'bg-white text-slate-600 border-slate-200 hover:border-slate-800 hover:text-slate-900'
              }`}
            >
              {cat}
            </button>
          ))}
        </div>
      )}

      <!-- 1. BIG FEATURED POST (ONLY SHOWN WHEN NO FILTER ACTIVE) -->
      {featuredPost && (
        <section 
          id="featuredPostSection" 
          class="w-full text-left"
          data-category={(featuredPost.data?.category || "").toLowerCase()}
          data-title={(featuredPost.data?.title || "").toLowerCase()}
        >
          <a 
            href={`/blog/${featuredPost.slug}`}
            class="group block bg-slate-50/70 rounded-3xl border border-slate-200/90 overflow-hidden p-4 sm:p-8 lg:p-10 hover:border-emerald-600/40 hover:shadow-xl transition-all duration-300"
          >
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-8 items-center">
              
              <!-- Featured Image -->
              <div class="lg:col-span-7 relative aspect-[16/10] rounded-2xl overflow-hidden bg-slate-900">
                <img 
                  src={featuredPost.data?.image || "https://images.unsplash.com/photo-1542314831-068cd1dbfeeb?auto=format&fit=crop&w=1200&q=80"} 
                  alt={featuredPost.data?.title || "Featured Guide"} 
                  fetchpriority="high"
                  width="800"
                  height="500"
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 ease-out" 
                />
                <div class="absolute top-3 left-3 bg-[#0d3b23] text-white text-[10px] font-black uppercase tracking-wider px-3 py-1 rounded-full shadow-sm flex items-center gap-1.5">
                  <svg class="w-3 h-3 fill-amber-400 shrink-0" viewBox="0 0 24 24">
                    <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/>
                  </svg>
                  <span>Featured Editorial Guide</span>
                </div>
              </div>

              <!-- Featured Content -->
              <div class="lg:col-span-5 space-y-3 sm:space-y-4">
                <div class="flex items-center gap-2 text-xs font-bold text-slate-500">
                  <span class="text-emerald-800 uppercase tracking-wider">{featuredPost.data?.category || "Travel Guide"}</span>
                  <span>•</span>
                  <span>{featuredPost.data?.date || "Recent"}</span>
                  <span>•</span>
                  <span>{featuredPost.data?.readTime || "4 min read"}</span>
                </div>

                <h2 class="font-serif text-xl sm:text-3xl lg:text-4xl font-black text-slate-900 tracking-tight leading-tight group-hover:text-emerald-800 transition-colors">
                  {featuredPost.data?.title}
                </h2>

                <p class="text-xs sm:text-sm text-slate-600 font-normal leading-relaxed line-clamp-3">
                  {featuredPost.data?.description}
                </p>

                <div class="pt-2">
                  <span class="inline-flex items-center gap-1.5 font-black text-xs uppercase tracking-wider text-[#0d3b23] group-hover:text-emerald-700">
                    <span>Read Full Guide</span>
                    <span class="group-hover:translate-x-1 transition-transform">➔</span>
                  </span>
                </div>
              </div>

            </div>
          </a>
        </section>
      )}

      <!-- 2. REGULAR POSTS GRID (2-COLS ON MOBILE, 3-COLS ON DESKTOP) -->
      <section class="space-y-6 text-left">
        <h3 class="text-lg sm:text-2xl font-serif font-black text-slate-900 tracking-tight">
          All Guides & Articles
        </h3>

        <!-- MOBILE SIDE-BY-SIDE 2-COLS, DESKTOP 3-COLS -->
        <div id="postsGridContainer" class="grid grid-cols-2 lg:grid-cols-3 gap-3.5 sm:gap-6 lg:gap-8">
          {regularPosts.map((post: any) => {
            const pData = post.data || {};
            const pSlug = post.slug;
            const pTitle = pData.title || "Gulshan Travel Guide";
            const pCat = pData.category || "Travel Guide";
            const pImg = pData.image || "https://images.unsplash.com/photo-1542314831-068cd1dbfeeb?auto=format&fit=crop&w=600&q=75";

            return (
              <article 
                class="post-card group flex flex-col justify-between bg-white rounded-2xl border border-slate-200 overflow-hidden shadow-xs hover:shadow-xl hover:border-emerald-600/40 transition-all duration-300"
                data-category={pCat.toLowerCase()}
                data-title={pTitle.toLowerCase()}
              >
                <div>
                  <!-- Thumbnail Photo -->
                  <a href={`/blog/${pSlug}`} class="block relative aspect-[16/10] w-full overflow-hidden bg-slate-900">
                    <img 
                      src={pImg} 
                      alt={pTitle} 
                      loading="lazy" 
                      decoding="async" 
                      width="500"
                      height="312"
                      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 ease-out" 
                    />
                    <div class="absolute top-2 left-2 bg-white/95 backdrop-blur-md text-slate-900 text-[8px] sm:text-[10px] font-black uppercase tracking-wider px-2 py-0.5 rounded border border-slate-200">
                      {pCat}
                    </div>
                  </a>

                  <!-- Text Details -->
                  <div class="p-2.5 sm:p-4 space-y-1 sm:space-y-1.5">
                    <div class="flex items-center gap-2 text-[9px] sm:text-[11px] font-semibold text-slate-400">
                      <span>{pData.date || "Recent"}</span>
                      <span>•</span>
                      <span>{pData.readTime || "4 min read"}</span>
                    </div>

                    <h4 class="font-serif text-xs sm:text-lg font-black text-slate-900 leading-snug group-hover:text-emerald-800 transition-colors line-clamp-2">
                      <a href={`/blog/${pSlug}`}>
                        {pTitle}
                      </a>
                    </h4>

                    <p class="text-[10px] sm:text-xs text-slate-500 font-normal line-clamp-2 leading-relaxed hidden sm:block">
                      {pData.description || "In-depth guidance and local inspection details."}
                    </p>
                  </div>
                </div>

                <!-- Footer link -->
                <div class="p-2.5 sm:p-4 pt-0">
                  <a 
                    href={`/blog/${pSlug}`} 
                    class="inline-flex items-center gap-1 text-[10px] sm:text-xs font-black uppercase tracking-wider text-[#0d3b23] group-hover:underline pt-2 border-t border-slate-100 w-full justify-between"
                  >
                    <span>Read Guide</span>
                    <span>➔</span>
                  </a>
                </div>

              </article>
            );
          })}
        </div>

        <!-- No Results Fallback with Vector SVG (No Emoji) -->
        <div id="noPostsFoundMsg" class="hidden py-16 text-center space-y-3 bg-slate-50 rounded-3xl border border-dashed border-slate-300">
          <div class="w-12 h-12 mx-auto rounded-full bg-white border border-slate-200 flex items-center justify-center text-slate-400 shadow-xs">
            <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24">
              <path d="M15.5 14h-.79l-.28-.27A6.471 6.471 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/>
            </svg>
          </div>
          <p class="text-sm font-bold text-slate-700">No articles found matching your filter.</p>
          <button id="resetFilterBtn" type="button" class="text-xs font-black uppercase tracking-wider text-emerald-800 underline cursor-pointer">
            Show All Guides ➔
          </button>
        </div>
      </section>

    </div>
  </div>

</Layout>

<!-- CLIENT SCRIPT (FILTER WITH FEATURED BANNER SYNC) -->
<script is:inline>
  const initBlogFilter = () => {
    const input = document.getElementById('blogSearchInput');
    const catBtns = document.querySelectorAll('.blog-cat-btn');
    const cards = document.querySelectorAll('.post-card');
    const featuredSection = document.getElementById('featuredPostSection');
    const noResults = document.getElementById('noPostsFoundMsg');
    const resetBtn = document.getElementById('resetFilterBtn');

    let currentCat = 'all';

    function applyFilter() {
      const query = (input?.value || '').trim().toLowerCase();
      let matchCount = 0;

      // Filter featured post if present
      if (featuredSection) {
        const featTitle = featuredSection.getAttribute('data-title') || '';
        const featCat = featuredSection.getAttribute('data-category') || '';
        const featMatches = (!query || featTitle.includes(query)) && (currentCat === 'all' || featCat.includes(currentCat));
        
        // Hide featured big banner if filtered out or searching
        if (query.length > 0 || currentCat !== 'all') {
          if (featMatches) {
            featuredSection.classList.remove('hidden');
            matchCount++;
          } else {
            featuredSection.classList.add('hidden');
          }
        } else {
          featuredSection.classList.remove('hidden');
          matchCount++;
        }
      }

      // Filter grid cards
      cards.forEach(card => {
        const title = card.getAttribute('data-title') || '';
        const cat = card.getAttribute('data-category') || '';

        const matchesQuery = !query || title.includes(query);
        const matchesCat = currentCat === 'all' || cat.includes(currentCat);

        if (matchesQuery && matchesCat) {
          card.classList.remove('hidden');
          matchCount++;
        } else {
          card.classList.add('hidden');
        }
      });

      if (noResults) {
        if (matchCount === 0) noResults.classList.remove('hidden');
        else noResults.classList.add('hidden');
      }
    }

    catBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        currentCat = (btn.getAttribute('data-cat') || 'all').toLowerCase();

        catBtns.forEach(b => {
          b.classList.remove('bg-[#0d3b23]', 'text-white', 'border-[#0d3b23]', 'shadow-xs');
          b.classList.add('bg-white', 'text-slate-600', 'border-slate-200');
        });
        btn.classList.remove('bg-white', 'text-slate-600', 'border-slate-200');
        btn.classList.add('bg-[#0d3b23]', 'text-white', 'border-[#0d3b23]', 'shadow-xs');

        applyFilter();
      });
    });

    if (input) {
      input.addEventListener('input', applyFilter);
    }

    if (resetBtn) {
      resetBtn.addEventListener('click', () => {
        if (input) input.value = '';
        currentCat = 'all';
        catBtns[0]?.click();
      });
    }
  };

  document.addEventListener('DOMContentLoaded', initBlogFilter);
  document.addEventListener('astro:page-load', initBlogFilter);
</script>
