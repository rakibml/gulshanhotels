---
// src/pages/[slug].astro
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const hotels = await getCollection('hotels');
  return hotels.map((entry: any) => ({
    params: { slug: entry.id || entry.slug },
    props: { hotel: entry },
  }));
}

const { hotel } = Astro.props;
const data = hotel.data || {};

// 100% Real CMS Frontmatter Data (Zero Demo/Fake Fallbacks)
const hotelTitle = data.title || data.name || "Hotel Details";
const hotelCategory = data.category;
const hotelLocation = data.location;
const hotelPrice = data.price;
const hotelRating = data.rating;
const reviewsCount = data.reviewsCount;
const hotelImage = data.image;

// Gallery Images (Only real images from CMS)
const galleryImages = (data.gallery && data.gallery.length > 0) 
  ? data.gallery 
  : (hotelImage ? [hotelImage] : []);

// Amenities (Only real items from CMS)
const amenitiesList = data.amenities || [];

// Nearby Places (Only real items from CMS)
const nearbyPlaces = data.nearby_places || [];

// FAQs (Only real items from CMS)
const faqList = data.faqs || [];
const halfFaqIndex = Math.ceil(faqList.length / 2);
const leftColumnFaqs = faqList.slice(0, halfFaqIndex);
const rightColumnFaqs = faqList.slice(halfFaqIndex);

// Section Toggles from Admin Panel
const showRates = data.enable_rates !== false;
const showAmenities = data.enable_amenities !== false && amenitiesList.length > 0;
const showNearby = data.enable_nearby !== false && nearbyPlaces.length > 0;
const showDetails = data.enable_details !== false;
const showRules = data.enable_rules !== false;
const showFaqs = data.enable_faqs !== false && faqList.length > 0;
const customSections = data.custom_sections || [];

// Dynamic Google FAQ Schema
const faqSchema = faqList.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqList.map((item: any) => ({
    "@type": "Question",
    "name": item.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.answer
    }
  }))
} : null;
---

<Layout title={`${hotelTitle} — Verified Hotel in Gulshan, Dhaka`}>

  <!-- GOOGLE FAQ SCHEMA -->
  {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}

  <!-- 1. TOP HEADER & BREADCRUMB -->
  <section class="bg-[#f7f5f0] text-slate-900 pt-6 sm:pt-8 pb-5 sm:pb-6 px-3.5 sm:px-8 border-b border-slate-200">
    <div class="max-w-[1400px] mx-auto space-y-3">
      
      <!-- Breadcrumb -->
      <div class="flex items-center gap-1.5 sm:gap-2 text-[11px] sm:text-xs text-slate-500 overflow-x-auto whitespace-nowrap">
        <a href="/" class="hover:text-emerald-700 transition">Home</a>
        <span>/</span>
        <a href="/#all-hotels" class="hover:text-emerald-700 transition">Gulshan Hotels</a>
        <span>/</span>
        <span class="text-slate-800 font-bold">{hotelTitle}</span>
      </div>

      <div>
        {hotelCategory && (
          <span class="bg-emerald-100 text-emerald-800 border border-emerald-300 text-[10px] sm:text-xs font-black uppercase tracking-widest px-2.5 py-0.5 sm:px-3 sm:py-1 rounded-full inline-block mb-2">
            {hotelCategory}
          </span>
        )}

        <!-- Main Title -->
        <h1 class="text-2xl sm:text-4xl lg:text-5xl font-black font-serif text-slate-900 leading-tight">{hotelTitle}</h1>
        
        {hotelLocation && (
          <p class="text-xs sm:text-sm text-slate-600 mt-2 flex flex-wrap items-center gap-2 font-medium">
            <span class="flex items-center gap-1">
              <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4 fill-emerald-600 shrink-0" viewBox="0 0 24 24"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>
              {hotelLocation}
            </span>
            {hotelRating && (
              <>
                <span>•</span>
                <span class="text-amber-600 font-bold flex items-center gap-1">
                  <svg class="w-3.5 h-3.5 fill-amber-500" viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
                  {hotelRating}
                </span>
                {reviewsCount && <span class="text-slate-500">({reviewsCount} reviews)</span>}
              </>
            )}
          </p>
        )}
      </div>

    </div>
  </section>

  <!-- 2. PHOTO GALLERY -->
  {galleryImages.length > 0 && (
    <section class="py-4 sm:py-6 px-3.5 sm:px-8 max-w-[1400px] mx-auto">
      <div class="grid grid-cols-1 md:grid-cols-4 gap-2.5 sm:gap-3 rounded-2xl sm:rounded-3xl overflow-hidden shadow-sm">
        
        <div class="md:col-span-2 h-[260px] sm:h-[380px] lg:h-[420px] relative overflow-hidden group">
          <img 
            src={galleryImages[0]} 
            alt={hotelTitle} 
            class="w-full h-full object-cover group-hover:scale-105 transition duration-500" 
          />
        </div>

        <div class="hidden md:grid md:col-span-2 grid-cols-2 gap-2.5 sm:gap-3 h-[380px] lg:h-[420px]">
          {galleryImages.slice(1, 5).map((img: string, idx: number) => (
            <div class="h-[185px] lg:h-[204px] relative overflow-hidden group rounded-xl">
              <img 
                src={img} 
                alt={`${hotelTitle} photo ${idx+2}`} 
                loading="lazy"
                decoding="async"
                class="w-full h-full object-cover group-hover:scale-105 transition duration-500" 
              />
            </div>
          ))}
        </div>

      </div>
    </section>
  )}

  <!-- MAIN PAGE CONTENT -->
  <section class="py-4 sm:py-6 pb-24 lg:pb-12 px-3.5 sm:px-8 max-w-[1400px] mx-auto grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10">
    
    <!-- LEFT MAIN COLUMN -->
    <div class="lg:col-span-8 space-y-8 sm:space-y-10 text-slate-800">
      
      <!-- 1. OVERVIEW (WITH AUTOMATIC 150-WORD READ MORE TOGGLE) -->
      <div id="overview" class="border-b border-slate-200 pb-6 sm:pb-8 space-y-3">
        <h2 class="text-xl sm:text-3xl font-black font-serif text-slate-900 border-b border-slate-200 pb-3">Hotel Overview</h2>
        
        <div id="overview-text" class="prose prose-slate text-sm sm:text-base leading-relaxed text-slate-700">
          {hotel.body ? <Fragment set:html={hotel.body} /> : (
            <p>
              Located in the heart of Gulshan, <strong>{hotelTitle}</strong> offers executive lodging with world-class hospitality, high-speed Wi-Fi, fine dining restaurants, and easy access to foreign embassies, commercial corporate headquarters, and shopping plazas.
            </p>
          )}
        </div>

        <!-- READ MORE / READ LESS BUTTON (AUTOMATICALLY SHOWN VIA JS IF > 150 WORDS) -->
        <button 
          id="toggleOverviewBtn" 
          class="hidden mt-3 text-xs sm:text-sm font-black text-emerald-700 hover:text-emerald-800 transition inline-flex items-center gap-1.5 cursor-pointer bg-emerald-50 hover:bg-emerald-100 px-4 py-2 rounded-xl border border-emerald-200 shadow-sm"
        >
          Read More ➔
        </button>
      </div>

      <!-- 2. LOCATION & LIVE GOOGLE MAP -->
      {hotelLocation && (
        <div id="location" class="border-b border-slate-200 pb-6 sm:pb-8 space-y-3.5 sm:space-y-4">
          <div>
            <h2 class="text-xl sm:text-3xl font-black font-serif text-slate-900">Location & Map</h2>
            <p class="text-xs sm:text-sm text-slate-600 mt-1 flex items-center gap-1.5 font-medium">
              <svg class="w-4 h-4 fill-emerald-600 shrink-0" viewBox="0 0 24 24"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>
              {hotelLocation}
            </p>
          </div>

          <div class="rounded-2xl overflow-hidden border border-slate-200 h-60 sm:h-80 shadow-sm">
            <iframe 
              src={`https://maps.google.com/maps?q=${encodeURIComponent(hotelTitle + ' ' + hotelLocation)}&t=&z=15&ie=UTF8&iwloc=&output=embed`}
              class="w-full h-full border-0" 
              allowfullscreen 
              loading="lazy"
              title={`${hotelTitle} Location Map`}
            ></iframe>
          </div>
        </div>
      )}

      <!-- 3. HOTEL AMENITIES -->
      {showAmenities && (
        <div id="amenities" class="border-b border-slate-200 pb-6 sm:pb-8 space-y-3.5 sm:space-y-4">
          <h2 class="text-xl sm:text-3xl font-black font-serif text-slate-900 border-b border-slate-200 pb-3">Hotel Amenities</h2>
          
          <div class="grid grid-cols-2 sm:grid-cols-3 gap-2.5 sm:gap-3 text-xs sm:text-sm">
            {amenitiesList.map((item: string) => (
              <div class="flex items-center gap-2 font-semibold text-slate-800 py-1">
                <svg class="w-4 h-4 fill-emerald-600 shrink-0" viewBox="0 0 24 24"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
                <span>{item}</span>
              </div>
            ))}
          </div>
        </div>
      )}

      <!-- 4. WHAT'S NEARBY & ACCORDION DROPDOWN -->
      {showNearby && (
        <div id="nearby" class="border-b border-slate-200 pb-6 sm:pb-8 space-y-3.5 sm:space-y-4">
          <div>
            <h2 class="text-xl sm:text-3xl font-black font-serif text-slate-900 border-b border-slate-200 pb-3">
              What's Nearby & Local Insights
            </h2>
            <p class="text-xs text-slate-500 mt-1.5">
              Click on any landmark below to view distance and local tips:
            </p>
          </div>
          
          <div class="space-y-2.5 pt-1">
            {nearbyPlaces.map((place: any) => (
              <details class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden group transition">
                <summary class="flex justify-between items-center p-3.5 sm:p-4 cursor-pointer select-none hover:bg-slate-50 transition">
                  <span class="font-bold text-slate-900 text-xs sm:text-base flex items-center gap-2">
                    <svg class="w-4 h-4 fill-emerald-600 shrink-0" viewBox="0 0 24 24"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>
                    {place.name}
                  </span>

                  <div class="flex items-center gap-2 sm:gap-3 shrink-0 ml-2">
                    <span class="text-emerald-700 font-extrabold text-[11px] sm:text-xs bg-emerald-50 px-2.5 py-1 rounded-lg border border-emerald-200">
                      {place.distance}
                    </span>
                    <span class="text-slate-400 text-[10px] sm:text-xs group-open:rotate-180 transition-transform">▼</span>
                  </div>
                </summary>

                {place.details && (
                  <div class="p-3.5 sm:p-4 pt-1 text-xs sm:text-sm text-slate-600 border-t border-slate-100 leading-relaxed bg-slate-50/60">
                    {place.details}
                  </div>
                )}
              </details>
            ))}
          </div>
        </div>
      )}

      <!-- 5. HOTEL INFORMATION -->
      {showDetails && (
        <div id="information" class="border-b border-slate-200 pb-6 sm:pb-8 space-y-4 sm:space-y-6">
          <h2 class="text-xl sm:text-3xl font-black font-serif text-slate-900 border-b border-slate-200 pb-3">Hotel Information</h2>
          
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 py-1">
            <div>
              <span class="text-slate-400 block font-bold text-[10px] sm:text-xs uppercase tracking-wider">Check-In</span>
              <span class="font-black text-slate-900 text-xs sm:text-base mt-0.5 block">2:00 PM</span>
            </div>
            <div>
              <span class="text-slate-400 block font-bold text-[10px] sm:text-xs uppercase tracking-wider">Check-Out</span>
              <span class="font-black text-slate-900 text-xs sm:text-base mt-0.5 block">12:00 PM</span>
            </div>
            <div>
              <span class="text-slate-400 block font-bold text-[10px] sm:text-xs uppercase tracking-wider">Smoking</span>
              <span class="font-black text-slate-900 text-xs sm:text-base mt-0.5 block">Non-Smoking</span>
            </div>
            <div>
              <span class="text-slate-400 block font-bold text-[10px] sm:text-xs uppercase tracking-wider">Power Backup</span>
              <span class="font-black text-emerald-700 text-xs sm:text-base mt-0.5 block">24/7 Generator</span>
            </div>
          </div>

          {showRules && (
            <div class="space-y-2 pt-3 border-t border-slate-200">
              <h3 class="font-bold text-slate-900 text-xs uppercase tracking-wider">General Policies</h3>
              <ul class="text-xs sm:text-sm text-slate-700 space-y-2">
                <li class="flex items-center gap-2">
                  <svg class="w-4 h-4 fill-emerald-600 shrink-0" viewBox="0 0 24 24"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
                  <span>Valid Government Photo ID (NID / Passport) required at check-in.</span>
                </li>
                <li class="flex items-center gap-2">
                  <svg class="w-4 h-4 fill-emerald-600 shrink-0" viewBox="0 0 24 24"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
                  <span>Pets policy subject to hotel management approval.</span>
                </li>
              </ul>
            </div>
          )}
        </div>
      )}

      <!-- 6. FAQS ACCORDION -->
      {showFaqs && (
        <div id="faqs" class="space-y-4 pt-1">
          <h2 class="text-xl sm:text-3xl font-black font-serif text-slate-900 border-b border-slate-200 pb-3">
            FAQs about {hotelTitle}
          </h2>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-3.5 items-start">
            
            <div class="space-y-3">
              {leftColumnFaqs.map((faq: any) => (
                <details class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden group transition">
                  <summary class="flex justify-between items-center p-3.5 sm:p-4 cursor-pointer select-none font-bold text-slate-900 text-xs sm:text-sm hover:text-emerald-700 transition">
                    <span>{faq.question}</span>
                    <span class="text-slate-400 text-[10px] sm:text-xs shrink-0 ml-2 group-open:rotate-180 transition-transform">▼</span>
                  </summary>
                  <div class="p-3.5 sm:p-4 pt-1 text-xs sm:text-sm text-slate-600 border-t border-slate-100 leading-relaxed bg-slate-50/60">
                    {faq.answer}
                  </div>
                </details>
              ))}
            </div>

            <div class="space-y-3">
              {rightColumnFaqs.map((faq: any) => (
                <details class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden group transition">
                  <summary class="flex justify-between items-center p-3.5 sm:p-4 cursor-pointer select-none font-bold text-slate-900 text-xs sm:text-sm hover:text-emerald-700 transition">
                    <span>{faq.question}</span>
                    <span class="text-slate-400 text-[10px] sm:text-xs shrink-0 ml-2 group-open:rotate-180 transition-transform">▼</span>
                  </summary>
                  <div class="p-3.5 sm:p-4 pt-1 text-xs sm:text-sm text-slate-600 border-t border-slate-100 leading-relaxed bg-slate-50/60">
                    {faq.answer}
                  </div>
                </details>
              ))}
            </div>

          </div>
        </div>
      )}

      <!-- 7. CUSTOM EXTRA SECTIONS -->
      {customSections.map((sec: any, idx: number) => (
        <div id={`custom-sec-${idx}`} class="border-b border-slate-200 pb-6 sm:pb-8 space-y-3">
          <h2 class="text-xl sm:text-3xl font-black font-serif text-slate-900 border-b border-slate-200 pb-3">{sec.title}</h2>
          <div class="text-xs sm:text-sm text-slate-600 leading-relaxed" set:html={sec.content} />
        </div>
      ))}

    </div>

    <!-- RIGHT STICKY ACTION SIDEBAR (30% DESKTOP) -->
    <div class="lg:col-span-4">
      <div class="sticky top-[80px] bg-slate-900 text-white p-5 sm:p-7 rounded-3xl border border-slate-800 shadow-2xl space-y-5">
        
        {hotelPrice && (
          <div>
            <span class="text-[10px] uppercase font-bold text-emerald-400 tracking-widest block">Starting Rate</span>
            <span class="text-2xl sm:text-3xl font-black text-white elimination mt-0.5 block">{hotelPrice}</span>
            <span class="text-[11px] text-slate-400 block mt-0.5">/ night + taxes & fees</span>
          </div>
        )}

        <!-- ACTION BUTTONS -->
        <div class="space-y-2.5 pt-1">
          {data.officialSite ? (
            <a href={data.officialSite} target="_blank" rel="noopener noreferrer" class="w-full bg-emerald-600 hover:bg-emerald-500 text-white font-extrabold text-xs sm:text-sm py-3 sm:py-3.5 rounded-xl shadow-lg transition flex items-center justify-center gap-2">
              <span>Check Official Site Price</span>
              <span>➔</span>
            </a>
          ) : (
            <a href="#information" class="w-full bg-emerald-600 hover:bg-emerald-500 text-white font-extrabold text-xs sm:text-sm py-3 sm:py-3.5 rounded-xl shadow-lg transition flex items-center justify-center gap-2">
              <span>Book Your Stay</span>
              <span>➔</span>
            </a>
          )}

          {data.whatsapp && (
            <a href={`https://wa.me/${data.whatsapp}?text=${encodeURIComponent('Hi, I want to inquire about reservation at ' + hotelTitle)}`} target="_blank" rel="noopener noreferrer" class="w-full bg-slate-800 hover:bg-slate-700 text-slate-200 font-bold text-xs sm:text-sm py-2.5 sm:py-3 rounded-xl border border-slate-700 transition flex items-center justify-center gap-2">
              <svg class="w-4 h-4 fill-emerald-400 shrink-0" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/></svg>
              <span>Instant WhatsApp Reservation</span>
            </a>
          )}

          {data.phone && (
            <a href={`tel:${data.phone}`} class="w-full bg-slate-800 hover:bg-slate-700 text-slate-200 font-bold text-xs sm:text-sm py-2.5 sm:py-3 rounded-xl border border-slate-700 transition flex items-center justify-center gap-2">
              <svg class="w-4 h-4 fill-emerald-400 shrink-0" viewBox="0 0 24 24"><path d="M6.62 10.79c1.44 2.83 2.62 4.01 5.45 5.45l2.2-2.23c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1v3.5c0 .55-.45 1-1 1C9.39 20 2 12.61 2 3c0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/></svg>
              <span>Direct Call Desk</span>
            </a>
          )}
        </div>

      </div>
    </div>

  </section>

  <!-- MOBILE PINNED BOTTOM BAR -->
  <div class="lg:hidden fixed bottom-0 left-0 right-0 z-50 bg-slate-950/95 text-white border-t border-slate-800 p-2.5 px-4 flex justify-between items-center shadow-2xl backdrop-blur-md">
    <div>
      <span class="text-[9px] text-slate-400 block font-bold uppercase tracking-wider">Starting Rate</span>
      <span class="font-black text-emerald-400 text-sm sm:text-base">{hotelPrice || 'Check Price'}</span>
    </div>

    {data.whatsapp ? (
      <a href={`https://wa.me/${data.whatsapp}?text=${encodeURIComponent('Hi, I want to inquire about reservation at ' + hotelTitle)}`} target="_blank" rel="noopener noreferrer" class="bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-black px-4 py-2.5 rounded-xl shadow transition flex items-center gap-1.5">
        <span>Reserve Now</span>
        <span>➔</span>
      </a>
    ) : (
      <a href="#information" class="bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-black px-4 py-2.5 rounded-xl shadow transition">
        Check Price ➔
      </a>
    )}
  </div>

  <!-- CLIENT-SIDE SCRIPT FOR OVERVIEW 150-WORD TRUNCATOR -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const overviewTextEl = document.getElementById('overview-text');
      const toggleBtn = document.getElementById('toggleOverviewBtn');

      if (!overviewTextEl) return;

      const fullText = overviewTextEl.innerText.trim();
      const words = fullText.split(/\s+/);

      if (words.length > 150) {
        const firstPart = words.slice(0, 150).join(' ');
        const remainingPart = words.slice(150).join(' ');

        overviewTextEl.innerHTML = `
          <span>${firstPart}</span>
          <span id="overview-dots">... </span>
          <span id="overview-more" class="hidden">${remainingPart}</span>
        `;

        if (toggleBtn) {
          toggleBtn.classList.remove('hidden');
          toggleBtn.addEventListener('click', () => {
            const moreSpan = document.getElementById('overview-more');
            const dotsSpan = document.getElementById('overview-dots');

            if (moreSpan && dotsSpan) {
              const isHidden = moreSpan.classList.contains('hidden');
              if (isHidden) {
                moreSpan.classList.remove('hidden');
                dotsSpan.classList.add('hidden');
                toggleBtn.innerHTML = 'Read Less ▲';
              } else {
                moreSpan.classList.add('hidden');
                dotsSpan.classList.remove('hidden');
                toggleBtn.innerHTML = 'Read More ➔';
              }
            }
          });
        }
      }
    });
  </script>

</Layout>
