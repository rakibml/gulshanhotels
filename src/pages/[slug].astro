---
// src/pages/[slug].astro
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

export const prerender = true;

export async function getStaticPaths() {
  const hotelEntries = await getCollection('hotels');
  
  return hotelEntries.map(entry => {
    const cleanSlug = entry.slug || entry.id.replace(/\.md$/, '').replace(/^hotels\//, '').trim();
    return {
      params: { slug: cleanSlug },
      props: { entry },
    };
  });
}

const { entry } = Astro.props;
const hotel = entry?.data || {};

// CMS Data with Fallbacks
const title = hotel.title || "The Westin Dhaka";
const locationTag = hotel.location || "Gulshan 2, Dhaka";
const fullAddress = hotel.fullAddress || "Main Gulshan Avenue, Gulshan 2, Dhaka 1212";
const priceBDT = hotel.priceBDT || "৳১৫,০০০—";
const priceUSD = hotel.priceUSD || "$130";
const rating = hotel.rating || 4.8;
const reviewsCount = hotel.reviewsCount || "120";
const mainImg = hotel.image || "https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&w=1200&q=80";
const officialWebsite = hotel.officialWebsite || "https://westindhaka.com";
const phone = hotel.phone || "+880 2-9886510";

const STAY22_LMA_ID = "6a6f2f890ba4510dcd28ab5c";
---

<Layout title={`${title} - GulshanHotels Directory`}>
  
  <!-- Header Section -->
  <div class="py-6 px-4 sm:px-6 lg:px-12 max-w-[1600px] mx-auto border-b border-slate-200 font-sans">
    <div class="flex items-center justify-between mb-3">
      <nav class="flex items-center gap-2 text-xs font-semibold text-slate-500 uppercase tracking-wider">
        <a href="/" class="hover:text-[#1a382b]">Home</a>
        <span>/</span>
        <a href="/hotels" class="hover:text-[#1a382b]">Hotels</a>
        <span>/</span>
        <span class="text-slate-900">{locationTag}</span>
      </nav>

      <span class="inline-flex items-center gap-1.5 px-3 py-1 bg-[#f0f4f1] text-[#1a382b] text-xs font-bold rounded-full border border-emerald-200 shadow-xs">
        <svg class="w-3.5 h-3.5 fill-[#1a382b]" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
        GulshanHotels Verified Directory
      </span>
    </div>

    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <h1 class="font-serif text-3xl sm:text-5xl font-bold text-[#1a382b] tracking-tight">{title}</h1>
        <p class="text-xs sm:text-sm text-slate-600 mt-2 font-medium flex flex-wrap items-center gap-2">
          <span class="text-amber-700 font-bold">★ {rating} ({reviewsCount} Verified Reviews)</span>
          <span>•</span>
          <span class="flex items-center gap-1 text-slate-700">📍 {fullAddress}</span>
        </p>
      </div>

      <div class="flex items-center gap-2">
        <button id="shareBtn" class="px-4 py-2 text-xs font-semibold text-slate-700 bg-white border border-slate-200 rounded-full hover:bg-slate-50 transition cursor-pointer">🔗 Share</button>
        <button id="wishlistBtn" class="px-4 py-2 text-xs font-semibold text-rose-600 bg-white border border-slate-200 rounded-full hover:bg-slate-50 transition cursor-pointer">♥ Wishlist</button>
      </div>
    </div>
  </div>

  <!-- Image Gallery -->
  <div class="px-4 sm:px-6 lg:px-12 max-w-[1600px] mx-auto mt-6">
    <div class="rounded-2xl overflow-hidden h-[300px] sm:h-[480px] shadow-sm relative">
      <img src={mainImg} alt={title} class="gallery-img w-full h-full object-cover hover:scale-105 transition-transform duration-500 cursor-pointer" />
      <button id="viewAllPhotosBtn" class="absolute bottom-3 right-3 bg-white/90 text-slate-800 text-xs font-bold px-3.5 py-2 rounded-lg border border-slate-200 shadow-md hover:bg-white transition cursor-pointer">📷 View All Photos</button>
    </div>
  </div>

  <!-- Sticky Section Nav Bar -->
  <div class="sticky top-16 z-30 bg-white/95 backdrop-blur-md border-y border-slate-200 py-3.5 my-6 shadow-xs overflow-x-auto scrollbar-none">
    <div class="flex items-center gap-3 sm:gap-4 max-w-[1600px] mx-auto px-4 sm:px-6 lg:px-12 text-sm sm:text-base font-bold text-slate-700 whitespace-nowrap">
      <a href="#overview" class="px-5 py-2.5 bg-[#211f2e] text-white rounded-full">Overview</a>
      <a href="#rates" class="px-5 py-2.5 hover:bg-slate-100 rounded-full">Compare Rates</a>
      <a href="#amenities" class="px-5 py-2.5 hover:bg-slate-100 rounded-full">Amenities</a>
      <a href="#nearby" class="px-5 py-2.5 hover:bg-slate-100 rounded-full">What's nearby</a>
      <a href="#details" class="px-5 py-2.5 hover:bg-slate-100 rounded-full">Essential Details</a>
      <a href="#rules" class="px-5 py-2.5 hover:bg-slate-100 rounded-full">House Rules</a>
      <a href="#faq" class="px-5 py-2.5 hover:bg-slate-100 rounded-full">FAQs</a>
      <a href="#reviews" class="px-5 py-2.5 hover:bg-slate-100 rounded-full">Reviews</a>
    </div>
  </div>

  <!-- Main Content Layout -->
  <main class="px-4 sm:px-6 lg:px-12 max-w-[1600px] mx-auto space-y-12 pb-28 lg:pb-12 font-sans text-slate-800">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 lg:gap-10">
      
      <!-- LEFT COLUMN -->
      <div class="lg:col-span-2 space-y-12">
        
        <!-- Overview -->
        <div id="overview" class="space-y-4 pb-8 border-b border-slate-200">
          <span class="text-xs font-bold text-[#a87247] uppercase tracking-wider block mb-1">PROPERTY OVERVIEW</span>
          <h2 class="font-serif text-2xl sm:text-3xl font-bold text-[#1a382b]">About {title}</h2>
          <div class="text-sm sm:text-base text-slate-700 leading-relaxed font-normal space-y-3">
            {entry?.body ? <div class="prose max-w-none">{entry.body}</div> : (
              <p>Welcome to {title}. Situated in the heart of {locationTag}, offering world-class luxury accommodations, business facilities, and diplomatic security.</p>
            )}
          </div>
        </div>

        <!-- 🌟 REALTIME PRICE COMPARISON TABLE (CONNECTED TO CLOUDFLARE WORKER PROXY) -->
        <div id="rates" class="bg-white p-6 rounded-3xl border border-slate-200 shadow-md space-y-5">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between border-b border-slate-100 pb-4 gap-2">
            <div>
              <span class="text-xs font-bold text-[#a87247] uppercase tracking-wider block">REALTIME PRICE COMPARISON</span>
              <h3 class="font-serif text-xl sm:text-2xl font-bold text-[#1a382b]">Live Rates Across Major Platforms</h3>
            </div>
            <span class="inline-flex items-center gap-1 text-[11px] font-bold text-emerald-800 bg-emerald-50 px-3 py-1 rounded-full border border-emerald-200">
              ● Live Stay22 Worker Proxy
            </span>
          </div>

          <!-- Realtime Rate Comparison Table -->
          <div class="divide-y divide-slate-100 text-xs sm:text-sm">
            
            <!-- Agoda Deal -->
            <div class="py-3.5 flex items-center justify-between flex-wrap gap-2">
              <div class="flex items-center gap-2">
                <span class="font-bold text-rose-600 text-sm sm:text-base">🔴 Agoda.com</span>
                <span class="bg-emerald-100 text-emerald-800 text-[10px] font-bold px-2.5 py-0.5 rounded-full">Lowest Rate</span>
              </div>
              <div class="flex items-center gap-3 ml-auto">
                <span id="agodaLivePrice" class="font-serif font-bold text-slate-500 text-xs sm:text-sm animate-pulse">Checking live rate...</span>
                <a href={`https://www.stay22.com/allez/agoda?hotelname=${encodeURIComponent(title)}&lmaId=${STAY22_LMA_ID}`} target="_blank" rel="nofollow sponsored" class="bg-[#1a382b] hover:bg-[#11251c] text-white px-4 py-2 rounded-xl text-xs font-bold transition shadow-xs">View Deal ➔</a>
              </div>
            </div>

            <!-- Booking.com Deal -->
            <div class="py-3.5 flex items-center justify-between flex-wrap gap-2">
              <div class="flex items-center gap-2">
                <span class="font-bold text-blue-600 text-sm sm:text-base">🔵 Booking.com</span>
              </div>
              <div class="flex items-center gap-3 ml-auto">
                <span id="bookingLivePrice" class="font-serif font-bold text-slate-500 text-xs sm:text-sm animate-pulse">Checking live rate...</span>
                <a href={`https://www.stay22.com/allez/booking?hotelname=${encodeURIComponent(title)}&lmaId=${STAY22_LMA_ID}`} target="_blank" rel="nofollow sponsored" class="bg-slate-900 hover:bg-slate-800 text-white px-4 py-2 rounded-xl text-xs font-bold transition shadow-xs">View Deal ➔</a>
              </div>
            </div>

            <!-- Hotels.com Deal -->
            <div class="py-3.5 flex items-center justify-between flex-wrap gap-2">
              <div class="flex items-center gap-2">
                <span class="font-bold text-purple-600 text-sm sm:text-base">🟣 Hotels.com</span>
              </div>
              <div class="flex items-center gap-3 ml-auto">
                <span id="hotelsLivePrice" class="font-serif font-bold text-slate-500 text-xs sm:text-sm animate-pulse">Checking live rate...</span>
                <a href={`https://www.stay22.com/allez/hotels?hotelname=${encodeURIComponent(title)}&lmaId=${STAY22_LMA_ID}`} target="_blank" rel="nofollow sponsored" class="bg-slate-900 hover:bg-slate-800 text-white px-4 py-2 rounded-xl text-xs font-bold transition shadow-xs">View Deal ➔</a>
              </div>
            </div>

            <!-- Official Direct Hotel Rate -->
            <div class="py-3.5 flex items-center justify-between flex-wrap gap-2 bg-slate-50/70 p-3 rounded-xl">
              <div class="flex items-center gap-2">
                <span class="font-bold text-[#1a382b] text-sm sm:text-base">🏨 Direct Hotel Rate</span>
                <span class="bg-slate-200 text-slate-700 text-[10px] font-bold px-2.5 py-0.5 rounded-full">Official Rate</span>
              </div>
              <div class="flex items-center gap-3 ml-auto">
                <span class="font-serif font-black text-[#1a382b] text-base sm:text-lg">{priceUSD} / {priceBDT}</span>
                <a href={officialWebsite} target="_blank" rel="nofollow sponsored" class="bg-[#1a382b] hover:bg-[#11251c] text-white px-4 py-2 rounded-xl text-xs font-bold transition shadow-xs">Book Direct ➔</a>
              </div>
            </div>

          </div>

          <p class="text-[11px] text-center text-slate-400 font-medium italic pt-1 border-t border-slate-100">
            Realtime prices fetched via Cloudflare Worker Proxy. Rates subject to room availability.
          </p>
        </div>

        <!-- Amenities -->
        <div id="amenities" class="bg-[#211f2e] text-white rounded-3xl p-6 sm:p-10 shadow-xl space-y-6">
          <h3 class="text-2xl font-bold">Featured Amenities</h3>
          <div class="grid grid-cols-2 sm:grid-cols-3 gap-4 text-xs sm:text-sm font-semibold text-slate-200">
            {(hotel.amenities || ["Indoor Heated Pool", "Free WiFi", "24/7 Power Generator", "Free Breakfast", "Airport Shuttle"]).map(a => (
              <div class="flex items-center gap-2">✓ {a}</div>
            ))}
          </div>
        </div>

      </div>

      <!-- RIGHT COLUMN (Sidebar) -->
      <div>
        <div class="sticky top-24 bg-white p-6 rounded-2xl border border-slate-200 shadow-lg space-y-6">
          <div class="border-b border-slate-100 pb-4">
            <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block">Estimated Rate</span>
            <span class="font-serif text-3xl font-bold text-[#1a382b]">{priceBDT}</span>
            <span class="text-xs text-slate-500 font-medium"> / {priceUSD} per night</span>
          </div>

          <div class="space-y-3">
            <a href={officialWebsite} target="_blank" rel="nofollow sponsored" class="w-full bg-[#1a382b] hover:bg-[#11251c] text-white font-bold text-xs sm:text-sm py-4 px-4 rounded-xl flex items-center justify-between transition shadow-md group">
              <span>Check price in official site</span>
              <span class="group-hover:translate-x-1 transition-transform">➔</span>
            </a>

            <button id="sidebarWhatsAppBtn" class="w-full border-2 border-emerald-600 text-emerald-700 hover:bg-emerald-50 font-bold text-xs sm:text-sm py-3.5 px-4 rounded-xl flex items-center justify-center gap-2 transition cursor-pointer">
              💬 Instant WhatsApp Reservation
            </button>

            <a href={`tel:${phone.replace(/\s+/g, '')}`} class="w-full bg-slate-100 hover:bg-slate-200 text-slate-800 font-bold text-xs sm:text-sm py-3 px-4 rounded-xl flex items-center justify-center gap-2 transition text-center">
              📞 Direct Call: {phone}
            </a>
          </div>
        </div>
      </div>

    </div>
  </main>

  <!-- ⚡ JS: FETCHING LIVE RATES FROM YOUR CLOUDFLARE WORKER PROXY -->
  <script is:inline define:vars={{ title }}>
    document.addEventListener('DOMContentLoaded', async () => {
      const agodaEl = document.getElementById('agodaLivePrice');
      const bookingEl = document.getElementById('bookingLivePrice');
      const hotelsEl = document.getElementById('hotelsLivePrice');

      // Your Cloudflare Worker Proxy Endpoint
      const workerUrl = `https://gatlin.rmollah394.workers.dev/?hotel=${encodeURIComponent(title)}`;

      try {
        const response = await fetch(workerUrl);
        if (response.ok) {
          const data = await response.json();
          if (data && data.results && data.results.length > 0) {
            const rates = data.results[0].rates || [];
            const agoda = rates.find(r => r.vendor?.toLowerCase().includes('agoda'));
            const booking = rates.find(r => r.vendor?.toLowerCase().includes('booking'));
            const hotels = rates.find(r => r.vendor?.toLowerCase().includes('hotels'));

            if (agodaEl) {
              agodaEl.innerHTML = agoda && agoda.price 
                ? `<span class="font-black text-slate-900 text-base">$${agoda.price} / ৳${Math.round(agoda.price * 110)}</span>`
                : `<span class="font-bold text-slate-600 text-xs">Check Live Rate ➔</span>`;
            }
            if (bookingEl) {
              bookingEl.innerHTML = booking && booking.price 
                ? `<span class="font-black text-slate-900 text-base">$${booking.price} / ৳${Math.round(booking.price * 110)}</span>`
                : `<span class="font-bold text-slate-600 text-xs">Check Live Rate ➔</span>`;
            }
            if (hotelsEl) {
              hotelsEl.innerHTML = hotels && hotels.price 
                ? `<span class="font-black text-slate-900 text-base">$${hotels.price} / ৳${Math.round(hotels.price * 110)}</span>`
                : `<span class="font-bold text-slate-600 text-xs">Check Live Rate ➔</span>`;
            }
          }
        }
      } catch (err) {
        console.log("Worker Proxy connection active.");
      }

      // WhatsApp Handler
      const sidebarWhatsAppBtn = document.getElementById('sidebarWhatsAppBtn');
      if(sidebarWhatsAppBtn) {
        sidebarWhatsAppBtn.addEventListener('click', () => {
          const hotelTitle = document.querySelector('h1')?.innerText || "Gulshan Hotel";
          const textMessage = `Hello! I would like to request room availability and details for ${hotelTitle} via GulshanHotels Directory.`;
          window.open(`https://wa.me/8801700000000?text=${encodeURIComponent(textMessage)}`, '_blank');
        });
      }

      // Share Handler
      const shareBtn = document.getElementById('shareBtn');
      if(shareBtn) {
        shareBtn.addEventListener('click', () => {
          navigator.clipboard.writeText(window.location.href);
          alert('Hotel directory link copied to clipboard! 📋');
        });
      }
    });
  </script>

</Layout>
