---
// src/pages/[slug].astro
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

// DYNAMIC STATIC PATHS GENERATOR
export async function getStaticPaths() {
  let hotels: any[] = [];
  
  try {
    hotels = await getCollection('hotels');
  } catch (e) {
    hotels = [];
  }

  // Backup glob scanner
  if (!hotels || hotels.length === 0) {
    try {
      const rawGlob = import.meta.glob('../content/hotels/*.md', { eager: true });
      hotels = Object.entries(rawGlob).map(([filePath, item]: [string, any]) => ({
        id: filePath.split('/').pop()?.replace('.md', ''),
        data: item.frontmatter || {},
        body: item.compiledContent ? item.compiledContent() : ''
      }));
    } catch (e) {
      hotels = [];
    }
  }

  // ⚠️ Cloudflare Safety Fix: যদি কোনো মার্কডাউন ফাইল না থাকে, তাও যেন বিল্ড ফেইল না করে
  if (!hotels || hotels.length === 0) {
    return [
      {
        params: { slug: 'hotel' },
        props: { hotel: { data: { title: 'Hotel Details' } } }
      }
    ];
  }

  return hotels.map((entry: any) => {
    const rawId = entry.id || entry.slug || '';
    const cleanSlug = rawId
      .split('/')
      .pop()
      .replace(/\.md$/, '')
      .toLowerCase();

    return {
      params: { slug: cleanSlug || 'hotel' },
      props: { hotel: entry },
    };
  });
}

const { hotel } = Astro.props;
const data = hotel.data || {};

