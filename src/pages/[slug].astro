---
// src/pages/[slug].astro
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

export const prerender = true;

export async function getStaticPaths() {
  let hotelEntries = [];
  try {
    hotelEntries = await getCollection('hotels');
  } catch (e) {
    hotelEntries = [];
  }

  if (!hotelEntries || hotelEntries.length === 0) {
    try {
      const rawGlob = import.meta.glob('../content/hotels/*.md', { eager: true });
      hotelEntries = Object.entries(rawGlob).map(([filePath, file]: [string, any]) => {
        const filename = filePath.split('/').pop()?.replace('.md', '') || 'hotel';
        return {
          id: filename,
          slug: filename,
          data: file.frontmatter,
          body: file.rawContent ? file.rawContent() : ''
        };
      });
    } catch (e) {
      hotelEntries = [];
    }
  }

  if (hotelEntries.length === 0) {
    hotelEntries = [
      {
        id: 'the-westin-dhaka',
        slug: 'the-westin-dhaka',
        data: {
          title: "The Westin Dhaka",
          location: "Gulshan 2, Dhaka",
          fullAddress: "Main Gulshan Avenue, Plot-01, Road 45, Gulshan 2, Dhaka 1212",
          priceBDT: "৳১৮,৫০০—",
          priceUSD: "$150",
          rating: 4.8,
          reviewsCount: "1,248",
          image: "https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&w=1200&q=80",
          officialWebsite: "https://westindhaka.com",
          phone: "+880 2-9886510"
        }
      },
      {
        id: 'amari-dhaka',
        slug: 'amari-dhaka',
        data: {
          title: "Amari Dhaka",
          location: "Gulshan 2, Dhaka",
          fullAddress: "47 Road No 41, Gulshan 2, Dhaka 1212",
          priceBDT: "৳১৬,০০০—",
          priceUSD: "$130",
          rating: 4.6,
          reviewsCount: "982",
          image: "https://images.unsplash.com/photo-1542314831-068cd1dbfeeb?auto=format&fit=crop&w=1200&q=80",
          officialWebsite: "https://amari.com",
          phone: "+880 2-55051818"
        }
      }
    ];
  }

  return hotelEntries.map((entry: any) => {
    const cleanSlug = entry.slug || entry.id?.replace(/\.md$/, '').replace(/^hotels\//, '').trim() || 'hotel';
    return {
      params: { slug: cleanSlug },
      props: { entry },
    };
  });
}

const { entry } = Astro.props;
const hotel = entry?.data || {};

const title = hotel.title || "The Westin Dhaka";
const locationTag = hotel.location || "Gulshan 2, Dhaka";
const fullAddress = hotel.fullAddress || "Main Gulshan Avenue, Gulshan 2, Dhaka 1212";
const priceBDT = hotel.priceBDT || "৳১৫,০০০—";
const priceUSD = hotel.priceUSD || "$130";
const rating = hotel.rating || 4.8;
const reviewsCount = hotel.reviewsCount || "120";
const mainImg = hotel.image || "https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&w=1200&q=80";
const officialWebsite = hotel.officialWebsite || "https://agoda.com";
const phone = hotel.phone || "+880 1700-000000";
---

<Layout title={`${title} - GulshanHotels Directory`}>
  
  <div class="bg-[#F8FAF9] py-8 min-h-screen">
    
    <!-- 1. Header Section -->
    <div class="px-4 sm:px-6 lg:px-12 max-w-[1600px] mx-auto border-b border-slate-200 pb-6 font-sans">
