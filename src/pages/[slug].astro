---
// src/pages/[slug].astro (PERMANENT LOCKED ROUTER — 100% BUILD-SAFE & 3-WAY ROUTING)
import Layout from '../layouts/Layout.astro';
import HotelMasterSchema from '../components/hotel/HotelMasterSchema.astro';
import LocationCategoryTemplate from '../components/landing/LocationCategoryTemplate.astro';
import HotelHeader from '../components/hotel/HotelHeader.astro';
import HotelSubNav from '../components/hotel/HotelSubNav.astro';
import HotelAboutAndRates from '../components/hotel/HotelAboutAndRates.astro';
import HotelAmenitiesAndRooms from '../components/hotel/HotelAmenitiesAndRooms.astro';
import HotelLocationMap from '../components/hotel/HotelLocationMap.astro';
import HotelReviews from '../components/hotel/HotelReviews.astro';
import HotelFaqsSection from '../components/hotel/HotelFaqsSection.astro';
import HotelNearbyHotels from '../components/hotel/HotelNearbyHotels.astro';
import PageView from '../components/PageView.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  // ১. হোটেল ডাটা লোডার
  let hotels: any[] = [];
  try { 
    hotels = await getCollection('hotels'); 
  } catch (e) {
    hotels = [];
  }

  if (!hotels || hotels.length === 0) {
    try {
      const rawGlob = import.meta.glob(['/src/content/hotels/*.{md,mdx}', '../content/hotels/*.{md,mdx}'], { eager: true });
      hotels = Object.entries(rawGlob).map(([filePath, item]: [string, any]) => ({
        id: filePath.split('/').pop()?.replace(/\.(md|mdx)$/, ''),
        data: item.frontmatter || item.data || {},
        body: item.compiledContent ? item.compiledContent() : ''
      }));
    } catch (e) {
      hotels = [];
    }
  }

  const hotelPaths: any[] = [];
  for (const entry of hotels) {
    const rawSlug = entry.data?.slug || entry.slug || entry.id || '';
    const cleanSlug = String(rawSlug).split('/').pop()?.replace(/\.(md|mdx)$/, '').trim().toLowerCase();
    if (cleanSlug) {
      hotelPaths.push({
        params: { slug: cleanSlug },
        props: { type: 'hotel', entry }
      });
    }
  }

  // ২. লোকেশন ও ক্যাটাগরি ক্লাস্টার ডাটা লোডার (SEO Landing Pages)
  let destinations: any[] = [];
  try { 
    destinations = await getCollection('destinations'); 
  } catch (e) {
    destinations = [];
  }

  if (!destinations || destinations.length === 0) {
    try {
      const rawGlobDest = import.meta.glob(['/src/content/destinations/*.{md,mdx}', '../content/destinations/*.{md,mdx}'], { eager: true });
      destinations = Object.entries(rawGlobDest).map(([filePath, item]: [string, any]) => ({
        id: filePath.split('/').pop()?.replace(/\.(md|mdx)$/, ''),
        data: item.frontmatter || item.data || {},
      }));
    } catch (e) {
      destinations = [];
    }
  }

  const destinationPaths: any[] = [];
  for (const entry of destinations) {
    const rawSlug = entry.data?.slug || entry.slug || entry.id || '';
    const cleanSlug = String(rawSlug).split('/').pop()?.replace(/\.(md|mdx)$/, '').trim().toLowerCase();
    if (cleanSlug) {
      destinationPaths.push({
        params: { slug: cleanSlug },
        props: { type: 'destination', entry }
      });
    }
  }

  // ৩. সাধারণ পেজ ডাটা লোডার (About, Privacy, Terms etc.)
  let pages: any[] = [];
  try { 
    pages = await getCollection('pages'); 
  } catch (e) {
    pages = [];
  }

  if (!pages || pages.length === 0) {
    try {
      const rawGlobPages = import.meta.glob(['/src/content/pages/*.{md,mdx}', '../content/pages/*.{md,mdx}'], { eager: true });
      pages = Object.entries(rawGlobPages).map(([filePath, item]: [string, any]) => ({
        id: filePath.split('/').pop()?.replace(/\.(md|mdx)$/, ''),
        data: item.frontmatter || item.data || {},
        Content: item.default || item.Content || null,
        body: item.compiledContent ? item.compiledContent() : ''
      }));
    } catch (e) {
      pages = [];
    }
  }

  // ডুপ্লিকেট ইউআরএল প্রতিরোধ
  const takenSlugs = new Set([
    ...hotelPaths.map((p: any) => p.params.slug),
    ...destinationPaths.map((p: any) => p.params.slug)
  ]);

  const pagePaths: any[] = [];
  for (const entry of pages) {
    const rawSlug = entry.data?.slug || entry.slug || entry.id || '';
    const cleanSlug = String(rawSlug).split('/').pop()?.replace(/\.(md|mdx)$/, '').trim().toLowerCase();
    if (cleanSlug && !takenSlugs.has(cleanSlug)) {
      pagePaths.push({
        params: { slug: cleanSlug },
        props: { type: 'page', entry }
      });
    }
  }

  // একক রিটার্ন
  return [...hotelPaths, ...destinationPaths, ...pagePaths];
}

const { type = 'hotel', entry } = Astro.props;

// হোটেল মেটাডাটা
const hotel = type === 'hotel' ? entry : null;
const hotelData = hotel?.data || {};
const hotelTitle = hotelData.title || hotelData.name || "Hotel Details";
const hotelCategory = hotelData.category || "Luxury Stay";
const hotelLocation = hotelData.location || "Dhaka, Bangladesh";
const hotelImage = hotelData.image || "https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&w=1200&q=80";

const metaDescription = hotelData.seo_description 
  || hotelData.description 
  || `Book your stay at ${hotelTitle}, a verified ${hotelCategory} located in ${hotelLocation}.`;
---

{type === 'destination' ? (
  <LocationCategoryTemplate entry={entry} />
) : type === 'page' ? (
  <PageView entry={entry} />
) : (
  <Layout 
    title={`${hotelTitle} — Verified ${hotelCategory} in ${hotelLocation}`}
    description={metaDescription}
    image={hotelImage}
  >
    <HotelMasterSchema hotel={hotel} />
    <HotelHeader hotel={hotel} />
    <HotelSubNav hotel={hotel} />
    <HotelAboutAndRates hotel={hotel} />
    <HotelAmenitiesAndRooms hotel={hotel} />
    <HotelLocationMap hotel={hotel} />
    <HotelReviews hotel={hotel} />
    <HotelFaqsSection hotel={hotel} />
    <HotelNearbyHotels currentHotel={hotel} />
  </Layout>
)}
