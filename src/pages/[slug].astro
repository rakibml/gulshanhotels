---
// src/pages/[slug].astro
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

// ১. Astro Static SSG Build-এর জন্য সব রিয়েল হোটেলের আলাদা পেজ জেনারেট করা
export async function getStaticPaths() {
  let hotels: any[] = [];

  // ১.১ কালেকশন থেকে আসল ডাটা আনা
  try {
    const collectionData = await getCollection('hotels');
    if (collectionData && collectionData.length > 0) {
      hotels = collectionData.map((item: any) => ({
        ...item.data,
        slug: item.data?.slug || item.id?.replace(/\.md$/, '') || 'hotel',
      }));
    }
  } catch (err) {
    hotels = [];
  }

  // ১.২ কালেকশন মিস হলে নেটিভ ফাইল স্ক্যানার
  if (!hotels || hotels.length === 0) {
    try {
      const rawGlob = import.meta.glob('../content/hotels/*.md', { eager: true });
      hotels = Object.entries(rawGlob).map(([filePath, item]: [string, any]) => {
        const filename = filePath.split('/').pop()?.replace('.md', '') || 'hotel';
        const fm = item.frontmatter || {};
        return {
          ...fm,
          slug: fm.slug || filename,
        };
      });
    } catch (err) {
      hotels = [];
    }
  }

  // প্রতিটি হোটেলের জন্য আলাদা রুট তৈরি
  return hotels.map((hotel) => ({
    params: { slug: hotel.slug },
    props: { hotel },
  }));
}

const { hotel } = Astro.props;

// Title Case Formatter
function toTitleCase(str: string) {
  if (!str) return 'Gulshan Hotel';
  return str.replace(/\w\S*/g, (txt) => txt.charAt(0).toUpperCase() + txt.substr(1).toLowerCase());
}

const hotelTitle = toTitleCase(hotel?.title || 'Gulshan Hotel');
---

<Layout title={`${hotelTitle} - GulshanHotels.com`}>
  <main class="bg-slate-50 min-h-screen py-12">
    <div class="max-w-[1400px] mx-auto px-4 sm:px-8 space-y-8">
      
      <!-- Back Button -->
      <div>
        <a href="/" class="inline-flex items-center gap-2 text-xs font-black uppercase text-emerald-800 hover:text-emerald-600 transition">
          ➔ Back to Home
        </a>
      </div>

      <!-- Hotel Banner / Gallery Section -->
      <div class="bg-white rounded-3xl p-6 sm:p-8 border border-slate-200 shadow-sm space-y-6">
        <div class="flex flex-col sm:flex-row justify-between sm:items-end gap-4 border-b border-slate-100 pb-6">
          <div>
            <span class="text-xs font-black text-emerald-800 uppercase tracking-widest bg-emerald-100 px-3 py-1 rounded-lg">
              {hotel?.category || '5-Star Luxury'}
            </span>
            <h1 class="text-3xl sm:text-5xl font-black text-slate-900 mt-3">{hotelTitle}</h1>
            <p class="text-sm font-bold text-slate-500 mt-2 flex items-center gap-1">
              📍 {hotel?.fullAddress || hotel?.location || 'Gulshan, Dhaka, Bangladesh'}
            </p>
          </div>

          <div class="flex items-center gap-3">
            <span class="text-amber-500 text-lg font-black bg-amber-50 px-3 py-1.5 rounded-xl border border-amber-200">
              ★ {hotel?.rating || '4.8'}
            </span>
          </div>
        </div>

        <!-- Single Hotel Main Image -->
        {hotel?.image && (
          <div class="h-[350px] sm:h-[500px] rounded-2xl overflow-hidden bg-slate-100 border border-slate-200">
            <img src={hotel.image} alt={hotelTitle} class="w-full h-full object-cover" />
          </div>
        )}

        <!-- Overview & Description -->
        <div class="space-y-4 pt-4">
          <h2 class="text-xl font-black text-slate-900 border-b border-slate-100 pb-2">Hotel Overview</h2>
          <p class="text-slate-700 text-sm sm:text-base leading-relaxed">
            {hotel?.editorNote || hotel?.description || 'Experience world-class luxury and diplomatic security in Gulshan, Dhaka.'}
          </p>
        </div>

        <!-- Action CTA -->
        <div class="pt-6 border-t border-slate-100 flex flex-col sm:flex-row gap-4">
          <a 
            href={`https://wa.me/8801700000000?text=${encodeURIComponent(`Hi GulshanHotels! Inquiring about ${hotelTitle}`)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="flex-1 bg-emerald-700 hover:bg-emerald-800 text-white font-black py-4 px-6 rounded-2xl text-center text-sm uppercase tracking-wider transition shadow-md"
          >
            💬 Reserve via WhatsApp
          </a>
        </div>
      </div>

    </div>
  </main>
</Layout>
