---
// src/pages/[slug].astro (PERMANENT LOCKED ROUTER — 100% BUILD-SAFE, SEO-PERFECT & 3-WAY ROUTING)
import Layout from '../layouts/Layout.astro';
import HotelMasterSchema from '../components/hotel/HotelMasterSchema.astro';
import LocationCategoryTemplate from '../components/landing/LocationCategoryTemplate.astro';
import HotelHeader from '../components/hotel/HotelHeader.astro';
import HotelSubNav from '../components/hotel/HotelSubNav.astro';

import HotelAbout from '../components/hotel/HotelAbout.astro';
import HotelRates from '../components/hotel/HotelRates.astro';

import HotelAmenitiesAndRooms from '../components/hotel/HotelAmenitiesAndRooms.astro';
import HotelLocationMap from '../components/hotel/HotelLocationMap.astro';
import HotelPolicies from '../components/hotel/HotelPolicies.astro';
import HotelReviews from '../components/hotel/HotelReviews.astro';
import HotelInsiderTips from '../components/hotel/HotelInsiderTips.astro';
import HotelFaqsSection from '../components/hotel/HotelFaqsSection.astro';
import HotelNearbyHotels from '../components/hotel/HotelNearbyHotels.astro';
import PageView from '../components/PageView.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const isProd = import.meta.env.PROD;

  // ১. হোটেল ডাটা লোডার
  let hotels: any[] = [];
  try { 
    hotels = await getCollection('hotels', ({ data }) => {
      return isProd ? data?.draft !== true : true;
    }); 
  } catch (e) {
    hotels = [];
  }

  if (!hotels || hotels.length === 0) {
    try {
      const rawGlob = import.meta.glob(['/src/content/hotels/*.{md,mdx}', '../content/hotels/*.{md,mdx}'], { eager: true });
      hotels = Object.entries(rawGlob)
        .map(([filePath, item]: [string, any]) => ({
          id: filePath.split('/').pop()?.replace(/\.(md|mdx)$/, ''),
          data: item.frontmatter || item.data || {},
          body: item.compiledContent ? item.compiledContent() : ''
        }))
        .filter((entry: any) => (isProd ? entry.data?.draft !== true : true));
    } catch (e) {
      hotels = [];
    }
  }

  const hotelPaths: any[] = [];
  for (const entry of hotels) {
    const rawSlug = entry.data?.slug || entry.slug || entry.id || '';
    const cleanSlug = String(rawSlug).split('/').pop()?.replace(/\.(md|mdx)$/, '').trim().toLowerCase();
    if (cleanSlug) {
      hotelPaths.push({
        params: { slug: cleanSlug },
        props: { type: 'hotel', entry }
      });
    }
  }

  // ২. লোকেশন ও ক্যাটাগরি ক্লাস্টার ডাটা লোডার
  let destinations: any[] = [];
  try { 
    destinations = await getCollection('destinations'); 
  } catch (e) {
    destinations = [];
  }

  if (!destinations || destinations.length === 0) {
    try {
      const rawGlobDest = import.meta.glob(['/src/content/destinations/*.{md,mdx}', '../content/destinations/*.{md,mdx}'], { eager: true });
      destinations = Object.entries(rawGlobDest).map(([filePath, item]: [string, any]) => ({
        id: filePath.split('/').pop()?.replace(/\.(md|mdx)$/, ''),
        data: item.frontmatter || item.data || {},
        Content: item.default || item.Content || null,
        body: item.compiledContent ? item.compiledContent() : ''
      }));
    } catch (e) {
      destinations = [];
    }
  }

  const destinationPaths: any[] = [];
  for (const entry of destinations) {
    const rawSlug = entry.data?.slug || entry.slug || entry.id || '';
    const cleanSlug = String(rawSlug).split('/').pop()?.replace(/\.(md|mdx)$/, '').trim().toLowerCase();
    if (cleanSlug) {
      destinationPaths.push({
        params: { slug: cleanSlug },
        props: { type: 'destination', entry }
      });
    }
  }

  // ৩. সাধারণ পেজ ডাটা লোডার (About, Privacy, Terms ইত্যাদি)
  let pages: any[] = [];
  try { 
    pages = await getCollection('pages'); 
  } catch (e) {
    pages = [];
  }

  if (!pages || pages.length === 0) {
    try {
      const rawGlobPages = import.meta.glob(['/src/content/pages/*.{md,mdx}', '../content/pages/*.{md,mdx}'], { eager: true });
      pages = Object.entries(rawGlobPages).map(([filePath, item]: [string, any]) => ({
        id: filePath.split('/').pop()?.replace(/\.(md|mdx)$/, ''),
        data: item.frontmatter || item.data || {},
        Content: item.default || item.Content || null,
        body: item.compiledContent ? item.compiledContent() : ''
      }));
    } catch (e) {
      pages = [];
    }
  }

  // ডুপ্লিকেট ইউআরএল প্রতিরোধ
  const takenSlugs = new Set([
    ...hotelPaths.map((p: any) => p.params.slug),
    ...destinationPaths.map((p: any) => p.params.slug)
  ]);

  const pagePaths: any[] = [];
  for (const entry of pages) {
    const rawSlug = entry.data?.slug || entry.slug || entry.id || '';
    const cleanSlug = String(rawSlug).split('/').pop()?.replace(/\.(md|mdx)$/, '').trim().toLowerCase();
    if (cleanSlug && !takenSlugs.has(cleanSlug)) {
      pagePaths.push({
        params: { slug: cleanSlug },
        props: { type: 'page', entry }
      });
    }
  }

  return [...hotelPaths, ...destinationPaths, ...pagePaths];
}

const { type = 'hotel', entry } = Astro.props;

// 🔥 Astro 7 Content Layer Compliant Markdown Renderer 🔥
let Content: any = null;
if (type === 'destination' || type === 'page') {
  try {
    const rendered = await render(entry);
    Content = rendered?.Content || null;
  } catch (err) {
    if (entry?.Content) {
      Content = entry.Content;
    } else if (typeof entry?.render === 'function') {
      const res = await entry.render();
      Content = res?.Content || null;
    } else {
      Content = null;
    }
  }
}

// ================= হোটেল মেটাডাটা ও ক্লিন এসইও ইঞ্জিন =================
const hotel = type === 'hotel' ? entry : null;
const hotelData = hotel?.data || {};
const hotelTitle = String(hotelData.title || hotelData.name || "").trim();
const hotelCategory = String(hotelData.category || "Luxury Hotel").trim();
const rawSlug = entry?.data?.slug || entry?.slug || entry?.id || "";
const hotelSlug = String(rawSlug).split('/').pop()?.replace(/\.(md|mdx)$/, '').trim().toLowerCase();

function getShortArea(loc: string): string {
  const s = String(loc || "").toLowerCase();
  if (s.includes('gulshan-2') || s.includes('gulshan 2')) return 'Gulshan 2, Dhaka';
  if (s.includes('gulshan-1') || s.includes('gulshan 1')) return 'Gulshan 1, Dhaka';
  if (s.includes('banani')) return 'Banani, Dhaka';
  if (s.includes('baridhara')) return 'Baridhara, Dhaka';
  if (s.includes('gulshan')) return 'Gulshan, Dhaka';
  return 'Gulshan, Dhaka';
}

const shortArea = getShortArea(hotelData.location);

let pageTitle = hotelData.seo_title ? String(hotelData.seo_title).trim() : "";
if (!pageTitle && hotelTitle) {
  const candidate = `${hotelTitle}: ${hotelCategory} in ${shortArea} | Rates`;
  if (candidate.length <= 60) {
    pageTitle = candidate;
  } else {
    pageTitle = `${hotelTitle} in ${shortArea} | Rates & Booking`;
    if (pageTitle.length > 60) {
      pageTitle = `${hotelTitle} (${shortArea.split(',')[0]}) | Rates`;
    }
  }
}

let metaDescription = hotelData.seo_description ? String(hotelData.seo_description).trim() : "";
if (!metaDescription && hotelTitle) {
  metaDescription = `Book your stay at ${hotelTitle} in ${shortArea}. Explore room rates, photos, amenities, guest reviews, and direct reservation details.`;
}

const rawImage = hotelData.image || (Array.isArray(hotelData.gallery) && hotelData.gallery.length > 0 
  ? (typeof hotelData.gallery[0] === 'object' ? hotelData.gallery[0]?.photo || hotelData.gallery[0]?.image : hotelData.gallery[0]) 
  : "");
const hotelImage = rawImage || "/images/hotel-placeholder.webp";
---

{type === 'destination' ? (
  <LocationCategoryTemplate entry={entry} Content={Content} />
) : type === 'page' ? (
  <PageView entry={entry} Content={Content} />
) : (
  <Layout 
    title={pageTitle}
    description={metaDescription}
    image={hotelImage}
    canonical={`https://gulshanhotels.com/${hotelSlug}/`}
  >
    <HotelMasterSchema hotel={hotel} />
    <HotelHeader hotel={hotel} />
    <HotelSubNav hotel={hotel} />

    <section id="about-and-rates" class="bg-white py-12 px-4 sm:px-6 lg:px-0 max-w-7xl mx-auto text-slate-800 border-b border-slate-200 scroll-mt-14 sm:scroll-mt-16">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-start">
        <div class="lg:col-span-7">
          <HotelAbout hotel={hotel} />
        </div>

        <div class="lg:col-span-5 lg:sticky lg:top-16 z-20">
          <HotelRates hotel={hotel} />
        </div>
      </div>
    </section>

    <HotelAmenitiesAndRooms hotel={hotel} />
    <HotelLocationMap hotel={hotel} />
    <HotelPolicies hotel={hotel} />
    <HotelReviews hotel={hotel} />
    <HotelInsiderTips hotel={hotel} />
    <HotelFaqsSection hotel={hotel} />
    <HotelNearbyHotels currentHotel={hotel} />
  </Layout>
)}
