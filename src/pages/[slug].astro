---
// src/pages/[slug].astro
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const hotels = await getCollection('hotels');
  return hotels.map((entry: any) => ({
    params: { slug: entry.id || entry.slug },
    props: { hotel: entry },
  }));
}

const { hotel } = Astro.props;
const data = hotel.data || {};

const hotelTitle = data.title || data.name || "Gulshan Hotel";
const hotelCategory = data.category || "5-Star Luxury Stay";
const hotelLocation = data.location || "Gulshan 2, Dhaka, Bangladesh";
const hotelPrice = data.price || "৳ 18,500 / night";
const hotelRating = data.rating;
const reviewsCount = data.reviewsCount;
const hotelImage = data.image || "https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&w=1200&q=80";

const galleryImages = data.gallery && data.gallery.length > 0 ? data.gallery : [
  hotelImage,
  "https://images.unsplash.com/photo-1582719478250-c89cae4dc85b?auto=format&fit=crop&w=800&q=80",
  "https://images.unsplash.com/photo-1542314831-068cd1dbfeeb?auto=format&fit=crop&w=800&q=80",
  "https://images.unsplash.com/photo-1571896349842-33c89424de2d?auto=format&fit=crop&w=800&q=80",
  "https://images.unsplash.com/photo-1512917774080-9991f1c4c750?auto=format&fit=crop&w=800&q=80"
];

const amenitiesList = data.amenities && data.amenities.length > 0 ? data.amenities : [
  "High-Speed Free Wi-Fi",
  "Swimming Pool & Jacuzzi",
  "Luxury Wellness Spa",
  "Fitness Center / Gym",
  "Multi-Cuisine Restaurant",
  "Rooftop Lounge & Bar",
  "24/7 Airport Transfer",
  "Complimentary Valet Parking",
  "24/7 Security & CCTV"
];

const nearbyPlaces = data.nearby_places && data.nearby_places.length > 0 ? data.nearby_places : [
  { name: "Gulshan Lake Park", distance: "250m" },
  { name: "Chef's Table Gulshan", distance: "400m" },
  { name: "US Embassy & Diplomatic Enclosure", distance: "1.2km" },
  { name: "Pink City Shopping Complex", distance: "500m" },
  { name: "United Hospital Gulshan", distance: "850m" },
  { name: "Dhaka Elevated Expressway Ramp", distance: "1.5km" }
];
---

<Layout title={`${hotelTitle} — Verified Hotel in Gulshan, Dhaka`}>

  <!-- 1. TOP HEADER & TITLE -->
  <section class="bg-[#f7f5f0] text-slate-900 pt-8 pb-6 px-4 sm:px-8 border-b border-slate-200">
    <div class="max-w-[1400px] mx-auto space-y-3">
      
      <!-- Breadcrumb -->
      <div class="flex items-center gap-2 text-xs sm:text-sm text-slate-500">
        <a href="/" class="hover:text-emerald-700 transition">Home</a>
        <span>/</span>
        <a href="/#all-hotels" class="hover:text-emerald-700 transition">Gulshan Hotels</a>
        <span>/</span>
        <span class="text-slate-800 font-bold">{hotelTitle}</span>
      </div>

      <div>
        <span class="bg-emerald-100 text-emerald-800 border border-emerald-300 text-xs font-black uppercase tracking-widest px-3 py-1 rounded-full inline-block mb-2">
          {hotelCategory}
        </span>

        <h1 class="text-3xl sm:text-5xl font-black font-serif text-slate-900 leading-tight">{hotelTitle}</h1>
        
        <p class="text-sm sm:text-base text-slate-700 mt-2 flex flex-wrap items-center gap-2 font-medium">
          <span class="flex items-center gap-1">
            <svg class="w-4 h-4 fill-emerald-600 shrink-0" viewBox="0 0 24 24"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>
            {hotelLocation}
          </span>
          {hotelRating && (
            <>
              <span>•</span>
              <span class="text-amber-600 font-bold flex items-center gap-1">
                <svg class="w-4 h-4 fill-amber-500" viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
                {hotelRating}
              </span>
              {reviewsCount && <span class="text-slate-500">({reviewsCount} reviews)</span>}
            </>
          )}
        </p>
      </div>

    </div>
  </section>

  <!-- 2. HOTEL IMAGES (BOOKING.COM STYLE GALLERY GRID) -->
  <section class="py-6 px-4 sm:px-8 max-w-[1400px] mx-auto">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-3 rounded-3xl overflow-hidden shadow-sm">
      
      <div class="md:col-span-2 h-[320px] sm:h-[420px] relative overflow-hidden group">
        <img src={galleryImages[0]} alt={hotelTitle} class="w-full h-full object-cover group-hover:scale-105 transition duration-500" />
      </div>

      <div class="hidden md:grid md:col-span-2 grid-cols-2 gap-3 h-[420px]">
        {galleryImages.slice(1, 5).map((img: string, idx: number) => (
          <div class="h-[204px] relative overflow-hidden group rounded-xl">
            <img src={img} alt={`${hotelTitle} photo ${idx+2}`} class="w-full h-full object-cover group-hover:scale-105 transition duration-500" />
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- MAIN PAGE CONTENT (NO INDIVIDUAL ITEM BOX BORDERS & LARGER TEXT) -->
  <section class="py-6 px-4 sm:px-8 max-w-[1400px] mx-auto grid grid-cols-1 lg:grid-cols-12 gap-10">
    
    <!-- LEFT MAIN COLUMN -->
    <div class="lg:col-span-8 space-y-10 text-slate-800">
      
      <!-- 1. OVERVIEW -->
      <div id="overview" class="border-b border-slate-200 pb-8 space-y-3">
        <h2 class="text-2xl sm:text-3xl font-black font-serif text-slate-900 border-b border-slate-200 pb-3">Hotel Overview</h2>
        
        <div class="prose prose-slate text-sm sm:text-base leading-relaxed text-slate-700">
          {hotel.body ? <Fragment set:html={hotel.body} /> : (
            <p>
              Located in the heart of Gulshan, <strong>{hotelTitle}</strong> offers executive lodging with world-class hospitality, high-speed Wi-Fi, fine dining restaurants, and easy access to foreign embassies, commercial corporate headquarters, and shopping plazas.
            </p>
          )}
        </div>
      </div>

      <!-- 2. LOCATION & LIVE GOOGLE MAP -->
      <div id="location" class="border-b border-slate-200 pb-8 space-y-4">
        <div>
          <h2 class="text-2xl sm:text-3xl font-black font-serif text-slate-900">Location & Map</h2>
          <p class="text-sm sm:text-base text-slate-600 mt-1 flex items-center gap-1.5 font-medium">
            <svg class="w-5 h-5 fill-emerald-600 shrink-0" viewBox="0 0 24 24"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>
            {hotelLocation}
          </p>
        </div>

        <div class="rounded-2xl overflow-hidden border border-slate-200 h-72 sm:h-80 shadow-sm">
          <iframe 
            src={`https://maps.google.com/maps?q=${encodeURIComponent(hotelTitle + ' ' + hotelLocation)}&t=&z=15&ie=UTF8&iwloc=&output=embed`}
            class="w-full h-full border-0" 
            allowfullscreen 
            loading="lazy"
            title={`${hotelTitle} Location Map`}
          ></iframe>
        </div>
      </div>

      <!-- 3. HOTEL AMENITIES (NO ITEM BORDER BOXES & LARGER TEXT) -->
      <div id="amenities" class="border-b border-slate-200 pb-8 space-y-4">
        <h2 class="text-2xl sm:text-3xl font-black font-serif text-slate-900 border-b border-slate-200 pb-3">Hotel Amenities</h2>
        
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3 text-sm sm:text-base">
          {amenitiesList.map((item: string) => (
            <div class="flex items-center gap-2.5 font-semibold text-slate-800 py-1">
              <svg class="w-5 h-5 fill-emerald-600 shrink-0" viewBox="0 0 24 24"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
              <span>{item}</span>
            </div>
          ))}
        </div>
      </div>

      <!-- 4. WHAT'S NEARBY (NO ITEM BORDER BOXES & LARGER TEXT) -->
      <div id="nearby" class="border-b border-slate-200 pb-8 space-y-4">
        <h2 class="text-2xl sm:text-3xl font-black font-serif text-slate-900 border-b border-slate-200 pb-3">What's Nearby</h2>
        
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-8 gap-y-3 text-sm sm:text-base">
          {nearbyPlaces.map((place: any) => (
            <div class="flex justify-between items-center py-2 border-b border-slate-100">
              <span class="font-bold text-slate-800 flex items-center gap-2">
                <svg class="w-5 h-5 fill-emerald-600 shrink-0" viewBox="0 0 24 24"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>
                {place.name}
              </span>
              <span class="text-emerald-700 font-extrabold text-sm">{place.distance}</span>
            </div>
          ))}
        </div>
      </div>

      <!-- 5. HOTEL INFORMATION & ESSENTIAL DETAILS (LARGER TEXT) -->
      <div id="information" class="space-y-6">
        <h2 class="text-2xl sm:text-3xl font-black font-serif text-slate-900 border-b border-slate-200 pb-3">Hotel Information & Rules</h2>
        
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 py-2">
          <div>
            <span class="text-slate-500 block font-bold text-xs uppercase tracking-wider">Check-In</span>
            <span class="font-black text-slate-900 text-base sm:text-lg mt-0.5 block">2:00 PM</span>
          </div>
          <div>
            <span class="text-slate-500 block font-bold text-xs uppercase tracking-wider">Check-Out</span>
            <span class="font-black text-slate-900 text-base sm:text-lg mt-0.5 block">12:00 PM</span>
          </div>
          <div>
            <span class="text-slate-500 block font-bold text-xs uppercase tracking-wider">Smoking Policy</span>
            <span class="font-black text-slate-900 text-base sm:text-lg mt-0.5 block">Non-Smoking</span>
          </div>
          <div>
            <span class="text-slate-500 block font-bold text-xs uppercase tracking-wider">Power Backup</span>
            <span class="font-black text-emerald-700 text-base sm:text-lg mt-0.5 block">24/7 Generator</span>
          </div>
        </div>

        <div class="space-y-3 pt-4 border-t border-slate-200">
          <h3 class="font-bold text-slate-900 text-sm uppercase tracking-wider">General Policies</h3>
          <ul class="text-sm sm:text-base text-slate-700 space-y-2.5">
            <li class="flex items-center gap-2.5">
              <svg class="w-5 h-5 fill-emerald-600 shrink-0" viewBox="0 0 24 24"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
              <span>Valid Government Photo ID (NID / Passport) is required at check-in.</span>
            </li>
            <li class="flex items-center gap-2.5">
              <svg class="w-5 h-5 fill-emerald-600 shrink-0" viewBox="0 0 24 24"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
              <span>Pets policy is subject to hotel management approval.</span>
            </li>
          </ul>
        </div>
      </div>

    </div>

    <!-- RIGHT STICKY ACTION SIDEBAR (30%) -->
    <div class="lg:col-span-4">
      <div class="sticky top-[90px] bg-slate-900 text-white p-6 sm:p-8 rounded-3xl border border-slate-800 shadow-2xl space-y-6">
        
        {hotelPrice && (
          <div>
            <span class="text-xs uppercase font-bold text-emerald-400 tracking-widest block">Starting Rate</span>
            <span class="text-3xl sm:text-4xl font-black text-white mt-1 block">{hotelPrice}</span>
            <span class="text-xs text-slate-400 block mt-1">/ night + taxes & fees</span>
          </div>
        )}

        <!-- ACTION BUTTONS -->
        <div class="space-y-3 pt-2">
          {data.officialSite ? (
            <a href={data.officialSite} target="_blank" rel="noopener noreferrer" class="w-full bg-emerald-600 hover:bg-emerald-500 text-white font-extrabold text-sm py-3.5 rounded-xl shadow-lg transition flex items-center justify-center gap-2">
              <span>Check Official Site Price</span>
              <span>➔</span>
            </a>
          ) : (
            <a href="#information" class="w-full bg-emerald-600 hover:bg-emerald-500 text-white font-extrabold text-sm py-3.5 rounded-xl shadow-lg transition flex items-center justify-center gap-2">
              <span>Book Your Stay</span>
              <span>➔</span>
            </a>
          )}

          {data.whatsapp && (
            <a href={`https://wa.me/${data.whatsapp}?text=${encodeURIComponent('Hi, I want to inquire about reservation at ' + hotelTitle)}`} target="_blank" rel="noopener noreferrer" class="w-full bg-slate-800 hover:bg-slate-700 text-slate-200 font-bold text-xs sm:text-sm py-3 rounded-xl border border-slate-700 transition flex items-center justify-center gap-2">
              <svg class="w-4 h-4 fill-emerald-400 shrink-0" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/></svg>
              <span>Instant WhatsApp Reservation</span>
            </a>
          )}

          {data.phone && (
            <a href={`tel:${data.phone}`} class="w-full bg-slate-800 hover:bg-slate-700 text-slate-200 font-bold text-xs sm:text-sm py-3 rounded-xl border border-slate-700 transition flex items-center justify-center gap-2">
              <svg class="w-4 h-4 fill-emerald-400 shrink-0" viewBox="0 0 24 24"><path d="M6.62 10.79c1.44 2.83 2.62 4.01 5.45 5.45l2.2-2.23c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1v3.5c0 .55-.45 1-1 1C9.39 20 2 12.61 2 3c0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/></svg>
              <span>Direct Call Desk</span>
            </a>
          )}
        </div>

      </div>
    </div>

  </section>

  <!-- MOBILE PINNED BOTTOM BAR -->
  <div class="lg:hidden fixed bottom-0 left-0 right-0 z-50 bg-slate-950 text-white border-t border-slate-800 p-3 px-5 flex justify-between items-center shadow-2xl backdrop-blur-md">
    <div>
      <span class="text-[10px] text-slate-400 block font-bold">Starting Rate</span>
      <span class="font-black text-emerald-400 text-base">{hotelPrice || 'Check Price'}</span>
    </div>
    <a href="#information" class="bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-black px-5 py-2.5 rounded-xl shadow transition">
      Check Price ➔
    </a>
  </div>

</Layout>
