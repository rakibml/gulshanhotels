---
// src/pages/[slug].astro
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  let hotels: any[] = [];
  try {
    const collectionData = await getCollection('hotels');
    if (collectionData && collectionData.length > 0) {
      hotels = collectionData.map((item: any) => ({
        params: { slug: (item.slug || item.id?.replace(/\.md$/, '') || 'hotel').toLowerCase() },
        props: { hotel: item },
      }));
    }
  } catch (err) {
    hotels = [];
  }

  // ক্লাউডফেয়ার বিল্ড সেফটি চেক
  if (!hotels || hotels.length === 0) {
    return [
      {
        params: { slug: 'hotel' },
        props: { hotel: { data: { title: 'Hotel Details' } } },
      },
    ];
  }

  return hotels;
}

const { hotel } = Astro.props;
const data = hotel?.data || {};
const hotelTitle = data.title || 'Hotel Details';
---

<Layout title={`${hotelTitle} - GulshanHotels.com`}>
  <main class="py-12 bg-slate-50 min-h-screen">
    <div class="max-w-[1200px] mx-auto px-4 space-y-6">
      <a href="/" class="text-xs font-bold text-emerald-800 uppercase">➔ Back to Home</a>
      <div class="bg-white p-8 rounded-3xl border border-slate-200 space-y-4 shadow-sm">
        <h1 class="text-4xl font-black text-slate-900">{hotelTitle}</h1>
        <p class="text-slate-600 text-sm leading-relaxed">{data.editorNote || data.description || 'Welcome to Gulshan, Dhaka.'}</p>
      </div>
    </div>
  </main>
</Layout>
