---
// src/pages/[slug].astro (Master Single Hotel Page Template)
import Layout from '../layouts/Layout.astro';
import HotelHeader from '../components/hotel/HotelHeader.astro';
import HotelAboutAndRates from '../components/hotel/HotelAboutAndRates.astro';
import HotelAmenitiesAndRooms from '../components/hotel/HotelAmenitiesAndRooms.astro';
import HotelLocationMap from '../components/hotel/HotelLocationMap.astro';
import HotelReviews from '../components/hotel/HotelReviews.astro';
import HotelFaqsSection from '../components/hotel/HotelFaqsSection.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  let hotels: any[] = [];
  try {
    hotels = await getCollection('hotels');
  } catch (e) {
    hotels = [];
  }

  // Backup glob scanner
  if (!hotels || hotels.length === 0) {
    try {
      const rawGlob = import.meta.glob('../content/hotels/*.md', { eager: true });
      hotels = Object.entries(rawGlob).map(([filePath, item]: [string, any]) => ({
        id: filePath.split('/').pop()?.replace('.md', ''),
        data: item.frontmatter || {},
        body: item.compiledContent ? item.compiledContent() : ''
      }));
    } catch (e) {
      hotels = [];
    }
  }

  return hotels.map((entry: any) => {
    const rawId = entry.id || entry.slug || '';
    const cleanSlug = rawId
      .split('/')
      .pop()
      .replace(/\.md$/, '')
      .toLowerCase();

    return {
      params: { slug: cleanSlug || 'hotel' },
      props: { hotel: entry },
    };
  });
}

const { hotel } = Astro.props;
---

<Layout title={`${hotel?.data?.title || 'Hotel'} — Verified Hotel in Gulshan, Dhaka`}>
  <!-- 1. HERO HEADER & TITLE -->
  <HotelHeader hotel={hotel} />

  <!-- 2. ABOUT HOTEL & LIVE STAY22 API RATES -->
  <HotelAboutAndRates hotel={hotel} />

  <!-- 3. AMENITIES & FEATURED ROOMS -->
  <HotelAmenitiesAndRooms hotel={hotel} />

   <!-- 5. LOCATION MAP -->
  <HotelLocationMap hotel={hotel} />

  <!-- 6. GUEST REVIEWS -->
  <HotelReviews hotel={hotel} />

  <!-- 7. FAQS ACCORDION -->
  <HotelFaqsSection hotel={hotel} />
</Layout>
