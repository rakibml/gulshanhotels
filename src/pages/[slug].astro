---
// src/pages/[slug].astro
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

export const prerender = true;

export async function getStaticPaths() {
  let globList = [];
  try {
    const rawGlob = import.meta.glob('../content/hotels/*.md', { eager: true });
    globList = Object.entries(rawGlob).map(([filePath, file]: [string, any]) => {
      const filename = filePath.split('/').pop()?.replace('.md', '') || 'hotel';
      return {
        params: { slug: filename },
        props: { hotel: file.frontmatter, content: file.Content },
      };
    });
  } catch (e) {
    globList = [];
  }

  if (globList.length === 0) {
    globList = [
      {
        params: { slug: 'amari-dhaka' },
        props: {
          hotel: {
            title: 'Amari Dhaka',
            category: '4-Star Boutique',
            location: 'Gulshan 2, Dhaka',
            price: '৳ 16,000 / night',
            rating: 4.8,
            image: 'https://images.unsplash.com/photo-1542314831-068cd1dbfeeb?auto=format&fit=crop&w=1200&q=80',
          },
          content: null
        }
      },
      {
        params: { slug: 'the-westin-dhaka' },
        props: {
          hotel: {
            title: 'The Westin Dhaka',
            category: '5-Star Luxury',
            location: 'Gulshan 2, Dhaka',
            price: '৳ 18,500 / night',
            rating: 4.9,
            image: 'https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&w=1200&q=80',
          },
          content: null
        }
      },
      {
        params: { slug: 'renaissance-dhaka' },
        props: {
          hotel: {
            title: 'Renaissance Dhaka Gulshan Hotel',
            category: '5-Star Premium',
            location: 'Gulshan 1, Dhaka',
            price: '৳ 22,000 / night',
            rating: 4.7,
            image: 'https://images.unsplash.com/photo-1582719478250-c89cae4dc85b?auto=format&fit=crop&w=1200&q=80',
          },
          content: null
        }
      }
    ];
  }

  return globList;
}

const { hotel } = Astro.props;
---

<Layout title={`${hotel?.title || 'Hotel Review'} - GulshanHotels.com`}>
  <main class="bg-[#F8FAF9] py-12 px-4 sm:px-8 lg:px-12 min-h-screen">
    <div class="max-w-[1200px] mx-auto space-y-8">
      
      <!-- Back Link -->
      <a href="/#hotels" class="inline-flex items-center space-x-2 text-xs font-black uppercase text-emerald-800 hover:text-emerald-600 transition">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
        <span>Back to All Hotels</span>
      </a>

      <!-- Main Hotel Details Banner Card -->
      <div class="bg-white rounded-3xl shadow-xl overflow-hidden border border-slate-200/90 grid grid-cols-1 md:grid-cols-12 gap-0">
        
        <!-- Image Container -->
        <div class="md:col-span-6 relative h-72 sm:h-[420px]">
          <img src={hotel?.image} alt={hotel?.title} class="w-full h-full object-cover" />
          <span class="absolute top-4 left-4 bg-[#0B1813] text-emerald-400 text-xs font-black uppercase px-3 py-1 rounded-lg border border-emerald-500/30 shadow">
            {hotel?.category || 'Luxury Hotel'}
          </span>
        </div>

        <!-- Details Box -->
        <div class="md:col-span-6 p-6 sm:p-10 flex flex-col justify-between space-y-6">
          <div class="space-y-4">
            <div class="flex justify-between items-center">
              <span class="text-xs font-bold text-slate-500 flex items-center gap-1">
                <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/></svg>
                <span>{hotel?.location}</span>
              </span>
              <span class="text-amber-500 font-black text-sm flex items-center gap-1">
                <svg class="w-4 h-4 text-amber-500 fill-amber-500" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                <span>{hotel?.rating || '4.8'} / 5</span>
              </span>
            </div>

            <h1 class="text-3xl sm:text-4xl font-black text-slate-900">{hotel?.title}</h1>
            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed pt-2">
              Experience world-class hospitality in the heart of Gulshan, Dhaka. Featuring luxury suites, fine dining, rooftop swimming pool, and spa facilities.
            </p>

            <div class="flex flex-wrap gap-2 pt-2">
              <span class="bg-slate-100 text-slate-700 text-xs font-bold px-3 py-1.5 rounded-xl border border-slate-200">Free High-Speed Wi-Fi</span>
              <span class="bg-slate-100 text-slate-700 text-xs font-bold px-3 py-1.5 rounded-xl border border-slate-200">Swimming Pool</span>
              <span class="bg-slate-100 text-slate-700 text-xs font-bold px-3 py-1.5 rounded-xl border border-slate-200">Spa & Wellness</span>
              <span class="bg-slate-100 text-slate-700 text-xs font-bold px-3 py-1.5 rounded-xl border border-slate-200">Fitness Gym</span>
            </div>
          </div>

          <!-- Price & Agoda Affiliate Button -->
          <div class="pt-6 border-t border-slate-100 flex flex-col sm:flex-row items-center justify-between gap-4">
            <div>
              <span class="text-[10px] text-slate-400 font-black uppercase block">Estimated Rate</span>
              <span class="text-2xl font-black text-slate-900">{hotel?.price}</span>
            </div>

            <a 
              href="https://agoda.com" 
              target="_blank" 
              rel="noopener noreferrer" 
              class="w-full sm:w-auto bg-[#D4AF37] hover:bg-amber-400 text-slate-950 font-black px-8 py-3.5 rounded-xl text-xs uppercase tracking-wider text-center shadow-lg transition"
            >
              Check Deals on Agoda ➔
            </a>
          </div>
        </div>

      </div>

    </div>
  </main>
</Layout>
