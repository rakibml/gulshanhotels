---
// src/pages/[slug].astro (Master Single Hotel Page Template - 100% SEO & Social Share Ready)
import Layout from '../layouts/Layout.astro';
import HotelHeader from '../components/hotel/HotelHeader.astro';
import HotelAboutAndRates from '../components/hotel/HotelAboutAndRates.astro';
import HotelAmenitiesAndRooms from '../components/hotel/HotelAmenitiesAndRooms.astro';
import HotelLocationMap from '../components/hotel/HotelLocationMap.astro';
import HotelReviews from '../components/hotel/HotelReviews.astro';
import HotelFaqsSection from '../components/hotel/HotelFaqsSection.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  let hotels: any[] = [];
  try {
    hotels = await getCollection('hotels');
  } catch (e) {
    hotels = [];
  }

  // Backup glob scanner fallback
  if (!hotels || hotels.length === 0) {
    try {
      const rawGlob = import.meta.glob('../content/hotels/*.md', { eager: true });
      hotels = Object.entries(rawGlob).map(([filePath, item]: [string, any]) => ({
        id: filePath.split('/').pop()?.replace('.md', ''),
        data: item.frontmatter || {},
        body: item.compiledContent ? item.compiledContent() : ''
      }));
    } catch (e) {
      hotels = [];
    }
  }

  // Process all entries for Custom Slug & Body Compilation
  const paths = await Promise.all(
    hotels.map(async (entry: any) => {
      // 1. Priority to Admin Panel Custom Slug, then entry.id / entry.slug
      const rawSlug = entry.data?.slug || entry.id || entry.slug || '';
      const cleanSlug = rawSlug
        .split('/')
        .pop()
        .replace(/\.md$/, '')
        .toLowerCase();

      // 2. Safe Body Compilation
      let renderedBody = entry.body || '';
      if (typeof entry.render === 'function') {
        try {
          const { Content } = await entry.render();
          renderedBody = Content;
        } catch (e) {}
      }

      return {
        params: { slug: cleanSlug || 'hotel' },
        props: { 
          hotel: {
            ...entry,
            renderedBody
          } 
        },
      };
    })
  );

  return paths;
}

const { hotel } = Astro.props;
const data = hotel?.data || {};

const hotelTitle = data.title || data.name || "Hotel Details";
const hotelCategory = data.category || "Luxury Stay";
const hotelLocation = data.location || "Dhaka, Bangladesh";
const hotelImage = data.image || "https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&w=1200&q=80";

// Smart Dynamic SEO Meta Description
const metaDescription = data.seo_description 
  || data.description 
  || `Book your stay at ${hotelTitle}, a verified ${hotelCategory} located in ${hotelLocation}. Check live room rates, amenities, photo gallery, and reviews.`;
---

<Layout 
  title={`${hotelTitle} — Verified ${hotelCategory} in ${hotelLocation}`}
  description={metaDescription}
  image={hotelImage}
>
  <!-- 1. HERO HEADER & TITLE -->
  <HotelHeader hotel={hotel} />

  <!-- 2. ABOUT HOTEL & LIVE STAY22 API RATES -->
  <HotelAboutAndRates hotel={hotel} />

  <!-- 3. AMENITIES & FEATURED ROOMS -->
  <HotelAmenitiesAndRooms hotel={hotel} />

  <!-- 4. LOCATION MAP -->
  <HotelLocationMap hotel={hotel} />

  <!-- 5. GUEST REVIEWS -->
  <HotelReviews hotel={hotel} />

  <!-- 6. FAQS ACCORDION -->
  <HotelFaqsSection hotel={hotel} />
</Layout>
