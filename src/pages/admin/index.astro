---
// src/pages/admin/index.astro
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>GulshanHotels - Admin Dashboard</title>
  </head>
  <body>
    <!-- Decap CMS Script -->
    <script src="https://unpkg.com/decap-cms@^3.0.0/dist/decap-cms.js"></script>

    <!-- Inline Configuration (No external config.yml file needed) -->
    <script is:inline>
      window.CMS_MANUAL_INIT = true;

      document.addEventListener('DOMContentLoaded', () => {
        if (window.CMS) {
          window.CMS.init({
            config: {
              backend: {
                name: 'github',
                repo: 'rakibml/gulshanhotels',
                branch: 'main'
              },
              media_folder: 'public/images/uploads',
              public_folder: '/images/uploads',
              collections: [
                {
                  name: 'hotels',
                  label: 'Hotels List',
                  folder: 'src/content/hotels',
                  create: true,
                  slug: '{{slug}}',
                  fields: [
                    { label: 'Hotel Name', name: 'title', widget: 'string' },
                    { 
                      label: 'Category', 
                      name: 'category', 
                      widget: 'select', 
                      options: ['5-Star Luxury', '4-Star Boutique', '3-Star Hotel', 'Serviced Apartment', 'Budget Stay'] 
                    },
                    { label: 'Location', name: 'location', widget: 'string', default: 'Gulshan 2, Dhaka' },
                    { label: 'Price Range', name: 'price', widget: 'string', default: '$$$$' },
                    { label: 'Star Rating', name: 'rating', widget: 'number', value_type: 'float', default: 4.8 },
                    { label: 'Featured Image', name: 'image', widget: 'image' },
                    { label: 'Featured on Homepage', name: 'featured', widget: 'boolean', default: true },
                    { label: 'Full Hotel Review & Features', name: 'body', widget: 'markdown' }
                  ]
                }
              ]
            }
          });
        }
      });
    </script>
  </body>
</html>