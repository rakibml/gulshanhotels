---
// src/pages/ocean-view-grand-resort.astro
import Layout from '../layouts/Layout.astro';
---

<Layout title="Ocean View Grand Resort - Gulshan 2, Dhaka | GulshanHotels Directory">
  
  <!-- Top Header Section -->
  <div class="py-6 px-4 sm:px-6 lg:px-12 max-w-[1600px] mx-auto border-b border-slate-200 font-sans">
    <div class="flex items-center justify-between mb-3">
      <nav class="flex items-center gap-2 text-xs font-semibold text-slate-500 uppercase tracking-wider">
        <a href="/" class="hover:text-[#1a382b]">Home</a>
        <span>/</span>
        <a href="/hotels" class="hover:text-[#1a382b]">Hotels</a>
        <span>/</span>
        <span class="text-slate-900">Gulshan 2</span>
      </nav>

      <span class="inline-flex items-center gap-1.5 px-3 py-1 bg-[#f0f4f1] text-[#1a382b] text-xs font-bold rounded-full border border-emerald-200 shadow-xs">
        <svg class="w-3.5 h-3.5 fill-[#1a382b]" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
        GulshanHotels Verified Directory
      </span>
    </div>

    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <h1 class="font-serif text-3xl sm:text-5xl font-bold text-[#1a382b] tracking-tight">
          Ocean View Grand Resort
        </h1>
        <p class="text-xs sm:text-sm text-slate-600 mt-2 font-medium flex flex-wrap items-center gap-2">
          <span class="text-amber-700 font-bold">★ 4.9 (48 Verified Reviews)</span>
          <span>•</span>
          <span class="flex items-center gap-1 text-slate-700">📍 Road 112, Gulshan 2, Diplomatic Zone, Dhaka</span>
        </p>
      </div>

      <div class="flex items-center gap-2">
        <button id="shareBtn" class="px-4 py-2 text-xs font-semibold text-slate-700 bg-white border border-slate-200 rounded-full hover:bg-slate-50 transition shadow-xs">🔗 Share</button>
        <button id="wishlistBtn" class="px-4 py-2 text-xs font-semibold text-rose-600 bg-white border border-slate-200 rounded-full hover:bg-slate-50 transition shadow-xs">♥ Wishlist</button>
      </div>
    </div>
  </div>

  <!-- 📸 REFERENCE input_file_6.png : Sticky Section Navigation Tabs Bar -->
  <div class="sticky top-16 z-30 bg-white/95 backdrop-blur-md border-b border-slate-200 py-3 mb-6 shadow-xs overflow-x-auto scrollbar-none">
    <div class="flex items-center gap-2 max-w-[1600px] mx-auto px-4 sm:px-6 lg:px-12 text-xs font-bold text-slate-600 whitespace-nowrap">
      <a href="#overview" class="px-4 py-2 bg-[#211f2e] text-white rounded-full shadow-xs">Overview</a>
      <a href="#amenities" class="px-4 py-2 hover:bg-slate-100 rounded-full transition">Amenities</a>
      <a href="#surroundings" class="px-4 py-2 hover:bg-slate-100 rounded-full transition">Surroundings</a>
      <a href="#houserules" class="px-4 py-2 hover:bg-slate-100 rounded-full transition">House Rules</a>
      <a href="#details" class="px-4 py-2 hover:bg-slate-100 rounded-full transition">Essential Details</a>
      <a href="#reviews" class="px-4 py-2 hover:bg-slate-100 rounded-full transition">Reviews</a>
    </div>
  </div>

  <main class="px-4 sm:px-6 lg:px-12 max-w-[1600px] mx-auto space-y-12 pb-28 lg:pb-12 font-sans text-slate-800">
    
    <!-- Image Gallery -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-2 sm:gap-3 rounded-2xl overflow-hidden max-h-[320px] sm:max-h-[460px] shadow-xs relative">
      <div class="col-span-2 md:col-span-2 md:row-span-2 h-[220px] sm:h-[320px] md:h-[460px]">
        <img src="https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&w=1200&q=80" alt="Resort Front View" class="gallery-img w-full h-full object-cover hover:scale-105 transition-transform duration-500 cursor-pointer" />
      </div>
      <div class="hidden sm:block h-[150px] md:h-[224px]">
        <img src="https://images.unsplash.com/photo-1582719508461-905c673771fd?auto=format&fit=crop&w=600&q=80" alt="Pool View" class="gallery-img w-full h-full object-cover hover:scale-105 transition-transform duration-500 cursor-pointer" />
      </div>
      <div class="hidden sm:block h-[150px] md:h-[224px]">
        <img src="https://images.unsplash.com/photo-1542314831-068cd1dbfeeb?auto=format&fit=crop&w=600&q=80" alt="Bedroom View" class="gallery-img w-full h-full object-cover hover:scale-105 transition-transform duration-500 cursor-pointer" />
      </div>
      <div class="hidden md:block h-[224px]">
        <img src="https://images.unsplash.com/photo-1571896349842-33c89424de2d?auto=format&fit=crop&w=600&q=80" alt="Balcony View" class="gallery-img w-full h-full object-cover hover:scale-105 transition-transform duration-500 cursor-pointer" />
      </div>
      <div class="hidden md:block h-[224px] relative">
        <img src="https://images.unsplash.com/photo-1520250497591-112f2f40a3f4?auto=format&fit=crop&w=600&q=80" alt="Dining View" class="gallery-img w-full h-full object-cover hover:scale-105 transition-transform duration-500 cursor-pointer" />
      </div>

      <button id="viewAllPhotosBtn" class="absolute bottom-3 right-3 bg-white/90 text-slate-800 text-xs font-bold px-3.5 py-2 rounded-lg border border-slate-200 shadow-md hover:bg-white transition">
        📷 View All Photos (5)
      </button>
    </div>

    <!-- Main 2-Column Split Layout -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 lg:gap-10">
      
      <!-- LEFT COLUMN (70%) -->
      <div class="lg:col-span-2 space-y-12">
        
        <!-- Overview Section -->
        <div id="overview" class="space-y-4 pb-8 border-b border-slate-200">
          <div class="bg-[#f4f7f5] border border-emerald-100 rounded-2xl p-5 space-y-2 mb-4">
            <div class="flex items-center gap-2">
              <span class="bg-[#1a382b] text-white text-[10px] font-bold uppercase tracking-wider px-2.5 py-0.5 rounded">Editor's Pick</span>
              <span class="text-xs font-bold text-[#1a382b]">GulshanHotels Inspection Note</span>
            </div>
            <p class="text-xs sm:text-sm text-slate-700 leading-relaxed italic">
              "Ideal accommodation choice for business travelers, diplomats, and expats visiting Gulshan 2. Highly rated for its 24/7 power backup, high-speed fiber internet, and top-tier security within the Diplomatic Zone."
            </p>
          </div>

          <h2 class="font-serif text-2xl sm:text-3xl font-bold text-[#1a382b]">About Ocean View Grand Resort</h2>
          <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
            Ocean View Grand Resort provides luxury accommodations located in the heart of Gulshan 2, Diplomatic Zone, Dhaka. Specially designed for international delegates, corporate executives, and diplomats, the property features spacious suites, fine-dining restaurants, and state-of-the-art conference facilities with maximum security.
          </p>
        </div>

        <!-- 📸 REFERENCE input_file_7.png : Featured Amenities Dark Section -->
        <div id="amenities" class="bg-[#211f2e] text-white rounded-3xl p-6 sm:p-10 shadow-xl relative overflow-hidden">
          <div class="space-y-1 mb-8">
            <span class="text-[10px] font-bold text-amber-400 uppercase tracking-widest">AMENITIES</span>
            <h3 class="text-2xl sm:text-3xl font-black tracking-tight">Featured Amenities <span class="text-slate-400 font-normal text-lg">(18)</span></h3>
          </div>

          <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
            <div class="lg:col-span-7 grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-slate-800/80 border border-slate-700/60 flex items-center justify-center text-lg shrink-0">🏊</div>
                <span class="text-xs font-bold text-slate-200">Indoor Heated Pool</span>
              </div>
              <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-slate-800/80 border border-slate-700/60 flex items-center justify-center text-lg shrink-0">🍳</div>
                <span class="text-xs font-bold text-slate-200">Continental Breakfast*</span>
              </div>
              <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-slate-800/80 border border-slate-700/60 flex items-center justify-center text-lg shrink-0">📶</div>
                <span class="text-xs font-bold text-slate-200">Free High-Speed Wi-Fi</span>
              </div>
              <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-slate-800/80 border border-slate-700/60 flex items-center justify-center text-lg shrink-0">🏋️</div>
                <span class="text-xs font-bold text-slate-200">Fitness Center / Exercise</span>
              </div>
              <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-slate-800/80 border border-slate-700/60 flex items-center justify-center text-lg shrink-0">⚡</div>
                <span class="text-xs font-bold text-slate-200">24/7 Power Generator</span>
              </div>
              <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-slate-800/80 border border-slate-700/60 flex items-center justify-center text-lg shrink-0">🚗</div>
                <span class="text-xs font-bold text-slate-200">Airport Shuttle Service</span>
              </div>
            </div>

            <!-- Image Card with Yellow Accent Border (Matching input_file_7.png) -->
            <div class="lg:col-span-5 relative pl-3 pb-3">
              <div class="absolute inset-0 bg-amber-400 rounded-2xl transform translate-x-3 translate-y-3 z-0"></div>
              <div class="relative z-10 rounded-2xl overflow-hidden shadow-2xl h-[200px] sm:h-[240px]">
                <img src="https://images.unsplash.com/photo-1582719508461-905c673771fd?auto=format&fit=crop&w=800&q=80" alt="Featured Amenity" class="w-full h-full object-cover" />
              </div>
            </div>
          </div>
        </div>

        <!-- 📸 REFERENCE input_file_10.png : Hotel Surroundings & Distances -->
        <div id="surroundings" class="space-y-6 pb-8 border-b border-slate-200">
          <div>
            <h3 class="font-serif text-2xl font-bold text-slate-900">Hotel surroundings</h3>
            <p class="text-xs text-slate-500 mt-1">Shortest estimated walking or driving distances displayed, actual distances may vary.</p>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8 text-xs">
            <div class="space-y-3">
              <h4 class="font-bold text-slate-900 flex items-center gap-2 text-sm">
                <span>🚶</span> What's nearby
              </h4>
              <ul class="space-y-2.5 text-slate-600 font-medium">
                <li class="flex justify-between border-b border-slate-100 pb-1.5">
                  <span>Pink City Shopping Complex</span>
                  <span class="text-slate-400">300 m</span>
                </li>
                <li class="flex justify-between border-b border-slate-100 pb-1.5">
                  <span>Gulshan 2 Circle</span>
                  <span class="text-slate-400">400 m</span>
                </li>
                <li class="flex justify-between border-b border-slate-100 pb-1.5">
                  <span>US Embassy & Diplomatic Zone</span>
                  <span class="text-slate-400">1.8 km</span>
                </li>
                <li class="flex justify-between border-b border-slate-100 pb-1.5">
                  <span>Indian Visa Application Center</span>
                  <span class="text-slate-400">2.1 km</span>
                </li>
              </ul>
            </div>

            <div class="space-y-3">
              <h4 class="font-bold text-slate-900 flex items-center gap-2 text-sm">
                <span>🍽️</span> Restaurants & cafes
              </h4>
              <ul class="space-y-2.5 text-slate-600 font-medium">
                <li class="flex justify-between border-b border-slate-100 pb-1.5">
                  <span>North End Coffee Roasters</span>
                  <span class="text-slate-400">250 m</span>
                </li>
                <li class="flex justify-between border-b border-slate-100 pb-1.5">
                  <span>Chef's Table Courtside</span>
                  <span class="text-slate-400">500 m</span>
                </li>
                <li class="flex justify-between border-b border-slate-100 pb-1.5">
                  <span>Izumi Fine Dining</span>
                  <span class="text-slate-400">650 m</span>
                </li>
              </ul>
            </div>

            <div class="space-y-3">
              <h4 class="font-bold text-slate-900 flex items-center gap-2 text-sm">
                <span>✈️</span> Closest airports & transport
              </h4>
              <ul class="space-y-2.5 text-slate-600 font-medium">
                <li class="flex justify-between border-b border-slate-100 pb-1.5">
                  <span>Hazrat Shahjalal Intl Airport</span>
                  <span class="text-slate-400">9.5 km</span>
                </li>
                <li class="flex justify-between border-b border-slate-100 pb-1.5">
                  <span>Kamalapur Railway Station</span>
                  <span class="text-slate-400">11 km</span>
                </li>
              </ul>
            </div>
          </div>
        </div>

        <!-- 📸 REFERENCE input_file_9.png : Booking.com Style House Rules Card -->
        <div id="houserules" class="bg-white rounded-2xl border border-slate-200 p-6 shadow-xs space-y-6">
          <div>
            <h3 class="font-serif text-2xl font-bold text-slate-900">House rules</h3>
            <p class="text-xs text-slate-500 mt-1">Ocean View Grand Resort takes special requests - add in the next step!</p>
          </div>

          <div class="divide-y divide-slate-100 text-xs">
            <div class="py-3.5 grid grid-cols-1 md:grid-cols-3 gap-2">
              <div class="font-bold text-slate-900 flex items-center gap-2">
                <span>➔</span> Check-in
              </div>
              <div class="md:col-span-2 text-slate-600 font-medium">From 12:00 PM to 00:00 AM</div>
            </div>

            <div class="py-3.5 grid grid-cols-1 md:grid-cols-3 gap-2">
              <div class="font-bold text-slate-900 flex items-center gap-2">
                <span>←</span> Check-out
              </div>
              <div class="md:col-span-2 text-slate-600 font-medium">From 06:00 AM to 11:00 AM</div>
            </div>

            <div class="py-3.5 grid grid-cols-1 md:grid-cols-3 gap-2">
              <div class="font-bold text-slate-900 flex items-center gap-2">
                <span>ℹ️</span> Cancellation / prepayment
              </div>
              <div class="md:col-span-2 text-slate-600 font-medium">
                Cancellation and prepayment policies vary according to accommodation type. Free cancellation up to 48 hours before arrival.
              </div>
            </div>

            <div class="py-3.5 grid grid-cols-1 md:grid-cols-3 gap-2">
              <div class="font-bold text-slate-900 flex items-center gap-2">
                <span>👨‍👩‍👧</span> Children and beds
              </div>
              <div class="md:col-span-2 text-slate-600 space-y-1 font-medium">
                <p><strong>Child policies:</strong> Children of any age are welcome. Children 12 years and above charged as adults.</p>
                <p><strong>Cot and extra bed policies:</strong> Extra beds available upon request (৳১,০০০ / night).</p>
              </div>
            </div>

            <div class="py-3.5 grid grid-cols-1 md:grid-cols-3 gap-2">
              <div class="font-bold text-slate-900 flex items-center gap-2">
                <span>🐾</span> Pets
              </div>
              <div class="md:col-span-2 text-slate-600 font-medium">Pets are not allowed. Only service animals permitted.</div>
            </div>

            <div class="py-3.5 grid grid-cols-1 md:grid-cols-3 gap-2">
              <div class="font-bold text-slate-900 flex items-center gap-2">
                <span>💳</span> Payment options
              </div>
              <div class="md:col-span-2 text-slate-600 font-medium">Accepts Cash, Credit Cards (Visa/MasterCard), bKash, and Nagad.</div>
            </div>
          </div>
        </div>

        <!-- 📸 REFERENCE input_file_8.png : Essential Details Icon Grid Section -->
        <div id="details" class="bg-slate-100/80 p-6 sm:p-8 rounded-2xl space-y-6">
          <div>
            <span class="text-[10px] font-bold text-amber-700 uppercase tracking-widest block mb-1">INFO</span>
            <h3 class="font-serif text-2xl font-bold text-slate-900">Essential details</h3>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 text-xs">
            <div class="flex items-start gap-3">
              <div class="w-10 h-10 rounded-xl bg-slate-200/80 flex items-center justify-center text-lg shrink-0">🕒</div>
              <div>
                <h4 class="font-bold text-slate-900">Check-In</h4>
                <p class="text-slate-500 font-medium">12:00 PM</p>
              </div>
            </div>

            <div class="flex items-start gap-3">
              <div class="w-10 h-10 rounded-xl bg-slate-200/80 flex items-center justify-center text-lg shrink-0">⏰</div>
              <div>
                <h4 class="font-bold text-slate-900">Check-Out</h4>
                <p class="text-slate-500 font-medium">11:00 AM</p>
              </div>
            </div>

            <div class="flex items-start gap-3">
              <div class="w-10 h-10 rounded-xl bg-slate-200/80 flex items-center justify-center text-lg shrink-0">🚭</div>
              <div>
                <h4 class="font-bold text-slate-900">No Smoking</h4>
                <p class="text-slate-500 font-medium">100% Smoke Free Hotel</p>
              </div>
            </div>

            <div class="flex items-start gap-3">
              <div class="w-10 h-10 rounded-xl bg-slate-200/80 flex items-center justify-center text-lg shrink-0">📞</div>
              <div>
                <h4 class="font-bold text-slate-900">Phone Number</h4>
                <p class="text-slate-500 font-medium">+880 1700-000000</p>
              </div>
            </div>

            <div class="flex items-start gap-3">
              <div class="w-10 h-10 rounded-xl bg-slate-200/80 flex items-center justify-center text-lg shrink-0">👶</div>
              <div>
                <h4 class="font-bold text-slate-900">Children</h4>
                <p class="text-slate-500 font-medium">Under 6 stay free</p>
              </div>
            </div>

            <div class="flex items-start gap-3">
              <div class="w-10 h-10 rounded-xl bg-slate-200/80 flex items-center justify-center text-lg shrink-0">🏢</div>
              <div>
                <h4 class="font-bold text-slate-900">Office Hours</h4>
                <p class="text-slate-500 font-medium">24/7 Front Desk</p>
              </div>
            </div>

            <div class="flex items-start gap-3">
              <div class="w-10 h-10 rounded-xl bg-slate-200/80 flex items-center justify-center text-lg shrink-0">🐾</div>
              <div>
                <h4 class="font-bold text-slate-900">Pets</h4>
                <p class="text-slate-500 font-medium">Pets Allowed: No</p>
              </div>
            </div>

            <div class="flex items-start gap-3">
              <div class="w-10 h-10 rounded-xl bg-slate-200/80 flex items-center justify-center text-lg shrink-0">⚡</div>
              <div>
                <h4 class="font-bold text-slate-900">Power Backup</h4>
                <p class="text-slate-500 font-medium">24/7 Full Generator</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Guest Reviews -->
        <div id="reviews" class="space-y-4">
          <span class="text-[11px] font-bold text-[#a87247] uppercase tracking-wider block mb-1">VERIFIED FEEDBACK</span>
          <h3 class="font-serif text-xl sm:text-2xl font-bold text-[#1a382b]">Guest Reviews (★ 4.9 out of 5)</h3>
          
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div class="p-5 bg-white rounded-2xl border border-slate-200 shadow-xs space-y-2">
              <div class="flex items-center gap-3">
                <div class="w-9 h-9 rounded-full bg-[#f0f4f1] text-[#1a382b] font-bold flex items-center justify-center text-xs">RH</div>
                <div>
                  <h4 class="font-bold text-xs text-slate-900">Rahat Hasan</h4>
                  <p class="text-[10px] text-slate-400">July 2026</p>
                </div>
              </div>
              <p class="text-xs text-slate-600 leading-relaxed">
                "An amazing stay in the heart of Gulshan 2! Excellent security, fast Wi-Fi for business work, and great hospitality."
              </p>
            </div>

            <div class="p-5 bg-white rounded-2xl border border-slate-200 shadow-xs space-y-2">
              <div class="flex items-center gap-3">
                <div class="w-9 h-9 rounded-full bg-[#f0f4f1] text-[#1a382b] font-bold flex items-center justify-center text-xs">SA</div>
                <div>
                  <h4 class="font-bold text-xs text-slate-900">Sultana Ahmed</h4>
                  <p class="text-[10px] text-slate-400">June 2026</p>
                </div>
              </div>
              <p class="text-xs text-slate-600 leading-relaxed">
                "Very convenient location near embassies. The breakfast buffet was fresh and delicious. Highly recommended."
              </p>
            </div>
          </div>
        </div>

      </div>

      <!-- RIGHT COLUMN (30% - Direct Contacts & Comparison Box) -->
      <div>
        <div class="sticky top-24 bg-white p-6 rounded-2xl border border-slate-200 shadow-lg space-y-6">
          
          <div class="flex justify-between items-baseline border-b border-slate-100 pb-4">
            <div>
              <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block">Estimated Rate</span>
              <span class="font-serif text-3xl font-bold text-[#1a382b]">৳৪,৫০—</span>
              <span class="text-xs text-slate-500 font-medium"> / night</span>
            </div>
            <span class="text-xs font-bold text-[#1a382b] bg-[#f0f4f1] px-2.5 py-1 rounded-full border border-emerald-100">
              Verified
            </span>
          </div>

          <div class="space-y-2.5">
            <span class="text-[11px] font-bold text-slate-400 uppercase tracking-wider block mb-1">DIRECT CONTACTS</span>
            
            <a href="tel:+8801700000000" class="w-full bg-[#1a382b] hover:bg-[#11251c] text-white font-bold text-xs py-3.5 rounded-xl flex items-center justify-center gap-2 transition shadow-xs">
              📞 Direct Call: +880 1700-000000
            </a>

            <a href="https://wa.me/8801700000000" target="_blank" class="w-full border-2 border-emerald-600 text-emerald-700 hover:bg-emerald-50 font-bold text-xs py-3 rounded-xl flex items-center justify-center gap-2 transition">
              💬 Chat on WhatsApp
            </a>

            <a href="https://oceanviewresort.com" target="_blank" rel="nofollow sponsored" class="w-full bg-slate-100 hover:bg-slate-200 text-slate-800 font-bold text-xs py-3 rounded-xl flex items-center justify-center gap-2 transition">
              🌐 Visit Official Website ↗
            </a>
          </div>

          <div class="pt-4 border-t border-slate-100 space-y-2">
            <span class="text-[11px] font-bold text-slate-400 uppercase tracking-wider block mb-1">COMPARE RATES</span>
            
            <button class="reserveBtnTrigger w-full text-xs font-bold text-emerald-800 bg-emerald-50 hover:bg-emerald-100 border border-emerald-200 py-2.5 rounded-xl flex items-center justify-center gap-1 transition">
              🏨 Book Directly with Hotel
            </button>

            <a href="https://booking.com" target="_blank" rel="nofollow sponsored" class="w-full text-xs font-bold text-blue-700 bg-blue-50 hover:bg-blue-100 border border-blue-200 py-2.5 rounded-xl flex items-center justify-center gap-1 transition">
              🔵 Compare on Booking.com
            </a>

            <a href="https://agoda.com" target="_blank" rel="nofollow sponsored" class="w-full text-xs font-bold text-rose-700 bg-rose-50 hover:bg-rose-100 border border-rose-200 py-2.5 rounded-xl flex items-center justify-center gap-1 transition">
              🔴 Compare on Agoda
            </a>
          </div>

          <p class="text-[11px] text-center text-slate-400 font-medium">Official directory listing. No booking middleman fees.</p>

        </div>
      </div>

    </div>

  </main>

  <!-- MODALS -->
  <div id="imageModal" class="fixed inset-0 z-50 bg-black/95 hidden flex-col items-center justify-center p-4">
    <button id="closeModalBtn" class="absolute top-4 right-4 text-white text-3xl font-bold p-2">&times;</button>
    <div class="relative max-w-5xl w-full flex items-center justify-center">
      <button id="prevImgBtn" class="absolute left-2 text-white text-3xl font-bold bg-white/20 w-12 h-12 rounded-full flex items-center justify-center backdrop-blur-md">&#10094;</button>
      <img id="modalImage" class="max-h-[75vh] max-w-full object-contain rounded-lg" src="" alt="Full view" />
      <button id="nextImgBtn" class="absolute right-2 text-white text-3xl font-bold bg-white/20 w-12 h-12 rounded-full flex items-center justify-center backdrop-blur-md">&#10095;</button>
    </div>
    <span id="imgCounter" class="text-white text-xs font-bold mt-4">1 / 5</span>
  </div>

  <div id="bookingModal" class="fixed inset-0 z-50 bg-black/60 hidden items-center justify-center p-4 backdrop-blur-xs">
    <div class="bg-white rounded-2xl max-w-md w-full p-6 space-y-4 shadow-2xl relative border border-slate-200">
      <button id="closeBookingBtn" class="absolute top-4 right-4 text-slate-400 hover:text-slate-700 text-2xl font-bold p-1">&times;</button>
      
      <h3 class="font-serif text-xl font-bold text-[#1a382b]">Direct Hotel Enquiry</h3>
      <p class="text-xs text-slate-500">Send an official inquiry directly to Ocean View Grand Resort management.</p>

      <form id="bookingForm" class="space-y-3 pt-1">
        <div>
          <label class="block text-xs font-bold text-slate-700 uppercase mb-1">Your Full Name</label>
          <input type="text" required placeholder="Enter your name" class="w-full border border-slate-200 p-2.5 rounded-lg text-xs focus:outline-none focus:border-[#1a382b] bg-slate-50" />
        </div>
        <div>
          <label class="block text-xs font-bold text-slate-700 uppercase mb-1">Phone / WhatsApp Number</label>
          <input type="tel" required placeholder="+880 1700-000000" class="w-full border border-slate-200 p-2.5 rounded-lg text-xs focus:outline-none focus:border-[#1a382b] bg-slate-50" />
        </div>
        <div>
          <label class="block text-xs font-bold text-slate-700 uppercase mb-1">Inquiry Message</label>
          <textarea rows="3" placeholder="Expected dates, number of guests..." class="w-full border border-slate-200 p-2.5 rounded-lg text-xs focus:outline-none focus:border-[#1a382b] bg-slate-50"></textarea>
        </div>

        <button type="submit" class="w-full bg-[#1a382b] hover:bg-[#11251c] text-white font-bold py-3.5 rounded-xl text-xs uppercase tracking-wider transition mt-2">
          Send Direct Inquiry ➔
        </button>
      </form>
    </div>
  </div>

  <!-- Google Schema -->
  <script type="application/ld+json" is:inline>
    {
      "@context": "https://schema.org",
      "@type": "LodgingBusiness",
      "name": "Ocean View Grand Resort",
      "description": "Official accommodation directory listing for Ocean View Grand Resort in Gulshan 2, Diplomatic Zone, Dhaka.",
      "url": "https://gulshanhotels.com/ocean-view-grand-resort",
      "telephone": "+8801700000000",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Road 112, Gulshan 2",
        "addressLocality": "Dhaka",
        "postalCode": "1212",
        "addressCountry": "BD"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": 23.7925,
        "longitude": 90.4167
      },
      "starRating": {
        "@type": "Rating",
        "ratingValue": "4.9"
      },
      "priceRange": "BDT 4,500 - 8,500"
    }
  </script>

  <!-- Interactive JS -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const galleryImgs = document.querySelectorAll('.gallery-img');
      const viewAllBtn = document.getElementById('viewAllPhotosBtn');
      const imageModal = document.getElementById('imageModal');
      const modalImg = document.getElementById('modalImage');
      const closeModalBtn = document.getElementById('closeModalBtn');
      const prevBtn = document.getElementById('prevImgBtn');
      const nextBtn = document.getElementById('nextImgBtn');
      const imgCounter = document.getElementById('imgCounter');

      const imgList = Array.from(galleryImgs).map(img => img.src);
      let currentIndex = 0;

      function openModal(index) {
        currentIndex = index;
        if(modalImg) modalImg.src = imgList[currentIndex];
        if(imgCounter) imgCounter.innerText = `${currentIndex + 1} / ${imgList.length}`;
        imageModal?.classList.remove('hidden');
        imageModal?.classList.add('flex');
      }

      function closeModalFunc() {
        imageModal?.classList.add('hidden');
        imageModal?.classList.remove('flex');
      }

      galleryImgs.forEach((img, idx) => {
        img.addEventListener('click', () => openModal(idx));
      });

      if(viewAllBtn) viewAllBtn.addEventListener('click', () => openModal(0));
      if(closeModalBtn) closeModalBtn.addEventListener('click', closeModalFunc);

      if(prevBtn) {
        prevBtn.addEventListener('click', () => {
          currentIndex = (currentIndex - 1 + imgList.length) % imgList.length;
          modalImg.src = imgList[currentIndex];
          imgCounter.innerText = `${currentIndex + 1} / ${imgList.length}`;
        });
      }

      if(nextBtn) {
        nextBtn.addEventListener('click', () => {
          currentIndex = (currentIndex + 1) % imgList.length;
          modalImg.src = imgList[currentIndex];
          imgCounter.innerText = `${currentIndex + 1} / ${imgList.length}`;
        });
      }

      const shareBtn = document.getElementById('shareBtn');
      if(shareBtn) {
        shareBtn.addEventListener('click', () => {
          navigator.clipboard.writeText(window.location.href);
          alert('Hotel directory link copied to clipboard! 📋');
        });
      }

      const reserveTriggers = document.querySelectorAll('.reserveBtnTrigger');
      const bookingModal = document.getElementById('bookingModal');
      const closeBookingBtn = document.getElementById('closeBookingBtn');
      const bookingForm = document.getElementById('bookingForm');

      function openBookingModalFunc() {
        bookingModal?.classList.remove('hidden');
        bookingModal?.classList.add('flex');
      }

      function closeBookingModalFunc() {
        bookingModal?.classList.add('hidden');
        bookingModal?.classList.remove('flex');
      }

      reserveTriggers.forEach(btn => btn.addEventListener('click', openBookingModalFunc));
      if(closeBookingBtn) closeBookingBtn.addEventListener('click', closeBookingModalFunc);

      if(bookingForm) {
        bookingForm.addEventListener('submit', (e) => {
          e.preventDefault();
          alert('Your enquiry has been sent to the hotel! Thank you.');
          closeBookingModalFunc();
        });
      }
    });
  </script>

</Layout>
