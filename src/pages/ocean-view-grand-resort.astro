---
// src/pages/ocean-view-grand-resort.astro
import Layout from '../layouts/Layout.astro';
---

<Layout title="Ocean View Grand Resort - Gulshan 2, Dhaka | GulshanHotels Directory">
  
  <main class="py-6 sm:py-10 px-4 sm:px-6 lg:px-12 max-w-[1600px] mx-auto space-y-8 pb-28 lg:pb-12">
    
    <!-- 1. Breadcrumb & Directory Verified Header -->
    <div class="border-b border-slate-200 pb-6">
      
      <!-- Top Badges -->
      <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
        <nav class="flex items-center gap-1.5 text-[11px] sm:text-xs font-bold text-slate-500 uppercase tracking-wider overflow-x-auto whitespace-nowrap">
          <a href="/" class="hover:text-emerald-600 transition">HOME</a>
          <span>/</span>
          <a href="/hotels" class="hover:text-emerald-600 transition">HOTELS</a>
          <span>/</span>
          <span class="text-slate-900">GULSHAN 2</span>
        </nav>

        <!-- Directory Verified Badge -->
        <span class="bg-emerald-50 text-emerald-800 border border-emerald-200 text-[11px] font-black px-3 py-1 rounded-full flex items-center gap-1.5 shadow-sm">
          <svg class="w-3.5 h-3.5 fill-emerald-600" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M6.267 3.455a3.066 3.066 0 001.745-.723 3.066 3.066 0 013.976 0 3.066 3.066 0 001.745.723 3.066 3.066 0 012.812 2.812c.051.643.304 1.254.723 1.745a3.066 3.066 0 010 3.976 3.066 3.066 0 00-.723 1.745 3.066 3.066 0 01-2.812 2.812 3.066 3.066 0 00-1.745.723 3.066 3.066 0 01-3.976 0 3.066 3.066 0 00-1.745-.723 3.066 3.066 0 01-2.812-2.812 3.066 3.066 0 00-.723-1.745 3.066 3.066 0 010-3.976 3.066 3.066 0 00.723-1.745 3.066 3.066 0 012.812-2.812zm7.44 5.252a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
          GULSHANHOTELS VERIFIED DIRECTORY
        </span>
      </div>

      <!-- Title & Location -->
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
          <h1 class="text-3xl sm:text-5xl font-black text-slate-900 tracking-tight leading-tight">
            Ocean View Grand Resort
          </h1>
          <p class="text-xs sm:text-sm text-slate-600 mt-2 font-semibold flex flex-wrap items-center gap-2">
            <span class="text-amber-600 font-bold">★ 4.9 (48 Verified Reviews)</span>
            <span>•</span>
            <span class="flex items-center gap-1 text-slate-700">
              📍 Road 112, Gulshan 2, Diplomatic Zone, Dhaka 1212
            </span>
          </p>
        </div>

        <!-- Action Buttons -->
        <div class="flex items-center gap-2">
          <button id="shareBtn" class="px-3.5 py-2 text-xs font-extrabold uppercase tracking-wider text-slate-700 bg-white border border-slate-200 rounded-lg hover:bg-slate-50 transition shadow-sm active:scale-95">
            🔗 Share
          </button>
          <button id="wishlistBtn" class="px-3.5 py-2 text-xs font-extrabold uppercase tracking-wider text-rose-600 bg-white border border-slate-200 rounded-lg hover:bg-slate-50 transition shadow-sm active:scale-95">
            ♥ Wishlist
          </button>
        </div>
      </div>

    </div>

    <!-- 2. Image Gallery Grid -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-2 sm:gap-3 rounded-2xl overflow-hidden max-h-[320px] sm:max-h-[460px] shadow-sm relative">
      <div class="col-span-2 md:col-span-2 md:row-span-2 h-[220px] sm:h-[320px] md:h-[460px]">
        <img src="https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&w=1200&q=80" alt="Resort Front View" class="gallery-img w-full h-full object-cover hover:scale-105 transition-transform duration-500 cursor-pointer" />
      </div>
      <div class="hidden sm:block h-[150px] md:h-[224px]">
        <img src="https://images.unsplash.com/photo-1582719508461-905c673771fd?auto=format&fit=crop&w=600&q=80" alt="Pool View" class="gallery-img w-full h-full object-cover hover:scale-105 transition-transform duration-500 cursor-pointer" />
      </div>
      <div class="hidden sm:block h-[150px] md:h-[224px]">
        <img src="https://images.unsplash.com/photo-1542314831-068cd1dbfeeb?auto=format&fit=crop&w=600&q=80" alt="Bedroom View" class="gallery-img w-full h-full object-cover hover:scale-105 transition-transform duration-500 cursor-pointer" />
      </div>
      <div class="hidden md:block h-[224px]">
        <img src="https://images.unsplash.com/photo-1571896349842-33c89424de2d?auto=format&fit=crop&w=600&q=80" alt="Balcony View" class="gallery-img w-full h-full object-cover hover:scale-105 transition-transform duration-500 cursor-pointer" />
      </div>
      <div class="hidden md:block h-[224px] relative">
        <img src="https://images.unsplash.com/photo-1520250497591-112f2f40a3f4?auto=format&fit=crop&w=600&q=80" alt="Dining View" class="gallery-img w-full h-full object-cover hover:scale-105 transition-transform duration-500 cursor-pointer" />
      </div>

      <button id="viewAllPhotosBtn" class="absolute bottom-3 right-3 bg-slate-900/90 text-white text-xs font-black px-3.5 py-2 rounded-lg backdrop-blur-sm hover:bg-slate-900 transition shadow-md">
        📷 View All Photos (5)
      </button>
    </div>

    <!-- 3. Directory Content Grid (2 Columns) -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 lg:gap-10 pt-2">
      
      <!-- LEFT COLUMN (70% - Directory Details & Guides) -->
      <div class="lg:col-span-2 space-y-8">
        
        <!-- Editor's Review & Local Note -->
        <div class="bg-slate-900 text-white p-5 sm:p-6 rounded-2xl space-y-3 shadow-md border border-slate-800">
          <div class="flex items-center gap-2">
            <span class="bg-emerald-600 text-white text-[10px] font-black uppercase px-2.5 py-1 rounded-md">Editor's Note</span>
            <span class="text-xs text-slate-300 font-bold">GulshanHotels Local Inspection Report</span>
          </div>
          <p class="text-xs sm:text-sm text-slate-200 leading-relaxed italic">
            "Ideal accommodation choice for business travelers, diplomats, and expats visiting Gulshan 2. Highly rated for its 24/7 power backup, high-speed fiber internet, and top-tier security within the Diplomatic Zone."
          </p>
        </div>

        <!-- Diplomatic Zone & Local Area Landmarks Guide -->
        <div class="space-y-4 pb-8 border-b border-slate-200">
          <h3 class="text-xs font-black uppercase tracking-wider text-emerald-700">Location Guide</h3>
          <h4 class="text-xl sm:text-2xl font-bold text-slate-900">Nearby Landmarks & Distances</h4>
          
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs text-slate-700">
            <div class="p-3.5 bg-white rounded-xl border border-slate-200 flex items-center justify-between shadow-sm">
              <span class="font-bold flex items-center gap-2">🏛️ US Embassy / Indian Visa Center</span>
              <span class="text-emerald-700 font-black">~8 mins drive</span>
            </div>
            <div class="p-3.5 bg-white rounded-xl border border-slate-200 flex items-center justify-between shadow-sm">
              <span class="font-bold flex items-center gap-2">🛍️ Pink City & Gulshan 2 Circle</span>
              <span class="text-emerald-700 font-black">~3 mins walk</span>
            </div>
            <div class="p-3.5 bg-white rounded-xl border border-slate-200 flex items-center justify-between shadow-sm">
              <span class="font-bold flex items-center gap-2">✈️ Hazrat Shahjalal Intl Airport</span>
              <span class="text-emerald-700 font-black">~20 mins drive</span>
            </div>
            <div class="p-3.5 bg-white rounded-xl border border-slate-200 flex items-center justify-between shadow-sm">
              <span class="font-bold flex items-center gap-2">🏥 United Hospital Gulshan</span>
              <span class="text-emerald-700 font-black">~5 mins drive</span>
            </div>
          </div>
        </div>

        <!-- Executive & Business Amenities -->
        <div class="space-y-4 pb-8 border-b border-slate-200">
          <h3 class="text-xs font-black uppercase tracking-wider text-emerald-700">Facilities</h3>
          <h4 class="text-xl sm:text-2xl font-bold text-slate-900">Executive Stay Amenities</h4>
          
          <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
            <div class="p-3.5 bg-white rounded-xl border border-slate-200 text-xs font-bold text-slate-800 shadow-sm flex items-center gap-2">
              <span class="text-base">⚡</span> 24/7 Power Backup
            </div>
            <div class="p-3.5 bg-white rounded-xl border border-slate-200 text-xs font-bold text-slate-800 shadow-sm flex items-center gap-2">
              <span class="text-base">📶</span> High-speed Fiber Wi-Fi
            </div>
            <div class="p-3.5 bg-white rounded-xl border border-slate-200 text-xs font-bold text-slate-800 shadow-sm flex items-center gap-2">
              <span class="text-base">🔒</span> Diplomatic Zone Security
            </div>
            <div class="p-3.5 bg-white rounded-xl border border-slate-200 text-xs font-bold text-slate-800 shadow-sm flex items-center gap-2">
              <span class="text-base">🚗</span> Airport Pickup / Shuttle
            </div>
            <div class="p-3.5 bg-white rounded-xl border border-slate-200 text-xs font-bold text-slate-800 shadow-sm flex items-center gap-2">
              <span class="text-base">🍳</span> Complimentary Breakfast
            </div>
            <div class="p-3.5 bg-white rounded-xl border border-slate-200 text-xs font-bold text-slate-800 shadow-sm flex items-center gap-2">
              <span class="text-base">💱</span> Currency Exchange Aid
            </div>
          </div>
        </div>

        <!-- About Property Details -->
        <div class="space-y-3 pb-8 border-b border-slate-200">
          <h3 class="text-xs font-black uppercase tracking-wider text-emerald-700">Property Overview</h3>
          <h4 class="text-xl sm:text-2xl font-bold text-slate-900">About Ocean View Grand Resort</h4>
          <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
            Ocean View Grand Resort provides luxury accommodations located in Gulshan 2, Dhaka. Designed for international delegates, diplomats, and corporate executives, featuring spacious ocean-themed suites, fine dining, and conference facilities.
          </p>
        </div>

      </div>

      <!-- RIGHT COLUMN (30% - Directory Contact & Direct Booking Hub) -->
      <div>
        <div class="sticky top-24 bg-white p-6 rounded-2xl border border-slate-200 shadow-xl space-y-6">
          
          <!-- Price Header -->
          <div class="flex justify-between items-baseline border-b border-slate-100 pb-4">
            <div>
              <span class="text-xs font-bold text-slate-400 block uppercase">Starting From</span>
              <span class="text-3xl font-black text-slate-900">৳৪,৫০—</span>
              <span class="text-xs text-slate-500 font-medium"> / night</span>
            </div>
            <span class="text-xs font-extrabold text-emerald-700 bg-emerald-50 px-2.5 py-1 rounded-md border border-emerald-200">
              Verified
            </span>
          </div>

          <!-- DIRECT CONTACT DIRECTORY HUB -->
          <div class="space-y-3">
            <h4 class="text-xs font-black uppercase tracking-wider text-slate-500">Direct Hotel Contacts</h4>

            <!-- Direct Call Button -->
            <a href="tel:+8801700000000" class="w-full bg-slate-900 hover:bg-slate-800 text-white font-extrabold text-xs py-3.5 rounded-xl flex items-center justify-center gap-2 transition shadow-md">
              📞 Direct Call: +880 1700-000000
            </a>

            <!-- Direct WhatsApp Button -->
            <a href="https://wa.me/8801700000000" target="_blank" class="w-full border-2 border-emerald-600 text-emerald-700 hover:bg-emerald-50 font-extrabold text-xs py-3 rounded-xl flex items-center justify-center gap-2 transition">
              💬 Chat on WhatsApp
            </a>

            <!-- Official Website Outbound Link -->
            <a href="https://oceanviewresort.com" target="_blank" rel="nofollow sponsored" class="w-full bg-slate-100 hover:bg-slate-200 text-slate-800 font-extrabold text-xs py-3 rounded-xl flex items-center justify-center gap-2 transition">
              🌐 Visit Official Website ➔
            </a>
          </div>

          <div class="border-t border-slate-100 pt-4 space-y-3">
            <h4 class="text-xs font-black uppercase tracking-wider text-slate-500">Quick Directory Enquiry</h4>
            <button class="reserveBtnTrigger w-full bg-emerald-700 hover:bg-emerald-800 text-white font-black text-xs uppercase tracking-wider py-3.5 rounded-xl transition shadow-md active:scale-95">
              Send Direct Enquiry
            </button>
          </div>

          <p class="text-[11px] text-center text-slate-400 font-medium">No booking fees. Connect directly with property management.</p>

        </div>
      </div>

    </div>

  </main>

  <!-- 📱 MOBILE FIXED BOTTOM CONTACT BAR -->
  <div class="lg:hidden fixed bottom-0 left-0 right-0 z-40 bg-white/95 backdrop-blur-md border-t border-slate-200 px-4 py-3 shadow-[0_-4px_20px_rgba(0,0,0,0.1)] flex items-center justify-between">
    <div>
      <span class="text-xs text-slate-400 block font-bold">Rates From</span>
      <span class="text-base font-black text-slate-900">৳৪,৫০— /night</span>
    </div>
    <div class="flex items-center gap-2">
      <a href="tel:+8801700000000" class="p-2.5 bg-slate-900 text-white rounded-xl text-xs font-bold">
        📞 Call
      </a>
      <a href="https://wa.me/8801700000000" target="_blank" class="p-2.5 border border-emerald-600 text-emerald-700 rounded-xl bg-emerald-50">
        💬
      </a>
      <button class="reserveBtnTrigger bg-emerald-700 hover:bg-emerald-800 text-white font-black text-xs uppercase tracking-wider px-4 py-2.5 rounded-xl shadow-md">
        Enquire
      </button>
    </div>
  </div>

  <!-- POPUPS / MODALS -->
  <!-- Image Lightbox Modal -->
  <div id="imageModal" class="fixed inset-0 z-50 bg-black/95 hidden flex-col items-center justify-center p-4">
    <button id="closeModalBtn" class="absolute top-4 right-4 text-white text-3xl font-bold p-2">&times;</button>
    <div class="relative max-w-5xl w-full flex items-center justify-center">
      <button id="prevImgBtn" class="absolute left-2 text-white text-3xl font-bold bg-white/20 w-12 h-12 rounded-full flex items-center justify-center backdrop-blur-md">&#10094;</button>
      <img id="modalImage" class="max-h-[75vh] max-w-full object-contain rounded-lg" src="" alt="Full view" />
      <button id="nextImgBtn" class="absolute right-2 text-white text-3xl font-bold bg-white/20 w-12 h-12 rounded-full flex items-center justify-center backdrop-blur-md">&#10095;</button>
    </div>
    <span id="imgCounter" class="text-white text-xs font-bold mt-4">1 / 5</span>
  </div>

  <!-- Quick Enquiry Modal -->
  <div id="bookingModal" class="fixed inset-0 z-50 bg-black/60 hidden items-center justify-center p-4 backdrop-blur-sm">
    <div class="bg-white rounded-2xl max-w-md w-full p-6 space-y-4 shadow-2xl relative border border-slate-200">
      <button id="closeBookingBtn" class="absolute top-4 right-4 text-slate-400 hover:text-slate-700 text-2xl font-bold p-1">&times;</button>
      
      <h3 class="text-xl font-bold text-slate-900">Direct Hotel Enquiry</h3>
      <p class="text-xs text-slate-500">Send an official inquiry directly to Ocean View Grand Resort management.</p>

      <form id="bookingForm" class="space-y-3 pt-1">
        <div>
          <label class="block text-xs font-bold text-slate-700 uppercase mb-1">Your Full Name</label>
          <input type="text" required placeholder="Enter your name" class="w-full border border-slate-200 p-2.5 rounded-lg text-xs focus:outline-none focus:border-emerald-600 bg-slate-50" />
        </div>
        <div>
          <label class="block text-xs font-bold text-slate-700 uppercase mb-1">Phone / WhatsApp Number</label>
          <input type="tel" required placeholder="+880 1700-000000" class="w-full border border-slate-200 p-2.5 rounded-lg text-xs focus:outline-none focus:border-emerald-600 bg-slate-50" />
        </div>
        <div>
          <label class="block text-xs font-bold text-slate-700 uppercase mb-1">Inquiry Message</label>
          <textarea rows="3" placeholder="Expected dates, number of guests, or special requirements..." class="w-full border border-slate-200 p-2.5 rounded-lg text-xs focus:outline-none focus:border-emerald-600 bg-slate-50"></textarea>
        </div>

        <button type="submit" class="w-full bg-emerald-700 hover:bg-emerald-800 text-white font-bold py-3.5 rounded-xl text-xs uppercase tracking-wider transition mt-2">
          Send Direct Inquiry ➔
        </button>
      </form>
    </div>
  </div>

  <!-- Interactive JS Script -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      // Lightbox Modal
      const galleryImgs = document.querySelectorAll('.gallery-img');
      const viewAllBtn = document.getElementById('viewAllPhotosBtn');
      const imageModal = document.getElementById('imageModal');
      const modalImg = document.getElementById('modalImage');
      const closeModalBtn = document.getElementById('closeModalBtn');
      const prevBtn = document.getElementById('prevImgBtn');
      const nextBtn = document.getElementById('nextImgBtn');
      const imgCounter = document.getElementById('imgCounter');

      const imgList = Array.from(galleryImgs).map(img => img.src);
      let currentIndex = 0;

      function openModal(index) {
        currentIndex = index;
        if(modalImg) modalImg.src = imgList[currentIndex];
        if(imgCounter) imgCounter.innerText = `${currentIndex + 1} / ${imgList.length}`;
        imageModal?.classList.remove('hidden');
        imageModal?.classList.add('flex');
      }

      function closeModalFunc() {
        imageModal?.classList.add('hidden');
        imageModal?.classList.remove('flex');
      }

      galleryImgs.forEach((img, idx) => {
        img.addEventListener('click', () => openModal(idx));
      });

      if(viewAllBtn) viewAllBtn.addEventListener('click', () => openModal(0));
      if(closeModalBtn) closeModalBtn.addEventListener('click', closeModalFunc);

      if(prevBtn) {
        prevBtn.addEventListener('click', () => {
          currentIndex = (currentIndex - 1 + imgList.length) % imgList.length;
          modalImg.src = imgList[currentIndex];
          imgCounter.innerText = `${currentIndex + 1} / ${imgList.length}`;
        });
      }

      if(nextBtn) {
        nextBtn.addEventListener('click', () => {
          currentIndex = (currentIndex + 1) % imgList.length;
          modalImg.src = imgList[currentIndex];
          imgCounter.innerText = `${currentIndex + 1} / ${imgList.length}`;
        });
      }

      // Share & Wishlist
      const shareBtn = document.getElementById('shareBtn');
      if(shareBtn) {
        shareBtn.addEventListener('click', () => {
          navigator.clipboard.writeText(window.location.href);
          alert('Hotel directory link copied to clipboard! 📋');
        });
      }

      // Enquiry Modal
      const reserveTriggers = document.querySelectorAll('.reserveBtnTrigger');
      const bookingModal = document.getElementById('bookingModal');
      const closeBookingBtn = document.getElementById('closeBookingBtn');
      const bookingForm = document.getElementById('bookingForm');

      function openBookingModalFunc() {
        bookingModal?.classList.remove('hidden');
        bookingModal?.classList.add('flex');
      }

      function closeBookingModalFunc() {
        bookingModal?.classList.add('hidden');
        bookingModal?.classList.remove('flex');
      }

      reserveTriggers.forEach(btn => btn.addEventListener('click', openBookingModalFunc));
      if(closeBookingBtn) closeBookingBtn.addEventListener('click', closeBookingModalFunc);

      if(bookingForm) {
        bookingForm.addEventListener('submit', (e) => {
          e.preventDefault();
          alert('Your enquiry has been sent to the hotel! Thank you for using GulshanHotels Directory.');
          closeBookingModalFunc();
        });
      }
    });
  </script>

</Layout>
