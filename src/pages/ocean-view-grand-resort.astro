---
// src/pages/ocean-view-grand-resort.astro
import Layout from '../layouts/Layout.astro';
---

<Layout title="Ocean View Grand Resort - Gulshan 2, Dhaka | GulshanHotels Directory">
  
  <main class="py-8 sm:py-12 px-4 sm:px-6 lg:px-12 max-w-[1600px] mx-auto space-y-8 pb-28 lg:pb-12 font-sans text-slate-800">
    
    <!-- 1. Breadcrumb & Title Header -->
    <div class="border-b border-slate-200 pb-6">
      
      <div class="flex items-center justify-between mb-3">
        <nav class="flex items-center gap-2 text-xs font-semibold text-slate-500 uppercase tracking-wider">
          <a href="/" class="hover:text-[#1a382b]">Home</a>
          <span>/</span>
          <a href="/hotels" class="hover:text-[#1a382b]">Hotels</a>
          <span>/</span>
          <span class="text-slate-900">Gulshan 2</span>
        </nav>

        <!-- Clean Inline Verified Badge -->
        <span class="inline-flex items-center gap-1.5 px-3 py-1 bg-[#f0f4f1] text-[#1a382b] text-xs font-bold rounded-full border border-emerald-100">
          <svg class="w-3.5 h-3.5 fill-[#1a382b]" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
          GulshanHotels Verified Directory
        </span>
      </div>

      <!-- Title & Location -->
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
          <h1 class="font-serif text-3xl sm:text-5xl font-bold text-[#1a382b] tracking-tight">
            Ocean View Grand Resort
          </h1>
          <p class="text-xs sm:text-sm text-slate-600 mt-2 font-medium flex flex-wrap items-center gap-2">
            <span class="text-amber-700 font-bold">★ 4.9 (48 Verified Reviews)</span>
            <span>•</span>
            <span class="flex items-center gap-1 text-slate-700">
              📍 Road 112, Gulshan 2, Diplomatic Zone, Dhaka 1212
            </span>
          </p>
        </div>

        <!-- Action Buttons -->
        <div class="flex items-center gap-2">
          <button id="shareBtn" class="px-4 py-2 text-xs font-semibold text-slate-700 bg-white border border-slate-200 rounded-full hover:bg-slate-50 transition shadow-xs">
            🔗 Share
          </button>
          <button id="wishlistBtn" class="px-4 py-2 text-xs font-semibold text-rose-600 bg-white border border-slate-200 rounded-full hover:bg-slate-50 transition shadow-xs">
            ♥ Wishlist
          </button>
        </div>
      </div>

    </div>

    <!-- 2. Image Gallery Grid -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-2 sm:gap-3 rounded-2xl overflow-hidden max-h-[320px] sm:max-h-[460px] shadow-xs relative">
      <div class="col-span-2 md:col-span-2 md:row-span-2 h-[220px] sm:h-[320px] md:h-[460px]">
        <img src="https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&w=1200&q=80" alt="Resort Front View" class="gallery-img w-full h-full object-cover hover:scale-105 transition-transform duration-500 cursor-pointer" />
      </div>
      <div class="hidden sm:block h-[150px] md:h-[224px]">
        <img src="https://images.unsplash.com/photo-1582719508461-905c673771fd?auto=format&fit=crop&w=600&q=80" alt="Pool View" class="gallery-img w-full h-full object-cover hover:scale-105 transition-transform duration-500 cursor-pointer" />
      </div>
      <div class="hidden sm:block h-[150px] md:h-[224px]">
        <img src="https://images.unsplash.com/photo-1542314831-068cd1dbfeeb?auto=format&fit=crop&w=600&q=80" alt="Bedroom View" class="gallery-img w-full h-full object-cover hover:scale-105 transition-transform duration-500 cursor-pointer" />
      </div>
      <div class="hidden md:block h-[224px]">
        <img src="https://images.unsplash.com/photo-1571896349842-33c89424de2d?auto=format&fit=crop&w=600&q=80" alt="Balcony View" class="gallery-img w-full h-full object-cover hover:scale-105 transition-transform duration-500 cursor-pointer" />
      </div>
      <div class="hidden md:block h-[224px] relative">
        <img src="https://images.unsplash.com/photo-1520250497591-112f2f40a3f4?auto=format&fit=crop&w=600&q=80" alt="Dining View" class="gallery-img w-full h-full object-cover hover:scale-105 transition-transform duration-500 cursor-pointer" />
      </div>

      <button id="viewAllPhotosBtn" class="absolute bottom-3 right-3 bg-white/90 text-slate-800 text-xs font-bold px-3.5 py-2 rounded-lg border border-slate-200 shadow-md hover:bg-white transition">
        📷 View All Photos (5)
      </button>
    </div>

    <!-- 3. Directory Content Grid (2 Columns) -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 lg:gap-10 pt-2">
      
      <!-- LEFT COLUMN (70%) -->
      <div class="lg:col-span-2 space-y-8">
        
        <!-- Light & Luxurious Editor's Note -->
        <div class="bg-[#f4f7f5] border border-emerald-100/80 rounded-2xl p-5 sm:p-6 space-y-2">
          <div class="flex items-center gap-2">
            <span class="bg-[#1a382b] text-white text-[10px] font-bold uppercase tracking-wider px-2.5 py-0.5 rounded">Editor's Pick</span>
            <span class="text-xs font-bold text-[#1a382b]">GulshanHotels Inspection Note</span>
          </div>
          <p class="text-xs sm:text-sm text-slate-700 leading-relaxed italic">
            "Ideal accommodation choice for business travelers, diplomats, and expats visiting Gulshan 2. Highly rated for its 24/7 power backup, high-speed fiber internet, and top-tier security within the Diplomatic Zone."
          </p>
        </div>

        <!-- Location Landmarks Guide -->
        <div class="space-y-4 pb-8 border-b border-slate-200">
          <div class="flex justify-between items-end">
            <div>
              <span class="text-[11px] font-bold text-[#a87247] uppercase tracking-wider block mb-1">LOCATION GUIDE</span>
              <h3 class="font-serif text-xl sm:text-2xl font-bold text-[#1a382b]">Nearby Landmarks & Distances</h3>
            </div>
            <a href="https://maps.google.com" target="_blank" class="text-xs font-bold text-[#1a382b] hover:underline hidden sm:block">Open in Google Maps ↗</a>
          </div>
          
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div class="p-4 bg-white rounded-xl border border-slate-200 flex items-center justify-between shadow-xs">
              <div class="flex items-center gap-3">
                <span class="w-8 h-8 rounded-lg bg-[#f0f4f1] text-[#1a382b] flex items-center justify-center text-base">🏛️</span>
                <div>
                  <h4 class="text-xs font-bold text-slate-800">US Embassy & Diplomatic Zone</h4>
                  <p class="text-[11px] text-slate-500">Major embassy area</p>
                </div>
              </div>
              <span class="text-xs font-bold text-[#1a382b] bg-[#f0f4f1] px-2.5 py-1 rounded-md">~8 mins drive</span>
            </div>

            <div class="p-4 bg-white rounded-xl border border-slate-200 flex items-center justify-between shadow-xs">
              <div class="flex items-center gap-3">
                <span class="w-8 h-8 rounded-lg bg-[#f0f4f1] text-[#1a382b] flex items-center justify-center text-base">🛍️</span>
                <div>
                  <h4 class="text-xs font-bold text-slate-800">Pink City & Gulshan 2 Circle</h4>
                  <p class="text-[11px] text-slate-500">Shopping & restaurants</p>
                </div>
              </div>
              <span class="text-xs font-bold text-[#1a382b] bg-[#f0f4f1] px-2.5 py-1 rounded-md">~3 mins walk</span>
            </div>

            <div class="p-4 bg-white rounded-xl border border-slate-200 flex items-center justify-between shadow-xs">
              <div class="flex items-center gap-3">
                <span class="w-8 h-8 rounded-lg bg-[#f0f4f1] text-[#1a382b] flex items-center justify-center text-base">✈️</span>
                <div>
                  <h4 class="text-xs font-bold text-slate-800">Hazrat Shahjalal Intl Airport</h4>
                  <p class="text-[11px] text-slate-500">International terminal</p>
                </div>
              </div>
              <span class="text-xs font-bold text-[#1a382b] bg-[#f0f4f1] px-2.5 py-1 rounded-md">~20 mins drive</span>
            </div>

            <div class="p-4 bg-white rounded-xl border border-slate-200 flex items-center justify-between shadow-xs">
              <div class="flex items-center gap-3">
                <span class="w-8 h-8 rounded-lg bg-[#f0f4f1] text-[#1a382b] flex items-center justify-center text-base">🏥</span>
                <div>
                  <h4 class="text-xs font-bold text-slate-800">United Hospital Gulshan</h4>
                  <p class="text-[11px] text-slate-500">Medical center</p>
                </div>
              </div>
              <span class="text-xs font-bold text-[#1a382b] bg-[#f0f4f1] px-2.5 py-1 rounded-md">~5 mins drive</span>
            </div>
          </div>
        </div>

        <!-- Executive Amenities -->
        <div class="space-y-4 pb-8 border-b border-slate-200">
          <span class="text-[11px] font-bold text-[#a87247] uppercase tracking-wider block mb-1">FACILITIES</span>
          <h3 class="font-serif text-xl sm:text-2xl font-bold text-[#1a382b]">Executive Stay Amenities</h3>
          
          <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
            <div class="p-3.5 bg-white rounded-xl border border-slate-200 text-xs font-bold text-slate-800 shadow-xs flex items-center gap-2.5">
              <span>⚡</span> 24/7 Power Backup
            </div>
            <div class="p-3.5 bg-white rounded-xl border border-slate-200 text-xs font-bold text-slate-800 shadow-xs flex items-center gap-2.5">
              <span>📶</span> High-speed Fiber Wi-Fi
            </div>
            <div class="p-3.5 bg-white rounded-xl border border-slate-200 text-xs font-bold text-slate-800 shadow-xs flex items-center gap-2.5">
              <span>🔒</span> Diplomatic Security
            </div>
            <div class="p-3.5 bg-white rounded-xl border border-slate-200 text-xs font-bold text-slate-800 shadow-xs flex items-center gap-2.5">
              <span>🚗</span> Airport Shuttle
            </div>
            <div class="p-3.5 bg-white rounded-xl border border-slate-200 text-xs font-bold text-slate-800 shadow-xs flex items-center gap-2.5">
              <span>🍳</span> Free Breakfast
            </div>
            <div class="p-3.5 bg-white rounded-xl border border-slate-200 text-xs font-bold text-slate-800 shadow-xs flex items-center gap-2.5">
              <span>💱</span> Currency Exchange Aid
            </div>
          </div>
        </div>

        <!-- Property Description -->
        <div class="space-y-3 pb-8 border-b border-slate-200">
          <span class="text-[11px] font-bold text-[#a87247] uppercase tracking-wider block mb-1">PROPERTY OVERVIEW</span>
          <h3 class="font-serif text-xl sm:text-2xl font-bold text-[#1a382b]">About Ocean View Grand Resort</h3>
          <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
            Ocean View Grand Resort provides luxury accommodations located in Gulshan 2, Dhaka. Designed for international delegates, diplomats, and corporate executives, featuring spacious suites, fine dining, and conference facilities.
          </p>
        </div>

      </div>

      <!-- RIGHT COLUMN (30% - Clean Contact Hub) -->
      <div>
        <div class="sticky top-24 bg-white p-6 rounded-2xl border border-slate-200 shadow-lg space-y-6">
          
          <div class="flex justify-between items-baseline border-b border-slate-100 pb-4">
            <div>
              <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block">Estimated Rate</span>
              <span class="font-serif text-3xl font-bold text-[#1a382b]">৳৪,৫০—</span>
              <span class="text-xs text-slate-500 font-medium"> / night</span>
            </div>
            <span class="text-xs font-bold text-[#1a382b] bg-[#f0f4f1] px-2.5 py-1 rounded-full border border-emerald-100">
              Verified Directory
            </span>
          </div>

          <!-- Primary Contact Buttons -->
          <div class="space-y-3">
            <a href="tel:+8801700000000" class="w-full bg-[#1a382b] hover:bg-[#11251c] text-white font-bold text-xs py-3.5 rounded-xl flex items-center justify-center gap-2 transition shadow-xs">
              📞 Direct Call: +880 1700-000000
            </a>

            <a href="https://wa.me/8801700000000" target="_blank" class="w-full border-2 border-emerald-600 text-emerald-700 hover:bg-emerald-50 font-bold text-xs py-3 rounded-xl flex items-center justify-center gap-2 transition">
              💬 Chat on WhatsApp
            </a>
          </div>

          <!-- Secondary Links -->
          <div class="pt-2 border-t border-slate-100 space-y-2">
            <button class="reserveBtnTrigger w-full text-xs font-bold text-slate-700 hover:text-[#1a382b] py-2 flex items-center justify-center gap-1 transition">
              ✉️ Send Direct Inquiry Form
            </button>
            <a href="https://oceanviewresort.com" target="_blank" rel="nofollow sponsored" class="w-full text-xs font-bold text-slate-500 hover:text-slate-800 py-1 flex items-center justify-center gap-1 transition">
              🌐 Official Hotel Website ↗
            </a>
          </div>

          <p class="text-[11px] text-center text-slate-400 font-medium">Direct directory listing. Connect directly with property management.</p>

        </div>
      </div>

    </div>

  </main>

  <!-- POPUPS / MODALS -->
  <div id="imageModal" class="fixed inset-0 z-50 bg-black/95 hidden flex-col items-center justify-center p-4">
    <button id="closeModalBtn" class="absolute top-4 right-4 text-white text-3xl font-bold p-2">&times;</button>
    <div class="relative max-w-5xl w-full flex items-center justify-center">
      <button id="prevImgBtn" class="absolute left-2 text-white text-3xl font-bold bg-white/20 w-12 h-12 rounded-full flex items-center justify-center backdrop-blur-md">&#10094;</button>
      <img id="modalImage" class="max-h-[75vh] max-w-full object-contain rounded-lg" src="" alt="Full view" />
      <button id="nextImgBtn" class="absolute right-2 text-white text-3xl font-bold bg-white/20 w-12 h-12 rounded-full flex items-center justify-center backdrop-blur-md">&#10095;</button>
    </div>
    <span id="imgCounter" class="text-white text-xs font-bold mt-4">1 / 5</span>
  </div>

  <div id="bookingModal" class="fixed inset-0 z-50 bg-black/60 hidden items-center justify-center p-4 backdrop-blur-xs">
    <div class="bg-white rounded-2xl max-w-md w-full p-6 space-y-4 shadow-2xl relative border border-slate-200">
      <button id="closeBookingBtn" class="absolute top-4 right-4 text-slate-400 hover:text-slate-700 text-2xl font-bold p-1">&times;</button>
      
      <h3 class="font-serif text-xl font-bold text-[#1a382b]">Direct Hotel Enquiry</h3>
      <p class="text-xs text-slate-500">Send an official inquiry directly to Ocean View Grand Resort management.</p>

      <form id="bookingForm" class="space-y-3 pt-1">
        <div>
          <label class="block text-xs font-bold text-slate-700 uppercase mb-1">Your Full Name</label>
          <input type="text" required placeholder="Enter your name" class="w-full border border-slate-200 p-2.5 rounded-lg text-xs focus:outline-none focus:border-[#1a382b] bg-slate-50" />
        </div>
        <div>
          <label class="block text-xs font-bold text-slate-700 uppercase mb-1">Phone / WhatsApp Number</label>
          <input type="tel" required placeholder="+880 1700-000000" class="w-full border border-slate-200 p-2.5 rounded-lg text-xs focus:outline-none focus:border-[#1a382b] bg-slate-50" />
        </div>
        <div>
          <label class="block text-xs font-bold text-slate-700 uppercase mb-1">Inquiry Message</label>
          <textarea rows="3" placeholder="Expected dates, number of guests..." class="w-full border border-slate-200 p-2.5 rounded-lg text-xs focus:outline-none focus:border-[#1a382b] bg-slate-50"></textarea>
        </div>

        <button type="submit" class="w-full bg-[#1a382b] hover:bg-[#11251c] text-white font-bold py-3.5 rounded-xl text-xs uppercase tracking-wider transition mt-2">
          Send Direct Inquiry ➔
        </button>
      </form>
    </div>
  </div>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const galleryImgs = document.querySelectorAll('.gallery-img');
      const viewAllBtn = document.getElementById('viewAllPhotosBtn');
      const imageModal = document.getElementById('imageModal');
      const modalImg = document.getElementById('modalImage');
      const closeModalBtn = document.getElementById('closeModalBtn');
      const prevBtn = document.getElementById('prevImgBtn');
      const nextBtn = document.getElementById('nextImgBtn');
      const imgCounter = document.getElementById('imgCounter');

      const imgList = Array.from(galleryImgs).map(img => img.src);
      let currentIndex = 0;

      function openModal(index) {
        currentIndex = index;
        if(modalImg) modalImg.src = imgList[currentIndex];
        if(imgCounter) imgCounter.innerText = `${currentIndex + 1} / ${imgList.length}`;
        imageModal?.classList.remove('hidden');
        imageModal?.classList.add('flex');
      }

      function closeModalFunc() {
        imageModal?.classList.add('hidden');
        imageModal?.classList.remove('flex');
      }

      galleryImgs.forEach((img, idx) => {
        img.addEventListener('click', () => openModal(idx));
      });

      if(viewAllBtn) viewAllBtn.addEventListener('click', () => openModal(0));
      if(closeModalBtn) closeModalBtn.addEventListener('click', closeModalFunc);

      if(prevBtn) {
        prevBtn.addEventListener('click', () => {
          currentIndex = (currentIndex - 1 + imgList.length) % imgList.length;
          modalImg.src = imgList[currentIndex];
          imgCounter.innerText = `${currentIndex + 1} / ${imgList.length}`;
        });
      }

      if(nextBtn) {
        nextBtn.addEventListener('click', () => {
          currentIndex = (currentIndex + 1) % imgList.length;
          modalImg.src = imgList[currentIndex];
          imgCounter.innerText = `${currentIndex + 1} / ${imgList.length}`;
        });
      }

      const shareBtn = document.getElementById('shareBtn');
      if(shareBtn) {
        shareBtn.addEventListener('click', () => {
          navigator.clipboard.writeText(window.location.href);
          alert('Hotel directory link copied to clipboard! 📋');
        });
      }

      const reserveTriggers = document.querySelectorAll('.reserveBtnTrigger');
      const bookingModal = document.getElementById('bookingModal');
      const closeBookingBtn = document.getElementById('closeBookingBtn');
      const bookingForm = document.getElementById('bookingForm');

      function openBookingModalFunc() {
        bookingModal?.classList.remove('hidden');
        bookingModal?.classList.add('flex');
      }

      function closeBookingModalFunc() {
        bookingModal?.classList.add('hidden');
        bookingModal?.classList.remove('flex');
      }

      reserveTriggers.forEach(btn => btn.addEventListener('click', openBookingModalFunc));
      if(closeBookingBtn) closeBookingBtn.addEventListener('click', closeBookingModalFunc);

      if(bookingForm) {
        bookingForm.addEventListener('submit', (e) => {
          e.preventDefault();
          alert('Your enquiry has been sent to the hotel! Thank you.');
          closeBookingModalFunc();
        });
      }
    });
  </script>

</Layout>
