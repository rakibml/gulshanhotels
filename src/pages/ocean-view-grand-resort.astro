---
// src/pages/ocean-view-grand-resort.astro
import Layout from '../layouts/Layout.astro';
---

<Layout title="Ocean View Grand Resort - GulshanHotels.com">
  <main class="py-8 sm:py-12 px-4 sm:px-6 lg:px-12 max-w-[1600px] mx-auto space-y-8">
    
    <!-- 1. Breadcrumb & Title Header -->
    <div class="border-b border-slate-200 pb-6">
      <nav class="flex items-center gap-2 text-xs font-bold text-slate-500 uppercase tracking-wider mb-3">
        <a href="/" class="hover:text-emerald-600 transition">HOME</a>
        <span>/</span>
        <a href="/hotels" class="hover:text-emerald-600 transition">HOTELS</a>
        <span>/</span>
        <span class="text-slate-900">OCEAN VIEW GRAND RESORT</span>
      </nav>

      <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
          <h1 class="text-3xl sm:text-5xl font-black text-slate-900 tracking-tight">
            Ocean View Grand Resort
          </h1>
          <p class="text-xs sm:text-sm text-slate-600 mt-2 font-semibold flex flex-wrap items-center gap-2">
            <span class="text-amber-600 font-bold">★ 4.9 (48 Reviews)</span>
            <span>•</span>
            <span>📍 Marine Drive, Cox's Bazar, Bangladesh</span>
          </p>
        </div>

        <!-- Share & Wishlist -->
        <div class="flex items-center gap-3">
          <button class="px-4 py-2.5 text-xs font-extrabold uppercase tracking-wider text-slate-700 bg-white border border-slate-200 rounded-lg hover:bg-slate-50 transition shadow-sm">
            🔗 Share
          </button>
          <button class="px-4 py-2.5 text-xs font-extrabold uppercase tracking-wider text-rose-600 bg-white border border-slate-200 rounded-lg hover:bg-slate-50 transition shadow-sm">
            ♥ Wishlist
          </button>
        </div>
      </div>
    </div>

    <!-- 2. Image Gallery Grid -->
    <div class="grid grid-cols-1 md:grid-cols-4 gap-3 rounded-2xl overflow-hidden max-h-[480px] shadow-sm">
      <div class="md:col-span-2 md:row-span-2 h-[260px] md:h-[480px]">
        <img src="https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&w=1200&q=80" alt="Resort Front View" class="w-full h-full object-cover hover:scale-105 transition-transform duration-500 cursor-pointer" />
      </div>
      <div class="h-[130px] md:h-[234px]">
        <img src="https://images.unsplash.com/photo-1582719508461-905c673771fd?auto=format&fit=crop&w=600&q=80" alt="Pool" class="w-full h-full object-cover hover:scale-105 transition-transform duration-500 cursor-pointer" />
      </div>
      <div class="h-[130px] md:h-[234px]">
        <img src="https://images.unsplash.com/photo-1542314831-068cd1dbfeeb?auto=format&fit=crop&w=600&q=80" alt="Bedroom" class="w-full h-full object-cover hover:scale-105 transition-transform duration-500 cursor-pointer" />
      </div>
      <div class="h-[130px] md:h-[234px]">
        <img src="https://images.unsplash.com/photo-1571896349842-33c89424de2d?auto=format&fit=crop&w=600&q=80" alt="Balcony View" class="w-full h-full object-cover hover:scale-105 transition-transform duration-500 cursor-pointer" />
      </div>
      <div class="h-[130px] md:h-[234px] relative">
        <img src="https://images.unsplash.com/photo-1520250497591-112f2f40a3f4?auto=format&fit=crop&w=600&q=80" alt="Dining" class="w-full h-full object-cover hover:scale-105 transition-transform duration-500 cursor-pointer" />
        <button class="absolute bottom-3 right-3 bg-slate-900/90 text-white text-xs font-black px-3.5 py-2 rounded-lg backdrop-blur-sm hover:bg-slate-900 transition">
          View All Photos 📷
        </button>
      </div>
    </div>

    <!-- 3. Main Content Split Layout -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-10 pt-4">
      
      <!-- Left Column (70%) -->
      <div class="lg:col-span-2 space-y-8">
        
        <!-- Hosted Info -->
        <div class="flex items-center justify-between pb-6 border-b border-slate-200">
          <div>
            <h2 class="text-xl font-bold text-slate-900">Luxury Sea View Suite • Hosted by Royal Stay Ltd</h2>
            <p class="text-xs text-slate-500 mt-1 font-medium">2 Guests • 1 Bedroom • 1 King Bed • 1 Private Bath</p>
          </div>
          <div class="w-12 h-12 rounded-full bg-emerald-700 text-white flex items-center justify-center font-black text-sm shrink-0 shadow-sm">
            RS
          </div>
        </div>

        <!-- Overview -->
        <div class="space-y-3 pb-8 border-b border-slate-200">
          <h3 class="text-xs font-black uppercase tracking-wider text-emerald-700">Overview</h3>
          <h4 class="text-2xl font-bold text-slate-900">About this resort</h4>
          <p class="text-sm text-slate-600 leading-relaxed">
            Experience world-class luxury at Ocean View Grand Resort, situated right along the scenic Marine Drive in Cox's Bazar. Enjoy ocean view rooms, an infinity pool overlooking the sea, and premium hospitality with delicious traditional and international cuisine.
          </p>
        </div>

        <!-- Amenities -->
        <div class="space-y-4 pb-8 border-b border-slate-200">
          <h3 class="text-xs font-black uppercase tracking-wider text-emerald-700">Facilities</h3>
          <h4 class="text-2xl font-bold text-slate-900">What this place offers</h4>
          <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
            <div class="p-3.5 bg-white rounded-xl border border-slate-200 text-xs font-bold text-slate-800 shadow-sm flex items-center gap-2">
              <span class="text-base">🏊</span> Infinity Pool
            </div>
            <div class="p-3.5 bg-white rounded-xl border border-slate-200 text-xs font-bold text-slate-800 shadow-sm flex items-center gap-2">
              <span class="text-base">📶</span> High-speed Wi-Fi
            </div>
            <div class="p-3.5 bg-white rounded-xl border border-slate-200 text-xs font-bold text-slate-800 shadow-sm flex items-center gap-2">
              <span class="text-base">❄️</span> Air Conditioning
            </div>
            <div class="p-3.5 bg-white rounded-xl border border-slate-200 text-xs font-bold text-slate-800 shadow-sm flex items-center gap-2">
              <span class="text-base">🍳</span> Free Breakfast
            </div>
            <div class="p-3.5 bg-white rounded-xl border border-slate-200 text-xs font-bold text-slate-800 shadow-sm flex items-center gap-2">
              <span class="text-base">🚗</span> Free Parking
            </div>
            <div class="p-3.5 bg-white rounded-xl border border-slate-200 text-xs font-bold text-slate-800 shadow-sm flex items-center gap-2">
              <span class="text-base">🌊</span> Sea View Balcony
            </div>
          </div>
        </div>

        <!-- Rules -->
        <div class="space-y-4 pb-8 border-b border-slate-200">
          <h3 class="text-xs font-black uppercase tracking-wider text-emerald-700">Information</h3>
          <h4 class="text-2xl font-bold text-slate-900">Things to know</h4>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 text-xs sm:text-sm text-slate-600">
            <div class="space-y-1">
              <h5 class="font-bold text-slate-900 mb-2">House Rules</h5>
              <p>• Check-in: 12:00 PM - 10:00 PM</p>
              <p>• Check-out: 11:00 AM</p>
              <p>• No smoking inside rooms</p>
            </div>
            <div class="space-y-1">
              <h5 class="font-bold text-slate-900 mb-2">Safety & Policy</h5>
              <p>• Free cancellation up to 48 hours before check-in.</p>
              <p>• 24/7 Security & CCTV surveillance.</p>
            </div>
          </div>
        </div>

      </div>

      <!-- Right Column (Sticky Booking Box 30%) -->
      <div>
        <div class="sticky top-24 bg-white p-6 rounded-2xl border border-slate-200 shadow-xl space-y-6">
          
          <div class="flex justify-between items-baseline border-b border-slate-100 pb-4">
            <div>
              <span class="text-3xl font-black text-slate-900">৳৪,৫০—</span>
              <span class="text-xs text-slate-500 font-medium"> / night</span>
            </div>
            <span class="text-xs font-extrabold text-amber-600 bg-amber-50 px-2.5 py-1 rounded-md border border-amber-200">
              ★ 4.9 (48)
            </span>
          </div>

          <!-- Date inputs -->
          <div class="border border-slate-200 rounded-xl overflow-hidden text-xs">
            <div class="grid grid-cols-2 border-b border-slate-200">
              <div class="p-3 border-r border-slate-200 bg-slate-50">
                <label class="block font-black text-slate-500 uppercase text-[10px]">Check-In</label>
                <input type="date" value="2026-08-10" class="w-full bg-transparent font-bold text-slate-800 focus:outline-none cursor-pointer" />
              </div>
              <div class="p-3 bg-slate-50">
                <label class="block font-black text-slate-500 uppercase text-[10px]">Check-Out</label>
                <input type="date" value="2026-08-12" class="w-full bg-transparent font-bold text-slate-800 focus:outline-none cursor-pointer" />
              </div>
            </div>
            <div class="p-3 bg-slate-50">
              <label class="block font-black text-slate-500 uppercase text-[10px]">Guests</label>
              <select class="w-full bg-transparent font-bold text-slate-800 focus:outline-none cursor-pointer">
                <option>2 Adults, 1 Room</option>
                <option>1 Adult, 1 Room</option>
              </select>
            </div>
          </div>

          <!-- CTA Buttons -->
          <div class="space-y-3">
            <button class="w-full bg-emerald-700 hover:bg-emerald-800 text-white font-black text-xs uppercase tracking-wider py-4 rounded-xl transition shadow-md active:scale-95">
              Reserve / Book Now
            </button>

            <a href="https://wa.me/8801700000000" target="_blank" class="w-full border-2 border-emerald-600 text-emerald-700 hover:bg-emerald-50 font-extrabold text-xs py-3 rounded-xl flex items-center justify-center gap-2 transition">
              💬 Chat on WhatsApp
            </a>

            <a href="tel:+8801700000000" class="w-full bg-slate-100 hover:bg-slate-200 text-slate-800 font-extrabold text-xs py-3 rounded-xl flex items-center justify-center gap-2 transition">
              📞 Call Hotel (+880 1700-000000)
            </a>
          </div>

          <p class="text-[11px] text-center text-slate-400 font-medium">Instant confirmation. Best price guaranteed.</p>

        </div>
      </div>

    </div>

    <!-- 4. Guest Reviews -->
    <div class="pt-8 border-t border-slate-200 space-y-6">
      <h3 class="text-2xl font-bold text-slate-900">Guest Reviews (★ 4.9 out of 5)</h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm space-y-3">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-full bg-slate-100 text-slate-700 font-bold flex items-center justify-center text-xs">
              RH
            </div>
            <div>
              <h4 class="font-bold text-xs text-slate-900">Rahat Hasan</h4>
              <p class="text-[11px] text-slate-400">Stayed in July 2026</p>
            </div>
          </div>
          <p class="text-xs text-slate-600 leading-relaxed">
            "An amazing place with direct sea view! The staff were polite, room cleanliness was top notch, and the pool experience was great."
          </p>
        </div>

        <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm space-y-3">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-full bg-slate-100 text-slate-700 font-bold flex items-center justify-center text-xs">
              SA
            </div>
            <div>
              <h4 class="font-bold text-xs text-slate-900">Sultana Ahmed</h4>
              <p class="text-[11px] text-slate-400">Stayed in June 2026</p>
            </div>
          </div>
          <p class="text-xs text-slate-600 leading-relaxed">
            "Great location right on Marine Drive. The breakfast buffet had plenty of options. Highly recommended for family trips!"
          </p>
        </div>
      </div>
    </div>

  </main>
</Layout>
