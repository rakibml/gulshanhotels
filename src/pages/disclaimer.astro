---
// src/pages/disclaimer.astro (100% Vector SVG - Zero Emojis - Enterprise Legal & Rate Disclaimer)
import Layout from '../layouts/Layout.astro';

const LAST_UPDATED = "November 2026";
const CONTACT_EMAIL = "legal@gulshanhotels.com";
const siteOrigin = "https://gulshanhotels.com";
const canonicalUrl = `${siteOrigin}/disclaimer`;

// GOOGLE WEBPAGE SCHEMA
const pageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": `${canonicalUrl}#webpage`,
  "url": canonicalUrl,
  "name": "Disclaimer & Rate Disclosure | GulshanHotels.com",
  "description": "Official rate accuracy disclaimer, trademark non-affiliation statement, and affiliate disclosure for GulshanHotels.com.",
  "inLanguage": "en-US",
  "isPartOf": {
    "@type": "WebSite",
    "@id": `${siteOrigin}/#website`,
    "name": "GulshanHotels.com",
    "url": `${siteOrigin}/`
  },
  "breadcrumb": {
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": `${siteOrigin}/` },
      { "@type": "ListItem", "position": 2, "name": "Disclaimer" }
    ]
  }
};
---

<Layout
  title="Disclaimer & Price Disclosure | GulshanHotels.com"
  description="Read our legal disclaimer covering hotel rate accuracy, trademark non-affiliation, affiliate disclosures, and third-party booking channels."
>
  <script type="application/ld+json" set:html={JSON.stringify(pageSchema)} />

  <main class="w-full bg-white text-slate-900 pt-6 pb-24">
    <div class="max-w-[880px] mx-auto px-4 sm:px-6 space-y-10 text-left">
      
      <!-- BREADCRUMBS -->
      <nav aria-label="Breadcrumb" class="flex items-center gap-2 text-xs font-semibold text-slate-400">
        <a href="/" class="hover:text-emerald-800 transition">Home</a>
        <span>/</span>
        <span class="text-slate-900 font-bold" aria-current="page">Disclaimer</span>
      </nav>

      <!-- PAGE HEADER -->
      <header class="space-y-4 border-b border-slate-200 pb-8">
        <div class="flex flex-wrap items-center gap-3">
          <!-- Legal Notice SVG Badge -->
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-amber-50 text-amber-900 border border-amber-200 text-[11px] font-black uppercase tracking-wider">
            <svg class="w-3.5 h-3.5 fill-amber-700 shrink-0" viewBox="0 0 24 24">
              <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"/>
            </svg>
            <span>Legal Notice & Transparency</span>
          </span>

          <span class="text-xs text-slate-400 font-medium">
            Effective Date: <strong class="text-slate-700">{LAST_UPDATED}</strong>
          </span>
        </div>

        <h1 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-black text-slate-900 tracking-tight leading-tight">
          Disclaimer & Disclosure Statement
        </h1>

        <p class="text-base sm:text-lg text-slate-600 font-normal leading-relaxed">
          This document clarifies our independent operational model, dynamic room price fluctuations, trademark protections, and affiliate referral partnerships across GulshanHotels.com.
        </p>

        <!-- INDEPENDENT PORTAL CALLOUT (TRADEMARK SAFEGUARD) -->
        <div class="p-4 sm:p-5 rounded-2xl bg-[#fbfbfa] border border-slate-200 flex items-start gap-3.5">
          <div class="w-8 h-8 rounded-xl bg-slate-100 border border-slate-200 flex items-center justify-center text-slate-700 shrink-0 shadow-2xs">
            <svg class="w-4 h-4 fill-none stroke-current stroke-2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <div class="text-xs sm:text-sm text-slate-700 leading-relaxed">
            <strong class="font-bold text-slate-900 block mb-0.5">Independent Information Directory</strong>
            GulshanHotels.com is an independent digital hospitality guide and aggregator. We are not directly owned, managed by, or formally partnered as an employer to individual hotel brands unless explicitly identified.
          </div>
        </div>
      </header>

      <!-- QUICK NAVIGATION JUMP PILLS -->
      <div class="flex items-center gap-2 overflow-x-auto pb-1 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
        <a href="#non-affiliation" class="shrink-0 px-3 py-1.5 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-bold transition">1. Brand Non-Affiliation</a>
        <a href="#rates-pricing" class="shrink-0 px-3 py-1.5 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-bold transition">2. Room Rate Accuracy</a>
        <a href="#affiliate-links" class="shrink-0 px-3 py-1.5 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-bold transition">3. Affiliate Disclosure</a>
        <a href="#content-accuracy" class="shrink-0 px-3 py-1.5 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-bold transition">4. Amenities & Inspection</a>
        <a href="#liability" class="shrink-0 px-3 py-1.5 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-bold transition">5. Limitation of Liability</a>
      </div>

      <!-- MAIN LEGAL SECTIONS -->
      <div 
        id="disclaimerBody" 
        class="prose prose-slate max-w-none text-[16px] sm:text-[17px] leading-[1.85] font-normal text-slate-700
               prose-headings:font-serif prose-headings:font-black prose-headings:text-slate-900 prose-headings:tracking-tight 
               prose-h2:text-2xl sm:prose-h2:text-3xl prose-h2:mt-10 prose-h2:mb-4 prose-h2:pt-6 prose-h2:border-t prose-h2:border-slate-100
               prose-h3:text-lg sm:prose-h3:text-xl prose-h3:mt-6 prose-h3:mb-3 
               prose-ul:my-4 prose-ul:list-disc prose-ul:pl-6 prose-li:my-1.5
               [&_a]:text-emerald-800 [&_a]:font-bold [&_a]:underline [&_a]:decoration-emerald-500/80 [&_a]:underline-offset-4 hover:[&_a]:text-emerald-950 transition-colors"
      >

        <section id="non-affiliation">
          <h2>1. Trademark Non-Affiliation Statement</h2>
          <p>
            All registered trademarks, brand names, commercial logos, and corporate identities displayed on GulshanHotels.com—including, but not limited to, <em>The Westin</em>, <em>Renaissance</em>, <em>Marriott</em>, <em>Amari</em>, <em>Radisson</em>, <em>Lakeshore</em>, and <em>Six Seasons</em>—remain the exclusive property of their respective trademark proprietors.
          </p>
          <p>
            The citation or depiction of these hotel names and public imagery on this portal serves an informative, comparative, and editorial directory function. Their presence does not signify formal endorsement, corporate sponsorship, or contractual affiliation by the respective hotel owners.
          </p>
        </section>

        <section id="rates-pricing">
          <h2>2. Room Rate Accuracy & Dynamic Pricing Notice</h2>
          <p>
            Hotel accommodations in the Gulshan diplomatic corridor operate under dynamic yield-management pricing. Room rates fluctuate continuously based on real-time factors including:
          </p>
          <ul>
            <li>Seasonal travel demand and peak diplomatic calendar dates.</li>
            <li>Real-time room occupancy, suite availability, and booking lead time.</li>
            <li>Applicable government value-added taxes (VAT), local service charges, and currency exchange rates (USD/BDT).</li>
          </ul>
          <p>
            While our editorial team conducts periodic audits of published starting prices, rates displayed on our portal are indicative estimates. <strong>You must verify and confirm the exact checkout total on the official hotel booking engine or partner reservation page prior to providing payment details.</strong>
          </p>
        </section>

        <section id="affiliate-links">
          <h2>3. Affiliate Marketing Disclosure (FTC & Google Compliance)</h2>
          <p>
            In accordance with international consumer transparency standards and the Federal Trade Commission (FTC) guidelines, we provide full disclosure regarding commercial compensation:
          </p>
          <p>
            Some reservation buttons (such as "View Prices", "Book Now", or specific third-party provider links) redirect to authorized distribution partners including Agoda, Booking.com, and Expedia. If you complete a confirmed reservation through these referral links, GulshanHotels.com may receive an affiliate referral commission.
          </p>
          <div class="bg-emerald-50/70 p-4 rounded-xl border border-emerald-200 text-xs sm:text-sm text-emerald-950 font-medium leading-relaxed">
            This commission is paid entirely by the booking platform out of their standard marketing budget. It does not alter, increase, or inflate the room rate you pay.
          </div>
        </section>

        <section id="content-accuracy">
          <h2>4. Amenities, Policies & Editorial Good Faith</h2>
          <p>
            Our team endeavors to compile accurate hotel descriptions, power backup specifications, couple policies, and proximity estimates (e.g., transit minutes to the US Embassy or Dhaka Elevated Expressway).
          </p>
          <p>
            However, hotels may modify their internal policies, breakfast hours, pool maintenance schedules, or check-in restrictions without prior public notice. GulshanHotels.com cannot guarantee that all hotel amenity specifications remain error-free or perpetually updated in real-time.
          </p>
        </section>

        <section id="liability">
          <h2>5. Limitation of Liability</h2>
          <p>
            GulshanHotels.com does not act as an accredited travel agency, tour operator, or hotel payment processor. Under no circumstances shall our site administration or contributors be held liable for:
          </p>
          <ul>
            <li>Reservation cancellations, room downgrades, or overbooking issues executed by third-party hotels.</li>
            <li>Discrepancies between advertised amenities and on-site hotel delivery.</li>
            <li>Personal losses, flight delays, or scheduling conflicts arising from reliance on traffic or distance estimates.</li>
          </ul>
        </section>

      </div>

      <!-- CORRECTION / DISPUTE RESOLUTION DESK -->
      <div class="mt-12 bg-slate-50 border border-slate-200 rounded-3xl p-6 sm:p-8 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6">
        <div class="space-y-1">
          <h3 class="font-serif font-bold text-slate-900 text-lg">Hotel Owner or Brand Representative?</h3>
          <p class="text-xs sm:text-sm text-slate-500 font-normal">
            If you represent a listed Gulshan property and wish to report an inaccurate rate, update amenities, or request an audit, please contact our legal desk.
          </p>
        </div>
        <a 
          href={`mailto:${CONTACT_EMAIL}`}
          class="bg-[#0d3b23] hover:bg-[#061e14] text-white font-extrabold text-xs px-5 py-3 rounded-xl uppercase tracking-wider transition shrink-0 shadow-xs flex items-center gap-2"
        >
          <span>Submit Audit Request</span>
          <svg class="w-3.5 h-3.5 fill-none stroke-current stroke-2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
          </svg>
        </a>
      </div>

    </div>
  </main>
</Layout>

<!-- CLIENT SCRIPT (AUTO NEW-TAB FOR EXTERNAL LINKS) -->
<script is:inline>
  const initDisclaimerLinks = () => {
    const links = document.querySelectorAll('#disclaimerBody a');
    links.forEach(link => {
      const href = link.getAttribute('href');
      if (href && !href.startsWith('#')) {
        link.setAttribute('target', '_blank');
        link.setAttribute('rel', 'noopener noreferrer');
      }
    });
  };
  document.addEventListener('DOMContentLoaded', initDisclaimerLinks);
  document.addEventListener('astro:page-load', initDisclaimerLinks);
</script>
