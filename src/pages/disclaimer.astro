---
// src/pages/disclaimer.astro
import Layout from '../layouts/Layout.astro';

const SITE_URL = 'https://gulshanhotels.com';
const CONTACT_EMAIL = 'info@gulshanhotels.com'; // আপনার legal@ ইমেইলটি আসলেই চালু থাকলে কেবল সেটি ব্যবহার করুন
const PARTNER_NAME = 'Agoda'; // নতুন পার্টনার যোগ করলে এখানে আপডেট করুন
const LAST_REVIEWED = '2026-11-20';
const LAST_UPDATED_TEXT = 'November 2026';

const canonicalUrl = `${SITE_URL}/disclaimer/`;
const pageDescription =
  'Read the disclaimer, rate accuracy notice, trademark statement, and affiliate disclosure for GulshanHotels.com.';

const pageSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${SITE_URL}/#website`,
      url: `${SITE_URL}/`,
      name: 'GulshanHotels.com',
      inLanguage: 'en',
      publisher: { '@id': `${SITE_URL}/#organization` },
    },
    {
      '@type': 'Organization',
      '@id': `${SITE_URL}/#organization`,
      name: 'GulshanHotels.com',
      url: `${SITE_URL}/`,
      email: CONTACT_EMAIL,
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${SITE_URL}/disclaimer/#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE_URL}/` },
        { '@type': 'ListItem', position: 2, name: 'Disclaimer', item: canonicalUrl },
      ],
    },
    {
      '@type': 'WebPage',
      '@id': `${SITE_URL}/disclaimer/#webpage`,
      url: canonicalUrl,
      name: 'Disclaimer & Affiliate Disclosure | GulshanHotels.com',
      description: pageDescription,
      inLanguage: 'en',
      isPartOf: { '@id': `${SITE_URL}/#website` },
      about: { '@id': `${SITE_URL}/#organization` },
      publisher: { '@id': `${SITE_URL}/#organization` },
      breadcrumb: { '@id': `${SITE_URL}/disclaimer/#breadcrumb` },
      lastReviewed: LAST_REVIEWED,
      dateModified: LAST_REVIEWED,
    },
  ],
};
---

<Layout
  title="Disclaimer & Affiliate Disclosure | GulshanHotels.com"
  description={pageDescription}
>
  <script type="application/ld+json" set:html={JSON.stringify(pageSchema)} />

  <main>
    <!-- Header (about.astro-এর সাথে সামঞ্জস্যপূর্ণ) -->
    <section class="bg-gradient-to-b from-emerald-50/70 to-white">
      <div class="mx-auto max-w-4xl px-4 py-14 text-center sm:px-8 sm:py-20">
        <nav aria-label="Breadcrumb" class="mb-5 flex justify-center text-xs font-medium text-slate-600">
          <ol class="flex items-center gap-2">
            <li><a href="/" class="hover:text-emerald-800 hover:underline">Home</a></li>
            <li aria-hidden="true">/</li>
            <li class="font-semibold text-slate-800" aria-current="page">Disclaimer</li>
          </ol>
        </nav>

        <h1 class="text-3xl font-extrabold tracking-tight text-slate-900 sm:text-5xl">
          Disclaimer &amp; Disclosures
        </h1>
        <p class="mx-auto mt-5 max-w-2xl text-base leading-relaxed text-slate-600 sm:text-lg">
          Important information about how GulshanHotels.com works, how hotel prices are displayed, trademark ownership, and our affiliate links.
        </p>
        <p class="mt-3 text-xs font-medium text-slate-600">
          Last updated: <strong class="text-slate-800">{LAST_UPDATED_TEXT}</strong>
        </p>
      </div>
    </section>

    <!-- Main Content -->
    <section class="mx-auto max-w-3xl px-4 py-12 sm:px-8 sm:py-16">
      <!-- Independent Directory Box -->
      <div class="mb-8 flex items-start gap-3.5 rounded-2xl border border-slate-200 bg-slate-50 p-5">
        <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-xl border border-slate-200 bg-white text-slate-700">
          <svg class="h-4 w-4 fill-none stroke-current stroke-2" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
        <div class="text-sm leading-relaxed text-slate-700">
          <p class="font-bold text-slate-900">Independent Hotel Guide</p>
          <p class="mt-0.5">
            GulshanHotels.com is an independent directory and neighborhood guide for Gulshan 1 and Gulshan 2 in Dhaka. We are not owned by, operated by, or officially affiliated with any hotel listed on this website.
          </p>
        </div>
      </div>

      <!-- Jump Navigation -->
      <nav aria-label="Disclaimer sections" class="mb-10 flex flex-wrap gap-2">
        <a href="#non-affiliation" class="rounded-full border border-slate-200 bg-white px-3.5 py-1.5 text-xs font-semibold text-slate-700 transition hover:border-emerald-300 hover:bg-emerald-50 hover:text-emerald-800">
          1. Trademarks
        </a>
        <a href="#rates-pricing" class="rounded-full border border-slate-200 bg-white px-3.5 py-1.5 text-xs font-semibold text-slate-700 transition hover:border-emerald-300 hover:bg-emerald-50 hover:text-emerald-800">
          2. Rate Accuracy
        </a>
        <a href="#affiliate-links" class="rounded-full border border-slate-200 bg-white px-3.5 py-1.5 text-xs font-semibold text-slate-700 transition hover:border-emerald-300 hover:bg-emerald-50 hover:text-emerald-800">
          3. Affiliate Disclosure
        </a>
        <a href="#content-accuracy" class="rounded-full border border-slate-200 bg-white px-3.5 py-1.5 text-xs font-semibold text-slate-700 transition hover:border-emerald-300 hover:bg-emerald-50 hover:text-emerald-800">
          4. Hotel Information
        </a>
        <a href="#liability" class="rounded-full border border-slate-200 bg-white px-3.5 py-1.5 text-xs font-semibold text-slate-700 transition hover:border-emerald-300 hover:bg-emerald-50 hover:text-emerald-800">
          5. Liability
        </a>
      </nav>

      <!-- Sections -->
      <div class="space-y-10 text-base leading-relaxed text-slate-600">
        <section id="non-affiliation" class="space-y-3 border-t border-slate-200 pt-8">
          <h2 class="text-2xl font-extrabold tracking-tight text-slate-900">
            1. Trademark &amp; Brand Non-Affiliation
          </h2>
          <p>
            All hotel names, brand names, logos, and trademarks mentioned on GulshanHotels.com—such as <em>The Westin</em>, <em>Renaissance</em>, <em>Amari</em>, <em>Lakeshore</em>, and <em>Six Seasons</em>—belong strictly to their respective owners.
          </p>
          <p>
            We reference these property names solely for informational and directory purposes so travelers can compare options in Gulshan. Listing a property does not imply sponsorship, endorsement, or any official partnership with the hotel’s management.
          </p>
        </section>

        <section id="rates-pricing" class="space-y-3 border-t border-slate-200 pt-8">
          <h2 class="text-2xl font-extrabold tracking-tight text-slate-900">
            2. Room Rate Accuracy &amp; Price Changes
          </h2>
          <p>
            Hotel prices in Gulshan change frequently depending on travel dates, demand, room availability, taxes, VAT, and exchange rates (USD/BDT).
          </p>
          <ul class="list-disc space-y-1.5 pl-5">
            <li>Where live rates are available from our booking partner ({PARTNER_NAME}), we display them as provided at that time.</li>
            <li>Other prices shown on the site are approximate starting guide rates compiled from public hotel and booking sources.</li>
          </ul>
          <p>
            <strong class="text-slate-900">Always verify the final room rate, taxes, cancellation rules, and check-in terms</strong> directly on the booking partner’s checkout page or the hotel’s official website before paying.
          </p>
        </section>

        <section id="affiliate-links" class="space-y-3 border-t border-slate-200 pt-8">
          <h2 class="text-2xl font-extrabold tracking-tight text-slate-900">
            3. Affiliate Disclosure
          </h2>
          <p>
            To keep GulshanHotels.com free for visitors, some outbound booking links on this website (such as links to {PARTNER_NAME}) are affiliate links.
          </p>
          <div class="rounded-2xl border border-emerald-200 bg-emerald-50/70 p-4 text-sm font-medium text-emerald-950">
            If you click an affiliate link and complete a booking, we may earn a small referral commission from the booking partner—at no extra cost to you. Affiliate commissions do not raise the room price you pay.
          </div>
          <p class="text-sm text-slate-600">
            For more on how we gather information and maintain listings, see our{' '}
            <a href="/about/#how-we-work" class="font-semibold text-emerald-800 underline-offset-2 hover:underline">
              How we work
            </a>{' '}
            section on the About page.
          </p>
        </section>

        <section id="content-accuracy" class="space-y-3 border-t border-slate-200 pt-8">
          <h2 class="text-2xl font-extrabold tracking-tight text-slate-900">
            4. Hotel Amenities, Distances &amp; Policies
          </h2>
          <p>
            Information about hotel facilities, check-in requirements, and approximate distances or travel times in Dhaka (for example, to embassies or Hazrat Shahjalal International Airport) is gathered from hotels’ official pages and public sources in good faith.
          </p>
          <p>
            Hotels may change their amenities, facilities, or guest policies without notice, and Dhaka traffic conditions vary widely. We cannot guarantee that every detail remains continuously up to date in real time.
          </p>
        </section>

        <section id="liability" class="space-y-3 border-t border-slate-200 pt-8">
          <h2 class="text-2xl font-extrabold tracking-tight text-slate-900">
            5. Limitation of Liability
          </h2>
          <p>
            GulshanHotels.com does not process bookings, accept payments, or act as a travel agency or tour operator. When you follow a link to book a hotel, your reservation contract is strictly between you and that booking platform or hotel.
          </p>
          <p>
            We are not responsible for reservation cancellations, overbooking, service quality, price disputes, or any losses resulting from reliance on information or distance estimates published on this website. Please also review our{' '}
            <a href="/privacy/" class="font-semibold text-emerald-800 underline-offset-2 hover:underline">
              Privacy Policy
            </a>.
          </p>
        </section>
      </div>

      <!-- Bottom CTA -->
      <div class="mt-12 flex flex-col items-start justify-between gap-6 rounded-3xl border border-slate-200 bg-slate-50 p-6 sm:flex-row sm:items-center sm:p-8">
        <div class="space-y-1">
          <h2 class="text-lg font-bold text-slate-900">Hotel Owner or Spotted an Error?</h2>
          <p class="text-sm text-slate-600">
            If you represent a property or found outdated details, let us know and we will verify and update the listing.
          </p>
        </div>
        <div class="flex shrink-0 flex-wrap gap-2.5">
          <a
            href="/contact/"
            class="inline-flex items-center gap-2 rounded-full bg-[#0d3b23] px-5 py-2.5 text-xs font-bold uppercase tracking-wider text-white transition hover:bg-[#061e14]"
          >
            <span>Report an Update</span>
            <svg class="h-3.5 w-3.5 fill-none stroke-current stroke-2" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M13 6l6 6-6 6" />
            </svg>
          </a>
          <a
            href={`mailto:${CONTACT_EMAIL}`}
            class="inline-flex items-center rounded-full border border-slate-300 bg-white px-5 py-2.5 text-xs font-bold text-slate-800 transition hover:border-emerald-300 hover:bg-emerald-50"
          >
            {CONTACT_EMAIL}
          </a>
        </div>
      </div>
    </section>
  </main>
</Layout>
