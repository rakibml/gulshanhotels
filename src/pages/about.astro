---
// src/pages/about.astro
import Layout from '../layouts/Layout.astro';

// Fill these in. Anything left empty is simply not shown.
const CONTACT_EMAIL = '';      // e.g. 'name@yourdomain.com'
const WHATSAPP_NUMBER = '';    // digits only with country code, e.g. '8801XXXXXXXXX'

const features = [
  {
    title: 'Discover',
    text: 'Browse luxury, boutique and business hotels across Gulshan 1, Gulshan 2, Banani and Baridhara.',
    icon: 'M21 21l-4.35-4.35M11 19a8 8 0 100-16 8 8 0 000 16z',
  },
  {
    title: 'Compare',
    text: 'Look at hotels side by side, check live prices where available, and spot current deals.',
    icon: 'M3 6h18M3 12h12M3 18h6',
  },
  {
    title: 'Save',
    text: 'Tap the heart on any hotel to save it, then come back to your shortlist whenever you are ready.',
    icon: 'M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z',
  },
];

const areas = [
  'Gulshan 1', 'Gulshan 2', 'Banani', 'Baridhara',
  'Near US Embassy', 'Near IVAC Visa Center',
];

const principles = [
  {
    title: 'Clear information',
    text: 'We aim to show each hotel\u2019s location, category and pricing in a simple, easy-to-scan way.',
  },
  {
    title: 'Check before you pay',
    text: 'Room rates and availability can change quickly. Always confirm the final price and your dates with the hotel or booking partner before you pay.',
  },
  // CONFIRM THIS ONE: keep it only if it is true for your site, otherwise delete this item.
  {
    title: 'How we are supported',
    text: 'Some links on this site may be partner or booking links. If you book through them we may earn a commission, at no extra cost to you.',
  },
];
---

<Layout
  title="About Us | GulshanHotels.com"
  description="GulshanHotels.com is a hotel guide for Gulshan, Banani and Baridhara, Dhaka. Discover, compare and shortlist places to stay in one place."
>
  <main>

    <!-- Intro -->
    <section class="bg-gradient-to-b from-emerald-50/70 to-white">
      <div class="mx-auto max-w-4xl px-4 py-16 text-center sm:px-8 sm:py-24">
        <p class="text-xs font-bold uppercase tracking-[0.2em] text-emerald-800">About us</p>
        <h1 class="mt-4 text-4xl font-extrabold tracking-tight text-slate-900 sm:text-5xl">
          Find the right hotel in Gulshan, faster.
        </h1>
        <p class="mx-auto mt-6 max-w-2xl text-base leading-relaxed text-slate-600 sm:text-lg">
          GulshanHotels.com is a hotel guide for Gulshan, Banani and Baridhara in Dhaka.
          We help you discover, compare and shortlist places to stay, all in one place.
        </p>
        <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
          <a href="/#hotels" class="inline-flex items-center gap-2 rounded-full bg-[#0d3b23] px-6 py-3 text-sm font-bold text-white shadow-sm transition hover:-translate-y-px hover:shadow-lg hover:shadow-emerald-900/25">
            Explore Gulshan hotels
            <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M13 6l6 6-6 6"/></svg>
          </a>
        </div>
      </div>
    </section>

    <!-- What you can do -->
    <section class="mx-auto max-w-[1100px] px-4 py-14 sm:px-8 sm:py-20">
      <h2 class="text-center text-2xl font-extrabold tracking-tight text-slate-900 sm:text-3xl">What you can do here</h2>
      <div class="mt-10 grid gap-5 sm:grid-cols-3">
        {features.map((f) => (
          <div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-2xs transition hover:-translate-y-0.5 hover:shadow-md">
            <span class="flex h-11 w-11 items-center justify-center rounded-2xl bg-emerald-50 text-emerald-800">
              <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d={f.icon} /></svg>
            </span>
            <h3 class="mt-4 text-lg font-bold text-slate-900">{f.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-slate-600">{f.text}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Why we built it -->
    <section class="bg-slate-50">
      <div class="mx-auto max-w-3xl px-4 py-14 sm:px-8 sm:py-20">
        <h2 class="text-2xl font-extrabold tracking-tight text-slate-900 sm:text-3xl">Why we built this</h2>
        <div class="mt-5 space-y-4 text-base leading-relaxed text-slate-600">
          <p>
            Gulshan is the heart of Dhaka’s diplomatic and business life. Whether you are visiting an embassy,
            attending meetings, or heading to a visa appointment, staying close by can save hours in Dhaka traffic.
          </p>
          <p>
            Finding the right hotel nearby often means jumping between many tabs and phone calls.
            GulshanHotels.com brings the options together so that choosing where to stay takes minutes instead of an evening.
          </p>
        </div>
      </div>
    </section>

    <!-- Areas -->
    <section class="mx-auto max-w-3xl px-4 py-14 text-center sm:px-8 sm:py-20">
      <h2 class="text-2xl font-extrabold tracking-tight text-slate-900 sm:text-3xl">Areas we cover</h2>
      <div class="mt-8 flex flex-wrap justify-center gap-2.5">
        {areas.map((a) => (
          <a href="/#hotels" class="rounded-full border border-slate-200 bg-white px-4 py-2 text-sm font-semibold text-slate-700 transition hover:border-emerald-300 hover:bg-emerald-50 hover:text-emerald-800">{a}</a>
        ))}
      </div>
    </section>

    <!-- Principles -->
    <section class="bg-slate-50">
      <div class="mx-auto max-w-[1100px] px-4 py-14 sm:px-8 sm:py-20">
        <h2 class="text-center text-2xl font-extrabold tracking-tight text-slate-900 sm:text-3xl">How we work</h2>
        <div class="mt-10 grid gap-5 sm:grid-cols-3">
          {principles.map((p) => (
            <div class="rounded-3xl border border-slate-200 bg-white p-6">
              <h3 class="text-base font-bold text-slate-900">{p.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-slate-600">{p.text}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Contact -->
    <section class="mx-auto max-w-3xl px-4 py-14 sm:px-8 sm:py-20">
      <div class="rounded-3xl bg-[#0d3b23] p-8 text-center text-white sm:p-12">
        <h2 class="text-2xl font-extrabold tracking-tight sm:text-3xl">Get in touch</h2>
        <p class="mx-auto mt-3 max-w-lg text-sm leading-relaxed text-emerald-100/90 sm:text-base">
          Have a question, spotted something that needs correcting, or want to list your hotel? We would love to hear from you.
        </p>
        <div class="mt-7 flex flex-col items-center justify-center gap-3 sm:flex-row">
          <a href="/contact/" class="inline-flex items-center rounded-full bg-white px-6 py-3 text-sm font-bold text-slate-900 transition hover:bg-emerald-50">List your hotel</a>
          {CONTACT_EMAIL && (
            <a href={`mailto:${CONTACT_EMAIL}`} class="inline-flex items-center rounded-full border border-white/30 px-6 py-3 text-sm font-bold text-white transition hover:bg-white/10">{CONTACT_EMAIL}</a>
          )}
          {WHATSAPP_NUMBER && (
            <a href={`https://wa.me/${WHATSAPP_NUMBER}`} rel="noopener" class="inline-flex items-center rounded-full border border-white/30 px-6 py-3 text-sm font-bold text-white transition hover:bg-white/10">WhatsApp</a>
          )}
        </div>
      </div>
    </section>

  </main>
</Layout>
