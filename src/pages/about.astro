---
// src/pages/about.astro
import Layout from '../layouts/Layout.astro';
---

<Layout title="About Us - Gulshan Hotels Guide">
  <main class="max-w-4xl mx-auto py-16 px-4">
    <h1 class="text-4xl font-extrabold text-slate-900">About GulshanHotels.com</h1>
    <p class="text-slate-600 mt-4 leading-relaxed text-lg">
      Welcome to <strong>GulshanHotels.com</strong>, your premier online portal and trusted local directory for luxury, boutique, and business accommodations in Gulshan 1 and Gulshan 2, Dhaka.
    </p>
    <div class="mt-8 p-6 bg-amber-50 rounded-2xl border border-amber-200">
      <h2 class="text-xl font-bold text-amber-800">Our Mission</h2>
      <p class="text-amber-900 mt-2">
        To provide foreign diplomats, business travelers, and tourists with accurate, real-time information, room rates, and honest reviews of the best hotels in Dhaka's most prestigious area.
      </p>
    </div>
  </main>
</Layout>