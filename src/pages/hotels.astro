---
// src/pages/hotels.astro (Sticky Top-0 Fixed + Mobile Responsive Filter Drawer)
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

// 1. Fetch Hotels
let rawHotels: any[] = [];
try {
  const allHotels = await getCollection('hotels');
  if (Array.isArray(allHotels)) rawHotels = allHotels;
} catch (e) {
  rawHotels = [];
}

if (!rawHotels || rawHotels.length === 0) {
  try {
    const rawGlob = import.meta.glob('../content/hotels/*.md', { eager: true });
    rawHotels = Object.entries(rawGlob).map(([filePath, item]: [string, any]) => ({
      slug: filePath.split('/').pop()?.replace('.md', ''),
      data: item.frontmatter || {},
      body: typeof item.rawContent === 'function' ? item.rawContent() : (item.compiledContent ? item.compiledContent() : '')
    }));
  } catch (e) {
    rawHotels = [];
  }
}

// Deduplicate Hotels
const uniqueHotelsMap = new Map();
rawHotels.forEach(h => {
  const key = String(h.data?.title || h.data?.name || h.slug || h.id || '').trim().toLowerCase();
  if (key && !uniqueHotelsMap.has(key)) {
    uniqueHotelsMap.set(key, h);
  }
});
const hotels = Array.from(uniqueHotelsMap.values());
const totalHotelsCount = hotels.length;

// 2. Fetch Reviews
let allCmsReviews: any[] = [];
try {
  const reviewsCol = await getCollection('reviews');
  if (Array.isArray(reviewsCol) && reviewsCol.length > 0) {
    allCmsReviews = reviewsCol.map(r => r.data || {});
  }
} catch (e) {}

if (allCmsReviews.length === 0) {
  try {
    const globModules = import.meta.glob('../content/reviews/*.md', { eager: true });
    Object.values(globModules).forEach((mod: any) => {
      if (mod && mod.frontmatter) {
        allCmsReviews.push(mod.frontmatter);
      }
    });
  } catch (err) {
    allCmsReviews = [];
  }
}

// 3. Dynamic Counters
let count5Star = 0;
let count4Star = 0;
let count3Star = 0;

let countGulshan1 = 0;
let countGulshan2 = 0;
let countNearGulshan = 0;
let countGuestHouse = 0;

hotels.forEach(h => {
  const cat = String(h.data?.starCategory || h.data?.category || '').toLowerCase();
  if (cat.includes('5')) count5Star++;
  else if (cat.includes('4')) count4Star++;
  else if (cat.includes('3')) count3Star++;

  const loc = String(h.data?.address || h.data?.location || h.data?.category || '').toLowerCase();
  const titleStr = String(h.data?.title || h.data?.name || '').toLowerCase();

  if (loc.includes('guest house') || loc.includes('guesthouse') || titleStr.includes('guest house') || titleStr.includes('guesthouse') || cat.includes('guest house')) {
    countGuestHouse++;
  }

  if (loc.includes('gulshan 1') || loc.includes('gulshan-1') || loc.includes('gulshan1')) {
    countGulshan1++;
  } else if (loc.includes('gulshan 2') || loc.includes('gulshan-2') || loc.includes('gulshan2')) {
    countGulshan2++;
  } else {
    countNearGulshan++;
  }
});

// Helpers
const toTitleCase = (str: string) => {
  return str.toLowerCase().split(' ').map(w => w.charAt(0).toUpperCase() + w.slice(1)).join(' ');
};

const getFirst25Words = (text: string): string => {
  if (!text) return "Experience world-class luxury suites, exceptional hospitality, fine dining, and prime comfort in the heart of Gulshan, Dhaka.";
  const clean = text.replace(/<[^>]*>?/gm, '').replace(/[#*`_~]/g, '').replace(/---[\s\S]*?---/g, '').trim();
  const words = clean.split(/\s+/).filter(Boolean);
  if (words.length <= 25) return words.join(' ');
  return words.slice(0, 25).join(' ') + '...';
};

const cleanPriceString = (priceRaw: string) => {
  if (!priceRaw) return 'Contact for Rates';
  const clean = String(priceRaw).replace(/night/gi, '').replace(/\//g, '').trim();
  const digits = clean.replace(/[^0-9.,]/g, '').trim();
  
  if (clean.includes('$')) return `$${digits}`;
  return `৳ ${digits}`;
};

// Common Icons
const svgMap: Record<string, string> = {
  locationPin: `<svg class="w-3.5 h-3.5 fill-slate-700 shrink-0 mt-0.5" viewBox="0 0 24 24"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>`,
  search: `<svg class="w-4 h-4 fill-slate-400 shrink-0" viewBox="0 0 24 24"><path d="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/></svg>`,
  filterIcon: `<svg class="w-4 h-4 fill-slate-700" viewBox="0 0 24 24"><path d="M10 18h4v-2h-4v2zM3 6v2h18V6H3zm3 7h12v-2H6v2z"/></svg>`,
  closeIcon: `<svg class="w-5 h-5 text-slate-700" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>`
};

const siteUrl = "https://gulshanhotels.com/";
---

<Layout 
  title="All Hotels in Gulshan Directory — Filter & Compare All Stays"
  description="Browse and compare the complete list of 5-star luxury hotels, boutique stays, and guest houses in Gulshan, Dhaka."
  canonical={siteUrl}
>
  <!-- BREADCRUMB NAVIGATION -->
  <div class="bg-[#F8FAF9] pt-6 pb-2 px-4 sm:px-8 lg:px-12 max-w-[1550px] mx-auto text-left">
    <nav class="flex items-center gap-2 text-xs font-bold text-slate-500">
      <a href="/" class="hover:text-emerald-800 transition">Home</a>
      <span>›</span>
      <span class="text-slate-900 font-extrabold">All Hotels in Gulshan</span>
    </nav>
  </div>

  <!-- MAIN CONTAINER -->
  <section id="all-hotels-directory" class="bg-[#F8FAF9] py-4 sm:py-8 px-3 sm:px-8 lg:px-12 max-w-[1550px] mx-auto text-slate-900 border-b border-slate-200/80">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 sm:gap-8 items-start relative">
      
      <!-- ================= MOBILE BACKDROP OVERLAY ================= -->
      <div id="filterDrawerBackdrop" class="fixed inset-0 bg-slate-900/60 backdrop-blur-xs z-50 hidden lg:hidden transition-opacity duration-300 opacity-0"></div>

      <!-- ================= 1. SIDEBAR / MOBILE SLIDE-OVER DRAWER ================= -->
      <aside 
        id="filterSidebarDrawer" 
        class="fixed inset-y-0 left-0 z-50 w-[85vw] max-w-sm bg-white p-5 overflow-y-auto transform -translate-x-full transition-transform duration-300 ease-in-out lg:translate-x-0 lg:static lg:w-auto lg:z-auto lg:col-span-3 lg:block lg:rounded-2xl lg:border lg:border-slate-200 lg:p-5 lg:overflow-visible lg:sticky lg:top-4 lg:shadow-xs text-left"
      >
        
        <!-- Mobile Drawer Header -->
        <div class="flex items-center justify-between border-b border-slate-100 pb-3 mb-4">
          <div class="flex items-center gap-2">
            <h3 class="font-bold text-slate-900 text-sm tracking-tight">Search & Filters</h3>
            <button id="resetAllFiltersBtn" class="text-xs font-bold text-[#006ce4] hover:underline cursor-pointer">Reset all</button>
          </div>
          <!-- Close Button (Mobile Only) -->
          <button id="closeMobileFilterBtn" class="p-1 rounded-lg hover:bg-slate-100 text-slate-500 lg:hidden cursor-pointer" aria-label="Close filters">
            <span set:html={svgMap.closeIcon}></span>
          </button>
        </div>

        <div class="space-y-5">
          <!-- A. SEARCH PROPERTY -->
          <div class="space-y-1.5">
            <label for="dirSearchInput" class="font-bold text-slate-900 text-xs uppercase tracking-wider block">Search</label>
            <div class="relative">
              <input 
                type="text" 
                id="dirSearchInput" 
                placeholder="Search hotel name..." 
                class="w-full bg-slate-50 border border-slate-200 rounded-lg pl-8 pr-3 py-2 text-xs text-slate-800 focus:bg-white focus:outline-none focus:ring-2 focus:ring-[#006ce4]/20 focus:border-[#006ce4] transition font-medium"
              />
              <div class="absolute left-2.5 top-1/2 -translate-y-1/2 pointer-events-none">
                <span set:html={svgMap.search} class="inline-flex"></span>
              </div>
            </div>
          </div>

          <!-- B. SORT BY -->
          <div class="space-y-1.5">
            <label for="dirSortSelect" class="font-bold text-slate-900 text-xs uppercase tracking-wider block">Sort by</label>
            <select id="dirSortSelect" class="w-full bg-slate-50 border border-slate-200 text-slate-900 font-bold text-xs rounded-lg px-3 py-2 focus:outline-none cursor-pointer">
              <option value="recommended">Top picks</option>
              <option value="rating-high">Rating (highest)</option>
              <option value="price-low">Price (lowest)</option>
              <option value="price-high">Price (highest)</option>
            </select>
          </div>

          <!-- 1. NEIGHBORHOOD -->
          <div class="space-y-3 border-t border-slate-100 pt-4">
            <h4 class="font-bold text-slate-900 text-xs uppercase tracking-wider">Neighborhood</h4>
            <div class="space-y-2 text-xs font-medium text-slate-700">
              <label class="flex items-center justify-between cursor-pointer p-1 rounded hover:bg-slate-50">
                <div class="flex items-center gap-2">
                  <input type="radio" name="areaFilter" class="filter-area-radio w-4 h-4 accent-[#006ce4] cursor-pointer" value="all" checked />
                  <span class="font-semibold text-slate-800">All Gulshan</span>
                </div>
                <span class="text-slate-400 text-[11px]">{totalHotelsCount}</span>
              </label>

              <label class="flex items-center justify-between cursor-pointer p-1 rounded hover:bg-slate-50">
                <div class="flex items-center gap-2">
                  <input type="radio" name="areaFilter" class="filter-area-radio w-4 h-4 accent-[#006ce4] cursor-pointer" value="gulshan-1" />
                  <span class="text-slate-800">Gulshan 1</span>
                </div>
                <span class="text-slate-400 text-[11px]">{countGulshan1}</span>
              </label>

              <label class="flex items-center justify-between cursor-pointer p-1 rounded hover:bg-slate-50">
                <div class="flex items-center gap-2">
                  <input type="radio" name="areaFilter" class="filter-area-radio w-4 h-4 accent-[#006ce4] cursor-pointer" value="gulshan-2" />
                  <span class="text-slate-800">Gulshan 2</span>
                </div>
                <span class="text-slate-400 text-[11px]">{countGulshan2}</span>
              </label>

              {countNearGulshan > 0 && (
                <label class="flex items-center justify-between cursor-pointer p-1 rounded hover:bg-slate-50">
                  <div class="flex items-center gap-2">
                    <input type="radio" name="areaFilter" class="filter-area-radio w-4 h-4 accent-[#006ce4] cursor-pointer" value="near" />
                    <span class="text-slate-800">Near Gulshan</span>
                  </div>
                  <span class="text-slate-400 text-[11px]">{countNearGulshan}</span>
                </label>
              )}
            </div>
          </div>

          <!-- 2. PROPERTY STAR RATING -->
          <div class="space-y-3 border-t border-slate-100 pt-4">
            <h4 class="font-bold text-slate-900 text-xs uppercase tracking-wider">Property Rating</h4>
            <div class="space-y-2 text-xs font-medium text-slate-700">
              {count5Star > 0 && (
                <label class="flex items-center justify-between cursor-pointer p-1 rounded hover:bg-slate-50">
                  <div class="flex items-center gap-2">
                    <input type="checkbox" class="filter-star-cb w-4 h-4 accent-[#006ce4] rounded cursor-pointer" value="5" />
                    <span class="flex items-center gap-1 font-semibold text-slate-800">5 stars <span class="text-[#febb02] text-sm">★★★★★</span></span>
                  </div>
                  <span class="text-slate-400 text-[11px]">{count5Star}</span>
                </label>
              )}
              {count4Star > 0 && (
                <label class="flex items-center justify-between cursor-pointer p-1 rounded hover:bg-slate-50">
                  <div class="flex items-center gap-2">
                    <input type="checkbox" class="filter-star-cb w-4 h-4 accent-[#006ce4] rounded cursor-pointer" value="4" />
                    <span class="flex items-center gap-1 font-semibold text-slate-800">4 stars <span class="text-[#febb02] text-sm">★★★★</span></span>
                  </div>
                  <span class="text-slate-400 text-[11px]">{count4Star}</span>
                </label>
              )}
              {count3Star > 0 && (
                <label class="flex items-center justify-between cursor-pointer p-1 rounded hover:bg-slate-50">
                  <div class="flex items-center gap-2">
                    <input type="checkbox" class="filter-star-cb w-4 h-4 accent-[#006ce4] rounded cursor-pointer" value="3" />
                    <span class="flex items-center gap-1 font-semibold text-slate-800">3 stars <span class="text-[#febb02] text-sm">★★★</span></span>
                  </div>
                  <span class="text-slate-400 text-[11px]">{count3Star}</span>
                </label>
              )}
            </div>
          </div>

          <!-- 3. REVIEW SCORE -->
          <div class="space-y-3 border-t border-slate-100 pt-4">
            <h4 class="font-bold text-slate-900 text-xs uppercase tracking-wider">Review Score</h4>
            <div class="space-y-2 text-xs font-medium text-slate-700">
              <label class="flex items-center justify-between cursor-pointer p-1 rounded hover:bg-slate-50">
                <div class="flex items-center gap-2">
                  <input type="checkbox" class="filter-score-cb w-4 h-4 accent-[#006ce4] rounded cursor-pointer" value="9" />
                  <span class="text-slate-800 font-semibold">Wonderful: 9+</span>
                </div>
              </label>
              <label class="flex items-center justify-between cursor-pointer p-1 rounded hover:bg-slate-50">
                <div class="flex items-center gap-2">
                  <input type="checkbox" class="filter-score-cb w-4 h-4 accent-[#006ce4] rounded cursor-pointer" value="8" />
                  <span class="text-slate-800 font-semibold">Very Good: 8+</span>
                </div>
              </label>
              <label class="flex items-center justify-between cursor-pointer p-1 rounded hover:bg-slate-50">
                <div class="flex items-center gap-2">
                  <input type="checkbox" class="filter-score-cb w-4 h-4 accent-[#006ce4] rounded cursor-pointer" value="7" />
                  <span class="text-slate-800 font-semibold">Good: 7+</span>
                </div>
              </label>
            </div>
          </div>

          <!-- 4. PROPERTY TYPE -->
          <div class="space-y-3 border-t border-slate-100 pt-4">
            <h4 class="font-bold text-slate-900 text-xs uppercase tracking-wider">Property Type</h4>
            <div class="space-y-2 text-xs font-medium text-slate-700">
              <label class="flex items-center justify-between cursor-pointer p-1 rounded hover:bg-slate-50">
                <div class="flex items-center gap-2">
                  <input type="checkbox" class="filter-type-cb w-4 h-4 accent-[#006ce4] rounded cursor-pointer" value="hotel" />
                  <span class="text-slate-800 font-semibold">Hotels</span>
                </div>
                <span class="text-slate-400 text-[11px]">{totalHotelsCount - countGuestHouse}</span>
              </label>
              {countGuestHouse > 0 && (
                <label class="flex items-center justify-between cursor-pointer p-1 rounded hover:bg-slate-50">
                  <div class="flex items-center gap-2">
                    <input type="checkbox" class="filter-type-cb w-4 h-4 accent-[#006ce4] rounded cursor-pointer" value="guesthouse" />
                    <span class="text-slate-800 font-semibold">Guest Houses</span>
                  </div>
                  <span class="text-slate-400 text-[11px]">{countGuestHouse}</span>
                </label>
              )}
            </div>
          </div>

          <!-- 5. POPULAR FACILITIES -->
          <div class="space-y-3 border-t border-slate-100 pt-4">
            <h4 class="font-bold text-slate-900 text-xs uppercase tracking-wider">Popular Facilities</h4>
            <div class="space-y-2 text-xs font-medium text-slate-700">
              <label class="flex items-center gap-2 cursor-pointer p-1 rounded hover:bg-slate-50">
                <input type="checkbox" class="filter-facility-cb w-4 h-4 accent-[#006ce4] rounded cursor-pointer" value="wifi" />
                <span class="text-slate-800">Free Wi-Fi</span>
              </label>
              <label class="flex items-center gap-2 cursor-pointer p-1 rounded hover:bg-slate-50">
                <input type="checkbox" class="filter-facility-cb w-4 h-4 accent-[#006ce4] rounded cursor-pointer" value="pool" />
                <span class="text-slate-800">Swimming Pool</span>
              </label>
              <label class="flex items-center gap-2 cursor-pointer p-1 rounded hover:bg-slate-50">
                <input type="checkbox" class="filter-facility-cb w-4 h-4 accent-[#006ce4] rounded cursor-pointer" value="gym" />
                <span class="text-slate-800">Fitness Center / Gym</span>
              </label>
              <label class="flex items-center gap-2 cursor-pointer p-1 rounded hover:bg-slate-50">
                <input type="checkbox" class="filter-facility-cb w-4 h-4 accent-[#006ce4] rounded cursor-pointer" value="spa" />
                <span class="text-slate-800">Spa & Wellness</span>
              </label>
              <label class="flex items-center gap-2 cursor-pointer p-1 rounded hover:bg-slate-50">
                <input type="checkbox" class="filter-facility-cb w-4 h-4 accent-[#006ce4] rounded cursor-pointer" value="restaurant" />
                <span class="text-slate-800">Restaurant</span>
              </label>
              <label class="flex items-center gap-2 cursor-pointer p-1 rounded hover:bg-slate-50">
                <input type="checkbox" class="filter-facility-cb w-4 h-4 accent-[#006ce4] rounded cursor-pointer" value="parking" />
                <span class="text-slate-800">Free Parking</span>
              </label>
              <label class="flex items-center gap-2 cursor-pointer p-1 rounded hover:bg-slate-50">
                <input type="checkbox" class="filter-facility-cb w-4 h-4 accent-[#006ce4] rounded cursor-pointer" value="shuttle" />
                <span class="text-slate-800">Airport Shuttle</span>
              </label>
            </div>
          </div>

          <!-- 6. BUDGET SLIDER -->
          <div class="space-y-3 border-t border-slate-100 pt-4">
            <div class="flex justify-between items-center">
              <h4 class="font-bold text-slate-900 text-xs uppercase tracking-wider">Your budget (per night)</h4>
              <span id="priceRangeValueDisplay" class="text-xs font-bold text-[#006ce4]">৳60,000+</span>
            </div>
            <div class="space-y-2 pt-1">
              <input type="range" id="priceRangeSlider" min="2000" max="60000" step="1000" value="60000" class="w-full accent-[#006ce4] cursor-pointer h-1.5 bg-slate-200 rounded-lg" />
              <div class="flex justify-between text-[11px] text-slate-400">
                <span>৳2,000</span>
                <span>৳60,000+</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Mobile Drawer Apply Button -->
        <div class="sticky bottom-0 bg-white pt-4 pb-2 mt-6 border-t border-slate-100 lg:hidden">
          <button id="applyMobileFilterBtn" class="w-full bg-[#006ce4] hover:bg-[#0057b8] text-white py-3 rounded-xl font-bold text-xs shadow-md transition">
            Show Results
          </button>
        </div>

      </aside>

      <!-- ================= 2. RIGHT COLUMN ================= -->
      <div class="lg:col-span-9 space-y-4">
        
        <!-- FLUSH STICKY HEADER (LOCKS DIRECTLY AT TOP-0) -->
        <div class="sticky top-0 z-40 bg-white/95 backdrop-blur-md p-2.5 sm:p-3.5 rounded-xl sm:rounded-2xl border border-slate-200 shadow-sm flex items-center justify-between gap-2 overflow-x-auto [scrollbar-width:none] [-ms-overflow-style:none] [&::-webkit-scrollbar]:hidden">
          
          <div class="flex items-center gap-2 shrink-0">
            
            <!-- MOBILE FILTER OPEN BUTTON (Visible on Phone/Tablet) -->
            <button 
              type="button" 
              id="openMobileFilterBtn" 
              class="lg:hidden flex items-center gap-1.5 px-3 py-2 rounded-xl text-xs font-bold bg-[#006ce4]/10 text-[#006ce4] border border-[#006ce4]/20 hover:bg-[#006ce4]/20 transition cursor-pointer shrink-0"
            >
              <span set:html={svgMap.filterIcon} class="inline-flex"></span>
              <span>Filters</span>
            </button>

            <!-- Quick Filter Tabs -->
            <button 
              type="button" 
              class="quick-pill-btn px-3 sm:px-3.5 py-2 rounded-xl text-xs font-bold transition flex items-center gap-1.5 shrink-0 bg-[#003b95] text-white shadow-xs cursor-pointer"
              data-quick="all"
            >
              <span>All Stays</span>
              <span class="bg-white/20 text-white text-[10px] px-1.5 py-0.5 rounded-full">{totalHotelsCount}</span>
            </button>

            <button 
              type="button" 
              class="quick-pill-btn px-3 sm:px-3.5 py-2 rounded-xl text-xs font-bold transition flex items-center gap-1.5 shrink-0 bg-slate-50 hover:bg-slate-100 text-slate-700 border border-slate-200 cursor-pointer"
              data-quick="hotel"
            >
              <span>Hotels</span>
              <span class="bg-slate-200 text-slate-700 text-[10px] px-1.5 py-0.5 rounded-full">{totalHotelsCount - countGuestHouse}</span>
            </button>

            {countGuestHouse > 0 && (
              <button 
                type="button" 
                class="quick-pill-btn px-3 sm:px-3.5 py-2 rounded-xl text-xs font-bold transition flex items-center gap-1.5 shrink-0 bg-slate-50 hover:bg-slate-100 text-slate-700 border border-slate-200 cursor-pointer"
                data-quick="guesthouse"
              >
                <span>Guest Houses</span>
                <span class="bg-slate-200 text-slate-700 text-[10px] px-1.5 py-0.5 rounded-full">{countGuestHouse}</span>
              </button>
            )}

            {countNearGulshan > 0 && (
              <button 
                type="button" 
                class="quick-pill-btn px-3 sm:px-3.5 py-2 rounded-xl text-xs font-bold transition flex items-center gap-1.5 shrink-0 bg-slate-50 hover:bg-slate-100 text-slate-700 border border-slate-200 cursor-pointer"
                data-quick="near"
              >
                <span>Near Gulshan</span>
                <span class="bg-slate-200 text-slate-700 text-[10px] px-1.5 py-0.5 rounded-full">{countNearGulshan}</span>
              </button>
            )}
          </div>

          <!-- Total Properties Indicator -->
          <div class="shrink-0 text-right">
            <span class="text-xs font-bold text-slate-600 hidden md:inline">
              Gulshan: <strong class="text-[#006ce4]" id="dirTotalHotelsDisplay">{totalHotelsCount} properties found</strong>
            </span>
          </div>

        </div>

        <!-- HOTEL CARDS LIST -->
        <div id="directoryCardsGrid" class="grid grid-cols-1 gap-4 items-stretch">
          {hotels.map((hotelItem: any) => {
            const hData = hotelItem.data || {};
            const rawTitle = String(hData.title || hData.name || "").trim();
            const hTitle = toTitleCase(rawTitle);
            const hSlug = String(hData.slug || hotelItem.slug || hotelItem.id || "").trim();
            const hImage = hData.image || (Array.isArray(hData.gallery) ? hData.gallery[0] : "");
            
            // Full Address
            const hFullAddress = String(hData.address || hData.location || hData.category || "Gulshan, Dhaka").trim();
            const locLower = hFullAddress.toLowerCase();
            const titleLowerStr = rawTitle.toLowerCase();
            const catLower = String(hData.category || '').toLowerCase();

            let areaType = 'near';
            if (locLower.includes('gulshan 1') || locLower.includes('gulshan-1') || locLower.includes('gulshan1')) {
              areaType = 'gulshan-1';
            } else if (locLower.includes('gulshan 2') || locLower.includes('gulshan-2') || locLower.includes('gulshan2')) {
              areaType = 'gulshan-2';
            } else {
              areaType = 'near';
            }

            const isGuestHouse = locLower.includes('guest house') || locLower.includes('guesthouse') || titleLowerStr.includes('guest house') || titleLowerStr.includes('guesthouse') || catLower.includes('guest house');

            // 25 Words from Body
            const rawAbout = hotelItem.body || (typeof hotelItem.rawContent === 'function' ? hotelItem.rawContent() : '') || hData.about || hData.description || '';
            const hSnippet25Words = getFirst25Words(rawAbout);

            // Amenities string for filter
            const amenitiesStr = JSON.stringify(hData.amenities || []).toLowerCase();

            // Price Calculation & Normalized Comparison
            const rawPrice = hData.price ? String(hData.price).trim() : "";
            const displayPrice = cleanPriceString(rawPrice);
            const rawDigits = parseFloat(rawPrice.replace(/[^0-9.]/g, '')) || 0;
            const isDollar = rawPrice.includes('$');
            
            const numericPrice = isDollar ? Math.round(rawDigits * 120) : rawDigits;

            let originalPriceNum = hData.originalPrice ? parseFloat(String(hData.originalPrice).replace(/[^0-9.]/g, '')) : 0;
            if (!originalPriceNum || originalPriceNum <= rawDigits) {
              originalPriceNum = isDollar ? Math.round(rawDigits * 1.20) : Math.round(rawDigits * 1.20 / 100) * 100;
            }
            const displayOriginalPrice = isDollar ? `$${originalPriceNum}` : `৳ ${originalPriceNum.toLocaleString()}`;

            // Star Count
            const rawCat = String(hData.starCategory || hData.category || '').toLowerCase();
            const starCount = rawCat.includes('5') ? 5 : (rawCat.includes('4') ? 4 : (rawCat.includes('3') ? 3 : 0));

            const hTitleLower = rawTitle.toLowerCase();
            const hSlugLower = hSlug.toLowerCase();

            // Real Reviews
            const matchedCmsReviews = allCmsReviews.filter(r => {
              if (!r) return false;
              const isApproved = r.approved === true || String(r.approved).toLowerCase() === 'true';
              if (!isApproved) return false;

              const rHotel = String(r.hotel || '').trim().toLowerCase();
              const rSlug = String(r.slug || r.hotelSlug || '').trim().toLowerCase();

              return (rSlug && rSlug === hSlugLower) || (rHotel && rHotel === hTitleLower);
            });

            const embedded = Array.isArray(hData.reviews) ? hData.reviews : [];
            const finalReviewsList = matchedCmsReviews.length > 0 ? matchedCmsReviews : embedded;

            const realCount = finalReviewsList.length;
            let realRating: string | null = null;

            if (realCount > 0) {
              const totalStars = finalReviewsList.reduce((sum: number, r: any) => {
                const num = parseFloat(r.rating);
                return sum + (!isNaN(num) && num > 0 && num <= 5 ? num : 5);
              }, 0);
              const avg = totalStars / realCount;
              realRating = (avg * 2).toFixed(1);
            }

            const numRating = parseFloat(realRating || '0');

            let ratingLabel = 'Wonderful';
            if (numRating < 9.0 && numRating >= 8.0) ratingLabel = 'Very Good';
            else if (numRating < 8.0 && numRating > 0) ratingLabel = 'Good';

            return (
              <div 
                class="directory-card-item bg-white rounded-2xl border border-slate-200/90 overflow-hidden shadow-xs hover:shadow-md transition duration-200 text-left relative flex flex-col md:flex-row p-3.5 sm:p-4 md:p-4 gap-3.5 sm:gap-4 md:gap-0 min-h-[195px]"
                data-title={hTitleLower}
                data-stars={starCount.toString()}
                data-area={areaType}
                data-guesthouse={isGuestHouse ? 'true' : 'false'}
                data-amenities={amenitiesStr}
                data-numeric-price={numericPrice}
                data-numeric-rating={numRating}
              >
                <!-- 1ST COLUMN: HOTEL PHOTO -->
                <div class="card-img-box relative w-full md:w-56 lg:w-60 shrink-0 rounded-xl overflow-hidden bg-slate-100 self-stretch md:self-auto h-48 md:h-auto">
                  {hImage ? (
                    <img 
                      src={hImage} 
                      alt={`${hTitle} Photo`} 
                      loading="lazy" 
                      decoding="async" 
                      class="w-full h-full object-cover hover:scale-105 transition duration-500" 
                    />
                  ) : (
                    <div class="w-full h-full flex items-center justify-center bg-slate-100 text-slate-400 text-xs font-bold">
                      Hotel Photo
                    </div>
                  )}

                  <button 
                    type="button"
                    class="card-wishlist-btn absolute top-2 right-2 w-7 h-7 sm:w-8 sm:h-8 rounded-full bg-white/90 hover:bg-white text-slate-800 flex items-center justify-center shadow transition cursor-pointer hover:scale-110 z-20"
                    data-title={hTitle}
                    data-image={hImage}
                    data-url={`/${hSlug}`}
                    data-price={displayPrice}
                    aria-label="Save to Wishlist"
                  >
                    <svg class="w-3.5 h-3.5 text-slate-700 transition" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path></svg>
                  </button>
                </div>

                <!-- 2ND COLUMN: MIDDLE DETAILS -->
                <div class="flex-1 flex flex-col justify-between min-w-0 py-1 md:px-4">
                  <div>
                    <!-- Title & Stars -->
                    <div class="flex items-center gap-1.5 flex-wrap">
                      <a href={`/${hSlug}`} class="text-base sm:text-lg font-bold text-[#006ce4] hover:text-[#003b95] hover:underline transition">
                        {hTitle}
                      </a>
                      {starCount > 0 && (
                        <span class="text-[#febb02] text-xs sm:text-sm tracking-tight shrink-0">
                          {'★'.repeat(starCount)}
                        </span>
                      )}
                    </div>

                    <!-- Full Hotel Address -->
                    <div class="flex items-start gap-1 text-[11px] sm:text-xs text-slate-600 font-medium mt-1 leading-snug">
                      <span set:html={svgMap.locationPin} class="inline-flex shrink-0"></span>
                      <span class="hover:underline cursor-pointer line-clamp-1">{hFullAddress}</span>
                    </div>

                    <!-- 25 Words Description -->
                    <p class="text-xs text-slate-600 mt-2.5 leading-relaxed line-clamp-3">
                      {hSnippet25Words}
                    </p>
                  </div>
                </div>

                <!-- 3RD COLUMN: PRICING & BOOKING -->
                <div class="w-full md:w-52 lg:w-56 shrink-0 md:border-l md:border-slate-100 md:pl-4 pt-3 md:pt-1 border-t md:border-t-0 border-slate-100 flex md:flex-col justify-between items-end text-right">
                  
                  <!-- Top: Review Score -->
                  <div class="w-full flex justify-end">
                    {realRating ? (
                      <div class="flex items-center gap-2">
                        <div class="text-right hidden sm:block">
                          <div class="text-xs font-bold text-slate-900 leading-tight">{ratingLabel}</div>
                          <div class="text-[10px] text-slate-500 leading-tight">{realCount} reviews</div>
                        </div>
                        <div class="bg-[#003b95] text-white font-bold text-sm px-2 py-1 rounded-t-lg rounded-br-lg leading-none shadow-xs">
                          {realRating}
                        </div>
                      </div>
                    ) : (
                      <div class="bg-slate-100 text-slate-600 text-[10px] font-bold px-2 py-0.5 rounded">
                        New to site
                      </div>
                    )}
                  </div>

                  <!-- Bottom: Pricing & CTA Button -->
                  <div class="w-full text-right space-y-1.5 mt-auto">
                    <div>
                      <span class="text-[11px] text-slate-400 line-through font-semibold block leading-none">
                        {displayOriginalPrice}
                      </span>
                      <span class="text-lg sm:text-xl font-extrabold text-[#008234] block leading-tight my-0.5">
                        {displayPrice}
                      </span>
                      <span class="text-[9px] sm:text-[10px] text-slate-500 font-medium block leading-tight">
                        Best rate found
                      </span>
                    </div>

                    <a 
                      href={`/${hSlug}`} 
                      class="w-full bg-[#006ce4] hover:bg-[#0057b8] text-white text-xs font-bold py-2 px-3 rounded-lg transition inline-flex items-center justify-center gap-1 shadow-xs hover:shadow whitespace-nowrap text-center"
                    >
                      <span>See Options</span>
                      <span class="text-xs">›</span>
                    </a>
                  </div>

                </div>

              </div>
            );
          })}
        </div>

      </div>

    </div>
  </section>
</Layout>

<!-- CLIENT SIDE JAVASCRIPT -->
<script is:inline>
  function initHotelsDirectoryPage() {
    const searchInput = document.getElementById('dirSearchInput');
    const sortSelect = document.getElementById('dirSortSelect');
    const priceSlider = document.getElementById('priceRangeSlider');
    const priceDisplay = document.getElementById('priceRangeValueDisplay');
    const resetBtn = document.getElementById('resetAllFiltersBtn');
    const totalDisplayEl = document.getElementById('dirTotalHotelsDisplay');
    const cards = document.querySelectorAll('.directory-card-item');

    const areaRadios = document.querySelectorAll('.filter-area-radio');
    const starCbs = document.querySelectorAll('.filter-star-cb');
    const scoreCbs = document.querySelectorAll('.filter-score-cb');
    const typeCbs = document.querySelectorAll('.filter-type-cb');
    const facilityCbs = document.querySelectorAll('.filter-facility-cb');
    const quickPillBtns = document.querySelectorAll('.quick-pill-btn');

    // Mobile Drawer Elements
    const openMobileFilterBtn = document.getElementById('openMobileFilterBtn');
    const closeMobileFilterBtn = document.getElementById('closeMobileFilterBtn');
    const applyMobileFilterBtn = document.getElementById('applyMobileFilterBtn');
    const filterSidebarDrawer = document.getElementById('filterSidebarDrawer');
    const filterDrawerBackdrop = document.getElementById('filterDrawerBackdrop');

    let currentQuickFilter = 'all';

    // Facilities Alias Map
    const facilityAliases = {
      wifi: ['wifi', 'wi-fi', 'internet'],
      pool: ['pool', 'swimming'],
      gym: ['gym', 'fitness', 'workout'],
      spa: ['spa', 'wellness', 'massage', 'sauna'],
      restaurant: ['restaurant', 'dining', 'cafe', 'breakfast'],
      parking: ['parking', 'garage'],
      shuttle: ['shuttle', 'airport transfer', 'pickup']
    };

    // Mobile Drawer Toggle Logic
    function openMobileDrawer() {
      if (filterSidebarDrawer && filterDrawerBackdrop) {
        filterSidebarDrawer.classList.remove('-translate-x-full');
        filterDrawerBackdrop.classList.remove('hidden');
        setTimeout(() => {
          filterDrawerBackdrop.classList.remove('opacity-0');
        }, 10);
        document.body.style.overflow = 'hidden';
      }
    }

    function closeMobileDrawer() {
      if (filterSidebarDrawer && filterDrawerBackdrop) {
        filterSidebarDrawer.classList.add('-translate-x-full');
        filterDrawerBackdrop.classList.add('opacity-0');
        setTimeout(() => {
          filterDrawerBackdrop.classList.add('hidden');
        }, 300);
        document.body.style.overflow = '';
      }
    }

    if (openMobileFilterBtn) openMobileFilterBtn.onclick = openMobileDrawer;
    if (closeMobileFilterBtn) closeMobileFilterBtn.onclick = closeMobileDrawer;
    if (applyMobileFilterBtn) applyMobileFilterBtn.onclick = closeMobileDrawer;
    if (filterDrawerBackdrop) filterDrawerBackdrop.onclick = closeMobileDrawer;

    // Filter Logic
    function filterDirectory() {
      const query = (searchInput?.value || '').trim().toLowerCase();
      const maxPrice = parseFloat(priceSlider?.value || '60000');
      
      const selectedArea = Array.from(areaRadios).find(r => r.checked)?.value || 'all';
      const selectedStars = Array.from(starCbs).filter(cb => cb.checked).map(cb => cb.value);
      const selectedScores = Array.from(scoreCbs).filter(cb => cb.checked).map(cb => parseFloat(cb.value));
      const selectedTypes = Array.from(typeCbs).filter(cb => cb.checked).map(cb => cb.value);
      const selectedFacilities = Array.from(facilityCbs).filter(cb => cb.checked).map(cb => cb.value.toLowerCase());

      let visibleCount = 0;

      cards.forEach(card => {
        const title = card.getAttribute('data-title') || '';
        const stars = card.getAttribute('data-stars') || '0';
        const area = card.getAttribute('data-area') || 'near';
        const isGuestHouse = card.getAttribute('data-guesthouse') === 'true';
        const price = parseFloat(card.getAttribute('data-numeric-price') || '0');
        const rating = parseFloat(card.getAttribute('data-numeric-rating') || '0');
        const amenities = (card.getAttribute('data-amenities') || '').toLowerCase();

        // 1. Search Match
        const matchSearch = !query || title.includes(query);

        // 2. Quick Pill Tab Match
        let matchQuick = true;
        if (currentQuickFilter === 'all') matchQuick = true;
        else if (currentQuickFilter === 'hotel') matchQuick = !isGuestHouse;
        else if (currentQuickFilter === 'guesthouse') matchQuick = isGuestHouse;
        else if (currentQuickFilter === 'near') matchQuick = (area === 'near');

        // 3. Sidebar Area Match
        const matchArea = selectedArea === 'all' || area === selectedArea;

        // 4. Star Rating Match
        const matchStars = selectedStars.length === 0 || selectedStars.includes(stars);

        // 5. Price Match
        const matchPrice = price === 0 || maxPrice >= 60000 || price <= maxPrice;

        // 6. Review Score Match
        let matchScore = true;
        if (selectedScores.length > 0) {
          const minScore = Math.min(...selectedScores);
          matchScore = rating >= minScore;
        }

        // 7. Property Type Match
        let matchType = true;
        if (selectedTypes.length > 0) {
          if (selectedTypes.includes('guesthouse') && !selectedTypes.includes('hotel')) {
            matchType = isGuestHouse;
          } else if (selectedTypes.includes('hotel') && !selectedTypes.includes('guesthouse')) {
            matchType = !isGuestHouse;
          }
        }

        // 8. Facilities Match
        let matchFacilities = true;
        if (selectedFacilities.length > 0) {
          matchFacilities = selectedFacilities.every(facKey => {
            const keywords = facilityAliases[facKey] || [facKey];
            return keywords.some(kw => amenities.includes(kw));
          });
        }

        if (matchSearch && matchQuick && matchArea && matchStars && matchPrice && matchScore && matchType && matchFacilities) {
          card.classList.remove('hidden');
          visibleCount++;
        } else {
          card.classList.add('hidden');
        }
      });

      if (totalDisplayEl) {
        totalDisplayEl.textContent = `${visibleCount} properties found`;
      }
    }

    // Quick Pill Buttons Click
    quickPillBtns.forEach(btn => {
      btn.onclick = () => {
        quickPillBtns.forEach(b => {
          b.className = 'quick-pill-btn px-3 sm:px-3.5 py-2 rounded-xl text-xs font-bold transition flex items-center gap-1.5 shrink-0 bg-slate-50 hover:bg-slate-100 text-slate-700 border border-slate-200 cursor-pointer';
          const badge = b.querySelector('span:last-child');
          if (badge) badge.className = 'bg-slate-200 text-slate-700 text-[10px] px-1.5 py-0.5 rounded-full';
        });

        btn.className = 'quick-pill-btn px-3 sm:px-3.5 py-2 rounded-xl text-xs font-bold transition flex items-center gap-1.5 shrink-0 bg-[#003b95] text-white shadow-xs cursor-pointer';
        const activeSpan = btn.querySelector('span:last-child');
        if (activeSpan) activeSpan.className = 'bg-white/20 text-white text-[10px] px-1.5 py-0.5 rounded-full';

        currentQuickFilter = btn.getAttribute('data-quick') || 'all';
        filterDirectory();
      };
    });

    if (searchInput) searchInput.oninput = filterDirectory;
    
    if (priceSlider) {
      priceSlider.oninput = (e) => {
        const val = parseInt(e.target.value);
        if (priceDisplay) {
          priceDisplay.textContent = val >= 60000 ? '৳60,000+' : `৳${val.toLocaleString()}`;
        }
        filterDirectory();
      };
    }

    areaRadios.forEach(r => r.onchange = filterDirectory);
    starCbs.forEach(cb => cb.onchange = filterDirectory);
    scoreCbs.forEach(cb => cb.onchange = filterDirectory);
    typeCbs.forEach(cb => cb.onchange = filterDirectory);
    facilityCbs.forEach(cb => cb.onchange = filterDirectory);

    if (resetBtn) {
      resetBtn.onclick = () => {
        if (searchInput) searchInput.value = '';
        if (priceSlider) {
          priceSlider.value = '60000';
          if (priceDisplay) priceDisplay.textContent = '৳60,000+';
        }
        if (sortSelect) sortSelect.value = 'recommended';
        if (areaRadios.length > 0) areaRadios[0].checked = true;
        starCbs.forEach(cb => cb.checked = false);
        scoreCbs.forEach(cb => cb.checked = false);
        typeCbs.forEach(cb => cb.checked = false);
        facilityCbs.forEach(cb => cb.checked = false);

        if (quickPillBtns.length > 0) {
          quickPillBtns[0].click();
        } else {
          filterDirectory();
        }
      };
    }

    if (sortSelect) {
      sortSelect.onchange = (e) => {
        const val = e.target.value;
        const grid = document.getElementById('directoryCardsGrid');
        if (!grid) return;

        const cardsArr = Array.from(cards);
        cardsArr.sort((a, b) => {
          const pA = parseFloat(a.getAttribute('data-numeric-price') || '0');
          const pB = parseFloat(b.getAttribute('data-numeric-price') || '0');
          const rA = parseFloat(a.getAttribute('data-numeric-rating') || '0');
          const rB = parseFloat(b.getAttribute('data-numeric-rating') || '0');

          if (val === 'price-low') return pA - pB;
          if (val === 'price-high') return pB - pA;
          if (val === 'rating-high') return rB - rA;
          return 0;
        });

        cardsArr.forEach(c => grid.appendChild(c));
      };
    }

    // Wishlist Logic
    document.querySelectorAll('.card-wishlist-btn').forEach(btn => {
      const title = btn.getAttribute('data-title') || '';
      let list = [];
      try { list = JSON.parse(localStorage.getItem('gh_wishlist') || '[]'); } catch (e) { list = []; }

      const isSaved = list.some(item => item.title === title);
      const iconSvg = btn.querySelector('svg');
      if (isSaved && iconSvg) {
        iconSvg.setAttribute('fill', 'currentColor');
        iconSvg.classList.add('text-rose-600');
        iconSvg.classList.remove('text-slate-700');
      }

      btn.onclick = (e) => {
        e.preventDefault();
        const image = btn.getAttribute('data-image') || '';
        const url = btn.getAttribute('data-url') || '';
        const price = btn.getAttribute('data-price') || '';

        try { list = JSON.parse(localStorage.getItem('gh_wishlist') || '[]'); } catch (err) { list = []; }

        const idx = list.findIndex(item => item.title === title);
        if (idx > -1) {
          list.splice(idx, 1);
          if (iconSvg) {
            iconSvg.setAttribute('fill', 'none');
            iconSvg.classList.remove('text-rose-600');
            iconSvg.classList.add('text-slate-700');
          }
        } else {
          list.push({ title, image, url, price });
          if (iconSvg) {
            iconSvg.setAttribute('fill', 'currentColor');
            iconSvg.classList.remove('text-slate-700');
            iconSvg.classList.add('text-rose-600');
          }
        }

        localStorage.setItem('gh_wishlist', JSON.stringify(list));
      };
    });
  }

  document.addEventListener('astro:page-load', initHotelsDirectoryPage);
  if (document.readyState !== 'loading') {
    initHotelsDirectoryPage();
  } else {
    document.addEventListener('DOMContentLoaded', initHotelsDirectoryPage);
  }
</script>
