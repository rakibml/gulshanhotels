---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

// ১. স্পন্সরড ডাটা লোড
let sponsorData = null;
try {
  const rawSponsor = import.meta.glob('../content/sponsored/*.md', { eager: true });
  const list = Object.values(rawSponsor);
  if (list && list.length > 0) {
    sponsorData = (list[0] as any).frontmatter;
  }
} catch (e) {
  sponsorData = null;
}

if (!sponsorData) {
  sponsorData = {
    enable: true,
    badge: "⭐ Editor's Choice",
    title: "The Westin Dhaka",
    category: "5-Star Luxury • Gulshan 2",
    rating: 4.8,
    image: "https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&w=800&q=80",
    buttonText: "Check Best Deal ➔",
    buttonLink: "/the-westin-dhaka"
  };
}

function toTitleCase(str: string) {
  if (!str) return 'Gulshan Hotel';
  return str.replace(/\w\S*/g, (txt) => txt.charAt(0).toUpperCase() + txt.substr(1).toLowerCase());
}

// ২. গুলশানের সব ভেরিফাইড হোটেল লোড করা
let hotels: any[] = [];
try {
  const collectionData = await getCollection('hotels');
  if (collectionData && collectionData.length > 0) {
    hotels = collectionData.map((item: any) => ({
      slug: item.id || item.slug,
      title: toTitleCase(item.data?.title || item.data?.name || 'Gulshan Hotel'),
      category: item.data?.category || 'Luxury Hotel',
      location: item.data?.location || 'Gulshan 2, Dhaka',
      zone: (item.data?.location || '').toLowerCase().includes('gulshan 1') 
            ? 'gulshan-1' 
            : (item.data?.location || '').toLowerCase().includes('banani')
            ? 'banani'
            : 'gulshan-2',
      price: item.data?.price || '$$$$',
      rating: item.data?.rating || 4.8,
      image: item.data?.image || 'https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&w=800&q=80',
    }));
  }
} catch (err) {
  hotels = [];
}
---

<Layout title="GulshanHotels.com — Luxury Accommodations & Travel Directory in Gulshan, Dhaka">
  
  <!-- APPLE-LEVEL LUXURY ANIMATED HERO SECTION -->
  <section id="heroSection" class="relative min-h-screen w-full bg-[#040c17] text-white flex flex-col justify-between overflow-hidden">
    
    <!-- 1. CINEMATIC BACKGROUND IMAGE WITH GPU-ACCELERATED APPLE SCROLL SCALE -->
    <div id="heroBgWrapper" class="absolute inset-0 w-full h-full pointer-events-none transition-transform duration-700 ease-out">
      <img 
        id="heroBgImage"
        src="https://images.unsplash.com/photo-1512917774080-9991f1c4c750?auto=format&fit=crop&w=2400&q=90" 
        alt="Gulshan Dhaka Aerial Evening Skyline" 
        class="w-full h-full object-cover opacity-50 scale-100 transition-transform duration-300"
      />

      <!-- Dynamic Sunset to Blue Hour Ambient Overlay -->
      <div class="absolute inset-0 bg-gradient-to-b from-[#040c17]/90 via-[#040c17]/50 to-[#040c17]/95"></div>
      
      <!-- Radial Golden Aura Glow -->
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[500px] bg-amber-500/10 blur-[150px] rounded-full"></div>

      <!-- MICRO-ANIMATIONS 1: GLOWING BUILDING WINDOWS (LIVING CITY EFFECT) -->
      <div class="absolute inset-0 pointer-events-none opacity-80">
        <div class="window-glow absolute top-[35%] left-[25%] w-2 h-2 bg-amber-300/80 rounded-full blur-[1px]"></div>
        <div class="window-glow delay-1 absolute top-[42%] left-[30%] w-1.5 h-3 bg-amber-200/90 blur-[1px]"></div>
        <div class="window-glow delay-2 absolute top-[38%] right-[28%] w-2.5 h-2 bg-amber-100/90 blur-[1px]"></div>
        <div class="window-glow delay-3 absolute top-[45%] right-[22%] w-2 h-2 bg-amber-300/70 blur-[1px]"></div>
        <div class="window-glow delay-4 absolute top-[50%] left-[48%] w-3 h-1.5 bg-amber-200/80 blur-[1px]"></div>
      </div>

      <!-- MICRO-ANIMATIONS 2: MOVING TRAFFIC LIGHT TRAILS ALONG BOULEVARD -->
      <div class="absolute bottom-[25%] left-0 w-full h-1 pointer-events-none overflow-hidden opacity-70">
        <div class="traffic-light-white absolute h-0.5 bg-gradient-to-r from-transparent via-white to-transparent w-48"></div>
        <div class="traffic-light-red absolute h-0.5 bg-gradient-to-r from-transparent via-red-500 to-transparent w-48"></div>
      </div>
    </div>

    <!-- 2. TRANSPARENT APPLE-STYLE NAVBAR (BECOMES GLASSMORPHISM ON SCROLL) -->
    <header id="mainNavbar" class="fixed top-0 left-0 right-0 z-50 py-4 sm:py-6 px-4 sm:px-8 lg:px-12 transition-all duration-500">
      <div class="max-w-[1600px] mx-auto flex justify-between items-center">
        
        <!-- Logo Left -->
        <a href="/" class="flex items-center gap-3 group">
          <div class="w-10 h-10 rounded-full border border-[#c5a059] bg-[#040c17]/60 backdrop-blur-md flex items-center justify-center text-[#c5a059] shadow-lg group-hover:scale-105 transition">
            <svg class="w-5 h-5 stroke-[#c5a059] fill-none" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8z"/>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 6v12M6 12h12"/>
            </svg>
          </div>
          <div class="flex flex-col">
            <span class="text-xl sm:text-2xl font-black font-['Cormorant_Garamond'] tracking-widest text-white leading-none">
              GULSHANHOTELS<span class="text-[#c5a059]">.COM</span>
            </span>
            <span class="text-[9px] text-[#c5a059] tracking-[0.3em] font-bold uppercase mt-1">
              LUXURY HOTEL DIRECTORY
            </span>
          </div>
        </a>

        <!-- Menu Right -->
        <nav class="hidden lg:flex items-center space-x-9 text-xs font-bold tracking-[0.2em] uppercase text-slate-200">
          <a href="#all-hotels" class="hover:text-[#c5a059] transition">Hotels</a>
          <a href="#areas" class="hover:text-[#c5a059] transition">Areas</a>
          <a href="#guide" class="hover:text-[#c5a059] transition">Travel Guide</a>
          <a href="#about" class="hover:text-[#c5a059] transition">About</a>
        </nav>

        <!-- Right Utilities & Search -->
        <div class="flex items-center space-x-3 sm:space-x-4">
          <a href="#all-hotels" class="text-slate-200 hover:text-[#c5a059] transition p-2" aria-label="Search">
            <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24"><path d="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/></svg>
          </a>

          <a href="#all-hotels" class="hidden sm:inline-flex bg-gradient-to-r from-[#c5a059] to-[#d4af37] text-slate-950 hover:text-white font-extrabold text-xs tracking-wider uppercase px-5 py-2.5 rounded-full transition shadow-xl hover:scale-105">
            Explore Directory
          </a>

          <button id="mobile-menu-btn" class="lg:hidden text-white hover:text-[#c5a059] p-2 focus:outline-none">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path></svg>
          </button>
        </div>

      </div>

      <!-- Mobile Drawer -->
      <div id="mobile-menu" class="hidden lg:hidden bg-[#040c17]/95 border-t border-slate-800 px-6 py-6 space-y-3 font-extrabold text-xs tracking-widest uppercase text-white backdrop-blur-xl mt-3 rounded-2xl">
        <a href="#all-hotels" class="block py-1 hover:text-[#c5a059]">Hotels</a>
        <a href="#areas" class="block py-1 hover:text-[#c5a059]">Areas</a>
        <a href="#guide" class="block py-1 hover:text-[#c5a059]">Travel Guide</a>
        <a href="#about" class="block py-1 hover:text-[#c5a059]">About</a>
      </div>
    </header>

    <!-- 3. CENTERED LUXURY TYPOGRAPHY & BUTTONS -->
    <div id="heroContent" class="relative z-20 max-w-[900px] mx-auto px-4 text-center my-auto pt-32 sm:pt-40 pb-16 space-y-6 sm:space-y-8 transition-all duration-500">
      
      <!-- Subtitle (Gold, Uppercase, Letter-spaced) -->
      <div class="inline-block">
        <span class="text-xs sm:text-sm font-bold uppercase tracking-[0.35em] text-[#c5a059] drop-shadow">
          EXPLORE ALL GULSHAN HOTELS
        </span>
      </div>

      <!-- Main Headline (GulshanHotels.com - Large, Elegant, White Luxury Serif) -->
      <h1 class="text-4xl sm:text-7xl lg:text-8xl font-black font-['Playfair_Display'] text-white tracking-tight leading-none drop-shadow-2xl select-none">
        GulshanHotels<span class="text-[#c5a059]">.com</span>
      </h1>

      <!-- Description (Max-width 650px) -->
      <p class="text-sm sm:text-lg text-slate-200 max-w-[650px] mx-auto font-normal leading-relaxed drop-shadow-md">
        Discover luxury, business, boutique, and budget hotels in the heart of Gulshan, Dhaka. Your official local accommodation guide.
      </p>

      <!-- Action Buttons -->
      <div class="pt-4 flex flex-wrap justify-center items-center gap-4">
        <!-- Primary Gold Button -->
        <a 
          href="#all-hotels" 
          class="group relative inline-flex items-center gap-3 bg-gradient-to-r from-[#c5a059] via-[#d4af37] to-[#c5a059] text-slate-950 font-black text-xs sm:text-sm uppercase tracking-widest px-8 py-4 rounded-full shadow-2xl transition duration-300 hover:scale-105 hover:shadow-amber-500/20 overflow-hidden"
        >
          <span>Explore Hotels</span>
          <span class="group-hover:translate-x-1 transition-transform">➔</span>
        </a>

        <!-- Secondary Glass Button -->
        <a 
          href="#areas" 
          class="inline-flex items-center gap-2 bg-white/10 hover:bg-white/20 border border-white/25 text-white font-extrabold text-xs sm:text-sm uppercase tracking-widest px-7 py-4 rounded-full transition backdrop-blur-md hover:scale-105"
        >
          <span>View City Guide</span>
        </a>
      </div>

    </div>

    <!-- 4. ANIMATED MOUSE SCROLL INDICATOR -->
    <div class="relative z-20 pb-8 text-center flex flex-col items-center justify-center space-y-2">
      <a href="#all-hotels" class="group inline-flex flex-col items-center gap-2 cursor-pointer">
        <span class="text-[10px] font-bold uppercase tracking-[0.3em] text-[#c5a059] group-hover:text-white transition">
          SCROLL TO EXPLORE
        </span>
        <!-- Gold Animated Mouse Line -->
        <div class="w-5 h-9 rounded-full border-2 border-[#c5a059]/60 flex justify-center pt-1.5 group-hover:border-[#c5a059] transition">
          <div class="w-1 h-2 bg-[#c5a059] rounded-full animate-bounce"></div>
        </div>
      </a>
    </div>

  </section>

  <!-- 5. MAIN HOTEL DIRECTORY GRID SECTION -->
  <section id="all-hotels" class="py-16 px-4 sm:px-6 lg:px-8 max-w-[1280px] mx-auto text-slate-800">
    
    <div class="flex justify-between items-end mb-8 border-b border-slate-200 pb-4">
      <div>
        <span class="text-xs font-black uppercase text-[#c5a059] tracking-wider">Official Directory</span>
        <h2 class="text-3xl sm:text-4xl font-black text-slate-900 font-['Playfair_Display']">
          Verified Gulshan Accommodations ({hotels.length})
        </h2>
      </div>
    </div>

    <!-- Hotel Cards Grid -->
    <div id="hotelsGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {hotels.map((hotel) => (
        <div 
          class="hotel-card bg-white rounded-2xl border border-slate-200 shadow-md hover:shadow-2xl hover:-translate-y-1 transition duration-300 overflow-hidden flex flex-col group"
          data-zone={hotel.zone}
          data-title={hotel.title.toLowerCase()}
        >
          <div class="h-56 w-full overflow-hidden relative">
            <img 
              src={hotel.image} 
              alt={hotel.title} 
              loading="lazy"
              decoding="async"
              class="w-full h-full object-cover group-hover:scale-105 transition duration-500" 
            />
            
            <div class="absolute top-3 left-3 bg-[#040c17]/90 text-[#c5a059] text-[10px] font-black uppercase px-2.5 py-1 rounded-md border border-[#c5a059]/40 backdrop-blur-md shadow">
              ✔ Verified Entry
            </div>

            <div class="absolute top-3 right-3 bg-slate-900/85 backdrop-blur-md text-amber-400 text-xs font-black px-2.5 py-1 rounded-md border border-slate-700 shadow-md">
              ★ {hotel.rating}
            </div>

            <div class="absolute bottom-3 left-3 bg-[#040c17]/90 text-slate-200 text-[10px] font-black uppercase px-2.5 py-1 rounded-md border border-[#c5a059]/40 backdrop-blur-md">
              {hotel.category}
            </div>
          </div>

          <div class="p-5 flex flex-col flex-1 justify-between">
            <div>
              <h3 class="font-['Playfair_Display'] text-xl font-bold text-slate-900 mb-2 group-hover:text-amber-700 transition">
                {hotel.title}
              </h3>

              <div class="flex items-center gap-1.5 text-xs text-slate-500 mb-6">
                <svg class="w-4 h-4 fill-[#c5a059] shrink-0" viewBox="0 0 24 24">
                  <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
                </svg>
                <span class="line-clamp-1">{hotel.location}</span>
              </div>
            </div>

            <div class="pt-4 border-t border-slate-100 flex items-center justify-between">
              <div>
                <span class="text-[10px] uppercase text-slate-400 font-extrabold block">Price Range</span>
                <span class="font-black text-slate-900 text-base">{hotel.price}</span>
              </div>

              <a href={`/${hotel.slug}`} class="bg-[#040c17] hover:bg-emerald-950 text-white font-extrabold text-xs px-4 py-2.5 rounded-xl shadow-md transition flex items-center gap-1">
                Compare Rates ➔
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>

  </section>

  <!-- CSS STYLES FOR GPU-ACCELERATED MICRO-ANIMATIONS -->
  <style>
    /* Window Glow Animation */
    @keyframes windowGlow {
      0%, 100% { opacity: 0.2; transform: scale(0.9); }
      50% { opacity: 0.9; transform: scale(1.1); }
    }

    .window-glow {
      animation: windowGlow 4s infinite ease-in-out;
    }
    .delay-1 { animation-delay: 1s; }
    .delay-2 { animation-delay: 2s; }
    .delay-3 { animation-delay: 2.5s; }
    .delay-4 { animation-delay: 3.5s; }

    /* Traffic Light Streak Animation */
    @keyframes trafficWhite {
      0% { transform: translateX(-200px); opacity: 0; }
      20% { opacity: 0.8; }
      80% { opacity: 0.8; }
      100% { transform: translateX(100vw); opacity: 0; }
    }

    @keyframes trafficRed {
      0% { transform: translateX(100vw); opacity: 0; }
      20% { opacity: 0.8; }
      80% { opacity: 0.8; }
      100% { transform: translateX(-200px); opacity: 0; }
    }

    .traffic-light-white {
      animation: trafficWhite 12s infinite linear;
    }
    .traffic-light-red {
      animation: trafficRed 15s infinite linear;
    }
  </style>

  <!-- JS SCRIPT FOR MOUSE PARALLAX, SCROLL SCALE & GLASS NAVBAR -->
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const heroBgImage = document.getElementById('heroBgImage');
      const mainNavbar = document.getElementById('mainNavbar');
      const mobileBtn = document.getElementById('mobile-menu-btn');
      const mobileMenu = document.getElementById('mobile-menu');

      // Mobile Menu Toggle
      if (mobileBtn && mobileMenu) {
        mobileBtn.addEventListener('click', () => {
          mobileMenu.classList.toggle('hidden');
        });
      }

      // 1. Mouse Movement Parallax (Capped at 15px max for natural luxury feel)
      window.addEventListener('mousemove', (e) => {
        if (!heroBgImage) return;
        const x = (e.clientX / window.innerWidth - 0.5) * 15;
        const y = (e.clientY / window.innerHeight - 0.5) * 15;
        heroBgImage.style.transform = `scale(1.05) translate3d(${x}px, ${y}px, 0)`;
      });

      // 2. Scroll Scale Animation (Apple Style 100% -> 108% Zoom + Glass Navbar)
      window.addEventListener('scroll', () => {
        const scrolled = window.scrollY;

        // Navbar Glassmorphism on scroll
        if (mainNavbar) {
          if (scrolled > 50) {
            mainNavbar.classList.add('bg-[#040c17]/85', 'backdrop-blur-xl', 'border-b', 'border-white/10', 'shadow-2xl');
            mainNavbar.classList.remove('py-4', 'sm:py-6');
            mainNavbar.classList.add('py-3');
          } else {
            mainNavbar.classList.remove('bg-[#040c17]/85', 'backdrop-blur-xl', 'border-b', 'border-white/10', 'shadow-2xl', 'py-3');
            mainNavbar.classList.add('py-4', 'sm:py-6');
          }
        }

        // Background Image Scale
        if (heroBgImage && scrolled < 800) {
          const scale = 1.05 + (scrolled / 800) * 0.08;
          heroBgImage.style.transform = `scale(${scale})`;
        }
      });
    });
  </script>

</Layout>
