---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

// ১. স্পন্সরড ডাটা লোড
let sponsorData = null;
try {
  const rawSponsor = import.meta.glob('../content/sponsored/*.md', { eager: true });
  const list = Object.values(rawSponsor);
  if (list && list.length > 0) {
    sponsorData = (list[0] as any).frontmatter;
  }
} catch (e) {
  sponsorData = null;
}

if (!sponsorData) {
  sponsorData = {
    enable: true,
    badge: "⭐ Editor's Choice",
    title: "The Westin Dhaka",
    category: "5-Star Luxury • Gulshan 2",
    rating: 4.8,
    image: "https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&w=800&q=80",
    buttonText: "Check Best Deal ➔",
    buttonLink: "/the-westin-dhaka"
  };
}

// ২. গুলশানের সব হোটেল কন্টেন্ট কালকশন থেকে লোড করা
let hotels: any[] = [];
try {
  const collectionData = await getCollection('hotels');
  if (collectionData && collectionData.length > 0) {
    hotels = collectionData.map((item: any) => ({
      slug: item.id || item.slug,
      title: item.data?.title || item.data?.name || 'Gulshan Hotel',
      category: item.data?.category || 'Luxury Hotel',
      location: item.data?.location || 'Gulshan 2, Dhaka',
      zone: (item.data?.location || '').toLowerCase().includes('gulshan 1') 
            ? 'gulshan-1' 
            : (item.data?.location || '').toLowerCase().includes('diplomatic') 
            ? 'diplomatic-zone' 
            : 'gulshan-2',
      price: item.data?.price || '$$$$',
      rating: item.data?.rating || 4.8,
      image: item.data?.image || 'https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&w=800&q=80',
    }));
  }
} catch (err) {
  hotels = [];
}

// ব্যাকআপ ডামি ডাটা (যদি ফোল্ডার ফাঁকা থাকে)
if (!hotels || hotels.length === 0) {
  hotels = [
    {
      slug: "the-westin-dhaka",
      title: "The Westin Dhaka",
      category: "5-Star Luxury",
      location: "Gulshan 2, Dhaka",
      zone: "gulshan-2",
      price: "$$$$",
      rating: 4.8,
      image: "https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&w=800&q=80",
    },
    {
      slug: "renaissance-dhaka-gulshan",
      title: "Renaissance Dhaka Gulshan Hotel",
      category: "5-Star Premium",
      location: "Gulshan 1, Dhaka",
      zone: "gulshan-1",
      price: "$$$$",
      rating: 4.7,
      image: "https://images.unsplash.com/photo-1582719478250-c89cae4dc85b?auto=format&fit=crop&w=800&q=80",
    },
    {
      slug: "amari-dhaka",
      title: "Amari Dhaka",
      category: "4-Star Boutique",
      location: "Gulshan 2, Dhaka",
      zone: "gulshan-2",
      price: "$$$",
      rating: 4.6,
      image: "https://images.unsplash.com/photo-1542314831-068cd1dbfeeb?auto=format&fit=crop&w=800&q=80",
    },
    {
      slug: "crowne-plaza-dhaka-gulshan",
      title: "Crowne Plaza Dhaka Gulshan",
      category: "5-Star Luxury",
      location: "Diplomatic Zone, Gulshan 2",
      zone: "diplomatic-zone",
      price: "$$$$",
      rating: 4.7,
      image: "https://images.unsplash.com/photo-1571896349842-33c89424de2d?auto=format&fit=crop&w=800&q=80",
    }
  ];
}
---

<Layout title="Gulshan Hotels - Official Directory & Travel Guide in Gulshan, Dhaka">
  
  <!-- HERO BANNER SECTION -->
  <section class="relative bg-slate-950 overflow-hidden text-white">
    <div class="absolute inset-0 w-full h-full">
      <img 
        src="/hero-gulshan.jpg" 
        alt="Gulshan Dhaka City Skyline Evening View" 
        class="w-full h-full object-cover opacity-35 scale-105 transform transition duration-1000" 
      />
      <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/60 to-slate-950/30"></div>
    </div>

    <div class="relative max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8 pt-16 pb-24 sm:pt-24 sm:pb-32 text-center">
      <div class="inline-flex items-center gap-2 bg-emerald-500/20 border border-emerald-500/40 text-emerald-300 text-xs font-bold uppercase tracking-widest px-3.5 py-1.5 rounded-full mb-6 backdrop-blur-md">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        Official Gulshan Accommodations Directory
      </div>

      <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black tracking-tight text-white leading-tight max-w-4xl mx-auto drop-shadow-md">
        Discover & Compare Hotels In <span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 to-teal-200">Gulshan, Dhaka</span>
      </h1>

      <p class="mt-4 text-sm sm:text-lg text-slate-300 max-w-2xl mx-auto font-normal leading-relaxed">
        Your unbiased local guide to luxury stays, business accommodations, and real-time deal comparison across Gulshan 1, Gulshan 2 & Diplomatic Zone.
      </p>

      <!-- Jump to Hotels CTA Button -->
      <div class="mt-8 flex justify-center">
        <a href="#all-hotels" class="bg-emerald-600 hover:bg-emerald-500 text-white font-black text-sm px-8 py-3.5 rounded-xl transition shadow-xl shadow-emerald-900/40 flex items-center gap-2">
          🔍 Browse All Hotels
        </a>
      </div>
    </div>

    <!-- Wave Divider -->
    <div class="absolute bottom-0 left-0 right-0 w-full overflow-hidden leading-none z-10 pointer-events-none">
      <svg class="relative block w-full h-8 sm:h-14 text-slate-50" viewBox="0 0 1200 120" preserveAspectRatio="none" fill="currentColor">
        <path d="M0,0 C150,90 350,-40 500,60 C650,160 900,10 1200,40 L1200,120 L0,120 Z"></path>
      </svg>
    </div>
  </section>

  <!-- WELCOME AUTHORITY & SPONSORED SHOWCASE -->
  <section class="bg-slate-50 py-10 px-4 sm:px-8 lg:px-12 border-b border-slate-200">
    <div class="max-w-[1600px] mx-auto grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
      
      <div class="lg:col-span-7 space-y-4 text-left">
        <div class="inline-block border-b-2 border-emerald-600 pb-1">
          <span class="text-xs font-black uppercase tracking-widest text-emerald-800">
            WELCOME TO GULSHANHOTELS.COM
          </span>
        </div>

        <h2 class="text-2xl sm:text-4xl font-black text-slate-900 tracking-tight leading-tight">
          Your Trusted Guide To Premium Hospitality
        </h2>

        <p class="text-slate-600 text-sm sm:text-base leading-relaxed">
          Gulshan is Dhaka’s most upscale neighborhood, known for its diplomatic district, 5-star luxury hotels, fine dining, and vibrant city life. Whether you're visiting for embassy appointments, international business, or leisure, we help you find the perfect hotel through unbiased reviews, real photos, and local insider tips.
        </p>

        <div class="hidden sm:grid grid-cols-2 sm:grid-cols-4 gap-4 pt-4 border-t border-slate-200">
          <div class="flex items-center space-x-2.5">
            <span class="text-xl">🔍</span>
            <div>
              <h3 class="text-xs font-bold text-slate-900">Expert Reviews</h3>
              <p class="text-[10px] text-slate-500">In-depth insights</p>
            </div>
          </div>

          <div class="flex items-center space-x-2.5">
            <span class="text-xl">📸</span>
            <div>
              <h3 class="text-xs font-bold text-slate-900">Real Photos</h3>
              <p class="text-[10px] text-slate-500">Authentic views</p>
            </div>
          </div>

          <div class="flex items-center space-x-2.5">
            <span class="text-xl">⚖️</span>
            <div>
              <h3 class="text-xs font-bold text-slate-900">Pros & Cons</h3>
              <p class="text-[10px] text-slate-500">Honest breakdowns</p>
            </div>
          </div>

          <div class="flex items-center space-x-2.5">
            <span class="text-xl">🤝</span>
            <div>
              <h3 class="text-xs font-bold text-slate-900">Unbiased Stays</h3>
              <p class="text-[10px] text-slate-500">Local recommendations</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Sponsored Hotel Card -->
      <div class="lg:col-span-5">
        {sponsorData && sponsorData.enable ? (
          <div class="relative rounded-2xl overflow-hidden shadow-xl border border-slate-200 group bg-slate-900">
            <img 
              src={sponsorData.image || "https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&w=800&q=80"} 
              alt={sponsorData.title} 
              class="w-full h-72 sm:h-80 object-cover group-hover:scale-105 transition-transform duration-500 opacity-90" 
            />
            <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/20 to-transparent"></div>

            <div class="absolute top-4 left-4 bg-amber-500 text-slate-950 text-[11px] font-black uppercase px-3 py-1 rounded-full shadow-md flex items-center space-x-1">
              <span>{sponsorData.badge || "⭐ Editor's Choice"}</span>
            </div>

            <div class="absolute bottom-4 left-4 right-4 text-white flex justify-between items-end">
              <div>
                <span class="text-[11px] font-extrabold text-emerald-300 bg-slate-950/80 px-2.5 py-0.5 rounded border border-emerald-500/40">
                  {sponsorData.category || "5-Star Luxury • Gulshan 2"}
                </span>
                <h3 class="text-2xl font-black text-white mt-1.5">{sponsorData.title}</h3>
                <p class="text-xs text-amber-400 font-bold mt-0.5">★ ★ ★ ★ ★ <span class="text-white ml-1">{sponsorData.rating || '4.8'}/5 Excellent</span></p>
              </div>

              <a 
                href={sponsorData.buttonLink || "#all-hotels"} 
                class="bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-extrabold px-4 py-2.5 rounded-lg shadow-lg transition shrink-0 ml-2"
              >
                {sponsorData.buttonText || "Check Best Deal ➔"}
              </a>
            </div>
          </div>
        ) : (
          <div class="bg-gradient-to-br from-emerald-900 to-slate-900 p-8 rounded-2xl border border-emerald-700/50 text-white text-center space-y-4 shadow-xl">
            <span class="bg-emerald-500/20 text-emerald-300 text-xs font-bold uppercase px-3 py-1 rounded-full border border-emerald-500/30">
              Sponsored Opportunity
            </span>
            <h3 class="text-2xl font-black text-white">Feature Your Hotel Here!</h3>
            <p class="text-xs text-slate-300">
              Reach over 25,000+ diplomats, tourists, and business travelers visiting Gulshan monthly. Get maximum visibility for your hotel.
            </p>
            <a href="/contact" class="inline-block bg-amber-500 hover:bg-amber-400 text-slate-950 font-black px-6 py-2.5 rounded-xl text-xs uppercase shadow transition">
              Contact For Sponsorship ➔
            </a>
          </div>
        )}
      </div>

    </div>
  </section>

  <!-- ALL GULSHAN HOTELS GRID WITH SEARCH & INTERACTIVE FILTER TABS -->
  <section id="all-hotels" class="py-16 px-4 sm:px-6 lg:px-8 max-w-[1280px] mx-auto">
    
    <!-- Header & Search Bar -->
    <div class="flex flex-col md:flex-row justify-between items-start md:items-end gap-4 mb-8">
      <div>
        <span class="text-xs font-black uppercase text-emerald-700 tracking-wider">Official Directory</span>
        <h2 class="text-3xl sm:text-4xl font-black text-slate-900">
          All Gulshan Hotels ({hotels.length})
        </h2>
        <p class="text-sm text-slate-500 mt-1">
          Explore all verified hotels in Gulshan 1, Gulshan 2, and Diplomatic Zone
        </p>
      </div>

      <!-- Live Search Box -->
      <div class="w-full md:w-72 relative">
        <input 
          type="text" 
          id="searchHotels" 
          placeholder="Search hotel name..." 
          class="w-full bg-white border border-slate-300 focus:border-emerald-500 focus:ring-2 focus:ring-emerald-200 rounded-xl px-4 py-2.5 text-xs text-slate-800 placeholder-slate-400 shadow-sm outline-none transition"
        />
        <span class="absolute right-3.5 top-2.5 text-slate-400 text-sm">🔍</span>
      </div>
    </div>

    <!-- Filter Pills/Tabs -->
    <div class="flex flex-wrap gap-2 mb-8 border-b border-slate-200 pb-4">
      <button 
        data-filter="all" 
        class="filter-tab active bg-emerald-600 text-white font-extrabold text-xs px-5 py-2.5 rounded-xl shadow transition"
      >
        All Hotels ({hotels.length})
      </button>
      <button 
        data-filter="gulshan-1" 
        class="filter-tab bg-white border border-slate-200 hover:bg-slate-100 text-slate-700 font-bold text-xs px-5 py-2.5 rounded-xl transition"
      >
        📍 Gulshan 1
      </button>
      <button 
        data-filter="gulshan-2" 
        class="filter-tab bg-white border border-slate-200 hover:bg-slate-100 text-slate-700 font-bold text-xs px-5 py-2.5 rounded-xl transition"
      >
        📍 Gulshan 2
      </button>
      <button 
        data-filter="diplomatic-zone" 
        class="filter-tab bg-white border border-slate-200 hover:bg-slate-100 text-slate-700 font-bold text-xs px-5 py-2.5 rounded-xl transition"
      >
        🏛️ Diplomatic Zone
      </button>
    </div>

    <!-- Hotel Cards Grid -->
    <div id="hotelsGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {hotels.map((hotel) => (
        <div 
          class="hotel-card bg-white rounded-2xl border border-slate-200 shadow-sm hover:shadow-xl hover:-translate-y-1 transition duration-300 overflow-hidden flex flex-col group"
          data-zone={hotel.zone}
          data-title={hotel.title.toLowerCase()}
        >
          <div class="h-56 w-full overflow-hidden relative">
            <img 
              src={hotel.image} 
              alt={hotel.title} 
              class="w-full h-full object-cover group-hover:scale-105 transition duration-500" 
            />
            <div class="absolute top-3 right-3 bg-slate-900/85 backdrop-blur-md text-amber-400 text-xs font-black px-2.5 py-1 rounded-md border border-slate-700 shadow-md">
              ★ {hotel.rating}
            </div>
            <div class="absolute bottom-3 left-3 bg-emerald-900/90 text-emerald-200 text-[10px] font-black uppercase px-2.5 py-1 rounded-md border border-emerald-500/40 backdrop-blur-md">
              {hotel.category}
            </div>
          </div>

          <div class="p-5 flex flex-col flex-1 justify-between">
            <div>
              <h3 class="font-serif text-xl font-bold text-slate-900 mb-2 group-hover:text-emerald-700 transition">
                {hotel.title}
              </h3>

              <div class="flex items-center gap-1.5 text-xs text-slate-500 mb-6">
                <svg class="w-4 h-4 fill-emerald-600 shrink-0" viewBox="0 0 24 24">
                  <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
                </svg>
                <span class="line-clamp-1">{hotel.location}</span>
              </div>
            </div>

            <div class="pt-4 border-t border-slate-100 flex items-center justify-between">
              <div>
                <span class="text-[10px] uppercase text-slate-400 font-extrabold block">Price Range</span>
                <span class="font-black text-slate-900 text-base">{hotel.price}</span>
              </div>

              <a 
                href={`/${hotel.slug}`} 
                class="bg-emerald-600 hover:bg-emerald-500 text-white font-extrabold text-xs px-4 py-2.5 rounded-xl shadow-md transition flex items-center gap-1"
              >
                View Details ➔
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Empty Result State -->
    <div id="noResults" class="hidden text-center py-16 bg-slate-50 rounded-2xl border border-dashed border-slate-300 mt-6">
      <span class="text-4xl">🏨</span>
      <h3 class="text-lg font-bold text-slate-800 mt-2">No hotels found</h3>
      <p class="text-xs text-slate-500 mt-1">Try clearing your search or selecting a different filter.</p>
    </div>

  </section>

  <!-- INSTANT CLIENT-SIDE FILTER & SEARCH SCRIPT -->
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const tabs = document.querySelectorAll('.filter-tab');
      const cards = document.querySelectorAll('.hotel-card');
      const searchInput = document.getElementById('searchHotels') as HTMLInputElement;
      const noResults = document.getElementById('noResults');

      let currentFilter = 'all';

      function filterHotels() {
        const query = searchInput ? searchInput.value.toLowerCase().trim() : '';
        let visibleCount = 0;

        cards.forEach((card) => {
          const el = card as HTMLElement;
          const zone = el.getAttribute('data-zone');
          const title = el.getAttribute('data-title') || '';

          const matchesFilter = currentFilter === 'all' || zone === currentFilter;
          const matchesSearch = query === '' || title.includes(query);

          if (matchesFilter && matchesSearch) {
            el.style.display = 'flex';
            visibleCount++;
          } else {
            el.style.display = 'none';
          }
        });

        if (noResults) {
          if (visibleCount === 0) {
            noResults.classList.remove('hidden');
          } else {
            noResults.classList.add('hidden');
          }
        }
      }

      tabs.forEach((tab) => {
        tab.addEventListener('click', () => {
          tabs.forEach((t) => {
            t.classList.remove('bg-emerald-600', 'text-white', 'shadow');
            t.classList.add('bg-white', 'border', 'border-slate-200', 'text-slate-700');
          });

          tab.classList.remove('bg-white', 'border', 'border-slate-200', 'text-slate-700');
          tab.classList.add('bg-emerald-600', 'text-white', 'shadow');

          currentFilter = tab.getAttribute('data-filter') || 'all';
          filterHotels();
        });
      });

      if (searchInput) {
        searchInput.addEventListener('input', filterHotels);
      }
    });
  </script>

</Layout>
