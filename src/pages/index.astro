---
// src/pages/index.astro (Clean & Optimized)
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import WelcomeSection from '../components/WelcomeSection.astro';
import PopularHotels from '../components/PopularHotels.astro';
import GulshanSeoGuide from '../components/GulshanSeoGuide.astro';
import { getCollection, getEntry } from 'astro:content';

// 1. Fetch Homepage Settings from CMS
let homepageConfig: any = {};

try {
  const globFiles = import.meta.glob('../content/homepage/*.md', { eager: true });
  const fileList: any[] = Object.values(globFiles);
  if (fileList.length > 0) {
    homepageConfig = fileList[0]?.frontmatter || fileList[0]?.data || {};
  }
} catch (e) {
  console.warn('Homepage eager glob import fallback...', e);
}

// Fallback
if (!homepageConfig || Object.keys(homepageConfig).length === 0) {
  try {
    const homepageEntry = (await getEntry('homepage', 'popular-hotels')) || (await getEntry('homepage', 'popular_hotels'));
    homepageConfig = homepageEntry?.data || {};
  } catch (e) {
    try {
      const col = await getCollection('homepage');
      if (col && col.length > 0) {
        homepageConfig = col[0]?.data || {};
      }
    } catch (err) {}
  }
}

const showPopularSection = homepageConfig.enable_popular_hotels !== false;
---

<Layout title="Gulshan Hotels — Best 5-Star & Luxury Hotels in Gulshan, Dhaka">
  <!-- 1. HERO BANNER -->
  <Hero />

  <!-- 2. WELCOME SECTION -->
  <WelcomeSection />

  <!-- 3. POPULAR HOTELS SECTION (Synced with Real Reviews & CMS) -->
  {showPopularSection && (
    <PopularHotels 
      title={homepageConfig.popular_hotels_title} 
      subtitle={homepageConfig.popular_hotels_subtitle}
      featuredHotels={homepageConfig.featured_hotels}
    />
  )}

  <!-- 4. GULSHAN SEO & WHY STAY IN GULSHAN GUIDE SECTION -->
  <GulshanSeoGuide />
</Layout>
