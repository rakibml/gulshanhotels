---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

// ১. স্পন্সরড ডাটা লোড
let sponsorData = null;
try {
  const rawSponsor = import.meta.glob('../content/sponsored/*.md', { eager: true });
  const list = Object.values(rawSponsor);
  if (list && list.length > 0) {
    sponsorData = (list[0] as any).frontmatter;
  }
} catch (e) {
  sponsorData = null;
}

if (!sponsorData) {
  sponsorData = {
    enable: true,
    badge: "⭐ Editor's Choice",
    title: "The Westin Dhaka",
    category: "5-Star Luxury • Gulshan 2",
    rating: 4.8,
    image: "https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&w=800&q=80",
    buttonText: "Check Best Deal ➔",
    buttonLink: "/the-westin-dhaka"
  };
}

function toTitleCase(str: string) {
  if (!str) return 'Gulshan Hotel';
  return str.replace(/\w\S*/g, (txt) => txt.charAt(0).toUpperCase() + txt.substr(1).toLowerCase());
}

// ২. গুলশানের সব ভেরিফাইড হোটেল লোড করা
let hotels: any[] = [];
try {
  const collectionData = await getCollection('hotels');
  if (collectionData && collectionData.length > 0) {
    hotels = collectionData.map((item: any) => ({
      slug: item.id || item.slug,
      title: toTitleCase(item.data?.title || item.data?.name || 'Gulshan Hotel'),
      category: item.data?.category || 'Luxury Hotel',
      location: item.data?.location || 'Gulshan 2, Dhaka',
      zone: (item.data?.location || '').toLowerCase().includes('gulshan 1') 
            ? 'gulshan-1' 
            : (item.data?.location || '').toLowerCase().includes('banani')
            ? 'banani'
            : 'gulshan-2',
      price: item.data?.price || '$$$$',
      rating: item.data?.rating || 4.8,
      image: item.data?.image || 'https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&w=800&q=80',
    }));
  }
} catch (err) {
  hotels = [];
}
---

<Layout title="Gulshan Hotels - Official Destination Authority & Accommodations Guide">
  
  <!-- HERO SECTION: GATLINBURG TOURISM BOARD STYLE -->
  <section class="relative min-h-[90vh] sm:min-h-screen bg-slate-950 text-white overflow-hidden rounded-b-3xl sm:rounded-b-[40px] shadow-2xl">
    
    <!-- Video / High-Impact Background Image -->
    <div class="absolute inset-0 w-full h-full">
      <video 
        id="heroVideo"
        autoplay 
        loop 
        muted 
        playsinline
        poster="/hero-gulshan.jpg"
        class="w-full h-full object-cover opacity-60 scale-105 transition duration-1000"
      >
        <source src="https://assets.mixkit.co/videos/preview/mixkit-city-traffic-at-night-4034-large.mp4" type="video/mp4" />
      </video>

      <!-- Gradient Dark Overlay for Typography Readability -->
      <div class="absolute inset-0 bg-gradient-to-b from-slate-950/80 via-slate-950/40 to-slate-950/90"></div>
    </div>

    <!-- OVERLAY HEADER & NAVIGATION (MATCHING GATLINBURG HEADER) -->
    <header class="relative z-20 max-w-[1400px] mx-auto px-4 sm:px-8 pt-6">
      
      <!-- Top Row Utility Links -->
      <div class="flex items-center justify-between border-b border-white/10 pb-3">
        <!-- Logo -->
        <a href="/" class="flex items-center gap-3 group">
          <div class="w-12 h-12 rounded-xl bg-emerald-600 border border-emerald-400/50 flex items-center justify-center font-black text-xl text-white shadow-lg group-hover:scale-105 transition">
            🏛️
          </div>
          <div>
            <span class="block font-black tracking-wider text-lg leading-none text-white font-serif">GULSHAN</span>
            <span class="text-[10px] uppercase font-bold tracking-widest text-emerald-400">DHAKA • BANGLADESH</span>
          </div>
        </a>

        <!-- Right Utilities -->
        <div class="flex items-center gap-4 sm:gap-6 text-xs font-bold text-slate-200">
          <a href="#about" class="hidden md:inline-block hover:text-emerald-400 transition">Diplomatic Guide</a>
          <a href="#blog" class="hidden md:inline-block hover:text-emerald-400 transition">Blog</a>
          
          <!-- Live Weather Widget -->
          <div class="hidden sm:flex items-center gap-1.5 bg-white/10 backdrop-blur-md px-3 py-1.5 rounded-full border border-white/15">
            <span class="text-sm">🌤️</span>
            <span>29.5°C Dhaka</span>
          </div>

          <!-- Wishlist Badge -->
          <a href="#saved" class="flex items-center gap-1 hover:text-emerald-400 transition">
            <span class="text-amber-400">🧡</span>
            <span>(0) My Trip</span>
          </a>

          <!-- Search Button (Gatlinburg Style Green Capsule) -->
          <a href="#all-hotels" class="bg-emerald-600 hover:bg-emerald-500 text-white font-black px-4 py-2 rounded-full shadow-lg transition flex items-center gap-1.5 text-xs">
            <span>Search</span>
            <span>🔍</span>
          </a>
        </div>
      </div>

      <!-- Main Navigation Menu Links (All Caps Gatlinburg Style) -->
      <nav class="hidden lg:flex items-center justify-center gap-8 pt-4 text-xs font-black tracking-widest uppercase text-slate-100">
        <a href="#all-hotels" class="hover:text-emerald-400 transition border-b-2 border-transparent hover:border-emerald-400 pb-1">PLACES TO STAY</a>
        <a href="#things-to-do" class="hover:text-emerald-400 transition border-b-2 border-transparent hover:border-emerald-400 pb-1">THINGS TO DO</a>
        <a href="#dining" class="hover:text-emerald-400 transition border-b-2 border-transparent hover:border-emerald-400 pb-1">FOOD & DRINK</a>
        <a href="#embassies" class="hover:text-emerald-400 transition border-b-2 border-transparent hover:border-emerald-400 pb-1">EMBASSIES</a>
        <a href="#diplomatic-zone" class="hover:text-emerald-400 transition border-b-2 border-transparent hover:border-emerald-400 pb-1">DIPLOMATIC ZONE</a>
        <a href="#plan" class="hover:text-emerald-400 transition border-b-2 border-transparent hover:border-emerald-400 pb-1">PLAN YOUR VISIT</a>
      </nav>

    </header>

    <!-- CENTER HERO TYPOGRAPHY (BOLD GATLINBURG STYLE) -->
    <div class="relative z-10 max-w-[1280px] mx-auto px-4 text-center my-auto pt-16 pb-20 sm:pt-24 sm:pb-32 flex flex-col items-center justify-center">
      
      <!-- Main Custom Styled Bold Headline -->
      <h1 class="text-4xl sm:text-7xl lg:text-8xl font-black uppercase tracking-tight text-white leading-none font-serif drop-shadow-2xl select-none">
        GULSHAN IS <br class="hidden sm:inline" />
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 via-teal-200 to-amber-300">CALLING</span>
      </h1>

      <p class="mt-6 text-sm sm:text-xl text-slate-200 max-w-2xl font-normal leading-relaxed drop-shadow">
        The Official Accommodations & Local Travel Directory for Gulshan 1, Gulshan 2 & Diplomatic Zone, Dhaka.
      </p>

      <!-- Quick Category Pills -->
      <div class="mt-8 flex flex-wrap justify-center gap-2 sm:gap-3">
        <a href="#all-hotels" class="bg-emerald-600 hover:bg-emerald-500 text-white font-extrabold text-xs sm:text-sm px-6 py-3 rounded-full transition shadow-xl">
          Explore All Hotels ➔
        </a>
        <a href="#diplomatic-zone" class="bg-white/10 hover:bg-white/20 border border-white/20 text-white font-extrabold text-xs sm:text-sm px-6 py-3 rounded-full transition backdrop-blur-md">
          🏛️ Diplomatic Zone
        </a>
      </div>

    </div>

    <!-- BOTTOM RIGHT CONTROLS (PLAY/PAUSE & MUTE BUTTONS LIKE GATLINBURG) -->
    <div class="absolute bottom-6 right-6 z-20 flex items-center gap-2">
      <button 
        id="toggleVideo" 
        aria-label="Pause Video"
        class="w-10 h-10 rounded-full bg-emerald-600/80 hover:bg-emerald-500 text-white border border-emerald-400/40 backdrop-blur-md flex items-center justify-center text-xs shadow-lg transition"
      >
        ⏸
      </button>
      <button 
        id="toggleMute" 
        aria-label="Toggle Sound"
        class="w-10 h-10 rounded-full bg-emerald-600/80 hover:bg-emerald-500 text-white border border-emerald-400/40 backdrop-blur-md flex items-center justify-center text-xs shadow-lg transition"
      >
        🔊
      </button>
    </div>

  </section>

  <!-- FLOATING FILTER CONSOLE -->
  <div class="relative z-20 -mt-8 max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8">
    <div class="bg-white rounded-2xl sm:rounded-full border border-slate-200 shadow-2xl p-2.5 flex items-center justify-between gap-2 overflow-x-auto [scrollbar-width:none] [-ms-overflow-style:none] [&::-webkit-scrollbar]:hidden">
      
      <div class="flex items-center gap-2 shrink-0 w-full sm:w-auto overflow-x-auto">
        <button data-filter="all" class="filter-pill active bg-[#052e16] text-white font-black text-xs sm:text-sm px-5 py-2.5 rounded-full transition flex items-center gap-2 shrink-0 shadow-md">
          <span>🏢 All Gulshan Hotels ({hotels.length})</span>
        </button>

        <button data-filter="gulshan-1" class="filter-pill bg-white border border-slate-200 hover:bg-slate-50 text-slate-800 font-bold text-xs sm:text-sm px-5 py-2.5 rounded-full transition flex items-center gap-2 shrink-0">
          <span>📍 Gulshan 1</span>
        </button>

        <button data-filter="gulshan-2" class="filter-pill bg-white border border-slate-200 hover:bg-slate-50 text-slate-800 font-bold text-xs sm:text-sm px-5 py-2.5 rounded-full transition flex items-center gap-2 shrink-0">
          <span>📍 Gulshan 2</span>
        </button>

        <button data-filter="banani" class="filter-pill bg-white border border-slate-200 hover:bg-slate-50 text-slate-800 font-bold text-xs sm:text-sm px-5 py-2.5 rounded-full transition flex items-center gap-2 shrink-0">
          <span>🏛️ Diplomatic Zone</span>
        </button>
      </div>

    </div>
  </div>

  <!-- MAIN HOTEL DIRECTORY GRID -->
  <section id="all-hotels" class="py-16 px-4 sm:px-6 lg:px-8 max-w-[1280px] mx-auto">
    
    <div class="flex justify-between items-end mb-8 border-b border-slate-200 pb-4">
      <div>
        <span class="text-xs font-black uppercase text-emerald-800 tracking-wider">Official Accommodations</span>
        <h2 class="text-3xl sm:text-4xl font-black text-slate-900 font-serif">
          Gulshan Hotels Directory ({hotels.length})
        </h2>
      </div>
    </div>

    <!-- Hotel Cards Grid -->
    <div id="hotelsGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {hotels.map((hotel) => (
        <div 
          class="hotel-card bg-white rounded-2xl border border-slate-200 shadow-md hover:shadow-2xl hover:-translate-y-1 transition duration-300 overflow-hidden flex flex-col group"
          data-zone={hotel.zone}
          data-title={hotel.title.toLowerCase()}
        >
          <div class="h-56 w-full overflow-hidden relative">
            <img src={hotel.image} alt={hotel.title} class="w-full h-full object-cover group-hover:scale-105 transition duration-500" />
            
            <div class="absolute top-3 left-3 bg-slate-950/90 text-emerald-300 text-[10px] font-black uppercase px-2.5 py-1 rounded-md border border-emerald-500/40 backdrop-blur-md shadow">
              ✔ Verified Entry
            </div>

            <div class="absolute top-3 right-3 bg-slate-900/85 backdrop-blur-md text-amber-400 text-xs font-black px-2.5 py-1 rounded-md border border-slate-700 shadow-md">
              ★ {hotel.rating}
            </div>

            <div class="absolute bottom-3 left-3 bg-emerald-950/90 text-emerald-300 text-[10px] font-black uppercase px-2.5 py-1 rounded-md border border-emerald-500/40 backdrop-blur-md">
              {hotel.category}
            </div>
          </div>

          <div class="p-5 flex flex-col flex-1 justify-between">
            <div>
              <h3 class="font-serif text-xl font-bold text-slate-900 mb-2 group-hover:text-emerald-700 transition">
                {hotel.title}
              </h3>

              <div class="flex items-center gap-1.5 text-xs text-slate-500 mb-6">
                <svg class="w-4 h-4 fill-emerald-600 shrink-0" viewBox="0 0 24 24">
                  <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
                </svg>
                <span class="line-clamp-1">{hotel.location}</span>
              </div>
            </div>

            <div class="pt-4 border-t border-slate-100 flex items-center justify-between">
              <div>
                <span class="text-[10px] uppercase text-slate-400 font-extrabold block">Price Range</span>
                <span class="font-black text-slate-900 text-base">{hotel.price}</span>
              </div>

              <a href={`/${hotel.slug}`} class="bg-emerald-600 hover:bg-emerald-500 text-white font-extrabold text-xs px-4 py-2.5 rounded-xl shadow-md transition flex items-center gap-1">
                Compare Rates ➔
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>

  </section>

  <!-- VIDEO CONTROLS SCRIPT -->
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const video = document.getElementById('heroVideo') as HTMLVideoElement;
      const toggleVideo = document.getElementById('toggleVideo');
      const toggleMute = document.getElementById('toggleMute');

      if (video && toggleVideo) {
        toggleVideo.addEventListener('click', () => {
          if (video.paused) {
            video.play();
            toggleVideo.innerText = '⏸';
          } else {
            video.pause();
            toggleVideo.innerText = '▶';
          }
        });
      }

      if (video && toggleMute) {
        toggleMute.addEventListener('click', () => {
          video.muted = !video.muted;
          toggleMute.innerText = video.muted ? '🔊' : '🔇';
        });
      }
    });
  </script>

</Layout>
