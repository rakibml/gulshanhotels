---
const totalHotels = Astro.props.totalHotels ?? 150;
---

<section class="relative h-[100vh] min-h-[720px] overflow-hidden">

  <!-- Background Video -->
  <video
    autoplay
    muted
    loop
    playsinline
    class="absolute inset-0 w-full h-full object-cover"
  >
    <source src="/videos/gulshan-hero.mp4" type="video/mp4" />
  </video>

  <!-- Overlay -->
  <div class="absolute inset-0 bg-black/35"></div>

  <!-- Navbar -->
  <header class="absolute top-0 left-0 right-0 z-30">
    <div class="max-w-7xl mx-auto px-6 py-6 flex items-center justify-between">

      <a href="/" class="text-white text-2xl font-bold">
        Gulshan Hotels
      </a>

      <nav class="hidden lg:flex gap-8 text-white text-sm">
        <a href="#">Hotels</a>
        <a href="#">Luxury</a>
        <a href="#">Business</a>
        <a href="#">Contact</a>
      </nav>

    </div>
  </header>

  <!-- Hero Content -->

  <div class="relative z-20 h-full flex items-center">

    <div class="max-w-7xl mx-auto px-6 w-full">

      <div class="max-w-3xl">

        <span class="uppercase tracking-[5px] text-white/80 text-sm">
          Luxury Hotel Directory
        </span>

        <h1 class="mt-5 text-5xl md:text-7xl font-bold text-white leading-tight">
          Explore All
          <br />
          Gulshan Hotels
        </h1>

        <p class="mt-6 text-xl text-white/80 max-w-xl">
          Discover luxury, boutique and business hotels
          across Gulshan with exclusive deals and trusted reviews.
        </p>

      </div>

      <!-- Search Card -->

      <div class="mt-16 bg-white rounded-3xl shadow-2xl p-6">

        <div class="grid lg:grid-cols-5 gap-5">

          <input
            placeholder="Destination"
            class="border rounded-xl px-4 py-4"
          />

          <input
            placeholder="Check In"
            class="border rounded-xl px-4 py-4"
          />

          <input
            placeholder="Check Out"
            class="border rounded-xl px-4 py-4"
          />

          <input
            placeholder="Guests"
            class="border rounded-xl px-4 py-4"
          />

          <button
            class="rounded-xl bg-black text-white font-semibold hover:bg-[#C8A96A] hover:text-black transition"
          >
            Search Hotels
          </button>

        </div>

      </div>

      <!-- Trust -->

      <div class="mt-8 flex flex-wrap gap-8 text-white/90 text-sm">

        <span>⭐ {totalHotels}+ Hotels</span>

        <span>✔ Verified Hotels</span>

        <span>💰 Best Price</span>

        <span>🛎 24/7 Support</span>

      </div>

    </div>

  </div>

</section>