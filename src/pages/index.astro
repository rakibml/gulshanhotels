---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import WelcomeSection from '../components/WelcomeSection.astro';
import PopularHotels from '../components/PopularHotels.astro';
import { getCollection } from 'astro:content';

let hotels: any[] = [];

// ১. Astro Content Collections থেকে আপনার আসল ডাটা লোড
try {
  const collectionData = await getCollection('hotels');
  if (collectionData && collectionData.length > 0) {
    hotels = collectionData.map((item: any) => ({
      ...item.data,
      slug: item.id?.replace(/\.md$/, '') || item.slug || 'hotel',
    }));
  }
} catch (err) {
  hotels = [];
}

// ২. ফাইল স্ক্যানার (NO DEMO BACKUP DATA)
if (!hotels || hotels.length === 0) {
  try {
    const rawGlob = import.meta.glob('../content/hotels/*.md', { eager: true });
    const globList = Object.entries(rawGlob);
    if (globList && globList.length > 0) {
      hotels = globList.map(([filePath, item]: [string, any]) => {
        const filename = filePath.split('/').pop()?.replace('.md', '') || 'hotel';
        const fm = item.frontmatter || {};
        return {
          ...fm,
          slug: fm.slug || filename,
        };
      });
    }
  } catch (err) {
    hotels = [];
  }
}

function toTitleCase(str: string) {
  if (!str) return 'Gulshan Hotel';
  return str.replace(/\w\S*/g, (txt) => txt.charAt(0).toUpperCase() + txt.substr(1).toLowerCase());
}

// শুধুমাত্র আপনার তৈরি করা আসল ফাইল রেন্ডার হবে
const popularHotels = hotels.map((h: any) => ({
  ...h,
  title: toTitleCase(h.title || 'Hotel')
}));
---

<Layout title="GulshanHotels.com - Verified Gulshan Hotel Audits & Local Guides">
  <!-- 1. HERO SECTION -->
  <Hero />

  <!-- 2. WELCOME AUTHORITY SECTION -->
  <WelcomeSection />

  <!-- 3. POPULAR HOTELS CAROUSEL SECTION -->
  <PopularHotels popularHotels={popularHotels} />
</Layout>
