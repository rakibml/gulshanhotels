---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

// ১. স্পন্সরড ডাটা লোড
let sponsorData = null;
try {
  const rawSponsor = import.meta.glob('../content/sponsored/*.md', { eager: true });
  const list = Object.values(rawSponsor);
  if (list && list.length > 0) {
    sponsorData = (list[0] as any).frontmatter;
  }
} catch (e) {
  sponsorData = null;
}

if (!sponsorData) {
  sponsorData = {
    enable: true,
    badge: "⭐ Editor's Choice",
    title: "The Westin Dhaka",
    category: "5-Star Luxury • Gulshan 2",
    rating: 4.8,
    image: "https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&w=800&q=80",
    buttonText: "Check Best Deal ➔",
    buttonLink: "/the-westin-dhaka"
  };
}

function toTitleCase(str: string) {
  if (!str) return 'Gulshan Hotel';
  return str.replace(/\w\S*/g, (txt) => txt.charAt(0).toUpperCase() + txt.substr(1).toLowerCase());
}

// ২. গুলশানের সব ভেরিফাইড হোটেল লোড করা
let hotels: any[] = [];
try {
  const collectionData = await getCollection('hotels');
  if (collectionData && collectionData.length > 0) {
    hotels = collectionData.map((item: any) => ({
      slug: item.id || item.slug,
      title: toTitleCase(item.data?.title || item.data?.name || 'Gulshan Hotel'),
      category: item.data?.category || 'Luxury Hotel',
      location: item.data?.location || 'Gulshan 2, Dhaka',
      zone: (item.data?.location || '').toLowerCase().includes('gulshan 1') 
            ? 'gulshan-1' 
            : (item.data?.location || '').toLowerCase().includes('banani')
            ? 'banani'
            : 'gulshan-2',
      price: item.data?.price || '$$$$',
      rating: item.data?.rating || 4.8,
      image: item.data?.image || 'https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&w=800&q=80',
    }));
  }
} catch (err) {
  hotels = [];
}

if (!hotels || hotels.length === 0) {
  hotels = [
    {
      slug: "the-westin-dhaka",
      title: "The Westin Dhaka",
      category: "5-Star Luxury",
      location: "Gulshan 2, Dhaka",
      zone: "gulshan-2",
      price: "$$$$",
      rating: 4.8,
      image: "https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&w=800&q=80",
    },
    {
      slug: "renaissance-dhaka-gulshan",
      title: "Renaissance Dhaka Gulshan Hotel",
      category: "5-Star Premium",
      location: "Gulshan 1, Dhaka",
      zone: "gulshan-1",
      price: "$$$$",
      rating: 4.7,
      image: "https://images.unsplash.com/photo-1582719478250-c89cae4dc85b?auto=format&fit=crop&w=800&q=80",
    },
    {
      slug: "amari-dhaka",
      title: "Amari Dhaka",
      category: "4-Star Boutique",
      location: "Gulshan 2, Dhaka",
      zone: "gulshan-2",
      price: "$$$",
      rating: 4.6,
      image: "https://images.unsplash.com/photo-1542314831-068cd1dbfeeb?auto=format&fit=crop&w=800&q=80",
    },
    {
      slug: "hotel-sarina-banani",
      title: "Hotel Sarina Dhaka",
      category: "5-Star Luxury",
      location: "Banani, Dhaka",
      zone: "banani",
      price: "$$$$",
      rating: 4.7,
      image: "https://images.unsplash.com/photo-1571896349842-33c89424de2d?auto=format&fit=crop&w=800&q=80",
    }
  ];
}
---

<Layout title="Gulshan Hotels — Official Directory & Best Hotel Deals in Gulshan, Dhaka">
  
  <!-- HERO BANNER SECTION (SEO RANKING TITLE & YOUR IMAGE) -->
  <section class="relative bg-slate-900 text-white min-h-[440px] sm:min-h-[520px] flex flex-col justify-center overflow-hidden pb-16 sm:pb-20 pt-12 sm:pt-16">
    
    <!-- HERO IMAGE LOCATION: Place your image at public/hero-gulshan.jpg -->
    <div class="absolute inset-0 w-full h-full">
      <img 
        src="/hero-gulshan.jpg" 
        onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1512917774080-9991f1c4c750?auto=format&fit=crop&w=2000&q=85';"
        alt="Gulshan Hotels Dhaka City View" 
        class="w-full h-full object-cover opacity-85 scale-105" 
      />
      <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/40 to-slate-950/20"></div>
    </div>

    <!-- Hero Content -->
    <div class="relative z-10 max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-4 sm:space-y-5 my-auto">
      
      <!-- Verified Badge -->
      <div class="inline-flex items-center gap-2 bg-emerald-600/90 border border-emerald-400/50 text-white text-xs font-black uppercase tracking-widest px-4 py-1.5 rounded-full shadow-lg backdrop-blur-md">
        <span class="w-2 h-2 rounded-full bg-emerald-300 animate-pulse"></span>
        Official Accommodations Directory
      </div>

      <!-- MAIN SEO H1 TITLE FOR RANKING "GULSHAN HOTELS" -->
      <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black tracking-tight text-white leading-tight max-w-4xl mx-auto font-serif drop-shadow-lg">
        Gulshan Hotels — <span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 via-teal-200 to-amber-300">Find & Compare Stays</span>
      </h1>

      <p class="text-xs sm:text-base text-slate-200 max-w-2xl mx-auto font-normal leading-relaxed drop-shadow">
        Compare live prices from Agoda, Booking.com & official hotel sites in Gulshan 1, Gulshan 2 & Diplomatic Zone.
      </p>

    </div>

    <!-- Bottom Wave Separator -->
    <div class="absolute bottom-0 left-0 right-0 w-full overflow-hidden leading-none z-10 pointer-events-none">
      <svg class="relative block w-full h-10 sm:h-16 text-slate-50" viewBox="0 0 1200 120" preserveAspectRatio="none" fill="currentColor">
        <path d="M0,0 C150,90 350,-40 500,60 C650,160 900,10 1200,40 L1200,120 L0,120 Z"></path>
      </svg>
    </div>
  </section>

  <!-- FLOATING SEARCH & FILTER CONSOLE -->
  <div class="relative z-20 -mt-8 sm:-mt-12 max-w-[1300px] mx-auto px-4 sm:px-6 lg:px-8">
    <div class="bg-white rounded-3xl border border-slate-200 shadow-2xl p-4 sm:p-6 space-y-4 text-slate-800">
      
      <!-- Zone Navigation Buttons (Exact Request) -->
      <div class="flex flex-wrap items-center justify-center sm:justify-start gap-2 border-b border-slate-100 pb-3">
        <span class="text-xs font-black uppercase text-slate-400 mr-2 shrink-0">Filter Zone:</span>
        <button data-filter="all" class="filter-tab active bg-emerald-700 text-white font-extrabold text-xs px-4 py-2 rounded-full transition shadow">
          🏢 All Gulshan Hotels ({hotels.length})
        </button>
        <button data-filter="gulshan-1" class="filter-tab bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-xs px-4 py-2 rounded-full transition">
          📍 Gulshan 1 Hotels
        </button>
        <button data-filter="gulshan-2" class="filter-tab bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-xs px-4 py-2 rounded-full transition">
          📍 Gulshan 2 Hotels
        </button>
        <button data-filter="banani" class="filter-tab bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-xs px-4 py-2 rounded-full transition">
          🏛️ Banani Hotels
        </button>
      </div>

      <!-- Live Search Box -->
      <div class="flex flex-col sm:flex-row items-center gap-3">
        <div class="relative w-full">
          <input 
            type="text" 
            id="searchHotels" 
            placeholder="Type hotel name (e.g. Westin, Amari, Renaissance)..." 
            class="w-full bg-slate-50 border border-slate-300 focus:border-emerald-600 focus:bg-white rounded-2xl px-4 py-3.5 text-xs sm:text-sm text-slate-900 placeholder-slate-400 outline-none transition shadow-inner"
          />
          <span class="absolute right-4 top-3.5 text-slate-400 text-base">🔍</span>
        </div>

        <a href="#all-hotels" class="w-full sm:w-auto bg-emerald-700 hover:bg-emerald-800 text-white font-black text-xs sm:text-sm px-8 py-3.5 rounded-2xl transition shrink-0 shadow-lg flex items-center justify-center gap-2">
          <span>Search Hotels</span>
          <span>➔</span>
        </a>
      </div>

    </div>
  </div>

  <!-- TRUST & AUTHORITY PILLARS BAR -->
  <section class="pt-10 sm:pt-12 pb-8 px-4 sm:px-6 lg:px-8 max-w-[1280px] mx-auto">
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4">
      
      <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-sm flex items-center gap-3">
        <span class="text-2xl p-2 bg-emerald-50 text-emerald-700 rounded-xl">🛡️</span>
        <div>
          <h3 class="text-xs font-black text-slate-900 uppercase">100% Verified</h3>
          <p class="text-[10px] text-slate-500">Physically inspected stays</p>
        </div>
      </div>

      <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-sm flex items-center gap-3">
        <span class="text-2xl p-2 bg-emerald-50 text-emerald-700 rounded-xl">⚡</span>
        <div>
          <h3 class="text-xs font-black text-slate-900 uppercase">Live Price Match</h3>
          <p class="text-[10px] text-slate-500">Agoda, Booking & Direct</p>
        </div>
      </div>

      <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-sm flex items-center gap-3">
        <span class="text-2xl p-2 bg-emerald-50 text-emerald-700 rounded-xl">🏛️</span>
        <div>
          <h3 class="text-xs font-black text-slate-900 uppercase">Diplomatic Zone</h3>
          <p class="text-[10px] text-slate-500">Near US & Foreign Embassies</p>
        </div>
      </div>

      <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-sm flex items-center gap-3">
        <span class="text-2xl p-2 bg-emerald-50 text-emerald-700 rounded-xl">📞</span>
        <div>
          <h3 class="text-xs font-black text-slate-900 uppercase">Direct Booking</h3>
          <p class="text-[10px] text-slate-500">WhatsApp & Direct Calls</p>
        </div>
      </div>

    </div>
  </section>

  <!-- MAIN HOTEL DIRECTORY GRID -->
  <section id="all-hotels" class="py-10 px-4 sm:px-6 lg:px-8 max-w-[1280px] mx-auto text-slate-800">
    
    <div class="flex justify-between items-end mb-8 border-b border-slate-200 pb-4">
      <div>
        <span class="text-xs font-black uppercase text-emerald-800 tracking-wider">Verified Accommodations</span>
        <h2 class="text-3xl sm:text-4xl font-black text-slate-900 font-serif">
          All Gulshan Hotels ({hotels.length})
        </h2>
      </div>
    </div>

    <!-- Hotel Cards Grid -->
    <div id="hotelsGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {hotels.map((hotel) => (
        <div 
          class="hotel-card bg-white rounded-2xl border border-slate-200 shadow-md hover:shadow-2xl hover:-translate-y-1 transition duration-300 overflow-hidden flex flex-col group"
          data-zone={hotel.zone}
          data-title={hotel.title.toLowerCase()}
        >
          <div class="h-48 sm:h-56 w-full overflow-hidden relative">
            <img 
              src={hotel.image} 
              alt={hotel.title} 
              loading="lazy"
              decoding="async"
              class="w-full h-full object-cover group-hover:scale-105 transition duration-500" 
            />
            
            <div class="absolute top-3 left-3 bg-slate-950/90 text-emerald-300 text-[10px] font-black uppercase px-2.5 py-1 rounded-md border border-emerald-500/40 backdrop-blur-md shadow">
              ✔ Verified Entry
            </div>

            <div class="absolute top-3 right-3 bg-slate-900/85 backdrop-blur-md text-amber-400 text-xs font-black px-2.5 py-1 rounded-md border border-slate-700 shadow-md">
              ★ {hotel.rating}
            </div>

            <!-- WORKABLE WISHLIST TOGGLE BUTTON ON CARD -->
            <button 
              class="card-wishlist-btn absolute bottom-3 right-3 bg-slate-950/80 hover:bg-rose-600 text-white text-sm w-8 h-8 rounded-full flex items-center justify-center transition backdrop-blur-md shadow-md"
              data-hotel={JSON.stringify(hotel)}
              aria-label="Save Hotel"
            >
              ♡
            </button>

            <div class="absolute bottom-3 left-3 bg-emerald-950/90 text-emerald-300 text-[10px] font-black uppercase px-2.5 py-1 rounded-md border border-emerald-500/40 backdrop-blur-md">
              {hotel.category}
            </div>
          </div>

          <div class="p-4 sm:p-5 flex flex-col flex-1 justify-between">
            <div>
              <h3 class="font-serif text-lg sm:text-xl font-bold text-slate-900 mb-1.5 sm:mb-2 group-hover:text-emerald-800 transition">
                {hotel.title}
              </h3>

              <div class="flex items-center gap-1.5 text-xs text-slate-500 mb-4 sm:mb-6">
                <svg class="w-4 h-4 fill-emerald-600 shrink-0" viewBox="0 0 24 24">
                  <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
                </svg>
                <span class="line-clamp-1">{hotel.location}</span>
              </div>
            </div>

            <div class="pt-3 sm:pt-4 border-t border-slate-100 flex items-center justify-between">
              <div>
                <span class="text-[10px] uppercase text-slate-400 font-extrabold block">Price Range</span>
                <span class="font-black text-slate-900 text-sm sm:text-base">{hotel.price}</span>
              </div>

              <a href={`/${hotel.slug}`} class="bg-emerald-700 hover:bg-emerald-800 text-white font-extrabold text-xs px-4 py-2.5 rounded-xl shadow-md transition flex items-center gap-1">
                Compare Rates ➔
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>

  </section>

  <!-- INSTANT FILTER, SEARCH & WISHLIST CARD SCRIPT -->
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const tabs = document.querySelectorAll('.filter-tab');
      const cards = document.querySelectorAll('.hotel-card');
      const searchInput = document.getElementById('searchHotels') as HTMLInputElement;

      let currentZone = 'all';

      // Read URL Query Parameter e.g. ?zone=gulshan-1
      const urlParams = new URLSearchParams(window.location.search);
      const zoneParam = urlParams.get('zone');
      if (zoneParam) {
        currentZone = zoneParam;
      }

      function applyFilter() {
        const query = searchInput ? searchInput.value.toLowerCase().trim() : '';

        cards.forEach((card) => {
          const el = card as HTMLElement;
          const zone = el.getAttribute('data-zone');
          const title = el.getAttribute('data-title') || '';

          const matchesZone = currentZone === 'all' || zone === currentZone;
          const matchesSearch = query === '' || title.includes(query);

          if (matchesZone && matchesSearch) {
            el.style.display = 'flex';
          } else {
            el.style.display = 'none';
          }
        });
      }

      // Zone Tabs Filter
      tabs.forEach((tab) => {
        const filterAttr = tab.getAttribute('data-filter');
        if (filterAttr === currentZone) {
          tabs.forEach(t => t.classList.remove('bg-emerald-700', 'text-white'));
          tab.classList.add('bg-emerald-700', 'text-white');
        }

        tab.addEventListener('click', () => {
          tabs.forEach((t) => {
            t.classList.remove('bg-emerald-700', 'text-white', 'shadow');
            t.classList.add('bg-slate-100', 'text-slate-700');
          });

          tab.classList.remove('bg-slate-100', 'text-slate-700');
          tab.classList.add('bg-emerald-700', 'text-white', 'shadow');

          currentZone = tab.getAttribute('data-filter') || 'all';
          applyFilter();
        });
      });

      if (searchInput) searchInput.addEventListener('input', applyFilter);

      // Card Wishlist Buttons Click
      document.querySelectorAll('.card-wishlist-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
          const target = e.currentTarget as HTMLElement;
          const hotelData = JSON.parse(target.getAttribute('data-hotel') || '{}');
          if (window.toggleWishlistHotel) {
            window.toggleWishlistHotel(hotelData);
            target.classList.toggle('bg-rose-600');
          }
        });
      });

      applyFilter();
    });
  </script>

</Layout>
