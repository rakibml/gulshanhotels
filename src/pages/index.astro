        </div>
      </header>

      <!-- CENTER HERO SEO TYPOGRAPHY -->
      <div class="relative z-10 max-w-[1280px] mx-auto px-3 text-center my-auto flex flex-col items-center justify-center space-y-2 sm:space-y-4">
        
        <div class="inline-flex items-center gap-1.5 bg-emerald-500/20 border border-emerald-400/40 text-emerald-300 text-[10px] sm:text-xs font-black uppercase tracking-widest px-3 py-1 rounded-full backdrop-blur-md">
          <span class="w-1.5 h-1.5 sm:w-2 sm:h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          Official Accommodations & Travel Authority
        </div>

        <h1 class="text-2xl xs:text-3xl sm:text-5xl lg:text-7xl font-black uppercase tracking-tight text-white leading-tight font-serif drop-shadow-2xl select-none">
          Find & Compare <br class="hidden sm:inline" />
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 via-teal-200 to-amber-300">Hotels In Gulshan, Dhaka</span>
        </h1>

        <p class="text-xs sm:text-base lg:text-lg text-slate-200 max-w-3xl font-normal leading-snug sm:leading-relaxed drop-shadow line-clamp-2 sm:line-clamp-none">
          Your official guide to 5-star luxury stays, diplomatic lodging, executive business suites, and real-time rate comparison in Gulshan 1, Gulshan 2 & Baridhara Diplomatic Enclosure.
        </p>

        <div class="pt-1 flex flex-wrap justify-center gap-2 sm:gap-3">
          <a href="#all-hotels" class="bg-emerald-600 hover:bg-emerald-500 text-white font-black text-[10px] sm:text-xs lg:text-sm px-4 py-2 sm:px-6 sm:py-3 rounded-full transition shadow-xl">
            Explore All Hotels ➔
          </a>
          <a href="#all-hotels?zone=banani" class="bg-white/10 hover:bg-white/20 border border-white/20 text-white font-black text-[10px] sm:text-xs lg:text-sm px-4 py-2 sm:px-6 sm:py-3 rounded-full transition backdrop-blur-md">
            🏛️ Diplomatic Zone
          </a>
        </div>

      </div>

      <!-- BOTTOM-LEFT AUTHORITY BADGE & VIDEO CONTROLS -->
      <div class="relative z-20 p-2 sm:p-4 lg:p-5 flex justify-between items-center gap-2">
        <div class="hidden md:flex items-center gap-2 bg-slate-900/80 border border-slate-700/60 px-3.5 py-1.5 rounded-full text-xs text-slate-200 backdrop-blur-md shadow-lg">
          <span class="text-emerald-400">🛡️</span>
          <span class="font-bold">100% Physically Inspected Stays in Gulshan 1, 2 & Diplomatic Zone</span>
        </div>

        <div class="flex items-center gap-1.5 sm:gap-2 ml-auto">
          <button id="toggleVideo" aria-label="Pause Video" class="w-7 h-7 sm:w-9 sm:h-9 lg:w-10 lg:h-10 rounded-full bg-emerald-600 hover:bg-emerald-500 text-white border border-emerald-400/40 backdrop-blur-md flex items-center justify-center text-[10px] sm:text-xs shadow-xl transition cursor-pointer">
            ⏸
          </button>
          <button id="toggleMute" aria-label="Toggle Sound" class="w-7 h-7 sm:w-9 sm:h-9 lg:w-10 lg:h-10 rounded-full bg-emerald-600 hover:bg-emerald-500 text-white border border-emerald-400/40 backdrop-blur-md flex items-center justify-center text-[10px] sm:text-xs shadow-xl transition cursor-pointer">
            🔊
          </button>
        </div>
