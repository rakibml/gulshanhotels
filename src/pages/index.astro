---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import WelcomeSection from '../components/WelcomeSection.astro';
import PopularHotels from '../components/PopularHotels.astro';

// Vite/Astro Native Eager Glob Import (সরাসরি আপনার আসল .md ফাইল থেকে ডাটা রিড করবে)
const rawHotels = import.meta.glob('/src/content/hotels/*.md', { eager: true });

const popularHotels = Object.entries(rawHotels).map(([filepath, file: any]) => {
  // ফাইলপাথ থেকে ফাইলনেম এক্সট্র্যাক্ট করা (যেমন: "/src/content/hotels/the-westin.md" -> "the-westin")
  const slugFromFile = filepath.split('/').pop()?.replace(/\.md$/, '') || 'hotel';
  const frontmatter = file.frontmatter || {};

  return {
    ...frontmatter,
    slug: frontmatter.slug || slugFromFile,
  };
});
---

<Layout title="GulshanHotels.com - Verified Gulshan Hotel Audits & Local Guides">
  <!-- 1. HERO SECTION -->
  <Hero />

  <!-- 2. WELCOME AUTHORITY SECTION -->
  <WelcomeSection />

  <!-- 3. POPULAR HOTELS CAROUSEL SECTION -->
  <PopularHotels popularHotels={popularHotels} />
</Layout>
