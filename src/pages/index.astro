---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

// ১. স্পন্সরড ডাটা লোড
let sponsorData = null;
try {
  const rawSponsor = import.meta.glob('../content/sponsored/*.md', { eager: true });
  const list = Object.values(rawSponsor);
  if (list && list.length > 0) {
    sponsorData = (list[0] as any).frontmatter;
  }
} catch (e) {
  sponsorData = null;
}

// ডিফল্ট স্পন্সর ডাটা
if (!sponsorData) {
  sponsorData = {
    enable: true,
    badge: "⭐ Editor's Choice",
    title: "The Westin Dhaka",
    category: "5-Star Luxury • Gulshan 2",
    rating: 4.8,
    image: "https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&w=800&q=80",
    buttonText: "Check Best Deal ➔",
    buttonLink: "/hotels"
  };
}

// ২. সাধারণ হোটেল লিস্ট লোড (Content Collection)
let hotels: any[] = [];
try {
  const collectionData = await getCollection('hotels');
  if (collectionData && collectionData.length > 0) {
    hotels = collectionData.map((item: any) => ({
      slug: item.id || item.slug,
      title: item.data?.title || item.data?.name || 'Gulshan Hotel',
      category: item.data?.category || 'Luxury Hotel',
      location: item.data?.location || 'Gulshan 2, Dhaka',
      price: item.data?.price || '$$$$',
      rating: item.data?.rating || 4.8,
      image: item.data?.image || 'https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&w=800&q=80',
    }));
  }
} catch (err) {
  hotels = [];
}

// ব্যাকআপ ডামি ডাটা (যদি কোনো ফোল্ডারে ফাইল না থাকে)
if (!hotels || hotels.length === 0) {
  hotels = [
    {
      slug: "the-westin-dhaka",
      title: "The Westin Dhaka",
      category: "5-Star Luxury",
      location: "Main Avenue, Gulshan 2, Dhaka",
      price: "$$$$",
      rating: 4.8,
      image: "https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&w=800&q=80",
    },
    {
      slug: "renaissance-dhaka-gulshan",
      title: "Renaissance Dhaka Gulshan Hotel",
      category: "5-Star Premium",
      location: "SE(B) 98 Gulshan Avenue, Gulshan 1",
      price: "$$$$",
      rating: 4.7,
      image: "https://images.unsplash.com/photo-1582719478250-c89cae4dc85b?auto=format&fit=crop&w=800&q=80",
    },
    {
      slug: "amari-dhaka",
      title: "Amari Dhaka",
      category: "4-Star Boutique",
      location: "47 Road 41, Gulshan 2, Dhaka",
      price: "$$$",
      rating: 4.6,
      image: "https://images.unsplash.com/photo-1542314831-068cd1dbfeeb?auto=format&fit=crop&w=800&q=80",
    },
    {
      slug: "crowne-plaza-dhaka-gulshan",
      title: "Crowne Plaza Dhaka Gulshan",
      category: "5-Star Luxury",
      location: "Gulshan 2, Dhaka",
      price: "$$$$",
      rating: 4.7,
      image: "https://images.unsplash.com/photo-1571896349842-33c89424de2d?auto=format&fit=crop&w=800&q=80",
    }
  ];
}
---

<Layout title="Gulshan Hotels - Official Accommodation & Travel Guide in Gulshan, Dhaka">
  
  <!-- HERO BANNER SECTION (UPDATED WITH OVERLAY CONTENT & QUICK SEARCH) -->
  <section class="relative bg-slate-950 overflow-hidden text-white">
    <!-- Background Image -->
    <div class="absolute inset-0 w-full h-full">
      <img 
        src="/hero-gulshan.jpg" 
        alt="Gulshan Dhaka City Skyline Evening View" 
        class="w-full h-full object-cover opacity-35 scale-105 transform transition duration-1000" 
      />
      <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/60 to-slate-950/30"></div>
    </div>

    <!-- Hero Content Overlay -->
    <div class="relative max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8 pt-16 pb-24 sm:pt-24 sm:pb-32 text-center">
      
      <!-- Verified Badge -->
      <div class="inline-flex items-center gap-2 bg-emerald-500/20 border border-emerald-500/40 text-emerald-300 text-xs font-bold uppercase tracking-widest px-3.5 py-1.5 rounded-full mb-6 backdrop-blur-md">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        Official Gulshan Accommodations Directory
      </div>

      <!-- Main Headline -->
      <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black tracking-tight text-white leading-tight max-w-4xl mx-auto drop-shadow-md">
        Discover & Compare The Best Hotels In <span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 to-teal-200">Gulshan, Dhaka</span>
      </h1>

      <p class="mt-4 text-sm sm:text-lg text-slate-300 max-w-2xl mx-auto font-normal leading-relaxed">
        Your unbiased local guide to luxury stays, business accommodations, and real-time deal comparison across Gulshan 1, Gulshan 2 & Diplomatic Zone.
      </p>

      <!-- Quick Area Filter Buttons -->
      <div class="mt-8 flex flex-wrap justify-center gap-2 sm:gap-3">
        <a href="/hotels" class="bg-emerald-600 hover:bg-emerald-500 text-white font-extrabold text-xs sm:text-sm px-5 py-2.5 rounded-xl transition shadow-lg shadow-emerald-900/30">
          All Hotels
        </a>
        <a href="/hotels?zone=gulshan-1" class="bg-slate-800/80 hover:bg-slate-700/80 border border-slate-700 text-slate-200 font-bold text-xs sm:text-sm px-4 py-2.5 rounded-xl transition backdrop-blur-md">
          📍 Gulshan 1
        </a>
        <a href="/hotels?zone=gulshan-2" class="bg-slate-800/80 hover:bg-slate-700/80 border border-slate-700 text-slate-200 font-bold text-xs sm:text-sm px-4 py-2.5 rounded-xl transition backdrop-blur-md">
          📍 Gulshan 2
        </a>
        <a href="/hotels?zone=diplomatic-zone" class="bg-slate-800/80 hover:bg-slate-700/80 border border-slate-700 text-slate-200 font-bold text-xs sm:text-sm px-4 py-2.5 rounded-xl transition backdrop-blur-md">
          🏛️ Diplomatic Zone
        </a>
      </div>

    </div>

    <!-- Wave Curve Divider -->
    <div class="absolute bottom-0 left-0 right-0 w-full overflow-hidden leading-none z-10 pointer-events-none">
      <svg class="relative block w-full h-8 sm:h-14 text-slate-50" viewBox="0 0 1200 120" preserveAspectRatio="none" fill="currentColor">
        <path d="M0,0 C150,90 350,-40 500,60 C650,160 900,10 1200,40 L1200,120 L0,120 Z"></path>
      </svg>
    </div>
  </section>

  <!-- WELCOME AUTHORITY & SPONSORED SHOWCASE -->
  <section class="bg-slate-50 py-10 px-4 sm:px-8 lg:px-12 border-b border-slate-200">
    <div class="max-w-[1600px] mx-auto grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
      
      <!-- Left Column: Narrative & Authority Badges -->
      <div class="lg:col-span-7 space-y-4 text-left">
        <div class="inline-block border-b-2 border-emerald-600 pb-1">
          <span class="text-xs font-black uppercase tracking-widest text-emerald-800">
            WELCOME TO GULSHANHOTELS.COM
          </span>
        </div>

        <h2 class="text-2xl sm:text-4xl font-black text-slate-900 tracking-tight leading-tight">
          Your Trusted Guide To Premium Hospitality
        </h2>

        <p class="text-slate-600 text-sm sm:text-base leading-relaxed">
          Gulshan is Dhaka’s most upscale neighborhood, known for its diplomatic district, 5-star luxury hotels, fine dining, and vibrant city life. Whether you're visiting for embassy appointments, international business, or leisure, we help you find the perfect hotel through unbiased reviews, real photos, and local insider tips.
        </p>

        <div class="hidden sm:grid grid-cols-2 sm:grid-cols-4 gap-4 pt-4 border-t border-slate-200">
          <div class="flex items-center space-x-2.5">
            <span class="text-xl">🔍</span>
            <div>
              <h3 class="text-xs font-bold text-slate-900">Expert Reviews</h3>
              <p class="text-[10px] text-slate-500">In-depth insights</p>
            </div>
          </div>

          <div class="flex items-center space-x-2.5">
            <span class="text-xl">📸</span>
            <div>
              <h3 class="text-xs font-bold text-slate-900">Real Photos</h3>
              <p class="text-[10px] text-slate-500">Authentic views</p>
            </div>
          </div>

          <div class="flex items-center space-x-2.5">
            <span class="text-xl">⚖️</span>
            <div>
              <h3 class="text-xs font-bold text-slate-900">Pros & Cons</h3>
              <p class="text-[10px] text-slate-500">Honest breakdowns</p>
            </div>
          </div>

          <div class="flex items-center space-x-2.5">
            <span class="text-xl">🤝</span>
            <div>
              <h3 class="text-xs font-bold text-slate-900">Unbiased Stays</h3>
              <p class="text-[10px] text-slate-500">Local recommendations</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Right Column: Sponsored Showcase (Dynamic Admin Controlled) -->
      <div class="lg:col-span-5">
        {sponsorData && sponsorData.enable ? (
          <div class="relative rounded-2xl overflow-hidden shadow-xl border border-slate-200 group bg-slate-900">
            <img 
              src={sponsorData.image || "https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&w=800&q=80"} 
              alt={sponsorData.title} 
              class="w-full h-72 sm:h-80 object-cover group-hover:scale-105 transition-transform duration-500 opacity-90" 
            />
            <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/20 to-transparent"></div>

            <div class="absolute top-4 left-4 bg-amber-500 text-slate-950 text-[11px] font-black uppercase px-3 py-1 rounded-full shadow-md flex items-center space-x-1">
              <span>{sponsorData.badge || "⭐ Editor's Choice"}</span>
            </div>

            <div class="absolute bottom-4 left-4 right-4 text-white flex justify-between items-end">
              <div>
                <span class="text-[11px] font-extrabold text-emerald-300 bg-slate-950/80 px-2.5 py-0.5 rounded border border-emerald-500/40">
                  {sponsorData.category || "5-Star Luxury • Gulshan 2"}
                </span>
                <h3 class="text-2xl font-black text-white mt-1.5">{sponsorData.title}</h3>
                <p class="text-xs text-amber-400 font-bold mt-0.5">★ ★ ★ ★ ★ <span class="text-white ml-1">{sponsorData.rating || '4.8'}/5 Excellent</span></p>
              </div>

              <a 
                href={sponsorData.buttonLink || "/hotels"} 
                class="bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-extrabold px-4 py-2.5 rounded-lg shadow-lg transition shrink-0 ml-2"
              >
                {sponsorData.buttonText || "Check Best Deal ➔"}
              </a>
            </div>
          </div>
        ) : (
          <div class="bg-gradient-to-br from-emerald-900 to-slate-900 p-8 rounded-2xl border border-emerald-700/50 text-white text-center space-y-4 shadow-xl">
            <span class="bg-emerald-500/20 text-emerald-300 text-xs font-bold uppercase px-3 py-1 rounded-full border border-emerald-500/30">
              Sponsored Opportunity
            </span>
            <h3 class="text-2xl font-black text-white">Feature Your Hotel Here!</h3>
            <p class="text-xs text-slate-300">
              Reach over 25,000+ diplomats, tourists, and business travelers visiting Gulshan monthly. Get maximum visibility for your hotel.
            </p>
            <a href="/contact" class="inline-block bg-amber-500 hover:bg-amber-400 text-slate-950 font-black px-6 py-2.5 rounded-xl text-xs uppercase shadow transition">
              Contact For Sponsorship ➔
            </a>
          </div>
        )}
      </div>

    </div>
  </section>

  <!-- DYNAMIC FEATURED HOTELS CAROUSEL SECTION -->
  <section class="py-12 px-4 sm:px-6 lg:px-8 max-w-[1280px] mx-auto font-sans text-gray-800">
    
    <!-- Section Header -->
    <div class="flex justify-between items-center mb-6">
      <div>
        <h2 class="font-serif text-2xl sm:text-3xl font-bold text-slate-900">
          Featured Gulshan Hotels
        </h2>
        <p class="text-xs sm:text-sm text-slate-500 mt-1">Explore top-rated luxury & boutique stays in Gulshan 1, 2 & Diplomatic Zone</p>
      </div>
      <a href="/hotels" class="text-xs sm:text-sm font-bold text-emerald-700 border border-emerald-200 hover:border-emerald-400 hover:bg-emerald-50 rounded-full px-4 sm:px-5 py-2 sm:py-2.5 transition flex items-center gap-1">
        See All Hotels &rarr;
      </a>
    </div>

    <!-- Carousel Wrapper -->
    <div class="relative group">
      
      <!-- Prev Button -->
      <button id="prevBtn" aria-label="Previous" class="absolute -left-3 md:-left-5 top-1/2 -translate-y-1/2 z-10 w-10 h-10 rounded-full bg-white border border-gray-200 shadow-md flex items-center justify-center text-gray-700 hover:bg-gray-50 hover:scale-105 active:scale-95 transition">
        &#10094;
      </button>

      <!-- Dynamic Carousel Track -->
      <div id="carouselTrack" class="flex gap-5 overflow-x-auto scroll-smooth py-3 [scrollbar-width:none] [-ms-overflow-style:none] [&::-webkit-scrollbar]:hidden">
        
        {hotels.map((hotel) => (
          <div class="w-[280px] sm:w-[300px] shrink-0 bg-white rounded-2xl border border-slate-200 shadow-sm hover:shadow-xl hover:-translate-y-1 transition duration-300 overflow-hidden flex flex-col group/card">
            <div class="h-[200px] w-full overflow-hidden relative">
              <img 
                class="w-full h-full object-cover rounded-t-2xl group-hover/card:scale-105 transition duration-500" 
                src={hotel.image} 
                alt={hotel.title} 
              />
              <div class="absolute top-3 right-3 bg-slate-900/80 backdrop-blur-md text-amber-400 text-xs font-black px-2.5 py-1 rounded-md border border-slate-700">
                ★ {hotel.rating}
              </div>
            </div>
            
            <div class="p-5 flex flex-col flex-1">
              <span class="text-[11px] font-extrabold uppercase text-emerald-700 tracking-wider mb-1">
                {hotel.category}
              </span>
              <h3 class="font-serif text-lg font-bold text-slate-900 mb-2 line-clamp-1 group-hover/card:text-emerald-700 transition">
                {hotel.title}
              </h3>
              
              <div class="flex items-center gap-1.5 text-xs text-slate-500 mb-6">
                <svg class="w-3.5 h-3.5 fill-emerald-600 shrink-0" viewBox="0 0 24 24">
                  <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
                </svg>
                <span class="line-clamp-1">{hotel.location}</span>
              </div>
              
              <div class="mt-auto flex items-center justify-between pt-3 border-t border-slate-100">
                <span class="font-black text-slate-900 text-sm">{hotel.price}</span>
                <a 
                  href={`/${hotel.slug}`} 
                  class="bg-emerald-600 hover:bg-emerald-700 text-white px-3.5 py-1.5 rounded-lg font-extrabold text-xs transition"
                >
                  View Details
                </a>
              </div>
            </div>
          </div>
        ))}

      </div>

      <!-- Next Button -->
      <button id="nextBtn" aria-label="Next" class="absolute -right-3 md:-right-5 top-1/2 -translate-y-1/2 z-10 w-10 h-10 rounded-full bg-white border border-gray-200 shadow-md flex items-center justify-center text-gray-700 hover:bg-gray-50 hover:scale-105 active:scale-95 transition">
        &#10095;
      </button>
    </div>

  </section>

  <!-- JS SCRIPT FOR CAROUSEL SCROLLING -->
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const track = document.getElementById('carouselTrack');
      const prevBtn = document.getElementById('prevBtn');
      const nextBtn = document.getElementById('nextBtn');

      if (track && prevBtn && nextBtn) {
        prevBtn.addEventListener('click', () => {
          track.scrollBy({ left: -320, behavior: 'smooth' });
        });

        nextBtn.addEventListener('click', () => {
          track.scrollBy({ left: 320, behavior: 'smooth' });
        });
      }
    });
  </script>

</Layout>
