---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

// ১. স্পন্সরড ডাটা লোড
let sponsorData = null;
try {
  const rawSponsor = import.meta.glob('../content/sponsored/*.md', { eager: true });
  const list = Object.values(rawSponsor);
  if (list && list.length > 0) {
    sponsorData = (list[0] as any).frontmatter;
  }
} catch (e) {
  sponsorData = null;
}

if (!sponsorData) {
  sponsorData = {
    enable: true,
    badge: "⭐ Editor's Choice",
    title: "The Westin Dhaka",
    category: "5-Star Luxury • Gulshan 2",
    rating: 4.8,
    image: "https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&w=800&q=80",
    buttonText: "Check Best Deal ➔",
    buttonLink: "/the-westin-dhaka"
  };
}

function toTitleCase(str: string) {
  if (!str) return 'Gulshan Hotel';
  return str.replace(/\w\S*/g, (txt) => txt.charAt(0).toUpperCase() + txt.substr(1).toLowerCase());
}

// ২. গুলশানের সব ভেরিফাইড হোটেল লোড করা
let hotels: any[] = [];
try {
  const collectionData = await getCollection('hotels');
  if (collectionData && collectionData.length > 0) {
    hotels = collectionData.map((item: any) => ({
      slug: item.id || item.slug,
      title: toTitleCase(item.data?.title || item.data?.name || 'Gulshan Hotel'),
      category: item.data?.category || 'Luxury Hotel',
      location: item.data?.location || 'Gulshan 2, Dhaka',
      zone: (item.data?.location || '').toLowerCase().includes('gulshan 1') 
            ? 'gulshan-1' 
            : (item.data?.location || '').toLowerCase().includes('banani')
            ? 'banani'
            : 'gulshan-2',
      price: item.data?.price || '$$$$',
      rating: item.data?.rating || 4.8,
      image: item.data?.image || 'https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&w=800&q=80',
    }));
  }
} catch (err) {
  hotels = [];
}
---

<Layout title="Gulshan Hotels - Official Destination Directory & Accommodations Guide in Gulshan, Dhaka">
  
  <!-- MASTERPIECE HERO SECTION CONTAINER -->
  <section class="relative bg-slate-950 text-white min-h-[85vh] sm:min-h-[90vh] flex flex-col justify-center overflow-hidden border-b border-slate-800">
    
    <!-- Background Evening Image & Ambient Emerald Radial Glow Overlay -->
    <div class="absolute inset-0 w-full h-full pointer-events-none">
      <img 
        src="https://images.unsplash.com/photo-1512917774080-9991f1c4c750?auto=format&fit=crop&w=2000&q=85" 
        alt="Gulshan Dhaka City Skyline Evening View" 
        class="w-full h-full object-cover opacity-35 scale-105 transform transition duration-1000" 
      />
      
      <!-- Gradient Overlays -->
      <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/75 to-slate-950/40"></div>
      <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[350px] bg-emerald-500/15 blur-[120px] rounded-full"></div>
    </div>

    <!-- YOUR ORIGINAL HEADER (INTEGRATED AT TOP) -->
    <header class="relative z-30 w-full border-b border-white/10 bg-gradient-to-b from-slate-950/90 to-transparent py-3 sm:py-4 px-4 sm:px-8">
      <div class="max-w-[1600px] mx-auto flex justify-between items-center">
        
        <a href="/" class="flex flex-col group">
          <span class="text-xl sm:text-3xl font-black tracking-tight text-white leading-none group-hover:text-emerald-400 transition">
            GULSHAN<span class="text-emerald-400">HOTELS</span>.COM
          </span>
          <span class="text-[9px] sm:text-[11px] text-slate-300 tracking-[0.25em] font-black uppercase mt-1">
            DHAKA • BANGLADESH
          </span>
        </a>

        <!-- Desktop Navigation Menu -->
        <nav class="hidden lg:flex items-center space-x-8 text-xs font-black tracking-widest uppercase text-white">
          <a href="/" class="text-emerald-400 hover:text-emerald-300 transition border-b-2 border-emerald-400 pb-0.5">HOME</a>
          
          <div class="relative group cursor-pointer py-1">
            <span class="flex items-center hover:text-emerald-400 transition">
              STAY
              <svg class="w-4 h-4 ml-1 text-slate-300 group-hover:text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"></path></svg>
            </span>
            <div class="absolute left-0 mt-2 w-56 bg-slate-900/95 border border-slate-700 rounded-xl shadow-2xl py-2 hidden group-hover:block transition-all text-white backdrop-blur-xl">
              <a href="#all-hotels" class="block px-4 py-2 hover:bg-slate-800 hover:text-emerald-400 font-extrabold text-xs">5-Star Luxury Hotels</a>
              <a href="#all-hotels" class="block px-4 py-2 hover:bg-slate-800 hover:text-emerald-400 font-extrabold text-xs">Boutique Stays</a>
              <a href="#all-hotels" class="block px-4 py-2 hover:bg-slate-800 hover:text-emerald-400 font-extrabold text-xs">Budget Accommodations</a>
            </div>
          </div>

          <a href="#all-hotels" class="hover:text-emerald-400 transition">DEALS</a>
          
          <div class="relative group cursor-pointer py-1">
            <span class="flex items-center hover:text-emerald-400 transition">
              AREAS GUIDE
              <svg class="w-4 h-4 ml-1 text-slate-300 group-hover:text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"></path></svg>
            </span>
            <div class="absolute left-0 mt-2 w-56 bg-slate-900/95 border border-slate-700 rounded-xl shadow-2xl py-2 hidden group-hover:block transition-all text-white backdrop-blur-xl">
              <a href="/about" class="block px-4 py-2 hover:bg-slate-800 hover:text-emerald-400 font-extrabold text-xs">Gulshan 1 Guide</a>
              <a href="/about" class="block px-4 py-2 hover:bg-slate-800 hover:text-emerald-400 font-extrabold text-xs">Gulshan 2 Guide</a>
              <a href="/about" class="block px-4 py-2 hover:bg-slate-800 hover:text-emerald-400 font-extrabold text-xs">Diplomatic Zone</a>
            </div>
          </div>

          <a href="/about" class="hover:text-emerald-400 transition">BLOG</a>
          <a href="/about" class="hover:text-emerald-400 transition">CONTACT</a>
        </nav>

        <div class="flex items-center space-x-3 sm:space-x-5">
          <button class="text-white hover:text-amber-400 transition p-2 rounded-full hover:bg-white/10">
            <svg class="w-5 h-5 sm:w-6 sm:h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path></svg>
          </button>

          <a href="#all-hotels" class="hidden sm:flex bg-emerald-600 hover:bg-emerald-500 text-white font-black text-xs tracking-wider uppercase px-4 py-2.5 rounded-full transition items-center space-x-2 shadow-lg border border-emerald-400/30">
            <svg class="w-4 h-4 text-emerald-200" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7"></path></svg>
            <span>Browse Map</span>
          </a>

          <button id="mobile-menu-btn" class="lg:hidden text-white hover:text-emerald-400 p-2 rounded-lg focus:outline-none hover:bg-white/10">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path></svg>
          </button>
        </div>

      </div>

      <!-- Mobile Menu Drawer -->
      <div id="mobile-menu" class="hidden lg:hidden bg-slate-900/95 border-t border-slate-800 px-5 py-5 space-y-3 font-extrabold text-sm text-white backdrop-blur-xl">
        <a href="/" class="block text-emerald-400 py-1">HOME</a>
        <a href="#all-hotels" class="block py-1">STAY</a>
        <a href="#all-hotels" class="block py-1">DEALS</a>
        <a href="/about" class="block py-1">BLOG</a>
        <a href="/about" class="block py-1">CONTACT</a>
      </div>
    </header>

    <!-- MAIN HERO CONTENT AREA -->
    <div class="relative z-10 max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8 pt-20 pb-16 text-center space-y-6 sm:space-y-8 my-auto">
      
      <!-- Official Badge -->
      <div class="inline-flex items-center gap-2 bg-gradient-to-r from-emerald-500/20 via-slate-900/80 to-amber-500/20 border border-emerald-500/40 text-emerald-300 text-xs sm:text-sm font-black uppercase tracking-widest px-4 py-2 rounded-full backdrop-blur-md shadow-xl">
        <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 animate-ping"></span>
        <span>GULSHAN'S OFFICIAL LODGING DIRECTORY</span>
      </div>

      <!-- Jaw-Dropping Masterpiece Headline -->
      <h1 class="text-3xl xs:text-4xl sm:text-6xl lg:text-7xl font-black tracking-tight text-white leading-tight font-serif drop-shadow-2xl">
        Discover Luxury & Comfort In <br class="hidden sm:inline" />
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 via-teal-200 to-amber-300">
          Gulshan, Dhaka
        </span>
      </h1>

      <p class="text-xs sm:text-base lg:text-lg text-slate-300 max-w-2xl mx-auto font-normal leading-relaxed drop-shadow">
        Your verified local guide to 5-star luxury stays, diplomatic lodging, executive business suites, and real-time rate comparison.
      </p>

      <!-- ALL-IN-ONE GLASSMORPHIC SEARCH & AREA CONSOLE -->
      <div class="max-w-4xl mx-auto pt-4">
        <div class="bg-slate-900/80 border border-slate-700/60 rounded-3xl p-3 sm:p-4 backdrop-blur-2xl shadow-2xl space-y-3">
          
          <!-- Zone Filter Tabs -->
          <div class="flex flex-wrap items-center justify-center gap-1.5 sm:gap-2 border-b border-slate-800 pb-3">
            <button data-filter="all" class="filter-tab active bg-emerald-600 text-white font-extrabold text-xs px-4 py-2 rounded-full transition shadow">
              🏢 All Gulshan ({hotels.length})
            </button>
            <button data-filter="gulshan-1" class="filter-tab bg-slate-800/80 hover:bg-slate-700 text-slate-200 font-bold text-xs px-4 py-2 rounded-full transition">
              📍 Gulshan 1
            </button>
            <button data-filter="gulshan-2" class="filter-tab bg-slate-800/80 hover:bg-slate-700 text-slate-200 font-bold text-xs px-4 py-2 rounded-full transition">
              📍 Gulshan 2
            </button>
            <button data-filter="banani" class="filter-tab bg-slate-800/80 hover:bg-slate-700 text-slate-200 font-bold text-xs px-4 py-2 rounded-full transition">
              🏛️ Diplomatic Zone
            </button>
          </div>

          <!-- Instant Search Input & CTA Button -->
          <div class="flex flex-col sm:flex-row items-center gap-2">
            <div class="relative w-full">
              <input 
                type="text" 
                id="searchHotels" 
                placeholder="Search hotel by name (e.g. Westin, Amari, Renaissance)..." 
                class="w-full bg-slate-950/80 border border-slate-700 focus:border-emerald-500 rounded-2xl px-4 py-3 text-xs sm:text-sm text-white placeholder-slate-400 outline-none transition"
              />
              <span class="absolute right-3.5 top-3.5 text-slate-400 text-sm">🔍</span>
            </div>

            <a href="#all-hotels" class="w-full sm:w-auto bg-emerald-600 hover:bg-emerald-500 text-white font-black text-xs sm:text-sm px-7 py-3 rounded-2xl transition shrink-0 shadow-lg flex items-center justify-center gap-2">
              <span>Find Rates</span>
              <span>➔</span>
            </a>
          </div>

        </div>
      </div>

    </div>

    <!-- TRUST & AUTHORITY PILLARS BAR -->
    <div class="relative z-10 max-w-[1280px] mx-auto px-4 pb-12">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-3 sm:gap-4">
        
        <div class="bg-slate-900/60 border border-slate-800/80 p-3.5 rounded-2xl backdrop-blur-md flex items-center gap-3">
          <span class="text-2xl p-2 bg-emerald-950/80 text-emerald-400 rounded-xl border border-emerald-500/20">🛡️</span>
          <div>
            <h3 class="text-xs font-black text-white uppercase">100% Verified</h3>
            <p class="text-[10px] text-slate-400">Inspected Physical Stays</p>
          </div>
        </div>

        <div class="bg-slate-900/60 border border-slate-800/80 p-3.5 rounded-2xl backdrop-blur-md flex items-center gap-3">
          <span class="text-2xl p-2 bg-emerald-950/80 text-emerald-400 rounded-xl border border-emerald-500/20">⚡</span>
          <div>
            <h3 class="text-xs font-black text-white uppercase">Live Price Match</h3>
            <p class="text-[10px] text-slate-400">Agoda, Booking & Direct</p>
          </div>
        </div>

        <div class="bg-slate-900/60 border border-slate-800/80 p-3.5 rounded-2xl backdrop-blur-md flex items-center gap-3">
          <span class="text-2xl p-2 bg-emerald-950/80 text-emerald-400 rounded-xl border border-emerald-500/20">🏛️</span>
          <div>
            <h3 class="text-xs font-black text-white uppercase">Diplomatic Zone</h3>
            <p class="text-[10px] text-slate-400">Near Foreign Embassies</p>
          </div>
        </div>

        <div class="bg-slate-900/60 border border-slate-800/80 p-3.5 rounded-2xl backdrop-blur-md flex items-center gap-3">
          <span class="text-2xl p-2 bg-emerald-950/80 text-emerald-400 rounded-xl border border-emerald-500/20">⭐</span>
          <div>
            <h3 class="text-xs font-black text-white uppercase">4.8/5 Rating</h3>
            <p class="text-[10px] text-slate-400">Verified Local Reviews</p>
          </div>
        </div>

      </div>
    </div>

  </section>

  <!-- MAIN HOTEL DIRECTORY GRID -->
  <section id="all-hotels" class="py-14 px-4 sm:px-6 lg:px-8 max-w-[1280px] mx-auto text-slate-800">
    
    <div class="flex justify-between items-end mb-8 border-b border-slate-200 pb-4">
      <div>
        <span class="text-xs font-black uppercase text-emerald-800 tracking-wider">Official Accommodations</span>
        <h2 class="text-2xl sm:text-4xl font-black text-slate-900 font-serif">
          All Gulshan Hotels ({hotels.length})
        </h2>
      </div>
    </div>

    <!-- Hotel Cards Grid -->
    <div id="hotelsGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {hotels.map((hotel) => (
        <div 
          class="hotel-card bg-white rounded-2xl border border-slate-200 shadow-md hover:shadow-2xl hover:-translate-y-1 transition duration-300 overflow-hidden flex flex-col group"
          data-zone={hotel.zone}
          data-title={hotel.title.toLowerCase()}
        >
          <div class="h-48 sm:h-56 w-full overflow-hidden relative">
            <img 
              src={hotel.image} 
              alt={hotel.title} 
              loading="lazy"
              decoding="async"
              class="w-full h-full object-cover group-hover:scale-105 transition duration-500" 
            />
            
            <div class="absolute top-3 left-3 bg-slate-950/90 text-emerald-300 text-[10px] font-black uppercase px-2.5 py-1 rounded-md border border-emerald-500/40 backdrop-blur-md shadow">
              ✔ Verified Entry
            </div>

            <div class="absolute top-3 right-3 bg-slate-900/85 backdrop-blur-md text-amber-400 text-xs font-black px-2.5 py-1 rounded-md border border-slate-700 shadow-md">
              ★ {hotel.rating}
            </div>

            <div class="absolute bottom-3 left-3 bg-emerald-950/90 text-emerald-300 text-[10px] font-black uppercase px-2.5 py-1 rounded-md border border-emerald-500/40 backdrop-blur-md">
              {hotel.category}
            </div>
          </div>

          <div class="p-4 sm:p-5 flex flex-col flex-1 justify-between">
            <div>
              <h3 class="font-serif text-lg sm:text-xl font-bold text-slate-900 mb-1.5 sm:mb-2 group-hover:text-emerald-700 transition">
                {hotel.title}
              </h3>

              <div class="flex items-center gap-1.5 text-xs text-slate-500 mb-4 sm:mb-6">
                <svg class="w-4 h-4 fill-emerald-600 shrink-0" viewBox="0 0 24 24">
                  <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
                </svg>
                <span class="line-clamp-1">{hotel.location}</span>
              </div>
            </div>

            <div class="pt-3 sm:pt-4 border-t border-slate-100 flex items-center justify-between">
              <div>
                <span class="text-[10px] uppercase text-slate-400 font-extrabold block">Price Range</span>
                <span class="font-black text-slate-900 text-sm sm:text-base">{hotel.price}</span>
              </div>

              <a href={`/${hotel.slug}`} class="bg-emerald-600 hover:bg-emerald-500 text-white font-extrabold text-xs px-3.5 sm:px-4 py-2 sm:py-2.5 rounded-xl shadow-md transition flex items-center gap-1">
                Compare Rates ➔
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>

  </section>

  <!-- INSTANT SEARCH & FILTER SCRIPT -->
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const tabs = document.querySelectorAll('.filter-tab');
      const cards = document.querySelectorAll('.hotel-card');
      const searchInput = document.getElementById('searchHotels') as HTMLInputElement;

      let currentZone = 'all';

      function applyFilter() {
        const query = searchInput ? searchInput.value.toLowerCase().trim() : '';

        cards.forEach((card) => {
          const el = card as HTMLElement;
          const zone = el.getAttribute('data-zone');
          const title = el.getAttribute('data-title') || '';

          const matchesZone = currentZone === 'all' || zone === currentZone;
          const matchesSearch = query === '' || title.includes(query);

          if (matchesZone && matchesSearch) {
            el.style.display = 'flex';
          } else {
            el.style.display = 'none';
          }
        });
      }

      tabs.forEach((tab) => {
        tab.addEventListener('click', () => {
          tabs.forEach((t) => {
            t.classList.remove('bg-emerald-600', 'text-white', 'shadow');
            t.classList.add('bg-slate-800/80', 'text-slate-200');
          });

          tab.classList.remove('bg-slate-800/80', 'text-slate-200');
          tab.classList.add('bg-emerald-600', 'text-white', 'shadow');

          currentZone = tab.getAttribute('data-filter') || 'all';
          applyFilter();
        });
      });

      if (searchInput) searchInput.addEventListener('input', applyFilter);
    });
  </script>

</Layout>
