---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

// ১. Astro Content Collection থেকে ডাটা লোড
let hotelEntries = [];
try {
  hotelEntries = await getCollection('hotels');
} catch (err) {
  hotelEntries = [];
}

// ২. যদি কালেকশন খালি থাকে, তবে Relative Glob দিয়ে ফাইল রিড
if (!hotelEntries || hotelEntries.length === 0) {
  try {
    const rawGlob = import.meta.glob('../content/hotels/*.md', { eager: true });
    hotelEntries = Object.values(rawGlob).map((item: any) => ({
      data: item.frontmatter || {},
      slug: 'hotel-detail'
    }));
  } catch (err) {
    hotelEntries = [];
  }
}

// ৩. সেফটি নেট: হোটেল ফাইল প্রসেস না হলে ডিফল্ট রেডি ডাটা শো করবে
if (!hotelEntries || hotelEntries.length === 0) {
  hotelEntries = [
    {
      data: {
        title: "The Westin Dhaka",
        category: "5-Star Luxury",
        location: "Gulshan 2, Dhaka",
        price: "$$$$",
        rating: 4.8,
        image: "https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&w=800&q=80",
      }
    },
    {
      data: {
        title: "Renaissance Dhaka Gulshan Hotel",
        category: "5-Star Premium",
        location: "Gulshan 1, Dhaka",
        price: "$$$$",
        rating: 4.7,
        image: "https://images.unsplash.com/photo-1582719478250-c89cae4dc85b?auto=format&fit=crop&w=800&q=80",
      }
    }
  ];
}
---

<Layout title="Gulshan Hotels - Best Hotels in Gulshan, Dhaka">
  <!-- Hero Section -->
  <section class="bg-slate-900 text-white py-20 px-4 text-center">
    <h1 class="text-4xl sm:text-6xl font-black">
      Find The Best Hotels in <span class="text-amber-400">Gulshan, Dhaka</span>
    </h1>
    <p class="text-slate-300 mt-2 text-lg">Discover top luxury, boutique stays, and budget hotels in Gulshan 1 & 2.</p>
  </section>

  <!-- Hotels Section -->
  <section class="py-12 max-w-6xl mx-auto px-4">
    <h2 class="text-2xl font-bold text-slate-900 mb-6">Hotels in Gulshan</h2>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {hotelEntries.map((hotel) => (
        <div class="bg-white rounded-xl shadow-md p-4 border border-slate-200 flex flex-col sm:flex-row gap-4 hover:shadow-lg transition">
          {hotel.data?.image && (
            <img src={hotel.data.image} alt={hotel.data.title || hotel.data.name} class="w-full sm:w-44 h-36 object-cover rounded-lg" />
          )}
          <div class="flex-1 flex flex-col justify-between">
            <div>
              <div class="flex justify-between items-center">
                <span class="text-xs font-bold text-amber-600 bg-amber-50 px-2 py-0.5 rounded border border-amber-200">
                  {hotel.data?.category || 'Hotel'}
                </span>
                <span class="text-sm font-bold text-amber-500">★ {hotel.data?.rating || '5.0'}</span>
              </div>
              <h3 class="text-lg font-bold text-slate-900 mt-1">{hotel.data?.title || hotel.data?.name || 'Gulshan Hotel'}</h3>
              <p class="text-xs text-slate-500 mt-0.5">📍 {hotel.data?.location || 'Gulshan, Dhaka'}</p>
            </div>

            <div class="mt-3 pt-3 border-t border-slate-100 flex justify-between items-center">
              <span class="text-sm font-bold text-slate-900">{hotel.data?.price || '$$$$'}</span>
              <span class="text-xs font-semibold text-amber-600 bg-amber-50 px-2.5 py-1 rounded">
                Available
              </span>
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>
</Layout>