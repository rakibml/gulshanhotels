---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

// ১. Astro Content Collections থেকে ডাটা লোড
let hotels = [];
try {
  const collectionData = await getCollection('hotels');
  if (collectionData && collectionData.length > 0) {
    hotels = collectionData.map((item: any) => ({
      slug: item.id?.replace(/\.md$/, '') || item.slug || 'hotel',
      title: item.data?.title || item.data?.name || 'Gulshan Hotel',
      category: item.data?.category || 'Luxury Hotel',
      location: item.data?.location || 'Gulshan 2, Dhaka',
      area: (item.data?.location || 'Gulshan 2').toLowerCase().includes('gulshan 1') ? 'gulshan-1' : (item.data?.location || '').toLowerCase().includes('banani') ? 'banani' : 'gulshan-2',
      rating: item.data?.rating || 4.8,
      reviews: item.data?.reviewsCount || '1,248',
      description: item.data?.description || 'Premium hotel featuring elegant rooms, rooftop swimming pool, fine dining, and diplomatic security in Gulshan.',
      image: item.data?.image || 'https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&w=800&q=80',
      popular: item.data?.popular ?? true,
    }));
  }
} catch (err) {
  hotels = [];
}

// ২. কালেকশন ফাঁকা থাকলে Relative Glob দিয়ে ফাইল স্ক্যান
if (!hotels || hotels.length === 0) {
  try {
    const rawGlob = import.meta.glob('../content/hotels/*.md', { eager: true });
    const globList = Object.entries(rawGlob);
    if (globList && globList.length > 0) {
      hotels = globList.map(([filePath, item]: [string, any]) => {
        const filename = filePath.split('/').pop()?.replace('.md', '') || 'hotel';
        return {
          slug: filename,
          title: item.frontmatter?.title || item.frontmatter?.name || 'Gulshan Hotel',
          category: item.frontmatter?.category || 'Luxury Hotel',
          location: item.frontmatter?.location || 'Gulshan 2, Dhaka',
          area: (item.frontmatter?.location || 'Gulshan 2').toLowerCase().includes('gulshan 1') ? 'gulshan-1' : (item.frontmatter?.location || '').toLowerCase().includes('banani') ? 'banani' : 'gulshan-2',
          rating: item.frontmatter?.rating || 4.8,
          reviews: item.frontmatter?.reviewsCount || '1,248',
          description: item.frontmatter?.description || 'Premium hotel featuring elegant rooms, rooftop swimming pool, fine dining, and diplomatic security in Gulshan.',
          image: item.frontmatter?.image || 'https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&w=800&q=80',
          popular: item.frontmatter?.popular ?? true,
        };
      });
    }
  } catch (err) {
    hotels = [];
  }
}

// ৩. সেফটি ডিফল্ট ডাটা
if (!hotels || hotels.length === 0) {
  hotels = [
    {
      slug: "the-westin-dhaka",
      title: "The Westin Dhaka",
      category: "5-Star Luxury",
      location: "Gulshan 2, Dhaka",
      area: "gulshan-2",
      rating: 4.8,
      reviews: "1,248",
      description: "Premium business hotel with elegant rooms, world-class dining and excellent meeting facilities in Gulshan 2.",
      image: "https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&w=800&q=80",
      popular: true,
    },
    {
      slug: "renaissance-dhaka",
      title: "Renaissance Dhaka Gulshan Hotel",
      category: "5-Star Premium",
      location: "Gulshan 1, Dhaka",
      area: "gulshan-1",
      rating: 4.7,
      reviews: "1,102",
      description: "Stylish hotel with spacious rooms, multiple dining options and warm hospitality in Gulshan 1.",
      image: "https://images.unsplash.com/photo-1582719478250-c89cae4dc85b?auto=format&fit=crop&w=800&q=80",
      popular: true,
    },
    {
      slug: "amari-dhaka",
      title: "Amari Dhaka",
      category: "4-Star Boutique",
      location: "Gulshan 2, Dhaka",
      area: "gulshan-2",
      rating: 4.6,
      reviews: "982",
      description: "Modern rooms, rooftop pool and easy access to embassies and corporate offices in Gulshan Circle 2.",
      image: "https://images.unsplash.com/photo-1542314831-068cd1dbfeeb?auto=format&fit=crop&w=800&q=80",
      popular: true,
    }
  ];
}

function toTitleCase(str: string) {
  if (!str) return 'Gulshan Hotel';
  return str.replace(/\w\S*/g, (txt) => txt.charAt(0).toUpperCase() + txt.substr(1).toLowerCase());
}

// টাইটেল ফিল্টার ও সেফ ফরম্যাট
const popularHotels = hotels.map((h: any) => ({
  ...h,
  title: toTitleCase(h.title)
}));
---

<Layout title="GulshanHotels.com - Verified Gulshan Hotel Audits & Local Guides">
  
  <!-- HERO BANNER WITH WAVY CURVE -->
  <section class="relative bg-slate-900 overflow-hidden min-h-[350px] sm:min-h-[480px] flex items-center justify-center">
    
    <!-- Background Image -->
    <div class="absolute inset-0 w-full h-full">
      <img 
        src="/hero-gulshan.jpg.webp" 
        onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1512917774080-9991f1c4c750?auto=format&fit=crop&w=2000&q=85';"
        alt="Gulshan Dhaka City Skyline" 
        class="w-full h-full object-cover object-center opacity-80" 
      />
      <div class="absolute inset-0 bg-gradient-to-t from-slate-950/90 via-slate-900/40 to-transparent"></div>
    </div>

    <!-- Overlay Text -->
    <div class="relative z-10 text-center px-4 sm:px-8 lg:px-12 max-w-[1550px] mx-auto w-full pt-10 pb-20 sm:pb-28 space-y-3">
      <span class="text-[11px] sm:text-xs font-black uppercase tracking-[0.25em] text-emerald-300 drop-shadow block">
        GULSHAN HOTELS GUIDE
      </span>
      <h1 class="font-serif text-3xl sm:text-6xl font-extrabold text-white tracking-tight drop-shadow-md leading-tight">
        Welcome to Gulshan, Dhaka
      </h1>
    </div>

    <!-- Seamless SVG Wave Divider -->
    <div class="absolute -bottom-1 left-0 right-0 w-full overflow-hidden leading-none z-20">
      <svg class="relative block w-full h-10 sm:h-20 text-white fill-current" viewBox="0 0 1200 120" preserveAspectRatio="none">
        <path d="M0,0 C150,90 350,-40 500,60 C650,160 900,10 1200,40 L1200,120 L0,120 Z"></path>
      </svg>
    </div>
  </section>

  <!-- WELCOME AUTHORITY SECTION -->
  <section class="bg-white py-12 sm:py-18 border-b border-slate-200">
    <div class="max-w-[1550px] mx-auto px-6 sm:px-20 lg:px-28 text-left space-y-4 sm:space-y-5">
      
      <div class="inline-block border-b-2 border-[#0d3b23] pb-1">
        <span class="text-sm sm:text-base font-black uppercase tracking-widest text-[#0d3b23]">
          WELCOME TO
        </span>
      </div>

      <div class="flex flex-wrap items-center gap-3 sm:gap-5">
        <h2 class="font-serif text-4xl sm:text-6xl font-black text-[#0d3b23] tracking-tight leading-none">
          GulshanHotels.com
        </h2>

        <div class="hidden sm:flex items-center space-x-1.5 text-emerald-600 font-light text-3xl tracking-tighter opacity-80">
          <span>\</span><span>|</span><span>/</span>
        </div>

        <div class="flex items-center space-x-3 sm:ml-2">
          <a href="https://facebook.com" target="_blank" rel="noopener noreferrer" title="Facebook" class="w-10 h-10 sm:w-11 sm:h-11 rounded-xl bg-[#1877F2] hover:bg-[#166FE5] text-white flex items-center justify-center shadow-md hover:scale-110 transition-all duration-300">
            <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 3.865 10.99 9.1 11.823v-8.367h-3.04v-3.456h3.04v-2.636c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953h-1.513c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.456h-2.796v8.367c5.235-.833 9.1-5.833 9.1-11.823z"/></svg>
          </a>

          <a href="https://instagram.com" target="_blank" rel="noopener noreferrer" title="Instagram" class="w-10 h-10 sm:w-11 sm:h-11 rounded-xl bg-gradient-to-tr from-amber-500 via-rose-500 to-purple-600 hover:opacity-90 text-white flex items-center justify-center shadow-md hover:scale-110 transition-all duration-300">
            <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
          </a>

          <a href="https://twitter.com" target="_blank" rel="noopener noreferrer" title="Twitter (X)" class="w-10 h-10 sm:w-11 sm:h-11 rounded-xl bg-slate-950 hover:bg-black text-white flex items-center justify-center shadow-md hover:scale-110 transition-all duration-300 border border-slate-800">
            <svg class="w-4 h-4 sm:w-5 sm:h-5 fill-current" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
          </a>
        </div>
      </div>

      <div class="text-slate-800 text-base sm:text-xl leading-relaxed sm:leading-relaxed pt-2 font-normal space-y-4">
        <p>
          At Gulshan, business meets diplomatic luxury. For international business leaders, foreign diplomats, non-resident Bangladeshis, and discerning travelers, <strong class="font-extrabold text-slate-900">GulshanHotels.com</strong> is where their journey begins. As the official local accommodation and travel directory for Gulshan 1, Gulshan 2, and the Diplomatic Zone, this is your one trusted source for verified 5-star luxury hotels, embassy proximity guides, fine dining, and real-time deal comparisons.
        </p>

        <div id="extended-content" class="hidden space-y-4 pt-1">
          <p>
            Whether you are visiting Gulshan for foreign embassy visa interviews (US Embassy, IVAC Indian Visa Center, UK Visa Application Centre, Saudi Embassy), high-profile corporate summits, or a weekend urban getaway, Gulshan offers Bangladesh's most secure and vibrant hospitality ecosystem.
          </p>
          <p>
            Our independent audit team routinely inspects room amenities, high-speed Wi-Fi speeds, swimming pool hygiene, rooftop dining options, and airport shuttle reliability across all major properties including The Westin Dhaka, Renaissance Dhaka, Amari Dhaka, and Lakeshore Hotel. We analyze consumer forum data and traveler reviews to uncover hidden checkout fees, identify maintenance gaps, and help you book smarter.
          </p>
        </div>

        <div>
          <button 
            id="read-more-btn" 
            type="button" 
            class="inline-flex items-center gap-2 text-sm sm:text-base font-black uppercase tracking-wider text-[#0d3b23] hover:text-emerald-700 pt-3 cursor-pointer border-b-2 border-[#0d3b23] pb-0.5 transition"
          >
            <span id="read-more-text">Read More</span>
            <svg id="read-more-arrow" class="w-4 h-4 transform transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"/></svg>
          </button>
        </div>
      </div>

    </div>
  </section>

  <!-- SECTION: "POPULAR HOTELS IN GULSHAN" (SIDE-BY-SIDE HORIZONTAL CAROUSEL ONLY) -->
  <section id="popular-hotels" class="bg-[#F8FAF9] py-16 border-b border-slate-200">
    <div class="max-w-[1550px] mx-auto px-4 sm:px-8 lg:px-12 space-y-8">
      
      <!-- Section Header with Left/Right Arrow Navigation -->
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 border-b border-slate-200 pb-4">
        <div>
          <span class="text-xs font-black text-emerald-800 uppercase tracking-widest bg-emerald-100/60 px-3 py-1 rounded-full border border-emerald-200">
            POPULAR ACCOMMODATIONS
          </span>
          <h2 class="text-3xl sm:text-4xl font-black text-slate-900 mt-2">Popular Hotels in Gulshan</h2>
          <p class="text-xs sm:text-sm text-slate-500 font-medium mt-1">Handpicked luxury and executive hotels recommended by our local audit team.</p>
        </div>

        <div class="flex items-center gap-3">
          <!-- Left/Right Arrow Buttons -->
          <div class="flex items-center gap-2">
            <button id="popularPrevBtn" aria-label="Previous" class="w-10 h-10 rounded-full bg-white border border-slate-200 shadow-sm flex items-center justify-center text-slate-700 hover:bg-[#0d3b23] hover:text-white transition cursor-pointer">
              ❮
            </button>
            <button id="popularNextBtn" aria-label="Next" class="w-10 h-10 rounded-full bg-white border border-slate-200 shadow-sm flex items-center justify-center text-slate-700 hover:bg-[#0d3b23] hover:text-white transition cursor-pointer">
              ❯
            </button>
          </div>

          <a href="#all-hotels" class="text-emerald-800 hover:text-emerald-600 font-black text-xs uppercase tracking-wider flex items-center space-x-1 shrink-0 ml-2">
            <span>View All Hotels ➔</span>
          </a>
        </div>
      </div>

      <!-- SIDE-BY-SIDE HORIZONTAL SCROLL CAROUSEL TRACK (NO MULTI-ROW GRID!) -->
      <div id="popularCarouselTrack" class="flex gap-6 overflow-x-auto scroll-smooth py-3 [scrollbar-width:none] [-ms-overflow-style:none] [&::-webkit-scrollbar]:hidden">
        {popularHotels.map((hotel: any) => (
          <div class="w-[300px] sm:w-[350px] shrink-0 bg-white rounded-3xl shadow-sm border border-slate-200/90 overflow-hidden flex flex-col justify-between hover:shadow-xl transition duration-300 group">
            
            <div>
              {hotel.image && (
                <a href={`/${hotel.slug}`} class="block relative h-56 overflow-hidden">
                  <img src={hotel.image} alt={hotel.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
                  <span class="absolute top-3 left-3 bg-[#0d3b23] text-emerald-300 text-[10px] font-black uppercase px-3 py-1 rounded-lg shadow border border-emerald-500/30">
                    {hotel.category}
                  </span>
                </a>
              )}
              
              <div class="p-6 space-y-2">
                <div class="flex justify-between items-center text-xs">
                  <span class="font-bold text-slate-500 flex items-center gap-1">
                    <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/></svg>
                    <span>{hotel.location}</span>
                  </span>
                  <span class="text-amber-500 font-black flex items-center gap-1">
                    <svg class="w-3.5 h-3.5 text-amber-500 fill-amber-500" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                    <span>{hotel.rating}</span>
                  </span>
                </div>

                <a href={`/${hotel.slug}`} class="block text-2xl font-black text-slate-900 group-hover:text-emerald-800 transition line-clamp-1">
                  {hotel.title}
                </a>

                <p class="text-xs text-slate-600 line-clamp-2 leading-relaxed pt-1">
                  {hotel.description}
                </p>
              </div>
            </div>

            <!-- Action Buttons ONLY (No Static Price text) -->
            <div class="p-6 pt-4 border-t border-slate-100 flex items-center justify-between gap-3">
              <button 
                data-title={hotel.title}
                data-slug={hotel.slug}
                class="open-price-modal flex-1 bg-[#0d3b23] hover:bg-emerald-900 text-white font-black py-3 px-3 rounded-xl text-xs uppercase tracking-wider shadow transition cursor-pointer text-center"
              >
                Check Price
              </button>

              <a 
                href={`/${hotel.slug}`} 
                class="flex-1 bg-slate-100 hover:bg-slate-200 text-slate-900 font-bold py-3 px-3 rounded-xl text-xs uppercase tracking-wider transition text-center"
              >
                Details
              </a>
            </div>

          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- REALTIME STAY22 PRICE COMPARISON POPUP MODAL -->
  <div id="priceModal" class="fixed inset-0 z-50 bg-slate-950/80 backdrop-blur-md hidden flex items-center justify-center p-4">
    <div class="bg-slate-900 border border-slate-800 rounded-3xl p-6 w-full max-w-md text-white space-y-4 shadow-2xl relative max-h-[85vh] overflow-y-auto">
      
      <!-- Modal Header -->
      <div class="flex items-center justify-between border-b border-slate-800 pb-3">
        <div>
          <span class="text-[10px] uppercase font-bold text-emerald-400 tracking-widest block">Live Stay22 API Match</span>
          <h3 id="modalHotelTitle" class="text-base font-black text-white font-serif">Compare Platform Rates</h3>
        </div>
        <button id="closePriceModalBtn" class="text-slate-400 hover:text-white text-2xl font-bold p-1 cursor-pointer">&times;</button>
      </div>

      <!-- Modal Rates Container -->
      <div id="modalRatesContainer" class="space-y-2.5">
        <div class="text-center py-8 bg-slate-950/60 rounded-2xl border border-slate-800 space-y-2">
          <span class="inline-block w-6 h-6 border-2 border-emerald-400 border-t-transparent rounded-full animate-spin"></span>
          <p class="text-xs font-bold text-slate-300">Fetching live rates from Stay22 API...</p>
        </div>
      </div>

      <!-- Modal Footer Actions -->
      <div class="pt-3 border-t border-slate-800">
        <a id="modalWhatsappBtn" href="https://wa.me/8801700000000" target="_blank" rel="noopener noreferrer" class="w-full bg-slate-800 hover:bg-slate-700 text-slate-200 font-bold text-xs py-3 rounded-xl border border-slate-700 transition flex items-center justify-center gap-2">
          <svg class="w-4 h-4 fill-emerald-400 shrink-0" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.892 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/></svg>
          <span>Instant WhatsApp Reservation</span>
        </a>
      </div>

    </div>
  </div>

  <!-- CLIENT SCRIPTS FOR READ MORE, CAROUSEL & LIVE STAY22 MODAL -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      // 1. Read More Toggle Script
      const readBtn = document.getElementById('read-more-btn');
      const extContent = document.getElementById('extended-content');
      const readText = document.getElementById('read-more-text');
      const readArrow = document.getElementById('read-more-arrow');

      if (readBtn && extContent && readText && readArrow) {
        readBtn.addEventListener('click', () => {
          const isHidden = extContent.classList.contains('hidden');
          if (isHidden) {
            extContent.classList.remove('hidden');
            readText.innerText = 'Read Less';
            readArrow.classList.add('rotate-180');
          } else {
            extContent.classList.add('hidden');
            readText.innerText = 'Read More';
            readArrow.classList.remove('rotate-180');
          }
        });
      }

      // 2. Popular Hotels Carousel Scroll Arrows
      const track = document.getElementById('popularCarouselTrack');
      const prevBtn = document.getElementById('popularPrevBtn');
      const nextBtn = document.getElementById('popularNextBtn');

      if (track && prevBtn && nextBtn) {
        prevBtn.addEventListener('click', () => {
          track.scrollBy({ left: -360, behavior: 'smooth' });
        });

        nextBtn.addEventListener('click', () => {
          track.scrollBy({ left: 360, behavior: 'smooth' });
        });
      }

      // 3. Realtime Stay22 API Price Comparison Modal Script
      const priceModal = document.getElementById('priceModal');
      const closePriceModalBtn = document.getElementById('closePriceModalBtn');
      const modalHotelTitle = document.getElementById('modalHotelTitle');
      const modalRatesContainer = document.getElementById('modalRatesContainer');
      const modalWhatsappBtn = document.getElementById('modalWhatsappBtn');

      if (closePriceModalBtn && priceModal) {
        closePriceModalBtn.addEventListener('click', () => {
          priceModal.classList.add('hidden');
        });
      }

      if (priceModal) {
        priceModal.addEventListener('click', (e) => {
          if (e.target === priceModal) {
            priceModal.classList.add('hidden');
          }
        });
      }

      document.querySelectorAll('.open-price-modal').forEach(btn => {
        btn.addEventListener('click', async (e) => {
          const target = e.currentTarget;
          const hotelTitle = target.getAttribute('data-title') || 'Hotel Details';

          if (modalHotelTitle) modalHotelTitle.textContent = hotelTitle;
          if (modalWhatsappBtn) {
            modalWhatsappBtn.href = `https://wa.me/8801700000000?text=${encodeURIComponent('Hi, I want to inquire about reservation at ' + hotelTitle)}`;
          }

          if (modalRatesContainer) {
            modalRatesContainer.innerHTML = `
              <div class="text-center py-8 bg-slate-950/60 rounded-2xl border border-slate-800 space-y-2">
                <span class="inline-block w-6 h-6 border-2 border-emerald-400 border-t-transparent rounded-full animate-spin"></span>
                <p class="text-xs font-bold text-slate-300">Fetching real-time prices for ${hotelTitle}...</p>
              </div>
            `;
          }

          if (priceModal) priceModal.classList.remove('hidden');

          try {
            const res = await fetch(`https://gatlin.rmollah394.workers.dev/?hotel=${encodeURIComponent(hotelTitle)}`);
            if (res.ok) {
              const json = await res.json();
              
              let rawResults = [];
              if (json && Array.isArray(json.results)) {
                rawResults = json.results;
              } else if (Array.isArray(json)) {
                rawResults = json;
              }

              const ignoreWords = ['hotel', 'dhaka', 'gulshan', 'bangladesh', 'the', 'by', 'an', 'ihg', 'resort', 'suites', 'apartments'];
              const targetKeywords = hotelTitle.toLowerCase()
                .split(/\s+/)
                .filter(word => word.length > 2 && !ignoreWords.includes(word));

              let deals = [];
              rawResults.forEach(item => {
                const itemName = (item.name || '').toLowerCase();
                const isMatch = targetKeywords.length === 0 || targetKeywords.some(keyword => itemName.includes(keyword));

                if (isMatch && item.suppliers && typeof item.suppliers === 'object') {
                  Object.entries(item.suppliers).forEach(([supplierKey, supplierData]) => {
                    const priceVal = supplierData.price && supplierData.price.total ? parseFloat(supplierData.price.total) : 0;
                    const linkUrl = supplierData.link || item.url || '#';
                    
                    const logoUrl = (supplierData.media && supplierData.media.logoSquare) 
                      ? supplierData.media.logoSquare 
                      : `https://r2.stay22.com/2025_${supplierKey}.png`;

                    let providerName = supplierKey.charAt(0).toUpperCase() + supplierKey.slice(1);
                    if (supplierKey === 'booking') providerName = 'Booking.com';
                    if (supplierKey === 'hotelscom') providerName = 'Hotels.com';
                    if (supplierKey === 'expedia') providerName = 'Expedia';
                    if (supplierKey === 'vrbo') providerName = 'Vrbo';

                    if (priceVal > 0) {
                      deals.push({
                        provider: providerName,
                        price: priceVal,
                        url: linkUrl,
                        logo: logoUrl
                      });
                    }
                  });
                }
              });

              deals.sort((a, b) => a.price - b.price);

              if (deals.length > 0 && modalRatesContainer) {
                modalRatesContainer.innerHTML = deals.map((item, idx) => `
                  <div class="flex items-center justify-between p-3 rounded-xl border ${idx === 0 ? 'bg-emerald-950/80 border-emerald-500/60' : 'bg-slate-950/60 border-slate-800'} transition">
                    <div class="flex items-center gap-2.5">
                      <div class="w-8 h-8 rounded-lg bg-white p-0.5 flex items-center justify-center shrink-0 overflow-hidden shadow-sm">
                        <img src="${item.logo}" alt="${item.provider} logo" class="w-full h-full object-contain" onerror="this.style.display='none'" />
                      </div>
                      <div>
                        <span class="text-xs font-bold text-white block leading-tight">${item.provider}</span>
                        ${idx === 0 ? '<span class="text-[9px] font-bold text-emerald-400 uppercase tracking-wider">Lowest Rate</span>' : ''}
                      </div>
                    </div>

                    <div class="flex items-center gap-2">
                      <span class="text-sm font-black text-white">$${item.price}</span>
                      <a href="${item.url}" target="_blank" rel="noopener noreferrer" class="${idx === 0 ? 'bg-[#00e676] text-slate-950' : 'bg-emerald-600 text-white'} text-[11px] font-extrabold px-3 py-1.5 rounded-lg transition shadow-md">
                        View deal ➔
                      </a>
                    </div>
                  </div>
                `).join('');
              } else if (modalRatesContainer) {
                modalRatesContainer.innerHTML = `<div class="p-4 text-center bg-slate-950/60 rounded-2xl border border-slate-800 text-slate-300 text-xs">No live rate entries returned from Stay22 API for "${hotelTitle}". Use WhatsApp below.</div>`;
              }
            }
          } catch (err) {
            if (modalRatesContainer) {
              modalRatesContainer.innerHTML = `<div class="p-4 text-center bg-slate-950/60 rounded-2xl border border-slate-800 text-slate-300 text-xs">Unable to connect to live pricing API. Use WhatsApp below.</div>`;
            }
          }
        });
      });
    });
  </script>

</Layout>
