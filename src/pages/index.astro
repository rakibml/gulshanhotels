---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

// ১. স্পন্সরড ডাটা লোড
let sponsorData = null;
try {
  const rawSponsor = import.meta.glob('../content/sponsored/*.md', { eager: true });
  const list = Object.values(rawSponsor);
  if (list && list.length > 0) {
    sponsorData = (list[0] as any).frontmatter;
  }
} catch (e) {
  sponsorData = null;
}

if (!sponsorData) {
  sponsorData = {
    enable: true,
    badge: "⭐ Editor's Choice",
    title: "The Westin Dhaka",
    category: "5-Star Luxury • Gulshan 2",
    rating: 4.8,
    image: "https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&w=800&q=80",
    buttonText: "Check Best Deal ➔",
    buttonLink: "/the-westin-dhaka"
  };
}

function toTitleCase(str: string) {
  if (!str) return 'Gulshan Hotel';
  return str.replace(/\w\S*/g, (txt) => txt.charAt(0).toUpperCase() + txt.substr(1).toLowerCase());
}

// ২. গুলশানের সব হোটেল লোড করা
let hotels: any[] = [];
try {
  const collectionData = await getCollection('hotels');
  if (collectionData && collectionData.length > 0) {
    hotels = collectionData.map((item: any) => ({
      slug: item.id || item.slug,
      title: toTitleCase(item.data?.title || item.data?.name || 'Gulshan Hotel'),
      category: item.data?.category || 'Luxury Hotel',
      location: item.data?.location || 'Gulshan 2, Dhaka',
      zone: (item.data?.location || '').toLowerCase().includes('gulshan 1') 
            ? 'gulshan-1' 
            : (item.data?.location || '').toLowerCase().includes('banani')
            ? 'banani'
            : 'gulshan-2',
      price: item.data?.price || '$$$$',
      rating: item.data?.rating || 4.8,
      image: item.data?.image || 'https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&w=800&q=80',
    }));
  }
} catch (err) {
  hotels = [];
}

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Which are the best 5-star luxury hotels in Gulshan, Dhaka?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The Westin Dhaka, Renaissance Dhaka Gulshan Hotel, Amari Dhaka, and Crowne Plaza Dhaka Gulshan are the leading 5-star luxury hotels offering world-class amenities and diplomatic security."
      }
    },
    {
      "@type": "Question",
      "name": "Which Gulshan hotels are closest to the US Embassy and Diplomatic Zone?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Hotels located in Gulshan 2 and the Diplomatic Zone—such as The Westin Dhaka, Amari Dhaka, and nearby boutique suites—are within 5 to 10 minutes of major embassies including the US, UK, and Indian High Commissions."
      }
    }
  ]
};
---

<Layout title="Gulshan Hotels - Official Directory & Luxury Accommodations Guide in Gulshan Dhaka">
  
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- HERO BANNER SECTION (3-COLUMN LAYOUT UTILIZING LEFT & RIGHT SPACES) -->
  <section class="relative bg-slate-950 text-white pb-20 pt-10 overflow-hidden">
    <!-- Background Image -->
    <div class="absolute inset-0 w-full h-full">
      <img 
        src="/hero-gulshan.jpg" 
        alt="Gulshan Dhaka City Skyline Evening View" 
        class="w-full h-full object-cover opacity-25" 
      />
      <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/75 to-slate-950/40"></div>
    </div>

    <div class="relative max-w-[1400px] mx-auto px-4 sm:px-6 lg:px-8 pt-8 pb-10">
      
      <!-- 3-Column Grid for Desktop -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
        
        <!-- LEFT COLUMN: DIRECTORY QUICK STATS (RED BOX 1) -->
        <div class="hidden lg:block lg:col-span-3">
          <div class="bg-slate-900/80 border border-slate-700/60 rounded-2xl p-5 backdrop-blur-md shadow-2xl space-y-4">
            <div class="border-b border-slate-800 pb-2">
              <span class="text-[10px] font-black uppercase tracking-widest text-emerald-400">Directory Highlights</span>
              <h3 class="text-sm font-bold text-white mt-0.5">Why Book In Gulshan?</h3>
            </div>

            <div class="space-y-3 text-xs">
              <div class="flex items-start gap-2.5">
                <span class="text-base bg-emerald-950/80 p-1.5 rounded-lg border border-emerald-500/30">🏨</span>
                <div>
                  <h4 class="font-bold text-white">25+ Verified Stays</h4>
                  <p class="text-[10px] text-slate-400">Gulshan 1, 2 & Diplomatic Zone</p>
                </div>
              </div>

              <div class="flex items-start gap-2.5">
                <span class="text-base bg-emerald-950/80 p-1.5 rounded-lg border border-emerald-500/30">⚡</span>
                <div>
                  <h4 class="font-bold text-white">Live Rate Comparison</h4>
                  <p class="text-[10px] text-slate-400">Agoda, Booking.com & Direct</p>
                </div>
              </div>

              <div class="flex items-start gap-2.5">
                <span class="text-base bg-emerald-950/80 p-1.5 rounded-lg border border-emerald-500/30">🛡️</span>
                <div>
                  <h4 class="font-bold text-white">Diplomatic Security</h4>
                  <p class="text-[10px] text-slate-400">Near US & Foreign Embassies</p>
                </div>
              </div>

              <div class="flex items-start gap-2.5">
                <span class="text-base bg-emerald-950/80 p-1.5 rounded-lg border border-emerald-500/30">⭐</span>
                <div>
                  <h4 class="font-bold text-white">4.8/5 Avg Rating</h4>
                  <p class="text-[10px] text-slate-400">Verified local guest reviews</p>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- CENTER COLUMN: MAIN HEADLINE & SUBTITLE -->
        <div class="lg:col-span-6 text-center space-y-4">
          <div class="inline-flex items-center gap-2 bg-emerald-500/20 border border-emerald-500/40 text-emerald-300 text-xs font-bold uppercase tracking-widest px-3.5 py-1.5 rounded-full backdrop-blur-md">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
            Official Gulshan Accommodations Directory & Travel Guide
          </div>

          <h1 class="text-3xl sm:text-5xl font-black tracking-tight text-white leading-tight">
            Find & Compare The Best <br class="hidden sm:inline" />
            <span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 to-teal-200">Hotels In Gulshan, Dhaka</span>
          </h1>

          <p class="text-xs sm:text-base text-slate-300 max-w-xl mx-auto font-normal leading-relaxed">
            Your official local guide to 5-star luxury stays, business accommodations, boutique suites, and real-time deal comparison across Gulshan 1, Gulshan 2 & Diplomatic Zone.
          </p>
        </div>

        <!-- RIGHT COLUMN: FEATURED HOTEL SPOTLIGHT MINI CARD (RED BOX 2) -->
        <div class="hidden lg:block lg:col-span-3">
          <div class="bg-slate-900/80 border border-slate-700/60 rounded-2xl p-4 backdrop-blur-md shadow-2xl space-y-3 group">
            
            <div class="relative h-32 rounded-xl overflow-hidden">
              <img 
                src="https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&w=600&q=80" 
                alt="The Westin Dhaka Spotlight" 
                class="w-full h-full object-cover group-hover:scale-105 transition duration-500" 
              />
              <span class="absolute top-2 left-2 bg-amber-500 text-slate-950 text-[10px] font-black uppercase px-2 py-0.5 rounded-full shadow">
                🔥 Hot Deal
              </span>
              <span class="absolute bottom-2 right-2 bg-slate-950/80 text-amber-400 text-[10px] font-black px-2 py-0.5 rounded border border-slate-700">
                ★ 4.8 / 5
              </span>
            </div>

            <div>
              <span class="text-[10px] font-bold text-emerald-400 uppercase">5-Star Luxury • Gulshan 2</span>
              <h4 class="text-sm font-black text-white leading-snug">The Westin Dhaka</h4>
              <p class="text-[11px] text-slate-400 mt-0.5">Prime Avenue Location • Spa & Pool</p>
            </div>

            <a 
              href="/the-westin-dhaka" 
              class="block w-full bg-emerald-600 hover:bg-emerald-500 text-white text-center font-extrabold text-xs py-2 rounded-xl transition shadow"
            >
              Check Deals ➔
            </a>
          </div>
        </div>

      </div>

    </div>
  </section>

  <!-- FLOATING FILTER BAR -->
  <div class="relative z-20 -mt-8 max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8">
    <div class="bg-white rounded-2xl sm:rounded-full border border-slate-200 shadow-xl p-2 sm:p-2.5 flex items-center justify-between gap-2 overflow-x-auto [scrollbar-width:none] [-ms-overflow-style:none] [&::-webkit-scrollbar]:hidden">
      
      <div class="flex items-center gap-2 shrink-0 w-full sm:w-auto overflow-x-auto">
        <button data-filter="all" class="filter-pill active bg-[#052e16] text-white font-extrabold text-xs sm:text-sm px-5 py-2.5 rounded-full transition flex items-center gap-2 shrink-0 shadow-md">
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M19 2H9c-1.1 0-2 .9-2 2v16c0 1.1.9 2 2 2h10c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm0 18H9V4h10v16z"/></svg>
          <span>All Gulshan</span>
        </button>

        <button data-filter="gulshan-1" class="filter-pill bg-white border border-slate-200 hover:bg-slate-50 text-slate-800 font-extrabold text-xs sm:text-sm px-5 py-2.5 rounded-full transition flex items-center gap-2 shrink-0">
          <svg class="w-4 h-4 fill-slate-700" viewBox="0 0 24 24"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7z"/></svg>
          <span>Gulshan 1</span>
        </button>

        <button data-filter="gulshan-2" class="filter-pill bg-white border border-slate-200 hover:bg-slate-50 text-slate-800 font-extrabold text-xs sm:text-sm px-5 py-2.5 rounded-full transition flex items-center gap-2 shrink-0">
          <svg class="w-4 h-4 fill-slate-700" viewBox="0 0 24 24"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7z"/></svg>
          <span>Gulshan 2</span>
        </button>

        <button data-filter="banani" class="filter-pill bg-white border border-slate-200 hover:bg-slate-50 text-slate-800 font-extrabold text-xs sm:text-sm px-5 py-2.5 rounded-full transition flex items-center gap-2 shrink-0">
          <svg class="w-4 h-4 fill-slate-700" viewBox="0 0 24 24"><path d="M12 7V3H2v18h20V7H12z"/></svg>
          <span>Banani</span>
        </button>

        <a href="#all-hotels" class="bg-white border border-slate-200 hover:bg-slate-50 text-slate-800 font-extrabold text-xs sm:text-sm px-5 py-2.5 rounded-full transition flex items-center gap-2 shrink-0">
          <svg class="w-4 h-4 fill-slate-700" viewBox="0 0 24 24"><path d="M20.5 3l-.16.03L15 5.1 9 3 3.36 4.9c-.21.07-.36.25-.36.48V20.5c0 .28.22.5.5.5l.16-.03L9 18.9l6 2.1 5.64-1.9c.21-.07.36-.25.36-.48V3.5c0-.28-.22-.5-.5-.5z"/></svg>
          <span>Show Map</span>
        </a>
      </div>

      <button id="toggleMoreFilters" class="bg-white border border-slate-200 hover:bg-slate-50 text-slate-800 font-extrabold text-xs sm:text-sm px-5 py-2.5 rounded-full transition flex items-center gap-2 shrink-0 ml-auto">
        <span>More Filters</span>
        <svg class="w-3.5 h-3.5 fill-slate-500" viewBox="0 0 24 24"><path d="M7 10l5 5 5-5z"/></svg>
      </button>

    </div>

    <!-- MORE FILTERS EXPANDABLE PANEL -->
    <div id="moreFiltersPanel" class="hidden mt-3 bg-white p-4 sm:p-6 rounded-2xl border border-slate-200 shadow-xl">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label class="block text-xs font-black text-slate-700 uppercase mb-1">Search Hotel Name</label>
          <input type="text" id="searchHotels" placeholder="e.g. Westin, Amari..." class="w-full bg-slate-50 border border-slate-300 focus:border-emerald-600 focus:bg-white rounded-xl px-4 py-2 text-xs outline-none" />
        </div>
        <div class="flex items-end">
          <button id="resetFilters" class="w-full bg-slate-100 hover:bg-slate-200 text-slate-800 font-extrabold text-xs py-2 rounded-xl transition">Reset Filters</button>
        </div>
      </div>
    </div>
  </div>

  <!-- WELCOME & LOCAL AUTHORITY SHOWCASE -->
  <section class="bg-slate-50 pt-16 pb-12 px-4 sm:px-8 lg:px-12 border-b border-slate-200">
    <div class="max-w-[1280px] mx-auto grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
      
      <div class="lg:col-span-7 space-y-4 text-left">
        <div class="inline-block border-b-2 border-emerald-600 pb-1">
          <span class="text-xs font-black uppercase tracking-widest text-emerald-800">WELCOME TO GULSHANHOTELS.COM</span>
        </div>

        <h2 class="text-2xl sm:text-4xl font-black text-slate-900 tracking-tight leading-tight">
          The Definitive Local Guide To Hotels In Gulshan, Dhaka
        </h2>

        <p class="text-slate-600 text-sm sm:text-base leading-relaxed">
          Welcome to **GulshanHotels.com**, your verified local authority for discovering luxury stays, executive business suites, and boutique hotels in Dhaka’s premier neighborhood. Whether you are visiting for diplomatic missions, embassy appointments, corporate conferences, or leisure travel, we provide real-time price comparison, unbiased local reviews, and verified hotel amenities.
        </p>

        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 pt-4 border-t border-slate-200">
          <div class="flex items-center space-x-2">
            <span class="text-lg">🔍</span>
            <div><h4 class="text-xs font-bold text-slate-900">Expert Reviews</h4><p class="text-[10px] text-slate-500">Local insights</p></div>
          </div>
          <div class="flex items-center space-x-2">
            <span class="text-lg">📸</span>
            <div><h4 class="text-xs font-bold text-slate-900">Real Photos</h4><p class="text-[10px] text-slate-500">Authentic views</p></div>
          </div>
          <div class="flex items-center space-x-2">
            <span class="text-lg">🏛️</span>
            <div><h4 class="text-xs font-bold text-slate-900">Diplomatic Zone</h4><p class="text-[10px] text-slate-500">Embassy stays</p></div>
          </div>
          <div class="flex items-center space-x-2">
            <span class="text-lg">🤝</span>
            <div><h4 class="text-xs font-bold text-slate-900">Direct Rates</h4><p class="text-[10px] text-slate-500">Live prices</p></div>
          </div>
        </div>
      </div>

      <!-- Sponsored Showcase -->
      <div class="lg:col-span-5">
        {sponsorData && sponsorData.enable ? (
          <div class="relative rounded-2xl overflow-hidden shadow-xl border border-slate-200 group bg-slate-900">
            <img src={sponsorData.image} alt={sponsorData.title} class="w-full h-72 sm:h-80 object-cover group-hover:scale-105 transition duration-500 opacity-90" />
            <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/20 to-transparent"></div>
            <div class="absolute top-4 left-4 bg-amber-500 text-slate-950 text-[11px] font-black uppercase px-3 py-1 rounded-full shadow-md">
              <span>{sponsorData.badge || "⭐ Editor's Choice"}</span>
            </div>
            <div class="absolute bottom-4 left-4 right-4 text-white flex justify-between items-end">
              <div>
                <span class="text-[11px] font-extrabold text-emerald-300 bg-slate-950/80 px-2.5 py-0.5 rounded border border-emerald-500/40">
                  {sponsorData.category}
                </span>
                <h3 class="text-2xl font-black text-white mt-1.5">{sponsorData.title}</h3>
              </div>
              <a href={sponsorData.buttonLink || "#all-hotels"} class="bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-extrabold px-4 py-2.5 rounded-lg shadow-lg transition shrink-0 ml-2">
                {sponsorData.buttonText || "Check Best Deal ➔"}
              </a>
            </div>
          </div>
        ) : null}
      </div>

    </div>
  </section>

  <!-- ALL GULSHAN HOTELS GRID -->
  <section id="all-hotels" class="py-16 px-4 sm:px-6 lg:px-8 max-w-[1280px] mx-auto">
    
    <div class="mb-8">
      <span class="text-xs font-black uppercase text-emerald-700 tracking-wider">Verified Directory</span>
      <h2 class="text-3xl sm:text-4xl font-black text-slate-900">
        All Hotels in Gulshan ({hotels.length})
      </h2>
    </div>

    <!-- Hotel Cards Grid -->
    <div id="hotelsGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {hotels.map((hotel) => (
        <div 
          class="hotel-card bg-white rounded-2xl border border-slate-200 shadow-sm hover:shadow-xl hover:-translate-y-1 transition duration-300 overflow-hidden flex flex-col group"
          data-zone={hotel.zone}
          data-title={hotel.title.toLowerCase()}
        >
          <div class="h-56 w-full overflow-hidden relative">
            <img src={hotel.image} alt={hotel.title} class="w-full h-full object-cover group-hover:scale-105 transition duration-500" />
            <div class="absolute top-3 right-3 bg-slate-900/85 backdrop-blur-md text-amber-400 text-xs font-black px-2.5 py-1 rounded-md border border-slate-700 shadow-md">
              ★ {hotel.rating}
            </div>
            <div class="absolute bottom-3 left-3 bg-emerald-950/90 text-emerald-300 text-[10px] font-black uppercase px-2.5 py-1 rounded-md border border-emerald-500/40 backdrop-blur-md">
              {hotel.category}
            </div>
          </div>

          <div class="p-5 flex flex-col flex-1 justify-between">
            <div>
              <h3 class="font-serif text-xl font-bold text-slate-900 mb-2 group-hover:text-emerald-700 transition">
                {hotel.title}
              </h3>

              <div class="flex items-center gap-1.5 text-xs text-slate-500 mb-6">
                <svg class="w-4 h-4 fill-emerald-600 shrink-0" viewBox="0 0 24 24">
                  <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
                </svg>
                <span class="line-clamp-1">{hotel.location}</span>
              </div>
            </div>

            <div class="pt-4 border-t border-slate-100 flex items-center justify-between">
              <div>
                <span class="text-[10px] uppercase text-slate-400 font-extrabold block">Price Range</span>
                <span class="font-black text-slate-900 text-base">{hotel.price}</span>
              </div>

              <a href={`/${hotel.slug}`} class="bg-emerald-600 hover:bg-emerald-500 text-white font-extrabold text-xs px-4 py-2.5 rounded-xl shadow-md transition flex items-center gap-1">
                View Details ➔
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Empty Result State -->
    <div id="noResults" class="hidden text-center py-16 bg-slate-50 rounded-2xl border border-dashed border-slate-300 mt-6">
      <span class="text-4xl">🏨</span>
      <h3 class="text-lg font-bold text-slate-800 mt-2">No hotels found</h3>
      <p class="text-xs text-slate-500 mt-1">Try selecting another filter or clearing your search.</p>
    </div>

  </section>

  <!-- SEO CONTENT SECTION 1: NEIGHBORHOOD AREA GUIDES -->
  <section class="py-16 bg-slate-900 text-white px-4 sm:px-6 lg:px-8 border-t border-slate-800">
    <div class="max-w-[1280px] mx-auto">
      
      <div class="text-center max-w-3xl mx-auto mb-12">
        <span class="text-xs font-black uppercase tracking-widest text-emerald-400 bg-emerald-950/80 px-3 py-1 rounded-full border border-emerald-500/30">
          Neighborhood Breakdown
        </span>
        <h2 class="text-3xl sm:text-4xl font-black text-white mt-3">
          Where To Stay In Gulshan, Dhaka: Area Comparison
        </h2>
        <p class="text-slate-400 text-sm mt-2">
          Understanding Gulshan’s zones helps you choose the perfect hotel for your diplomatic, business, or leisure visit.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        
        <div class="bg-slate-800/80 border border-slate-700/60 p-6 rounded-2xl space-y-3 backdrop-blur-sm">
          <div class="text-3xl">📍</div>
          <h3 class="text-xl font-bold text-white">Gulshan 1: Business Hub</h3>
          <p class="text-xs text-slate-300 leading-relaxed">
            Gulshan 1 is the vibrant commercial heartbeat of the area. Staying in Gulshan 1 offers easy access to major corporate headquarters, shopping plazas, and bustling dining avenues along Gulshan Avenue.
          </p>
          <ul class="text-[11px] text-emerald-400 font-bold space-y-1 pt-2 border-t border-slate-700">
            <li>✔ Top Hotels: Renaissance Dhaka Gulshan</li>
            <li>✔ Distance to Airport: ~30-40 mins</li>
          </ul>
        </div>

        <div class="bg-slate-800/80 border border-slate-700/60 p-6 rounded-2xl space-y-3 backdrop-blur-sm">
          <div class="text-3xl">⭐</div>
          <h3 class="text-xl font-bold text-white">Gulshan 2: 5-Star Luxury</h3>
          <p class="text-xs text-slate-300 leading-relaxed">
            Gulshan 2 represents the pinnacle of luxury accommodations in Bangladesh. Home to international 5-star hotel chains like The Westin and Amari, this neighborhood features upscale cafes, diplomatic residences, and lush parks.
          </p>
          <ul class="text-[11px] text-emerald-400 font-bold space-y-1 pt-2 border-t border-slate-700">
            <li>✔ Top Hotels: The Westin, Amari, Crowne Plaza</li>
            <li>✔ Key Attraction: Gulshan Circle 2 & Lake Park</li>
          </ul>
        </div>

        <div class="bg-slate-800/80 border border-slate-700/60 p-6 rounded-2xl space-y-3 backdrop-blur-sm">
          <div class="text-3xl">🏛️</div>
          <h3 class="text-xl font-bold text-white">Diplomatic Zone: Security</h3>
          <p class="text-xs text-slate-300 leading-relaxed">
