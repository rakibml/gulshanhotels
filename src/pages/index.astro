---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
---

<Layout title="Gulshan Hotels - Discover Gulshan's Finest Luxury Hotels">
  
  <!-- HERO SECTION ONLY -->
  <section class="relative bg-[#070D12] text-white py-20 sm:py-32 px-4 sm:px-8 lg:px-12 overflow-hidden min-h-[380px] sm:min-h-[460px] flex items-center">
    
    <!-- Background Image with Soft Gradient Overlay -->
    <div class="absolute inset-0 opacity-100 bg-cover bg-center" style="background-image: url('/hero-gulshan.jpg.webp');"></div>
    <div class="absolute inset-0 bg-gradient-to-r from-[#070D12] via-[#070D12]/75 to-transparent"></div>

    <div class="relative max-w-[1600px] mx-auto w-full text-center sm:text-left space-y-5">
      
      <!-- Crown Badge -->
      <div class="flex justify-center sm:justify-start">
        <span class="bg-[#D4AF37]/15 text-[#E8D8B0] text-xs font-black uppercase tracking-widest px-4 py-1.5 rounded-full border border-[#D4AF37]/40 shadow-md">
          👑 Dhaka's Premier Hotel Guide
        </span>
      </div>

      <!-- Main Headline -->
      <h1 class="text-3xl sm:text-6xl font-black tracking-tight leading-tight text-white max-w-4xl">
        Discover Gulshan's Finest <span class="text-[#D4AF37]">Luxury Hotels</span>
      </h1>
      
      <!-- Subtitle -->
      <p class="text-sm sm:text-lg text-slate-300 max-w-2xl leading-relaxed">
        Compare, book and experience the best hotels in the heart of Dhaka.
      </p>

    </div>
  </section>

  <!-- NEW SECTION: Floating Area Filter Bar (Matching input_file_89.png) -->
  <section class="bg-slate-50 relative z-20 -mt-6 sm:-mt-8 px-4 sm:px-8 lg:px-12">
    <div class="max-w-[1600px] mx-auto">
      <div class="bg-white p-2.5 sm:p-3.5 rounded-2xl shadow-xl border border-slate-200/80 flex items-center gap-2.5 sm:gap-3 overflow-x-auto no-scrollbar">
        
        <!-- Pill 1: All Gulshan (Active Dark Green Pill) -->
        <button class="bg-[#07120E] text-white hover:bg-emerald-950 px-4 py-2.5 rounded-full text-xs font-extrabold flex items-center space-x-2 shrink-0 shadow-sm transition">
          <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path></svg>
          <span>All Gulshan</span>
        </button>

        <!-- Pill 2: Gulshan 1 -->
        <button class="bg-white hover:bg-slate-50 text-slate-800 border border-slate-200 px-4 py-2.5 rounded-full text-xs font-extrabold flex items-center space-x-2 shrink-0 transition">
          <svg class="w-4 h-4 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path></svg>
          <span>Gulshan 1</span>
        </button>

        <!-- Pill 3: Gulshan 2 -->
        <button class="bg-white hover:bg-slate-50 text-slate-800 border border-slate-200 px-4 py-2.5 rounded-full text-xs font-extrabold flex items-center space-x-2 shrink-0 transition">
          <svg class="w-4 h-4 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path></svg>
          <span>Gulshan 2</span>
        </button>

        <!-- Pill 4: Banani -->
        <button class="bg-white hover:bg-slate-50 text-slate-800 border border-slate-200 px-4 py-2.5 rounded-full text-xs font-extrabold flex items-center space-x-2 shrink-0 transition">
          <svg class="w-4 h-4 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path></svg>
          <span>Banani</span>
        </button>

        <!-- Pill 5: Show Map -->
        <button class="bg-white hover:bg-slate-50 text-slate-800 border border-slate-200 px-4 py-2.5 rounded-full text-xs font-extrabold flex items-center space-x-2 shrink-0 transition">
          <svg class="w-4 h-4 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7"></path></svg>
          <span>Show Map</span>
        </button>

        <!-- Pill 6: More Filters Dropdown -->
        <button class="bg-white hover:bg-slate-50 text-slate-800 border border-slate-200 px-4 py-2.5 rounded-full text-xs font-extrabold flex items-center space-x-2 shrink-0 transition sm:ml-auto">
          <svg class="w-4 h-4 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4"></path></svg>
          <span>More Filters</span>
          <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
        </button>

      </div>
    </div>
  </section>

</Layout>
