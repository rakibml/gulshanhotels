    </section>

  </div>

  <!-- FLOATING INTERACTIVE FILTER CONSOLE -->
  <div class="relative z-20 -mt-5 sm:-mt-6 max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8">
    <div class="bg-white rounded-2xl sm:rounded-full border border-slate-200 shadow-2xl p-2 sm:p-2.5 flex items-center justify-between gap-2 overflow-x-auto [scrollbar-width:none] [-ms-overflow-style:none] [&::-webkit-scrollbar]:hidden">
      
      <div class="flex items-center gap-2 shrink-0 w-full sm:w-auto overflow-x-auto">
        <button data-filter="all" class="filter-pill active bg-[#052e16] text-white font-black text-xs sm:text-sm px-4 sm:px-5 py-2 sm:py-2.5 rounded-full transition flex items-center gap-2 shrink-0 shadow-md">
          <span>🏢 All Gulshan Hotels ({hotels.length})</span>
        </button>

        <button data-filter="gulshan-1" class="filter-pill bg-white border border-slate-200 hover:bg-slate-50 text-slate-800 font-bold text-xs sm:text-sm px-4 sm:px-5 py-2 sm:py-2.5 rounded-full transition flex items-center gap-2 shrink-0">
          <span>📍 Gulshan 1</span>
        </button>

        <button data-filter="gulshan-2" class="filter-pill bg-white border border-slate-200 hover:bg-slate-50 text-slate-800 font-bold text-xs sm:text-sm px-4 sm:px-5 py-2 sm:py-2.5 rounded-full transition flex items-center gap-2 shrink-0">
          <span>📍 Gulshan 2</span>
        </button>

        <button data-filter="banani" class="filter-pill bg-white border border-slate-200 hover:bg-slate-50 text-slate-800 font-bold text-xs sm:text-sm px-4 sm:px-5 py-2 sm:py-2.5 rounded-full transition flex items-center gap-2 shrink-0">
          <span>🏛️ Diplomatic Zone</span>
        </button>
      </div>

      <button id="toggleMoreFilters" class="bg-emerald-600 hover:bg-emerald-500 text-white font-extrabold text-xs sm:text-sm px-4 sm:px-5 py-2 sm:py-2.5 rounded-full transition flex items-center gap-2 shrink-0 ml-auto shadow-lg">
        <span>🔍 Search Hotel</span>
      </button>

    </div>

    <!-- EXPANDABLE SEARCH PANEL -->
    <div id="moreFiltersPanel" class="hidden mt-3 bg-white p-4 sm:p-5 rounded-2xl border border-slate-200 shadow-2xl">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label class="block text-xs font-black text-slate-700 uppercase mb-1">Search Hotel Name</label>
          <input type="text" id="searchHotels" placeholder="e.g. Westin, Amari, Renaissance..." class="w-full bg-slate-50 border border-slate-300 focus:border-emerald-600 focus:bg-white rounded-xl px-4 py-2.5 text-xs text-slate-900 outline-none" />
        </div>
        <div class="flex items-end">
          <button id="resetFilters" class="w-full bg-slate-100 hover:bg-slate-200 text-slate-800 font-extrabold text-xs py-2.5 rounded-xl transition">Clear Search</button>
        </div>
      </div>
    </div>
  </div>

  <!-- NEW 300+ WORDS RICH SEO CONTENT SECTION (CRITICAL FOR GOOGLE 1ST PAGE RANKING) -->
  <section class="pt-12 pb-8 px-4 sm:px-6 lg:px-8 max-w-[1280px] mx-auto">
    <div class="bg-white rounded-3xl p-6 sm:p-10 border border-slate-200 shadow-sm space-y-6">
      
      <!-- SEO Header -->
      <div class="border-b border-slate-100 pb-4">
        <span class="text-xs font-black uppercase text-emerald-800 tracking-wider">Official Destination Authority</span>
        <h2 class="text-2xl sm:text-3xl font-black text-slate-900 mt-1 font-serif">
          The Definitive Guide To Hotels & Accommodations In Gulshan, Dhaka
        </h2>
      </div>

      <!-- 300+ Words Structured SEO Content Body -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 text-xs sm:text-sm text-slate-600 leading-relaxed">
        
        <!-- Left SEO Column -->
        <div class="space-y-4">
          <p>
            Welcome to <strong>GulshanHotels.com</strong>, the official accommodation directory and verified local travel guide for Dhaka’s most prestigious neighborhood. Whether you are arriving for embassy diplomatic appointments, international corporate conferences, or luxury leisure travel, selecting the right hotel in Gulshan is essential for a seamless stay in Bangladesh.
          </p>
          <p>
            Gulshan is renowned as Dhaka’s primary diplomatic and financial district. Divided into <strong>Gulshan 1</strong>, <strong>Gulshan 2</strong>, and the <strong>Baridhara Diplomatic Enclosure</strong>, the area hosts foreign high commissions, multinational corporate headquarters, upscale shopping avenues, and international fine-dining restaurants.
          </p>
          <h3 class="text-sm font-bold text-slate-900 pt-2 border-t border-slate-100">
            5-Star Luxury vs Executive Business Stays
          </h3>
          <p>
            Travelers seeking world-class hospitality can choose from renowned 5-star hotel chains including <em>The Westin Dhaka</em>, <em>Renaissance Dhaka Gulshan Hotel</em>, <em>Amari Dhaka</em>, and <em>Crowne Plaza Dhaka Gulshan</em>. These luxury properties feature executive suites, rooftop infinity pools, heated spa facilities, and multi-cuisine buffet dining.
          </p>
        </div>

        <!-- Right SEO Column -->
        <div class="space-y-4">
          <h3 class="text-sm font-bold text-slate-900">
            Diplomatic Zone Security & Embassy Proximity
          </h3>
          <p>
            For foreign diplomats and government delegates, staying near the <strong>Baridhara Diplomatic Enclosure</strong> offers maximum peace of mind. Hotels in Gulshan 2 are positioned within 5 to 10 minutes of major embassies including the United States Embassy, British High Commission, Indian Visa Application Center, and Australian High Commission.
          </p>
          <p>
            Additionally, Gulshan offers unmatched transport connectivity. With direct access to the <strong>Dhaka Elevated Expressway</strong>, travel time from Hazrat Shahjalal International Airport (DAC) to Gulshan hotels is reduced to under 20 minutes, bypassing central city traffic.
          </p>
          <div class="bg-slate-50 p-4 rounded-2xl border border-slate-200">
            <h4 class="text-xs font-black text-slate-900 uppercase mb-1">
              ✔ Real-Time Rate Match Guarantee
            </h4>
            <p class="text-xs text-slate-500">
              We monitor live accommodation prices across Agoda, Booking.com, and official hotel reservation desks to ensure you secure the lowest verified rate for your stay.
            </p>
          </div>
        </div>

      </div>

    </div>
  </section>

  <!-- TRUST & AUTHORITY BADGES (4 KEY PILLARS) -->
  <section class="pb-10 px-4 sm:px-6 lg:px-8 max-w-[1280px] mx-auto">
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4">
      
      <div class="bg-white p-3.5 sm:p-4 rounded-2xl border border-slate-200 shadow-sm flex items-center gap-2.5 sm:gap-3">
        <span class="text-xl sm:text-2xl p-1.5 sm:p-2 bg-emerald-50 text-emerald-700 rounded-xl">🛡️</span>
        <div>
          <h3 class="text-[11px] sm:text-xs font-black text-slate-900 uppercase">100% Verified</h3>
          <p class="text-[10px] text-slate-500">Physically inspected stays</p>
        </div>
      </div>

      <div class="bg-white p-3.5 sm:p-4 rounded-2xl border border-slate-200 shadow-sm flex items-center gap-2.5 sm:gap-3">
        <span class="text-xl sm:text-2xl p-1.5 sm:p-2 bg-emerald-50 text-emerald-700 rounded-xl">⚡</span>
        <div>
          <h3 class="text-[11px] sm:text-xs font-black text-slate-900 uppercase">Live Price Match</h3>
          <p class="text-[10px] text-slate-500">Agoda, Booking & Direct</p>
        </div>
      </div>

      <div class="bg-white p-3.5 sm:p-4 rounded-2xl border border-slate-200 shadow-sm flex items-center gap-2.5 sm:gap-3">
        <span class="text-xl sm:text-2xl p-1.5 sm:p-2 bg-emerald-50 text-emerald-700 rounded-xl">🏛️</span>
        <div>
          <h3 class="text-[11px] sm:text-xs font-black text-slate-900 uppercase">Diplomatic Zone</h3>
          <p class="text-[10px] text-slate-500">Near US & Foreign Embassies</p>
        </div>
      </div>

      <div class="bg-white p-3.5 sm:p-4 rounded-2xl border border-slate-200 shadow-sm flex items-center gap-2.5 sm:gap-3">
        <span class="text-xl sm:text-2xl p-1.5 sm:p-2 bg-emerald-50 text-emerald-700 rounded-xl">📞</span>
        <div>
          <h3 class="text-[11px] sm:text-xs font-black text-slate-900 uppercase">Direct Booking</h3>
          <p class="text-[10px] text-slate-500">WhatsApp & Direct Calls</p>
        </div>
      </div>

    </div>
  </section>

  <!-- MAIN HOTEL DIRECTORY GRID -->
  <section id="all-hotels" class="py-8 sm:py-10 px-4 sm:px-6 lg:px-8 max-w-[1280px] mx-auto">
    
    <div class="flex justify-between items-end mb-6 sm:mb-8 border-b border-slate-200 pb-3 sm:pb-4">
      <div>
        <span class="text-xs font-black uppercase text-emerald-800 tracking-wider">Verified Accommodations</span>
        <h2 class="text-2xl sm:text-4xl font-black text-slate-900 font-serif">
          All Gulshan Hotels ({hotels.length})
        </h2>
      </div>
    </div>

    <!-- Hotel Cards Grid -->
    <div id="hotelsGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 sm:gap-6">
      {hotels.map((hotel) => (
        <div 
          class="hotel-card bg-white rounded-2xl border border-slate-200 shadow-md hover:shadow-2xl hover:-translate-y-1 transition duration-300 overflow-hidden flex flex-col group"
          data-zone={hotel.zone}
          data-title={hotel.title.toLowerCase()}
        >
          <div class="h-48 sm:h-56 w-full overflow-hidden relative">
            <img 
              src={hotel.image} 
              alt={hotel.title} 
              loading="lazy"
              decoding="async"
              class="w-full h-full object-cover group-hover:scale-105 transition duration-500" 
            />
            
            <div class="absolute top-3 left-3 bg-slate-950/90 text-emerald-300 text-[10px] font-black uppercase px-2.5 py-1 rounded-md border border-emerald-500/40 backdrop-blur-md shadow">
              ✔ Verified Entry
            </div>

            <div class="absolute top-3 right-3 bg-slate-900/85 backdrop-blur-md text-amber-400 text-xs font-black px-2.5 py-1 rounded-md border border-slate-700 shadow-md">
              ★ {hotel.rating}
            </div>

            <div class="absolute bottom-3 left-3 bg-emerald-950/90 text-emerald-300 text-[10px] font-black uppercase px-2.5 py-1 rounded-md border border-emerald-500/40 backdrop-blur-md">
              {hotel.category}
            </div>
          </div>

          <div class="p-4 sm:p-5 flex flex-col flex-1 justify-between">
            <div>
              <h3 class="font-serif text-lg sm:text-xl font-bold text-slate-900 mb-1.5 sm:mb-2 group-hover:text-emerald-700 transition">
                {hotel.title}
              </h3>

              <div class="flex items-center gap-1.5 text-xs text-slate-500 mb-4 sm:mb-6">
                <svg class="w-4 h-4 fill-emerald-600 shrink-0" viewBox="0 0 24 24">
                  <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
                </svg>
                <span class="line-clamp-1">{hotel.location}</span>
              </div>
            </div>

            <div class="pt-3 sm:pt-4 border-t border-slate-100 flex items-center justify-between">
              <div>
                <span class="text-[10px] uppercase text-slate-400 font-extrabold block">Price Range</span>
                <span class="font-black text-slate-900 text-sm sm:text-base">{hotel.price}</span>
              </div>

              <a href={`/${hotel.slug}`} class="bg-emerald-600 hover:bg-emerald-500 text-white font-extrabold text-xs px-3.5 sm:px-4 py-2 sm:py-2.5 rounded-xl shadow-md transition flex items-center gap-1">
                Compare Rates ➔
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>

  </section>

  <!-- INSTANT SEARCH & VIDEO CONTROLS SCRIPT -->
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const video = document.getElementById('heroVideo') as HTMLVideoElement;
      const toggleVideo = document.getElementById('toggleVideo');
      const toggleMute = document.getElementById('toggleMute');
      const pills = document.querySelectorAll('.filter-pill');
      const cards = document.querySelectorAll('.hotel-card');
      const searchInput = document.getElementById('searchHotels') as HTMLInputElement;
      const toggleMoreFilters = document.getElementById('toggleMoreFilters');
      const moreFiltersPanel = document.getElementById('moreFiltersPanel');

      let currentZone = 'all';

      // Video Controls
      if (video && toggleVideo) {
        toggleVideo.addEventListener('click', () => {
          if (video.paused) {
            video.play();
            toggleVideo.innerText = '⏸';
          } else {
            video.pause();
            toggleVideo.innerText = '▶';
          }
        });
      }

      if (video && toggleMute) {
        toggleMute.addEventListener('click', () => {
          video.muted = !video.muted;
          toggleMute.innerText = video.muted ? '🔊' : '🔇';
        });
      }

      // Filter Console
      if (toggleMoreFilters && moreFiltersPanel) {
        toggleMoreFilters.addEventListener('click', () => {
          moreFiltersPanel.classList.toggle('hidden');
        });
      }

      function applyFilter() {
        const query = searchInput ? searchInput.value.toLowerCase().trim() : '';

        cards.forEach((card) => {
          const el = card as HTMLElement;
          const zone = el.getAttribute('data-zone');
          const title = el.getAttribute('data-title') || '';

          const matchesZone = currentZone === 'all' || zone === currentZone;
          const matchesSearch = query === '' || title.includes(query);

          if (matchesZone && matchesSearch) {
            el.style.display = 'flex';
          } else {
            el.style.display = 'none';
          }
        });
      }

      pills.forEach((pill) => {
        pill.addEventListener('click', () => {
          pills.forEach((p) => {
            p.classList.remove('bg-[#052e16]', 'text-white', 'shadow-md');
            p.classList.add('bg-white', 'border', 'border-slate-200', 'text-slate-800');
          });

          pill.classList.remove('bg-white', 'border', 'border-slate-200', 'text-slate-800');
          pill.classList.add('bg-[#052e16]', 'text-white', 'shadow-md');

          currentZone = pill.getAttribute('data-filter') || 'all';
          applyFilter();
        });
      });

      if (searchInput) searchInput.addEventListener('input', applyFilter);
    });
  </script>

</Layout>
