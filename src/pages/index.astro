---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

// ১. স্পন্সরড ডাটা লোড
let sponsorData = null;
try {
  const rawSponsor = import.meta.glob('../content/sponsored/*.md', { eager: true });
  const list = Object.values(rawSponsor);
  if (list && list.length > 0) {
    sponsorData = (list[0] as any).frontmatter;
  }
} catch (e) {
  sponsorData = null;
}

if (!sponsorData) {
  sponsorData = {
    enable: true,
    badge: "🏛️ Official Featured Stay",
    title: "The Westin Dhaka",
    category: "5-Star Luxury • Gulshan 2 Diplomatic Zone",
    rating: 4.8,
    image: "https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&w=800&q=80",
    buttonText: "View Official Registry ➔",
    buttonLink: "/the-westin-dhaka"
  };
}

function toTitleCase(str: string) {
  if (!str) return 'Gulshan Hotel';
  return str.replace(/\w\S*/g, (txt) => txt.charAt(0).toUpperCase() + txt.substr(1).toLowerCase());
}

// ২. গুলশানের সব ভেরিফাইড হোটেল লোড করা
let hotels: any[] = [];
try {
  const collectionData = await getCollection('hotels');
  if (collectionData && collectionData.length > 0) {
    hotels = collectionData.map((item: any) => ({
      slug: item.id || item.slug,
      title: toTitleCase(item.data?.title || item.data?.name || 'Gulshan Hotel'),
      category: item.data?.category || 'Verified Luxury Stay',
      location: item.data?.location || 'Gulshan 2, Dhaka',
      zone: (item.data?.location || '').toLowerCase().includes('gulshan 1') 
            ? 'gulshan-1' 
            : (item.data?.location || '').toLowerCase().includes('banani')
            ? 'banani'
            : 'gulshan-2',
      price: item.data?.price || '$$$$',
      rating: item.data?.rating || 4.8,
      image: item.data?.image || 'https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&w=800&q=80',
    }));
  }
} catch (err) {
  hotels = [];
}

// Google JSON-LD Schema for Authority Directory
const authoritySchema = {
  "@context": "https://schema.org",
  "@type": "GovernmentPermit",
  "name": "Gulshan Accommodations Official Directory",
  "description": "The official accommodation directory and diplomatic travel guide for Gulshan 1, Gulshan 2, and Diplomatic Zone in Dhaka, Bangladesh.",
  "areaServed": "Gulshan, Dhaka, Bangladesh"
};
---

<Layout title="GulshanHotels.com — Official Accommodation Directory & Local Travel Authority for Gulshan, Dhaka">
  
  <script type="application/ld+json" set:html={JSON.stringify(authoritySchema)} />

  <!-- OFFICIAL AUTHORITY HERO HEADER SECTION -->
  <section class="relative bg-slate-950 text-white pt-12 pb-20 overflow-hidden border-b border-amber-500/20">
    
    <!-- Background Architectural Pattern & Image Overlay -->
    <div class="absolute inset-0 w-full h-full">
      <img 
        src="/hero-gulshan.jpg" 
        alt="Gulshan Dhaka Diplomatic District Skyline" 
        class="w-full h-full object-cover opacity-20" 
      />
      <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/85 to-slate-950/60"></div>
    </div>

    <div class="relative max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-6">
      
      <!-- Official Seal & Authority Badge -->
      <div class="inline-flex items-center gap-2.5 bg-gradient-to-r from-amber-500/20 via-emerald-500/20 to-amber-500/20 border border-amber-400/40 text-amber-200 text-xs font-black uppercase tracking-widest px-4 py-2 rounded-full backdrop-blur-md shadow-lg">
        <span class="text-base">🏛️</span>
        <span>OFFICIAL ACCOMMODATIONS DIRECTORY & DIPLOMATIC TRAVEL GUIDE</span>
      </div>

      <!-- Main Authority Title -->
      <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black tracking-tight text-white leading-tight max-w-4xl mx-auto font-serif">
        The Verified Lodging & Travel Authority For <span class="text-transparent bg-clip-text bg-gradient-to-r from-amber-300 via-emerald-300 to-teal-200">Gulshan, Dhaka</span>
      </h1>

      <p class="text-sm sm:text-base text-slate-300 max-w-3xl mx-auto leading-relaxed font-normal">
        Serving foreign diplomats, international delegations, corporate executives, and tourists with physically inspected hotels, verified direct contact channels, and real-time rate comparison across Gulshan 1, Gulshan 2 & Baridhara Diplomatic Enclosure.
      </p>

      <!-- Authority Quick Stats Counter Bar -->
      <div class="pt-6 grid grid-cols-2 md:grid-cols-4 gap-4 max-w-4xl mx-auto border-t border-slate-800">
        <div class="bg-slate-900/90 border border-slate-800 p-3.5 rounded-xl text-center">
          <span class="block text-2xl font-black text-amber-400">25+</span>
          <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider">Physically Inspected Stays</span>
        </div>
        <div class="bg-slate-900/90 border border-slate-800 p-3.5 rounded-xl text-center">
          <span class="block text-2xl font-black text-emerald-400">100%</span>
          <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider">Verified Direct Contacts</span>
        </div>
        <div class="bg-slate-900/90 border border-slate-800 p-3.5 rounded-xl text-center">
          <span class="block text-2xl font-black text-amber-400">3 Zones</span>
          <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider">Gulshan 1, 2 & Diplomatic</span>
        </div>
        <div class="bg-slate-900/90 border border-slate-800 p-3.5 rounded-xl text-center">
          <span class="block text-2xl font-black text-emerald-400">24/7</span>
          <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider">Direct Concierge Access</span>
        </div>
      </div>

    </div>
  </section>

  <!-- OFFICIAL FLOATING DIRECTORY CONSOLE -->
  <div class="relative z-20 -mt-8 max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8">
    <div class="bg-white rounded-2xl sm:rounded-full border border-slate-200 shadow-2xl p-2.5 flex items-center justify-between gap-2 overflow-x-auto [scrollbar-width:none] [-ms-overflow-style:none] [&::-webkit-scrollbar]:hidden">
      
      <div class="flex items-center gap-2 shrink-0 w-full sm:w-auto overflow-x-auto">
        <button data-filter="all" class="filter-pill active bg-[#052e16] text-white font-extrabold text-xs sm:text-sm px-5 py-2.5 rounded-full transition flex items-center gap-2 shrink-0 shadow-md">
          <span>🏢 All Verified Directory Entries</span>
        </button>

        <button data-filter="gulshan-1" class="filter-pill bg-white border border-slate-200 hover:bg-slate-50 text-slate-800 font-extrabold text-xs sm:text-sm px-5 py-2.5 rounded-full transition flex items-center gap-2 shrink-0">
          <span>📍 Gulshan 1 Business Hub</span>
        </button>

        <button data-filter="gulshan-2" class="filter-pill bg-white border border-slate-200 hover:bg-slate-50 text-slate-800 font-extrabold text-xs sm:text-sm px-5 py-2.5 rounded-full transition flex items-center gap-2 shrink-0">
          <span>⭐ Gulshan 2 Circle</span>
        </button>

        <button data-filter="banani" class="filter-pill bg-white border border-slate-200 hover:bg-slate-50 text-slate-800 font-extrabold text-xs sm:text-sm px-5 py-2.5 rounded-full transition flex items-center gap-2 shrink-0">
          <span>🏛️ Diplomatic Enclosure</span>
        </button>
      </div>

      <button id="toggleMoreFilters" class="bg-slate-100 hover:bg-slate-200 text-slate-900 font-extrabold text-xs sm:text-sm px-5 py-2.5 rounded-full transition flex items-center gap-2 shrink-0 ml-auto border border-slate-300">
        <span>🔍 Search Directory</span>
      </button>

    </div>

    <!-- MORE FILTERS / SEARCH PANEL -->
    <div id="moreFiltersPanel" class="hidden mt-3 bg-white p-5 rounded-2xl border border-slate-200 shadow-2xl">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label class="block text-xs font-black text-slate-700 uppercase mb-1">Search Official Directory</label>
          <input type="text" id="searchHotels" placeholder="e.g. Westin, Renaissance, Amari..." class="w-full bg-slate-50 border border-slate-300 focus:border-emerald-600 focus:bg-white rounded-xl px-4 py-2.5 text-xs outline-none" />
        </div>
        <div class="flex items-end">
          <button id="resetFilters" class="w-full bg-slate-100 hover:bg-slate-200 text-slate-800 font-extrabold text-xs py-2.5 rounded-xl transition">Reset Search Filter</button>
        </div>
      </div>
    </div>
  </div>

  <!-- DIPLOMATIC & EMBASSY PROXIMITY INDEX (AUTHORITY SPECIALTY) -->
  <section class="py-14 bg-slate-900 text-white px-4 sm:px-6 lg:px-8 border-b border-slate-800">
    <div class="max-w-[1280px] mx-auto">
      
      <div class="flex flex-col md:flex-row justify-between items-start md:items-end gap-4 mb-8 border-b border-slate-800 pb-4">
        <div>
          <span class="text-xs font-black uppercase tracking-widest text-amber-400">Embassy & Consulate Proximity Index</span>
          <h2 class="text-2xl sm:text-3xl font-black text-white mt-1 font-serif">
            Diplomatic Zone Hotel Distance Matrix
          </h2>
        </div>
        <span class="bg-emerald-950 text-emerald-300 text-xs font-bold px-3 py-1 rounded-full border border-emerald-500/30">
          ✔ High-Security Inspection Standards
        </span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        
        <div class="bg-slate-950 border border-slate-800 p-5 rounded-2xl space-y-2">
          <div class="flex justify-between items-center text-amber-400 font-bold text-xs">
            <span>🇺🇸 US Embassy & Indian High Comm.</span>
            <span>Gulshan 2 / Baridhara</span>
          </div>
          <h3 class="text-base font-bold text-white">United States & Indian Missions</h3>
          <p class="text-xs text-slate-400 leading-relaxed">
            Located within a 3-minute drive from Gulshan 2 Circle. Accommodations here feature 24/7 armed diplomatic police patrols and high-level fire/life safety compliance.
          </p>
        </div>

        <div class="bg-slate-950 border border-slate-800 p-5 rounded-2xl space-y-2">
          <div class="flex justify-between items-center text-amber-400 font-bold text-xs">
            <span>🇬🇧 UK & European Missions</span>
            <span>Diplomatic Enclosure</span>
          </div>
          <h3 class="text-base font-bold text-white">UK, German & French Embassies</h3>
          <p class="text-xs text-slate-400 leading-relaxed">
            Conveniently accessed from Road 79 and Madani Avenue. Hotels offer dedicated executive lounge spaces for international delegation meetings.
          </p>
        </div>

        <div class="bg-slate-950 border border-slate-800 p-5 rounded-2xl space-y-2">
          <div class="flex justify-between items-center text-amber-400 font-bold text-xs">
            <span>✈️ Express Airport Connectivity</span>
            <span>Elevated Expressway</span>
          </div>
          <h3 class="text-base font-bold text-white">Hazrat Shahjalal Int'l Airport (DAC)</h3>
          <p class="text-xs text-slate-400 leading-relaxed">
            Directly connected via the Dhaka Elevated Expressway ramp in Gulshan. Travel time to airport terminal is reduced to only 15–20 minutes.
          </p>
        </div>

      </div>

    </div>
  </section>

  <!-- OFFICIAL DIRECTORY GRID SECTION -->
  <section id="all-hotels" class="py-16 px-4 sm:px-6 lg:px-8 max-w-[1280px] mx-auto">
    
    <div class="flex justify-between items-end mb-8 border-b border-slate-200 pb-4">
      <div>
        <span class="text-xs font-black uppercase text-emerald-800 tracking-wider">Physically Verified Directory Entries</span>
        <h2 class="text-3xl sm:text-4xl font-black text-slate-900 font-serif">
          Official Gulshan Accommodations Registry ({hotels.length})
        </h2>
      </div>
    </div>

    <!-- Hotel Cards Grid with Official Stamps -->
    <div id="hotelsGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {hotels.map((hotel) => (
        <div 
          class="hotel-card bg-white rounded-2xl border border-slate-200 shadow-md hover:shadow-2xl hover:-translate-y-1 transition duration-300 overflow-hidden flex flex-col group"
          data-zone={hotel.zone}
          data-title={hotel.title.toLowerCase()}
        >
          <div class="h-56 w-full overflow-hidden relative">
            <img src={hotel.image} alt={hotel.title} class="w-full h-full object-cover group-hover:scale-105 transition duration-500" />
            
            <!-- Official Inspection Stamp -->
            <div class="absolute top-3 left-3 bg-slate-950/90 text-amber-300 text-[10px] font-black uppercase px-2.5 py-1 rounded-md border border-amber-500/40 backdrop-blur-md shadow flex items-center gap-1">
              <span>✔ Official Verified Entry</span>
            </div>

            <div class="absolute top-3 right-3 bg-slate-900/85 backdrop-blur-md text-amber-400 text-xs font-black px-2.5 py-1 rounded-md border border-slate-700 shadow-md">
              ★ {hotel.rating}
            </div>

            <div class="absolute bottom-3 left-3 bg-emerald-950/90 text-emerald-300 text-[10px] font-black uppercase px-2.5 py-1 rounded-md border border-emerald-500/40 backdrop-blur-md">
              {hotel.category}
            </div>
          </div>

          <div class="p-5 flex flex-col flex-1 justify-between">
            <div>
              <h3 class="font-serif text-xl font-bold text-slate-900 mb-2 group-hover:text-emerald-700 transition">
                {hotel.title}
              </h3>

              <div class="flex items-center gap-1.5 text-xs text-slate-500 mb-6">
                <svg class="w-4 h-4 fill-emerald-600 shrink-0" viewBox="0 0 24 24">
                  <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
                </svg>
                <span class="line-clamp-1">{hotel.location}</span>
              </div>
            </div>

            <div class="pt-4 border-t border-slate-100 flex items-center justify-between">
              <div>
                <span class="text-[10px] uppercase text-slate-400 font-extrabold block">Price Guidance</span>
                <span class="font-black text-slate-900 text-base">{hotel.price}</span>
              </div>

              <a href={`/${hotel.slug}`} class="bg-emerald-800 hover:bg-emerald-700 text-white font-extrabold text-xs px-4 py-2.5 rounded-xl shadow-md transition flex items-center gap-1">
                View Official Listing ➔
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>

  </section>

  <!-- ACCORDION FAQ SECTION (SEARCH ENGINE AUTHORITY & USER TRUST) -->
  <section class="py-16 bg-slate-50 px-4 sm:px-6 lg:px-8 border-t border-slate-200">
    <div class="max-w-[900px] mx-auto">
      
      <div class="text-center mb-10">
        <span class="text-xs font-black uppercase tracking-wider text-emerald-800">Official Travel Knowledge Desk</span>
        <h2 class="text-3xl font-black text-slate-900 mt-1 font-serif">
          Gulshan Lodging & Security FAQs
        </h2>
      </div>

      <div class="space-y-4">
        
        <details class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm group">
          <summary class="font-bold text-slate-900 text-sm sm:text-base cursor-pointer flex justify-between items-center">
            <span>How does GulshanHotels.com verify local accommodation entries?</span>
            <span class="text-emerald-600 transition group-open:rotate-180">▼</span>
          </summary>
          <p class="text-xs sm:text-sm text-slate-600 mt-3 leading-relaxed border-t border-slate-100 pt-3">
            Every property featured in our directory undergoes physical site inspection to verify room quality, emergency exit compliance, armed security protocols, and direct telephone/reservation authenticity.
          </p>
        </details>

        <details class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm group">
          <summary class="font-bold text-slate-900 text-sm sm:text-base cursor-pointer flex justify-between items-center">
            <span>Are hotels in Gulshan safe for foreign diplomats and international corporate delegates?</span>
            <span class="text-emerald-600 transition group-open:rotate-180">▼</span>
          </summary>
          <p class="text-xs sm:text-sm text-slate-600 mt-3 leading-relaxed border-t border-slate-100 pt-3">
            Yes, Gulshan 1, Gulshan 2, and Baridhara Diplomatic Enclosure are monitored by the Diplomatic Security Division of the Bangladesh Police. Properties featured in our 5-star and executive tiers maintain strict access control protocols.
          </p>
        </details>

      </div>

    </div>
  </section>

  <!-- INSTANT SEARCH SCRIPT -->
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const pills = document.querySelectorAll('.filter-pill');
      const cards = document.querySelectorAll('.hotel-card');
      const searchInput = document.getElementById('searchHotels') as HTMLInputElement;
      const toggleMoreFilters = document.getElementById('toggleMoreFilters');
      const moreFiltersPanel = document.getElementById('moreFiltersPanel');

      let currentZone = 'all';

      if (toggleMoreFilters && moreFiltersPanel) {
        toggleMoreFilters.addEventListener('click', () => {
          moreFiltersPanel.classList.toggle('hidden');
        });
      }

      function applyFilter() {
        const query = searchInput ? searchInput.value.toLowerCase().trim() : '';

        cards.forEach((card) => {
          const el = card as HTMLElement;
          const zone = el.getAttribute('data-zone');
          const title = el.getAttribute('data-title') || '';

          const matchesZone = currentZone === 'all' || zone === currentZone;
          const matchesSearch = query === '' || title.includes(query);

          if (matchesZone && matchesSearch) {
            el.style.display = 'flex';
          } else {
            el.style.display = 'none';
          }
        });
      }

      pills.forEach((pill) => {
        pill.addEventListener('click', () => {
          pills.forEach((p) => {
            p.classList.remove('bg-[#052e16]', 'text-white', 'shadow-md');
            p.classList.add('bg-white', 'border', 'border-slate-200', 'text-slate-800');
          });

          pill.classList.remove('bg-white', 'border', 'border-slate-200', 'text-slate-800');
          pill.classList.add('bg-[#052e16]', 'text-white', 'shadow-md');

          currentZone = pill.getAttribute('data-filter') || 'all';
          applyFilter();
        });
      });

      if (searchInput) searchInput.addEventListener('input', applyFilter);
    });
  </script>

</Layout>
