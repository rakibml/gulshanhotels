---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

// ১. স্পন্সরড ডাটা লোড
let sponsorData = null;
try {
  const rawSponsor = import.meta.glob('../content/sponsored/*.md', { eager: true });
  const list = Object.values(rawSponsor);
  if (list && list.length > 0) {
    sponsorData = (list[0] as any).frontmatter;
  }
} catch (e) {
  sponsorData = null;
}

if (!sponsorData) {
  sponsorData = {
    enable: true,
    badge: "⭐ Editor's Choice",
    title: "The Westin Dhaka",
    category: "5-Star Luxury • Gulshan 2",
    rating: 4.8,
    image: "https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&w=800&q=80",
    buttonText: "Check Best Deal ➔",
    buttonLink: "/the-westin-dhaka"
  };
}

function toTitleCase(str: string) {
  if (!str) return 'Gulshan Hotel';
  return str.replace(/\w\S*/g, (txt) => txt.charAt(0).toUpperCase() + txt.substr(1).toLowerCase());
}

// ২. গুলশানের সব ভেরিফাইড হোটেল লোড করা
let hotels: any[] = [];
try {
  const collectionData = await getCollection('hotels');
  if (collectionData && collectionData.length > 0) {
    hotels = collectionData.map((item: any) => ({
      slug: item.id || item.slug,
      title: toTitleCase(item.data?.title || item.data?.name || 'Gulshan Hotel'),
      category: item.data?.category || 'Luxury Hotel',
      location: item.data?.location || 'Gulshan 2, Dhaka',
      zone: (item.data?.location || '').toLowerCase().includes('gulshan 1') 
            ? 'gulshan-1' 
            : (item.data?.location || '').toLowerCase().includes('banani')
            ? 'banani'
            : 'gulshan-2',
      price: item.data?.price || '$$$$',
      rating: item.data?.rating || 4.8,
      image: item.data?.image || 'https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&w=800&q=80',
    }));
  }
} catch (err) {
  hotels = [];
}
---

<Layout title="Gulshan Hotels - Executive Luxury Accommodations Directory in Gulshan, Dhaka">
  
  <!-- VIRGIN HOTELS STYLE FULL-BLEED HERO BANNER -->
  <section class="relative min-h-[80vh] sm:min-h-[85vh] bg-slate-950 text-white flex flex-col justify-between overflow-hidden">
    
    <!-- Background Image with High Contrast Overlay -->
    <div class="absolute inset-0 w-full h-full">
      <img 
        src="https://images.unsplash.com/photo-1512917774080-9991f1c4c750?auto=format&fit=crop&w=2000&q=85" 
        alt="Gulshan Dhaka City Skyline Evening View" 
        class="w-full h-full object-cover opacity-50 scale-105 transform transition duration-1000" 
      />
      <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/60 to-slate-950/40"></div>
    </div>

    <!-- 1. VIRGIN-STYLE TRANSPARENT NAVBAR -->
    <header class="relative z-30 w-full border-b border-white/10 bg-gradient-to-b from-slate-950/90 to-transparent py-4 px-4 sm:px-8 lg:px-12">
      <div class="max-w-[1600px] mx-auto flex justify-between items-center">
        
        <!-- Brand Logo -->
        <a href="/" class="flex flex-col group">
          <span class="text-2xl sm:text-3xl font-black tracking-tight text-white leading-none group-hover:text-emerald-400 transition">
            GULSHAN<span class="text-emerald-400">HOTELS</span>
          </span>
          <span class="text-[9px] text-emerald-400 tracking-[0.3em] font-black uppercase mt-1">
            DHAKA • BANGLADESH
          </span>
        </a>

        <!-- Desktop Navigation Menu -->
        <nav class="hidden lg:flex items-center space-x-9 text-xs font-black tracking-widest uppercase text-slate-100">
          <a href="/" class="text-emerald-400 hover:text-emerald-300 transition border-b-2 border-emerald-400 pb-0.5">HOME</a>
          <a href="#all-hotels" class="hover:text-emerald-400 transition">HOTELS</a>
          <a href="#all-hotels" class="hover:text-emerald-400 transition">DEALS</a>
          <a href="/about" class="hover:text-emerald-400 transition">AREAS GUIDE</a>
          <a href="/about" class="hover:text-emerald-400 transition">CONTACT</a>
        </nav>

        <!-- Right Utilities -->
        <div class="flex items-center space-x-3 sm:space-x-5">
          <a href="#all-hotels" class="bg-emerald-600 hover:bg-emerald-500 text-white font-black text-xs tracking-wider uppercase px-5 py-2.5 rounded-full transition shadow-lg border border-emerald-400/30">
            BROWSE MAP
          </a>

          <button id="mobile-menu-btn" class="lg:hidden text-white hover:text-emerald-400 p-2 focus:outline-none">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path></svg>
          </button>
        </div>

      </div>

      <!-- Mobile Drawer -->
      <div id="mobile-menu" class="hidden lg:hidden bg-slate-900/95 border-t border-slate-800 px-5 py-5 space-y-3 font-extrabold text-xs text-white backdrop-blur-xl mt-3 rounded-2xl">
        <a href="/" class="block text-emerald-400 py-1">HOME</a>
        <a href="#all-hotels" class="block py-1">HOTELS</a>
        <a href="#all-hotels" class="block py-1">DEALS</a>
        <a href="/about" class="block py-1">AREAS GUIDE</a>
        <a href="/about" class="block py-1">CONTACT</a>
      </div>
    </header>

    <!-- 2. CENTER HERO TYPOGRAPHY (VIRGIN BOLD STATEMENT) -->
    <div class="relative z-10 max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8 text-center my-auto py-16 sm:py-24 space-y-4">
      
      <div class="inline-flex items-center gap-2 bg-emerald-500/20 border border-emerald-400/40 text-emerald-300 text-xs font-black uppercase tracking-widest px-4 py-1.5 rounded-full backdrop-blur-md">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        OFFICIAL GULSHAN ACCOMMODATIONS DIRECTORY
      </div>

      <h1 class="text-3xl sm:text-6xl lg:text-7xl font-black tracking-tight text-white uppercase leading-tight font-serif select-none drop-shadow-2xl">
        Executive Luxury & Stays In <br class="hidden sm:inline" />
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 via-teal-200 to-amber-300">
          Gulshan, Dhaka
        </span>
      </h1>

      <p class="text-xs sm:text-base text-slate-300 max-w-2xl mx-auto font-normal leading-relaxed">
        Your unbiased guide to 5-star luxury suites, diplomatic lodging, corporate stays, and real-time deal comparison.
      </p>

    </div>

    <!-- Bottom Wave Separator -->
    <div class="relative w-full overflow-hidden leading-none z-10 pointer-events-none">
      <svg class="relative block w-full h-8 sm:h-12 text-slate-900" viewBox="0 0 1200 120" preserveAspectRatio="none" fill="currentColor">
        <path d="M0,0 C150,90 350,-40 500,60 C650,160 900,10 1200,40 L1200,120 L0,120 Z"></path>
      </svg>
    </div>

  </section>

  <!-- 3. VIRGIN-STYLE FLOATING HORIZONTAL BOOKING / SEARCH CONSOLE -->
  <div class="relative z-20 -mt-6 sm:-mt-8 max-w-[1300px] mx-auto px-4 sm:px-6 lg:px-8">
    <div class="bg-white rounded-2xl sm:rounded-full border border-slate-200 shadow-2xl p-3 sm:p-4 text-slate-900 space-y-3">
      
      <!-- Zone Tabs Row -->
      <div class="flex flex-wrap items-center justify-center sm:justify-start gap-2 border-b border-slate-100 pb-3">
        <span class="text-xs font-black uppercase text-slate-400 mr-2 shrink-0">Filter Zone:</span>
        <button data-filter="all" class="filter-tab active bg-emerald-600 text-white font-black text-xs px-4 py-2 rounded-full transition shadow">
          🏢 All Gulshan ({hotels.length})
        </button>
        <button data-filter="gulshan-1" class="filter-tab bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-xs px-4 py-2 rounded-full transition">
          📍 Gulshan 1
        </button>
        <button data-filter="gulshan-2" class="filter-tab bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-xs px-4 py-2 rounded-full transition">
          📍 Gulshan 2
        </button>
        <button data-filter="banani" class="filter-tab bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-xs px-4 py-2 rounded-full transition">
          🏛️ Diplomatic Zone
        </button>
      </div>

      <!-- Search Input & CTA Button Row -->
      <div class="flex flex-col sm:flex-row items-center gap-3">
        <div class="relative w-full">
          <input 
            type="text" 
            id="searchHotels" 
            placeholder="Type hotel name (e.g. Westin, Amari, Renaissance)..." 
            class="w-full bg-slate-50 border border-slate-300 focus:border-emerald-600 focus:bg-white rounded-2xl px-4 py-3 text-xs sm:text-sm text-slate-900 placeholder-slate-400 outline-none transition"
          />
          <span class="absolute right-4 top-3.5 text-slate-400 text-sm">🔍</span>
        </div>

        <a href="#all-hotels" class="w-full sm:w-auto bg-emerald-600 hover:bg-emerald-500 text-white font-black text-xs sm:text-sm px-8 py-3.5 rounded-2xl transition shrink-0 shadow-lg flex items-center justify-center gap-2">
          <span>Search Hotels</span>
          <span>➔</span>
        </a>
      </div>

    </div>
  </div>

  <!-- 4. VIRGIN LIFESTYLE FEATURE BADGES -->
  <section class="pt-12 pb-10 px-4 sm:px-6 lg:px-8 max-w-[1280px] mx-auto text-white">
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4">
      
      <div class="bg-slate-900 p-4 rounded-2xl border border-slate-800 shadow-sm flex items-center gap-3">
        <span class="text-2xl p-2 bg-emerald-950 text-emerald-400 rounded-xl border border-emerald-500/20">🛡️</span>
        <div>
          <h3 class="text-xs font-black uppercase text-white">100% Verified</h3>
          <p class="text-[10px] text-slate-400">Inspected Physical Stays</p>
        </div>
      </div>

      <div class="bg-slate-900 p-4 rounded-2xl border border-slate-800 shadow-sm flex items-center gap-3">
        <span class="text-2xl p-2 bg-emerald-950 text-emerald-400 rounded-xl border border-emerald-500/20">⚡</span>
        <div>
          <h3 class="text-xs font-black uppercase text-white">Live Price Match</h3>
          <p class="text-[10px] text-slate-400">Agoda, Booking & Direct</p>
        </div>
      </div>

      <div class="bg-slate-900 p-4 rounded-2xl border border-slate-800 shadow-sm flex items-center gap-3">
        <span class="text-2xl p-2 bg-emerald-950 text-emerald-400 rounded-xl border border-emerald-500/20">🏛️</span>
        <div>
          <h3 class="text-xs font-black uppercase text-white">Diplomatic Zone</h3>
          <p class="text-[10px] text-slate-400">Near Foreign Embassies</p>
        </div>
      </div>

      <div class="bg-slate-900 p-4 rounded-2xl border border-slate-800 shadow-sm flex items-center gap-3">
        <span class="text-2xl p-2 bg-emerald-950 text-emerald-400 rounded-xl border border-emerald-500/20">📞</span>
        <div>
          <h3 class="text-xs font-black uppercase text-white">Direct Booking</h3>
          <p class="text-[10px] text-slate-400">WhatsApp & Direct Calls</p>
        </div>
      </div>

    </div>
  </section>

  <!-- 5. MAIN HOTEL DIRECTORY GRID -->
  <section id="all-hotels" class="py-10 px-4 sm:px-6 lg:px-8 max-w-[1280px] mx-auto text-white">
    
    <div class="flex justify-between items-end mb-8 border-b border-slate-800 pb-4">
      <div>
        <span class="text-xs font-black uppercase text-emerald-400 tracking-wider">Official Accommodations</span>
        <h2 class="text-3xl sm:text-4xl font-black text-white font-serif">
          All Gulshan Hotels ({hotels.length})
        </h2>
      </div>
    </div>

    <!-- Hotel Cards Grid -->
    <div id="hotelsGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {hotels.map((hotel) => (
        <div 
          class="hotel-card bg-slate-900 rounded-2xl border border-slate-800 shadow-md hover:shadow-2xl hover:-translate-y-1 transition duration-300 overflow-hidden flex flex-col group"
          data-zone={hotel.zone}
          data-title={hotel.title.toLowerCase()}
        >
          <div class="h-48 sm:h-56 w-full overflow-hidden relative">
            <img 
              src={hotel.image} 
              alt={hotel.title} 
              loading="lazy"
              decoding="async"
              class="w-full h-full object-cover group-hover:scale-105 transition duration-500" 
            />
            
            <div class="absolute top-3 left-3 bg-slate-950/90 text-emerald-300 text-[10px] font-black uppercase px-2.5 py-1 rounded-md border border-emerald-500/40 backdrop-blur-md shadow">
              ✔ Verified Entry
            </div>

            <div class="absolute top-3 right-3 bg-slate-950/85 backdrop-blur-md text-amber-400 text-xs font-black px-2.5 py-1 rounded-md border border-slate-800 shadow-md">
              ★ {hotel.rating}
            </div>

            <div class="absolute bottom-3 left-3 bg-emerald-950/90 text-emerald-300 text-[10px] font-black uppercase px-2.5 py-1 rounded-md border border-emerald-500/40 backdrop-blur-md">
              {hotel.category}
            </div>
          </div>

          <div class="p-4 sm:p-5 flex flex-col flex-1 justify-between">
            <div>
              <h3 class="font-serif text-lg sm:text-xl font-bold text-white mb-1.5 sm:mb-2 group-hover:text-emerald-400 transition">
                {hotel.title}
              </h3>

              <div class="flex items-center gap-1.5 text-xs text-slate-400 mb-4 sm:mb-6">
                <svg class="w-4 h-4 fill-emerald-500 shrink-0" viewBox="0 0 24 24">
                  <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
                </svg>
                <span class="line-clamp-1">{hotel.location}</span>
              </div>
            </div>

            <div class="pt-3 sm:pt-4 border-t border-slate-800 flex items-center justify-between">
              <div>
                <span class="text-[10px] uppercase text-slate-400 font-extrabold block">Price Range</span>
                <span class="font-black text-white text-sm sm:text-base">{hotel.price}</span>
              </div>

              <a href={`/${hotel.slug}`} class="bg-emerald-600 hover:bg-emerald-500 text-white font-extrabold text-xs px-4 py-2.5 rounded-xl shadow-md transition flex items-center gap-1">
                Compare Rates ➔
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>

  </section>

  <!-- INSTANT FILTER & SEARCH SCRIPT -->
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const tabs = document.querySelectorAll('.filter-tab');
      const cards = document.querySelectorAll('.hotel-card');
      const searchInput = document.getElementById('searchHotels') as HTMLInputElement;

      let currentZone = 'all';

      function applyFilter() {
        const query = searchInput ? searchInput.value.toLowerCase().trim() : '';

        cards.forEach((card) => {
          const el = card as HTMLElement;
          const zone = el.getAttribute('data-zone');
          const title = el.getAttribute('data-title') || '';

          const matchesZone = currentZone === 'all' || zone === currentZone;
          const matchesSearch = query === '' || title.includes(query);

          if (matchesZone && matchesSearch) {
            el.style.display = 'flex';
          } else {
            el.style.display = 'none';
          }
        });
      }

      tabs.forEach((tab) => {
        tab.addEventListener('click', () => {
          tabs.forEach((t) => {
            t.classList.remove('bg-emerald-600', 'text-white', 'shadow');
            t.classList.add('bg-slate-100', 'text-slate-700');
          });

          tab.classList.remove('bg-slate-100', 'text-slate-700');
          tab.classList.add('bg-emerald-600', 'text-white', 'shadow');

          currentZone = tab.getAttribute('data-filter') || 'all';
          applyFilter();
        });
      });

      if (searchInput) searchInput.addEventListener('input', applyFilter);
    });
  </script>

</Layout>
