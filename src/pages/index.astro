---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

// ১. স্পন্সরড ডাটা লোড
let sponsorData = null;
try {
  const rawSponsor = import.meta.glob('../content/sponsored/*.md', { eager: true });
  const list = Object.values(rawSponsor);
  if (list && list.length > 0) {
    sponsorData = (list[0] as any).frontmatter;
  }
} catch (e) {
  sponsorData = null;
}

if (!sponsorData) {
  sponsorData = {
    enable: true,
    badge: "⭐ Editor's Choice",
    title: "The Westin Dhaka",
    category: "5-Star Luxury • Gulshan 2",
    rating: 4.8,
    image: "https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&w=800&q=80",
    buttonText: "Check Best Deal ➔",
    buttonLink: "/the-westin-dhaka"
  };
}

function toTitleCase(str: string) {
  if (!str) return 'Gulshan Hotel';
  return str.replace(/\w\S*/g, (txt) => txt.charAt(0).toUpperCase() + txt.substr(1).toLowerCase());
}

// ২. গুলশানের সব ভেরিফাইড হোটেল লোড করা
let hotels: any[] = [];
try {
  const collectionData = await getCollection('hotels');
  if (collectionData && collectionData.length > 0) {
    hotels = collectionData.map((item: any) => ({
      slug: item.id || item.slug,
      title: toTitleCase(item.data?.title || item.data?.name || 'Gulshan Hotel'),
      category: item.data?.category || 'Luxury Hotel',
      location: item.data?.location || 'Gulshan 2, Dhaka',
      zone: (item.data?.location || '').toLowerCase().includes('gulshan 1') 
            ? 'gulshan-1' 
            : (item.data?.location || '').toLowerCase().includes('banani')
            ? 'banani'
            : 'gulshan-2',
      price: item.data?.price || '$$$$',
      rating: item.data?.rating || 4.8,
      image: item.data?.image || 'https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&w=800&q=80',
    }));
  }
} catch (err) {
  hotels = [];
}
---

<Layout title="Gulshan Hotels - Authentic Stays & Local Hospitality Guide in Gulshan, Dhaka">
  
  <!-- HERO SECTION CONTAINER -->
  <section class="relative bg-[#051a13] text-white min-h-[90vh] lg:min-h-screen overflow-hidden flex flex-col justify-between pb-12">
    
    <!-- Background Image with Natural Warm Night Glow -->
    <div class="absolute inset-0 w-full h-full">
      <img 
        src="https://images.unsplash.com/photo-1512917774080-9991f1c4c750?auto=format&fit=crop&w=2000&q=85" 
        alt="Gulshan Avenue Evening Night View" 
        class="w-full h-full object-cover opacity-50 scale-105" 
      />
      <!-- Natural Gradient Overlay without Heavy Flat Green Wash -->
      <div class="absolute inset-0 bg-gradient-to-r from-[#051a13]/90 via-[#051a13]/60 to-[#051a13]/70"></div>
    </div>

    <!-- 1. TRANSPARENT HEADER BAR -->
    <header class="relative z-30 w-full border-b border-[#c5a059]/20 bg-transparent py-4 px-4 sm:px-8 lg:px-12">
      <div class="max-w-[1600px] mx-auto flex justify-between items-center">
        
        <!-- Gold Leaf Logo -->
        <a href="/" class="flex items-center gap-3 group">
          <div class="w-10 h-10 rounded-full border border-[#c5a059] flex items-center justify-center text-[#c5a059] shadow-lg">
            <svg class="w-5 h-5 stroke-[#c5a059] fill-none" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8z"/>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 6v12M6 12h12"/>
            </svg>
          </div>
          <div class="flex flex-col">
            <span class="text-xl sm:text-2xl font-black font-['Playfair_Display'] tracking-widest text-white leading-none">
              GULSHAN HOTELS
            </span>
            <span class="text-[9px] text-[#c5a059] tracking-[0.25em] font-bold uppercase mt-1">
              AUTHENTIC STAYS. LOCAL EXPERTISE.
            </span>
          </div>
        </a>

        <!-- Center Nav Links -->
        <nav class="hidden lg:flex items-center space-x-8 text-xs font-bold tracking-widest uppercase text-slate-100">
          <a href="#all-hotels" class="hover:text-[#c5a059] transition">HOTEL REVIEWS</a>
          <a href="#about" class="hover:text-[#c5a059] transition">AREAS GUIDE</a>
          <a href="#all-hotels" class="hover:text-[#c5a059] transition">COLLECTIONS</a>
          <a href="#blog" class="hover:text-[#c5a059] transition">ARTICLES</a>
          <a href="#about" class="hover:text-[#c5a059] transition">ABOUT GULSHAN</a>
        </nav>

        <!-- Right Utilities -->
        <div class="flex items-center space-x-4">
          <button class="text-slate-200 hover:text-[#c5a059] transition p-1.5">
            <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24"><path d="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/></svg>
          </button>
          
          <button class="text-slate-200 hover:text-[#c5a059] transition p-1.5">
            <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>
          </button>

          <a href="#all-hotels" class="bg-[#0b291d] border border-[#c5a059]/60 hover:border-[#c5a059] text-[#c5a059] hover:text-white font-extrabold text-xs tracking-wider uppercase px-5 py-2.5 rounded-md transition shadow-md">
            EXPLORE GULSHAN
          </a>
        </div>

      </div>
    </header>

    <!-- 2. MAIN HERO CONTENT (EXACT TYPOGRAPHY & STATS CARD) -->
    <div class="relative z-10 max-w-[1500px] mx-auto px-4 sm:px-8 pt-8 sm:pt-12 pb-8 my-auto w-full">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
        
        <!-- Left Column: Master Typography -->
        <div class="lg:col-span-7 space-y-4 sm:space-y-6 text-left">
          
          <span class="text-xs font-bold uppercase tracking-[0.3em] text-[#c5a059]">
            AUTHENTIC STAYS. LOCAL EXPERTISE.
          </span>

          <h1 class="text-4xl sm:text-6xl lg:text-7xl font-black font-['Playfair_Display'] text-white leading-tight">
            Experience Gulshan, <br />
            <span class="italic font-normal text-[#c5a059]">Like a</span> <span class="text-[#c5a059]">Local</span>
          </h1>

          <p class="text-sm sm:text-base text-slate-200 max-w-xl font-normal leading-relaxed">
            Independent hotel reviews, local insights and curated recommendations to help you discover the very best of Gulshan.
          </p>

          <div class="pt-2 font-['Playfair_Display'] italic text-xl text-[#c5a059]">
            Stay better. Experience more.
          </div>

        </div>

        <!-- Right Column: "GULSHAN AT A GLANCE" Dark Green Card -->
        <div class="lg:col-span-5 flex justify-end">
          <div class="w-full max-w-sm bg-[#0b2c1f]/95 border border-[#c5a059]/30 rounded-2xl p-6 shadow-2xl backdrop-blur-md space-y-5">
            
            <div class="text-center border-b border-[#c5a059]/20 pb-3">
              <span class="text-xs font-bold uppercase tracking-[0.25em] text-[#c5a059]">
                GULSHAN AT A GLANCE
              </span>
            </div>

            <div class="space-y-4">
              <!-- Item 1: Thin Gold Vector Building Icon -->
              <div class="flex items-center gap-4">
                <div class="w-12 h-12 rounded-full bg-[#071f16] border border-[#c5a059]/30 flex items-center justify-center shrink-0">
                  <svg class="w-6 h-6 stroke-[#c5a059] fill-none" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5m0 0v-5a2 2 0 012-2h2a2 2 0 012 2v5m-6 0h6"/>
                  </svg>
                </div>
                <div>
                  <span class="block text-2xl font-black font-['Playfair_Display'] text-white leading-none">150+</span>
                  <span class="text-xs text-slate-300 mt-1 block">Hotels Reviewed</span>
                </div>
              </div>

              <!-- Item 2: Thin Gold Vector Map Pin Icon -->
              <div class="border-t border-[#c5a059]/15 pt-3.5 flex items-center gap-4">
                <div class="w-12 h-12 rounded-full bg-[#071f16] border border-[#c5a059]/30 flex items-center justify-center shrink-0">
                  <svg class="w-6 h-6 stroke-[#c5a059] fill-none" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                  </svg>
                </div>
                <div>
                  <span class="block text-2xl font-black font-['Playfair_Display'] text-white leading-none">8</span>
                  <span class="text-xs text-slate-300 mt-1 block">Areas Covered</span>
                </div>
              </div>

              <!-- Item 3: Thin Gold Vector Outline Star Icon -->
              <div class="border-t border-[#c5a059]/15 pt-3.5 flex items-center gap-4">
                <div class="w-12 h-12 rounded-full bg-[#071f16] border border-[#c5a059]/30 flex items-center justify-center shrink-0">
                  <svg class="w-6 h-6 stroke-[#c5a059] fill-none" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"/>
                  </svg>
                </div>
                <div>
                  <span class="block text-2xl font-black font-['Playfair_Display'] text-white leading-none">5000+</span>
                  <span class="text-xs text-slate-300 mt-1 block">Verified Guest Reviews</span>
                </div>
              </div>

              <!-- Item 4: Thin Gold Vector Shield Checkmark Icon -->
              <div class="border-t border-[#c5a059]/15 pt-3.5 flex items-center gap-4">
                <div class="w-12 h-12 rounded-full bg-[#071f16] border border-[#c5a059]/30 flex items-center justify-center shrink-0">
                  <svg class="w-6 h-6 stroke-[#c5a059] fill-none" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
                  </svg>
                </div>
                <div>
                  <span class="block text-2xl font-black font-['Playfair_Display'] text-white leading-none">100%</span>
                  <span class="text-xs text-slate-300 mt-1 block">Independent & Unbiased</span>
                </div>
              </div>
            </div>

          </div>
        </div>

      </div>
    </div>

    <!-- 3. FLOATING WHITE BOOKING CONSOLE (EXACT MATCD TO MOCKUP) -->
    <div class="relative z-20 max-w-[1300px] mx-auto px-4 w-full -mb-16">
      <div class="bg-white text-slate-800 rounded-3xl p-6 sm:p-8 shadow-2xl border border-slate-100">
        
        <div class="mb-4">
          <h3 class="text-xl font-['Playfair_Display'] italic text-[#0b291d] border-b-2 border-[#c5a059] inline-block pb-1">
            Find your perfect stay
          </h3>
        </div>

        <!-- 4 Fields & Search Button Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-3 items-center">
          
          <!-- Field 1 -->
          <div class="bg-slate-50 border border-slate-200 rounded-xl p-3 text-left">
            <span class="block text-[10px] font-black uppercase text-slate-400">WHERE TO?</span>
            <div class="flex justify-between items-center text-xs font-bold text-slate-800 mt-1">
              <span>Search areas or hotels</span>
              <svg class="w-4 h-4 fill-slate-400" viewBox="0 0 24 24"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>
            </div>
          </div>

          <!-- Field 2 -->
          <div class="bg-slate-50 border border-slate-200 rounded-xl p-3 text-left">
            <span class="block text-[10px] font-black uppercase text-slate-400">CHECK-IN</span>
            <div class="flex justify-between items-center text-xs font-bold text-slate-800 mt-1">
              <span>Add date</span>
              <svg class="w-4 h-4 stroke-slate-400 fill-none" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
            </div>
          </div>

          <!-- Field 3 -->
          <div class="bg-slate-50 border border-slate-200 rounded-xl p-3 text-left">
            <span class="block text-[10px] font-black uppercase text-slate-400">CHECK-OUT</span>
            <div class="flex justify-between items-center text-xs font-bold text-slate-800 mt-1">
              <span>Add date</span>
              <svg class="w-4 h-4 stroke-slate-400 fill-none" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
            </div>
          </div>

          <!-- Field 4 -->
          <div class="bg-slate-50 border border-slate-200 rounded-xl p-3 text-left">
            <span class="block text-[10px] font-black uppercase text-slate-400">GUESTS</span>
            <div class="flex justify-between items-center text-xs font-bold text-slate-800 mt-1">
              <span>2 Guests</span>
              <svg class="w-4 h-4 fill-slate-400" viewBox="0 0 24 24"><path d="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5z"/></svg>
            </div>
          </div>

          <!-- Search Button -->
          <div>
            <a href="#all-hotels" class="w-full bg-[#0b291d] hover:bg-[#061e14] text-white font-extrabold text-xs tracking-wider uppercase py-4 rounded-xl shadow-lg transition flex items-center justify-center gap-2">
              <span>SEARCH HOTELS</span>
              <span>➔</span>
            </a>
          </div>

        </div>

      </div>
    </div>

  </section>

  <!-- 4. POPULAR AREAS QUICK BAR -->
  <section class="bg-[#f7f5f0] pt-24 pb-8 px-4 max-w-[1300px] mx-auto">
    <div class="flex flex-wrap items-center justify-center gap-4 sm:gap-6 text-xs font-extrabold text-slate-700 border-b border-slate-300 pb-6">
      <span class="text-[#c5a059] uppercase tracking-widest">POPULAR AREAS:</span>
      
      <a href="#all-hotels" class="flex items-center gap-1.5 hover:text-emerald-800 transition">
        <span>🏢</span> Gulshan 1
      </a>
      <span class="text-slate-300">•</span>

      <a href="#all-hotels" class="flex items-center gap-1.5 hover:text-emerald-800 transition">
        <span>🏢</span> Gulshan 2
      </a>
      <span class="text-slate-300">•</span>

      <a href="#all-hotels" class="flex items-center gap-1.5 hover:text-emerald-800 transition">
        <span>🏢</span> Banani
      </a>
      <span class="text-slate-300">•</span>

      <a href="#all-hotels" class="flex items-center gap-1.5 hover:text-emerald-800 transition">
        <span>🛡️</span> Niketon
      </a>
      <span class="text-slate-300">•</span>

      <a href="#all-hotels" class="flex items-center gap-1.5 hover:text-emerald-800 transition">
        <span>🏛️</span> Baridhara
      </a>

      <a href="#all-hotels" class="text-[#c5a059] hover:underline ml-2">
        View all areas ➔
      </a>
    </div>

    <!-- Scroll Indicator -->
    <div class="text-center pt-8">
      <span class="block text-[10px] font-black uppercase tracking-[0.3em] text-slate-400">
        SCROLL TO DISCOVER
      </span>
      <span class="inline-block mt-2 text-lg text-slate-500 animate-bounce">↓</span>
    </div>
  </section>

  <!-- 5. MAIN HOTEL DIRECTORY GRID -->
  <section id="all-hotels" class="py-12 px-4 sm:px-6 lg:px-8 max-w-[1280px] mx-auto text-slate-800">
    
    <div class="flex justify-between items-end mb-8 border-b border-slate-200 pb-4">
      <div>
        <span class="text-xs font-black uppercase text-[#c5a059] tracking-wider">Official Accommodations</span>
        <h2 class="text-3xl sm:text-4xl font-black text-slate-900 font-serif">
          All Gulshan Hotels ({hotels.length})
        </h2>
      </div>
    </div>

    <!-- Hotel Cards Grid -->
    <div id="hotelsGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {hotels.map((hotel) => (
        <div 
          class="hotel-card bg-white rounded-2xl border border-slate-200 shadow-md hover:shadow-2xl hover:-translate-y-1 transition duration-300 overflow-hidden flex flex-col group"
          data-zone={hotel.zone}
          data-title={hotel.title.toLowerCase()}
        >
          <div class="h-48 sm:h-56 w-full overflow-hidden relative">
            <img 
              src={hotel.image} 
              alt={hotel.title} 
              loading="lazy"
              decoding="async"
              class="w-full h-full object-cover group-hover:scale-105 transition duration-500" 
            />
            
            <div class="absolute top-3 left-3 bg-[#061e14]/90 text-[#c5a059] text-[10px] font-black uppercase px-2.5 py-1 rounded-md border border-[#c5a059]/40 backdrop-blur-md shadow">
              ✔ Verified Entry
            </div>

            <div class="absolute top-3 right-3 bg-slate-900/85 backdrop-blur-md text-amber-400 text-xs font-black px-2.5 py-1 rounded-md border border-slate-700 shadow-md">
              ★ {hotel.rating}
            </div>

            <div class="absolute bottom-3 left-3 bg-[#061e14]/90 text-slate-200 text-[10px] font-black uppercase px-2.5 py-1 rounded-md border border-[#c5a059]/40 backdrop-blur-md">
              {hotel.category}
            </div>
          </div>

          <div class="p-4 sm:p-5 flex flex-col flex-1 justify-between">
            <div>
              <h3 class="font-serif text-lg sm:text-xl font-bold text-slate-900 mb-1.5 sm:mb-2 group-hover:text-emerald-800 transition">
                {hotel.title}
              </h3>

              <div class="flex items-center gap-1.5 text-xs text-slate-500 mb-4 sm:mb-6">
                <svg class="w-4 h-4 fill-[#c5a059] shrink-0" viewBox="0 0 24 24">
                  <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
                </svg>
                <span class="line-clamp-1">{hotel.location}</span>
              </div>
            </div>

            <div class="pt-3 sm:pt-4 border-t border-slate-100 flex items-center justify-between">
              <div>
                <span class="text-[10px] uppercase text-slate-400 font-extrabold block">Price Range</span>
                <span class="font-black text-slate-900 text-sm sm:text-base">{hotel.price}</span>
              </div>

              <a href={`/${hotel.slug}`} class="bg-[#0b291d] hover:bg-[#061e14] text-white font-extrabold text-xs px-4 py-2.5 rounded-xl shadow-md transition flex items-center gap-1">
                Compare Rates ➔
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>

  </section>

</Layout>
