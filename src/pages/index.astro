---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

// ১. স্পন্সরড ডাটা লোড
let sponsorData = null;
try {
  const rawSponsor = import.meta.glob('../content/sponsored/*.md', { eager: true });
  const list = Object.values(rawSponsor);
  if (list && list.length > 0) {
    sponsorData = (list[0] as any).frontmatter;
  }
} catch (e) {
  sponsorData = null;
}

if (!sponsorData) {
  sponsorData = {
    enable: true,
    badge: "⭐ Editor's Choice",
    title: "The Westin Dhaka",
    category: "5-Star Luxury • Gulshan 2",
    rating: 4.8,
    image: "https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&w=800&q=80",
    buttonText: "Check Best Deal ➔",
    buttonLink: "/the-westin-dhaka"
  };
}

function toTitleCase(str: string) {
  if (!str) return 'Gulshan Hotel';
  return str.replace(/\w\S*/g, (txt) => txt.charAt(0).toUpperCase() + txt.substr(1).toLowerCase());
}

// ২. গুলশানের সব ভেরিফাইড হোটেল লোড করা
let hotels: any[] = [];
try {
  const collectionData = await getCollection('hotels');
  if (collectionData && collectionData.length > 0) {
    hotels = collectionData.map((item: any) => ({
      slug: item.id || item.slug,
      title: toTitleCase(item.data?.title || item.data?.name || 'Gulshan Hotel'),
      category: item.data?.category || 'Luxury Hotel',
      location: item.data?.location || 'Gulshan 2, Dhaka',
      zone: (item.data?.location || '').toLowerCase().includes('gulshan 1') 
            ? 'gulshan-1' 
            : (item.data?.location || '').toLowerCase().includes('banani')
            ? 'banani'
            : (item.data?.location || '').toLowerCase().includes('niketon')
            ? 'niketon'
            : (item.data?.location || '').toLowerCase().includes('baridhara')
            ? 'baridhara'
            : 'gulshan-2',
      price: item.data?.price || '$$$$',
      rating: item.data?.rating || 4.8,
      image: item.data?.image || 'https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&w=800&q=80',
    }));
  }
} catch (err) {
  hotels = [];
}
---

<Layout title="Gulshan Hotels - Authentic Stays & Local Hospitality Guide in Gulshan, Dhaka">
  
  <!-- ARTISTIC ILLUSTRATED VECTOR HERO SECTION (NO HEAVY IMAGES) -->
  <section class="relative bg-[#041810] text-white min-h-[85vh] lg:min-h-[90vh] overflow-hidden flex flex-col justify-between">
    
    <!-- ARTISTIC SVG BACKGROUND DRAWING (GULSHAN SKYLINE & LAKE VECTOR ARTWORK) -->
    <div class="absolute inset-0 w-full h-full pointer-events-none overflow-hidden">
      
      <!-- Gradient Radial Glow -->
      <div class="absolute top-1/3 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[400px] bg-emerald-500/10 blur-[130px] rounded-full"></div>
      <div class="absolute top-10 right-10 w-[300px] h-[300px] bg-[#c5a059]/10 blur-[100px] rounded-full"></div>

      <!-- Vector Architectural Line Art Drawing of Gulshan Skyline & Buildings -->
      <svg class="absolute bottom-12 left-0 w-full h-[280px] text-[#c5a059]/15" viewBox="0 0 1440 320" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M0,224 L60,213.3 C120,203 240,181 360,186.7 C480,192 600,224 720,229.3 C840,235 960,213 1080,197.3 C1200,181 1320,171 1380,165.3 L1440,160 L1440,320 L1380,320 C1320,320 1200,320 1080,320 C960,320 840,320 720,320 C600,320 480,320 360,320 C240,320 120,320 60,320 L0,320 Z" fill="currentColor"></path>
        <!-- Building Silhouette Strokes -->
        <path d="M100 320V120H180V320M220 320V80H320V320M360 320V160H440V320M520 320V60H640V320M700 320V140H800V320M860 320V100H960V320M1020 320V180H1120V320M1180 320V90H1300V320" stroke="currentColor" stroke-width="1.5" stroke-dasharray="4 4" opacity="0.4"></path>
      </svg>

      <!-- Abstract Gold Vector Geometric Grid Lines -->
      <svg class="absolute top-0 right-0 w-full h-full text-[#c5a059]/5 opacity-40" viewBox="0 0 100 100" preserveAspectRatio="none">
        <path d="M0 0 L100 100 M100 0 L0 100 M50 0 L50 100 M0 50 L100 50" stroke="currentColor" stroke-width="0.2"></path>
      </svg>
    </div>

    <!-- 1. TRANSPARENT HEADER BAR -->
    <header class="relative z-30 w-full border-b border-[#c5a059]/20 bg-transparent py-4 px-4 sm:px-8 lg:px-12">
      <div class="max-w-[1600px] mx-auto flex justify-between items-center">
        
        <!-- Gold Leaf Logo -->
        <a href="/" class="flex items-center gap-3 group">
          <div class="w-10 h-10 rounded-full border border-[#c5a059] flex items-center justify-center text-[#c5a059] shadow-lg">
            <svg class="w-5 h-5 stroke-[#c5a059] fill-none" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8z"/>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 6v12M6 12h12"/>
            </svg>
          </div>
          <div class="flex flex-col">
            <span class="text-xl sm:text-2xl font-black font-['Cormorant_Garamond'] tracking-widest text-white leading-none">
              GULSHAN HOTELS
            </span>
            <span class="text-[9px] text-[#c5a059] tracking-[0.25em] font-bold uppercase mt-1">
              AUTHENTIC STAYS. LOCAL EXPERTISE.
            </span>
          </div>
        </a>

        <!-- Center Nav Links -->
        <nav class="hidden lg:flex items-center space-x-8 text-xs font-bold tracking-widest uppercase text-slate-100">
          <a href="#all-hotels" class="hover:text-[#c5a059] transition">HOTEL REVIEWS</a>
          <a href="#popular-areas" class="hover:text-[#c5a059] transition">AREAS GUIDE</a>
          <a href="#all-hotels" class="hover:text-[#c5a059] transition">COLLECTIONS</a>
          <a href="#blog" class="hover:text-[#c5a059] transition">ARTICLES</a>
          <a href="#about" class="hover:text-[#c5a059] transition">ABOUT GULSHAN</a>
        </nav>

        <!-- Right Utilities -->
        <div class="flex items-center space-x-4">
          <button class="text-slate-200 hover:text-[#c5a059] transition p-1.5">
            <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24"><path d="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/></svg>
          </button>

          <a href="#all-hotels" class="bg-[#0b291d] border border-[#c5a059]/60 hover:border-[#c5a059] text-[#c5a059] hover:text-white font-extrabold text-xs tracking-wider uppercase px-5 py-2.5 rounded-md transition shadow-md">
            EXPLORE
          </a>
        </div>

      </div>
    </header>

    <!-- 2. MAIN HERO CONTENT AREA (ILLUSTRATED ARTWORK BACKGROUND) -->
    <div class="relative z-10 max-w-[1400px] mx-auto px-4 sm:px-8 py-10 sm:py-16 text-center sm:text-left w-full my-auto">
      <div class="max-w-2xl space-y-4 sm:space-y-6">
        
        <!-- Vector Illustrated Badge -->
        <div class="inline-flex items-center gap-2 bg-[#0b291d] border border-[#c5a059]/40 px-3.5 py-1.5 rounded-full shadow-lg">
          <span class="text-[#c5a059] text-xs">🎨</span>
          <span class="text-[10px] sm:text-xs font-bold uppercase tracking-[0.25em] text-[#c5a059]">
            AUTHENTIC STAYS. LOCAL EXPERTISE.
          </span>
        </div>

        <h1 class="text-4xl sm:text-6xl lg:text-7xl font-black font-['Cormorant_Garamond'] text-white leading-tight">
          Experience Gulshan, <br />
          <span class="italic font-normal text-[#c5a059]">Like a</span> <span class="text-[#c5a059]">Local</span>
        </h1>

        <p class="text-xs sm:text-base text-slate-200 font-normal leading-relaxed max-w-xl">
          Independent hotel reviews, local insights and curated recommendations to help you discover the very best of Gulshan, Dhaka.
        </p>

        <div class="pt-2 flex flex-wrap items-center justify-center sm:justify-start gap-4">
          <a href="#all-hotels" class="bg-[#0b291d] border border-[#c5a059] hover:bg-[#083823] text-white font-extrabold text-xs tracking-wider uppercase px-7 py-3.5 rounded-xl shadow-2xl transition flex items-center gap-2">
            <span>Explore All Hotels</span>
            <span>➔</span>
          </a>

          <div class="font-['Cormorant_Garamond'] italic text-lg sm:text-xl text-[#c5a059]">
            Stay better. Experience more.
          </div>
        </div>

      </div>
    </div>

    <!-- 3. TORN PAPER BRUSH SVG EDGE DIVIDER AT HERO BOTTOM -->
    <div class="relative w-full overflow-hidden leading-none z-10 -mt-2">
      <svg 
        class="relative block w-full h-10 sm:h-16 text-[#f7f5f0]" 
        viewBox="0 0 1200 120" 
        preserveAspectRatio="none" 
        fill="currentColor"
      >
        <path d="M 0,0 L 0,32.0 C 10.2,31.3 10.2,37.3 20.3,38.6 C 30.5,40.6 30.5,36.1 40.7,37.0 C 50.8,35.7 50.8,35.0 61.0,34.7 C 71.2,32.6 71.2,31.4 81.4,29.6 C 91.5,27.0 91.5,31.3 101.7,28.4 L 1200,120 L 0,120 Z"></path>
      </svg>
    </div>

  </section>

  <!-- 4. HIGHLIGHTED POPULAR AREAS CONSOLE BAR -->
  <section id="popular-areas" class="relative z-20 -mt-6 sm:-mt-8 max-w-[1300px] mx-auto px-4">
    <div class="bg-[#072418] border border-[#c5a059]/40 text-white rounded-2xl sm:rounded-full p-3 sm:p-4 shadow-2xl flex flex-col md:flex-row items-center justify-between gap-3">
      
      <span class="text-[#c5a059] text-xs font-black uppercase tracking-widest px-2 shrink-0">
        📍 POPULAR AREAS:
      </span>

      <div class="flex flex-wrap items-center justify-center gap-2 overflow-x-auto w-full md:w-auto">
        <button data-filter="all" class="filter-tab active bg-[#c5a059] text-[#051c14] font-black text-xs px-4 py-2 rounded-full transition shadow">
          🏢 All Areas
        </button>
        <button data-filter="gulshan-1" class="filter-tab bg-[#03150d] hover:bg-[#061e14] text-slate-200 border border-[#c5a059]/30 font-bold text-xs px-4 py-2 rounded-full transition">
          🏢 Gulshan 1
        </button>
        <button data-filter="gulshan-2" class="filter-tab bg-[#03150d] hover:bg-[#061e14] text-slate-200 border border-[#c5a059]/30 font-bold text-xs px-4 py-2 rounded-full transition">
          🏢 Gulshan 2
        </button>
        <button data-filter="banani" class="filter-tab bg-[#03150d] hover:bg-[#061e14] text-slate-200 border border-[#c5a059]/30 font-bold text-xs px-4 py-2 rounded-full transition">
          🏢 Banani
        </button>
        <button data-filter="niketon" class="filter-tab bg-[#03150d] hover:bg-[#061e14] text-slate-200 border border-[#c5a059]/30 font-bold text-xs px-4 py-2 rounded-full transition">
          🛡️ Niketon
        </button>
        <button data-filter="baridhara" class="filter-tab bg-[#03150d] hover:bg-[#061e14] text-slate-200 border border-[#c5a059]/30 font-bold text-xs px-4 py-2 rounded-full transition">
          🏛️ Baridhara
        </button>
      </div>

    </div>
  </section>

  <!-- 5. SCROLL TO DISCOVER INDICATOR SECTION -->
  <section class="bg-[#f7f5f0] text-center pt-8 pb-6 text-slate-800">
    <div class="inline-flex items-center gap-4 text-[10px] font-black uppercase tracking-[0.3em] text-slate-400">
      <span class="w-12 h-px bg-slate-300"></span>
      <span>SCROLL TO DISCOVER</span>
      <span class="w-12 h-px bg-slate-300"></span>
    </div>
    <a href="#all-hotels" class="block mt-2 group">
      <span class="w-8 h-8 rounded-full border border-slate-300 text-slate-500 flex items-center justify-center mx-auto text-xs group-hover:border-[#c5a059] group-hover:text-[#c5a059] transition shadow-sm animate-bounce">
        ↓
      </span>
    </a>
  </section>

  <!-- 6. MAIN HOTEL DIRECTORY GRID -->
  <section id="all-hotels" class="pb-16 pt-2 px-4 sm:px-6 lg:px-8 max-w-[1280px] mx-auto text-slate-800">
    
    <div class="flex justify-between items-end mb-8 border-b border-slate-200 pb-4">
      <div>
        <span class="text-xs font-black uppercase text-[#c5a059] tracking-wider">Official Accommodations</span>
        <h2 class="text-3xl sm:text-4xl font-black text-slate-900 font-['Cormorant_Garamond']">
          All Gulshan Hotels ({hotels.length})
        </h2>
      </div>
    </div>

    <!-- Hotel Cards Grid -->
    <div id="hotelsGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {hotels.map((hotel) => (
        <div 
          class="hotel-card bg-white rounded-2xl border border-slate-200 shadow-md hover:shadow-2xl hover:-translate-y-1 transition duration-300 overflow-hidden flex flex-col group"
          data-zone={hotel.zone}
          data-title={hotel.title.toLowerCase()}
        >
          <div class="h-48 sm:h-56 w-full overflow-hidden relative">
            <img 
              src={hotel.image} 
              alt={hotel.title} 
              loading="lazy"
              decoding="async"
              class="w-full h-full object-cover group-hover:scale-105 transition duration-500" 
            />
            
            <div class="absolute top-3 left-3 bg-[#051c14]/90 text-[#c5a059] text-[10px] font-black uppercase px-2.5 py-1 rounded-md border border-[#c5a059]/40 backdrop-blur-md shadow">
              ✔ Verified Entry
            </div>

            <div class="absolute top-3 right-3 bg-slate-900/85 backdrop-blur-md text-amber-400 text-xs font-black px-2.5 py-1 rounded-md border border-slate-700 shadow-md">
              ★ {hotel.rating}
            </div>

            <div class="absolute bottom-3 left-3 bg-[#051c14]/90 text-slate-200 text-[10px] font-black uppercase px-2.5 py-1 rounded-md border border-[#c5a059]/40 backdrop-blur-md">
              {hotel.category}
            </div>
          </div>

          <div class="p-4 sm:p-5 flex flex-col flex-1 justify-between">
            <div>
              <h3 class="font-['Cormorant_Garamond'] text-lg sm:text-xl font-bold text-slate-900 mb-1.5 sm:mb-2 group-hover:text-emerald-800 transition">
                {hotel.title}
              </h3>

              <div class="flex items-center gap-1.5 text-xs text-slate-500 mb-4 sm:mb-6">
                <svg class="w-4 h-4 fill-[#c5a059] shrink-0" viewBox="0 0 24 24">
                  <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
                </svg>
                <span class="line-clamp-1">{hotel.location}</span>
              </div>
            </div>

            <div class="pt-3 sm:pt-4 border-t border-slate-100 flex items-center justify-between">
              <div>
                <span class="text-[10px] uppercase text-slate-400 font-extrabold block">Price Range</span>
                <span class="font-black text-slate-900 text-sm sm:text-base">{hotel.price}</span>
              </div>

              <a href={`/${hotel.slug}`} class="bg-[#0b291d] hover:bg-[#051c14] text-white font-extrabold text-xs px-4 py-2.5 rounded-xl shadow-md transition flex items-center gap-1">
                Compare Rates ➔
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>

  </section>

  <!-- INSTANT FILTER SCRIPT -->
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const tabs = document.querySelectorAll('.filter-tab');
      const cards = document.querySelectorAll('.hotel-card');

      let currentZone = 'all';

      function applyFilter() {
        cards.forEach((card) => {
          const el = card as HTMLElement;
          const zone = el.getAttribute('data-zone');

          const matchesZone = currentZone === 'all' || zone === currentZone;

          if (matchesZone) {
            el.style.display = 'flex';
          } else {
            el.style.display = 'none';
          }
        });
      }

      tabs.forEach((tab) => {
        tab.addEventListener('click', () => {
          tabs.forEach((t) => {
            t.classList.remove('bg-[#c5a059]', 'text-[#051c14]', 'shadow');
            t.classList.add('bg-[#03150d]', 'text-slate-200');
          });

          tab.classList.remove('bg-[#03150d]', 'text-slate-200');
          tab.classList.add('bg-[#c5a059]', 'text-[#051c14]', 'shadow');

          currentZone = tab.getAttribute('data-filter') || 'all';
          applyFilter();
        });
      });
    });
  </script>

</Layout>
