---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
---

<Layout title="Gulshan Hotels - Discover Gulshan's Finest Luxury Hotels">
  
  <!-- HERO SECTION ONLY (With hero-gulshan.jpg.webp image) -->
  <section class="relative bg-[#070D12] text-white py-16 sm:py-24 px-4 sm:px-6 lg:px-8 border-b border-[#D4AF37]/20 overflow-hidden">
    
    <!-- Background Image with Soft Gradient Overlay -->
    <div class="absolute inset-0 opacity-100 bg-cover bg-center" style="background-image: url('/hero-gulshan.jpg.webp');"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-[#070D12] via-[#070D12]/60 to-transparent"></div>

    <div class="relative max-w-4xl mx-auto text-center space-y-6">
      
      <!-- Crown Badge -->
      <span class="bg-[#D4AF37]/10 text-[#E8D8B0] text-xs font-black uppercase tracking-widest px-4 py-1.5 rounded-full border border-[#D4AF37]/30 inline-block shadow-sm">
        👑 Dhaka's Premier Hotel Guide
      </span>

      <!-- Main Headline -->
      <h1 class="text-3xl sm:text-6xl font-black tracking-tight leading-tight text-white">
        Discover Gulshan's Finest <span class="text-[#D4AF37]">Luxury Hotels</span>
      </h1>
      
      <!-- Subtitle -->
      <p class="text-sm sm:text-base text-slate-300 max-w-xl mx-auto leading-relaxed">
        Compare, book and experience the best hotels in the heart of Dhaka.
      </p>

      <!-- Guest Reviews Avatars -->
      <div class="flex items-center justify-center space-x-3 pt-1">
        <div class="flex -space-x-2">
          <img class="w-8 h-8 rounded-full border-2 border-[#070D12] object-cover" src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=100" />
          <img class="w-8 h-8 rounded-full border-2 border-[#070D12] object-cover" src="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=100" />
          <img class="w-8 h-8 rounded-full border-2 border-[#070D12] object-cover" src="https://images.unsplash.com/photo-1494790108377-be9c29b29330?w=100" />
        </div>
        <div class="text-left text-xs">
          <span class="font-extrabold text-white block">5,000+ Happy Guests</span>
          <span class="text-[#D4AF37] font-bold text-xs">★ ★ ★ ★ ★</span>
        </div>
      </div>

      <!-- Search & Filter Card (Floating Dark Card) -->
      <div class="bg-[#0E161C]/90 backdrop-blur-md p-4 sm:p-5 rounded-2xl shadow-2xl border border-[#D4AF37]/30 max-w-3xl mx-auto text-left space-y-3 mt-8">
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
          
          <!-- Destination Field -->
          <div class="p-3 bg-[#070D12] rounded-xl border border-slate-800">
            <label class="block text-[10px] font-bold text-[#E8D8B0]/80 uppercase tracking-wider">Destination</label>
            <select class="w-full bg-transparent font-extrabold text-white text-xs focus:outline-none cursor-pointer mt-1">
              <option class="bg-[#070D12]">Gulshan, Dhaka</option>
              <option class="bg-[#070D12]">Gulshan 1 Circle</option>
              <option class="bg-[#070D12]">Gulshan 2 Circle</option>
              <option class="bg-[#070D12]">Diplomatic Zone</option>
            </select>
          </div>

          <!-- Dates Field -->
          <div class="p-3 bg-[#070D12] rounded-xl border border-slate-800">
            <label class="block text-[10px] font-bold text-[#E8D8B0]/80 uppercase tracking-wider">Check-in / Out</label>
            <input type="text" value="Fri, 24 May - Sun, 26 May" class="w-full bg-transparent font-extrabold text-white text-xs focus:outline-none cursor-pointer mt-1" readonly />
          </div>

          <!-- Guests Field -->
          <div class="p-3 bg-[#070D12] rounded-xl border border-slate-800">
            <label class="block text-[10px] font-bold text-[#E8D8B0]/80 uppercase tracking-wider">Guests</label>
            <select class="w-full bg-transparent font-extrabold text-white text-xs focus:outline-none cursor-pointer mt-1">
              <option class="bg-[#070D12]">2 Adults, 1 Room</option>
              <option class="bg-[#070D12]">1 Adult, Single</option>
              <option class="bg-[#070D12]">Family Stay</option>
            </select>
          </div>

        </div>

        <!-- Search Button -->
        <a href="#hotels" class="w-full bg-[#D4AF37] hover:bg-amber-400 text-slate-950 font-black py-3 rounded-xl transition text-center text-xs uppercase tracking-wider block shadow-xl">
          🔍 Search Hotels
        </a>
      </div>

    </div>
  </section>

</Layout>
