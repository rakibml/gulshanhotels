---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';

// হোটেল ডাটা
const featuredHotels = [
  {
    name: "The Westin Dhaka",
    slug: "the-westin-dhaka",
    location: "Gulshan 2, Dhaka",
    category: "5-Star Luxury",
    price: "$$$$",
    rating: 4.8,
    reviews: 1240,
    image: "https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&w=800&q=80",
    features: ["Rooftop Pool", "Spa & Gym", "5 Dining Outlets", "Airport Shuttle"],
  },
  {
    name: "Renaissance Dhaka Gulshan Hotel",
    slug: "renaissance-dhaka",
    location: "Gulshan 1, Dhaka",
    category: "5-Star Premium",
    price: "$$$$",
    rating: 4.7,
    reviews: 980,
    image: "https://images.unsplash.com/photo-1582719478250-c89cae4dc85b?auto=format&fit=crop&w=800&q=80",
    features: ["Infinity Pool", "Executive Lounge", "Fine Dining", "City View"],
  },
  {
    name: "Amari Dhaka",
    slug: "amari-dhaka",
    location: "Gulshan 2, Dhaka",
    category: "4-Star Boutique",
    price: "$$$",
    rating: 4.6,
    reviews: 850,
    image: "https://images.unsplash.com/photo-1542314831-068cd1dbfeeb?auto=format&fit=crop&w=800&q=80",
    features: ["Rooftop Bar", "Breeze Spa", "Free WiFi", "Meeting Rooms"],
  },
  {
    name: "Lakeshore Hotel Gulshan",
    slug: "lakeshore-hotel",
    location: "Gulshan 2 (Near Lake)",
    category: "Boutique Hotel",
    price: "$$$",
    rating: 4.5,
    reviews: 620,
    image: "https://images.unsplash.com/photo-1520250497591-112f2f40a3f4?auto=format&fit=crop&w=800&q=80",
    features: ["Lake View", "Quiet Location", "Multi-Cuisine", "Fitness Center"],
  }
];

// Schema Markup for SEO
const schemaData = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "Gulshan Hotels",
  "url": "https://gulshanhotels.com",
  "description": "Your ultimate guide to finding the best hotels, boutique stays, and luxury accommodations in Gulshan 1 & 2, Dhaka.",
};
---

<Layout title="Gulshan Hotels - Best Hotels & Accommodation Guide in Gulshan, Dhaka">
  <!-- Schema Markup Injection -->
  <script type="application/ld+json" set:html={JSON.stringify(schemaData)} />

  <!-- Navigation -->
  <header class="bg-slate-900 text-white sticky top-0 z-50 shadow-md">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4 flex justify-between items-center">
      <a href="/" class="text-2xl font-extrabold tracking-tight text-amber-400">
        Gulshan<span class="text-white">Hotels</span>.com
      </a>
      <nav class="hidden md:flex space-x-6 text-sm font-semibold">
        <a href="#hotels" class="hover:text-amber-400 transition">Featured Hotels</a>
        <a href="#categories" class="hover:text-amber-400 transition">Categories</a>
        <a href="#guide" class="hover:text-amber-400 transition">Gulshan Area Guide</a>
      </nav>
      <a href="#hotels" class="bg-amber-500 hover:bg-amber-600 text-slate-900 font-bold px-4 py-2 rounded-lg text-sm transition">
        Explore Stays
      </a>
    </div>
  </header>

  <!-- Hero Section -->
  <section class="relative bg-slate-900 text-white py-24 px-4 overflow-hidden">
    <div class="absolute inset-0 opacity-30 bg-cover bg-center" style="background-image: url('https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&w=1600&q=80');"></div>
    <div class="relative max-w-5xl mx-auto text-center space-y-6">
      <span class="bg-amber-400/20 text-amber-300 text-xs font-semibold uppercase tracking-wider px-3 py-1 rounded-full border border-amber-400/30">
        Dhaka's Diplomatic & Commercial Hub
      </span>
      <h1 class="text-4xl sm:text-6xl font-black tracking-tight leading-tight">
        Find The Best Hotels in <span class="text-amber-400">Gulshan, Dhaka</span>
      </h1>
      <p class="text-lg sm:text-xl text-slate-300 max-w-3xl mx-auto">
        Discover top 5-star luxury hotels, charming boutique stays, serviced apartments, and budget-friendly accommodations near Gulshan 1 & 2 circles and Diplomatic Zone.
      </p>

      <!-- Search Bar UI -->
      <div class="bg-white p-3 rounded-2xl shadow-2xl max-w-3xl mx-auto flex flex-col sm:flex-row gap-3 text-slate-800">
        <div class="flex-1 text-left px-3 py-1 border-b sm:border-b-0 sm:border-r border-slate-200">
          <label class="block text-xs font-bold text-slate-400 uppercase">Location Area</label>
          <select class="w-full bg-transparent font-semibold text-slate-800 focus:outline-none">
            <option>All Gulshan Areas</option>
            <option>Gulshan 1 Circle</option>
            <option>Gulshan 2 Circle</option>
            <option>Diplomatic Zone & Embassies</option>
            <option>Gulshan Avenue</option>
          </select>
        </div>
        <div class="flex-1 text-left px-3 py-1 border-b sm:border-b-0 sm:border-r border-slate-200">
          <label class="block text-xs font-bold text-slate-400 uppercase">Hotel Category</label>
          <select class="w-full bg-transparent font-semibold text-slate-800 focus:outline-none">
            <option>All Hotel Types</option>
            <option>5-Star Luxury</option>
            <option>Boutique Hotels</option>
            <option>Serviced Apartments</option>
            <option>Budget Stays</option>
          </select>
        </div>
        <button class="bg-amber-500 hover:bg-amber-600 text-slate-900 font-bold px-8 py-3 rounded-xl transition">
          Find Hotels
        </button>
      </div>
    </div>
  </section>

  <!-- Categories Section -->
  <section id="categories" class="py-12 bg-slate-100 border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-wrap gap-3 justify-center text-sm font-semibold text-slate-700">
        <span class="bg-white px-4 py-2 rounded-full shadow-sm hover:shadow transition cursor-pointer border border-slate-200 text-amber-600">
          ✨ All Hotels in Gulshan
        </span>
        <span class="bg-white px-4 py-2 rounded-full shadow-sm hover:shadow transition cursor-pointer border border-slate-200">
          🏨 5-Star Luxury Hotels
        </span>
        <span class="bg-white px-4 py-2 rounded-full shadow-sm hover:shadow transition cursor-pointer border border-slate-200">
          🌿 Boutique Stays
        </span>
        <span class="bg-white px-4 py-2 rounded-full shadow-sm hover:shadow transition cursor-pointer border border-slate-200">
          🏢 Serviced Apartments
        </span>
        <span class="bg-white px-4 py-2 rounded-full shadow-sm hover:shadow transition cursor-pointer border border-slate-200">
          🏛️ Diplomatic Zone Hotels
        </span>
        <span class="bg-white px-4 py-2 rounded-full shadow-sm hover:shadow transition cursor-pointer border border-slate-200">
          💰 Budget-Friendly Stays
        </span>
      </div>
    </div>
  </section>

  <!-- Featured Hotels Grid -->
  <section id="hotels" class="py-16 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12">
      <h2 class="text-3xl font-extrabold text-slate-900">Top Rated Hotels in Gulshan</h2>
      <p class="text-slate-600 mt-2">Handpicked luxury and boutique accommodations with top-tier amenities.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-2 gap-8">
      {featuredHotels.map((hotel) => (
        <div class="bg-white rounded-2xl shadow-md overflow-hidden border border-slate-200 hover:shadow-xl transition flex flex-col sm:flex-row">
          <img src={hotel.image} alt={hotel.name} class="w-full sm:w-48 h-48 object-cover" />
          <div class="p-6 flex-1 flex flex-col justify-between">
            <div>
              <div class="flex justify-between items-start">
                <span class="text-xs font-bold text-amber-600 bg-amber-50 px-2.5 py-1 rounded border border-amber-200">
                  {hotel.category}
                </span>
                <div class="flex items-center text-amber-500 font-bold text-sm">
                  ★ {hotel.rating} <span class="text-slate-400 font-normal ml-1">({hotel.reviews})</span>
                </div>
              </div>
              <h3 class="text-xl font-bold text-slate-900 mt-2">{hotel.name}</h3>
              <p class="text-xs text-slate-500 mt-1">📍 {hotel.location}</p>
              
              <div class="flex flex-wrap gap-1.5 mt-3">
                {hotel.features.map(f => (
                  <span class="bg-slate-100 text-slate-600 text-[11px] font-medium px-2 py-0.5 rounded">
                    ✓ {f}
                  </span>
                ))}
              </div>
            </div>

            <div class="mt-4 pt-4 border-t border-slate-100 flex justify-between items-center">
              <div>
                <span class="text-xs text-slate-400 uppercase font-semibold">Price Range</span>
                <div class="text-lg font-bold text-slate-900">{hotel.price}</div>
              </div>
              <button class="bg-slate-900 hover:bg-amber-500 hover:text-slate-900 text-white font-bold px-4 py-2 rounded-lg text-sm transition">
                View Details
              </button>
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- SEO Area Guide / Topical Authority Section -->
  <section id="guide" class="bg-slate-900 text-slate-300 py-16 px-4">
    <div class="max-w-4xl mx-auto space-y-6">
      <h2 class="text-3xl font-bold text-white text-center">Complete Guide to Staying in Gulshan, Dhaka</h2>
      <p class="leading-relaxed">
        Gulshan is Bangladesh’s most prestigious commercial, diplomatic, and residential area, situated in north Dhaka. Whether you are visiting for international business, official embassy appointments, or a relaxing urban retreat, choosing a hotel in Gulshan offers unparalleled safety, convenience, and luxury.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 pt-4">
        <div class="bg-slate-800 p-6 rounded-xl border border-slate-700">
          <h3 class="text-xl font-bold text-amber-400 mb-2">Gulshan 1 Circle</h3>
          <p class="text-sm text-slate-300">
            Ideal for business travelers requiring close proximity to Tejgaon Industrial Area, Hatirjheel, and central business hubs with seamless metro connectivity.
          </p>
        </div>
        <div class="bg-slate-800 p-6 rounded-xl border border-slate-700">
          <h3 class="text-xl font-bold text-amber-400 mb-2">Gulshan 2 & Diplomatic Zone</h3>
          <p class="text-sm text-slate-300">
            Home to foreign embassies, high commissions, fine-dining restaurants, and international 5-star hotel brands like The Westin, Renaissance, and Amari.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Footer -->
  <footer class="bg-slate-950 text-slate-400 py-8 border-t border-slate-800 text-center text-sm">
    <div class="max-w-7xl mx-auto px-4">
      <p>© 2026 GulshanHotels.com — The Ultimate Guide & Accommodation Directory for Gulshan, Dhaka.</p>
    </div>
  </footer>
</Layout>