---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

// ১. স্পন্সরড ডাটা লোড
let sponsorData = null;
try {
  const rawSponsor = import.meta.glob('../content/sponsored/*.md', { eager: true });
  const list = Object.values(rawSponsor);
  if (list && list.length > 0) {
    sponsorData = (list[0] as any).frontmatter;
  }
} catch (e) {
  sponsorData = null;
}

if (!sponsorData) {
  sponsorData = {
    enable: true,
    badge: "⭐ Editor's Choice",
    title: "The Westin Dhaka",
    category: "5-Star Luxury • Gulshan 2",
    rating: 4.8,
    image: "https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&w=800&q=80",
    buttonText: "Check Best Deal ➔",
    buttonLink: "/the-westin-dhaka"
  };
}

function toTitleCase(str: string) {
  if (!str) return 'Gulshan Hotel';
  return str.replace(/\w\S*/g, (txt) => txt.charAt(0).toUpperCase() + txt.substr(1).toLowerCase());
}

// ২. গুলশানের সব ভেরিফাইড হোটেল লোড করা
let hotels: any[] = [];
try {
  const collectionData = await getCollection('hotels');
  if (collectionData && collectionData.length > 0) {
    hotels = collectionData.map((item: any) => ({
      slug: item.id || item.slug,
      title: toTitleCase(item.data?.title || item.data?.name || 'Gulshan Hotel'),
      category: item.data?.category || 'Luxury Hotel',
      location: item.data?.location || 'Gulshan 2, Dhaka',
      zone: (item.data?.location || '').toLowerCase().includes('gulshan 1') 
            ? 'gulshan-1' 
            : (item.data?.location || '').toLowerCase().includes('banani')
            ? 'banani'
            : 'gulshan-2',
      price: item.data?.price || '$$$$',
      rating: item.data?.rating || 4.8,
      image: item.data?.image || 'https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&w=800&q=80',
    }));
  }
} catch (err) {
  hotels = [];
}
---

<Layout title="Gulshan Hotels - Official Destination Directory & Accommodations Guide in Gulshan, Dhaka">
  
  <!-- HERO WRAPPER WITH GATLINBURG CURVED CARD MARGINS -->
  <div class="p-2 sm:p-4 lg:p-6 max-w-[1600px] mx-auto">
    
    <!-- CLEAN UNIVERSAL HERO CARD CONTAINER -->
    <section class="relative aspect-[16/10] sm:aspect-[16/9] lg:aspect-[21/9] min-h-[260px] sm:min-h-[480px] lg:min-h-[600px] max-h-[800px] w-full bg-slate-950 text-white rounded-[20px] sm:rounded-[36px] overflow-hidden shadow-2xl flex flex-col justify-between border border-slate-800">
      
      <!-- Live Background Video & Overlay -->
      <div class="absolute inset-0 w-full h-full">
        <video 
          id="heroVideo"
          autoplay 
          loop 
          muted 
          playsinline
          poster="https://images.unsplash.com/photo-1512917774080-9991f1c4c750?auto=format&fit=crop&w=1920&q=80"
          class="w-full h-full object-cover opacity-60 transition duration-1000"
        >
          <source src="https://assets.mixkit.co/videos/preview/mixkit-city-traffic-at-night-4034-large.mp4" type="video/mp4" />
          <source src="/hero-gulshan.mp4" type="video/mp4" />
        </video>

        <!-- Dark Gradient Overlay -->
        <div class="absolute inset-0 bg-gradient-to-b from-slate-950/85 via-slate-950/40 to-slate-950/90"></div>
      </div>

      <!-- YOUR ORIGINAL HEADER -->
      <header class="relative z-30 w-full border-b border-white/15 bg-gradient-to-b from-slate-950/85 to-transparent py-2 sm:py-3.5 px-3 sm:px-8">
        <div class="max-w-[1600px] mx-auto flex justify-between items-center">
          
          <a href="/" class="flex flex-col group">
            <span class="text-base sm:text-2xl lg:text-3xl font-black tracking-tight text-white leading-none group-hover:text-emerald-400 transition">
              GULSHAN<span class="text-emerald-400">HOTELS</span>.COM
            </span>
            <span class="text-[8px] sm:text-[10px] text-slate-300 tracking-[0.2em] font-black uppercase mt-0.5">
              DHAKA • BANGLADESH
            </span>
          </a>

          <!-- Desktop Navigation Menu -->
          <nav class="hidden lg:flex items-center space-x-8 text-xs font-black tracking-widest uppercase text-white">
            <a href="/" class="text-emerald-400 hover:text-emerald-300 transition border-b-2 border-emerald-400 pb-0.5">HOME</a>
            
            <div class="relative group cursor-pointer py-1">
              <span class="flex items-center hover:text-emerald-400 transition">
                STAY
                <svg class="w-4 h-4 ml-1 text-slate-300 group-hover:text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"></path></svg>
              </span>
              <div class="absolute left-0 mt-2 w-56 bg-slate-900/95 border border-slate-700 rounded-xl shadow-2xl py-2 hidden group-hover:block transition-all text-white backdrop-blur-xl">
                <a href="#all-hotels" class="block px-4 py-2 hover:bg-slate-800 hover:text-emerald-400 font-extrabold text-xs">5-Star Luxury Hotels</a>
                <a href="#all-hotels" class="block px-4 py-2 hover:bg-slate-800 hover:text-emerald-400 font-extrabold text-xs">Boutique Stays</a>
                <a href="#all-hotels" class="block px-4 py-2 hover:bg-slate-800 hover:text-emerald-400 font-extrabold text-xs">Budget Accommodations</a>
              </div>
            </div>

            <a href="#all-hotels" class="hover:text-emerald-400 transition">DEALS</a>
            
            <div class="relative group cursor-pointer py-1">
              <span class="flex items-center hover:text-emerald-400 transition">
                AREAS GUIDE
                <svg class="w-4 h-4 ml-1 text-slate-300 group-hover:text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"></path></svg>
              </span>
              <div class="absolute left-0 mt-2 w-56 bg-slate-900/95 border border-slate-700 rounded-xl shadow-2xl py-2 hidden group-hover:block transition-all text-white backdrop-blur-xl">
                <a href="/contact" class="block px-4 py-2 hover:bg-slate-800 hover:text-emerald-400 font-extrabold text-xs">Gulshan 1 Guide</a>
                <a href="/contact" class="block px-4 py-2 hover:bg-slate-800 hover:text-emerald-400 font-extrabold text-xs">Gulshan 2 Guide</a>
                <a href="/contact" class="block px-4 py-2 hover:bg-slate-800 hover:text-emerald-400 font-extrabold text-xs">Diplomatic Zone</a>
              </div>
            </div>

            <a href="/contact" class="hover:text-emerald-400 transition">BLOG</a>
            <a href="/contact" class="hover:text-emerald-400 transition">CONTACT</a>
          </nav>

          <div class="flex items-center space-x-2 sm:space-x-4">
            <button class="text-white hover:text-amber-400 transition p-1 sm:p-2 rounded-full hover:bg-white/10">
              <svg class="w-4 h-4 sm:w-5 sm:h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path></svg>
            </button>

            <a href="#all-hotels" class="hidden sm:flex bg-emerald-600 hover:bg-emerald-500 text-white font-black text-xs tracking-wider uppercase px-3.5 py-2 rounded-full transition items-center space-x-1.5 shadow-lg border border-emerald-400/30">
              <svg class="w-3.5 h-3.5 text-emerald-200" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7"></path></svg>
              <span>Browse Map</span>
            </a>

            <button id="mobile-menu-btn" class="lg:hidden text-white hover:text-emerald-400 p-1 rounded-lg focus:outline-none hover:bg-white/10">
              <svg class="w-5 h-5 sm:w-6 sm:h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path></svg>
            </button>
          </div>

        </div>

        <div id="mobile-menu" class="hidden lg:hidden bg-slate-900/95 border-t border-slate-800 px-4 py-3 space-y-2 font-extrabold text-xs text-white backdrop-blur-xl rounded-2xl mt-1">
          <a href="/" class="block text-emerald-400 py-1">HOME</a>
          <a href="#all-hotels" class="block py-1">STAY</a>
          <a href="#all-hotels" class="block py-1">DEALS</a>
          <a href="/contact" class="block py-1">BLOG</a>
          <a href="/contact" class="block py-1">CONTACT</a>
        </div>
      </header>

      <!-- CENTER HERO CONTENT (CLEAN WHITE TITLE & VECTOR ICON BUTTONS) -->
      <div class="relative z-10 max-w-[1280px] mx-auto px-3 text-center my-auto flex flex-col items-center justify-center space-y-4 sm:space-y-6">
        
        <!-- Clean White H1 Title (No Gradient Color) -->
        <h1 class="text-2xl xs:text-3xl sm:text-5xl lg:text-7xl font-black uppercase tracking-tight text-white leading-tight font-serif drop-shadow-2xl select-none">
          Find & Compare <br class="hidden sm:inline" />
          <span>Hotels In Gulshan, Dhaka</span>
        </h1>

        <!-- 3 BUTTONS WITH VECTOR SVG PIN ICONS -->
        <div class="pt-2 flex flex-wrap justify-center items-center gap-2 sm:gap-3">
          <!-- Button 1 -->
          <a href="#all-hotels" class="bg-emerald-600 hover:bg-emerald-500 text-white font-black text-[10px] sm:text-xs lg:text-sm px-4 py-2 sm:px-6 sm:py-3 rounded-full transition shadow-xl border border-emerald-400/30 flex items-center gap-2">
            <span>Explore All Gulshan Hotels ➔</span>
          </a>

          <!-- Button 2 (With Vector SVG Map Pin Icon) -->
          <a href="#all-hotels?zone=gulshan-1" class="bg-white/10 hover:bg-white/20 border border-white/20 text-white font-extrabold text-[10px] sm:text-xs lg:text-sm px-4 py-2 sm:px-6 sm:py-3 rounded-full transition backdrop-blur-md flex items-center gap-2">
            <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4 fill-emerald-400 shrink-0" viewBox="0 0 24 24">
              <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
            </svg>
            <span>Gulshan 1 Hotels</span>
          </a>

          <!-- Button 3 (With Vector SVG Map Pin Icon) -->
          <a href="#all-hotels?zone=gulshan-2" class="bg-white/10 hover:bg-white/20 border border-white/20 text-white font-extrabold text-[10px] sm:text-xs lg:text-sm px-4 py-2 sm:px-6 sm:py-3 rounded-full transition backdrop-blur-md flex items-center gap-2">
            <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4 fill-emerald-400 shrink-0" viewBox="0 0 24 24">
              <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
            </svg>
            <span>Gulshan 2 Hotels</span>
          </a>
        </div>

      </div>

      <!-- BOTTOM-RIGHT SOCIAL MEDIA LINKS (FACEBOOK & INSTAGRAM) -->
      <div class="relative z-20 p-3 sm:p-5 flex justify-end items-center gap-2">
        
        <!-- Facebook Link -->
        <a 
          href="https://facebook.com" 
          target="_blank" 
          rel="noopener noreferrer" 
          aria-label="Facebook Page"
          class="w-8 h-8 sm:w-10 sm:h-10 rounded-full bg-white/10 hover:bg-emerald-600 border border-white/20 text-white backdrop-blur-md flex items-center justify-center transition shadow-lg"
        >
          <svg class="w-4 h-4 sm:w-5 sm:h-5 fill-current" viewBox="0 0 24 24">
            <path d="M24 12.073c0-6.627-4.873-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
          </svg>
        </a>

        <!-- Instagram Link -->
        <a 
          href="https://instagram.com" 
          target="_blank" 
          rel="noopener noreferrer" 
          aria-label="Instagram Page"
          class="w-8 h-8 sm:w-10 sm:h-10 rounded-full bg-white/10 hover:bg-emerald-600 border border-white/20 text-white backdrop-blur-md flex items-center justify-center transition shadow-lg"
        >
          <svg class="w-4 h-4 sm:w-5 sm:h-5 fill-current" viewBox="0 0 24 24">
            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
          </svg>
        </a>

      </div>

    </section>

  </div>

  <!-- TRUST & AUTHORITY BADGES (4 KEY PILLARS) -->
  <section class="pt-10 sm:pt-12 pb-8 sm:pb-10 px-4 sm:px-6 lg:px-8 max-w-[1280px] mx-auto">
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4">
      
      <div class="bg-white p-3.5 sm:p-4 rounded-2xl border border-slate-200 shadow-sm flex items-center gap-2.5 sm:gap-3">
        <span class="text-xl sm:text-2xl p-1.5 sm:p-2 bg-emerald-50 text-emerald-700 rounded-xl">🛡️</span>
        <div>
          <h3 class="text-[11px] sm:text-xs font-black text-slate-900 uppercase">100% Verified</h3>
          <p class="text-[10px] text-slate-500">Physically inspected stays</p>
        </div>
      </div>

      <div class="bg-white p-3.5 sm:p-4 rounded-2xl border border-slate-200 shadow-sm flex items-center gap-2.5 sm:gap-3">
        <span class="text-xl sm:text-2xl p-1.5 sm:p-2 bg-emerald-50 text-emerald-700 rounded-xl">⚡</span>
        <div>
          <h3 class="text-[11px] sm:text-xs font-black text-slate-900 uppercase">Live Price Match</h3>
          <p class="text-[10px] text-slate-500">Agoda, Booking & Direct</p>
        </div>
      </div>

      <div class="bg-white p-3.5 sm:p-4 rounded-2xl border border-slate-200 shadow-sm flex items-center gap-2.5 sm:gap-3">
        <span class="text-xl sm:text-2xl p-1.5 sm:p-2 bg-emerald-50 text-emerald-700 rounded-xl">🏛️</span>
        <div>
          <h3 class="text-[11px] sm:text-xs font-black text-slate-900 uppercase">Diplomatic Zone</h3>
          <p class="text-[10px] text-slate-500">Near US & Foreign Embassies</p>
        </div>
      </div>

      <div class="bg-white p-3.5 sm:p-4 rounded-2xl border border-slate-200 shadow-sm flex items-center gap-2.5 sm:gap-3">
        <span class="text-xl sm:text-2xl p-1.5 sm:p-2 bg-emerald-50 text-emerald-700 rounded-xl">📞</span>
        <div>
          <h3 class="text-[11px] sm:text-xs font-black text-slate-900 uppercase">Direct Booking</h3>
          <p class="text-[10px] text-slate-500">WhatsApp & Direct Calls</p>
        </div>
      </div>

    </div>
  </section>

  <!-- MAIN HOTEL DIRECTORY GRID -->
  <section id="all-hotels" class="py-8 sm:py-10 px-4 sm:px-6 lg:px-8 max-w-[1280px] mx-auto">
    
    <div class="flex justify-between items-end mb-6 sm:mb-8 border-b border-slate-200 pb-3 sm:pb-4">
      <div>
        <span class="text-xs font-black uppercase text-emerald-800 tracking-wider">Verified Accommodations</span>
        <h2 class="text-2xl sm:text-4xl font-black text-slate-900 font-serif">
          All Gulshan Hotels ({hotels.length})
        </h2>
      </div>
    </div>

    <!-- Hotel Cards Grid -->
    <div id="hotelsGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 sm:gap-6">
      {hotels.map((hotel) => (
        <div 
          class="hotel-card bg-white rounded-2xl border border-slate-200 shadow-md hover:shadow-2xl hover:-translate-y-1 transition duration-300 overflow-hidden flex flex-col group"
          data-zone={hotel.zone}
          data-title={hotel.title.toLowerCase()}
        >
          <div class="h-48 sm:h-56 w-full overflow-hidden relative">
            <img 
              src={hotel.image} 
              alt={hotel.title} 
              loading="lazy"
              decoding="async"
              class="w-full h-full object-cover group-hover:scale-105 transition duration-500" 
            />
            
            <div class="absolute top-3 left-3 bg-slate-950/90 text-emerald-300 text-[10px] font-black uppercase px-2.5 py-1 rounded-md border border-emerald-500/40 backdrop-blur-md shadow">
              ✔ Verified Entry
            </div>

            <div class="absolute top-3 right-3 bg-slate-900/85 backdrop-blur-md text-amber-400 text-xs font-black px-2.5 py-1 rounded-md border border-slate-700 shadow-md">
              ★ {hotel.rating}
            </div>

            <div class="absolute bottom-3 left-3 bg-emerald-950/90 text-emerald-300 text-[10px] font-black uppercase px-2.5 py-1 rounded-md border border-emerald-500/40 backdrop-blur-md">
              {hotel.category}
            </div>
          </div>

          <div class="p-4 sm:p-5 flex flex-col flex-1 justify-between">
            <div>
              <h3 class="font-serif text-lg sm:text-xl font-bold text-slate-900 mb-1.5 sm:mb-2 group-hover:text-emerald-700 transition">
                {hotel.title}
              </h3>

              <div class="flex items-center gap-1.5 text-xs text-slate-500 mb-4 sm:mb-6">
                <svg class="w-4 h-4 fill-emerald-600 shrink-0" viewBox="0 0 24 24">
                  <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
                </svg>
                <span class="line-clamp-1">{hotel.location}</span>
              </div>
            </div>

            <div class="pt-3 sm:pt-4 border-t border-slate-100 flex items-center justify-between">
              <div>
                <span class="text-[10px] uppercase text-slate-400 font-extrabold block">Price Range</span>
                <span class="font-black text-slate-900 text-sm sm:text-base">{hotel.price}</span>
              </div>

              <a href={`/${hotel.slug}`} class="bg-emerald-600 hover:bg-emerald-500 text-white font-extrabold text-xs px-3.5 sm:px-4 py-2 sm:py-2.5 rounded-xl shadow-md transition flex items-center gap-1">
                Compare Rates ➔
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>

  </section>

</Layout>
