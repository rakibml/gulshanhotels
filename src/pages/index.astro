---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

// ১. স্পন্সরড ডাটা লোড
let sponsorData = null;
try {
  const rawSponsor = import.meta.glob('../content/sponsored/*.md', { eager: true });
  const list = Object.values(rawSponsor);
  if (list && list.length > 0) {
    sponsorData = (list[0] as any).frontmatter;
  }
} catch (e) {
  sponsorData = null;
}

// ডিফল্ট স্পন্সর ডাটা
if (!sponsorData) {
  sponsorData = {
    enable: true,
    badge: "⭐ Editor's Choice",
    title: "The Westin Dhaka",
    category: "5-Star Luxury • Gulshan 2",
    rating: 4.8,
    image: "https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&w=800&q=80",
    buttonText: "Check Best Deal ➔",
    buttonLink: "https://agoda.com"
  };
}

// ২. সাধারণ হোটেল লিস্ট লোড
let hotels = [];
try {
  const collectionData = await getCollection('hotels');
  if (collectionData && collectionData.length > 0) {
    hotels = collectionData.map((item: any) => ({
      title: item.data?.title || item.data?.name || 'Gulshan Hotel',
      category: item.data?.category || 'Luxury Hotel',
      location: item.data?.location || 'Gulshan 2, Dhaka',
      price: item.data?.price || '$$$$',
      rating: item.data?.rating || 4.8,
      image: item.data?.image || 'https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&w=800&q=80',
    }));
  }
} catch (err) {
  hotels = [];
}

if (!hotels || hotels.length === 0) {
  try {
    const rawGlob = import.meta.glob('../content/hotels/*.md', { eager: true });
    const globList = Object.values(rawGlob);
    if (globList && globList.length > 0) {
      hotels = globList.map((item: any) => ({
        title: item.frontmatter?.title || item.frontmatter?.name || 'Gulshan Hotel',
        category: item.frontmatter?.category || 'Luxury Hotel',
        location: item.frontmatter?.location || 'Gulshan 2, Dhaka',
        price: item.frontmatter?.price || '$$$$',
        rating: item.frontmatter?.rating || 4.8,
        image: item.frontmatter?.image || 'https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&w=800&q=80',
      }));
    }
  } catch (err) {
    hotels = [];
  }
}

if (!hotels || hotels.length === 0) {
  hotels = [
    {
      title: "The Westin Dhaka",
      category: "5-Star Luxury",
      location: "Gulshan 2, Dhaka",
      price: "$$$$",
      rating: 4.8,
      image: "https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&w=800&q=80",
    },
    {
      title: "Renaissance Dhaka Gulshan Hotel",
      category: "5-Star Premium",
      location: "Gulshan 1, Dhaka",
      price: "$$$$",
      rating: 4.7,
      image: "https://images.unsplash.com/photo-1582719478250-c89cae4dc85b?auto=format&fit=crop&w=800&q=80",
    },
    {
      title: "Amari Dhaka",
      category: "4-Star Boutique",
      location: "Gulshan 2, Dhaka",
      price: "$$$",
      rating: 4.6,
      image: "https://images.unsplash.com/photo-1542314831-068cd1dbfeeb?auto=format&fit=crop&w=800&q=80",
    }
  ];
}
---

<Layout title="Gulshan Hotels - Official Accommodation & Travel Guide in Gulshan, Dhaka">
  
  <!-- Hero Banner Section -->
  <section class="relative bg-slate-900 overflow-hidden">
    <div class="relative h-[280px] sm:h-[400px] w-full overflow-hidden">
      <img 
        src="/hero-gulshan.jpg" 
        alt="Gulshan Dhaka City Skyline Evening View" 
        class="w-full h-full object-cover opacity-90" 
      />
      <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/20 to-transparent"></div>
    </div>

    <div class="absolute bottom-0 left-0 right-0 w-full overflow-hidden leading-none z-10">
      <svg class="relative block w-full h-10 sm:h-16 text-slate-50" viewBox="0 0 1200 120" preserveAspectRatio="none" fill="currentColor">
        <path d="M0,0 C150,90 350,-40 500,60 C650,160 900,10 1200,40 L1200,120 L0,120 Z"></path>
      </svg>
    </div>
  </section>

  <!-- Welcome Authority Section with Dynamic Sponsored Showcase -->
  <section class="bg-slate-50 py-10 px-4 sm:px-8 lg:px-12 border-b border-slate-200 -mt-2">
    <div class="max-w-[1600px] mx-auto grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
      
      <!-- Left Column: Narrative & Authority Badges -->
      <div class="lg:col-span-7 space-y-4 text-left">
        <div class="inline-block border-b-2 border-emerald-600 pb-1">
          <span class="text-xs font-black uppercase tracking-widest text-emerald-800">
            WELCOME TO GULSHANHOTELS.COM
          </span>
        </div>

        <h1 class="text-3xl sm:text-5xl font-black text-slate-900 tracking-tight leading-tight">
          Your Trusted Guide To The Best Hotels In Gulshan
        </h1>

        <p class="text-slate-600 text-sm sm:text-base leading-relaxed">
          Gulshan is Dhaka’s most upscale neighborhood, known for its diplomatic district, 5-star luxury hotels, fine dining, and vibrant city life. Whether you're visiting for embassy appointments, international business, or leisure, we help you find the perfect hotel through unbiased reviews, real photos, and local insider tips.
        </p>

        <div class="hidden sm:grid grid-cols-2 sm:grid-cols-4 gap-4 pt-4 border-t border-slate-200">
          <div class="flex items-center space-x-2.5">
            <span class="text-xl">🔍</span>
            <div>
              <h4 class="text-xs font-bold text-slate-900">Expert Reviews</h4>
              <p class="text-[10px] text-slate-500">In-depth insights</p>
            </div>
          </div>

          <div class="flex items-center space-x-2.5">
            <span class="text-xl">📸</span>
            <div>
              <h4 class="text-xs font-bold text-slate-900">Real Photos</h4>
              <p class="text-[10px] text-slate-500">Authentic views</p>
            </div>
          </div>

          <div class="flex items-center space-x-2.5">
            <span class="text-xl">⚖️</span>
            <div>
              <h4 class="text-xs font-bold text-slate-900">Pros & Cons</h4>
              <p class="text-[10px] text-slate-500">Honest breakdowns</p>
            </div>
          </div>

          <div class="flex items-center space-x-2.5">
            <span class="text-xl">🤝</span>
            <div>
              <h4 class="text-xs font-bold text-slate-900">Unbiased Stays</h4>
              <p class="text-[10px] text-slate-500">Local recommendations</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Right Column: Sponsored Showcase (Dynamic Admin Controlled) -->
      <div class="lg:col-span-5">
        {sponsorData && sponsorData.enable ? (
          <div class="relative rounded-2xl overflow-hidden shadow-xl border border-slate-200 group bg-slate-900">
            <img 
              src={sponsorData.image || "https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&w=800&q=80"} 
              alt={sponsorData.title} 
              class="w-full h-72 sm:h-80 object-cover group-hover:scale-105 transition-transform duration-500 opacity-90" 
            />
            <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/20 to-transparent"></div>

            <!-- Custom Badge Text -->
            <div class="absolute top-4 left-4 bg-amber-500 text-slate-950 text-[11px] font-black uppercase px-3 py-1 rounded-full shadow-md flex items-center space-x-1">
              <span>{sponsorData.badge || "⭐ Editor's Choice"}</span>
            </div>

            <!-- Bottom Content & Target Link -->
            <div class="absolute bottom-4 left-4 right-4 text-white flex justify-between items-end">
              <div>
                <span class="text-[11px] font-extrabold text-emerald-300 bg-slate-950/80 px-2.5 py-0.5 rounded border border-emerald-500/40">
                  {sponsorData.category || "5-Star Luxury • Gulshan 2"}
                </span>
                <h3 class="text-2xl font-black text-white mt-1.5">{sponsorData.title}</h3>
                <p class="text-xs text-amber-400 font-bold mt-0.5">★ ★ ★ ★ ★ <span class="text-white ml-1">{sponsorData.rating || '4.8'}/5 Excellent</span></p>
              </div>

              <a 
                href={sponsorData.buttonLink || "#hotels"} 
                target="_blank"
                rel="noopener noreferrer"
                class="bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-extrabold px-4 py-2.5 rounded-lg shadow-lg transition shrink-0 ml-2"
              >
                {sponsorData.buttonText || "Check Best Deal ➔"}
              </a>
            </div>
          </div>
        ) : (
          /* Feature Your Hotel Call to Action (When Sponsored is disabled) */
          <div class="bg-gradient-to-br from-emerald-900 to-slate-900 p-8 rounded-2xl border border-emerald-700/50 text-white text-center space-y-4 shadow-xl">
            <span class="bg-emerald-500/20 text-emerald-300 text-xs font-bold uppercase px-3 py-1 rounded-full border border-emerald-500/30">
              Sponsored Opportunity
            </span>
            <h3 class="text-2xl font-black text-white">Feature Your Hotel Here!</h3>
            <p class="text-xs text-slate-300">
              Reach over 25,000+ diplomats, tourists, and business travelers visiting Gulshan monthly. Get maximum visibility for your hotel.
            </p>
            <a href="/about" class="inline-block bg-amber-500 hover:bg-amber-400 text-slate-950 font-black px-6 py-2.5 rounded-xl text-xs uppercase shadow transition">
              Contact For Sponsorship ➔
            </a>
          </div>
        )}
      </div>

    </div>
  </section>
<section class="py-12 px-4 sm:px-6 lg:px-8 max-w-[1280px] mx-auto font-sans text-gray-800">
  
  <!-- Section Header -->
  <div class="flex justify-between items-center mb-6">
    <h2 class="font-serif text-2xl sm:text-3xl font-bold text-[#1a382b]">
      Stay at our featured hotels
    </h2>
    <a href="#" class="text-xs sm:text-sm font-semibold text-[#a87247] border border-gray-200 hover:border-gray-300 rounded-full px-4 sm:px-5 py-2 sm:py-2.5 transition-all hover:bg-gray-50 flex items-center gap-1">
      See More Hotels &rarr;
    </a>
  </div>

  <!-- Carousel Wrapper -->
  <div class="relative group">
    
    <!-- Prev Button -->
    <button id="prevBtn" aria-label="Previous" class="absolute -left-3 md:-left-5 top-1/2 -translate-y-1/2 z-10 w-10 h-10 rounded-full bg-white border border-gray-200 shadow-md flex items-center justify-center text-gray-700 hover:bg-gray-50 hover:scale-105 active:scale-95 transition-all">
      &#10094;
    </button>

    <!-- Carousel Track -->
    <div id="carouselTrack" class="flex gap-5 overflow-x-auto scroll-smooth py-3 [scrollbar-width:none] [-ms-overflow-style:none] [&::-webkit-scrollbar]:hidden">
      
      <!-- Card 1 -->
      <div class="w-[280px] sm:w-[290px] shrink-0 bg-white rounded-2xl border border-gray-100 shadow-sm hover:shadow-lg hover:-translate-y-1 transition-all duration-300 overflow-hidden flex flex-col">
        <div class="h-[200px] w-full overflow-hidden">
          <img class="w-full h-full object-cover rounded-t-2xl" src="https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&w=600&q=80" alt="Ocean View Resort" />
        </div>
        <div class="p-5 flex flex-col flex-1">
          <h3 class="font-serif text-lg font-bold text-[#1a382b] mb-2 line-clamp-1">Ocean View Grand Resort</h3>
          <div class="flex items-center gap-1.5 text-xs text-gray-500 mb-6">
            <svg class="w-3.5 h-3.5 fill-[#a87247]" viewBox="0 0 24 24"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>
            <span>Cox's Bazar, Bangladesh</span>
          </div>
          <div class="mt-auto flex items-center justify-between text-xs">
            <span class="font-semibold text-gray-800">1 Bed, 1 Bath</span>
            <span class="bg-[#f1f5f3] text-[#1a382b] px-3 py-1.5 rounded-md font-semibold text-[11px]">Host: Royal Stay Ltd</span>
          </div>
        </div>
      </div>

      <!-- Card 2 -->
      <div class="w-[280px] sm:w-[290px] shrink-0 bg-white rounded-2xl border border-gray-100 shadow-sm hover:shadow-lg hover:-translate-y-1 transition-all duration-300 overflow-hidden flex flex-col">
        <div class="h-[200px] w-full overflow-hidden">
          <img class="w-full h-full object-cover rounded-t-2xl" src="https://images.unsplash.com/photo-1582719508461-905c673771fd?auto=format&fit=crop&w=600&q=80" alt="Mountain Breeze Hotel" />
        </div>
        <div class="p-5 flex flex-col flex-1">
          <h3 class="font-serif text-lg font-bold text-[#1a382b] mb-2 line-clamp-1">Mountain Breeze Hotel</h3>
          <div class="flex items-center gap-1.5 text-xs text-gray-500 mb-6">
            <svg class="w-3.5 h-3.5 fill-[#a87247]" viewBox="0 0 24 24"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>
            <span>Sylhet, Bangladesh</span>
          </div>
          <div class="mt-auto flex items-center justify-between text-xs">
            <span class="font-semibold text-gray-800">2 Bed, 2 Bath</span>
            <span class="bg-[#f1f5f3] text-[#1a382b] px-3 py-1.5 rounded-md font-semibold text-[11px]">Host: Green Valley</span>
          </div>
        </div>
      </div>

      <!-- Card 3 -->
      <div class="w-[280px] sm:w-[290px] shrink-0 bg-white rounded-2xl border border-gray-100 shadow-sm hover:shadow-lg hover:-translate-y-1 transition-all duration-300 overflow-hidden flex flex-col">
        <div class="h-[200px] w-full overflow-hidden">
          <img class="w-full h-full object-cover rounded-t-2xl" src="https://images.unsplash.com/photo-1542314831-068cd1dbfeeb?auto=format&fit=crop&w=600&q=80" alt="PANORAMIC PALACE HOTEL" />
        </div>
        <div class="p-5 flex flex-col flex-1">
          <h3 class="font-serif text-lg font-bold text-[#1a382b] mb-2 line-clamp-1">PANORAMIC PALACE HOTEL</h3>
          <div class="flex items-center gap-1.5 text-xs text-gray-500 mb-6">
            <svg class="w-3.5 h-3.5 fill-[#a87247]" viewBox="0 0 24 24"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>
            <span>Dhaka, Bangladesh</span>
          </div>
          <div class="mt-auto flex items-center justify-between text-xs">
            <span class="font-semibold text-gray-800">3 Bed, 3.5 Bath</span>
            <span class="bg-[#f1f5f3] text-[#1a382b] px-3 py-1.5 rounded-md font-semibold text-[11px]">Host: Luxury Living</span>
          </div>
        </div>
      </div>

      <!-- Card 4 -->
      <div class="w-[280px] sm:w-[290px] shrink-0 bg-white rounded-2xl border border-gray-100 shadow-sm hover:shadow-lg hover:-translate-y-1 transition-all duration-300 overflow-hidden flex flex-col">
        <div class="h-[200px] w-full overflow-hidden">
          <img class="w-full h-full object-cover rounded-t-2xl" src="https://images.unsplash.com/photo-1571896349842-33c89424de2d?auto=format&fit=crop&w=600&q=80" alt="Lakeview Heritage Suites" />
        </div>
        <div class="p-5 flex flex-col flex-1">
          <h3 class="font-serif text-lg font-bold text-[#1a382b] mb-2 line-clamp-1">Lakeview Heritage Suites</h3>
          <div class="flex items-center gap-1.5 text-xs text-gray-500 mb-6">
            <svg class="w-3.5 h-3.5 fill-[#a87247]" viewBox="0 0 24 24"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>
            <span>Rangamati, Bangladesh</span>
          </div>
          <div class="mt-auto flex items-center justify-between text-xs">
            <span class="font-semibold text-gray-800">2 Bed, 2 Bath</span>
            <span class="bg-[#f1f5f3] text-[#1a382b] px-3 py-1.5 rounded-md font-semibold text-[11px]">Host: Eco Resorts</span>
          </div>
        </div>
      </div>

    </div>

    <!-- Next Button -->
    <button id="nextBtn" aria-label="Next" class="absolute -right-3 md:-right-5 top-1/2 -translate-y-1/2 z-10 w-10 h-10 rounded-full bg-white border border-gray-200 shadow-md flex items-center justify-center text-gray-700 hover:bg-gray-50 hover:scale-105 active:scale-95 transition-all">
      &#10095;
    </button>
  </div>

</section>

</Layout>
