---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

// ১. স্পন্সরড ডাটা লোড
let sponsorData = null;
try {
  const rawSponsor = import.meta.glob('../content/sponsored/*.md', { eager: true });
  const list = Object.values(rawSponsor);
  if (list && list.length > 0) {
    sponsorData = (list[0] as any).frontmatter;
  }
} catch (e) {
  sponsorData = null;
}

if (!sponsorData) {
  sponsorData = {
    enable: true,
    badge: "⭐ Editor's Choice",
    title: "The Westin Dhaka",
    category: "5-Star Luxury • Gulshan 2",
    rating: 4.8,
    image: "https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&w=800&q=80",
    buttonText: "Check Best Deal ➔",
    buttonLink: "/the-westin-dhaka"
  };
}

function toTitleCase(str: string) {
  if (!str) return 'Gulshan Hotel';
  return str.replace(/\w\S*/g, (txt) => txt.charAt(0).toUpperCase() + txt.substr(1).toLowerCase());
}

// ২. গুলশানের সব ভেরিফাইড হোটেল লোড করা
let hotels: any[] = [];
try {
  const collectionData = await getCollection('hotels');
  if (collectionData && collectionData.length > 0) {
    hotels = collectionData.map((item: any) => ({
      slug: item.id || item.slug,
      title: toTitleCase(item.data?.title || item.data?.name || 'Gulshan Hotel'),
      category: item.data?.category || 'Luxury Hotel',
      location: item.data?.location || 'Gulshan 2, Dhaka',
      zone: (item.data?.location || '').toLowerCase().includes('gulshan 1') 
            ? 'gulshan-1' 
            : (item.data?.location || '').toLowerCase().includes('banani')
            ? 'banani'
            : 'gulshan-2',
      price: item.data?.price || '$$$$',
      rating: item.data?.rating || 4.8,
      image: item.data?.image || 'https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&w=800&q=80',
    }));
  }
} catch (err) {
  hotels = [];
}

// Google Schema for Authority & Conversion SEO
const directorySchema = {
  "@context": "https://schema.org",
  "@type": "DirectoryPage",
  "name": "GulshanHotels.com - Verified Accommodation Directory",
  "description": "Official Directory and Live Price Comparison Guide for Hotels in Gulshan 1, Gulshan 2, and Diplomatic Zone, Dhaka."
};
---

<Layout title="Gulshan Hotels - Official Directory & Live Price Comparison for Gulshan, Dhaka">
  
  <script type="application/ld+json" set:html={JSON.stringify(directorySchema)} />

  <!-- HERO SECTION: HIGH-CONVERSION & MODERN AUTHORITY LOOK -->
  <section class="relative bg-slate-950 text-white pt-12 pb-20 overflow-hidden">
    <!-- Background Image -->
    <div class="absolute inset-0 w-full h-full">
      <img 
        src="/hero-gulshan.jpg" 
        alt="Gulshan Dhaka City Skyline Evening View" 
        class="w-full h-full object-cover opacity-30 scale-105" 
      />
      <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/80 to-slate-950/40"></div>
    </div>

    <div class="relative max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-6">
      
      <!-- Trust Badge -->
      <div class="inline-flex items-center gap-2 bg-emerald-500/20 border border-emerald-500/40 text-emerald-300 text-xs font-black uppercase tracking-widest px-4 py-1.5 rounded-full backdrop-blur-md">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        Gulshan's #1 Verified Accommodation Directory
      </div>

      <!-- Main Headline -->
      <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black tracking-tight text-white leading-tight max-w-4xl mx-auto">
        Find & Compare Hotels In <span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 to-teal-200">Gulshan, Dhaka</span>
      </h1>

      <p class="text-sm sm:text-base text-slate-300 max-w-2xl mx-auto font-normal leading-relaxed">
        Compare live prices from Agoda, Booking.com & Official Hotel Sites. 100% Physically Inspected & Verified Directory.
      </p>

    </div>
  </section>

  <!-- FLOATING INTERACTIVE FILTER CONSOLE (HIGH CONVERSION) -->
  <div class="relative z-20 -mt-8 max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8">
    <div class="bg-white rounded-2xl sm:rounded-full border border-slate-200 shadow-2xl p-2.5 flex items-center justify-between gap-2 overflow-x-auto [scrollbar-width:none] [-ms-overflow-style:none] [&::-webkit-scrollbar]:hidden">
      
      <div class="flex items-center gap-2 shrink-0 w-full sm:w-auto overflow-x-auto">
        <button data-filter="all" class="filter-pill active bg-[#052e16] text-white font-black text-xs sm:text-sm px-5 py-2.5 rounded-full transition flex items-center gap-2 shrink-0 shadow-md">
          <span>🏢 All Gulshan Hotels ({hotels.length})</span>
        </button>

        <button data-filter="gulshan-1" class="filter-pill bg-white border border-slate-200 hover:bg-slate-50 text-slate-800 font-bold text-xs sm:text-sm px-5 py-2.5 rounded-full transition flex items-center gap-2 shrink-0">
          <span>📍 Gulshan 1</span>
        </button>

        <button data-filter="gulshan-2" class="filter-pill bg-white border border-slate-200 hover:bg-slate-50 text-slate-800 font-bold text-xs sm:text-sm px-5 py-2.5 rounded-full transition flex items-center gap-2 shrink-0">
          <span>📍 Gulshan 2</span>
        </button>

        <button data-filter="banani" class="filter-pill bg-white border border-slate-200 hover:bg-slate-50 text-slate-800 font-bold text-xs sm:text-sm px-5 py-2.5 rounded-full transition flex items-center gap-2 shrink-0">
          <span>🏛️ Diplomatic Zone</span>
        </button>
      </div>

      <!-- Live Search Trigger Button -->
      <button id="toggleMoreFilters" class="bg-emerald-600 hover:bg-emerald-500 text-white font-extrabold text-xs sm:text-sm px-5 py-2.5 rounded-full transition flex items-center gap-2 shrink-0 ml-auto shadow-lg">
        <span>🔍 Search Hotel Name</span>
      </button>

    </div>

    <!-- EXPANDABLE SEARCH PANEL -->
    <div id="moreFiltersPanel" class="hidden mt-3 bg-white p-4 sm:p-5 rounded-2xl border border-slate-200 shadow-2xl">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label class="block text-xs font-black text-slate-700 uppercase mb-1">Type Hotel Name</label>
          <input type="text" id="searchHotels" placeholder="e.g. Westin, Amari, Renaissance..." class="w-full bg-slate-50 border border-slate-300 focus:border-emerald-600 focus:bg-white rounded-xl px-4 py-2.5 text-xs text-slate-900 outline-none" />
        </div>
        <div class="flex items-end">
          <button id="resetFilters" class="w-full bg-slate-100 hover:bg-slate-200 text-slate-800 font-extrabold text-xs py-2.5 rounded-xl transition">Clear Search</button>
        </div>
      </div>
    </div>
  </div>

  <!-- TRUST & AUTHORITY BADGES (4 KEY PILLARS) -->
  <section class="bg-slate-50 pt-12 pb-10 px-4 sm:px-6 lg:px-8 border-b border-slate-200">
    <div class="max-w-[1280px] mx-auto grid grid-cols-2 lg:grid-cols-4 gap-4">
      
      <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-sm flex items-center gap-3">
        <span class="text-2xl p-2 bg-emerald-50 text-emerald-700 rounded-xl">🛡️</span>
        <div>
          <h3 class="text-xs font-black text-slate-900 uppercase">100% Verified</h3>
          <p class="text-[11px] text-slate-500">Physically inspected stays</p>
        </div>
      </div>

      <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-sm flex items-center gap-3">
        <span class="text-2xl p-2 bg-emerald-50 text-emerald-700 rounded-xl">⚡</span>
        <div>
          <h3 class="text-xs font-black text-slate-900 uppercase">Live Price Match</h3>
          <p class="text-[11px] text-slate-500">Agoda, Booking & Direct</p>
        </div>
      </div>

      <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-sm flex items-center gap-3">
        <span class="text-2xl p-2 bg-emerald-50 text-emerald-700 rounded-xl">🏛️</span>
        <div>
          <h3 class="text-xs font-black text-slate-900 uppercase">Diplomatic Zone</h3>
          <p class="text-[11px] text-slate-500">Near US & Foreign Embassies</p>
        </div>
      </div>

      <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-sm flex items-center gap-3">
        <span class="text-2xl p-2 bg-emerald-50 text-emerald-700 rounded-xl">📞</span>
        <div>
          <h3 class="text-xs font-black text-slate-900 uppercase">Direct Booking</h3>
          <p class="text-[11px] text-slate-500">WhatsApp & Direct Calls</p>
        </div>
      </div>

    </div>
  </section>

  <!-- FEATURED SPONSORED SHOWCASE (HIGH CLICK CONVERSION) -->
  {sponsorData && sponsorData.enable ? (
    <section class="py-10 px-4 sm:px-6 lg:px-8 max-w-[1280px] mx-auto">
      <div class="relative rounded-3xl overflow-hidden shadow-2xl border border-slate-200 bg-slate-900 text-white grid grid-cols-1 lg:grid-cols-12 items-center">
        
        <div class="lg:col-span-7 h-64 sm:h-80 relative overflow-hidden">
          <img src={sponsorData.image} alt={sponsorData.title} class="w-full h-full object-cover group-hover:scale-105 transition duration-500 opacity-90" />
          <div class="absolute inset-0 bg-gradient-to-r from-slate-950/80 via-transparent to-transparent"></div>
          
          <div class="absolute top-4 left-4 bg-amber-500 text-slate-950 text-xs font-black uppercase px-3.5 py-1 rounded-full shadow-lg">
            {sponsorData.badge || "⭐ Featured Choice"}
          </div>
        </div>

        <div class="lg:col-span-5 p-6 sm:p-8 space-y-4">
          <span class="text-xs font-black uppercase text-emerald-400 bg-emerald-950 px-3 py-1 rounded-md border border-emerald-500/30">
            {sponsorData.category}
          </span>
          
          <h2 class="text-2xl sm:text-3xl font-black text-white">{sponsorData.title}</h2>
          
          <p class="text-xs text-slate-300 leading-relaxed">
            Gulshan's premier luxury stay with world-class amenities, heated pool, diplomatic security, and fine dining restaurants.
          </p>

          <div class="pt-2 flex items-center justify-between">
            <span class="text-amber-400 font-bold text-xs">★ {sponsorData.rating} / 5 Excellent</span>
            
            <a 
              href={sponsorData.buttonLink || "/the-westin-dhaka"} 
              class="bg-emerald-600 hover:bg-emerald-500 text-white font-extrabold text-xs px-5 py-3 rounded-xl shadow-lg transition"
            >
              {sponsorData.buttonText || "Check Best Price ➔"}
            </a>
          </div>
        </div>

      </div>
    </section>
  ) : null}

  <!-- MAIN HOTEL DIRECTORY GRID (HIGH CONVERSION CARDS) -->
  <section id="all-hotels" class="py-12 px-4 sm:px-6 lg:px-8 max-w-[1280px] mx-auto">
    
    <div class="flex justify-between items-end mb-8 border-b border-slate-200 pb-4">
      <div>
        <span class="text-xs font-black uppercase text-emerald-800 tracking-wider">Verified Accommodations</span>
        <h2 class="text-3xl sm:text-4xl font-black text-slate-900">
          All Gulshan Hotels ({hotels.length})
        </h2>
      </div>
    </div>

    <!-- Hotel Cards Grid -->
    <div id="hotelsGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {hotels.map((hotel) => (
        <div 
          class="hotel-card bg-white rounded-2xl border border-slate-200 shadow-md hover:shadow-2xl hover:-translate-y-1 transition duration-300 overflow-hidden flex flex-col group"
          data-zone={hotel.zone}
          data-title={hotel.title.toLowerCase()}
        >
          <div class="h-56 w-full overflow-hidden relative">
            <img src={hotel.image} alt={hotel.title} class="w-full h-full object-cover group-hover:scale-105 transition duration-500" />
            
            <div class="absolute top-3 left-3 bg-slate-950/90 text-emerald-300 text-[10px] font-black uppercase px-2.5 py-1 rounded-md border border-emerald-500/40 backdrop-blur-md shadow">
              ✔ Verified Entry
            </div>

            <div class="absolute top-3 right-3 bg-slate-900/85 backdrop-blur-md text-amber-400 text-xs font-black px-2.5 py-1 rounded-md border border-slate-700 shadow-md">
              ★ {hotel.rating}
            </div>

            <div class="absolute bottom-3 left-3 bg-emerald-950/90 text-emerald-300 text-[10px] font-black uppercase px-2.5 py-1 rounded-md border border-emerald-500/40 backdrop-blur-md">
              {hotel.category}
            </div>
          </div>

          <div class="p-5 flex flex-col flex-1 justify-between">
            <div>
              <h3 class="font-serif text-xl font-bold text-slate-900 mb-2 group-hover:text-emerald-700 transition">
                {hotel.title}
              </h3>

              <div class="flex items-center gap-1.5 text-xs text-slate-500 mb-6">
                <svg class="w-4 h-4 fill-emerald-600 shrink-0" viewBox="0 0 24 24">
                  <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
                </svg>
                <span class="line-clamp-1">{hotel.location}</span>
              </div>
            </div>

            <div class="pt-4 border-t border-slate-100 flex items-center justify-between">
              <div>
                <span class="text-[10px] uppercase text-slate-400 font-extrabold block">Estimated Rate</span>
                <span class="font-black text-slate-900 text-base">{hotel.price}</span>
              </div>

              <!-- HIGH CONVERSION ACTION BUTTON (LINKS TO LIVE RATE COMPARISON TABLE) -->
              <a href={`/${hotel.slug}`} class="bg-emerald-600 hover:bg-emerald-500 text-white font-extrabold text-xs px-4 py-2.5 rounded-xl shadow-md transition flex items-center gap-1">
                Compare Rates ➔
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>

  </section>

  <!-- COMPACT SEO AUTHORITATIVE GUIDE (SCORED FOR GOOGLE RANKING & TRUST) -->
  <section class="py-16 bg-slate-900 text-white px-4 sm:px-6 lg:px-8 border-t border-slate-800">
    <div class="max-w-[1280px] mx-auto">
      
      <div class="text-center max-w-2xl mx-auto mb-10">
        <span class="text-xs font-black uppercase text-emerald-400 tracking-wider">Local Travel Authority</span>
        <h2 class="text-3xl font-black text-white mt-1">
          Where To Stay In Gulshan, Dhaka
        </h2>
        <p class="text-xs text-slate-400 mt-1">Quick zone comparison for diplomats, corporate delegates, and tourists</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="bg-slate-800/80 border border-slate-700/60 p-5 rounded-2xl space-y-2">
          <div class="text-2xl">📍</div>
          <h3 class="text-base font-bold text-white">Gulshan 1: Business Hub</h3>
          <p class="text-xs text-slate-300 leading-relaxed">
            Best for corporate stays, commercial offices, and fine dining along Gulshan Avenue.
          </p>
        </div>

        <div class="bg-slate-800/80 border border-slate-700/60 p-5 rounded-2xl space-y-2">
          <div class="text-2xl">⭐</div>
          <h3 class="text-base font-bold text-white">Gulshan 2: 5-Star Luxury</h3>
          <p class="text-xs text-slate-300 leading-relaxed">
            Home to premier 5-star hotels, Gulshan Circle 2, Lake Park, and executive rooftop lounges.
          </p>
        </div>

        <div class="bg-slate-800/80 border border-slate-700/60 p-5 rounded-2xl space-y-2">
          <div class="text-2xl">🏛️</div>
          <h3 class="text-base font-bold text-white">Diplomatic Zone: High Security</h3>
          <p class="text-xs text-slate-300 leading-relaxed">
            Closest to US Embassy, UK High Commission, foreign missions, and high-security enclosures.
          </p>
        </div>
      </div>

    </div>
  </section>

  <!-- INSTANT FILTER SCRIPT -->
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const pills = document.querySelectorAll('.filter-pill');
      const cards = document.querySelectorAll('.hotel-card');
      const searchInput = document.getElementById('searchHotels') as HTMLInputElement;
      const toggleMoreFilters = document.getElementById('toggleMoreFilters');
      const moreFiltersPanel = document.getElementById('moreFiltersPanel');

      let currentZone = 'all';

      if (toggleMoreFilters && moreFiltersPanel) {
        toggleMoreFilters.addEventListener('click', () => {
          moreFiltersPanel.classList.toggle('hidden');
        });
      }

      function applyFilter() {
        const query = searchInput ? searchInput.value.toLowerCase().trim() : '';

        cards.forEach((card) => {
          const el = card as HTMLElement;
          const zone = el.getAttribute('data-zone');
          const title = el.getAttribute('data-title') || '';

          const matchesZone = currentZone === 'all' || zone === currentZone;
          const matchesSearch = query === '' || title.includes(query);

          if (matchesZone && matchesSearch) {
            el.style.display = 'flex';
          } else {
            el.style.display = 'none';
          }
        });
      }

      pills.forEach((pill) => {
        pill.addEventListener('click', () => {
          pills.forEach((p) => {
            p.classList.remove('bg-[#052e16]', 'text-white', 'shadow-md');
            p.classList.add('bg-white', 'border', 'border-slate-200', 'text-slate-800');
          });

          pill.classList.remove('bg-white', 'border', 'border-slate-200', 'text-slate-800');
          pill.classList.add('bg-[#052e16]', 'text-white', 'shadow-md');

          currentZone = pill.getAttribute('data-filter') || 'all';
          applyFilter();
        });
      });

      if (searchInput) searchInput.addEventListener('input', applyFilter);
    });
  </script>

</Layout>
