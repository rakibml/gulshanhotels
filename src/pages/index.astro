---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';

const featuredHotels = [
  {
    name: "The Westin Dhaka",
    slug: "the-westin-dhaka",
    location: "Gulshan 2, Dhaka",
    category: "5-Star Luxury",
    price: "$$$$",
    rating: 4.8,
    reviews: 1240,
    image: "https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&w=800&q=80",
  },
  {
    name: "Renaissance Dhaka Gulshan Hotel",
    slug: "renaissance-dhaka",
    location: "Gulshan 1, Dhaka",
    category: "5-Star Premium",
    price: "$$$$",
    rating: 4.7,
    reviews: 980,
    image: "https://images.unsplash.com/photo-1582719478250-c89cae4dc85b?auto=format&fit=crop&w=800&q=80",
  }
];
---

<Layout title="Gulshan Hotels - Best Hotels in Gulshan, Dhaka">
  <section class="bg-slate-900 text-white py-20 px-4 text-center">
    <h1 class="text-4xl font-black">Find The Best Hotels in <span class="text-amber-400">Gulshan, Dhaka</span></h1>
    <p class="text-slate-300 mt-2">Discover top luxury and boutique stays in Gulshan 1 & 2.</p>
  </section>

  <section class="py-12 max-w-6xl mx-auto px-4">
    <h2 class="text-2xl font-bold mb-6">Top Rated Hotels in Gulshan</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {featuredHotels.map((hotel) => (
        <div class="bg-white rounded-xl shadow p-4 border border-slate-200 flex flex-col sm:flex-row gap-4">
          <img src={hotel.image} class="w-full sm:w-40 h-32 object-cover rounded-lg" />
          <div class="flex-1">
            <span class="text-xs font-bold text-amber-600 bg-amber-50 px-2 py-0.5 rounded border border-amber-200">{hotel.category}</span>
            <h3 class="text-lg font-bold text-slate-900 mt-1">{hotel.name}</h3>
            <p class="text-xs text-slate-500">📍 {hotel.location}</p>
          </div>
        </div>
      ))}
    </div>
  </section>
</Layout>