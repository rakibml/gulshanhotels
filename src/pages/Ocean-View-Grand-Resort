---
// src/pages/hotel-details.astro
import Layout from '../layouts/Layout.astro';
---

<Layout title="Ocean View Grand Resort - GulshanHotels.com">
  
  <!-- 1. Breadcrumb & Title Header -->
  <div class="bg-[#f8faf9] border-b border-slate-200 py-6 px-4 sm:px-6 lg:px-8">
    <div class="max-w-[1280px] mx-auto">
      
      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 text-xs text-slate-500 mb-3">
        <a href="/" class="hover:text-[#1a382b]">Home</a>
        <span>/</span>
        <a href="/hotels" class="hover:text-[#1a382b]">Hotels</a>
        <span>/</span>
        <span class="text-slate-800 font-semibold">Ocean View Grand Resort</span>
      </nav>

      <!-- Hotel Title & Quick Info -->
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
          <h1 class="font-serif text-2xl sm:text-4xl font-bold text-[#1a382b] mb-2">
            Ocean View Grand Resort
          </h1>
          <div class="flex flex-wrap items-center gap-3 text-xs sm:text-sm text-slate-600">
            <span class="flex items-center gap-1 font-semibold text-amber-700">
              ★ 4.9 <span class="text-slate-500 font-normal">(48 Reviews)</span>
            </span>
            <span>•</span>
            <span class="flex items-center gap-1">
              <svg class="w-4 h-4 fill-[#a87247]" viewBox="0 0 24 24"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>
              Marine Drive, Cox's Bazar, Bangladesh
            </span>
          </div>
        </div>

        <!-- Share & Save Buttons -->
        <div class="flex items-center gap-3">
          <button class="flex items-center gap-1.5 px-3.5 py-2 text-xs font-semibold border border-slate-200 rounded-xl hover:bg-white bg-slate-50 transition">
            🔗 Share
          </button>
          <button class="flex items-center gap-1.5 px-3.5 py-2 text-xs font-semibold border border-slate-200 rounded-xl hover:bg-white bg-slate-50 transition text-rose-600">
            ♥ Save
          </button>
        </div>
      </div>

    </div>
  </div>

  <!-- 2. Airbnb Style Image Gallery Grid -->
  <section class="py-6 px-4 sm:px-6 lg:px-8 max-w-[1280px] mx-auto">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-3 rounded-2xl overflow-hidden max-h-[480px]">
      
      <!-- Big Main Image (Left 2 cols) -->
      <div class="md:col-span-2 md:row-span-2 h-[260px] md:h-[480px]">
        <img src="https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&w=1200&q=80" alt="Ocean View Grand Resort" class="w-full h-full object-cover hover:scale-105 transition-transform duration-500 cursor-pointer" />
      </div>

      <!-- Small Images (Right Grid) -->
      <div class="h-[130px] md:h-[234px]">
        <img src="https://images.unsplash.com/photo-1582719508461-905c673771fd?auto=format&fit=crop&w=600&q=80" alt="Resort Pool" class="w-full h-full object-cover hover:scale-105 transition-transform duration-500 cursor-pointer" />
      </div>

      <div class="h-[130px] md:h-[234px]">
        <img src="https://images.unsplash.com/photo-1542314831-068cd1dbfeeb?auto=format&fit=crop&w=600&q=80" alt="Resort Bedroom" class="w-full h-full object-cover hover:scale-105 transition-transform duration-500 cursor-pointer" />
      </div>

      <div class="h-[130px] md:h-[234px]">
        <img src="https://images.unsplash.com/photo-1571896349842-33c89424de2d?auto=format&fit=crop&w=600&q=80" alt="Resort Balcony" class="w-full h-full object-cover hover:scale-105 transition-transform duration-500 cursor-pointer" />
      </div>

      <div class="h-[130px] md:h-[234px] relative">
        <img src="https://images.unsplash.com/photo-1520250497591-112f2f40a3f4?auto=format&fit=crop&w=600&q=80" alt="Resort Dining" class="w-full h-full object-cover hover:scale-105 transition-transform duration-500 cursor-pointer" />
        <button class="absolute bottom-3 right-3 bg-white/90 backdrop-blur-md text-slate-800 text-xs font-bold px-3 py-1.5 rounded-lg border border-slate-200 shadow hover:bg-white transition">
          View All Photos 📷
        </button>
      </div>

    </div>
  </section>

  <!-- 3. Main Content Split Layout (2 Columns) -->
  <section class="py-8 px-4 sm:px-6 lg:px-8 max-w-[1280px] mx-auto">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-10">
      
      <!-- LEFT COLUMN (70% Area - Hotel Info) -->
      <div class="lg:col-span-2 space-y-10">
        
        <!-- Hosted Badge & Highlights -->
        <div class="flex items-center justify-between pb-6 border-b border-slate-200">
          <div>
            <h2 class="font-serif text-xl font-bold text-[#1a382b]">Entire Luxury Suite • Hosted by Royal Stay Ltd</h2>
            <p class="text-xs sm:text-sm text-slate-500 mt-1">2 Guests • 1 Bedroom • 1 King Bed • 1 Bath • Private Sea View Balcony</p>
          </div>
          <div class="w-12 h-12 rounded-full bg-[#1a382b] text-white flex items-center justify-center font-bold text-sm shrink-0">
            RS
          </div>
        </div>

        <!-- Description -->
        <div class="space-y-3 pb-8 border-b border-slate-200">
          <h3 class="font-serif text-xl font-bold text-[#1a382b]">About this resort</h3>
          <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
            Experience world-class luxury at Ocean View Grand Resort, situated right along the scenic Marine Drive in Cox's Bazar. Enjoy breathtaking sunset views from your private balcony, take a dip in our infinity pool overlooking the sea, and indulge in delicious seafood at our rooftop restaurant. Perfect for couples, families, and solo travelers seeking peace, comfort, and premium hospitality.
          </p>
        </div>

        <!-- Amenities -->
        <div class="space-y-4 pb-8 border-b border-slate-200">
          <h3 class="font-serif text-xl font-bold text-[#1a382b]">What this place offers</h3>
          <div class="grid grid-cols-2 sm:grid-cols-3 gap-4">
            <div class="flex items-center gap-3 p-3.5 bg-slate-50 rounded-xl text-xs sm:text-sm font-medium text-slate-700 border border-slate-100">
              <span class="text-lg">🏊</span> Infinity Pool
            </div>
            <div class="flex items-center gap-3 p-3.5 bg-slate-50 rounded-xl text-xs sm:text-sm font-medium text-slate-700 border border-slate-100">
              <span class="text-lg">📶</span> Free High-speed Wi-Fi
            </div>
            <div class="flex items-center gap-3 p-3.5 bg-slate-50 rounded-xl text-xs sm:text-sm font-medium text-slate-700 border border-slate-100">
              <span class="text-lg">❄️</span> Air Conditioning
            </div>
            <div class="flex items-center gap-3 p-3.5 bg-slate-50 rounded-xl text-xs sm:text-sm font-medium text-slate-700 border border-slate-100">
              <span class="text-lg">🍳</span> Complimentary Breakfast
            </div>
            <div class="flex items-center gap-3 p-3.5 bg-slate-50 rounded-xl text-xs sm:text-sm font-medium text-slate-700 border border-slate-100">
              <span class="text-lg">🚗</span> Free Secure Parking
            </div>
            <div class="flex items-center gap-3 p-3.5 bg-slate-50 rounded-xl text-xs sm:text-sm font-medium text-slate-700 border border-slate-100">
              <span class="text-lg">🌊</span> Ocean View Balcony
            </div>
          </div>
        </div>

        <!-- House Rules & Policies -->
        <div class="space-y-4 pb-8 border-b border-slate-200">
          <h3 class="font-serif text-xl font-bold text-[#1a382b]">Things to know</h3>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 text-xs sm:text-sm text-slate-600">
            <div class="space-y-1">
              <h4 class="font-bold text-slate-800 mb-2">House Rules</h4>
              <p>• Check-in: 12:00 PM - 10:00 PM</p>
              <p>• Check-out: 11:00 AM</p>
              <p>• No smoking indoors</p>
            </div>
            <div class="space-y-1">
              <h4 class="font-bold text-slate-800 mb-2">Safety & Cancellation</h4>
              <p>• Free cancellation up to 48 hours before check-in.</p>
              <p>• 24/7 Front desk security & CCTV coverage.</p>
            </div>
          </div>
        </div>

      </div>

      <!-- RIGHT COLUMN (30% Area - Sticky Booking Box) -->
      <div>
        <div class="sticky top-24 bg-white p-6 rounded-2xl border border-slate-200 shadow-xl space-y-6">
          
          <!-- Price Header -->
          <div class="flex justify-between items-baseline border-b border-slate-100 pb-4">
            <div>
              <span class="text-2xl font-bold text-[#1a382b]">৳৪,৫০—</span>
              <span class="text-xs text-slate-500"> / night</span>
            </div>
            <div class="text-xs font-semibold text-amber-700 flex items-center gap-1">
              ★ 4.9 <span class="text-slate-400">(48)</span>
            </div>
          </div>

          <!-- Booking Box Input Mockup -->
          <div class="border border-slate-200 rounded-xl overflow-hidden text-xs">
            <div class="grid grid-cols-2 border-b border-slate-200">
              <div class="p-3 border-r border-slate-200 bg-slate-50">
                <label class="block font-bold text-slate-500 uppercase text-[10px]">Check-In</label>
                <input type="date" value="2026-08-10" class="w-full bg-transparent font-medium text-slate-800 focus:outline-none cursor-pointer" />
              </div>
              <div class="p-3 bg-slate-50">
                <label class="block font-bold text-slate-500 uppercase text-[10px]">Check-Out</label>
                <input type="date" value="2026-08-12" class="w-full bg-transparent font-medium text-slate-800 focus:outline-none cursor-pointer" />
              </div>
            </div>
            <div class="p-3 bg-slate-50">
              <label class="block font-bold text-slate-500 uppercase text-[10px]">Guests</label>
              <select class="w-full bg-transparent font-medium text-slate-800 focus:outline-none cursor-pointer">
                <option>2 Adults, 1 Room</option>
                <option>1 Adult, 1 Room</option>
              </select>
            </div>
          </div>

          <!-- CTAs -->
          <div class="space-y-3">
            <button class="w-full bg-[#1a382b] hover:bg-[#11251c] text-white font-bold py-3.5 rounded-xl text-sm transition-all shadow-md active:scale-95">
              Reserve / Book Now
            </button>

            <a href="https://wa.me/8801700000000" target="_blank" class="w-full border-2 border-emerald-600 text-emerald-700 hover:bg-emerald-50 font-bold py-3 rounded-xl text-xs flex items-center justify-center gap-2 transition-all">
              💬 Chat on WhatsApp
            </a>

            <a href="tel:+8801700000000" class="w-full bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold py-3 rounded-xl text-xs flex items-center justify-center gap-2 transition-all">
              📞 Call Hotel (+880 1700-000000)
            </a>
          </div>

          <p class="text-[11px] text-center text-slate-400">Instant confirmation. No booking fees charged.</p>

        </div>
      </div>

    </div>
  </section>

  <!-- 4. Guest Reviews Section -->
  <section class="py-12 bg-slate-50 border-t border-slate-200">
    <div class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8">
      <h3 class="font-serif text-2xl font-bold text-[#1a382b] mb-6">Guest Reviews (★ 4.9 out of 5)</h3>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        
        <!-- Review 1 -->
        <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm">
          <div class="flex items-center gap-3 mb-3">
            <div class="w-10 h-10 rounded-full bg-slate-200 font-bold text-slate-700 flex items-center justify-center text-xs">
              RH
            </div>
            <div>
              <h4 class="font-bold text-xs text-slate-800">Rahat Hasan</h4>
              <p class="text-[11px] text-slate-400">Stayed in July 2026</p>
            </div>
          </div>
          <p class="text-xs text-slate-600 leading-relaxed">
            "An amazing place with a direct sea view! The staff were polite, room cleanliness was top notch, and the infinity pool experience was unforgettable."
          </p>
        </div>

        <!-- Review 2 -->
        <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm">
          <div class="flex items-center gap-3 mb-3">
            <div class="w-10 h-10 rounded-full bg-slate-200 font-bold text-slate-700 flex items-center justify-center text-xs">
              SA
            </div>
            <div>
              <h4 class="font-bold text-xs text-slate-800">Sultana Ahmed</h4>
              <p class="text-[11px] text-slate-400">Stayed in June 2026</p>
            </div>
          </div>
          <p class="text-xs text-slate-600 leading-relaxed">
            "Great location right on Marine Drive. The breakfast buffet had plenty of variety. Highly recommended for family trips!"
          </p>
        </div>

      </div>
    </div>
  </section>

</Layout>
