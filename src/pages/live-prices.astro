---
// src/pages/live-prices.astro (Full Control Live Price & Booking Channels Manager)
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Admin Live Price Manager — GulshanHotels">
  <div class="min-h-screen bg-slate-900 text-slate-100 py-10 px-4 sm:px-6 lg:px-8">
    <div class="max-w-2xl mx-auto bg-slate-800 border border-slate-700 rounded-3xl p-6 sm:p-8 shadow-2xl space-y-6 text-left">
      
      <!-- Header -->
      <div class="border-b border-slate-700 pb-4">
        <span class="text-xs font-black uppercase text-emerald-400 tracking-widest block">Instant Cloudflare KV Sync</span>
        <h1 class="text-2xl sm:text-3xl font-black font-serif text-white mt-1">Live Rate & Channel Manager</h1>
        <p class="text-xs text-slate-400 mt-1">Full control over prices, OTA visibility, official site & WhatsApp links.</p>
      </div>

      <!-- Form -->
      <form id="priceManagerForm" class="space-y-6 text-xs sm:text-sm">
        
        <!-- Passcode & Hotel Name -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-slate-300 font-extrabold uppercase text-[11px] mb-1">Admin Passcode</label>
            <input 
              type="password" 
              id="adminPasscode" 
              required 
              placeholder="Enter passcode (default: admin2026)" 
              class="w-full bg-slate-900 border border-slate-700 rounded-xl p-3 text-white focus:outline-none focus:border-emerald-500 transition font-mono"
            />
          </div>

          <div>
            <label class="block text-slate-300 font-extrabold uppercase text-[11px] mb-1">Hotel Name / Title</label>
            <input 
              type="text" 
              id="targetHotel" 
              required 
              placeholder="e.g. The Midori by Lakeshore" 
              class="w-full bg-slate-900 border border-slate-700 rounded-xl p-3 text-white focus:outline-none focus:border-emerald-500 transition"
            />
          </div>
        </div>

        <!-- Top Starting Price -->
        <div class="bg-slate-900 p-4 rounded-2xl border border-slate-700/80 space-y-2">
          <label class="block text-emerald-400 font-black uppercase text-[11px]">Top Card Starting Price Display</label>
          <input 
            type="text" 
            id="startingPriceText" 
            placeholder="e.g. $120 / night or ৳ 18,500 / night" 
            class="w-full bg-slate-800 border border-slate-700 rounded-xl p-3 text-white font-bold focus:outline-none focus:border-emerald-500" 
          />
        </div>

        <!-- OTA CONTROLS GRID -->
        <div class="space-y-4">
          <h3 class="text-xs font-black uppercase text-slate-400 tracking-wider">OTA Channels & Custom Prices</h3>

          <!-- AGODA -->
          <div class="bg-slate-900/90 p-4 rounded-2xl border border-slate-700/80 space-y-3">
            <div class="flex items-center justify-between">
              <span class="font-extrabold text-white text-sm flex items-center gap-2">
                <span class="w-2.5 h-2.5 rounded-full bg-rose-500"></span> 🔴 Agoda Channel
              </span>
              <label class="flex items-center gap-2 cursor-pointer text-xs font-bold text-slate-300">
                <input type="checkbox" id="showAgodaPrice" checked class="w-4 h-4 accent-emerald-500 rounded cursor-pointer" />
                <span>Show Price Tag</span>
              </label>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <input type="text" id="agodaPrice" placeholder="Price (e.g. $114 - leave blank for no price)" class="bg-slate-800 border border-slate-700 rounded-xl p-2.5 text-white" />
              <input type="url" id="agodaUrl" placeholder="Custom Agoda Link (Optional)" class="bg-slate-800 border border-slate-700 rounded-xl p-2.5 text-white" />
            </div>
          </div>

          <!-- BOOKING.COM -->
          <div class="bg-slate-900/90 p-4 rounded-2xl border border-slate-700/80 space-y-3">
            <div class="flex items-center justify-between">
              <span class="font-extrabold text-white text-sm flex items-center gap-2">
                <span class="w-2.5 h-2.5 rounded-full bg-blue-500"></span> 🔵 Booking.com Channel
              </span>
              <label class="flex items-center gap-2 cursor-pointer text-xs font-bold text-slate-300">
                <input type="checkbox" id="showBookingPrice" checked class="w-4 h-4 accent-emerald-500 rounded cursor-pointer" />
                <span>Show Price Tag</span>
              </label>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <input type="text" id="bookingPrice" placeholder="Price (e.g. $120 - leave blank for no price)" class="bg-slate-800 border border-slate-700 rounded-xl p-2.5 text-white" />
              <input type="url" id="bookingUrl" placeholder="Custom Booking.com Link (Optional)" class="bg-slate-800 border border-slate-700 rounded-xl p-2.5 text-white" />
            </div>
          </div>

          <!-- EXPEDIA -->
          <div class="bg-slate-900/90 p-4 rounded-2xl border border-slate-700/80 space-y-3">
            <div class="flex items-center justify-between">
              <span class="font-extrabold text-white text-sm flex items-center gap-2">
                <span class="w-2.5 h-2.5 rounded-full bg-yellow-500"></span> 🟡 Expedia Channel
              </span>
              <label class="flex items-center gap-2 cursor-pointer text-xs font-bold text-slate-300">
                <input type="checkbox" id="showExpediaPrice" checked class="w-4 h-4 accent-emerald-500 rounded cursor-pointer" />
                <span>Show Price Tag</span>
              </label>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <input type="text" id="expediaPrice" placeholder="Price (e.g. $125 - leave blank for no price)" class="bg-slate-800 border border-slate-700 rounded-xl p-2.5 text-white" />
              <input type="url" id="expediaUrl" placeholder="Custom Expedia Link (Optional)" class="bg-slate-800 border border-slate-700 rounded-xl p-2.5 text-white" />
            </div>
          </div>

          <!-- OFFICIAL HOTEL WEBSITE -->
          <div class="bg-slate-900/90 p-4 rounded-2xl border border-slate-700/80 space-y-3">
            <div class="flex items-center justify-between">
              <span class="font-extrabold text-white text-sm flex items-center gap-2">
                <span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span> 🏨 Official Hotel Partner
              </span>
              <label class="flex items-center gap-2 cursor-pointer text-xs font-bold text-slate-300">
                <input type="checkbox" id="showDirectPrice" checked class="w-4 h-4 accent-emerald-500 rounded cursor-pointer" />
                <span>Show Price Tag</span>
              </label>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <input type="text" id="directPrice" placeholder="Price (e.g. $110 - leave blank for no price)" class="bg-slate-800 border border-slate-700 rounded-xl p-2.5 text-white" />
              <input type="url" id="directUrl" placeholder="Official Website URL (e.g. https://...)" class="bg-slate-800 border border-slate-700 rounded-xl p-2.5 text-white" />
            </div>
          </div>

          <!-- WHATSAPP DIRECT BOOKING -->
          <div class="bg-slate-900/90 p-4 rounded-2xl border border-slate-700/80 space-y-3">
            <div class="flex items-center justify-between">
              <span class="font-extrabold text-white text-sm flex items-center gap-2">
                <span class="w-2.5 h-2.5 rounded-full bg-emerald-400"></span> 💬 WhatsApp Direct Channel
              </span>
              <label class="flex items-center gap-2 cursor-pointer text-xs font-bold text-slate-300">
                <input type="checkbox" id="enableWhatsapp" checked class="w-4 h-4 accent-emerald-500 rounded cursor-pointer" />
                <span>Show WhatsApp Channel</span>
              </label>
            </div>
            <div>
              <input type="text" id="whatsappNumber" placeholder="WhatsApp Number (e.g. 8801700000000)" class="w-full bg-slate-800 border border-slate-700 rounded-xl p-2.5 text-white" />
            </div>
          </div>

        </div>

        <!-- Submit Button -->
        <div class="pt-4">
          <button 
            type="submit" 
            id="savePriceBtn" 
            class="w-full bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-black uppercase tracking-wider py-4 rounded-xl shadow-lg transition cursor-pointer text-xs"
          >
            Save Live Rates & Channels ⚡ (0.1s Global Sync)
          </button>
        </div>

      </form>

      <!-- Status Alert -->
      <div id="statusAlert" class="hidden p-4 rounded-xl text-xs font-bold text-center"></div>

    </div>
  </div>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const form = document.getElementById('priceManagerForm');
      const passcodeEl = document.getElementById('adminPasscode');
      const hotelEl = document.getElementById('targetHotel');
      const startingPriceEl = document.getElementById('startingPriceText');
      const saveBtn = document.getElementById('savePriceBtn');
      const alertEl = document.getElementById('statusAlert');

      // Remember passcode
      if (passcodeEl) {
        passcodeEl.value = localStorage.getItem('gh_admin_passcode') || 'admin2026';
      }

      if (form) {
        form.addEventListener('submit', async (e) => {
          e.preventDefault();
          
          const passcode = passcodeEl.value.trim();
          localStorage.setItem('gh_admin_passcode', passcode);

          if (saveBtn) {
            saveBtn.disabled = true;
            saveBtn.innerText = 'Syncing Cloudflare KV...';
          }

          if (alertEl) alertEl.className = 'hidden';

          const payload = {
            passcode: passcode,
            hotel: hotelEl.value.trim(),
            startingPrice: startingPriceEl.value.trim(),
            channels: {
              agoda: {
                price: document.getElementById('agodaPrice')?.value.trim() || '',
                showPrice: document.getElementById('showAgodaPrice')?.checked ?? true,
                url: document.getElementById('agodaUrl')?.value.trim() || ''
              },
              booking: {
                price: document.getElementById('bookingPrice')?.value.trim() || '',
                showPrice: document.getElementById('showBookingPrice')?.checked ?? true,
                url: document.getElementById('bookingUrl')?.value.trim() || ''
              },
              expedia: {
                price: document.getElementById('expediaPrice')?.value.trim() || '',
                showPrice: document.getElementById('showExpediaPrice')?.checked ?? true,
                url: document.getElementById('expediaUrl')?.value.trim() || ''
              },
              direct: {
                price: document.getElementById('directPrice')?.value.trim() || '',
                showPrice: document.getElementById('showDirectPrice')?.checked ?? true,
                url: document.getElementById('directUrl')?.value.trim() || ''
              },
              whatsapp: {
                enable: document.getElementById('enableWhatsapp')?.checked ?? true,
                number: document.getElementById('whatsappNumber')?.value.trim() || ''
              }
            }
          };

          try {
            const res = await fetch('https://gatlin.rmollah394.workers.dev/api/admin/update-prices', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(payload)
            });

            const json = await res.json();

            if (res.ok && json.success) {
              if (alertEl) {
                alertEl.textContent = '✅ ' + json.message;
                alertEl.className = 'p-4 rounded-xl text-xs font-bold text-center bg-emerald-950 border border-emerald-500/50 text-emerald-300 block';
              }
            } else {
              if (alertEl) {
                alertEl.textContent = '❌ Error: ' + (json.error || 'Failed to update channel rates');
                alertEl.className = 'p-4 rounded-xl text-xs font-bold text-center bg-rose-950 border border-rose-500/50 text-rose-300 block';
              }
            }
          } catch (err) {
            if (alertEl) {
              alertEl.textContent = '❌ Network Error: ' + err.message;
              alertEl.className = 'p-4 rounded-xl text-xs font-bold text-center bg-rose-950 border border-rose-500/50 text-rose-300 block';
            }
          } finally {
            if (saveBtn) {
              saveBtn.disabled = false;
              saveBtn.innerText = 'Save Live Rates & Channels ⚡ (0.1s Global Sync)';
            }
          }
        });
      }
    });
  </script>
</Layout>
