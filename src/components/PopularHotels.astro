---
// src/components/PopularHotels.astro (100% Ultra-Professional Booking.com/Agoda Style - No Rank Numbers)
import { getCollection } from 'astro:content';

interface Props {
  title?: string;
  subtitle?: string;
}

const { 
  title = "Popular Hotels in Gulshan", 
  subtitle = "Handpicked top luxury, business & boutique stays recommended by travelers." 
} = Astro.props;

// 1. Fetch Hotels from Astro Content Collection
let hotels: any[] = [];
try {
  const allHotels = await getCollection('hotels');
  hotels = allHotels.filter(h => h.data.popular !== false);
} catch (e) {
  hotels = [];
}

// Fallback if collection is empty
if (!hotels || hotels.length === 0) {
  try {
    const glob1 = import.meta.glob('../content/hotels/*.md', { eager: true });
    const glob2 = import.meta.glob('../../content/hotels/*.md', { eager: true });
    const combined = { ...glob1, ...glob2 };
    hotels = Object.entries(combined).map(([filePath, item]: [string, any]) => ({
      slug: filePath.split('/').pop()?.replace('.md', ''),
      data: item.frontmatter || {}
    }));
  } catch (e) {
    hotels = [];
  }
}

// 2. Fetch Approved Guest Reviews from src/content/reviews/
let allCmsReviews: any[] = [];
try {
  const reviewsCol = await getCollection('reviews');
  if (Array.isArray(reviewsCol) && reviewsCol.length > 0) {
    allCmsReviews = reviewsCol.map(r => r.data || {});
  }
} catch (e) {
  try {
    const glob1 = import.meta.glob('../content/reviews/*.md', { eager: true });
    const glob2 = import.meta.glob('../../content/reviews/*.md', { eager: true });
    const combined = { ...glob1, ...glob2 };
    allCmsReviews = Object.values(combined).map((item: any) => item.frontmatter || {});
  } catch (err) {
    allCmsReviews = [];
  }
}

// Helper: Strict Review Matching Logic per Hotel
function getHotelReviewStats(hData: any, hSlug: string) {
  const hTitleLower = (hData.title || hData.name || "").trim().toLowerCase();
  const hSlugLower = (hData.slug || hSlug || "").trim().toLowerCase();

  const matchedCmsReviews = allCmsReviews.filter(r => {
    if (!r) return false;
    const isApproved = r.approved === true || String(r.approved).toLowerCase() === 'true';
    if (!isApproved) return false;

    const rHotel = (r.hotel || '').trim().toLowerCase();
    const rSlug = (r.slug || r.hotelSlug || '').trim().toLowerCase();

    const matchSlug = rSlug && hSlugLower && (rSlug === hSlugLower || hSlugLower.includes(rSlug) || rSlug.includes(hSlugLower));
    const matchTitle = rHotel && hTitleLower && (rHotel === hTitleLower || hTitleLower.includes(rHotel) || rHotel.includes(hTitleLower));

    return matchSlug || matchTitle;
  });

  const embeddedReviews = Array.isArray(hData.reviews) ? hData.reviews : (Array.isArray(hData.user_reviews) ? hData.user_reviews : []);
  const activeReviews = matchedCmsReviews.length > 0 ? matchedCmsReviews : embeddedReviews;

  if (activeReviews.length > 0) {
    const count = activeReviews.length;
    const totalStars = activeReviews.reduce((sum: number, r: any) => {
      const num = parseFloat(r.rating);
      return sum + (!isNaN(num) && num > 0 && num <= 5 ? num : 5);
    }, 0);

    const avg = (totalStars / count).toFixed(1);
    const clampedAvg = Math.min(Math.max(parseFloat(avg) || 5.0, 1.0), 5.0).toFixed(1);

    return {
      rating: clampedAvg,
      reviewsCount: count,
      hasReviews: true
    };
  }

  // Check if hotel frontmatter has a valid rating (<= 5.0)
  if (hData.rating) {
    const rawR = parseFloat(hData.rating);
    if (!isNaN(rawR) && rawR > 0 && rawR <= 5.0) {
      const count = parseInt(hData.reviewsCount || hData.reviews_count || "0", 10) || 0;
      return {
        rating: rawR.toFixed(1),
        reviewsCount: count,
        hasReviews: count > 0
      };
    }
  }

  return {
    rating: "5.0",
    reviewsCount: 0,
    hasReviews: false
  };
}
---

<!-- POPULAR HOTELS SECTION -->
<section id="hotels" class="bg-[#F8FAF9] py-10 px-4 sm:px-8 lg:px-12 max-w-[1550px] mx-auto text-slate-900 border-b border-slate-200/80">
  <div class="space-y-6">
    
    <!-- Section Header -->
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-end gap-3 text-left border-b border-slate-200/80 pb-4">
      <div class="space-y-1">
        <h2 class="text-2xl sm:text-3xl font-black font-sans text-slate-900 tracking-tight">
          {title}
        </h2>
        <p class="text-xs sm:text-sm text-slate-600 font-medium">
          {subtitle}
        </p>
      </div>

      <a href="/#hotels" class="text-xs sm:text-sm font-extrabold text-emerald-800 hover:underline transition shrink-0">
        View all hotels ➔
      </a>
    </div>

    <!-- Carousel Track Container -->
    <div class="relative group">
      
      <!-- Carousel Navigation Arrows -->
      {hotels.length > 3 && (
        <button id="popPrevBtn" aria-label="Previous Hotels" class="absolute -left-3 sm:-left-5 top-1/2 -translate-y-1/2 w-10 h-10 rounded-full bg-white border border-slate-300 shadow-xl text-slate-800 hover:bg-[#0d3b23] hover:text-white transition z-20 cursor-pointer flex items-center justify-center text-sm font-bold active:scale-95">❮</button>
      )}
      {hotels.length > 3 && (
        <button id="popNextBtn" aria-label="Next Hotels" class="absolute -right-3 sm:-right-5 top-1/2 -translate-y-1/2 w-10 h-10 rounded-full bg-white border border-slate-300 shadow-xl text-slate-800 hover:bg-[#0d3b23] hover:text-white transition z-20 cursor-pointer flex items-center justify-center text-sm font-bold active:scale-95">❯</button>
      )}

      <!-- Track -->
      <div id="popularHotelsTrack" class="flex gap-5 overflow-x-auto scroll-smooth py-3 px-1 [scrollbar-width:none] [-ms-overflow-style:none] [&::-webkit-scrollbar]:hidden">
        {hotels.map((hotelItem: any) => {
          const hData = hotelItem.data || {};
          const hTitle = hData.title || hData.name || "Hotel Details";
          const hSlug = hData.slug || hotelItem.slug || hotelItem.id || "hotel";
          const hImage = hData.image || (Array.isArray(hData.gallery) ? hData.gallery[0] : "https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&w=600&q=80");
          const hCategory = hData.category || "5-Star Luxury Stay";
          const hLocation = hData.location || "Gulshan 2, Dhaka";
          const hPrice = hData.price || "$120";

          // Calculate Exact Synced Rating Stats
          const stats = getHotelReviewStats(hData, hSlug);

          return (
            <div class="popular-card-item w-[290px] sm:w-[330px] shrink-0 bg-white rounded-2xl border border-slate-200/90 overflow-hidden shadow-xs hover:shadow-xl transition-all duration-300 flex flex-col justify-between group text-left relative">
              
              <!-- Card Image Header -->
              <div class="relative w-full h-52 sm:h-56 overflow-hidden bg-slate-900">
                <img 
                  src={hImage} 
                  alt={`${hTitle} Photo`} 
                  loading="lazy" 
                  decoding="async" 
                  class="w-full h-full object-cover group-hover:scale-105 transition duration-500" 
                />

                <!-- Category Pill Badge (Top Left) -->
                <span class="absolute top-3 left-3 bg-slate-950/80 backdrop-blur-md text-emerald-400 text-[10px] font-black uppercase tracking-wider px-2.5 py-1 rounded-lg border border-white/10 shadow-sm">
                  {hCategory}
                </span>

                <!-- Wishlist Heart Button (Top Right) -->
                <button 
                  type="button"
                  class="card-wishlist-btn absolute top-3 right-3 w-8 h-8 rounded-full bg-white/90 hover:bg-white text-slate-800 flex items-center justify-center shadow-md transition cursor-pointer hover:scale-110 z-10"
                  data-title={hTitle}
                  data-image={hImage}
                  data-url={`/${hSlug}`}
                  data-price={hPrice}
                  aria-label="Add to Wishlist"
                >
                  <svg class="w-4 h-4 text-slate-700 transition" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path></svg>
                </button>
              </div>

              <!-- Card Body -->
              <div class="p-5 space-y-3 flex-1 flex flex-col justify-between">
                <div class="space-y-2">
                  
                  <!-- Hotel Title -->
                  <a href={`/${hSlug}`} class="block">
                    <h3 class="font-extrabold text-slate-900 text-base sm:text-lg leading-tight group-hover:text-emerald-800 transition line-clamp-1">
                      {hTitle}
                    </h3>
                  </a>

                  <!-- Location Address with Map Pin -->
                  <p class="text-xs text-slate-500 font-medium flex items-center gap-1">
                    <svg class="w-3.5 h-3.5 fill-emerald-600 shrink-0" viewBox="0 0 24 24"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>
                    <span class="truncate">{hLocation}</span>
                  </p>

                  <!-- RATING BADGE & REVIEW COUNT (BOOKING.COM / AGODA STYLE) -->
                  {stats.hasReviews ? (
                    <div class="flex items-center gap-2 pt-1">
                      <span class="bg-emerald-800 text-white font-black text-xs px-2.5 py-0.5 rounded-md shadow-2xs">
                        {stats.rating}
                      </span>
                      <span class="text-xs font-extrabold text-emerald-900">Excellent</span>
                      <span class="text-xs text-slate-400 font-normal">({stats.reviewsCount} {stats.reviewsCount === 1 ? 'review' : 'reviews'})</span>
                    </div>
                  ) : (
                    <div class="pt-1">
                      <span class="bg-slate-100 text-slate-600 border border-slate-200 text-[10px] font-bold px-2.5 py-0.5 rounded-md inline-block">
                        New Property
                      </span>
                    </div>
                  )}

                </div>

                <!-- PRICE & CTA BUTTON FOOTER LINE -->
                <div class="pt-3 border-t border-slate-100 flex items-center justify-between mt-3">
                  <div class="text-left">
                    <span class="text-[10px] font-extrabold text-slate-400 uppercase tracking-wider block leading-none">Starting from</span>
                    <span class="text-base sm:text-lg font-black text-slate-900 mt-0.5 block">{hPrice.startsWith('$') || hPrice.startsWith('৳') ? hPrice : '$' + hPrice}</span>
                  </div>

                  <a 
                    href={`/${hSlug}`} 
                    class="bg-[#0d3b23] hover:bg-[#061e14] text-white font-extrabold text-xs px-4 py-2.5 rounded-xl transition shadow-sm group-hover:scale-105 shrink-0"
                  >
                    View Deals ➔
                  </a>
                </div>
              </div>

            </div>
          );
        })}
      </div>

    </div>

  </div>
</section>

<!-- CLIENT SCRIPT FOR CAROUSEL SCROLL & WISHLIST TOGGLE -->
<script is:inline>
  const initPopularHotelsSection = () => {
    const track = document.getElementById('popularHotelsTrack');
    const prevBtn = document.getElementById('popPrevBtn');
    const nextBtn = document.getElementById('popNextBtn');

    if (track && prevBtn && nextBtn) {
      prevBtn.addEventListener('click', () => {
        track.scrollBy({ left: -320, behavior: 'smooth' });
      });

      nextBtn.addEventListener('click', () => {
        track.scrollBy({ left: 320, behavior: 'smooth' });
      });
    }

    // Wishlist Heart Toggle Handler
    document.querySelectorAll('.card-wishlist-btn').forEach(btn => {
      const title = btn.getAttribute('data-title') || '';
      
      let list = [];
      try {
        list = JSON.parse(localStorage.getItem('gh_wishlist') || '[]');
      } catch (err) {
        list = [];
      }

      const isSaved = list.some(item => item.title === title);
      const iconSvg = btn.querySelector('svg');
      if (isSaved && iconSvg) {
        iconSvg.setAttribute('fill', 'currentColor');
        iconSvg.classList.add('text-rose-600');
        iconSvg.classList.remove('text-slate-700');
      }

      btn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();

        const image = btn.getAttribute('data-image') || '';
        const url = btn.getAttribute('data-url') || '';
        const price = btn.getAttribute('data-price') || '';

        try {
          list = JSON.parse(localStorage.getItem('gh_wishlist') || '[]');
        } catch (err) {
          list = [];
        }

        const existingIndex = list.findIndex(item => item.title === title);

        if (existingIndex > -1) {
          list.splice(existingIndex, 1);
          if (iconSvg) {
            iconSvg.setAttribute('fill', 'none');
            iconSvg.classList.remove('text-rose-600');
            iconSvg.classList.add('text-slate-700');
          }
        } else {
          list.push({ title, image, url, price });
          if (iconSvg) {
            iconSvg.setAttribute('fill', 'currentColor');
            iconSvg.classList.remove('text-slate-700');
            iconSvg.classList.add('text-rose-600');
          }
        }

        localStorage.setItem('gh_wishlist', JSON.stringify(list));

        const countEl = document.getElementById('wishlist-count');
        if (countEl) {
          if (list.length > 0) {
            countEl.textContent = list.length.toString();
            countEl.classList.remove('hidden');
          } else {
            countEl.classList.add('hidden');
          }
        }
      });
    });
  };

  document.addEventListener('DOMContentLoaded', initPopularHotelsSection);
  document.addEventListener('astro:page-load', initPopularHotelsSection);
</script>
