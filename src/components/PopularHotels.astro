---
interface Props {
  popularHotels: any[];
}
const { popularHotels = [] } = Astro.props;
---

<section id="popular-hotels" class="bg-[#F8FAF9] py-16 border-b border-slate-200 relative overflow-hidden">
  <div class="max-w-[1550px] mx-auto px-4 sm:px-8 lg:px-12 space-y-8">
    
    <!-- Section Header -->
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 border-b border-slate-200 pb-4">
      <div>
        <span class="text-xs font-black text-emerald-800 uppercase tracking-widest bg-emerald-100/70 px-3 py-1 rounded-full border border-emerald-300/60 inline-block mb-2">
          POPULAR ACCOMMODATIONS
        </span>
        <h2 class="text-3xl sm:text-4xl font-black text-slate-900 tracking-tight">Popular Hotels in Gulshan</h2>
        <p class="text-xs sm:text-sm text-slate-500 font-medium mt-1">Handpicked luxury and executive hotels recommended by our local audit team.</p>
      </div>

      <!-- Navigation & View All Link -->
      <div class="flex items-center gap-4">
        <div class="flex items-center gap-2">
          <button id="popularPrevBtn" aria-label="Previous Slide" class="w-10 h-10 rounded-full bg-white border border-slate-200 shadow-sm flex items-center justify-center text-slate-700 hover:bg-[#0d3b23] hover:text-white transition-all cursor-pointer active:scale-95">❮</button>
          <button id="popularNextBtn" aria-label="Next Slide" class="w-10 h-10 rounded-full bg-white border border-slate-200 shadow-sm flex items-center justify-center text-slate-700 hover:bg-[#0d3b23] hover:text-white transition-all cursor-pointer active:scale-95">❯</button>
        </div>
        <a href="#all-hotels" class="text-emerald-800 hover:text-emerald-600 font-black text-xs uppercase tracking-wider shrink-0 transition-colors flex items-center gap-1">
          View All Hotels <span>➔</span>
        </a>
      </div>
    </div>

    <!-- Carousel Track -->
    <div id="popularCarouselTrack" class="flex gap-6 overflow-x-auto scroll-smooth py-3 [scrollbar-width:none] [-ms-overflow-style:none] [&::-webkit-scrollbar]:hidden">
      {popularHotels.map((hotel: any) => (
        <article class="w-[300px] sm:w-[350px] shrink-0 bg-white rounded-3xl shadow-sm border border-slate-200/90 overflow-hidden flex flex-col justify-between hover:shadow-xl hover:-translate-y-1 transition duration-300 group relative">
          
          <div>
            <!-- Hotel Image & Badges -->
            <div class="relative h-56 overflow-hidden bg-slate-100">
              {hotel.image ? (
                <a href={`/${hotel.slug}`} class="block w-full h-full">
                  <img src={hotel.image} alt={hotel.title} loading="lazy" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
                </a>
              ) : (
                <div class="w-full h-full flex items-center justify-center bg-slate-200 text-slate-400 font-bold text-sm">No Image Available</div>
              )}

              <!-- 1. CATEGORY BADGE (CMS Controlled) -->
              {hotel.showCategory !== false && hotel.category && (
                <span class="absolute top-3 left-3 bg-[#0d3b23]/90 backdrop-blur-md text-emerald-300 text-[10px] font-black uppercase px-3 py-1 rounded-lg shadow-md border border-emerald-500/30">
                  {hotel.category}
                </span>
              )}

              <!-- Wishlist Heart Button -->
              <button 
                data-hotel-slug={hotel.slug}
                data-hotel-title={hotel.title}
                data-hotel-image={hotel.image}
                class="wishlist-toggle-btn absolute top-3 right-3 w-9 h-9 rounded-full bg-white/90 backdrop-blur-md shadow-md flex items-center justify-center text-slate-400 hover:text-rose-500 transition-colors cursor-pointer"
                title="Save to Wishlist"
              >
                <svg class="w-5 h-5 fill-current pointer-events-none" viewBox="0 0 24 24">
                  <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
                </svg>
              </button>
            </div>

            <!-- Card Content Body -->
            <div class="p-6 space-y-3">
              
              <!-- Location & Rating Row -->
              <div class="flex justify-between items-start gap-2">
                
                <!-- 2. LOCATION & DETAILED ADDRESS (CMS Controlled) -->
                {hotel.showLocation !== false && (hotel.location || hotel.locationDetail) && (
                  <div class="space-y-0.5 flex-1">
                    {hotel.location && (
                      <span class="font-bold text-slate-600 flex items-center gap-1 text-xs">
                        📍 {hotel.location}
                      </span>
                    )}
                    {hotel.locationDetail && (
                      <p class="text-[11px] text-slate-500 leading-snug font-normal pt-0.5">
                        {hotel.locationDetail}
                      </p>
                    )}
                  </div>
                )}

                <!-- 3. RATING BADGE (CMS Controlled) -->
                {hotel.showRating !== false && hotel.rating && (
                  <span class="bg-amber-50 text-amber-700 px-2 py-0.5 rounded-md font-black text-[11px] border border-amber-200/80 shrink-0">
                    ★ {hotel.rating}
                  </span>
                )}
              </div>

              <!-- Title -->
              <a href={`/${hotel.slug}`} class="block text-xl font-black text-slate-900 group-hover:text-emerald-800 transition line-clamp-1">
                {hotel.title}
              </a>

              <!-- 4. DESCRIPTION (CMS Controlled) -->
              {hotel.showDescription !== false && hotel.description && (
                <p class="text-xs text-slate-600 line-clamp-2 leading-relaxed font-medium">
                  {hotel.description}
                </p>
              )}

            </div>
          </div>

          <!-- 5. BUTTON ACTIONS (CMS Controlled) -->
          {(hotel.showCheckPrice !== false || hotel.showDetailsBtn !== false) && (
            <div class="p-6 pt-4 border-t border-slate-100 flex items-center justify-between gap-3 bg-slate-50/50">
              {hotel.showCheckPrice !== false && (
                <button data-title={hotel.title} data-slug={hotel.slug} class="open-price-modal flex-1 bg-[#0d3b23] hover:bg-emerald-900 text-white font-black py-3 px-3 rounded-xl text-xs uppercase tracking-wider shadow transition duration-200 cursor-pointer text-center active:scale-95">
                  Check Price
                </button>
              )}
              {hotel.showDetailsBtn !== false && (
                <a href={`/${hotel.slug}`} class="flex-1 bg-white border border-slate-200 hover:bg-slate-100 text-slate-800 font-bold py-3 px-3 rounded-xl text-xs uppercase tracking-wider transition text-center shadow-xs">
                  Details
                </a>
              )}
            </div>
          )}

        </article>
      ))}
    </div>

  </div>
</section>

<!-- REALTIME STAY22 PRICE COMPARISON POPUP MODAL -->
<div id="priceModal" class="fixed inset-0 z-50 bg-slate-950/80 backdrop-blur-md hidden flex items-center justify-center p-4">
  <div class="bg-slate-900 border border-slate-800 rounded-3xl p-6 w-full max-w-md text-white space-y-4 shadow-2xl relative max-h-[85vh] flex flex-col justify-between">
    <div class="flex items-center justify-between border-b border-slate-800 pb-3">
      <div>
        <span class="text-[10px] uppercase font-bold text-emerald-400 tracking-widest block">Live Stay22 API Match</span>
        <h3 id="modalHotelTitle" class="text-base font-black text-white truncate max-w-[280px]">Compare Platform Rates</h3>
      </div>
      <button id="closePriceModalBtn" class="text-slate-400 hover:text-white text-2xl font-bold w-8 h-8 rounded-full flex items-center justify-center hover:bg-slate-800 cursor-pointer">&times;</button>
    </div>
    <div id="modalRatesContainer" class="space-y-2.5 overflow-y-auto max-h-[350px] pr-1">
      <div class="text-center py-8 bg-slate-950/60 rounded-2xl border border-slate-800 space-y-2">
        <span class="inline-block w-6 h-6 border-2 border-emerald-400 border-t-transparent rounded-full animate-spin"></span>
        <p class="text-xs font-bold text-slate-300">Fetching live rates from Stay22 API...</p>
      </div>
    </div>
    <div class="pt-3 border-t border-slate-800 space-y-2">
      <a id="modalWhatsappBtn" href="https://wa.me/8801700000000" target="_blank" rel="noopener noreferrer" class="w-full bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-xs py-3 rounded-xl transition flex items-center justify-center gap-2 shadow-lg cursor-pointer">
        💬 Instant WhatsApp Reservation
      </a>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Carousel Scroll Logic
    const track = document.getElementById('popularCarouselTrack');
    const prevBtn = document.getElementById('popularPrevBtn');
    const nextBtn = document.getElementById('popularNextBtn');

    if (track && prevBtn && nextBtn) {
      prevBtn.addEventListener('click', () => track.scrollBy({ left: -374, behavior: 'smooth' }));
      nextBtn.addEventListener('click', () => track.scrollBy({ left: 374, behavior: 'smooth' }));
    }

    // Modal & API Logic
    const priceModal = document.getElementById('priceModal');
    const closeModalBtn = document.getElementById('closePriceModalBtn');
    const modalTitle = document.getElementById('modalHotelTitle');
    const ratesContainer = document.getElementById('modalRatesContainer');
    const whatsappBtn = document.getElementById('modalWhatsappBtn') as HTMLAnchorElement | null;

    const closeModal = () => priceModal?.classList.add('hidden');
    if (closeModalBtn) closeModalBtn.addEventListener('click', closeModal);
    if (priceModal) priceModal.addEventListener('click', (e) => { if (e.target === priceModal) closeModal(); });

    document.querySelectorAll('.open-price-modal').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const title = btn.getAttribute('data-title') || 'Hotel';
        if (modalTitle) modalTitle.textContent = title;
        if (whatsappBtn) {
          whatsappBtn.href = `https://wa.me/8801700000000?text=${encodeURIComponent(`Hi GulshanHotels! Inquiring about ${title}`)}`;
        }
        if (ratesContainer) {
          ratesContainer.innerHTML = `<div class="text-center py-8"><span class="inline-block w-6 h-6 border-2 border-emerald-400 border-t-transparent rounded-full animate-spin"></span><p class="text-xs text-slate-300 mt-2">Fetching live rates...</p></div>`;
        }
        priceModal?.classList.remove('hidden');

        try {
          const res = await fetch(`https://gatlin.rmollah394.workers.dev/?hotel=${encodeURIComponent(title)}`);
          const data = await res.json();
          if (ratesContainer) {
            const stay22Url = `https://www.stay22.com/embed/lma?lma=6a6f2f890ba4510dcd28ab5c&address=${encodeURIComponent(title + ' Gulshan Dhaka')}`;
            ratesContainer.innerHTML = `
              <div class="p-4 bg-slate-950/80 rounded-2xl border border-slate-800 text-center space-y-3">
                <p class="text-xs text-slate-200 font-bold">Best prices ready for ${title}</p>
                <a href="${stay22Url}" target="_blank" rel="noopener noreferrer" class="block w-full bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-xs py-2.5 rounded-xl transition">Compare Live Platform Rates ↗</a>
              </div>
            `;
          }
        } catch {
          if (ratesContainer) ratesContainer.innerHTML = `<p class="text-xs text-center text-slate-400 py-4">Direct rates loading error. Please contact WhatsApp.</p>`;
        }
      });
    });

    // Wishlist Logic
    const getWishlist = () => JSON.parse(localStorage.getItem('gulshan_wishlist') || '[]');
    const updateWishlistUI = () => {
      const wishlist = getWishlist();
      document.querySelectorAll('.wishlist-toggle-btn').forEach((btn) => {
        const slug = btn.getAttribute('data-hotel-slug');
        if (wishlist.some((item: any) => item.slug === slug)) {
          btn.classList.add('text-rose-500'); btn.classList.remove('text-slate-400');
        } else {
          btn.classList.remove('text-rose-500'); btn.classList.add('text-slate-400');
        }
      });
    };

    document.querySelectorAll('.wishlist-toggle-btn').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const slug = btn.getAttribute('data-hotel-slug');
        const title = btn.getAttribute('data-hotel-title');
        const image = btn.getAttribute('data-hotel-image');
        if (!slug) return;
        let wishlist = getWishlist();
        const idx = wishlist.findIndex((item: any) => item.slug === slug);
        if (idx > -1) wishlist.splice(idx, 1);
        else wishlist.push({ slug, title, image });
        localStorage.setItem('gulshan_wishlist', JSON.stringify(wishlist));
        updateWishlistUI();
        window.dispatchEvent(new Event('wishlistUpdated'));
      });
    });

    updateWishlistUI();
  });
</script>
