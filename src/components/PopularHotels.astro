---
// src/components/PopularHotels.astro (Hero-Overlap Safe, Clean Booking Branding & Real Review Sync)
import { getCollection } from 'astro:content';

interface Props {
  title?: string;
  subtitle?: string;
  featuredHotels?: any[];
}

const { 
  title = "Popular Hotels in Gulshan, Dhaka", 
  subtitle = "Handpicked top luxury & executive stays recommended by verified guest reviews.",
  featuredHotels = []
} = Astro.props;

// 1. Fetch All Hotels from Content Collection
let allHotels: any[] = [];
try {
  const collectionHotels = await getCollection('hotels');
  if (Array.isArray(collectionHotels)) {
    allHotels = collectionHotels;
  }
} catch (e) {
  allHotels = [];
}

if (allHotels.length === 0) {
  try {
    const glob1 = import.meta.glob('/src/content/hotels/*.md', { eager: true });
    const glob2 = import.meta.glob('../content/hotels/*.md', { eager: true });
    const glob3 = import.meta.glob('../../content/hotels/*.md', { eager: true });
    const combined = { ...glob1, ...glob2, ...glob3 };
    allHotels = Object.entries(combined).map(([filePath, item]: [string, any]) => ({
      slug: filePath.split('/').pop()?.replace('.md', ''),
      data: item.frontmatter || {}
    }));
  } catch (e) {
    allHotels = [];
  }
}

// 2. Filter & Sort Hotels
let hotels: any[] = [];
const selectedSlugs = Array.isArray(featuredHotels) 
  ? featuredHotels.map((item: any) => {
      if (typeof item === 'object' && item !== null) {
        return item.hotel_slug || item.slug || item.title || item.name || '';
      }
      return String(item || '');
    }).filter(Boolean)
  : [];

if (selectedSlugs.length > 0) {
  selectedSlugs.forEach(slugStr => {
    const cleanTarget = String(slugStr).trim().toLowerCase();
    const found = allHotels.find(h => {
      const hSlug = String(h.data?.slug || h.slug || h.id || '').trim().toLowerCase();
      const hTitle = String(h.data?.title || h.data?.name || '').trim().toLowerCase();
      return hSlug === cleanTarget || hTitle === cleanTarget || cleanTarget.includes(hSlug) || cleanTarget.includes(hTitle);
    });
    if (found && !hotels.some(x => (x.data?.title || x.slug) === (found.data?.title || found.slug))) {
      hotels.push(found);
    }
  });
}

if (hotels.length === 0) {
  const uniqueHotelsMap = new Map();
  allHotels.forEach(h => {
    if (h.data?.popular !== false && (h.data?.title || h.data?.name)) {
      const key = (h.data?.title || h.data?.name || h.slug || h.id || '').trim().toLowerCase();
      if (key && !uniqueHotelsMap.has(key)) {
        uniqueHotelsMap.set(key, h);
      }
    }
  });
  hotels = Array.from(uniqueHotelsMap.values());
}

// 3. Fetch Approved Guest Reviews
let allCmsReviews: any[] = [];
try {
  const reviewsCol = await getCollection('reviews');
  if (Array.isArray(reviewsCol) && reviewsCol.length > 0) {
    reviewsCol.forEach(r => { if (r && r.data) allCmsReviews.push(r.data); });
  }
} catch (e) {}

try {
  const glob1 = import.meta.glob('/src/content/reviews/*.md', { eager: true });
  const glob2 = import.meta.glob('../content/reviews/*.md', { eager: true });
  const glob3 = import.meta.glob('../../content/reviews/*.md', { eager: true });
  const combined = { ...glob1, ...glob2, ...glob3 };
  Object.values(combined).forEach((mod: any) => {
    if (mod && mod.frontmatter) {
      allCmsReviews.push(mod.frontmatter);
    }
  });
} catch (e) {}

// Helper function for price formatting
const formatPrice = (rawPrice: string) => {
  if (!rawPrice) return "Contact for Rates";
  const clean = String(rawPrice).replace(/night/gi, '').replace(/\//g, '').trim();
  const digits = clean.replace(/[^0-9.,]/g, '').trim();
  if (!digits) return "Contact for Rates";
  if (clean.includes('$')) return `$${digits}`;
  return `৳ ${digits}`;
};
---

<!-- POPULAR HOTELS SECTION (PT-20 RESERVES BREATHING ROOM FOR HERO SEARCH OVERLAP) -->
<section id="popular-hotels" class="bg-white pt-16 sm:pt-20 lg:pt-24 pb-12 px-4 sm:px-6 lg:px-8 max-w-[1280px] mx-auto text-slate-900 border-b border-slate-100 text-left">
  <div class="space-y-6">
    
    <!-- Section Header with Fixed Link to /hotels -->
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-end gap-3 border-b border-slate-100 pb-4">
      <div class="space-y-1 max-w-2xl">
        <span class="text-[10px] sm:text-xs font-black uppercase tracking-[0.2em] text-[#006ce4] block">
          Featured Stays
        </span>
        <h2 class="text-2xl sm:text-3xl lg:text-4xl font-black font-sans text-slate-900 tracking-tight">
          {title}
        </h2>
        {subtitle && (
          <p class="text-xs sm:text-sm text-slate-500 font-medium">
            {subtitle}
          </p>
        )}
      </div>

      <!-- Links directly to the full directory -->
      <a href="/hotels" class="text-xs sm:text-sm font-bold text-[#006ce4] hover:text-[#003b95] hover:underline transition shrink-0 inline-flex items-center gap-1">
        <span>View all {allHotels.length} properties</span>
        <span>➔</span>
      </a>
    </div>

    <!-- Carousel Track Container -->
    <div class="relative group">
      
      <!-- Carousel Navigation Arrows -->
      {hotels.length > 3 && (
        <button id="popPrevBtn" aria-label="Previous Hotels" class="absolute -left-3 sm:-left-4 top-1/2 -translate-y-1/2 w-9 h-9 sm:w-10 sm:h-10 rounded-full bg-white border border-slate-200 shadow-xl text-slate-800 hover:bg-[#006ce4] hover:text-white transition z-20 cursor-pointer flex items-center justify-center text-sm font-bold active:scale-95 hidden">❮</button>
      )}
      {hotels.length > 3 && (
        <button id="popNextBtn" aria-label="Next Hotels" class="absolute -right-3 sm:-right-4 top-1/2 -translate-y-1/2 w-9 h-9 sm:w-10 sm:h-10 rounded-full bg-white border border-slate-200 shadow-xl text-slate-800 hover:bg-[#006ce4] hover:text-white transition z-20 cursor-pointer flex items-center justify-center text-sm font-bold active:scale-95">❯</button>
      )}

      <!-- Track -->
      <div id="popularHotelsTrack" class="flex gap-4 sm:gap-5 overflow-x-auto scroll-smooth py-3 px-1 [scrollbar-width:none] [-ms-overflow-style:none] [&::-webkit-scrollbar]:hidden">
        {hotels.map((hotelItem: any) => {
          const hData = hotelItem.data || {};
          const hTitle = (hData.title || hData.name || "Hotel Details").trim();
          const hSlug = (hData.slug || hotelItem.slug || hotelItem.id || "hotel").trim();
          const hImage = hData.image || (Array.isArray(hData.gallery) ? hData.gallery[0] : "https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&w=600&q=80");
          const hFullAddress = String(hData.address || hData.location || hData.category || "Gulshan 2, Dhaka").trim();

          const rawPrice = hData.price ? String(hData.price).trim() : "";
          const displayPrice = formatPrice(rawPrice);
          const rawDigits = parseFloat(rawPrice.replace(/[^0-9.]/g, '')) || 0;
          const isDollar = rawPrice.includes('$');

          // Star Count
          const rawCat = String(hData.starCategory || hData.category || '').toLowerCase();
          const starCount = rawCat.includes('5') ? 5 : (rawCat.includes('4') ? 4 : (rawCat.includes('3') ? 3 : 0));

          // Reviews Calculation
          const hTitleLower = hTitle.toLowerCase();
          const hSlugLower = hSlug.toLowerCase();

          const matchedCmsReviews = allCmsReviews.filter(r => {
            if (!r) return false;
            const isApproved = r.approved === true || String(r.approved).toLowerCase() === 'true';
            if (!isApproved) return false;

            const rHotel = (r.hotel || '').trim().toLowerCase();
            const rSlug = (r.slug || r.hotelSlug || '').trim().toLowerCase();

            const matchTitle = rHotel && (rHotel === hTitleLower || hTitleLower.includes(rHotel) || rHotel.includes(hTitleLower));
            const matchSlug = rSlug && hSlugLower && (rSlug === hSlugLower || hSlugLower.includes(rSlug) || rSlug.includes(hSlugLower));

            return matchTitle || matchSlug;
          });

          const embedded = Array.isArray(hData.reviews) ? hData.reviews : [];
          const finalReviewsList = matchedCmsReviews.length > 0 ? matchedCmsReviews : embedded;

          const realCount = finalReviewsList.length;
          let realRating: string | null = null;

          if (realCount > 0) {
            const totalStars = finalReviewsList.reduce((sum: number, r: any) => {
              const num = parseFloat(r.rating);
              return sum + (!isNaN(num) && num > 0 && num <= 5 ? num : 5);
            }, 0);
            realRating = (totalStars / realCount).toFixed(1);
          }

          const numRating = parseFloat(realRating || '0');
          let ratingLabel = 'Wonderful';
          if (numRating < 4.5 && numRating >= 4.0) ratingLabel = 'Very Good';
          else if (numRating < 4.0 && numRating > 0) ratingLabel = 'Good';

          return (
            <div class="popular-card-item w-[280px] sm:w-[310px] shrink-0 bg-white rounded-2xl border border-slate-200/90 overflow-hidden shadow-2xs hover:shadow-xl transition-all duration-300 flex flex-col justify-between group relative text-left">
              
              <!-- Card Image Header -->
              <div class="relative w-full h-48 sm:h-52 overflow-hidden bg-slate-100">
                <a href={`/${hSlug}`} class="block w-full h-full">
                  <img 
                    src={hImage} 
                    alt={`${hTitle} Photo`} 
                    loading="lazy" 
                    decoding="async" 
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" 
                  />
                </a>

                <!-- Wishlist Heart Button (Independent & Safe) -->
                <button 
                  type="button"
                  class="card-wishlist-btn absolute top-3 right-3 w-8 h-8 rounded-full bg-white/90 hover:bg-white text-slate-800 flex items-center justify-center shadow-md transition cursor-pointer hover:scale-110 z-20"
                  data-title={hTitle}
                  data-image={hImage}
                  data-url={`/${hSlug}`}
                  data-price={displayPrice}
                  aria-label="Add to Wishlist"
                  onclick="event.stopPropagation();"
                >
                  <svg class="w-4 h-4 text-slate-700 transition" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path>
                  </svg>
                </button>
              </div>

              <!-- Card Body -->
              <div class="p-4 sm:p-5 flex-1 flex flex-col justify-between space-y-3">
                
                <div class="space-y-1.5">
                  <!-- Title & Stars -->
                  <div>
                    <a href={`/${hSlug}`} class="font-extrabold text-slate-900 text-base sm:text-lg leading-tight hover:text-[#006ce4] transition line-clamp-1 block">
                      {hTitle}
                    </a>
                    {starCount > 0 && (
                      <span class="text-[#febb02] text-xs tracking-tight mt-0.5 block">
                        {'★'.repeat(starCount)}
                      </span>
                    )}
                  </div>

                  <!-- Location -->
                  <div class="flex items-center gap-1 text-xs text-slate-500 font-medium">
                    <svg class="w-3.5 h-3.5 fill-slate-400 shrink-0" viewBox="0 0 24 24">
                      <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
                    </svg>
                    <span class="truncate">{hFullAddress}</span>
                  </div>

                  <!-- Booking.com Style Rating Badge -->
                  <div class="pt-1">
                    {realRating ? (
                      <div class="flex items-center gap-1.5">
                        <div class="bg-[#003b95] text-white font-bold text-xs px-1.5 py-0.5 rounded leading-none shadow-2xs">
                          {realRating}
                        </div>
                        <span class="text-xs font-bold text-slate-800">{ratingLabel}</span>
                        <span class="text-[11px] text-slate-400">({realCount})</span>
                      </div>
                    ) : (
                      <span class="bg-slate-100 text-slate-600 text-[10px] font-bold px-2 py-0.5 rounded">
                        New to site
                      </span>
                    )}
                  </div>
                </div>

                <!-- Bottom Price & CTA Button -->
                <div class="pt-2 border-t border-slate-100 flex items-end justify-between gap-2">
                  <div>
                    <span class="text-[10px] text-slate-400 uppercase font-bold block leading-none">Starting from</span>
                    <span class="text-base sm:text-lg font-black text-[#008234] block leading-tight mt-0.5">
                      {displayPrice}
                    </span>
                  </div>

                  <a 
                    href={`/${hSlug}`} 
                    class="bg-[#006ce4] hover:bg-[#0057b8] text-white font-bold text-xs py-2 px-3.5 rounded-xl transition shadow-xs hover:shadow active:scale-95 inline-flex items-center gap-1 shrink-0"
                  >
                    <span>Details</span>
                    <span>➔</span>
                  </a>
                </div>

              </div>

            </div>
          );
        })}
      </div>

    </div>

  </div>
</section>

<!-- SCRIPT FOR CAROUSEL SCROLL & WISHLIST TOGGLE -->
<script is:inline>
  const initPopularHotelsSection = () => {
    const track = document.getElementById('popularHotelsTrack');
    const prevBtn = document.getElementById('popPrevBtn');
    const nextBtn = document.getElementById('popNextBtn');

    function updateArrows() {
      if (!track || !prevBtn || !nextBtn) return;
      const scrollLeft = track.scrollLeft;
      const maxScroll = track.scrollWidth - track.clientWidth - 5;

      prevBtn.classList.toggle('hidden', scrollLeft <= 5);
      nextBtn.classList.toggle('hidden', scrollLeft >= maxScroll);
    }

    if (track && prevBtn && nextBtn) {
      prevBtn.addEventListener('click', () => track.scrollBy({ left: -320, behavior: 'smooth' }));
      nextBtn.addEventListener('click', () => track.scrollBy({ left: 320, behavior: 'smooth' }));
      updateArrows();
      track.addEventListener('scroll', updateArrows);
      window.addEventListener('resize', updateArrows);
    }
  };

  document.addEventListener('DOMContentLoaded', initPopularHotelsSection);
  document.addEventListener('astro:page-load', initPopularHotelsSection);
</script>
