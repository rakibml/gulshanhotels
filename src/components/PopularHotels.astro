---
// src/components/PopularHotels.astro (100% Hotel Markdown Frontmatter Sync & User Review Prioritization)
import { getCollection } from 'astro:content';

interface Props {
  title?: string;
  subtitle?: string;
}

const { 
  title = "Travelers' Choice: Top hotels", 
  subtitle = "Handpicked top stays in Gulshan - decided by verified guest reviews." 
} = Astro.props;

// 1. Fetch Hotels from Astro Content Collection
let hotels: any[] = [];
try {
  const allHotels = await getCollection('hotels');
  hotels = allHotels.filter(h => h.data.popular !== false);
} catch (e) {
  hotels = [];
}

// Fallback if collection is empty
if (!hotels || hotels.length === 0) {
  try {
    const glob1 = import.meta.glob('/src/content/hotels/*.md', { eager: true });
    const glob2 = import.meta.glob('../content/hotels/*.md', { eager: true });
    const glob3 = import.meta.glob('../../content/hotels/*.md', { eager: true });
    const combined = { ...glob1, ...glob2, ...glob3 };
    hotels = Object.entries(combined).map(([filePath, item]: [string, any]) => ({
      slug: filePath.split('/').pop()?.replace('.md', ''),
      data: item.frontmatter || {}
    }));
  } catch (e) {
    hotels = [];
  }
}

// 2. Fetch Approved Guest Reviews from src/content/reviews/
let allCmsReviews: any[] = [];
try {
  const reviewsCol = await getCollection('reviews');
  if (Array.isArray(reviewsCol) && reviewsCol.length > 0) {
    allCmsReviews = reviewsCol.map(r => r.data || {});
  }
} catch (e) {
  try {
    const glob1 = import.meta.glob('/src/content/reviews/*.md', { eager: true });
    const glob2 = import.meta.glob('../content/reviews/*.md', { eager: true });
    const glob3 = import.meta.glob('../../content/reviews/*.md', { eager: true });
    const combined = { ...glob1, ...glob2, ...glob3 };
    allCmsReviews = Object.values(combined).map((item: any) => item.frontmatter || {});
  } catch (err) {
    allCmsReviews = [];
  }
}
---

<!-- POPULAR HOTELS SECTION -->
<section id="hotels" class="bg-[#F8FAF9] pt-0 pb-12 px-4 sm:px-8 lg:px-12 max-w-[1550px] mx-auto text-slate-900 border-b border-slate-200/80">
  <div class="space-y-6">
    
    <!-- Section Header -->
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-end gap-3 text-left border-b border-slate-200/80 pb-4">
      <div class="space-y-1">
        <h2 class="text-2xl sm:text-3xl font-black font-sans text-slate-900 tracking-tight">
          {title}
        </h2>
        <p class="text-xs sm:text-sm text-slate-600 font-medium">
          {subtitle}
        </p>
      </div>

      <a href="/#hotels" class="text-xs sm:text-sm font-extrabold text-slate-900 hover:text-emerald-800 underline transition shrink-0">
        See all
      </a>
    </div>

    <!-- Carousel Track Container -->
    <div class="relative group">
      
      <!-- Carousel Navigation Arrows -->
      {hotels.length > 3 && (
        <button id="popPrevBtn" aria-label="Previous Hotels" class="absolute -left-3 sm:-left-5 top-1/2 -translate-y-1/2 w-10 h-10 rounded-full bg-white border border-slate-300 shadow-xl text-slate-800 hover:bg-slate-900 hover:text-white transition z-20 cursor-pointer flex items-center justify-center text-sm font-bold active:scale-95">❮</button>
      )}
      {hotels.length > 3 && (
        <button id="popNextBtn" aria-label="Next Hotels" class="absolute -right-3 sm:-right-5 top-1/2 -translate-y-1/2 w-10 h-10 rounded-full bg-white border border-slate-300 shadow-xl text-slate-800 hover:bg-slate-900 hover:text-white transition z-20 cursor-pointer flex items-center justify-center text-sm font-bold active:scale-95">❯</button>
      )}

      <!-- Track -->
      <div id="popularHotelsTrack" class="flex gap-5 overflow-x-auto scroll-smooth py-3 px-1 [scrollbar-width:none] [-ms-overflow-style:none] [&::-webkit-scrollbar]:hidden">
        {hotels.map((hotelItem: any, index: number) => {
          const hData = hotelItem.data || {};
          const hTitle = (hData.title || hData.name || "Hotel Details").trim();
          const hSlug = (hData.slug || hotelItem.slug || hotelItem.id || "hotel").trim();
          const hImage = hData.image || (Array.isArray(hData.gallery) ? hData.gallery[0] : "https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&w=600&q=80");
          const hLocation = hData.category || hData.location || "Gulshan 2, Dhaka";
          const hPrice = hData.price || "$120";

          // 1. Check user-submitted approved reviews
          const hTitleLower = hTitle.toLowerCase();
          const hSlugLower = hSlug.toLowerCase();

          const matchedCmsReviews = allCmsReviews.filter(r => {
            if (!r) return false;
            const isApproved = r.approved === true || String(r.approved).toLowerCase() === 'true';
            if (!isApproved) return false;

            const rHotel = (r.hotel || '').trim().toLowerCase();
            const rSlug = (r.slug || r.hotelSlug || '').trim().toLowerCase();

            const matchSlug = rSlug && hSlugLower && (rSlug === hSlugLower || hSlugLower.includes(rSlug) || rSlug.includes(hSlugLower));
            const matchTitle = rHotel && hTitleLower && (rHotel === hTitleLower || hTitleLower.includes(rHotel) || rHotel.includes(hTitleLower));

            return matchSlug || matchTitle;
          });

          // 2. Check embedded reviews inside hotel markdown
          const embeddedReviews = Array.isArray(hData.reviews) ? hData.reviews : (Array.isArray(hData.user_reviews) ? hData.user_reviews : []);
          const activeReviews = matchedCmsReviews.length > 0 ? matchedCmsReviews : embeddedReviews;

          // 3. Smart Fallback Rating & Review Count Logic
          let displayRating = null;
          let displayCount = null;

          if (activeReviews.length > 0) {
            // User-submitted approved reviews take priority
            displayCount = activeReviews.length;
            const totalStars = activeReviews.reduce((sum: number, r: any) => sum + (Number(r.rating) || 5), 0);
            displayRating = (totalStars / displayCount).toFixed(1);
          } else {
            // Fallback to Hotel Frontmatter Rating & Review Count (How your previous code worked!)
            if (hData.rating) {
              const rawR = parseFloat(hData.rating);
              displayRating = (!isNaN(rawR) && rawR <= 5.0 && rawR > 0) ? rawR.toFixed(1) : (hData.rating ? String(hData.rating) : "5.0");
            } else {
              displayRating = "5.0";
            }

            displayCount = hData.reviewsCount || hData.reviews_count || "12";
          }

          const ratingVal = Math.min(Math.max(Number(displayRating) || 5, 1), 5);

          return (
            <div class="popular-card-item w-[280px] sm:w-[320px] shrink-0 bg-white rounded-3xl border border-slate-200/90 overflow-hidden shadow-sm hover:shadow-xl transition duration-300 flex flex-col justify-between group text-left relative">
              
              <a href={`/${hSlug}`} class="block flex-1 flex flex-col justify-between">
                <div>
                  <!-- Card Image Header -->
                  <div class="relative w-full h-48 sm:h-52 overflow-hidden bg-slate-900">
                    <img 
                      src={hImage} 
                      alt={`${hTitle} Photo`} 
                      loading="lazy" 
                      decoding="async" 
                      class="w-full h-full object-cover group-hover:scale-105 transition duration-500" 
                    />

                    <!-- Wishlist Heart Button (Top Right) -->
                    <button 
                      type="button"
                      class="card-wishlist-btn absolute top-3 right-3 w-8 h-8 rounded-full bg-white/90 hover:bg-white text-slate-800 flex items-center justify-center shadow-md transition cursor-pointer hover:scale-110 z-10"
                      data-title={hTitle}
                      data-image={hImage}
                      data-url={`/${hSlug}`}
                      data-price={hPrice}
                      aria-label="Add to Wishlist"
                    >
                      <svg class="w-4 h-4 text-slate-700 transition" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path></svg>
                    </button>
                  </div>

                  <!-- Card Body -->
                  <div class="p-5 space-y-2.5">
                    
                    <!-- Hotel Title -->
                    <h3 class="font-extrabold text-slate-900 text-base sm:text-lg leading-tight group-hover:text-emerald-800 transition line-clamp-2">
                      {hTitle}
                    </h3>

                    <!-- RATING DISPLAY (GUARANTEED SHOWS RATING & COUNT) -->
                    <div class="flex items-center gap-1.5 text-xs text-slate-600 font-bold pt-0.5">
                      <span class="font-black text-slate-900 text-sm">{displayRating}</span>
                      <div class="flex items-center space-x-0.5 text-[#00aa6c]">
                        {Array.from({ length: 5 }).map((_, i) => (
                          <span class={`w-2.5 h-2.5 rounded-full inline-block ${i < ratingVal ? 'bg-[#00aa6c]' : 'bg-slate-300'}`}></span>
                        ))}
                      </div>
                      <span class="text-slate-500 font-normal">({displayCount} {Number(displayCount) === 1 ? 'review' : 'reviews'})</span>
                    </div>

                  </div>
                </div>

                <!-- Price Footer Line -->
                <div class="p-5 pt-0 border-t border-slate-100/80 flex items-baseline gap-1.5 mt-2">
                  <span class="text-xs text-slate-500 font-medium">from</span>
                  <span class="text-lg font-black text-slate-900">{hPrice.startsWith('$') || hPrice.startsWith('৳') ? hPrice : '$' + hPrice}</span>
                </div>
              </a>

              <!-- CARD ACTION BUTTON -->
              <div class="p-5 pt-0">
                <a 
                  href={`/${hSlug}`} 
                  class="block w-full bg-[#0d3b23] hover:bg-[#061e14] text-white font-extrabold text-xs text-center py-3 rounded-xl transition shadow-md uppercase tracking-wider"
                >
                  View Details ➔
                </a>
              </div>

            </div>
          );
        })}
      </div>

    </div>

  </div>
</section>

<!-- CLIENT SCRIPT FOR CAROUSEL SCROLL & INTERACTIVE WISHLIST TOGGLE -->
<script is:inline>
  const initPopularHotelsSection = () => {
    const track = document.getElementById('popularHotelsTrack');
    const prevBtn = document.getElementById('popPrevBtn');
    const nextBtn = document.getElementById('popNextBtn');

    if (track && prevBtn && nextBtn) {
      prevBtn.addEventListener('click', () => {
        track.scrollBy({ left: -320, behavior: 'smooth' });
      });

      nextBtn.addEventListener('click', () => {
        track.scrollBy({ left: 320, behavior: 'smooth' });
      });
    }

    // Wishlist Heart Toggle Handler
    document.querySelectorAll('.card-wishlist-btn').forEach(btn => {
      const title = btn.getAttribute('data-title') || '';
      
      let list = [];
      try {
        list = JSON.parse(localStorage.getItem('gh_wishlist') || '[]');
      } catch (err) {
        list = [];
      }

      const isSaved = list.some(item => item.title === title);
      const iconSvg = btn.querySelector('svg');
      if (isSaved && iconSvg) {
        iconSvg.setAttribute('fill', 'currentColor');
        iconSvg.classList.add('text-rose-600');
        iconSvg.classList.remove('text-slate-700');
      }

      btn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();

        const image = btn.getAttribute('data-image') || '';
        const url = btn.getAttribute('data-url') || '';
        const price = btn.getAttribute('data-price') || '';

        try {
          list = JSON.parse(localStorage.getItem('gh_wishlist') || '[]');
        } catch (err) {
          list = [];
        }

        const existingIndex = list.findIndex(item => item.title === title);

        if (existingIndex > -1) {
          list.splice(existingIndex, 1);
          if (iconSvg) {
            iconSvg.setAttribute('fill', 'none');
            iconSvg.classList.remove('text-rose-600');
            iconSvg.classList.add('text-slate-700');
          }
        } else {
          list.push({ title, image, url, price });
          if (iconSvg) {
            iconSvg.setAttribute('fill', 'currentColor');
            iconSvg.classList.remove('text-slate-700');
            iconSvg.classList.add('text-rose-600');
          }
        }

        localStorage.setItem('gh_wishlist', JSON.stringify(list));

        const countEl = document.getElementById('wishlist-count');
        if (countEl) {
          if (list.length > 0) {
            countEl.textContent = list.length.toString();
            countEl.classList.remove('hidden');
          } else {
            countEl.classList.add('hidden');
          }
        }
      });
    });
  };

  document.addEventListener('DOMContentLoaded', initPopularHotelsSection);
  document.addEventListener('astro:page-load', initPopularHotelsSection);
</script>
