---
// src/components/PopularHotels.astro (100% TripAdvisor "Travelers' Choice: Top Hotels" Style)
import { getCollection } from 'astro:content';

interface Props {
  title?: string;
  subtitle?: string;
}

const { 
  title = "Travelers' Choice: Top hotels", 
  subtitle = "Among our top 1% of hotels in Gulshan - decided by verified travelers." 
} = Astro.props;

// Fetch hotels from Astro Content Collection
let hotels: any[] = [];
try {
  const allHotels = await getCollection('hotels');
  hotels = allHotels.filter(h => h.data.popular !== false);
} catch (e) {
  hotels = [];
}

// Fallback if collection is empty
if (!hotels || hotels.length === 0) {
  try {
    const rawGlob = import.meta.glob('../content/hotels/*.md', { eager: true });
    hotels = Object.entries(rawGlob).map(([filePath, item]: [string, any]) => ({
      slug: filePath.split('/').pop()?.replace('.md', ''),
      data: item.frontmatter || {}
    }));
  } catch (e) {
    hotels = [];
  }
}
---

<!-- POPULAR HOTELS SECTION (TRIPADVISOR TRAVELERS' CHOICE STYLE) -->
<section id="hotels" class="bg-white py-12 px-4 sm:px-8 lg:px-12 max-w-[1550px] mx-auto text-slate-900 border-b border-slate-200/80">
  <div class="space-y-6">
    
    <!-- Section Header -->
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-end gap-3 text-left border-b border-slate-100 pb-4">
      <div class="space-y-1">
        <h2 class="text-2xl sm:text-3xl font-black font-sans text-slate-900 tracking-tight">
          {title}
        </h2>
        <p class="text-xs sm:text-sm text-slate-600 font-medium">
          {subtitle}
        </p>
      </div>

      <a href="/#hotels" class="text-xs sm:text-sm font-extrabold text-slate-900 hover:text-emerald-800 underline transition shrink-0">
        See all
      </a>
    </div>

    <!-- Carousel Track Container -->
    <div class="relative group">
      
      <!-- Carousel Navigation Arrows -->
      {hotels.length > 3 && (
        <button id="popPrevBtn" aria-label="Previous Hotels" class="absolute -left-3 sm:-left-5 top-1/2 -translate-y-1/2 w-10 h-10 rounded-full bg-white border border-slate-300 shadow-xl text-slate-800 hover:bg-slate-900 hover:text-white transition z-20 cursor-pointer flex items-center justify-center text-sm font-bold active:scale-95">❮</button>
      )}
      {hotels.length > 3 && (
        <button id="popNextBtn" aria-label="Next Hotels" class="absolute -right-3 sm:-right-5 top-1/2 -translate-y-1/2 w-10 h-10 rounded-full bg-white border border-slate-300 shadow-xl text-slate-800 hover:bg-slate-900 hover:text-white transition z-20 cursor-pointer flex items-center justify-center text-sm font-bold active:scale-95">❯</button>
      )}

      <!-- Track -->
      <div id="popularHotelsTrack" class="flex gap-5 overflow-x-auto scroll-smooth py-3 px-1 [scrollbar-width:none] [-ms-overflow-style:none] [&::-webkit-scrollbar]:hidden">
        {hotels.map((hotelItem: any, index: number) => {
          const hData = hotelItem.data || {};
          const hTitle = hData.title || hData.name || "Hotel Details";
          const hSlug = hData.slug || hotelItem.slug || hotelItem.id || "hotel";
          const hImage = hData.image || (Array.isArray(hData.gallery) ? hData.gallery[0] : "https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&w=600&q=80");
          const hLocation = hData.category || hData.location || "Gulshan 2, Dhaka";
          const hRating = hData.rating || "5.0";
          const hReviews = hData.reviewsCount || hData.reviews_count || "1,248";
          const hPrice = hData.price || "$120";

          return (
            <div class="popular-card-item w-[280px] sm:w-[320px] shrink-0 bg-white rounded-2xl border border-slate-200/90 overflow-hidden shadow-sm hover:shadow-xl transition duration-300 flex flex-col justify-between group text-left relative">
              
              <a href={`/${hSlug}`} class="block flex-1 flex flex-col justify-between">
                <div>
                  <!-- Card Image Header -->
                  <div class="relative w-full h-48 sm:h-52 overflow-hidden bg-slate-900">
                    <img 
                      src={hImage} 
                      alt={`${hTitle} Photo`} 
                      loading="lazy" 
                      decoding="async" 
                      class="w-full h-full object-cover group-hover:scale-105 transition duration-500" 
                    />

                    <!-- Gold TripAdvisor Award Badge (Top Left) -->
                    <div class="absolute top-3 left-3 bg-[#f2b203] text-slate-950 font-black text-[10px] px-2 py-1 rounded-md shadow-md flex items-center gap-1 border border-amber-300 tracking-wider">
                      <svg class="w-3.5 h-3.5 fill-slate-950 shrink-0" viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/></svg>
                      <span>2026 CHOICE</span>
                    </div>

                    <!-- Wishlist Heart Button (Top Right) -->
                    <button 
                      type="button"
                      class="card-wishlist-btn absolute top-3 right-3 w-8 h-8 rounded-full bg-white/90 hover:bg-white text-slate-800 flex items-center justify-center shadow-md transition cursor-pointer hover:scale-110 z-10"
                      data-title={hTitle}
                      data-image={hImage}
                      data-url={`/${hSlug}`}
                      data-price={hPrice}
                      aria-label="Add to Wishlist"
                    >
                      <svg class="w-4 h-4 text-slate-700 hover:text-rose-600 transition" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path></svg>
                    </button>
                  </div>

                  <!-- Card Body -->
                  <div class="p-5 space-y-2.5">
                    
                    <!-- Big Bold Rank Number + Location Badge -->
                    <div class="flex items-center justify-between">
                      <span class="text-3xl font-black font-sans text-slate-900 leading-none">
                        {index + 1}
                      </span>

                      <span class="bg-emerald-100 text-emerald-900 border border-emerald-300/80 text-[10px] font-black px-2.5 py-0.5 rounded-md uppercase tracking-wider">
                        {hLocation}
                      </span>
                    </div>

                    <!-- Hotel Title -->
                    <h3 class="font-extrabold text-slate-900 text-base sm:text-lg leading-tight group-hover:text-emerald-800 transition line-clamp-2">
                      {hTitle}
                    </h3>

                    <!-- TripAdvisor Style Green Bubble Circles Rating -->
                    <div class="flex items-center gap-1.5 text-xs text-slate-600 font-bold pt-0.5">
                      <span class="font-black text-slate-900 text-sm">{hRating}</span>
                      <div class="flex items-center space-x-1 text-[#00aa6c]">
                        <span class="w-2.5 h-2.5 rounded-full bg-[#00aa6c] inline-block"></span>
                        <span class="w-2.5 h-2.5 rounded-full bg-[#00aa6c] inline-block"></span>
                        <span class="w-2.5 h-2.5 rounded-full bg-[#00aa6c] inline-block"></span>
                        <span class="w-2.5 h-2.5 rounded-full bg-[#00aa6c] inline-block"></span>
                        <span class="w-2.5 h-2.5 rounded-full bg-[#00aa6c] inline-block"></span>
                      </div>
                      <span class="text-slate-500 font-normal">({hReviews})</span>
                    </div>

                  </div>
                </div>

                <!-- Price Footer Line -->
                <div class="p-5 pt-0 border-t border-slate-100/80 flex items-baseline gap-1.5 mt-2">
                  <span class="text-xs text-slate-500 font-medium">from</span>
                  <span class="text-lg font-black text-slate-900">{hPrice.startsWith('$') || hPrice.startsWith('৳') ? hPrice : '$' + hPrice}</span>
                </div>
              </a>

            </div>
          );
        })}
      </div>

    </div>

  </div>
</section>

<!-- CLIENT SCRIPT FOR CAROUSEL SCROLL & WISHLIST SAVING -->
<script is:inline>
  const initPopularHotelsSection = () => {
    const track = document.getElementById('popularHotelsTrack');
    const prevBtn = document.getElementById('popPrevBtn');
    const nextBtn = document.getElementById('popNextBtn');

    if (track && prevBtn && nextBtn) {
      prevBtn.addEventListener('click', () => {
        track.scrollBy({ left: -320, behavior: 'smooth' });
      });

      nextBtn.addEventListener('click', () => {
        track.scrollBy({ left: 320, behavior: 'smooth' });
      });
    }

    // Wishlist Button Click Handler
    document.querySelectorAll('.card-wishlist-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();

        const title = btn.getAttribute('data-title') || '';
        const image = btn.getAttribute('data-image') || '';
        const url = btn.getAttribute('data-url') || '';
        const price = btn.getAttribute('data-price') || '';

        let list = [];
        try {
          list = JSON.parse(localStorage.getItem('gh_wishlist') || '[]');
        } catch (err) {
          list = [];
        }

        const exists = list.some(item => item.title === title);
        if (!exists) {
          list.push({ title, image, url, price });
          localStorage.setItem('gh_wishlist', JSON.stringify(list));
          
          // Animate heart
          btn.innerHTML = `<svg class="w-4 h-4 text-rose-600 fill-rose-600" viewBox="0 0 24 24"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>`;
          
          // Trigger global wishlist counter update
          const countEl = document.getElementById('wishlist-count');
          if (countEl) {
            countEl.textContent = list.length.toString();
            countEl.classList.remove('hidden');
          }
        }
      });
    });
  };

  document.addEventListener('DOMContentLoaded', initPopularHotelsSection);
  document.addEventListener('astro:page-load', initPopularHotelsSection);
</script>
