---
// src/components/TopDeals.astro (100% Genuine Discounts, Same-Currency Engine, W3C Valid HTML & Realtime Wishlist)
import { getCollection } from 'astro:content';

interface Props {
  title?: string;
  subtitle?: string;
}

const { 
  title = "Top Hotel Deals in Gulshan", 
  subtitle = "Exclusive rates where verified partner booking channels offer special discounted rates."
} = Astro.props;

const isProd = import.meta.env.PROD;

// ১. সুরক্ষিত ও আলাদা ট্রাই-ক্যাচ দিয়ে হোটেল লোডার
let allHotels: any[] = [];
try {
  const collectionHotels = await getCollection('hotels', ({ data }) => {
    return isProd ? data?.draft !== true : true;
  });
  if (Array.isArray(collectionHotels) && collectionHotels.length > 0) {
    allHotels = collectionHotels;
  }
} catch (e) {
  allHotels = [];
}

// কালেকশন ফেইল করলেও গ্লোব ফলব্যাক ১০০% চলবে
if (allHotels.length === 0) {
  try {
    const rawGlob = import.meta.glob(['/src/content/hotels/*.{md,mdx}', '../content/hotels/*.{md,mdx}'], { eager: true });
    allHotels = Object.entries(rawGlob)
      .filter(([_, item]: [string, any]) => (isProd ? item?.frontmatter?.draft !== true : true))
      .map(([filePath, item]: [string, any]) => ({
        slug: filePath.split('/').pop()?.replace(/\.(md|mdx)$/, ''),
        data: item.frontmatter || item.data || {}
      }));
  } catch (e) {
    allHotels = [];
  }
}

// ২. সুরক্ষিত ও আলাদা ট্রাই-ক্যাচ দিয়ে রিভিউ লোডার
let allReviewsRaw: any[] = [];
try {
  const cmsReviews = await getCollection('reviews');
  if (Array.isArray(cmsReviews) && cmsReviews.length > 0) {
    allReviewsRaw = cmsReviews.map(r => r.data || {});
  }
} catch (e) {
  allReviewsRaw = [];
}

if (allReviewsRaw.length === 0) {
  try {
    const rawGlob = import.meta.glob(['/src/content/reviews/*.{md,mdx}', '../content/reviews/*.{md,mdx}'], { eager: true });
    allReviewsRaw = Object.values(rawGlob).map((item: any) => item.frontmatter || item.data || {});
  } catch (e) {
    allReviewsRaw = [];
  }
}

const approvedReviewsList = allReviewsRaw.filter(item => {
  if (!item) return false;
  return item.approved === true || String(item.approved).trim().toLowerCase() === 'true';
});

const normalize = (str: string) => String(str || '').toLowerCase().replace(/[^a-z0-9]/g, '');
const dotsArray = [0, 1, 2, 3, 4];

// কারেন্সি ডিটেক্টর
function detectCurrency(v: any): string {
  const s = String(v || '');
  if (s.includes('$')) return '$';
  if (s.includes('৳')) return '৳';
  return '$'; // ডিফল্ট
}

function extractNumericPrice(val: any): number | null {
  if (!val) return null;
  const match = String(val).replace(/,/g, '').match(/(\d+(?:\.\d+)?)/);
  return match ? parseFloat(match[1]) : null;
}

// ক্লাউডফ্লেয়ার থাম্বনেইল অপ্টিমাইজার
function getCardImage(url: string) {
  if (!url) return "/images/hotel-placeholder.webp";
  const cleanUrl = url.trim();
  if (cleanUrl.startsWith('https://media.gulshanhotels.com/')) {
    const path = cleanUrl.replace('https://media.gulshanhotels.com/', '');
    return `https://media.gulshanhotels.com/cdn-cgi/image/width=640,quality=75,format=auto,onerror=redirect/${path}`;
  }
  if (cleanUrl.includes('unsplash.com')) {
    const base = cleanUrl.split('?')[0];
    return `${base}?auto=format&fit=crop&w=640&q=75&fm=webp`;
  }
  return cleanUrl;
}

// ৩. ১০০% জেনুইন ডিল ইঞ্জিন (একই কারেন্সির মধ্যে সঠিক ডিসকাউন্ট হিসাব)
interface DealProcessedHotel {
  hotelItem: any;
  hTitle: string;
  hSlug: string;
  hImage: string;
  hLocation: string;
  currencySymbol: string;
  dealPriceDisplay: string;
  originalPrice: number | null;
  discountPercent: number;
  savingsAmount: number;
  reviewsCount: number;
  avgRating: string | null;
  ratingVal: number;
}

const processedDeals: DealProcessedHotel[] = allHotels.map(hotelItem => {
  const hData = hotelItem.data || {};
  const hTitle = String(hData.title || hData.name || "Hotel Details").trim();
  const rawSlug = String(hData.slug || hotelItem.slug || hotelItem.id || "hotel").trim();
  const hSlug = rawSlug.replace(/\.(md|mdx)$/, '').split('/').pop()?.toLowerCase() || "";
  
  const rawImg = hData.image || (Array.isArray(hData.gallery) && hData.gallery[0] ? (typeof hData.gallery[0] === 'object' ? hData.gallery[0].photo || hData.gallery[0].image : hData.gallery[0]) : "");
  const hImage = getCardImage(rawImg);
  const hLocation = String(hData.locality || hData.location || "Gulshan, Dhaka").trim();

  // রিভিউ হিসাব
  const normTitle = normalize(hTitle);
  const normSlug = normalize(hSlug);

  const matchedReviews = approvedReviewsList.filter(rev => {
    const revHotel = normalize(rev.hotel || rev.slug || rev.hotelSlug || '');
    return revHotel !== '' && (revHotel === normTitle || revHotel === normSlug);
  });

  const reviewsCount = matchedReviews.length;
  const avgRating = reviewsCount > 0 
    ? (matchedReviews.reduce((sum, r) => sum + (Number(r.rating) || 5), 0) / reviewsCount).toFixed(1) 
    : null;
  const ratingVal = avgRating ? Math.min(Math.max(Math.round(Number(avgRating)), 1), 5) : 0;

  // মূল দাম ও কারেন্সি
  const rawStarting = hData.price || hData.starting_price;
  const startNum = extractNumericPrice(rawStarting);
  const hotelCurrency = detectCurrency(rawStarting);

  const channels = Array.isArray(hData.booking_channels) ? hData.booking_channels : [];
  
  // শুধুমাত্র একই কারেন্সির চ্যানেলগুলোর দাম ফিল্টার করা (টাকার সাথে ডলারের অমিল রোধ)
  const validSameCurrencyChannelPrices = channels
    .filter((ch: any) => detectCurrency(ch.price) === hotelCurrency)
    .map((ch: any) => extractNumericPrice(ch.price))
    .filter((p): p is number => p !== null && p > 0);

  const minChannelPrice = validSameCurrencyChannelPrices.length > 0 ? Math.min(...validSameCurrencyChannelPrices) : null;

  let dealPrice = startNum;
  let originalPrice: number | null = null;
  let discountPercent = 0;
  let savingsAmount = 0;

  // ডিসকাউন্ট ক্যালকুলেশন (১০০% নিরাপদ ও সৎ)
  if (startNum && minChannelPrice && minChannelPrice < startNum) {
    originalPrice = startNum;
    dealPrice = minChannelPrice;
    savingsAmount = startNum - minChannelPrice;
    discountPercent = Math.round((savingsAmount / startNum) * 100);
  } else if (startNum && (hData.old_price || hData.original_price)) {
    const oldP = extractNumericPrice(hData.old_price || hData.original_price);
    if (oldP && oldP > startNum) {
      originalPrice = oldP;
      dealPrice = startNum;
      savingsAmount = oldP - startNum;
      discountPercent = Math.round((savingsAmount / oldP) * 100);
    }
  }

  const dealPriceDisplay = dealPrice ? `${hotelCurrency}${dealPrice.toLocaleString()}` : "Check rates";

  return {
    hotelItem,
    hTitle,
    hSlug,
    hImage,
    hLocation,
    currencySymbol: hotelCurrency,
    dealPriceDisplay,
    originalPrice,
    discountPercent,
    savingsAmount,
    reviewsCount,
    avgRating,
    ratingVal
  };
});

// শুধুমাত্র বাস্তব ছাড় বা অফার থাকা হোটেলগুলোকে ক্রমানুসারে সাজানো
const dealHotels = processedDeals
  .filter(h => h.discountPercent > 0 || h.hotelItem.data?.is_deal === true)
  .sort((a, b) => b.discountPercent - a.discountPercent || b.savingsAmount - a.savingsAmount);
---

{dealHotels.length > 0 && (
  <section 
    id="deals" 
    class="w-full bg-white pt-6 pb-14 text-slate-900 border-b border-slate-100"
    style="content-visibility: auto; contain-intrinsic-size: auto 480px;"
  >
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-0 space-y-4">
      
      <!-- Section Header -->
      <div class="flex justify-between items-end gap-4 text-left">
        <div class="space-y-1">
          <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-rose-50 text-rose-700 text-[11px] font-black uppercase tracking-wider mb-0.5 border border-rose-200">
            <span>🔥 Limited Time Offers</span>
          </div>
          <h2 class="text-2xl sm:text-3xl font-black font-sans text-slate-900 tracking-tight">
            {title}
          </h2>
          {subtitle && (
            <p class="text-xs sm:text-sm text-slate-500 font-medium">
              {subtitle}
            </p>
          )}
        </div>

        <a 
          href="/#hotels" 
          class="hidden sm:inline-flex items-center justify-center px-5 py-2 sm:py-2.5 rounded-full border border-slate-300 hover:border-slate-900 bg-white hover:bg-slate-50 text-xs sm:text-sm font-bold text-[#0a2540] transition shrink-0"
        >
          View all deals
        </a>
      </div>

      <!-- Carousel Track Container -->
      <div class="relative group">
        
        {dealHotels.length > 3 && (
          <button id="dealsPrevBtn" type="button" aria-label="Previous Deals" class="absolute -left-3 sm:-left-5 top-1/2 -translate-y-1/2 w-10 h-10 rounded-full bg-white border border-slate-300 text-slate-800 hover:bg-[#0d3b23] hover:text-white transition z-20 cursor-pointer flex items-center justify-center text-sm font-bold active:scale-95 shadow-md hidden">❮</button>
        )}
        {dealHotels.length > 3 && (
          <button id="dealsNextBtn" type="button" aria-label="Next Deals" class="absolute -right-3 sm:-right-5 top-1/2 -translate-y-1/2 w-10 h-10 rounded-full bg-white border border-slate-300 text-slate-800 hover:bg-[#0d3b23] hover:text-white transition z-20 cursor-pointer flex items-center justify-center text-sm font-bold active:scale-95 shadow-md">❯</button>
        )}

        <!-- Track -->
        <div id="dealsHotelsTrack" class="flex gap-5 overflow-x-auto scroll-smooth py-2 px-1 [scrollbar-width:none] [-ms-overflow-style:none] [&::-webkit-scrollbar]:hidden">
          {dealHotels.map((deal) => (
            <div class="deal-card-item w-[280px] sm:w-[320px] shrink-0 bg-white rounded-2xl overflow-hidden flex flex-col text-left relative group">
              
              <!-- ১. কার্ড ছবি ও উইশলিস্ট বাটন (W3C ভ্যালিডেশন পাস: বাটন ও লিংক আলাদা) -->
              <div class="relative w-full aspect-[16/10] overflow-hidden rounded-2xl bg-slate-100">
                <a href={`/${deal.hSlug}/`} class="block w-full h-full" aria-label={`View deal for ${deal.hTitle}`}>
                  <img 
                    src={deal.hImage} 
                    alt={`${deal.hTitle} Room Photo`} 
                    loading="lazy" 
                    decoding="async" 
                    width="320"
                    height="200"
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" 
                  />
                </a>

                <!-- খাঁটি ডিসকাউন্ট ব্যাজ (pointer-events-none যাতে ক্লিক আটকানো না যায়) -->
                {deal.discountPercent > 0 && (
                  <div class="absolute top-3 left-3 bg-rose-600 text-white text-[11px] font-black uppercase tracking-wider px-2.5 py-1 rounded-lg z-10 shadow-sm pointer-events-none">
                    {deal.discountPercent}% OFF
                  </div>
                )}

                <!-- উইশলিস্ট বাটন -->
                <button 
                  type="button"
                  class="card-wishlist-btn absolute top-3 right-3 w-8 h-8 rounded-full bg-white/95 hover:bg-white text-slate-800 flex items-center justify-center border border-slate-200 cursor-pointer z-10 shadow-sm transition active:scale-90"
                  data-slug={deal.hSlug}
                  data-title={deal.hTitle}
                  data-image={deal.hImage}
                  data-url={`/${deal.hSlug}/`}
                  data-price={deal.dealPriceDisplay}
                  aria-label={`Save ${deal.hTitle} to wishlist`}
                >
                  <svg aria-hidden="true" class="w-4 h-4 text-slate-700 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path></svg>
                </button>
              </div>

              <!-- ২. কার্ড ডিটেইলস -->
              <div class="pt-3 pb-1 px-0.5 space-y-1.5">
                
                <h3 class="font-extrabold text-slate-900 text-base sm:text-lg leading-tight line-clamp-2 hover:text-emerald-800 transition-colors">
                  <a href={`/${deal.hSlug}/`} class="hover:underline">
                    {deal.hTitle}
                  </a>
                </h3>

                <!-- Location -->
                {deal.hLocation && (
                  <div class="flex items-center gap-1 text-xs text-slate-500 font-medium">
                    <svg aria-hidden="true" class="w-3.5 h-3.5 fill-emerald-700 shrink-0" viewBox="0 0 24 24">
                      <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
                    </svg>
                    <span class="truncate">{deal.hLocation}</span>
                  </div>
                )}

                <!-- Reviews Display -->
                {deal.reviewsCount > 0 && deal.avgRating ? (
                  <div class="flex items-center gap-1.5 text-xs text-slate-600 font-bold pt-0.5">
                    <span class="font-black text-slate-900 text-sm">{deal.avgRating}</span>
                    <div class="flex items-center space-x-0.5" role="img" aria-label={`Rated ${deal.avgRating} out of 5 stars`}>
                      {dotsArray.map((i) => (
                        <span class={`w-2.5 h-2.5 rounded-full inline-block ${i < deal.ratingVal ? 'bg-[#00aa6c]' : 'bg-slate-200'}`}></span>
                      ))}
                    </div>
                    <span class="text-slate-500 font-medium text-[11px]">({deal.reviewsCount} {deal.reviewsCount === 1 ? 'review' : 'reviews'})</span>
                  </div>
                ) : (
                  <div class="flex items-center gap-1.5 text-xs text-slate-400 font-medium pt-0.5">
                    <span class="bg-slate-100 text-slate-600 border border-slate-200 text-[10px] font-bold px-2 py-0.5 rounded">No reviews yet</span>
                  </div>
                )}

                <!-- সৎ প্রাইস ডিসপ্লে (কোনো ফেক ভ্যালু নেই) -->
                <div class="flex items-baseline gap-2 pt-1">
                  {deal.dealPriceDisplay !== "Check rates" && (
                    <span class="text-xs text-slate-500 font-medium">from</span>
                  )}
                  {deal.originalPrice && (
                    <span class="text-xs text-slate-400 line-through font-semibold">{deal.currencySymbol}{deal.originalPrice.toLocaleString()}</span>
                  )}
                  <span class="text-base sm:text-lg font-black text-rose-700">
                    {deal.dealPriceDisplay}{deal.dealPriceDisplay !== "Check rates" ? ' / night' : ''}
                  </span>
                </div>

              </div>

            </div>
          ))}
        </div>

      </div>

      <!-- Mobile Button -->
      <div class="pt-3 flex sm:hidden justify-center w-full">
        <a 
          href="/#hotels" 
          class="w-full py-3 px-6 rounded-full border border-slate-300 hover:border-slate-900 bg-white hover:bg-slate-50 text-sm font-bold text-[#0a2540] text-center transition shadow-none"
        >
          View all deals
        </a>
      </div>

    </div>
  </section>
)}

<!-- SCRIPT (রিয়েল-টাইম উইশলিস্ট সিঙ্ক ও নিরাপদ ইভেন্ট হ্যান্ডলিং) -->
<script is:inline>
  (() => {
    let dealsAbortCtrl = null;

    const initTopDealsSection = () => {
      if (dealsAbortCtrl) dealsAbortCtrl.abort();
      dealsAbortCtrl = new AbortController();
      const { signal } = dealsAbortCtrl;

      const track = document.getElementById('dealsHotelsTrack');
      const prevBtn = document.getElementById('dealsPrevBtn');
      const nextBtn = document.getElementById('dealsNextBtn');

      if (!track) return;

      let isUpdating = false;
      function updateArrows() {
        if (isUpdating) return;
        isUpdating = true;

        requestAnimationFrame(() => {
          if (!track || !prevBtn || !nextBtn) {
            isUpdating = false;
            return;
          }

          const scrollLeft = track.scrollLeft;
          const maxScroll = track.scrollWidth - track.clientWidth - 5;

          if (scrollLeft <= 5) {
            prevBtn.classList.add('hidden');
          } else {
            prevBtn.classList.remove('hidden');
          }

          if (scrollLeft >= maxScroll) {
            nextBtn.classList.add('hidden');
          } else {
            nextBtn.classList.remove('hidden');
          }

          isUpdating = false;
        });
      }

      if (prevBtn && nextBtn) {
        prevBtn.addEventListener('click', () => {
          track.scrollBy({ left: -320, behavior: 'smooth' });
        }, { signal });

        nextBtn.addEventListener('click', () => {
          track.scrollBy({ left: 320, behavior: 'smooth' });
        }, { signal });

        updateArrows();
        track.addEventListener('scroll', updateArrows, { passive: true, signal });
        window.addEventListener('resize', updateArrows, { passive: true, signal });
      }

      // উইশলিস্ট বাটন UI সিঙ্ক হেল্পার
      const syncWishlistUI = () => {
        let list = [];
        try { list = JSON.parse(localStorage.getItem('gh_wishlist') || '[]'); } catch (err) { list = []; }

        document.querySelectorAll('#deals .card-wishlist-btn').forEach(btn => {
          const slug = btn.getAttribute('data-slug') || '';
          const title = btn.getAttribute('data-title') || '';
          const isSaved = list.some(item => (item.slug && item.slug === slug) || item.title === title);
          const iconSvg = btn.querySelector('svg');

          if (iconSvg) {
            if (isSaved) {
              iconSvg.setAttribute('fill', 'currentColor');
              iconSvg.classList.add('text-rose-600');
              iconSvg.classList.remove('text-slate-700');
            } else {
              iconSvg.setAttribute('fill', 'none');
              iconSvg.classList.remove('text-rose-600');
              iconSvg.classList.add('text-slate-700');
            }
          }
        });
      };

      syncWishlistUI();
      window.addEventListener('wishlist-updated', syncWishlistUI, { signal });

      // উইশলিস্ট ক্লিক হ্যান্ডলার
      document.querySelectorAll('#deals .card-wishlist-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          e.stopPropagation();

          const slug = btn.getAttribute('data-slug') || '';
          const title = btn.getAttribute('data-title') || '';
          const image = btn.getAttribute('data-image') || '';
          const url = btn.getAttribute('data-url') || '';
          const price = btn.getAttribute('data-price') || '';

          let list = [];
          try { list = JSON.parse(localStorage.getItem('gh_wishlist') || '[]'); } catch (err) { list = []; }

          const existingIndex = list.findIndex(item => (item.slug && item.slug === slug) || item.title === title);

          if (existingIndex > -1) {
            list.splice(existingIndex, 1);
          } else {
            list.push({ slug, title, image, url, price });
          }

          localStorage.setItem('gh_wishlist', JSON.stringify(list));
          syncWishlistUI();
          window.dispatchEvent(new CustomEvent('wishlist-updated'));

          const countEl = document.getElementById('wishlist-count');
          if (countEl) {
            if (list.length > 0) {
              countEl.textContent = list.length.toString();
              countEl.classList.remove('hidden');
            } else {
              countEl.classList.add('hidden');
            }
          }
        }, { signal });
      });
    };

    document.addEventListener('DOMContentLoaded', initTopDealsSection);
    document.addEventListener('astro:page-load', initTopDealsSection);
  })();
</script>
