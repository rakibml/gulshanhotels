---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import HotelCard from '../components/HotelCard.astro';
import QuickViewModal from '../components/QuickViewModal.astro';

// Fetch all hotels and reviews safely
let allHotels: any[] = [];
try {
  allHotels = await getCollection('hotels');
} catch (e) {
  allHotels = [];
}

let allCmsReviews: any[] = [];
try {
  allCmsReviews = await getCollection('reviews');
} catch (e) {
  allCmsReviews = [];
}

// খালি বা ড্রাফট ফাইল ফিল্টার (Ghost Box দূর করার জন্য)
const validHotels = allHotels.filter(hotel => {
  const d = hotel?.data || {};
  return (d.title || d.name || '').trim().length > 0;
});

// Calculate Initial Category Counts for Top Pills & Sidebar
const totalCount = validHotels.length;
const hotelCount = validHotels.filter(h => {
  const c = String(h.data?.category || '').toLowerCase();
  return !c.includes('guest house') && !c.includes('guesthouse');
}).length;
const guestHouseCount = validHotels.filter(h => {
  const c = String(h.data?.category || '').toLowerCase();
  const t = String(h.data?.title || '').toLowerCase();
  return c.includes('guest house') || c.includes('guesthouse') || t.includes('guest house');
}).length;

const g1Count = validHotels.filter(h => {
  const a = String(h.data?.address || h.data?.location || '').toLowerCase();
  return a.includes('gulshan 1') || a.includes('gulshan-1') || a.includes('gulshan1');
}).length;
const g2Count = validHotels.filter(h => {
  const a = String(h.data?.address || h.data?.location || '').toLowerCase();
  return a.includes('gulshan 2') || a.includes('gulshan-2') || a.includes('gulshan2');
}).length;
const nearCount = totalCount - (g1Count + g2Count);

const star5Count = validHotels.filter(h => String(h.data?.starCategory || h.data?.category || '').includes('5')).length;
const star4Count = validHotels.filter(h => String(h.data?.starCategory || h.data?.category || '').includes('4')).length;
---

<Layout title="All Hotels in Gulshan - Best Rates & Deals">
  <!-- পেজের মূল ব্যাকগ্রাউন্ড (#f7f7f9) -->
  <main class="bg-[#f7f7f9] min-h-screen pb-16 text-slate-900 text-left">
    
    <!-- ================= 1. BREADCRUMB ================= -->
    <div class="max-w-[1200px] mx-auto px-3 sm:px-4 pt-3 pb-1 text-xs text-slate-500 font-medium">
      <a href="/" class="hover:underline text-slate-600">Home</a>
      <span class="mx-1.5">›</span>
      <span class="text-slate-900 font-bold">All Hotels in Gulshan</span>
    </div>

    <!-- ================= 2. MAIN CONTAINER (CONTROLS WIDTH & PADDING) ================= -->
    <div class="max-w-[1200px] mx-auto px-3 sm:px-4 pt-2">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-5 items-start">
        
        <!-- ================= LEFT SIDEBAR (FILTERS) ================= -->
        <aside class="hidden lg:block lg:col-span-3 bg-white p-4 sm:p-5 rounded-2xl border border-slate-200/90 shadow-2xs space-y-5 sticky top-4">
          
          <!-- Header & Reset -->
          <div class="flex items-center justify-between border-b border-slate-100 pb-3">
            <h3 class="text-sm font-black text-slate-900">Search & Filters</h3>
            <button type="button" id="resetFiltersBtn" class="text-xs font-bold text-[#006ce4] hover:underline cursor-pointer">
              Reset all
            </button>
          </div>

          <!-- SEARCH -->
          <div class="space-y-1.5">
            <span class="text-[11px] font-black uppercase text-slate-400 tracking-wider block">SEARCH</span>
            <div class="relative">
              <input 
                type="text" 
                id="sidebarSearchInput" 
                placeholder="Search hotel name..." 
                class="w-full bg-slate-50 focus:bg-white text-xs font-semibold rounded-xl pl-8 pr-3 py-2 border border-slate-200 focus:border-[#006ce4] focus:outline-none transition"
              />
              <svg class="w-3.5 h-3.5 text-slate-400 absolute left-2.5 top-1/2 -translate-y-1/2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
              </svg>
            </div>
          </div>

          <!-- SORT BY -->
          <div class="space-y-1.5 border-t border-slate-100 pt-4">
            <span class="text-[11px] font-black uppercase text-slate-400 tracking-wider block">SORT BY</span>
            <select id="sidebarSortSelect" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3 py-2 text-xs font-bold text-slate-800 focus:outline-none focus:border-[#006ce4] cursor-pointer">
              <option value="featured">Top picks</option>
              <option value="price-asc">Price: Low to High</option>
              <option value="price-desc">Price: High to Low</option>
              <option value="rating-desc">Guest Rating: High to Low</option>
            </select>
          </div>

          <!-- NEIGHBORHOOD (RADIO) -->
          <div class="space-y-2 border-t border-slate-100 pt-4">
            <span class="text-[11px] font-black uppercase text-slate-400 tracking-wider block">NEIGHBORHOOD</span>
            <div class="space-y-2 text-xs font-semibold text-slate-700">
              <label class="flex items-center justify-between cursor-pointer group">
                <span class="flex items-center gap-2">
                  <input type="radio" name="areaFilter" value="all" checked class="area-radio text-[#006ce4]" />
                  <span>All Gulshan</span>
                </span>
                <span class="text-[11px] text-slate-400 font-bold">{totalCount}</span>
              </label>
              <label class="flex items-center justify-between cursor-pointer group">
                <span class="flex items-center gap-2">
                  <input type="radio" name="areaFilter" value="gulshan-1" class="area-radio text-[#006ce4]" />
                  <span>Gulshan 1</span>
                </span>
                <span class="text-[11px] text-slate-400 font-bold">{g1Count}</span>
              </label>
              <label class="flex items-center justify-between cursor-pointer group">
                <span class="flex items-center gap-2">
                  <input type="radio" name="areaFilter" value="gulshan-2" class="area-radio text-[#006ce4]" />
                  <span>Gulshan 2</span>
                </span>
                <span class="text-[11px] text-slate-400 font-bold">{g2Count}</span>
              </label>
              <label class="flex items-center justify-between cursor-pointer group">
                <span class="flex items-center gap-2">
                  <input type="radio" name="areaFilter" value="near" class="area-radio text-[#006ce4]" />
                  <span>Near Gulshan</span>
                </span>
                <span class="text-[11px] text-slate-400 font-bold">{nearCount}</span>
              </label>
            </div>
          </div>

          <!-- PROPERTY RATING -->
          <div class="space-y-2 border-t border-slate-100 pt-4">
            <span class="text-[11px] font-black uppercase text-slate-400 tracking-wider block">PROPERTY RATING</span>
            <div class="space-y-2 text-xs font-semibold text-slate-700">
              <label class="flex items-center justify-between cursor-pointer">
                <span class="flex items-center gap-2">
                  <input type="checkbox" value="5" class="star-check text-[#006ce4] rounded" />
                  <span>5 stars <span class="text-[#febb02]">★★★★★</span></span>
                </span>
                <span class="text-[11px] text-slate-400 font-bold">{star5Count}</span>
              </label>
              <label class="flex items-center justify-between cursor-pointer">
                <span class="flex items-center gap-2">
                  <input type="checkbox" value="4" class="star-check text-[#006ce4] rounded" />
                  <span>4 stars <span class="text-[#febb02]">★★★★</span></span>
                </span>
                <span class="text-[11px] text-slate-400 font-bold">{star4Count}</span>
              </label>
            </div>
          </div>

          <!-- REVIEW SCORE -->
          <div class="space-y-2 border-t border-slate-100 pt-4">
            <span class="text-[11px] font-black uppercase text-slate-400 tracking-wider block">REVIEW SCORE</span>
            <div class="space-y-2 text-xs font-semibold text-slate-700">
              <label class="flex items-center gap-2 cursor-pointer">
                <input type="checkbox" value="9" class="rating-check text-[#006ce4] rounded" />
                <span>Wonderful: 9+</span>
              </label>
              <label class="flex items-center gap-2 cursor-pointer">
                <input type="checkbox" value="8" class="rating-check text-[#006ce4] rounded" />
                <span>Very Good: 8+</span>
              </label>
              <label class="flex items-center gap-2 cursor-pointer">
                <input type="checkbox" value="7" class="rating-check text-[#006ce4] rounded" />
                <span>Good: 7+</span>
              </label>
            </div>
          </div>

          <!-- PROPERTY TYPE -->
          <div class="space-y-2 border-t border-slate-100 pt-4">
            <span class="text-[11px] font-black uppercase text-slate-400 tracking-wider block">PROPERTY TYPE</span>
            <div class="space-y-2 text-xs font-semibold text-slate-700">
              <label class="flex items-center justify-between cursor-pointer">
                <span class="flex items-center gap-2">
                  <input type="checkbox" value="hotel" class="type-check text-[#006ce4] rounded" />
                  <span>Hotels</span>
                </span>
                <span class="text-[11px] text-slate-400 font-bold">{hotelCount}</span>
              </label>
              <label class="flex items-center justify-between cursor-pointer">
                <span class="flex items-center gap-2">
                  <input type="checkbox" value="guesthouse" class="type-check text-[#006ce4] rounded" />
                  <span>Guest Houses</span>
                </span>
                <span class="text-[11px] text-slate-400 font-bold">{guestHouseCount}</span>
              </label>
            </div>
          </div>

        </aside>

        <!-- ================= RIGHT COLUMN (HOTEL CARDS) ================= -->
        <section class="lg:col-span-9 space-y-3">
          
          <!-- TOP PILL TABS BAR & PROPERTIES COUNT -->
          <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-2.5 bg-white p-2.5 sm:p-3 rounded-2xl border border-slate-200/80 shadow-2xs">
            
            <!-- Quick Filter Pill Tabs -->
            <div class="flex flex-wrap items-center gap-1.5 text-xs font-bold">
              <button type="button" class="top-pill-btn bg-[#003b95] text-white px-3 py-1.5 rounded-lg transition flex items-center gap-1.5 cursor-pointer active-pill" data-type="all">
                <span>All Stays</span>
                <span class="bg-white/20 text-white text-[10px] px-1.5 py-0.2 rounded">{totalCount}</span>
              </button>
              <button type="button" class="top-pill-btn bg-slate-100 text-slate-700 hover:bg-slate-200 px-3 py-1.5 rounded-lg transition flex items-center gap-1.5 cursor-pointer" data-type="hotel">
                <span>Hotels</span>
                <span class="bg-slate-200 text-slate-600 text-[10px] px-1.5 py-0.2 rounded">{hotelCount}</span>
              </button>
              <button type="button" class="top-pill-btn bg-slate-100 text-slate-700 hover:bg-slate-200 px-3 py-1.5 rounded-lg transition flex items-center gap-1.5 cursor-pointer" data-type="guesthouse">
                <span>Guest Houses</span>
                <span class="bg-slate-200 text-slate-600 text-[10px] px-1.5 py-0.2 rounded">{guestHouseCount}</span>
              </button>
              <button type="button" class="top-pill-btn bg-slate-100 text-slate-700 hover:bg-slate-200 px-3 py-1.5 rounded-lg transition flex items-center gap-1.5 cursor-pointer" data-type="near">
                <span>Near Gulshan</span>
                <span class="bg-slate-200 text-slate-600 text-[10px] px-1.5 py-0.2 rounded">{nearCount}</span>
              </button>
            </div>

            <!-- Properties Found Text -->
            <span id="propertiesFoundCount" class="text-xs font-bold text-slate-600 shrink-0">
              Gulshan: <strong class="text-slate-900 font-black">{totalCount} properties found</strong>
            </span>

          </div>

          <!-- HOTEL CARDS LIST -->
          <div id="hotelCardsContainer" class="flex flex-col">
            {validHotels.map(hotel => (
              <HotelCard hotelItem={hotel} allCmsReviews={allCmsReviews} />
            ))}
          </div>

          <!-- NO RESULTS BOX -->
          <div id="noHotelsFoundBox" class="hidden bg-white rounded-2xl border border-slate-200 p-10 text-center space-y-2">
            <h4 class="text-base font-black text-slate-900">No properties found</h4>
            <p class="text-xs text-slate-500">Try relaxing your filters or search keywords.</p>
          </div>

        </section>

      </div>
    </div>

    <!-- ================= GLOBAL QUICK VIEW MODAL ================= -->
    <QuickViewModal />

  </main>
</Layout>

<!-- ================= CLIENT FILTERING & INTERACTION SCRIPT ================= -->
<script is:inline>
  const initHotelsDirectory = () => {
    const cards = Array.from(document.querySelectorAll('.directory-card-item'));
    const countEl = document.getElementById('propertiesFoundCount');
    const noBox = document.getElementById('noHotelsFoundBox');
    const container = document.getElementById('hotelCardsContainer');
    
    // Inputs
    const searchInput = document.getElementById('sidebarSearchInput');
    const sortSelect = document.getElementById('sidebarSortSelect');
    const resetBtn = document.getElementById('resetFiltersBtn');

    let activeSearch = '';
    let activeArea = 'all';
    let activeType = 'all';
    let selectedStars = [];
    let selectedRatings = [];

    function filterCards() {
      let count = 0;

      cards.forEach(card => {
        const title = card.getAttribute('data-title') || '';
        const area = card.getAttribute('data-area') || '';
        const stars = card.getAttribute('data-stars') || '0';
        const isGuest = card.getAttribute('data-guesthouse') === 'true';
        const rating = parseFloat(card.getAttribute('data-numeric-rating') || '0');

        const matchSearch = !activeSearch || title.includes(activeSearch);
        const matchArea = activeArea === 'all' || area === activeArea;
        
        let matchType = true;
        if (activeType === 'hotel') matchType = !isGuest;
        else if (activeType === 'guesthouse') matchType = isGuest;
        else if (activeType === 'near') matchType = (area === 'near');

        const matchStar = selectedStars.length === 0 || selectedStars.includes(stars);
        
        let matchRating = true;
        if (selectedRatings.length > 0) {
          matchRating = selectedRatings.some(minR => rating >= minR);
        }

        if (matchSearch && matchArea && matchType && matchStar && matchRating) {
          card.classList.remove('hidden');
          card.style.display = 'flex';
          count++;
        } else {
          card.classList.add('hidden');
          card.style.display = 'none';
        }
      });

      if (countEl) {
        countEl.innerHTML = `Gulshan: <strong class="text-slate-900 font-black">${count} properties found</strong>`;
      }
      if (noBox) {
        if (count === 0) noBox.classList.remove('hidden');
        else noBox.classList.add('hidden');
      }
    }

    // 1. Search
    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        activeSearch = (e.target.value || '').trim().toLowerCase();
        filterCards();
      });
    }

    // 2. Area Radio
    document.querySelectorAll('.area-radio').forEach(r => {
      r.addEventListener('change', (e) => {
        activeArea = e.target.value;
        filterCards();
      });
    });

    // 3. Top Pills
    document.querySelectorAll('.top-pill-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.top-pill-btn').forEach(b => {
          b.classList.remove('bg-[#003b95]', 'text-white', 'active-pill');
          b.classList.add('bg-slate-100', 'text-slate-700');
        });
        btn.classList.remove('bg-slate-100', 'text-slate-700');
        btn.classList.add('bg-[#003b95]', 'text-white', 'active-pill');
        
        activeType = btn.getAttribute('data-type') || 'all';
        filterCards();
      });
    });

    // 4. Stars Checkbox
    document.querySelectorAll('.star-check').forEach(ch => {
      ch.addEventListener('change', () => {
        selectedStars = Array.from(document.querySelectorAll('.star-check:checked')).map(c => c.value);
        filterCards();
      });
    });

    // 5. Rating Checkbox
    document.querySelectorAll('.rating-check').forEach(ch => {
      ch.addEventListener('change', () => {
        selectedRatings = Array.from(document.querySelectorAll('.rating-check:checked')).map(c => parseFloat(c.value));
        filterCards();
      });
    });

    // 6. Property Type Checkbox
    document.querySelectorAll('.type-check').forEach(ch => {
      ch.addEventListener('change', () => {
        const checked = Array.from(document.querySelectorAll('.type-check:checked')).map(c => c.value);
        if (checked.length === 1) activeType = checked[0];
        else activeType = 'all';
        filterCards();
      });
    });

    // 7. Sort
    if (sortSelect && container) {
      sortSelect.addEventListener('change', (e) => {
        const val = e.target.value;
        const sorted = [...cards].sort((a, b) => {
          const pA = parseFloat(a.getAttribute('data-numeric-price') || '0');
          const pB = parseFloat(b.getAttribute('data-numeric-price') || '0');
          const rA = parseFloat(a.getAttribute('data-numeric-rating') || '0');
          const rB = parseFloat(b.getAttribute('data-numeric-rating') || '0');

          if (val === 'price-asc') return pA - pB;
          if (val === 'price-desc') return pB - pA;
          if (val === 'rating-desc') return rB - rA;
          return 0;
        });
        sorted.forEach(c => container.appendChild(c));
      });
    }

    // 8. Reset
    if (resetBtn) {
      resetBtn.addEventListener('click', () => {
        if (searchInput) searchInput.value = '';
        activeSearch = '';
        activeArea = 'all';
        activeType = 'all';
        selectedStars = [];
        selectedRatings = [];

        document.querySelectorAll('.area-radio').forEach(r => r.checked = (r.value === 'all'));
        document.querySelectorAll('.star-check, .rating-check, .type-check').forEach(c => c.checked = false);

        document.querySelectorAll('.top-pill-btn').forEach(b => {
          b.classList.remove('bg-[#003b95]', 'text-white', 'active-pill');
          b.classList.add('bg-slate-100', 'text-slate-700');
        });
        const firstPill = document.querySelector('.top-pill-btn[data-type="all"]');
        if (firstPill) {
          firstPill.classList.remove('bg-slate-100', 'text-slate-700');
          firstPill.classList.add('bg-[#003b95]', 'text-white', 'active-pill');
        }

        filterCards();
      });
    }
  };

  document.addEventListener('DOMContentLoaded', initHotelsDirectory);
  document.addEventListener('astro:page-load', initHotelsDirectory);
</script>
