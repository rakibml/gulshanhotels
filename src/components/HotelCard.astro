---
// মেইন হোটেল কার্ড ফাইল (আগের সব ইমপোর্ট এবং লজিক ঠিক থাকবে)
import CardImage from './card/CardImage.astro';
import CardInfo from './card/CardInfo.astro';
import CardPricing from './card/CardPricing.astro';

// ... (আগের সব লজিক এবং ভেরিয়েবল একই থাকবে) ...
const { hotelItem, allCmsReviews = [] } = Astro.props;
// (বাকি লজিকগুলো এখানে থাকবে...)
---

{hasValidTitle && (
  <div 
    class="directory-card-item bg-white rounded-2xl border border-slate-200/90 hover:border-slate-300 shadow-sm hover:shadow-md transition duration-200 text-left relative flex flex-col md:flex-row overflow-hidden mb-5"
    data-title={hTitleLower}
    data-stars={starCount.toString()}
    data-area={areaType}
    data-guesthouse={isGuestHouse ? 'true' : 'false'}
    data-amenities={amenitiesStr}
    data-numeric-price={numericPrice}
    data-numeric-rating={numRating}
    data-official-price={officialBaseStartingPrice}
  >
    <!-- ১. ছবির মডিউল: মোবাইলে ফুল উইডথ, ডেক্সটপে ফিক্সড উইডথ -->
    <div class="w-full md:w-64 lg:w-72 shrink-0 overflow-hidden">
      <CardImage 
        image={hImage} 
        title={hTitle} 
        url={hotelUrl} 
        price={displayPrice} 
      />
    </div>

    <!-- ২য় ও ৩য় মডিউল র‍্যাপার: ইনফরমেশন এবং প্রাইসিং -->
    <div class="flex-1 flex flex-col justify-between p-4 sm:p-5 gap-4">
      
      <div class="flex flex-col md:flex-row justify-between gap-4 md:gap-2">
        <!-- ২. টাইটেল, অ্যাড্রেস ও রিভিউ -->
        <CardInfo 
          title={hTitle} 
          url={hotelUrl} 
          stars={starCount} 
          address={hFullAddress} 
          latestReview={latestReview} 
          fallbackAbout={hSnippet25Words} 
          rating={realRating} 
          ratingLabel={ratingLabel} 
          reviewsCount={realCount} 
        />

        <!-- ৩. প্রাইসিং ও রেটিং: ডেক্সটপে ডানে, মোবাইলে নিচের লাইনে -->
        <CardPricing 
          displayPrice={displayPrice} 
          displayOriginalPrice={displayOriginalPrice} 
          discountPercent={discountPercent} 
          rating={realRating} 
          ratingLabel={ratingLabel} 
          reviewsCount={realCount} 
          title={hTitle} 
        />
      </div>

    </div>
  </div>
)}

<style is:global>
  /* আপনার গ্লোবাল স্টাইলগুলো এখানে থাকবে */
  .directory-card-item {
    margin-bottom: 20px !important;
  }
  
  /* মোবাইলে ইমেজের অ্যাসপেক্ট রেশিও কন্ট্রোল */
  @media (max-width: 767px) {
    .directory-card-item :global(.card-img-box) {
      width: 100% !important;
      aspect-ratio: 16 / 10;
      height: auto !important;
    }
  }
</style>
