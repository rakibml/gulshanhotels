---
interface Props {
  hotelItem: any;
  allCmsReviews?: any[];
}

const { hotelItem, allCmsReviews = [] } = Astro.props;

// ================= HELPERS (LIGHTWEIGHT & SAFE) =================
const toTitleCase = (str: string) => {
  if (!str) return '';
  return str.toLowerCase().split(' ').filter(Boolean).map(w => w.charAt(0).toUpperCase() + w.slice(1)).join(' ');
};

const getFirst25Words = (text: string): string => {
  if (!text || typeof text !== 'string') {
    return "Experience world-class luxury suites, exceptional hospitality, fine dining, and prime comfort in the heart of Gulshan, Dhaka.";
  }
  const clean = text.replace(/<[^>]+>/g, ' ').replace(/[#*`_~]/g, '').trim();
  const words = clean.split(/\s+/).filter(Boolean);
  if (words.length <= 25) return words.join(' ');
  return words.slice(0, 25).join(' ') + '...';
};

const cleanPriceString = (priceRaw: string) => {
  if (!priceRaw) return 'Contact for Rates';
  const clean = String(priceRaw).replace(/night/gi, '').replace(/\//g, '').trim();
  const digits = clean.replace(/[^0-9.,]/g, '').trim();
  if (!digits) return 'Contact for Rates';
  if (clean.includes('$')) return `$${digits}`;
  return `৳ ${digits}`;
};

const svgMap = {
  locationPin: `<svg class="w-3.5 h-3.5 fill-slate-700 shrink-0 mt-0.5" viewBox="0 0 24 24"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>`
};

// ================= DATA EXTRACTION =================
const hData = hotelItem?.data || {};
const rawTitle = String(hData.title || hData.name || "").trim();
const hTitle = toTitleCase(rawTitle);

const hSlug = String(hData.slug || hotelItem?.slug || hotelItem?.id || "").trim();
const hotelUrl = `/${hSlug}`; 

const rawImg = 
  hData.image || 
  hData.coverImage || 
  hData.featuredImage || 
  hData.thumbnail || 
  (Array.isArray(hData.gallery) ? hData.gallery[0] : null) || 
  (Array.isArray(hData.images) ? hData.images[0] : null) || 
  "";

const hImage = typeof rawImg === 'object' && rawImg !== null && rawImg.src 
  ? rawImg.src 
  : (typeof rawImg === 'string' ? rawImg : "");

const hFullAddress = String(hData.address || hData.location || hData.category || "Gulshan, Dhaka").trim();
const locLower = hFullAddress.toLowerCase();
const titleLowerStr = rawTitle.toLowerCase();
const catLower = String(hData.category || '').toLowerCase();

let areaType = 'near';
if (locLower.includes('gulshan 1') || locLower.includes('gulshan-1') || locLower.includes('gulshan1')) {
  areaType = 'gulshan-1';
} else if (locLower.includes('gulshan 2') || locLower.includes('gulshan-2') || locLower.includes('gulshan2')) {
  areaType = 'gulshan-2';
} else {
  areaType = 'near';
}

const isGuestHouse = locLower.includes('guest house') || locLower.includes('guesthouse') || titleLowerStr.includes('guest house') || titleLowerStr.includes('guesthouse') || catLower.includes('guest house');

const rawAbout = hotelItem?.body || hData.about || hData.description || '';
const hSnippet25Words = getFirst25Words(rawAbout);
const amenitiesStr = JSON.stringify(hData.amenities || []).toLowerCase();

// ================= AGODA STYLE REAL PRICING & % DISCOUNT =================
const parsePriceItem = (str: any) => {
  if (!str) return null;
  const s = String(str).trim();
  const digits = parseFloat(s.replace(/[^0-9.]/g, ''));
  if (isNaN(digits) || digits <= 0) return null;
  const isUsd = s.includes('$');
  return { num: digits, isUsd };
};

const priceCandidates: { num: number; isUsd: boolean; normalized: number }[] = [];

const basePriceParsed = parsePriceItem(hData.price);
if (basePriceParsed) {
  priceCandidates.push({
    ...basePriceParsed,
    normalized: basePriceParsed.isUsd ? basePriceParsed.num * 120 : basePriceParsed.num
  });
}

if (Array.isArray(hData.booking_channels)) {
  hData.booking_channels.forEach((ch: any) => {
    const chParsed = parsePriceItem(ch?.price);
    if (chParsed) {
      priceCandidates.push({
        ...chParsed,
        normalized: chParsed.isUsd ? chParsed.num * 120 : chParsed.num
      });
    }
  });
}

const explicitOrig = parsePriceItem(hData.originalPrice);
if (explicitOrig) {
  priceCandidates.push({
    ...explicitOrig,
    normalized: explicitOrig.isUsd ? explicitOrig.num * 120 : explicitOrig.num
  });
}

let displayPrice = "Contact for Rates";
let displayOriginalPrice = "";
let discountPercent = 0;
let numericPrice = 0;

if (priceCandidates.length > 0) {
  const isDollar = priceCandidates.some(p => p.isUsd);

  let lowest = priceCandidates[0];
  let highest = priceCandidates[0];

  for (let i = 1; i < priceCandidates.length; i++) {
    if (priceCandidates[i].normalized < lowest.normalized) lowest = priceCandidates[i];
    if (priceCandidates[i].normalized > highest.normalized) highest = priceCandidates[i];
  }

  displayPrice = isDollar ? `$${lowest.num}` : `৳ ${lowest.num.toLocaleString()}`;
  numericPrice = lowest.normalized;

  if (highest.normalized > lowest.normalized && highest.num > lowest.num) {
    displayOriginalPrice = isDollar ? `$${highest.num}` : `৳ ${highest.num.toLocaleString()}`;
    discountPercent = Math.round(((highest.num - lowest.num) / highest.num) * 100);
  }
}

const rawCat = String(hData.starCategory || hData.category || '').toLowerCase();
const starCount = rawCat.includes('5') ? 5 : (rawCat.includes('4') ? 4 : (rawCat.includes('3') ? 3 : 0));

const hTitleLower = rawTitle.toLowerCase();
const hSlugLower = hSlug.toLowerCase();

// Reviews Calculation
const matchedCmsReviews = allCmsReviews.filter(r => {
  if (!r) return false;
  const isApproved = r.approved === true || String(r.approved).toLowerCase() === 'true';
  if (!isApproved) return false;
  const rHotel = String(r.hotel || '').trim().toLowerCase();
  const rSlug = String(r.slug || r.hotelSlug || '').trim().toLowerCase();
  return (rSlug && rSlug === hSlugLower) || (rHotel && rHotel === hTitleLower);
});

const embedded = Array.isArray(hData.reviews) ? hData.reviews : [];
const finalReviewsList = matchedCmsReviews.length > 0 ? matchedCmsReviews : embedded;
const realCount = finalReviewsList.length;
let realRating: string | null = null;

if (realCount > 0) {
  const totalStars = finalReviewsList.reduce((sum: number, r: any) => {
    const num = parseFloat(r.rating);
    return sum + (!isNaN(num) && num > 0 && num <= 5 ? num : 5);
  }, 0);
  const avg = totalStars / realCount;
  realRating = (avg * 2).toFixed(1);
}

const numRating = parseFloat(realRating || '0');
let ratingLabel = 'Wonderful';
if (numRating < 9.0 && numRating >= 8.0) ratingLabel = 'Very Good';
else if (numRating < 8.0 && numRating > 0) ratingLabel = 'Good';

// Quick View Images
let quickViewImages: string[] = [];
if (Array.isArray(hData.gallery)) {
  quickViewImages = hData.gallery.slice(0, 5).map((img: any) => typeof img === 'object' && img?.src ? img.src : String(img || '')).filter(Boolean);
}
if (quickViewImages.length === 0 && hImage) {
  quickViewImages.push(hImage);
}

const quickViewData = {
  title: hTitle,
  stars: starCount,
  rating: realRating,
  ratingLabel: ratingLabel,
  reviewsCount: realCount,
  address: hFullAddress,
  price: displayPrice,
  images: quickViewImages,
  channels: Array.isArray(hData.booking_channels) ? hData.booking_channels : [],
  whatsapp: hData.whatsapp || '',
  phone: hData.phone || '',
  url: hotelUrl
};

const hasValidTitle = hTitle.length > 0;
---

{hasValidTitle && (
  <div 
    class="directory-card-item bg-white rounded-xl border border-slate-200/90 hover:border-slate-300 shadow-2xs hover:shadow-md transition duration-150 text-left relative flex flex-row overflow-hidden min-h-[140px] sm:min-h-[165px] md:min-h-[185px]"
    data-title={hTitleLower}
    data-stars={starCount.toString()}
    data-area={areaType}
    data-guesthouse={isGuestHouse ? 'true' : 'false'}
    data-amenities={amenitiesStr}
    data-numeric-price={numericPrice}
    data-numeric-rating={numRating}
  >
    <!-- Hidden Payload -->
    <div class="hotel-quickview-data hidden" data-payload={JSON.stringify(quickViewData)}></div>

    <!-- ================= 1ST COLUMN: HOTEL PHOTO (FLUSH TO EDGE LIKE AGODA) ================= -->
    <div class="card-img-box relative w-32 sm:w-48 md:w-56 lg:w-60 shrink-0 bg-slate-100 self-stretch overflow-hidden">
      {hImage ? (
        <img 
          src={hImage} 
          alt={`${hTitle} Photo`} 
          loading="lazy" 
          decoding="async" 
          class="absolute inset-0 w-full h-full object-cover hover:scale-105 transition duration-500" 
        />
      ) : (
        <div class="absolute inset-0 w-full h-full flex items-center justify-center bg-slate-100 text-slate-400 text-xs font-bold">
          Hotel Photo
        </div>
      )}

      <!-- Wishlist Button -->
      <button 
        type="button"
        class="card-wishlist-btn absolute top-2 right-2 w-7 h-7 sm:w-8 sm:h-8 rounded-full bg-white/90 hover:bg-white text-slate-800 flex items-center justify-center shadow transition cursor-pointer hover:scale-110 z-20"
        data-title={hTitle}
        data-image={hImage}
        data-url={hotelUrl}
        data-price={displayPrice}
        aria-label="Save to Wishlist"
        onclick="event.stopPropagation();"
      >
        <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4 text-slate-700 transition" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path>
        </svg>
      </button>
    </div>

    <!-- ================= 2ND & 3RD COLUMN CONTENT WRAPPER ================= -->
    <div class="flex-1 flex flex-col md:flex-row justify-between min-w-0 p-2.5 sm:p-3.5 md:p-4 gap-2 md:gap-0">
      
      <!-- 2ND COLUMN: HOTEL DETAILS -->
      <div class="flex-1 flex flex-col justify-between min-w-0 pr-1 md:pr-2">
        <div>
          <!-- Title & Stars -->
          <div class="flex items-center gap-1 sm:gap-1.5 flex-wrap">
            <a href={hotelUrl} class="text-xs sm:text-base md:text-lg font-bold text-[#006ce4] hover:text-[#003b95] hover:underline transition line-clamp-1 sm:line-clamp-none">
              {hTitle}
            </a>
            {starCount > 0 && (
              <span class="text-[#febb02] text-[10px] sm:text-xs md:text-sm tracking-tight shrink-0">
                {'★'.repeat(starCount)}
              </span>
            )}
          </div>

          <!-- Address -->
          <div class="flex items-start gap-1 text-[10px] sm:text-xs text-slate-600 font-medium mt-0.5 sm:mt-1 leading-snug">
            <span set:html={svgMap.locationPin} class="inline-flex shrink-0"></span>
            <span class="hover:underline cursor-pointer line-clamp-1">{hFullAddress}</span>
          </div>

          <!-- Description -->
          <p class="text-[11px] sm:text-xs text-slate-600 mt-1.5 sm:mt-2 leading-relaxed line-clamp-2 md:line-clamp-3 hidden sm:block">
            {hSnippet25Words}
          </p>
        </div>

        <!-- Mobile Inline Review Score Badge -->
        <div class="md:hidden flex items-center gap-1.5 mt-1">
          {realRating ? (
            <>
              <div class="bg-[#003b95] text-white font-bold text-[10px] px-1.5 py-0.5 rounded leading-none shadow-2xs">
                {realRating}
              </div>
              <span class="text-[10px] font-bold text-slate-800">{ratingLabel}</span>
              <span class="text-[9px] text-slate-500">({realCount})</span>
            </>
          ) : (
            <span class="bg-slate-100 text-slate-600 text-[9px] font-bold px-1.5 py-0.5 rounded">
              New to site
            </span>
          )}
        </div>
      </div>

      <!-- 3RD COLUMN: PRICING & BOOKING -->
      <div class="w-full md:w-48 lg:w-52 shrink-0 md:border-l md:border-slate-100 md:pl-3.5 pt-1.5 sm:pt-2 md:pt-1 border-t md:border-t-0 border-slate-100 flex flex-row md:flex-col justify-between items-center md:items-end text-left md:text-right gap-2">
        
        <!-- Desktop Review Score -->
        <div class="w-full hidden md:flex justify-end">
          {realRating ? (
            <div class="flex items-center gap-2">
              <div class="text-right hidden sm:block">
                <div class="text-xs font-bold text-slate-900 leading-tight">{ratingLabel}</div>
                <div class="text-[10px] text-slate-500 leading-tight">{realCount} reviews</div>
              </div>
              <div class="bg-[#003b95] text-white font-bold text-xs sm:text-sm px-2 py-1 rounded-t-lg rounded-br-lg leading-none shadow-2xs">
                {realRating}
              </div>
            </div>
          ) : (
            <div class="bg-slate-100 text-slate-600 text-[10px] font-bold px-2 py-0.5 rounded">
              New to site
            </div>
          )}
        </div>

        <!-- Price Info (Agoda Style) -->
        <div class="text-left md:text-right">
          {displayOriginalPrice && (
            <div class="flex items-center gap-1.5 justify-start md:justify-end leading-none mb-0.5">
              <span class="text-[9px] sm:text-[11px] text-slate-400 line-through font-semibold">
                {displayOriginalPrice}
              </span>
              {discountPercent > 0 && (
                <span class="text-[9px] sm:text-[10px] font-black text-[#e52429] bg-rose-50 border border-rose-200/80 px-1 py-0.5 rounded leading-none">
                  -{discountPercent}%
                </span>
              )}
            </div>
          )}
          <span class="text-sm sm:text-base md:text-xl font-extrabold text-[#008234] block leading-tight my-0.5">
            {displayPrice}
          </span>
          <span class="text-[8px] sm:text-[10px] text-slate-500 font-medium block leading-tight">
            Best rate found
          </span>
        </div>

        <!-- Quick View Action Button -->
        <button 
          type="button"
          class="open-quick-view-btn w-auto md:w-full bg-[#006ce4] hover:bg-[#0057b8] text-white text-[11px] sm:text-xs font-bold py-1.5 sm:py-2 px-3 rounded-lg sm:rounded-xl transition inline-flex items-center justify-center gap-1.5 shadow-xs hover:shadow cursor-pointer whitespace-nowrap text-center active:scale-95"
          aria-label={`Quick view of ${hTitle}`}
        >
          <svg class="w-3.5 h-3.5 shrink-0 fill-current opacity-90" viewBox="0 0 24 24">
            <path d="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"/>
          </svg>
          <span>Quick View</span>
        </button>

      </div>

    </div>
  </div>
)}

<!-- ================= AGODA GLOBAL DESIGN ENFORCER ================= -->
<style is:global>
  /* ১. পুরো পেজের ব্যাকগ্রাউন্ড অটোমেটিক অ্যাগোডার মতো সফট গ্রে (#f7f7f9) হবে */
  body, main {
    background-color: #f7f7f9 !important;
  }

  /* ২. কার্ডের মাঝের গ্যাপ অটোমেটিক ১২ পিক্সেল (Agoda gap) লক থাকবে */
  .directory-card-item {
    margin-bottom: 12px !important;
    margin-top: 0 !important;
  }

  /* ৩. খালি ফ্রেম বা ফাঁকা দাগ (Ghost Card) চিরতরে অদৃশ্য থাকবে */
  .directory-card-item:empty,
  .directory-card-item[data-title=""] {
    display: none !important;
  }
</style>
