---
import CardImage from './card/CardImage.astro';
import CardInfo from './card/CardInfo.astro';
import CardPricing from './card/CardPricing.astro';

interface Props {
  hotelItem: any;
  allCmsReviews?: any[];
}

const { hotelItem, allCmsReviews = [] } = Astro.props;

// --- ১. হেল্পার ফাংশনসমূহ (Data Cleaning) ---
const toTitleCase = (str: string) => {
  if (!str) return '';
  return str.toLowerCase().split(' ').filter(Boolean).map(w => w.charAt(0).toUpperCase() + w.slice(1)).join(' ');
};

const getFirst25Words = (text: string): string => {
  if (!text || typeof text !== 'string') return "Experience world-class luxury and comfort in the heart of Gulshan, Dhaka.";
  const clean = text.replace(/<[^>]+>/g, ' ').replace(/[#*`_~]/g, '').trim();
  const words = clean.split(/\s+/).filter(Boolean);
  return words.length <= 25 ? words.join(' ') : words.slice(0, 25).join(' ') + '...';
};

const cleanPriceString = (priceRaw: string) => {
  if (!priceRaw) return 'Contact for Rates';
  const clean = String(priceRaw).replace(/night/gi, '').replace(/\//g, '').trim();
  const digits = clean.replace(/[^0-9.,]/g, '').trim();
  return clean.includes('$') ? `$${digits}` : `৳ ${digits}`;
};

// --- ২. হোটেলের মূল তথ্য ---
const hData = hotelItem?.data || {};
const hotelTitle = (hData.title || hData.name || "Hotel Details").trim();
const hotelSlug = (hData.slug || hotelItem?.slug || hotelItem?.id || "hotel").trim();

const hTitle = toTitleCase(hotelTitle);
const hSlug = hotelSlug;
const hotelUrl = `/${hSlug}`; 

const rawImg = hData.image || hData.coverImage || hData.featuredImage || (Array.isArray(hData.gallery) ? hData.gallery[0] : "");
const hImage = typeof rawImg === 'object' && rawImg !== null && rawImg.src ? rawImg.src : (typeof rawImg === 'string' ? rawImg : "");

const hFullAddress = String(hData.address || hData.location || "Gulshan, Dhaka").trim();
const locLower = hFullAddress.toLowerCase();

// এরিয়া এবং স্টার
let areaType = 'near';
if (locLower.includes('gulshan 1')) areaType = 'gulshan-1';
else if (locLower.includes('gulshan 2')) areaType = 'gulshan-2';

const rawCat = String(hData.starCategory || hData.category || '').toLowerCase();
const starCount = rawCat.includes('5') ? 5 : (rawCat.includes('4') ? 4 : (rawCat.includes('3') ? 3 : 0));
const hSnippet25Words = getFirst25Words(hotelItem?.body || hData.about || hData.description || '');

// --- ৩. প্রাইসিং লজিক ---
const rawBasePrice = hData.price ? String(hData.price).trim() : "";
const officialBaseStartingPrice = cleanPriceString(rawBasePrice);
const rawDigits = parseFloat(rawBasePrice.replace(/[^0-9.]/g, '')) || 0;
let numericPrice = rawBasePrice.includes('$') ? Math.round(rawDigits * 120) : rawDigits;

let lowestNum = 0, highestNum = 0;
if (Array.isArray(hData.booking_channels)) {
  hData.booking_channels.forEach((ch: any) => {
    const pNum = parseFloat(String(ch?.price || '').replace(/[^0-9.]/g, '')) || 0;
    if (pNum > 0) {
      if (lowestNum === 0 || pNum < lowestNum) lowestNum = pNum;
      if (pNum > highestNum) highestNum = pNum;
    }
  });
}
const displayPrice = lowestNum > 0 ? (rawBasePrice.includes('$') ? `$${lowestNum}` : `৳ ${lowestNum.toLocaleString()}`) : officialBaseStartingPrice;
let displayOriginalPrice = "";
let discountPercent = 0;
if (highestNum > lowestNum && lowestNum > 0) {
  displayOriginalPrice = rawBasePrice.includes('$') ? `$${highestNum}` : `৳ ${highestNum.toLocaleString()}`;
  discountPercent = Math.round(((highestNum - lowestNum) / highestNum) * 100);
}

// --- ৪. রিভিউ লজিক (হোটেল পেজের সাথে ১০০% মিল রাখা হয়েছে) ---
const searchTitle = hotelTitle.toLowerCase();
const searchSlug = hotelSlug.toLowerCase();

let rawReviewsList: any[] = [];
try {
  const rawGlob = import.meta.glob('../content/reviews/*.md', { eager: true });
  rawReviewsList = Object.values(rawGlob).map((item: any) => item.frontmatter || {});
  if (rawReviewsList.length === 0 && allCmsReviews.length > 0) {
    rawReviewsList = allCmsReviews.map(r => r.data || r);
  }
} catch (e) {
  rawReviewsList = allCmsReviews.map(r => r.data || r);
}

const approvedCmsReviews = rawReviewsList.filter(item => {
  if (!item) return false;
  const isApproved = item.approved === true || String(item.approved).toLowerCase() === 'true';
  if (!isApproved) return false;
  const rHotel = (item.hotel || "").trim().toLowerCase();
  const rSlug = (item.slug || item.hotelSlug || "").trim().toLowerCase();
  return (rSlug !== "" && (rSlug === searchSlug || searchSlug.includes(rSlug))) || 
         (rHotel !== "" && (rHotel === searchTitle || searchTitle.includes(rHotel)));
});

const hotelEmbeddedReviews = Array.isArray(hData.reviews) ? hData.reviews : [];
const finalReviewsList = [...approvedCmsReviews, ...hotelEmbeddedReviews].map((rev) => ({
  rating: Number(rev.rating) || 5,
  comment: (rev.comment || '').trim()
})).filter(r => r.comment.length > 2);

const realCount = finalReviewsList.length;
const totalStarsSum = finalReviewsList.reduce((sum, r) => sum + r.rating, 0);
const realRating = realCount > 0 ? (totalStarsSum / realCount * 2).toFixed(1) : null;

const numRating = parseFloat(realRating || '0');
let ratingLabel = 'Wonderful';
if (numRating < 9.0 && numRating >= 8.0) ratingLabel = 'Very Good';
else if (numRating < 8.0 && numRating > 0) ratingLabel = 'Good';

const latestReview = approvedCmsReviews.length > 0 ? approvedCmsReviews[0] : (hotelEmbeddedReviews.length > 0 ? hotelEmbeddedReviews[0] : null);
const hasValidTitle = hTitle.length > 0;
---

{hasValidTitle && (
  <div 
    class="directory-card-item group bg-white rounded-[32px] border border-slate-200 hover:border-slate-300 shadow-sm hover:shadow-xl transition-all duration-500 flex flex-col md:flex-row overflow-hidden mb-8"
    data-title={hotelTitle.toLowerCase()}
    data-stars={starCount.toString()}
    data-area={areaType}
    data-numeric-price={numericPrice}
    data-numeric-rating={numRating}
    data-official-price={officialBaseStartingPrice}
  >
    <!-- ১. ইমেজ সেকশন (ডেক্সটপে ফিক্সড সাইজ, মোবাইলে ফুল) -->
    <div class="relative w-full md:w-72 lg:w-80 shrink-0 aspect-[16/10] md:aspect-auto overflow-hidden bg-slate-100 border-b md:border-b-0 md:border-r border-slate-100">
      <CardImage image={hImage} title={hTitle} url={hotelUrl} price={displayPrice} />
    </div>

    <!-- ২. কন্টেন্ট র‍্যাপার (ডেক্সটপে ইনফো এবং প্রাইস পাশাপাশি থাকবে) -->
    <div class="flex-1 flex flex-col md:flex-row">
      
      <!-- ২.১ ইনফরমেশন সেকশন (মাঝখানের অংশ) -->
      <div class="flex-1 min-w-0 p-5 lg:p-6">
        <CardInfo 
          title={hTitle} 
          url={hotelUrl} 
          stars={starCount} 
          address={hFullAddress} 
          latestReview={latestReview} 
          fallbackAbout={hSnippet25Words} 
          rating={realRating} 
          ratingLabel={ratingLabel} 
          reviewsCount={realCount} 
          amenities={hData.amenities || []}
        />
      </div>

      <!-- ২.২ প্রাইসিং এবং অ্যাকশন সেকশন (ডানদিকের সাইডবার) -->
      <div class="w-full md:w-[220px] lg:w-[260px] shrink-0 p-5 lg:p-6 bg-slate-50/40 md:bg-transparent md:border-l border-slate-100 flex flex-col justify-center">
        <CardPricing 
          displayPrice={displayPrice} 
          displayOriginalPrice={displayOriginalPrice} 
          discountPercent={discountPercent} 
          rating={realRating} 
          ratingLabel={ratingLabel} 
          reviewsCount={realCount} 
          title={hTitle} 
        />
      </div>

    </div>
  </div>
)}

<style is:global>
  /* কার্ডের জন্য গ্লোবাল স্টাইল */
  .directory-card-item {
    font-family: 'Plus Jakarta Sans', sans-serif;
  }
  
  /* ট্রানজিশন স্মুথ করার জন্য */
  .directory-card-item img {
    will-change: transform;
  }
</style>
