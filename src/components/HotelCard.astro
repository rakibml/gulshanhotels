---
// src/components/directory/HotelCard.astro (Butter-Smooth 60FPS Mobile Optimized & Full Dynamic Features)
import CardImage from './card/CardImage.astro';
import CardInfo from './card/CardInfo.astro';
import CardPricing from './card/CardPricing.astro';

interface Props {
  hotelItem: any;
  allCmsReviews?: any[];
}

const { hotelItem, allCmsReviews = [] } = Astro.props;

// --- 1. Helper Functions ---
const toTitleCase = (str: string) => str ? str.toLowerCase().split(' ').map(w => w.charAt(0).toUpperCase() + w.slice(1)).join(' ') : '';

const getFirst25Words = (text: string) => {
  if (!text) return "Experience world-class luxury and comfort in Gulshan.";
  const clean = text.replace(/<[^>]+>/g, ' ').replace(/[#*`_~]/g, '').trim();
  const words = clean.split(/\s+/);
  return words.length <= 25 ? words.join(' ') : words.slice(0, 25).join(' ') + '...';
};

// --- 2. Extract Basic Hotel Data ---
const hData = hotelItem?.data || {};
const hotelTitle = (hData.title || hData.name || "Hotel Details").trim();
const hotelSlug = (hData.slug || hotelItem?.slug || hotelItem?.id || "hotel").trim();

const hTitle = toTitleCase(hotelTitle);
const hSlug = hotelSlug;
const hotelUrl = `/${hSlug}`; 

const rawImg = hData.image || hData.coverImage || (Array.isArray(hData.gallery) ? hData.gallery[0] : "");
const hImage = typeof rawImg === 'object' && rawImg !== null && rawImg.src ? rawImg.src : (typeof rawImg === 'string' ? rawImg : "");

const hFullAddress = String(hData.address || hData.location || "Gulshan, Dhaka").trim();
const locLower = hFullAddress.toLowerCase();
const titleLowerStr = hotelTitle.toLowerCase();

// --- 3. Filter Data Logic ---
let areaType = 'near';
if (locLower.includes('gulshan 1') || locLower.includes('gulshan-1')) areaType = 'gulshan-1';
else if (locLower.includes('gulshan 2') || locLower.includes('gulshan-2')) areaType = 'gulshan-2';

const rawCat = String(hData.starCategory || hData.category || '').toLowerCase();
const starCount = rawCat.includes('5') ? 5 : (rawCat.includes('4') ? 4 : 3);
const isGuestHouse = locLower.includes('guest house') || locLower.includes('guesthouse') || titleLowerStr.includes('guest house');

// --- 4. Pricing Logic ---
const mdPriceRaw = hData.price || "$100"; 
const isDollar = mdPriceRaw.includes('$');
const mdPriceNumeric = parseFloat(mdPriceRaw.replace(/[^0-9.]/g, '')) || 0;

let lowestChannelPrice = 0;
if (Array.isArray(hData.booking_channels)) {
  hData.booking_channels.forEach((ch: any) => {
    const pNum = parseFloat(String(ch?.price || '').replace(/[^0-9.]/g, ''));
    if (pNum > 0) {
      if (lowestChannelPrice === 0 || pNum < lowestChannelPrice) {
        lowestChannelPrice = pNum;
      }
    }
  });
}

let displayPrice = "";         
let displayOriginalPrice = ""; 
let discountPercent = 0;

if (lowestChannelPrice > 0 && lowestChannelPrice < mdPriceNumeric) {
  displayPrice = isDollar ? `$${lowestChannelPrice}` : `৳${lowestChannelPrice.toLocaleString()}`;
  displayOriginalPrice = mdPriceRaw.startsWith('$') || mdPriceRaw.startsWith('৳') ? mdPriceRaw : '$' + mdPriceRaw;
  discountPercent = Math.round(((mdPriceNumeric - lowestChannelPrice) / mdPriceNumeric) * 100);
} else {
  displayPrice = mdPriceRaw.startsWith('$') || mdPriceRaw.startsWith('৳') ? mdPriceRaw : '$' + mdPriceRaw;
  displayOriginalPrice = "";
  discountPercent = 0;
}

const filterPriceVal = lowestChannelPrice > 0 ? lowestChannelPrice : mdPriceNumeric;
const filterPriceBDT = isDollar ? Math.round(filterPriceVal * 120) : filterPriceVal;

// --- 5. Reviews Logic ---
const searchTitle = hotelTitle.toLowerCase();
const searchSlug = hotelSlug.toLowerCase();
let rawReviewsList: any[] = [];

try {
  const rawGlob = import.meta.glob('../content/reviews/*.md', { eager: true });
  rawReviewsList = Object.values(rawGlob).map((item: any) => item.frontmatter || {});
} catch (e) {}

const approvedCmsReviews = rawReviewsList.filter(item => {
  if (!item || !item.approved) return false;
  const rSlug = (item.slug || item.hotelSlug || "").toLowerCase();
  const rHotel = (item.hotel || "").toLowerCase();
  return (rSlug !== "" && rSlug === searchSlug) || (rHotel !== "" && rHotel === searchTitle);
});

const allApprovedReviews = [...approvedCmsReviews, ...(hData.reviews || [])];
const realCount = allApprovedReviews.length;
const realRating = realCount > 0 ? (allApprovedReviews.reduce((sum, r) => sum + (Number(r.rating) || 5), 0) / realCount).toFixed(1) : "5.0";
const latestReview = allApprovedReviews.length > 0 ? allApprovedReviews[0] : null;

const hotelGallery = Array.isArray(hData.gallery) && hData.gallery.length > 0 ? hData.gallery : [hImage];

// --- 6. 100% Dynamic Policies Collection ---
const rawPolicies = Array.isArray(hData.policies) ? hData.policies : [];
let policiesList: any[] = [];

if (rawPolicies.length > 0) {
  policiesList = rawPolicies
    .filter((p: any) => p && p.label && p.value)
    .map((p: any) => ({
      label: String(p.label).trim(),
      value: String(p.value).trim(),
      custom_svg: p.custom_svg || p.svg || ""
    }));
} else {
  if (hData.checkIn || hData.check_in) policiesList.push({ label: 'Check-In', value: String(hData.checkIn || hData.check_in) });
  if (hData.checkOut || hData.check_out) policiesList.push({ label: 'Check-Out', value: String(hData.checkOut || hData.check_out) });
  if (hData.powerBackup || hData.power_backup) policiesList.push({ label: 'Power Backup', value: String(hData.powerBackup || hData.power_backup) });
  if (hData.smokingPolicy || hData.smoking) policiesList.push({ label: 'Smoking', value: String(hData.smokingPolicy || hData.smoking) });
  if (hData.couplePolicy || hData.couple_policy) policiesList.push({ label: 'Couple Policy', value: String(hData.couplePolicy || hData.couple_policy) });
  if (hData.cancellation) policiesList.push({ label: 'Cancellation', value: String(hData.cancellation) });
}

// --- 7. Comprehensive Amenities Extraction ---
const allExtractedAmenities: string[] = [];

if (Array.isArray(hData.amenities)) {
  hData.amenities.forEach((item: any) => {
    const name = typeof item === 'string' ? item : (item?.name || '');
    if (name) allExtractedAmenities.push(name);
  });
}

if (Array.isArray(hData.categorized_amenities)) {
  hData.categorized_amenities.forEach((cat: any) => {
    if (Array.isArray(cat?.items)) {
      cat.items.forEach((sub: any) => {
        const name = typeof sub === 'string' ? sub : (sub?.name || '');
        if (name) allExtractedAmenities.push(name);
      });
    }
  });
}

const amenitiesFilterString = allExtractedAmenities.join(' | ').toLowerCase();
const hasValidTitle = hTitle.length > 0;
---

{hasValidTitle && (
  <div 
    class="directory-card-item bg-white rounded-2xl sm:rounded-3xl border border-slate-200/90 hover:border-slate-300 shadow-2xs hover:shadow-md transition-shadow duration-200 mb-4 overflow-hidden cursor-pointer"
    data-title={titleLowerStr}
    data-hotel-name={hTitle}
    data-hotel-address={hFullAddress}
    data-hotel-url={hotelUrl}
    data-stars={starCount.toString()}
    data-area={areaType}
    data-slug={hSlug}
    data-guesthouse={isGuestHouse ? 'true' : 'false'}
    data-numeric-price={filterPriceBDT}
    data-numeric-rating={parseFloat(realRating)}
    
    /* --- Modal & Filter Attributes --- */
    data-md-price={mdPriceRaw}
    data-booking-channels={JSON.stringify(hData.booking_channels || [])}
    data-gallery={JSON.stringify(hotelGallery)}
    data-policies={JSON.stringify(policiesList)}
    data-amenities={amenitiesFilterString}
    data-whatsapp={hData.whatsapp || ""}
    data-phone={hData.phone || ""}
  >
    <div class="w-full flex flex-col md:grid md:grid-cols-[280px_1fr_240px] lg:grid-cols-[320px_1fr_260px]">
      
      <!-- Module 1: Image -->
      <div class="relative w-full h-full min-h-[200px] md:min-h-0 bg-slate-100 border-b md:border-b-0 md:border-r border-slate-100">
        <CardImage image={hImage} title={hTitle} url={hotelUrl} price={displayPrice} />
      </div>

      <!-- Module 2: Information -->
      <div class="p-4 sm:p-5 md:p-6 flex flex-col justify-center min-w-0">
        <CardInfo 
          title={hTitle} 
          url={hotelUrl} 
          stars={starCount} 
          address={hFullAddress} 
          latestReview={latestReview} 
          fallbackAbout={getFirst25Words(hData.about)} 
          rating={realRating} 
          reviewsCount={realCount} 
          amenities={allExtractedAmenities}
        />
      </div>

      <!-- Module 3: Pricing -->
      <div class="p-4 sm:p-5 md:p-6 bg-slate-50/40 md:bg-white md:border-l border-slate-100 flex flex-col justify-center">
        <CardPricing 
          displayPrice={displayPrice} 
          displayOriginalPrice={displayOriginalPrice} 
          discountPercent={discountPercent} 
          title={hTitle} 
        />
      </div>

    </div>
  </div>
)}

<style is:global>
  /* ১. মোবাইলে ৬০ FPS মসৃণ স্ক্রলিং ও মেমোরি সেভার (Zero Jank / Zero Lag) */
  .directory-card-item {
    content-visibility: auto;
    contain-intrinsic-size: 0 200px;
    -webkit-backface-visibility: hidden;
    backface-visibility: hidden;
    transform: translateZ(0);
  }

  /* ২. ব্যাকগ্রাউন্ড ধবধবে সাদা */
  html, body, main {
    background-color: #ffffff !important;
  }

  .directory-card-item:empty,
  .directory-card-item[data-title=""] {
    display: none !important;
  }
</style>

<!-- SMART WHOLE-CARD CLICK NAVIGATION SCRIPT -->
<script>
  const setupCardNavigation = () => {
    if ((window as any).__cardNavInitialized) return;
    (window as any).__cardNavInitialized = true;

    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement | null;
      if (!target) return;

      // যদি ইউজার Quick View, Wishlist বা See More বাটনে ক্লিক করে, তবে পেজ নেভিগেট হবে না!
      if (target.closest('button, input, select, textarea, .open-quick-view-btn, .wishlist-btn, .toggle-review-btn')) {
        return;
      }

      // কার্ডের যেকোনো জায়গায় ক্লিক পড়লে
      const card = target.closest('.directory-card-item') as HTMLElement | null;
      if (!card) return;

      const url = card.getAttribute('data-hotel-url') || card.querySelector('a')?.getAttribute('href');
      if (!url || url === '#') return;

      if (e.ctrlKey || e.metaKey) {
        window.open(url, '_blank');
      } else {
        window.location.href = url;
      }
    });
  };

  setupCardNavigation();
  document.addEventListener('astro:page-load', setupCardNavigation);
</script>
