---
interface Props {
  hotelItem: any;
  allCmsReviews?: any[];
}

const { hotelItem, allCmsReviews = [] } = Astro.props;

// Helpers
const toTitleCase = (str: string) => {
  return str.toLowerCase().split(' ').map(w => w.charAt(0).toUpperCase() + w.slice(1)).join(' ');
};

const getFirst25Words = (text: string): string => {
  if (!text) return "Experience world-class luxury suites, exceptional hospitality, fine dining, and prime comfort in the heart of Gulshan, Dhaka.";
  const clean = text.replace(/<[^>]*>?/gm, '').replace(/[#*`_~]/g, '').replace(/---[\s\S]*?---/g, '').trim();
  const words = clean.split(/\s+/).filter(Boolean);
  if (words.length <= 25) return words.join(' ');
  return words.slice(0, 25).join(' ') + '...';
};

const cleanPriceString = (priceRaw: string) => {
  if (!priceRaw) return 'Contact for Rates';
  const clean = String(priceRaw).replace(/night/gi, '').replace(/\//g, '').trim();
  const digits = clean.replace(/[^0-9.,]/g, '').trim();
  if (clean.includes('$')) return `$${digits}`;
  return `৳ ${digits}`;
};

const svgMap = {
  locationPin: `<svg class="w-3.5 h-3.5 fill-slate-700 shrink-0 mt-0.5" viewBox="0 0 24 24"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>`
};

// Data Extraction
const hData = hotelItem.data || {};
const rawTitle = String(hData.title || hData.name || "").trim();
const hTitle = toTitleCase(rawTitle);
const hSlug = String(hData.slug || hotelItem.slug || hotelItem.id || "").trim();
const hImage = hData.image || (Array.isArray(hData.gallery) ? hData.gallery[0] : "");

const hFullAddress = String(hData.address || hData.location || hData.category || "Gulshan, Dhaka").trim();
const locLower = hFullAddress.toLowerCase();
const titleLowerStr = rawTitle.toLowerCase();
const catLower = String(hData.category || '').toLowerCase();

let areaType = 'near';
if (locLower.includes('gulshan 1') || locLower.includes('gulshan-1') || locLower.includes('gulshan1')) {
  areaType = 'gulshan-1';
} else if (locLower.includes('gulshan 2') || locLower.includes('gulshan-2') || locLower.includes('gulshan2')) {
  areaType = 'gulshan-2';
} else {
  areaType = 'near';
}

const isGuestHouse = locLower.includes('guest house') || locLower.includes('guesthouse') || titleLowerStr.includes('guest house') || titleLowerStr.includes('guesthouse') || catLower.includes('guest house');

const rawAbout = hotelItem.body || (typeof hotelItem.rawContent === 'function' ? hotelItem.rawContent() : '') || hData.about || hData.description || '';
const hSnippet25Words = getFirst25Words(rawAbout);
const amenitiesStr = JSON.stringify(hData.amenities || []).toLowerCase();

const rawPrice = hData.price ? String(hData.price).trim() : "";
const displayPrice = cleanPriceString(rawPrice);
const rawDigits = parseFloat(rawPrice.replace(/[^0-9.]/g, '')) || 0;
const isDollar = rawPrice.includes('$');
const numericPrice = isDollar ? Math.round(rawDigits * 120) : rawDigits;

let originalPriceNum = hData.originalPrice ? parseFloat(String(hData.originalPrice).replace(/[^0-9.]/g, '')) : 0;
if (!originalPriceNum || originalPriceNum <= rawDigits) {
  originalPriceNum = isDollar ? Math.round(rawDigits * 1.20) : Math.round(rawDigits * 1.20 / 100) * 100;
}
const displayOriginalPrice = isDollar ? `$${originalPriceNum}` : `৳ ${originalPriceNum.toLocaleString()}`;

const rawCat = String(hData.starCategory || hData.category || '').toLowerCase();
const starCount = rawCat.includes('5') ? 5 : (rawCat.includes('4') ? 4 : (rawCat.includes('3') ? 3 : 0));

const hTitleLower = rawTitle.toLowerCase();
const hSlugLower = hSlug.toLowerCase();

// Reviews Calculation
const matchedCmsReviews = allCmsReviews.filter(r => {
  if (!r) return false;
  const isApproved = r.approved === true || String(r.approved).toLowerCase() === 'true';
  if (!isApproved) return false;
  const rHotel = String(r.hotel || '').trim().toLowerCase();
  const rSlug = String(r.slug || r.hotelSlug || '').trim().toLowerCase();
  return (rSlug && rSlug === hSlugLower) || (rHotel && rHotel === hTitleLower);
});

const embedded = Array.isArray(hData.reviews) ? hData.reviews : [];
const finalReviewsList = matchedCmsReviews.length > 0 ? matchedCmsReviews : embedded;
const realCount = finalReviewsList.length;
let realRating: string | null = null;

if (realCount > 0) {
  const totalStars = finalReviewsList.reduce((sum: number, r: any) => {
    const num = parseFloat(r.rating);
    return sum + (!isNaN(num) && num > 0 && num <= 5 ? num : 5);
  }, 0);
  const avg = totalStars / realCount;
  realRating = (avg * 2).toFixed(1);
}

const numRating = parseFloat(realRating || '0');
let ratingLabel = 'Wonderful';
if (numRating < 9.0 && numRating >= 8.0) ratingLabel = 'Very Good';
else if (numRating < 8.0 && numRating > 0) ratingLabel = 'Good';
---

<div 
  class="directory-card-item bg-white rounded-xl sm:rounded-2xl border border-slate-200/90 overflow-hidden shadow-xs hover:shadow-md transition duration-200 text-left relative flex flex-row p-2.5 sm:p-3.5 md:p-4 gap-2.5 sm:gap-4 md:gap-0 min-h-[145px] sm:min-h-[180px] md:min-h-[195px]"
  data-title={hTitleLower}
  data-stars={starCount.toString()}
  data-area={areaType}
  data-guesthouse={isGuestHouse ? 'true' : 'false'}
  data-amenities={amenitiesStr}
  data-numeric-price={numericPrice}
  data-numeric-rating={numRating}
>
  <!-- ================= 1ST COLUMN: HOTEL PHOTO ================= -->
  <div class="card-img-box relative w-28 sm:w-44 md:w-56 lg:w-60 shrink-0 rounded-lg sm:rounded-xl overflow-hidden bg-slate-100 self-stretch">
    {hImage ? (
      <img 
        src={hImage} 
        alt={`${hTitle} Photo`} 
        loading="lazy" 
        decoding="async" 
        class="w-full h-full object-cover hover:scale-105 transition duration-500" 
      />
    ) : (
      <div class="w-full h-full flex items-center justify-center bg-slate-100 text-slate-400 text-xs font-bold">
        Hotel Photo
      </div>
    )}

    <button 
      type="button"
      class="card-wishlist-btn absolute top-1.5 right-1.5 sm:top-2 sm:right-2 w-6 h-6 sm:w-8 sm:h-8 rounded-full bg-white/90 hover:bg-white text-slate-800 flex items-center justify-center shadow transition cursor-pointer hover:scale-110 z-20"
      data-title={hTitle}
      data-image={hImage}
      data-url={`/${hSlug}`}
      data-price={displayPrice}
      aria-label="Save to Wishlist"
    >
      <svg class="w-3 h-3 sm:w-3.5 sm:h-3.5 text-slate-700 transition" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path></svg>
    </button>
  </div>

  <!-- 2ND & 3RD COLUMN WRAPPER -->
  <div class="flex-1 flex flex-col md:flex-row justify-between min-w-0 md:px-4 py-0 sm:py-0.5 gap-1.5 sm:gap-2 md:gap-0">
    
    <!-- ================= 2ND COLUMN: HOTEL DETAILS ================= -->
    <div class="flex-1 flex flex-col justify-between min-w-0 pr-1 md:pr-0">
      <div>
        <!-- Title & Stars -->
        <div class="flex items-center gap-1 sm:gap-1.5 flex-wrap">
          <a href={`/${hSlug}`} class="text-xs sm:text-base md:text-lg font-bold text-[#006ce4] hover:text-[#003b95] hover:underline transition line-clamp-1 sm:line-clamp-none">
            {hTitle}
          </a>
          {starCount > 0 && (
            <span class="text-[#febb02] text-[10px] sm:text-xs md:text-sm tracking-tight shrink-0">
              {'★'.repeat(starCount)}
            </span>
          )}
        </div>

        <!-- Address -->
        <div class="flex items-start gap-1 text-[10px] sm:text-xs text-slate-600 font-medium mt-0.5 sm:mt-1 leading-snug">
          <span set:html={svgMap.locationPin} class="inline-flex shrink-0"></span>
          <span class="hover:underline cursor-pointer line-clamp-1">{hFullAddress}</span>
        </div>

        <!-- Description -->
        <p class="text-[11px] sm:text-xs text-slate-600 mt-1.5 sm:mt-2.5 leading-relaxed line-clamp-2 md:line-clamp-3 hidden sm:block">
          {hSnippet25Words}
        </p>
      </div>

      <!-- Mobile Inline Review Score Badge -->
      <div class="md:hidden flex items-center gap-1.5 mt-1">
        {realRating ? (
          <>
            <div class="bg-[#003b95] text-white font-bold text-[10px] px-1.5 py-0.5 rounded leading-none shadow-xs">
              {realRating}
            </div>
            <span class="text-[10px] font-bold text-slate-800">{ratingLabel}</span>
            <span class="text-[9px] text-slate-500">({realCount})</span>
          </>
        ) : (
          <span class="bg-slate-100 text-slate-600 text-[9px] font-bold px-1.5 py-0.5 rounded">
            New to site
          </span>
        )}
      </div>
    </div>

    <!-- ================= 3RD COLUMN: PRICING & BOOKING (আপনি এটি পরিবর্তন করতে পারবেন) ================= -->
    <div class="w-full md:w-52 lg:w-56 shrink-0 md:border-l md:border-slate-100 md:pl-4 pt-1.5 sm:pt-2 md:pt-1 border-t md:border-t-0 border-slate-100 flex flex-row md:flex-col justify-between items-center md:items-end text-left md:text-right gap-2">
      
      <!-- Desktop Review Score -->
      <div class="w-full hidden md:flex justify-end">
        {realRating ? (
          <div class="flex items-center gap-2">
            <div class="text-right hidden sm:block">
              <div class="text-xs font-bold text-slate-900 leading-tight">{ratingLabel}</div>
              <div class="text-[10px] text-slate-500 leading-tight">{realCount} reviews</div>
            </div>
            <div class="bg-[#003b95] text-white font-bold text-sm px-2 py-1 rounded-t-lg rounded-br-lg leading-none shadow-xs">
              {realRating}
            </div>
          </div>
        ) : (
          <div class="bg-slate-100 text-slate-600 text-[10px] font-bold px-2 py-0.5 rounded">
            New to site
          </div>
        )}
      </div>

      <!-- Price Info -->
      <div class="text-left md:text-right">
        <span class="text-[9px] sm:text-[11px] text-slate-400 line-through font-semibold block leading-none">
          {displayOriginalPrice}
        </span>
        <span class="text-sm sm:text-base md:text-xl font-extrabold text-[#008234] block leading-tight my-0.5">
          {displayPrice}
        </span>
        <span class="text-[8px] sm:text-[10px] text-slate-500 font-medium block leading-tight">
          Best rate found
        </span>
      </div>

      <!-- CTA Button -->
      <a 
        href={`/${hSlug}`} 
        class="w-auto md:w-full bg-[#006ce4] hover:bg-[#0057b8] text-white text-[11px] sm:text-xs font-bold py-1.5 sm:py-2 px-3 rounded-lg transition inline-flex items-center justify-center gap-1 shadow-xs hover:shadow whitespace-nowrap text-center"
      >
        <span>See Options</span>
        <span class="text-xs">›</span>
      </a>

    </div>

  </div>
</div>
