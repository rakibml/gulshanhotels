---
import CardImage from './card/CardImage.astro';
import CardInfo from './card/CardInfo.astro';
import CardPricing from './card/CardPricing.astro';

interface Props {
  hotelItem: any;
  allCmsReviews?: any[];
}

const { hotelItem, allCmsReviews = [] } = Astro.props;

// --- ১. লজিক সেকশন (আগের মতোই থাকবে) ---
const toTitleCase = (str: string) => str ? str.toLowerCase().split(' ').map(w => w.charAt(0).toUpperCase() + w.slice(1)).join(' ') : '';
const getFirst25Words = (text: string) => {
  if (!text) return "Experience world-class luxury in Gulshan.";
  const clean = text.replace(/<[^>]+>/g, ' ').trim();
  const words = clean.split(/\s+/);
  return words.length <= 25 ? words.join(' ') : words.slice(0, 25).join(' ') + '...';
};
const cleanPriceString = (p: string) => p ? (p.includes('$') ? `$${p.replace(/[^0-9.]/g, '')}` : `৳ ${p.replace(/[^0-9.]/g, '')}`) : 'Contact for Rates';

const hData = hotelItem?.data || {};
const hTitle = toTitleCase(hData.title || hData.name || "");
const hSlug = hData.slug || hotelItem?.slug || hotelItem?.id || "hotel";
const hotelUrl = `/${hSlug}`; 
const hImage = hData.image || hData.coverImage || (Array.isArray(hData.gallery) ? hData.gallery[0] : "");
const hFullAddress = hData.address || hData.location || "Gulshan, Dhaka";

// Pricing logic
const rawBasePrice = hData.price ? String(hData.price).trim() : "";
let lowestNum = 0, highestNum = 0;
if (Array.isArray(hData.booking_channels)) {
  hData.booking_channels.forEach((ch: any) => {
    const pNum = parseFloat(String(ch?.price || '').replace(/[^0-9.]/g, '')) || 0;
    if (pNum > 0) {
      if (lowestNum === 0 || pNum < lowestNum) lowestNum = pNum;
      if (pNum > highestNum) highestNum = pNum;
    }
  });
}
const displayPrice = lowestNum > 0 ? (rawBasePrice.includes('$') ? `$${lowestNum}` : `৳ ${lowestNum.toLocaleString()}`) : cleanPriceString(rawBasePrice);
let displayOriginalPrice = "";
let discountPercent = 0;
if (highestNum > lowestNum) {
  displayOriginalPrice = rawBasePrice.includes('$') ? `$${highestNum}` : `৳ ${highestNum.toLocaleString()}`;
  discountPercent = Math.round(((highestNum - lowestNum) / highestNum) * 100);
}

// Reviews logic (Sync with Hotel Page)
const searchSlug = hSlug.toLowerCase();
let rawReviewsList: any[] = [];
try {
  const rawGlob = import.meta.glob('../content/reviews/*.md', { eager: true });
  rawReviewsList = Object.values(rawGlob).map((item: any) => item.frontmatter || {});
} catch (e) {}

const approvedCmsReviews = rawReviewsList.filter(item => {
  if (!item || !item.approved) return false;
  const rSlug = (item.slug || item.hotelSlug || "").toLowerCase();
  return rSlug === searchSlug;
});
const allApprovedReviews = [...approvedCmsReviews, ...(hData.reviews || [])];
const realCount = allApprovedReviews.length;
const realRating = realCount > 0 ? (allApprovedReviews.reduce((sum, r) => sum + (Number(r.rating) || 5), 0) / realCount * 2).toFixed(1) : "10.0";
const latestReview = allApprovedReviews.length > 0 ? allApprovedReviews[0] : null;

const starCount = hData.starCategory?.includes('5') ? 5 : 4;
---

<div class="directory-card-item group bg-white rounded-[24px] sm:rounded-[32px] border border-slate-200 hover:border-slate-300 shadow-sm hover:shadow-xl transition-all duration-500 mb-6 overflow-hidden">
  
  <!-- গ্রিড লেআউট: মোবাইলে ১ কলাম, ডেক্সটপে ৩ কলাম (Image | Info | Price) -->
  <div class="flex flex-col md:grid md:grid-cols-[280px_1fr_240px] lg:grid-cols-[320px_1fr_260px] min-h-[200px]">
    
    <!-- ১. ইমেজ সেকশন -->
    <div class="relative w-full h-full min-h-[200px] md:min-h-0 bg-slate-100 border-b md:border-b-0 md:border-r border-slate-100 overflow-hidden">
      <CardImage image={hImage} title={hTitle} url={hotelUrl} price={displayPrice} />
    </div>

    <!-- ২. ইনফরমেশন সেকশন -->
    <div class="p-4 sm:p-6 flex flex-col justify-center min-w-0">
      <CardInfo 
        title={hTitle} 
        url={hotelUrl} 
        stars={starCount} 
        address={hFullAddress} 
        latestReview={latestReview} 
        fallbackAbout={getFirst25Words(hData.about)} 
        rating={realRating} 
        reviewsCount={realCount} 
        amenities={hData.amenities || []}
      />
    </div>

    <!-- ৩. প্রাইসিং সেকশন -->
    <div class="p-4 sm:p-6 bg-slate-50/50 md:bg-white md:border-l border-slate-100 flex flex-col justify-center shrink-0">
      <CardPricing 
        displayPrice={displayPrice} 
        displayOriginalPrice={displayOriginalPrice} 
        discountPercent={discountPercent} 
        title={hTitle} 
      />
    </div>

  </div>
</div>

<style is:global>
  .directory-card-item { font-family: 'Plus Jakarta Sans', sans-serif; }
</style>
