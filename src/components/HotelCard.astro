---
interface Props {
  hotelItem: any;
  allCmsReviews?: any[];
}

const { hotelItem, allCmsReviews = [] } = Astro.props;

// ================= HELPERS =================
const toTitleCase = (str: string) => {
  if (!str) return '';
  return str.toLowerCase().split(' ').filter(Boolean).map(w => w.charAt(0).toUpperCase() + w.slice(1)).join(' ');
};

const getFirst25Words = (text: string): string => {
  if (!text || typeof text !== 'string') {
    return "Experience world-class luxury suites, exceptional hospitality, fine dining, and prime comfort in the heart of Gulshan, Dhaka.";
  }
  const clean = text.replace(/<[^>]+>/g, ' ').replace(/[#*`_~]/g, '').trim();
  const words = clean.split(/\s+/).filter(Boolean);
  if (words.length <= 25) return words.join(' ');
  return words.slice(0, 25).join(' ') + '...';
};

const cleanPriceString = (priceRaw: string) => {
  if (!priceRaw) return 'Contact for Rates';
  const clean = String(priceRaw).replace(/night/gi, '').replace(/\//g, '').trim();
  const digits = clean.replace(/[^0-9.,]/g, '').trim();
  if (!digits) return 'Contact for Rates';
  if (clean.includes('$')) return `$${digits}`;
  return `৳ ${digits}`;
};

const svgMap = {
  locationPin: `<svg class="w-4 h-4 fill-slate-600 shrink-0 mt-0.5" viewBox="0 0 24 24"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5-2.5 2.5 2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>`
};

// ================= DATA EXTRACTION =================
const hData = hotelItem?.data || {};
const rawTitle = String(hData.title || hData.name || "").trim();
const hTitle = toTitleCase(rawTitle);

const hSlug = String(hData.slug || hotelItem?.slug || hotelItem?.id || "").trim();
const hotelUrl = `/${hSlug}`; 

const rawImg = 
  hData.image || 
  hData.coverImage || 
  hData.featuredImage || 
  hData.thumbnail || 
  (Array.isArray(hData.gallery) ? hData.gallery[0] : null) || 
  (Array.isArray(hData.images) ? hData.images[0] : null) || 
  "";

const hImage = typeof rawImg === 'object' && rawImg !== null && rawImg.src 
  ? rawImg.src 
  : (typeof rawImg === 'string' ? rawImg : "");

const hFullAddress = String(hData.address || hData.location || hData.category || "Gulshan, Dhaka").trim();
const locLower = hFullAddress.toLowerCase();
const titleLowerStr = rawTitle.toLowerCase();
const catLower = String(hData.category || '').toLowerCase();

let areaType = 'near';
if (locLower.includes('gulshan 1') || locLower.includes('gulshan-1') || locLower.includes('gulshan1')) {
  areaType = 'gulshan-1';
} else if (locLower.includes('gulshan 2') || locLower.includes('gulshan-2') || locLower.includes('gulshan2')) {
  areaType = 'gulshan-2';
} else {
  areaType = 'near';
}

const isGuestHouse = locLower.includes('guest house') || locLower.includes('guesthouse') || titleLowerStr.includes('guest house') || titleLowerStr.includes('guesthouse') || catLower.includes('guest house');

const rawAbout = hotelItem?.body || hData.about || hData.description || '';
const hSnippet25Words = getFirst25Words(rawAbout);
const amenitiesStr = JSON.stringify(hData.amenities || []).toLowerCase();

// Safe Fast Pricing
const rawBasePrice = hData.price ? String(hData.price).trim() : "";
const officialBaseStartingPrice = cleanPriceString(rawBasePrice);

const rawDigits = parseFloat(rawBasePrice.replace(/[^0-9.]/g, '')) || 0;
const isDollar = rawBasePrice.includes('$');
let numericPrice = isDollar ? Math.round(rawDigits * 120) : rawDigits;

let lowestNum = rawDigits;
let highestNum = rawDigits;

if (Array.isArray(hData.booking_channels)) {
  hData.booking_channels.forEach((ch: any) => {
    const pStr = String(ch?.price || '');
    const pNum = parseFloat(pStr.replace(/[^0-9.]/g, '')) || 0;
    if (pNum > 0) {
      if (lowestNum === 0 || pNum < lowestNum) lowestNum = pNum;
      if (pNum > highestNum) highestNum = pNum;
    }
  });
}

const displayPrice = lowestNum > 0 ? (isDollar ? `$${lowestNum}` : `৳ ${lowestNum.toLocaleString()}`) : officialBaseStartingPrice;
let displayOriginalPrice = "";
let discountPercent = 0;

if (highestNum > lowestNum && lowestNum > 0) {
  displayOriginalPrice = isDollar ? `$${highestNum}` : `৳ ${highestNum.toLocaleString()}`;
  discountPercent = Math.round(((highestNum - lowestNum) / highestNum) * 100);
}

const rawCat = String(hData.starCategory || hData.category || '').toLowerCase();
const starCount = rawCat.includes('5') ? 5 : (rawCat.includes('4') ? 4 : (rawCat.includes('3') ? 3 : 0));
const hTitleLower = rawTitle.toLowerCase();
const hSlugLower = hSlug.toLowerCase();

// Reviews
const matchedCmsReviews = allCmsReviews.filter(r => {
  if (!r) return false;
  const isApproved = r.approved === true || String(r.approved).toLowerCase() === 'true';
  if (!isApproved) return false;
  const rHotel = String(r.hotel || '').trim().toLowerCase();
  const rSlug = String(r.slug || r.hotelSlug || '').trim().toLowerCase();
  return (rSlug && rSlug === hSlugLower) || (rHotel && rHotel === hTitleLower);
});

const embedded = Array.isArray(hData.reviews) ? hData.reviews : [];
const finalReviewsList = matchedCmsReviews.length > 0 ? matchedCmsReviews : embedded;
const realCount = finalReviewsList.length;
let realRating: string | null = null;

if (realCount > 0) {
  const totalStars = finalReviewsList.reduce((sum: number, r: any) => {
    const num = parseFloat(r.rating);
    return sum + (!isNaN(num) && num > 0 && num <= 5 ? num : 5);
  }, 0);
  const avg = totalStars / realCount;
  realRating = (avg * 2).toFixed(1);
}

const numRating = parseFloat(realRating || '0');
let ratingLabel = 'Wonderful';
if (numRating < 9.0 && numRating >= 8.0) ratingLabel = 'Very Good';
else if (numRating < 8.0 && numRating > 0) ratingLabel = 'Good';

const hasValidTitle = hTitle.length > 0;
---

{hasValidTitle && (
  <div 
    class="directory-card-item bg-white rounded-xl border border-slate-200/90 hover:border-slate-300 shadow-2xs hover:shadow-md transition duration-150 text-left relative flex flex-row overflow-hidden min-h-[145px] sm:min-h-[175px] md:min-h-[195px] mb-3"
    data-title={hTitleLower}
    data-stars={starCount.toString()}
    data-area={areaType}
    data-guesthouse={isGuestHouse ? 'true' : 'false'}
    data-amenities={amenitiesStr}
    data-numeric-price={numericPrice}
    data-numeric-rating={numRating}
    data-official-price={officialBaseStartingPrice}
    data-whatsapp={hData.whatsapp || ''}
    data-phone={hData.phone || ''}
  >
    <!-- ================= 1ST COLUMN: HOTEL PHOTO ================= -->
    <div class="card-img-box relative w-32 sm:w-48 md:w-56 lg:w-64 shrink-0 bg-slate-100 self-stretch overflow-hidden">
      {hImage ? (
        <img 
          src={hImage} 
          alt={`${hTitle} Photo`} 
          loading="lazy" 
          decoding="async" 
          class="absolute inset-0 w-full h-full object-cover hover:scale-105 transition duration-500" 
        />
      ) : (
        <div class="absolute inset-0 w-full h-full flex items-center justify-center bg-slate-100 text-slate-400 text-xs font-bold">
          Hotel Photo
        </div>
      )}

      <!-- Wishlist Button -->
      <button 
        type="button"
        class="card-wishlist-btn absolute top-2 right-2 w-7 h-7 sm:w-8 sm:h-8 rounded-full bg-white/90 hover:bg-white text-slate-800 flex items-center justify-center shadow transition cursor-pointer hover:scale-110 z-20"
        data-title={hTitle}
        data-image={hImage}
        data-url={hotelUrl}
        data-price={displayPrice}
        aria-label="Save to Wishlist"
        onclick="event.stopPropagation();"
      >
        <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4 text-slate-700 transition" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path>
        </svg>
      </button>
    </div>

    <!-- ================= 2ND & 3RD COLUMN WRAPPER ================= -->
    <div class="flex-1 flex flex-col md:flex-row justify-between min-w-0 p-3 sm:p-3.5 md:p-4 gap-2 md:gap-0">
      
      <!-- ================= 2ND COLUMN: DETAILS ================= -->
      <div class="flex-1 flex flex-col justify-between min-w-0 pr-1 md:pr-3">
        <div>
          <!-- Title & Stars -->
          <div class="flex items-center gap-1.5 flex-wrap">
            {/* ✏️ ১. হোটেলের টাইটেল সাইজ (text-sm sm:text-lg md:text-xl) */}
            <a href={hotelUrl} class="card-hotel-link text-sm sm:text-lg md:text-xl font-extrabold text-[#006ce4] hover:text-[#003b95] hover:underline transition line-clamp-1 sm:line-clamp-none leading-snug">
              {hTitle}
            </a>
            
            {/* ✏️ ২. স্টারের সাইজ (text-xs sm:text-sm md:text-base) */}
            {starCount > 0 && (
              <span class="text-[#febb02] text-xs sm:text-sm md:text-base tracking-tight shrink-0">
                {'★'.repeat(starCount)}
              </span>
            )}
          </div>

          <!-- Address -->
          {/* ✏️ ৩. অ্যাড্রেস বা ঠিকানার সাইজ (text-xs sm:text-sm) */}
          <div class="flex items-start gap-1.5 text-xs sm:text-sm text-slate-600 font-medium mt-1 sm:mt-1.5 leading-snug">
            <span set:html={svgMap.locationPin} class="inline-flex shrink-0"></span>
            <span class="card-hotel-address hover:underline cursor-pointer line-clamp-1">{hFullAddress}</span>
          </div>

          <!-- Description -->
          {/* ✏️ ৪. ডেসক্রিপশন বা বর্ণনার সাইজ (text-xs sm:text-sm) */}
          <p class="text-xs sm:text-sm text-slate-600 mt-2 sm:mt-2.5 leading-relaxed line-clamp-2 md:line-clamp-3 hidden sm:block">
            {hSnippet25Words}
          </p>
        </div>

        <!-- Mobile Inline Review Score Badge -->
        <div class="md:hidden flex items-center gap-1.5 mt-1.5">
          {realRating ? (
            <>
              <div class="bg-[#003b95] text-white font-bold text-xs px-2 py-0.5 rounded leading-none shadow-2xs">
                {realRating}
              </div>
              <span class="text-xs font-bold text-slate-800">{ratingLabel}</span>
              <span class="text-[11px] text-slate-500">({realCount})</span>
            </>
          ) : (
            <span class="bg-slate-100 text-slate-600 text-[10px] font-bold px-2 py-0.5 rounded">
              New to site
            </span>
          )}
        </div>
      </div>

      <!-- ================= 3RD COLUMN: PRICING & BOOKING ================= -->
      <div class="w-full md:w-48 lg:w-56 shrink-0 md:border-l md:border-slate-100 md:pl-4 pt-2 md:pt-0 border-t md:border-t-0 border-slate-100 flex flex-row md:flex-col justify-between items-center md:items-end text-left md:text-right gap-2">
        
        <!-- Desktop Review Score -->
        <div class="w-full hidden md:flex justify-end">
          {realRating ? (
            <div class="flex items-center gap-2">
              <div class="text-right hidden sm:block">
                {/* ✏️ ৫. রিভিউ লেবেল সাইজ (text-xs sm:text-sm) */}
                <div class="text-xs sm:text-sm font-bold text-slate-900 leading-tight">{ratingLabel}</div>
                {/* ✏️ ৬. রিভিউ কাউন্ট সাইজ (text-[11px] sm:text-xs) */}
                <div class="text-[11px] sm:text-xs text-slate-500 leading-tight">{realCount} reviews</div>
              </div>
              {/* ✏️ ৭. রিভিউ স্কোরের নীল বক্সের সাইজ (text-sm sm:text-base) */}
              <div class="bg-[#003b95] text-white font-black text-sm sm:text-base px-2.5 py-1.5 rounded-t-lg rounded-br-lg leading-none shadow-2xs">
                {realRating}
              </div>
            </div>
          ) : (
            <div class="bg-slate-100 text-slate-600 text-xs font-bold px-2.5 py-1 rounded">
              New to site
            </div>
          )}
        </div>

        <!-- Price Info (Agoda Style) -->
        <div class="text-left md:text-right">
          {displayOriginalPrice && (
            <div class="flex items-center gap-1.5 justify-start md:justify-end leading-none mb-1">
              {/* ✏️ ৮. পুরোনো কাটা দামের সাইজ (text-xs sm:text-sm) */}
              <span class="text-xs sm:text-sm text-slate-400 line-through font-semibold">
                {displayOriginalPrice}
              </span>
              {/* ✏️ ৯. পার্সেন্টেজ ছাড়ের সাইজ (text-[10px] sm:text-xs) */}
              {discountPercent > 0 && (
                <span class="text-[10px] sm:text-xs font-black text-[#e52429] bg-rose-50 border border-rose-200/80 px-1.5 py-0.5 rounded leading-none">
                  -{discountPercent}%
                </span>
              )}
            </div>
          )}

          {/* ✏️ ১০. মূল সবুজ প্রাইস সাইজ (text-lg sm:text-2xl md:text-3xl) - অ্যাগোডার মতো বড় */}
          <span class="card-final-price text-lg sm:text-2xl md:text-3xl font-black text-[#008234] block leading-tight my-0.5">
            {displayPrice}
          </span>
          
          {/* ✏️ ১১. প্রাইসের নিচের 'Best rate found' সাইজ (text-[10px] sm:text-xs) */}
          <span class="text-[10px] sm:text-xs text-slate-500 font-medium block leading-tight">
            Best rate found
          </span>
        </div>

        <!-- Quick View Action Button -->
        {/* ✏️ ১২. কুইক ভিউ বাটনের লেখার সাইজ (text-xs sm:text-sm) */}
        <button 
          type="button" 
          class="open-quick-view-btn w-auto md:w-full bg-[#006ce4] hover:bg-[#0057b8] text-white text-xs sm:text-sm font-bold py-2 sm:py-2.5 px-3.5 rounded-lg sm:rounded-xl transition inline-flex items-center justify-center gap-1.5 shadow-xs hover:shadow cursor-pointer whitespace-nowrap text-center active:scale-95"
          aria-label={`Quick view of ${hTitle}`}
        >
          <svg class="w-4 h-4 shrink-0 fill-current opacity-90" viewBox="0 0 24 24">
            <path d="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"/>
          </svg>
          <span>Quick View</span>
        </button>

      </div>

    </div>
  </div>
)}

<style is:global>
  body, main {
    background-color: #ffffff !important;
  }
  .directory-card-item {
    margin-bottom: 12px !important;
    margin-top: 0 !important;
  }
  .directory-card-item:empty,
  .directory-card-item[data-title=""] {
    display: none !important;
  }
</style>
