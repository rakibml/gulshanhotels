---
// src/components/directory/DirectoryCard.astro
import CardImage from './card/CardImage.astro';
import CardInfo from './card/CardInfo.astro';
import CardPricing from './card/CardPricing.astro';

interface Props {
  hotelItem: any;
  allCmsReviews?: any[];
}

const { hotelItem, allCmsReviews = [] } = Astro.props;

// --- ১. হেল্পার ফাংশনসমূহ ---
const toTitleCase = (str: string) => str ? str.toLowerCase().split(' ').map(w => w.charAt(0).toUpperCase() + w.slice(1)).join(' ') : '';
const getFirst25Words = (text: string) => {
  if (!text) return "Experience world-class luxury and comfort in Gulshan.";
  const clean = text.replace(/<[^>]+>/g, ' ').replace(/[#*`_~]/g, '').trim();
  const words = clean.split(/\s+/);
  return words.length <= 25 ? words.join(' ') : words.slice(0, 25).join(' ') + '...';
};

// --- ২. হোটেলের তথ্য নিষ্কাশন ---
const hData = hotelItem?.data || {};
const hotelTitle = (hData.title || hData.name || "Hotel Details").trim();
const hotelSlug = (hData.slug || hotelItem?.slug || hotelItem?.id || "hotel").trim();

const hTitle = toTitleCase(hotelTitle);
const hSlug = hotelSlug;
const hotelUrl = `/${hSlug}`; 

const rawImg = hData.image || hData.coverImage || (Array.isArray(hData.gallery) ? hData.gallery[0] : "");
const hImage = typeof rawImg === 'object' && rawImg !== null && rawImg.src ? rawImg.src : (typeof rawImg === 'string' ? rawImg : "");

const hFullAddress = String(hData.address || hData.location || "Gulshan, Dhaka").trim();
const locLower = hFullAddress.toLowerCase();
const titleLowerStr = hotelTitle.toLowerCase();

// --- ৩. ফিল্টার ডাটা সেট করা ---
let areaType = 'near';
if (locLower.includes('gulshan 1') || locLower.includes('gulshan-1')) areaType = 'gulshan-1';
else if (locLower.includes('gulshan 2') || locLower.includes('gulshan-2')) areaType = 'gulshan-2';

const rawCat = String(hData.starCategory || hData.category || '').toLowerCase();
const starCount = rawCat.includes('5') ? 5 : (rawCat.includes('4') ? 4 : 3);
const isGuestHouse = locLower.includes('guest house') || locLower.includes('guesthouse') || titleLowerStr.includes('guest house');

// --- ৪. প্রাইসিং লজিক (নিখুঁত টাকার ক্যালকুলেশন) ---
const rawBasePrice = hData.price ? String(hData.price).trim() : "";
const isDollar = rawBasePrice.includes('$');

// বেজ প্রাইস থেকে সংখ্যা বের করা
const baseDigits = parseFloat(rawBasePrice.replace(/[^0-9.]/g, '')) || 0;

let lowestNum = 0, highestNum = 0;
if (Array.isArray(hData.booking_channels)) {
  hData.booking_channels.forEach((ch: any) => {
    const pNum = parseFloat(String(ch?.price || '').replace(/[^0-9.]/g, ''));
    if (pNum > 0) {
      if (lowestNum === 0 || pNum < lowestNum) lowestNum = pNum;
      if (pNum > highestNum) highestNum = pNum;
    }
  });
}

// যদি বুকিং চ্যানেল না থাকে তবে বেজ প্রাইস ব্যবহার হবে
const finalLowest = lowestNum > 0 ? lowestNum : baseDigits;
const finalHighest = highestNum > lowestNum ? highestNum : 0;

// ডিসপ্লে প্রাইস তৈরি করা (পপুলার হোটেলের মতো)
const displayPrice = isDollar ? `$${finalLowest}` : `৳${finalLowest.toLocaleString()}`;
let displayOriginalPrice = "";
let discountPercent = 0;

if (finalHighest > finalLowest) {
  displayOriginalPrice = isDollar ? `$${finalHighest}` : `৳${finalHighest.toLocaleString()}`;
  discountPercent = Math.round(((finalHighest - finalLowest) / finalHighest) * 100);
}

// ফিল্টারের জন্য টাকার অংক (যদি ডলার হয় তবে ১২০ দিয়ে গুণ)
const filterPriceBDT = isDollar ? Math.round(finalLowest * 120) : finalLowest;

// --- ৫. রিভিউ লজিক (৫.০ স্কেলে) ---
const searchTitle = hotelTitle.toLowerCase();
const searchSlug = hotelSlug.toLowerCase();
let rawReviewsList: any[] = [];
try {
  const rawGlob = import.meta.glob('../content/reviews/*.md', { eager: true });
  rawReviewsList = Object.values(rawGlob).map((item: any) => item.frontmatter || {});
} catch (e) {}

const approvedCmsReviews = rawReviewsList.filter(item => {
  if (!item || !item.approved) return false;
  const rSlug = (item.slug || item.hotelSlug || "").toLowerCase();
  const rHotel = (item.hotel || "").toLowerCase();
  return (rSlug !== "" && rSlug === searchSlug) || (rHotel !== "" && rHotel === searchTitle);
});

const allApprovedReviews = [...approvedCmsReviews, ...(hData.reviews || [])];
const realCount = allApprovedReviews.length;
// ৫.০ স্কেলে রেটিং
const realRating = realCount > 0 ? (allApprovedReviews.reduce((sum, r) => sum + (Number(r.rating) || 5), 0) / realCount).toFixed(1) : "5.0";
const latestReview = allApprovedReviews.length > 0 ? allApprovedReviews[0] : null;

const hasValidTitle = hTitle.length > 0;
---

{hasValidTitle && (
  <div 
    class="directory-card-item group bg-white rounded-[24px] sm:rounded-[32px] border border-slate-200 hover:border-slate-300 shadow-sm hover:shadow-xl transition-all duration-500 mb-6 overflow-hidden"
    data-title={titleLowerStr}
    data-stars={starCount.toString()}
    data-area={areaType}
    data-guesthouse={isGuestHouse ? 'true' : 'false'}
    data-numeric-price={filterPriceBDT}
    data-numeric-rating={parseFloat(realRating)}
  >
    <div class="flex flex-col md:grid md:grid-cols-[280px_1fr_240px] lg:grid-cols-[320px_1fr_260px]">
      
      <!-- ১. ইমেজ মডিউল -->
      <div class="relative w-full h-full min-h-[220px] md:min-h-0 bg-slate-100 border-b md:border-b-0 md:border-r border-slate-100">
        <CardImage image={hImage} title={hTitle} url={hotelUrl} price={displayPrice} />
      </div>

      <!-- ২. ইনফরমেশন মডিউল -->
      <div class="p-5 sm:p-6 flex flex-col justify-center min-w-0">
        <CardInfo 
          title={hTitle} 
          url={hotelUrl} 
          stars={starCount} 
          address={hFullAddress} 
          latestReview={latestReview} 
          fallbackAbout={getFirst25Words(hData.about)} 
          rating={realRating} 
          reviewsCount={realCount} 
          amenities={hData.amenities || []}
        />
      </div>

      <!-- ৩. প্রাইসিং মডিউল -->
      <div class="p-5 sm:p-6 bg-slate-50/50 md:bg-white md:border-l border-slate-100 flex flex-col justify-center">
        <CardPricing 
          displayPrice={displayPrice} 
          displayOriginalPrice={displayOriginalPrice} 
          discountPercent={discountPercent} 
          title={hTitle} 
        />
      </div>

    </div>
  </div>
)}

<style is:global>
  .directory-card-item { font-family: 'Plus Jakarta Sans', sans-serif; }
</style>
