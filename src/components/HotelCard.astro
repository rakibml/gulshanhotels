---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import HotelCard from '../components/HotelCard.astro';
import QuickViewModal from '../components/QuickViewModal.astro';

// Fetch all hotels and reviews safely
let allHotels: any[] = [];
try {
  allHotels = await getCollection('hotels');
} catch (e) {
  allHotels = [];
}

let allCmsReviews: any[] = [];
try {
  allCmsReviews = await getCollection('reviews');
} catch (e) {
  allCmsReviews = [];
}

// খালি বা ড্রাফট ফাইল ফিল্টার (Ghost Card চিরতরে দূর করার জন্য)
const validHotels = allHotels.filter(hotel => {
  const d = hotel?.data || {};
  return (d.title || d.name || '').trim().length > 0;
});
---

<Layout title="Hotels in Gulshan, Dhaka - Best Rates & Deals">
  <!-- AGODA STYLE SOFT GRAY BACKGROUND (#f5f7fa) -->
  <main class="bg-[#f5f7fa] min-h-screen pb-16 text-slate-900">
    
    <!-- ================= STICKY SEARCH & FILTER BAR (TOP-0) ================= -->
    <header class="sticky top-0 z-30 bg-white border-b border-slate-200/90 shadow-xs">
      <div class="max-w-7xl mx-auto px-3 sm:px-4 lg:px-6 py-2.5 sm:py-3 flex items-center justify-between gap-2 sm:gap-4">
        
        <!-- Search Input -->
        <div class="relative flex-1 max-w-md">
          <input 
            type="text" 
            id="hotelSearchInput" 
            placeholder="Search hotel name, location..." 
            class="w-full bg-slate-100 hover:bg-slate-50 focus:bg-white text-xs sm:text-sm font-semibold rounded-xl pl-8 sm:pl-9 pr-3 py-2 border border-slate-200 focus:border-[#006ce4] focus:outline-none transition"
          />
          <svg class="w-4 h-4 text-slate-400 absolute left-2.5 top-1/2 -translate-y-1/2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
          </svg>
        </div>

        <!-- Quick Filters (Desktop) -->
        <div class="hidden md:flex items-center gap-2 text-xs font-bold text-slate-700">
          <button type="button" class="area-filter-btn px-3 py-1.5 rounded-lg border border-slate-200 bg-white hover:bg-slate-50 transition cursor-pointer active-filter" data-area="all">All Areas</button>
          <button type="button" class="area-filter-btn px-3 py-1.5 rounded-lg border border-slate-200 bg-white hover:bg-slate-50 transition cursor-pointer" data-area="gulshan-1">Gulshan 1</button>
          <button type="button" class="area-filter-btn px-3 py-1.5 rounded-lg border border-slate-200 bg-white hover:bg-slate-50 transition cursor-pointer" data-area="gulshan-2">Gulshan 2</button>
        </div>

        <!-- Mobile Filter Drawer Trigger Button -->
        <button 
          type="button" 
          id="openMobileDrawerBtn" 
          class="md:hidden flex items-center gap-1.5 bg-[#006ce4] text-white text-xs font-bold px-3 py-2 rounded-xl shadow-xs shrink-0 cursor-pointer"
        >
          <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M10 18h4v-2h-4v2zM3 6v2h18V6H3zm3 7h12v-2H6v2z"/></svg>
          <span>Filters</span>
        </button>

      </div>
    </header>

    <!-- ================= MAIN CONTENT LAYOUT ================= -->
    <div class="max-w-7xl mx-auto px-3 sm:px-4 lg:px-6 pt-4 sm:pt-6">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
        
        <!-- DESKTOP SIDEBAR FILTERS (LEFT COLUMN) -->
        <aside class="hidden lg:block lg:col-span-3 bg-white p-5 rounded-2xl border border-slate-200/90 shadow-2xs space-y-6 text-left sticky top-20">
          <div>
            <h4 class="text-sm font-black text-slate-900 mb-3">Filter by Stars</h4>
            <div class="space-y-2 text-xs font-bold text-slate-700">
              <label class="flex items-center gap-2 cursor-pointer">
                <input type="radio" name="starFilter" value="all" checked class="star-radio text-[#006ce4]" />
                <span>All Ratings</span>
              </label>
              <label class="flex items-center gap-2 cursor-pointer">
                <input type="radio" name="starFilter" value="5" class="star-radio text-[#006ce4]" />
                <span class="text-[#febb02]">★★★★★</span> <span>5 Stars</span>
              </label>
              <label class="flex items-center gap-2 cursor-pointer">
                <input type="radio" name="starFilter" value="4" class="star-radio text-[#006ce4]" />
                <span class="text-[#febb02]">★★★★</span> <span>4 Stars</span>
              </label>
              <label class="flex items-center gap-2 cursor-pointer">
                <input type="radio" name="starFilter" value="3" class="star-radio text-[#006ce4]" />
                <span class="text-[#febb02]">★★★</span> <span>3 Stars</span>
              </label>
            </div>
          </div>

          <!-- Price Budget Filter -->
          <div class="border-t border-slate-100 pt-5">
            <div class="flex items-center justify-between mb-2">
              <h4 class="text-sm font-black text-slate-900">Budget (BDT)</h4>
              <span id="priceDisplayVal" class="text-xs font-black text-[#008234]">All</span>
            </div>
            <input 
              type="range" 
              id="priceSlider" 
              min="2000" 
              max="35000" 
              step="500" 
              value="35000" 
              class="w-full accent-[#006ce4] cursor-pointer"
            />
            <div class="flex justify-between text-[10px] font-bold text-slate-400 mt-1">
              <span>৳ 2,000</span>
              <span>৳ 35,000+</span>
            </div>
          </div>
        </aside>

        <!-- HOTEL CARDS LISTING (RIGHT COLUMN) -->
        <section class="lg:col-span-9 space-y-3">
          
          <!-- Top Results Bar -->
          <div class="flex items-center justify-between bg-white px-4 py-3 rounded-xl border border-slate-200/80 shadow-2xs">
            <span id="propertiesFoundCount" class="text-xs sm:text-sm font-black text-slate-900">
              {validHotels.length} properties found
            </span>

            <!-- Sort By -->
            <div class="flex items-center gap-1.5 text-xs font-bold text-slate-600">
              <span>Sort:</span>
              <select id="hotelSortSelect" class="bg-slate-50 border border-slate-200 rounded-lg px-2 py-1 font-bold text-slate-800 text-xs focus:outline-none">
                <option value="featured">Featured First</option>
                <option value="price-asc">Price: Low to High</option>
                <option value="price-desc">Price: High to Low</option>
                <option value="rating-desc">Guest Rating: High to Low</option>
              </select>
            </div>
          </div>

          <!-- AGODA STYLE TIGHT GAP (gap-3 = 12px) -->
          <div id="hotelCardsContainer" class="flex flex-col gap-3">
            {validHotels.map(hotel => (
              <HotelCard hotelItem={hotel} allCmsReviews={allCmsReviews} />
            ))}
          </div>

          <!-- No Results Fallback -->
          <div id="noHotelsFoundBox" class="hidden bg-white rounded-2xl border border-slate-200 p-8 text-center space-y-2">
            <h4 class="text-base font-black text-slate-900">No properties matched your filters</h4>
            <p class="text-xs text-slate-500">Try adjusting your search keywords, star rating, or budget slider.</p>
          </div>

        </section>

      </div>
    </div>

    <!-- ================= MOBILE SLIDE-OVER FILTER DRAWER ================= -->
    <div id="mobileDrawerOverlay" class="fixed inset-0 z-50 bg-slate-950/70 backdrop-blur-xs hidden transition-opacity">
      <div class="fixed inset-y-0 right-0 max-w-xs w-full bg-white shadow-2xl p-5 flex flex-col justify-between">
        <div class="space-y-6 text-left">
          <div class="flex items-center justify-between border-b border-slate-100 pb-3">
            <h3 class="text-base font-black text-slate-900">Filter Hotels</h3>
            <button type="button" id="closeMobileDrawerBtn" class="text-2xl font-bold text-slate-400 p-1">&times;</button>
          </div>

          <div>
            <h4 class="text-xs font-black uppercase text-slate-400 mb-2">Area</h4>
            <div class="flex flex-wrap gap-1.5 text-xs font-bold">
              <button type="button" class="m-area-btn px-3 py-1.5 rounded-lg border border-slate-200 bg-slate-100" data-area="all">All</button>
              <button type="button" class="m-area-btn px-3 py-1.5 rounded-lg border border-slate-200" data-area="gulshan-1">Gulshan 1</button>
              <button type="button" class="m-area-btn px-3 py-1.5 rounded-lg border border-slate-200" data-area="gulshan-2">Gulshan 2</button>
            </div>
          </div>
        </div>

        <button type="button" id="applyMobileFiltersBtn" class="w-full bg-[#006ce4] text-white font-bold text-xs py-3 rounded-xl shadow">
          Apply Filters
        </button>
      </div>
    </div>

    <!-- ================= GLOBAL QUICK VIEW MODAL ================= -->
    <QuickViewModal />

  </main>
</Layout>

<!-- ================= CLIENT FILTERING & INTERACTIVITY SCRIPT ================= -->
<script is:inline>
  const initDirectoryPage = () => {
    const searchInput = document.getElementById('hotelSearchInput');
    const cards = Array.from(document.querySelectorAll('.directory-card-item'));
    const countEl = document.getElementById('propertiesFoundCount');
    const noResultsBox = document.getElementById('noHotelsFoundBox');
    const sortSelect = document.getElementById('hotelSortSelect');
    const cardsContainer = document.getElementById('hotelCardsContainer');
    const priceSlider = document.getElementById('priceSlider');
    const priceDisplayVal = document.getElementById('priceDisplayVal');

    let activeSearch = '';
    let activeArea = 'all';
    let activeStar = 'all';
    let maxBudget = 35000;

    // Filter Logic
    function applyFilters() {
      let visibleCount = 0;

      cards.forEach(card => {
        const title = card.getAttribute('data-title') || '';
        const area = card.getAttribute('data-area') || '';
        const stars = card.getAttribute('data-stars') || '0';
        const price = parseFloat(card.getAttribute('data-numeric-price') || '0');

        const matchesSearch = !activeSearch || title.includes(activeSearch);
        const matchesArea = activeArea === 'all' || area === activeArea;
        const matchesStar = activeStar === 'all' || stars === activeStar;
        const matchesPrice = maxBudget >= 35000 || price <= maxBudget;

        if (matchesSearch && matchesArea && matchesStar && matchesPrice) {
          card.classList.remove('hidden');
          card.style.display = 'flex';
          visibleCount++;
        } else {
          card.classList.add('hidden');
          card.style.display = 'none';
        }
      });

      if (countEl) countEl.textContent = `${visibleCount} properties found`;
      if (noResultsBox) {
        if (visibleCount === 0) noResultsBox.classList.remove('hidden');
        else noResultsBox.classList.add('hidden');
      }
    }

    // Search Input
    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        activeSearch = (e.target.value || '').trim().toLowerCase();
        applyFilters();
      });
    }

    // Area Buttons
    document.querySelectorAll('.area-filter-btn, .m-area-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        activeArea = btn.getAttribute('data-area') || 'all';
        document.querySelectorAll('.area-filter-btn').forEach(b => b.classList.remove('bg-[#006ce4]', 'text-white'));
        btn.classList.add('bg-[#006ce4]', 'text-white');
        applyFilters();
      });
    });

    // Star Radios
    document.querySelectorAll('.star-radio').forEach(radio => {
      radio.addEventListener('change', (e) => {
        activeStar = e.target.value;
        applyFilters();
      });
    });

    // Price Slider
    if (priceSlider) {
      priceSlider.addEventListener('input', (e) => {
        maxBudget = parseFloat(e.target.value);
        if (priceDisplayVal) {
          priceDisplayVal.textContent = maxBudget >= 35000 ? 'All' : `≤ ৳ ${maxBudget.toLocaleString()}`;
        }
        applyFilters();
      });
    }

    // Sorting
    if (sortSelect && cardsContainer) {
      sortSelect.addEventListener('change', (e) => {
        const val = e.target.value;
        const sorted = [...cards].sort((a, b) => {
          const priceA = parseFloat(a.getAttribute('data-numeric-price') || '0');
          const priceB = parseFloat(b.getAttribute('data-numeric-price') || '0');
          const ratingA = parseFloat(a.getAttribute('data-numeric-rating') || '0');
          const ratingB = parseFloat(b.getAttribute('data-numeric-rating') || '0');

          if (val === 'price-asc') return priceA - priceB;
          if (val === 'price-desc') return priceB - priceA;
          if (val === 'rating-desc') return ratingB - ratingA;
          return 0;
        });

        sorted.forEach(c => cardsContainer.appendChild(c));
      });
    }

    // Mobile Drawer Logic
    const drawerOverlay = document.getElementById('mobileDrawerOverlay');
    const openDrawerBtn = document.getElementById('openMobileDrawerBtn');
    const closeDrawerBtn = document.getElementById('closeMobileDrawerBtn');
    const applyDrawerBtn = document.getElementById('applyMobileFiltersBtn');

    if (openDrawerBtn && drawerOverlay) {
      openDrawerBtn.addEventListener('click', () => drawerOverlay.classList.remove('hidden'));
    }
    if (closeDrawerBtn && drawerOverlay) {
      closeDrawerBtn.addEventListener('click', () => drawerOverlay.classList.add('hidden'));
    }
    if (applyDrawerBtn && drawerOverlay) {
      applyDrawerBtn.addEventListener('click', () => drawerOverlay.classList.add('hidden'));
    }
  };

  document.addEventListener('DOMContentLoaded', initDirectoryPage);
  document.addEventListener('astro:page-load', initDirectoryPage);
</script>
