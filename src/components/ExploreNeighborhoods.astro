---
// src/components/RecentGuestReviews.astro (100% Genuine Reviews, Zero Rating Inflation & WCAG Accessible)
import { getCollection } from 'astro:content';

interface Props {
  title?: string;
  subtitle?: string;
}

const { 
  title = "Recent Guest Feedback", 
  subtitle = "Real ratings and experiences from verified travelers staying across Gulshan."
} = Astro.props;

const isProd = import.meta.env.PROD;

// ১. ড্রাফট ফিল্টারসহ হোটেল লোডার (গুগলে ৪০৪ এরর বন্ধ)
let allHotels: any[] = [];
try {
  const hotelCol = await getCollection('hotels', ({ data }) => {
    return isProd ? data?.draft !== true : true;
  });
  if (Array.isArray(hotelCol) && hotelCol.length > 0) {
    allHotels = hotelCol.map(h => ({
      id: h.id,
      slug: (h.slug || h.id || '').replace(/\.(md|mdx)$/, '').split('/').pop()?.toLowerCase(),
      data: h.data || {}
    }));
  }
} catch (e) {
  allHotels = [];
}

if (allHotels.length === 0) {
  try {
    const rawGlobHotels = import.meta.glob(['/src/content/hotels/*.{md,mdx}', '../content/hotels/*.{md,mdx}'], { eager: true });
    allHotels = Object.entries(rawGlobHotels)
      .filter(([_, item]: [string, any]) => (isProd ? item?.frontmatter?.draft !== true : true))
      .map(([filePath, item]: [string, any]) => ({
        id: filePath.split('/').pop()?.replace(/\.(md|mdx)$/, ''),
        slug: filePath.split('/').pop()?.replace(/\.(md|mdx)$/, '')?.toLowerCase(),
        data: item?.frontmatter || item?.data || {}
      }));
  } catch (e) {
    allHotels = [];
  }
}

// ২. সব রিভিউ ডাটা লোডার
let allReviews: any[] = [];
try {
  const rawGlobReviews = import.meta.glob(['/src/content/reviews/*.{md,mdx}', '../content/reviews/*.{md,mdx}'], { eager: true });
  allReviews = Object.entries(rawGlobReviews).map(([filePath, item]: [string, any]) => ({
    ...(item?.frontmatter || item?.data || item || {}),
    _fileName: filePath.split('/').pop() || ''
  }));
} catch (e) {
  allReviews = [];
}

// ৩. হোটেলের লোকাল রিভিউ মার্জ (সৎভাবে শুধু অনুমোদিত রিভিউ নেওয়া)
allHotels.forEach((h: any) => {
  const hData = h.data || {};
  const embedded = Array.isArray(hData.reviews) ? hData.reviews : [];
  const hSlug = String(h.slug || hData.slug || h.id || '').toLowerCase();
  
  embedded.forEach((rev: any) => {
    // অনুমোদিত না হলে যোগ হবে না
    if (rev && (rev.approved === undefined || rev.approved === true || String(rev.approved).toLowerCase() === 'true')) {
      allReviews.push({
        ...rev,
        hotel: rev.hotel || hData.title || hData.name || '',
        slug: hSlug,
        approved: true
      });
    }
  });
});

// ৪. কড়া ফিল্টারিং (গুগল স্প্যাম রোধ: নূন্যতম ১০ অক্ষর এবং ১-৫ ভ্যালিড রেটিং)
const approvedReviews = allReviews.filter((r: any) => {
  if (!r) return false;
  const isApproved = r.approved === true || String(r.approved).trim().toLowerCase() === 'true';
  const comment = String(r.comment || r.review || r.body || '').trim();
  const rating = Number(r.rating);
  
  // কোনো ভুয়া বা মিসিং রেটিং চলবে না
  return isApproved && comment.length >= 10 && !isNaN(rating) && rating >= 1 && rating <= 5;
});

// ৫. তারিখ পার্সার হেল্পার
const parseReviewDateToTime = (rev: any) => {
  const dStr = rev.date;
  if (dStr && dStr !== 'Recent' && dStr !== 'Recent Stay') {
    const cleanStr = String(dStr).replace(' at ', ' ').trim();
    const time = new Date(cleanStr).getTime();
    if (!isNaN(time) && time > 0) return time;
  }
  if (rev._fileName) {
    const fileMatch = String(rev._fileName).match(/^(\d{4}-\d{2}-\d{2})/);
    if (fileMatch) {
      const fTime = new Date(fileMatch[1]).getTime();
      if (!isNaN(fTime)) return fTime;
    }
  }
  return 0;
};

// ৬. Newest-First সর্টিং (সর্বশেষ রিভিউ আগে)
const sortedReviews = approvedReviews.sort((a, b) => {
  return parseReviewDateToTime(b) - parseReviewDateToTime(a);
});

// ৭. ডেটা এনরিচমেন্ট এবং মিসিং হোটেলের রিভিউ বাদ দেওয়া
const enrichedReviews = sortedReviews.map((rev: any) => {
  const rSlug = String(rev.slug || rev.hotelSlug || rev.id || '').replace(/\.(md|mdx)$/, '').split('/').pop()?.toLowerCase() || '';
  const rHotel = String(rev.hotel || '').trim().toLowerCase();

  const matchedHotel = allHotels.find((h: any) => {
    const hSlug = String(h.slug || h.data?.slug || h.id || '').toLowerCase();
    const hTitle = String(h.data?.title || h.data?.name || '').trim().toLowerCase();
    return (rSlug !== '' && hSlug === rSlug) || (rHotel !== '' && (hTitle === rHotel || hSlug === rHotel));
  });

  // লাইভ হোটেলের অস্তিত্ব না থাকলে রিভিউ বাতিল
  if (!matchedHotel) return null;

  const hData = matchedHotel.data || {};
  const hotelTitle = String(hData.title || hData.name || "").trim();
  const hotelSlug = String(matchedHotel.slug || hData.slug || "").toLowerCase();
  const cleanDate = String(rev.date || 'Recent').replace(/\s+at\s+.*$/i, '').trim();

  return {
    reviewerName: String(rev.name || rev.author || "Guest Reviewer").trim(),
    date: cleanDate,
    rating: Math.round(Number(rev.rating)), // কোনো ভুয়া ৫ স্টার নয়, আসল রেটিং
    comment: String(rev.comment || rev.review || rev.body || '').trim(),
    hotelTitle,
    hotelSlug
  };
}).filter((item): item is NonNullable<typeof item> => item !== null && item.hotelSlug !== "").slice(0, 4);

const hasReviews = enrichedReviews.length > 0;
const starsArray = [1, 2, 3, 4, 5];
---

{hasReviews && (
  <section id="recent-reviews" class="w-full bg-white py-12 text-slate-900 border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-0 space-y-6">
      
      <!-- Section Header -->
      <div class="space-y-1 text-left border-b border-slate-100 pb-4">
        <h2 class="text-2xl sm:text-3xl lg:text-4xl font-sans font-black text-slate-900 tracking-tight leading-tight">
          {title}
        </h2>
        <p class="text-xs sm:text-sm text-slate-500 font-medium">
          {subtitle}
        </p>
      </div>

      <!-- 2-COLS MOBILE & 4-COLS DESKTOP GRID -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6 text-left">
        {enrichedReviews.map((item) => (
          <div class="group flex flex-col justify-between bg-slate-50/80 hover:bg-white rounded-2xl sm:rounded-3xl border border-slate-200 hover:border-emerald-600/40 hover:shadow-lg transition-all duration-300 p-4 sm:p-5">
            
            <div class="space-y-3">
              
              <!-- ১. টপ বার: অ্যাক্সেসিবল স্টার রেটিং এবং হোটেলের ক্যানোনিকাল লিংক -->
              <div class="flex items-start justify-between gap-2">
                <!-- স্ক্রিন রিডার ও গুগলের জন্য role="img" এবং aria-label যুক্ত -->
                <div class="flex items-center gap-0.5 shrink-0 pt-0.5" role="img" aria-label={`Rated ${item.rating} out of 5 stars`}>
                  {starsArray.map(s => (
                    <svg aria-hidden="true" class={`w-3.5 h-3.5 shrink-0 ${s <= item.rating ? 'fill-amber-400' : 'fill-slate-200'}`} viewBox="0 0 24 24">
                      <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/>
                    </svg>
                  ))}
                </div>

                <!-- ক্যানোনিকাল স্ল্যাশযুক্ত হোটেলের নাম -->
                <a 
                  href={`/${item.hotelSlug}/`} 
                  class="text-xs font-black uppercase tracking-wider text-slate-800 hover:text-emerald-800 hover:underline transition-colors text-right leading-tight truncate max-w-[150px]"
                  title={item.hotelTitle}
                >
                  {item.hotelTitle}
                </a>
              </div>

              <!-- ২. কাস্টমারের আসল রিভিউ কমেন্ট -->
              <p class="text-xs sm:text-sm text-slate-700 italic font-normal line-clamp-4 leading-relaxed min-h-[64px]">
                "{item.comment}"
              </p>

            </div>

            <!-- ৩. ফুটার: কাস্টমারের নাম, তারিখ এবং অ্যাক্সেসিবল হোটেল লিংক -->
            <div class="pt-3.5 mt-3 border-t border-slate-200/80 flex items-center justify-between text-xs">
              
              <div class="flex items-center gap-2 min-w-0">
                <div class="w-7 h-7 rounded-full bg-white text-emerald-900 font-black text-xs flex items-center justify-center shrink-0 uppercase border border-slate-200 shadow-2xs">
                  {item.reviewerName.charAt(0)}
                </div>
                <div class="min-w-0">
                  <span class="text-xs font-bold text-slate-900 truncate block leading-tight">
                    {item.reviewerName}
                  </span>
                  <span class="text-[11px] text-slate-500 font-medium block truncate mt-0.5">
                    {item.date}
                  </span>
                </div>
              </div>

              <!-- সঠিক ক্যানোনিকাল লিংক ও অ্যাক্সেসিবল বাটন -->
              <a 
                href={`/${item.hotelSlug}/`} 
                class="shrink-0 text-emerald-800 font-black text-xs hover:underline flex items-center gap-1 pl-1"
                aria-label={`View details of ${item.hotelTitle}`}
              >
                <span>View</span>
                <span aria-hidden="true">➔</span>
              </a>

            </div>

          </div>
        ))}
      </div>

    </div>
  </section>
)}
