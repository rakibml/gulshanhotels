---

<!-- HOTELS.COM STYLE LIFESTYLE SECTION -->
<section id="stay-styles" class="w-full bg-white pt-8 pb-14 text-slate-900">
  <div class="max-w-[1550px] mx-auto px-4 sm:px-8 lg:px-12 space-y-6">
    
    <!-- Section Title & Subtitle (Hotels.com Serif Style) -->
    <div class="space-y-1 text-left">
      <h2 class="text-3xl sm:text-4xl lg:text-[40px] font-serif font-black text-slate-900 tracking-tight leading-tight">
        {title}
      </h2>
      <p class="text-xs sm:text-sm text-slate-500 font-medium">
        {subtitle}
      </p>
    </div>

    <!-- Category Tabs with Underline Indicator -->
    <div class="flex items-center gap-6 sm:gap-8 border-b border-slate-200 overflow-x-auto scroll-smooth [scrollbar-width:none] [-ms-overflow-style:none] [&::-webkit-scrollbar]:hidden">
      {styleCategories.map((cat, idx) => (
        <button
          type="button"
          data-tab-target={cat.id}
          class={`stay-tab-btn pb-3 text-xs sm:text-sm font-bold tracking-tight whitespace-nowrap transition-all cursor-pointer border-b-2 -mb-[1px] ${idx === 0 ? 'border-slate-900 text-slate-900' : 'border-transparent text-slate-500 hover:text-slate-900'}`}
        >
          {cat.name}
        </button>
      ))}
    </div>

    <!-- Category Hotel Groups -->
    <div id="stayTabContentContainer" class="text-left">
      {styleCategories.map((cat, idx) => (
        <div 
          id={`tab-panel-${cat.id}`} 
          class={`stay-tab-panel grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 ${idx === 0 ? 'grid' : 'hidden'}`}
        >
          {cat.hotels.map((hotel) => (
            <a 
              href={hotel.link} 
              class="group block text-left cursor-pointer transition-opacity hover:opacity-95"
            >
              <!-- Rounded Photo Header -->
              <div class="relative aspect-[16/10] w-full rounded-2xl overflow-hidden bg-slate-100">
                <img 
                  src={hotel.image} 
                  alt={`${hotel.name} Photo`} 
                  loading="lazy" 
                  decoding="async" 
                  class="w-full h-full object-cover group-hover:scale-102 transition-transform duration-300" 
                />
              </div>

              <!-- Editorial Details Directly Below Photo (No Border, No Shadow) -->
              <div class="pt-3 space-y-0.5">
                <!-- Hotel Name -->
                <h3 class="font-bold text-slate-900 text-base sm:text-lg leading-snug group-hover:text-emerald-800 transition-colors">
                  {hotel.name}
                </h3>

                <!-- Location -->
                <p class="text-xs sm:text-sm text-slate-500 font-normal truncate">
                  {hotel.location}
                </p>

                <!-- Pricing (Hotels.com Format) -->
                <div class="pt-1.5">
                  <span class="text-base sm:text-lg font-black text-slate-900 block leading-tight">
                    {hotel.price}
                  </span>
                  <span class="text-[11px] text-slate-500 font-normal">
                    avg per night
                  </span>
                </div>
              </div>
            </a>
          ))}
        </div>
      ))}
    </div>

  </div>
</section>

<!-- TAB SWITCH SCRIPT -->
<script is:inline>
  const initStayStyleTabs = () => {
    const tabs = document.querySelectorAll('.stay-tab-btn');
    const panels = document.querySelectorAll('.stay-tab-panel');

    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        const targetId = tab.getAttribute('data-tab-target');

        // Update tab styles
        tabs.forEach(t => {
          t.classList.remove('border-slate-900', 'text-slate-900');
          t.classList.add('border-transparent', 'text-slate-500');
        });
        tab.classList.remove('border-transparent', 'text-slate-500');
        tab.classList.add('border-slate-900', 'text-slate-900');

        // Toggle corresponding panel
        panels.forEach(p => {
          if (p.id === `tab-panel-${targetId}`) {
            p.classList.remove('hidden');
            p.classList.add('grid');
          } else {
            p.classList.add('hidden');
            p.classList.remove('grid');
          }
        });
      });
    });
  };

  document.addEventListener('DOMContentLoaded', initStayStyleTabs);
  document.addEventListener('astro:page-load', initStayStyleTabs);
</script>
