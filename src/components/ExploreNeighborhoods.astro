---
// src/components/RecentGuestReviews.astro (100% Real-Time Recent Hotel Reviews Feed - 2-Column Mobile)
import { getCollection } from 'astro:content';

interface Props {
  title?: string;
  subtitle?: string;
}

const { 
  title = "Recent Guest Feedback", 
  subtitle = "Real experiences and ratings from travelers staying across luxury hotels in Gulshan."
} = Astro.props;

// ১. সব হোটেলের ডাটা লোড করা (যাতে হোটেলের আসল ছবি ও নাম পাওয়া যায়)
let allHotels: any[] = [];
try {
  const hotelCol = await getCollection('hotels');
  if (Array.isArray(hotelCol) && hotelCol.length > 0) allHotels = hotelCol;
} catch (e) {}

if (allHotels.length === 0) {
  try {
    const rawGlobHotels = import.meta.glob(['/src/content/hotels/*.{md,mdx}', '../content/hotels/*.{md,mdx}'], { eager: true });
    allHotels = Object.values(rawGlobHotels).map((item: any) => ({
      data: item?.frontmatter || item?.data || {}
    }));
  } catch (e) {}
}

// ২. সব রিভিউ ডাটা লোড করা
let allReviews: any[] = [];
try {
  const rawGlobReviews = import.meta.glob(['/src/content/reviews/*.{md,mdx}', '../content/reviews/*.{md,mdx}'], { eager: true });
  allReviews = Object.values(rawGlobReviews).map((item: any) => item?.frontmatter || item?.data || item || {});
} catch (e) {}

// ৩. শুধুমাত্র অনুমোদিত এবং বাস্তব রিভিউগুলো ফিল্টার করা
const approvedReviews = allReviews.filter((r: any) => {
  if (!r) return false;
  const isApproved = r.approved === true || String(r.approved).trim().toLowerCase() === 'true';
  return isApproved && String(r.comment || '').trim().length > 2;
});

// ৪. তারিখ অনুযায়ী সাজানো (সবচেয়ে নতুন রিভিউ সবার আগে থাকবে)
const sortedReviews = approvedReviews.sort((a, b) => {
  const dateA = new Date(a.date || 0).getTime();
  const dateB = new Date(b.date || 0).getTime();
  return dateB - dateA;
});

// ৫. প্রতিটি রিভিউর সাথে তার নির্দিষ্ট হোটেলের ছবি ও লিংক জোড়া লাগানো
const enrichedReviews = sortedReviews.map((rev: any) => {
  const rSlug = String(rev.slug || rev.hotelSlug || rev.id || '').replace(/\.(md|mdx)$/, '').split('/').pop()?.toLowerCase() || '';
  const rHotel = String(rev.hotel || '').trim().toLowerCase();

  // রিভিউ যে হোটেলের, সেই হোটেলকে খুঁজে বের করা
  const matchedHotel = allHotels.find((h: any) => {
    const hSlug = String(h.data?.slug || h.slug || h.id || '').replace(/\.(md|mdx)$/, '').split('/').pop()?.toLowerCase() || '';
    const hTitle = String(h.data?.title || h.data?.name || '').trim().toLowerCase();
    return (rSlug !== '' && hSlug === rSlug) || (rHotel !== '' && hTitle === rHotel);
  });

  const hData = matchedHotel?.data || {};
  const hotelTitle = hData.title || hData.name || rev.hotel || "Gulshan Luxury Hotel";
  const hotelSlug = String(hData.slug || matchedHotel?.slug || matchedHotel?.id || rSlug || '').replace(/\.(md|mdx)$/, '').split('/').pop()?.toLowerCase() || "";
  const hotelImage = hData.image || (Array.isArray(hData.gallery) ? hData.gallery[0] : "https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&w=500&q=75");
  const hotelLocation = hData.location || "Gulshan, Dhaka";

  return {
    reviewerName: rev.name || rev.author || "Verified Guest",
    date: rev.date || "Recent Stay",
    rating: Number(rev.rating) || 5,
    comment: String(rev.comment || rev.review || '').trim(),
    hotelTitle,
    hotelSlug,
    hotelImage,
    hotelLocation
  };
}).slice(0, 4); // মোবাইলে ২x২ গ্রিডের জন্য সর্বশেষ ৪টি রিভিউ

const hasReviews = enrichedReviews.length > 0;
const starsArray = [1, 2, 3, 4, 5];
---

{hasReviews && (
  <section 
    id="recent-reviews" 
    class="w-full bg-white py-10 sm:py-12 text-slate-900 border-b border-slate-200"
  >
    <div class="max-w-[1550px] mx-auto px-3 sm:px-8 lg:px-12 space-y-5">
      
      <!-- Section Header -->
      <div class="space-y-1 text-left border-b border-slate-100 pb-3">
        <span class="text-[9px] sm:text-xs font-black uppercase tracking-widest text-emerald-800 flex items-center gap-1.5">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
          <span>Verified Stay Experiences</span>
        </span>
        <h2 class="text-xl sm:text-3xl lg:text-4xl font-serif font-black text-slate-900 tracking-tight leading-tight">
          {title}
        </h2>
        <p class="text-[11px] sm:text-sm text-slate-500 font-medium">
          {subtitle}
        </p>
      </div>

      <!-- SIDE-BY-SIDE MOBILE 2-COLUMN & DESKTOP 4-COLUMN GRID -->
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-6 text-left">
        {enrichedReviews.map((item) => (
          <div class="group flex flex-col justify-between bg-white rounded-2xl border border-slate-200 overflow-hidden shadow-xs hover:shadow-xl hover:border-emerald-600/40 transition-all duration-300">
            <div>
              
              <!-- ১. হোটেলের ছবি ও লোকেশন ব্যাজ -->
              <a href={`/${item.hotelSlug}`} class="block relative aspect-[16/10] w-full overflow-hidden bg-slate-900">
                <img 
                  src={item.hotelImage} 
                  alt={item.hotelTitle} 
                  loading="lazy" 
                  decoding="async" 
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 ease-out" 
                />
                <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent"></div>
                
                <!-- হোটেলের নাম ছবির ওপরে মার্জিতভাবে -->
                <div class="absolute bottom-2 left-2 right-2 text-left">
                  <h4 class="text-white text-[10px] sm:text-xs font-bold leading-tight truncate drop-shadow-sm">
                    {item.hotelTitle}
                  </h4>
                  <span class="text-slate-300 text-[8px] sm:text-[9px] font-medium truncate block">
                    {item.hotelLocation}
                  </span>
                </div>
              </a>

              <!-- ২. কাস্টমারের আসল রিভিউ ও স্টার -->
              <div class="p-2.5 sm:p-4 space-y-1.5">
                
                <!-- গোল্ডেন ভেক্টর স্টার -->
                <div class="flex items-center gap-0.5">
                  {starsArray.map(s => (
                    <svg class={`w-2.5 h-2.5 sm:w-3 sm:h-3 shrink-0 ${s <= item.rating ? 'fill-amber-400' : 'fill-slate-200'}`} viewBox="0 0 24 24">
                      <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/>
                    </svg>
                  ))}
                  <span class="text-[9px] sm:text-[10px] text-slate-400 font-bold ml-1">{item.rating}.0</span>
                </div>

                <!-- কাস্টমারের মন্তব্য -->
                <p class="text-[10px] sm:text-xs text-slate-700 italic font-normal line-clamp-3 leading-relaxed">
                  "{item.comment}"
                </p>
              </div>
            </div>

            <!-- ৩. কাস্টমারের নাম, তারিখ এবং হোটেল লিংক -->
            <div class="p-2.5 sm:p-4 pt-0">
              <div class="pt-2 sm:pt-3 border-t border-slate-100 flex items-center justify-between">
                
                <div class="flex items-center gap-1.5 min-w-0">
                  <div class="w-6 h-6 rounded-full bg-emerald-50 text-emerald-900 border border-emerald-200 text-[10px] font-black uppercase flex items-center justify-center shrink-0">
                    {item.reviewerName.charAt(0)}
                  </div>
                  <div class="min-w-0">
                    <span class="text-[10px] sm:text-xs font-bold text-slate-900 truncate block leading-tight">
                      {item.reviewerName}
                    </span>
                    <span class="text-[8px] sm:text-[9px] text-slate-400 font-medium block truncate">
                      {item.date}
                    </span>
                  </div>
                </div>

                <a 
                  href={`/${item.hotelSlug}`} 
                  class="shrink-0 text-[10px] sm:text-xs font-black uppercase tracking-wider text-[#0d3b23] hover:underline flex items-center gap-0.5 pl-1"
                >
                  <span class="hidden xs:inline">Stay</span>
                  <span>➔</span>
                </a>
              </div>
            </div>

          </div>
        ))}
      </div>

    </div>
  </section>
)}
