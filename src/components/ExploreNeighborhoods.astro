---
// src/components/RecentGuestReviews.astro (Ultra-Clean Image-Free Guest Feedback Wall)
import { getCollection } from 'astro:content';

interface Props {
  title?: string;
  subtitle?: string;
}

const { 
  title = "Recent Guest Feedback", 
  subtitle = "Real ratings and experiences from verified travelers staying across Gulshan."
} = Astro.props;

// ১. হোটেল ডাটা লোডার (শুধুমাত্র হোটেলের নাম ও লিংকের জন্য)
let allHotels: any[] = [];
try {
  const hotelCol = await getCollection('hotels');
  if (Array.isArray(hotelCol) && hotelCol.length > 0) {
    allHotels = hotelCol.map(h => ({
      id: h.id,
      slug: (h.slug || h.id || '').replace(/\.(md|mdx)$/, '').split('/').pop()?.toLowerCase(),
      data: h.data || {}
    }));
  }
} catch (e) {}

if (allHotels.length === 0) {
  try {
    const rawGlobHotels = import.meta.glob(['/src/content/hotels/*.{md,mdx}', '../content/hotels/*.{md,mdx}'], { eager: true });
    allHotels = Object.entries(rawGlobHotels).map(([filePath, item]: [string, any]) => ({
      id: filePath.split('/').pop()?.replace(/\.(md|mdx)$/, ''),
      slug: filePath.split('/').pop()?.replace(/\.(md|mdx)$/, '')?.toLowerCase(),
      data: item?.frontmatter || item?.data || {}
    }));
  } catch (e) {}
}

// ২. সব রিভিউ ডাটা লোডার
let allReviews: any[] = [];
try {
  const rawGlobReviews = import.meta.glob(['/src/content/reviews/*.{md,mdx}', '../content/reviews/*.{md,mdx}'], { eager: true });
  allReviews = Object.entries(rawGlobReviews).map(([filePath, item]: [string, any]) => ({
    ...(item?.frontmatter || item?.data || item || {}),
    _fileName: filePath.split('/').pop() || ''
  }));
} catch (e) {
  allReviews = [];
}

// ৩. হোটেলের লোকাল রিভিউ মার্জ
allHotels.forEach((h: any) => {
  const hData = h.data || {};
  const embedded = Array.isArray(hData.reviews) ? hData.reviews : [];
  const hSlug = String(h.slug || hData.slug || h.id || '').toLowerCase();
  embedded.forEach((rev: any) => {
    allReviews.push({
      ...rev,
      hotel: rev.hotel || hData.title || hData.name || '',
      slug: hSlug,
      approved: true
    });
  });
});

// ৪. ফিল্টারিং (অনুমোদিত রিভিউ)
const approvedReviews = allReviews.filter((r: any) => {
  if (!r) return false;
  const isApproved = r.approved === true || String(r.approved).trim().toLowerCase() === 'true';
  return isApproved && String(r.comment || r.review || r.body || '').trim().length > 1;
});

// ৫. তারিখ পার্সার হেল্পার
const parseReviewDateToTime = (rev: any) => {
  const dStr = rev.date;
  if (dStr && dStr !== 'Recent' && dStr !== 'Recent Stay') {
    const cleanStr = String(dStr).replace(' at ', ' ').trim();
    const time = new Date(cleanStr).getTime();
    if (!isNaN(time) && time > 0) return time;
  }
  if (rev._fileName) {
    const fileMatch = String(rev._fileName).match(/^(\d{4}-\d{2}-\d{2})/);
    if (fileMatch) {
      const fTime = new Date(fileMatch[1]).getTime();
      if (!isNaN(fTime)) return fTime;
    }
  }
  return 0;
};

// ৬. Newest-First সর্টিং (সর্বশেষ রিভিউ সবার আগে)
const sortedReviews = approvedReviews.sort((a, b) => {
  return parseReviewDateToTime(b) - parseReviewDateToTime(a);
});

// ৭. ডেটা এনরিচমেন্ট
const enrichedReviews = sortedReviews.map((rev: any) => {
  const rSlug = String(rev.slug || rev.hotelSlug || rev.id || '').replace(/\.(md|mdx)$/, '').split('/').pop()?.toLowerCase() || '';
  const rHotel = String(rev.hotel || '').trim().toLowerCase();

  const matchedHotel = allHotels.find((h: any) => {
    const hSlug = String(h.slug || h.data?.slug || h.id || '').toLowerCase();
    const hTitle = String(h.data?.title || h.data?.name || '').trim().toLowerCase();
    return (rSlug !== '' && hSlug === rSlug) || (rHotel !== '' && (hTitle === rHotel || hSlug === rHotel));
  });

  const hData = matchedHotel?.data || {};
  const hotelTitle = hData.title || hData.name || rev.hotel || "Gulshan Hotel";
  const hotelSlug = String(matchedHotel?.slug || hData.slug || matchedHotel?.id || rSlug || '').toLowerCase();
  const cleanDate = String(rev.date || 'Recent').replace(/\s+at\s+.*$/i, '').trim();

  return {
    reviewerName: rev.name || rev.author || "Verified Guest",
    date: cleanDate,
    rating: Number(rev.rating) || 5,
    comment: String(rev.comment || rev.review || rev.body || '').trim(),
    hotelTitle,
    hotelSlug
  };
}).slice(0, 4);

const hasReviews = enrichedReviews.length > 0;
const starsArray = [1, 2, 3, 4, 5];
---

{hasReviews && (
  <section id="recent-reviews" class="w-full bg-white py-12 text-slate-900 border-b border-slate-200">
    <div class="max-w-[1550px] mx-auto px-4 sm:px-8 lg:px-12 space-y-6">
      
      <!-- Section Header -->
      <div class="space-y-1 text-left border-b border-slate-100 pb-4">
        <span class="text-[10px] sm:text-xs font-black uppercase tracking-widest text-emerald-800 flex items-center gap-1.5">
          <span class="w-2 h-2 rounded-full bg-emerald-600"></span>
          <span>Verified Stay Experiences</span>
        </span>
        <h2 class="text-2xl sm:text-3xl lg:text-4xl font-serif font-black text-slate-900 tracking-tight leading-tight">
          {title}
        </h2>
        <p class="text-xs sm:text-sm text-slate-500 font-medium">
          {subtitle}
        </p>
      </div>

      <!-- ULTRA-CLEAN 2-COLS MOBILE & 4-COLS DESKTOP GRID -->
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-3.5 sm:gap-6 text-left">
        {enrichedReviews.map((item) => (
          <div class="group flex flex-col justify-between bg-slate-50/70 hover:bg-white rounded-2xl sm:rounded-3xl border border-slate-200 hover:border-emerald-600/40 hover:shadow-lg transition-all duration-300 p-3.5 sm:p-5">
            
            <div class="space-y-3">
              
              <!-- ১. টপ বার: রেটিং স্টার এবং হোটেলের ব্যাজ -->
              <div class="space-y-2">
                <div class="flex items-center justify-between gap-1 flex-wrap">
                  <!-- গোল্ডেন ভেক্টর স্টার -->
                  <div class="flex items-center gap-0.5">
                    {starsArray.map(s => (
                      <svg class={`w-3.5 h-3.5 shrink-0 ${s <= item.rating ? 'fill-amber-400' : 'fill-slate-200'}`} viewBox="0 0 24 24">
                        <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/>
                      </svg>
                    ))}
                  </div>

                  <!-- হোটেলের নামযুক্ত ট্যাগ/পিল -->
                  <a 
                    href={`/${item.hotelSlug}`} 
                    class="text-[9px] sm:text-[10px] font-black uppercase tracking-wider text-emerald-900 bg-emerald-100/70 hover:bg-emerald-200/80 border border-emerald-200 px-2 py-0.5 rounded-md truncate max-w-[130px] transition-colors"
                    title={item.hotelTitle}
                  >
                    {item.hotelTitle}
                  </a>
                </div>
              </div>

              <!-- ২. কাস্টমারের আসল রিভিউ কমেন্ট -->
              <p class="text-xs sm:text-sm text-slate-700 italic font-normal line-clamp-4 leading-relaxed min-h-[64px]">
                "{item.comment}"
              </p>

            </div>

            <!-- ৩. ফুটার: কাস্টমারের নাম, তারিখ এবং হোটেল লিংক -->
            <div class="pt-3.5 mt-3 border-t border-slate-200/80 flex items-center justify-between text-xs">
              
              <div class="flex items-center gap-2 min-w-0">
                <div class="w-7 h-7 rounded-full bg-white text-emerald-900 font-black text-xs flex items-center justify-center shrink-0 uppercase border border-slate-200 shadow-2xs">
                  {item.reviewerName.charAt(0)}
                </div>
                <div class="min-w-0">
                  <span class="text-xs font-bold text-slate-900 truncate block leading-tight">
                    {item.reviewerName}
                  </span>
                  <span class="text-[10px] text-slate-400 font-medium block truncate mt-0.5">
                    {item.date}
                  </span>
                </div>
              </div>

              <a 
                href={`/${item.hotelSlug}`} 
                class="shrink-0 text-emerald-800 font-black text-xs hover:underline flex items-center gap-0.5 pl-1"
                aria-label={`View ${item.hotelTitle}`}
              >
                <span class="hidden xs:inline">Hotel</span>
                <span>➔</span>
              </a>

            </div>

          </div>
        ))}
      </div>

    </div>
  </section>
)}
