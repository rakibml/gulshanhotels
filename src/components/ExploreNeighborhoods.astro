---
// src/components/ExploreNeighborhoods.astro (Ultra-Clean Luxury Editorial Design)
interface Props {
  title?: string;
  subtitle?: string;
}

const { 
  title = "Explore Hotels by Neighborhood", 
  subtitle = "Curated luxury stays across North Dhaka's premier diplomatic and business zones."
} = Astro.props;

// গুলশান ও ঢাকার বাস্তবসম্মত আরবান লাক্সারি ছবি ও তথ্য
const neighborhoods = [
  {
    name: "Gulshan 2",
    tagline: "Diplomatic Heart & 5-Star Stays",
    hotelCount: "15+ Hotels",
    highlights: "The Westin • Renaissance • Lake Park",
    // আধুনিক আরবান সিটি ও লেক ভিউ
    image: "https://images.unsplash.com/photo-1514565131-fce0801e5785?auto=format&fit=crop&w=800&q=80",
    link: "/#hotels"
  },
  {
    name: "Gulshan 1",
    tagline: "Corporate Hub & Shopping Center",
    hotelCount: "10+ Hotels",
    highlights: "MNC Offices • DCC Market • Central Access",
    // মডার্ন কমার্শিয়াল সিটি আর্কিটেকচার
    image: "https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?auto=format&fit=crop&w=800&q=80",
    link: "/#hotels"
  },
  {
    name: "Banani",
    tagline: "Road 11 Cafes & Boutique Luxury",
    hotelCount: "12+ Hotels",
    highlights: "Trendy Cafes • Boutique Stays • Nightlife",
    // প্রিমিয়াম বুটিক ও আরবান লাইফস্টাইল
    image: "https://images.unsplash.com/photo-1551882547-ff40c63fe5fa?auto=format&fit=crop&w=800&q=80",
    link: "/#hotels"
  },
  {
    name: "Baridhara Enclave",
    tagline: "Ultra-Secure Diplomatic Suites",
    hotelCount: "8+ Suites",
    highlights: "Embassy Enclave • Park Walk • Quiet Stays",
    // শান্ত ও গ্রিন ডিপ্লোম্যাটিক এভিনিউ
    image: "https://images.unsplash.com/photo-1590381105924-c72589b9ef3f?auto=format&fit=crop&w=800&q=80",
    link: "/#hotels"
  }
];
---

<!-- EXPLORE BY NEIGHBORHOODS (CLEAN LUXURY EDITORIAL STYLE) -->
<section id="neighborhoods" class="w-full bg-white pt-8 pb-14 text-slate-900">
  <div class="max-w-[1550px] mx-auto px-4 sm:px-8 lg:px-12 space-y-6">
    
    <!-- Section Header -->
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-end gap-4 text-left">
      <div class="space-y-1">
        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-50 text-emerald-800 text-[11px] font-black uppercase tracking-wider mb-0.5">
          <span>📍 Strategic Zones</span>
        </div>
        <h2 class="text-2xl sm:text-3xl font-black font-sans text-slate-900 tracking-tight">
          {title}
        </h2>
        {subtitle && (
          <p class="text-xs sm:text-sm text-slate-500 font-medium max-w-2xl">
            {subtitle}
          </p>
        )}
      </div>

      <span class="hidden md:inline-block text-xs font-semibold text-slate-400">
        4 Key Zones in North Dhaka
      </span>
    </div>

    <!-- 4-COLUMN CARDS WITH BALANCED EDITORIAL PROPORTIONS -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 text-left">
      {neighborhoods.map((zone) => (
        <a 
          href={zone.link} 
          class="group relative h-[360px] sm:h-[390px] rounded-2xl overflow-hidden block border border-slate-200/90 hover:border-slate-400 transition-all duration-300 cursor-pointer"
        >
          <!-- Background Image with smooth hover -->
          <img 
            src={zone.image} 
            alt={`${zone.name} Area`} 
            loading="lazy" 
            decoding="async" 
            class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 ease-out" 
          />

          <!-- Clean Dark Gradient (Only covering the bottom half, so photo stays visible) -->
          <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/40 to-transparent"></div>

          <!-- Top Badge: Minimal Frosted Glass (সবগুলোর সেইম ক্লাসি স্টাইল) -->
          <div class="absolute top-4 left-4 z-10">
            <span class="inline-flex items-center text-[10px] font-black uppercase tracking-widest px-3 py-1 rounded-full bg-black/40 backdrop-blur-md text-white border border-white/20">
              {zone.hotelCount}
            </span>
          </div>

          <!-- Bottom Content: Clean & Clutter-Free -->
          <div class="absolute inset-x-0 bottom-0 p-5 z-10 space-y-1.5">
            
            <div class="space-y-0.5">
              <h3 class="text-2xl font-black text-white tracking-tight leading-tight group-hover:text-emerald-400 transition-colors">
                {zone.name}
              </h3>
              <p class="text-xs text-slate-200 font-medium">
                {zone.tagline}
              </p>
            </div>

            <!-- Key Landmarks Subtitle (কোনো ভারী বাটন ছাড়া হালকা ক্লাসি টেক্সট) -->
            <p class="text-[11px] text-slate-300/80 font-normal truncate pt-0.5">
              {zone.highlights}
            </p>

            <!-- Bottom Line: Minimalist Arrow Link -->
            <div class="pt-2 flex items-center gap-1.5 text-xs font-bold text-white group-hover:text-emerald-400 transition-colors">
              <span class="uppercase tracking-wider text-[11px]">View Properties</span>
              <span class="inline-block transition-transform duration-300 group-hover:translate-x-1">➔</span>
            </div>

          </div>
        </a>
      ))}
    </div>

  </div>
</section>
