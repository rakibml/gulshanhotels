---
// src/components/ExploreNeighborhoods.astro (Explore Gulshan by Key Zones & Neighborhoods)
interface Props {
  title?: string;
  subtitle?: string;
}

const { 
  title = "Explore Hotels by Neighborhood", 
  subtitle = "Choose the ideal zone for your stay—from diplomatic luxury to corporate hubs and trendy food streets."
} = Astro.props;

// ৪টি প্রধান এলাকা ও তাদের তথ্য
const neighborhoods = [
  {
    name: "Gulshan 2",
    tagline: "Diplomatic Heart & 5-Star Luxury",
    hotelCount: "15+ Hotels",
    highlights: ["5-Star Luxury", "Lake Park Walkways", "Fine Dining"],
    image: "https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&w=800&q=80",
    link: "/#hotels",
    badgeColor: "bg-emerald-950/80 text-emerald-300 border-emerald-600/40"
  },
  {
    name: "Gulshan 1",
    tagline: "Commercial Hub & Shopping",
    hotelCount: "10+ Hotels",
    highlights: ["Corporate Offices", "DCC Market", "Central Connectivity"],
    image: "https://images.unsplash.com/photo-1542314831-068cd1dbfeeb?auto=format&fit=crop&w=800&q=80",
    link: "/#hotels",
    badgeColor: "bg-slate-950/80 text-amber-300 border-amber-600/40"
  },
  {
    name: "Banani",
    tagline: "Road 11 Cafes & Boutique Stays",
    hotelCount: "12+ Hotels",
    highlights: ["Boutique Hotels", "Vibrant Food Street", "Nightlife"],
    image: "https://images.unsplash.com/photo-1571896349842-33c89424de2d?auto=format&fit=crop&w=800&q=80",
    link: "/#hotels",
    badgeColor: "bg-purple-950/80 text-purple-300 border-purple-600/40"
  },
  {
    name: "Baridhara Enclave",
    tagline: "Ultra-Secure Diplomatic Suites",
    hotelCount: "8+ Suites",
    highlights: ["Embassy Zone", "Serviced Apartments", "Maximum Security"],
    image: "https://images.unsplash.com/photo-1582719478250-c89cae4dc85b?auto=format&fit=crop&w=800&q=80",
    link: "/#hotels",
    badgeColor: "bg-blue-950/80 text-blue-300 border-blue-600/40"
  }
];
---

<!-- EXPLORE BY NEIGHBORHOODS SECTION -->
<section id="neighborhoods" class="w-full bg-white pt-8 pb-14 text-slate-900">
  <div class="max-w-[1550px] mx-auto px-4 sm:px-8 lg:px-12 space-y-6">
    
    <!-- Section Header -->
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-end gap-4 text-left">
      <div class="space-y-1">
        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-50 text-emerald-800 text-[11px] font-black uppercase tracking-wider mb-0.5">
          <span>📍 Strategic Locations</span>
        </div>
        <h2 class="text-2xl sm:text-3xl font-black font-sans text-slate-900 tracking-tight">
          {title}
        </h2>
        {subtitle && (
          <p class="text-xs sm:text-sm text-slate-500 font-medium max-w-2xl">
            {subtitle}
          </p>
        )}
      </div>

      <span class="hidden md:inline-block text-xs font-semibold text-slate-400">
        4 Key Zones in North Dhaka
      </span>
    </div>

    <!-- 4-COLUMN NEIGHBORHOOD PHOTO CARDS -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 text-left">
      {neighborhoods.map((zone) => (
        <a 
          href={zone.link} 
          class="group relative h-[380px] sm:h-[420px] rounded-3xl overflow-hidden block border border-slate-200/80 hover:border-slate-400 transition-colors duration-300 cursor-pointer"
        >
          <!-- Background Photo -->
          <img 
            src={zone.image} 
            alt={`${zone.name} Area`} 
            loading="lazy" 
            decoding="async" 
            class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 ease-out" 
          />

          <!-- Dark Gradient Overlay for perfect readability -->
          <div class="absolute inset-0 bg-gradient-to-t from-slate-950/95 via-slate-950/40 to-slate-950/20"></div>

          <!-- Top Badge: Hotel Count -->
          <div class="absolute top-4 left-4 z-10">
            <span class={`inline-block text-[11px] font-black uppercase tracking-wider px-3 py-1 rounded-full border backdrop-blur-md ${zone.badgeColor}`}>
              {zone.hotelCount}
            </span>
          </div>

          <!-- Bottom Content Container -->
          <div class="absolute inset-x-0 bottom-0 p-5 z-10 flex flex-col justify-end space-y-2">
            
            <div>
              <h3 class="text-2xl sm:text-3xl font-black text-white tracking-tight leading-tight group-hover:text-emerald-300 transition-colors">
                {zone.name}
              </h3>
              <p class="text-xs sm:text-[13px] text-slate-300 font-medium mt-1 leading-snug">
                {zone.tagline}
              </p>
            </div>

            <!-- Area Feature Tags -->
            <div class="flex flex-wrap gap-1.5 pt-1">
              {zone.highlights.map((tag) => (
                <span class="text-[10px] font-bold text-slate-200 bg-white/10 backdrop-blur-md border border-white/15 px-2 py-0.5 rounded-md">
                  {tag}
                </span>
              ))}
            </div>

            <!-- View Hotels CTA Button Line -->
            <div class="pt-2 flex items-center justify-between text-xs font-black text-emerald-400 group-hover:text-emerald-300 transition-colors">
              <span class="uppercase tracking-wider text-[11px]">Explore Hotels</span>
              <span class="w-7 h-7 rounded-full bg-white/10 group-hover:bg-emerald-400 group-hover:text-slate-950 text-white flex items-center justify-center transition-all duration-300 text-sm">
                ➔
              </span>
            </div>

          </div>
        </a>
      ))}
    </div>

  </div>
</section>
