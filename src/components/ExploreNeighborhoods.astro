---
// src/components/GulshanLifestyle.astro (100% Dynamic - Auto Fetches Latest Guides by Category)
import { getCollection } from 'astro:content';

interface Props {
  title?: string;
  subtitle?: string;
}

const { 
  title = "Beyond the stay. Explore Gulshan.", 
  subtitle = "Curated travel guides, embassy interview tips, and local dining recommendations updated weekly."
} = Astro.props;

// ১. সব পোস্ট ফেচ করা
let allPosts: any[] = [];
try {
  const postCol = await getCollection('posts');
  if (Array.isArray(postCol) && postCol.length > 0) allPosts = postCol;
} catch (e) {}

if (allPosts.length === 0) {
  try {
    const rawGlob = import.meta.glob('../content/posts/*.md', { eager: true });
    allPosts = Object.entries(rawGlob).map(([filePath, item]: [string, any]) => ({
      slug: filePath.split('/').pop()?.replace('.md', ''),
      data: item.frontmatter || {}
    }));
  } catch (e) {}
}

// তারিখ অনুযায়ী সাজানো (লেটেস্ট পোস্ট সবার আগে)
const sortedPosts = allPosts.sort((a, b) => {
  const dateA = new Date(a.data?.date || 0).getTime();
  const dateB = new Date(b.data?.date || 0).getTime();
  return dateB - dateA;
});

// ক্যাটাগরি তালিকা
const categories = [
  { id: "all", name: "All Guides" },
  { id: "embassy", name: "Embassy Guides" },
  { id: "dining", name: "Food & Dining" },
  { id: "reviews", name: "Hotel Reviews" },
  { id: "travel", name: "Travel Guides" }
];

// ক্যাটাগরি ফিল্টার হেল্পার
const getPostsByCategory = (catId: string) => {
  if (catId === "all") return sortedPosts.slice(0, 4);

  const filtered = sortedPosts.filter(p => {
    const cat = String(p.data?.category || '').toLowerCase();
    if (catId === "embassy") return cat.includes("embassy") || cat.includes("visa");
    if (catId === "dining") return cat.includes("food") || cat.includes("dining") || cat.includes("restaurant");
    if (catId === "reviews") return cat.includes("review") || cat.includes("hotel");
    if (catId === "travel") return cat.includes("travel") || cat.includes("guide");
    return false;
  });

  // কোনো ক্যাটাগরিতে পোস্ট কম থাকলে লেটেস্ট পোস্ট দিয়ে ব্যাকআপ রাখা যাতে সেকশন খালি না দেখায়
  return filtered.length > 0 ? filtered.slice(0, 4) : sortedPosts.slice(0, 4);
};
---

<!-- DYNAMIC LIFESTYLE & GUIDES SECTION -->
<section 
  id="gulshan-lifestyle" 
  class="w-full bg-white pt-8 pb-14 text-slate-900 border-b border-slate-100"
  style="content-visibility: auto; contain-intrinsic-size: 1px 400px;"
>
  <div class="max-w-[1550px] mx-auto px-4 sm:px-8 lg:px-12 space-y-6">
    
    <!-- Section Title & Subtitle -->
    <div class="space-y-1 text-left">
      <h2 class="text-3xl sm:text-4xl lg:text-[40px] font-serif font-black text-slate-900 tracking-tight leading-tight">
        {title}
      </h2>
      <p class="text-xs sm:text-sm text-slate-500 font-medium">
        {subtitle}
      </p>
    </div>

    <!-- Category Tabs with Underline Indicator -->
    <div class="flex items-center gap-6 sm:gap-8 border-b border-slate-200 overflow-x-auto scroll-smooth [scrollbar-width:none] [-ms-overflow-style:none] [&::-webkit-scrollbar]:hidden">
      {categories.map((cat, idx) => (
        <button
          type="button"
          data-tab-target={cat.id}
          class={`lifestyle-tab-btn pb-3 text-xs sm:text-sm font-bold tracking-tight whitespace-nowrap transition-all cursor-pointer border-b-2 -mb-[1px] ${idx === 0 ? 'border-slate-900 text-slate-900' : 'border-transparent text-slate-500 hover:text-slate-900'}`}
        >
          {cat.name}
        </button>
      ))}
    </div>

    <!-- Dynamic Category Content Panels -->
    <div id="lifestyleTabContentContainer" class="text-left">
      {categories.map((cat, idx) => {
        const postsForThisTab = getPostsByCategory(cat.id);

        return (
          <div 
            id={`lifestyle-panel-${cat.id}`} 
            class={`lifestyle-tab-panel overflow-x-auto sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6 pb-2 sm:pb-0 scroll-smooth [scrollbar-width:none] [-ms-overflow-style:none] [&::-webkit-scrollbar]:hidden ${idx === 0 ? 'flex sm:grid' : 'hidden'}`}
          >
            {postsForThisTab.map((post: any) => {
              const pData = post.data || {};
              const pSlug = post.slug || post.id?.replace(/\.md$/, '');
              const pTitle = pData.title || "Gulshan Travel Guide";
              const pDesc = pData.description || "In-depth recommendations and local tips.";
              const pCat = pData.category || "Travel Guide";
              const pImg = pData.image || "https://images.unsplash.com/photo-1542314831-068cd1dbfeeb?auto=format&fit=crop&w=600&q=75";
              const pReadTime = pData.readTime || "4 min read";

              return (
                <a 
                  href={`/blog/${pSlug}`} 
                  class="group block text-left cursor-pointer transition-opacity hover:opacity-95 w-[240px] sm:w-auto shrink-0 sm:shrink space-y-2.5"
                >
                  <!-- Rounded Photo -->
                  <div class="relative aspect-[16/10] w-full rounded-2xl overflow-hidden bg-slate-100 border border-slate-200/80">
                    <img 
                      src={pImg} 
                      alt={pTitle} 
                      loading="lazy" 
                      decoding="async" 
                      fetchpriority="low"
                      width="400"
                      height="250"
                      class="w-full h-full object-cover group-hover:scale-104 transition duration-500 ease-out" 
                    />

                    <!-- Category Badge -->
                    <div class="absolute top-2.5 left-2.5 bg-white/95 backdrop-blur-md text-slate-900 text-[10px] font-black uppercase tracking-wider px-2.5 py-0.5 rounded-md border border-slate-200">
                      {pCat}
                    </div>
                  </div>

                  <!-- Details -->
                  <div class="space-y-1">
                    <h3 class="font-bold text-slate-900 text-base sm:text-lg leading-snug group-hover:text-emerald-800 transition-colors line-clamp-2 capitalize">
                      {pTitle}
                    </h3>

                    <p class="text-xs text-slate-500 font-normal line-clamp-2 leading-relaxed">
                      {pDesc}
                    </p>

                    <!-- Read Time & Link Line (Hotels.com Format with SVG) -->
                    <div class="pt-2 flex items-center justify-between text-xs border-t border-slate-100">
                      <span class="text-slate-400 font-semibold flex items-center gap-1 text-[11px]">
                        <svg class="w-3.5 h-3.5 text-slate-400 fill-none stroke-current stroke-2" viewBox="0 0 24 24">
                          <circle cx="12" cy="12" r="10"></circle>
                          <polyline points="12 6 12 12 16 14"></polyline>
                        </svg>
                        <span>{pReadTime}</span>
                      </span>

                      <span class="inline-flex items-center gap-1 text-[11px] font-black uppercase tracking-wider text-[#0d3b23] group-hover:underline">
                        <span>Read Guide</span>
                        <svg class="w-3 h-3 fill-none stroke-current stroke-[3]" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                        </svg>
                      </span>
                    </div>
                  </div>
                </a>
              );
            })}
          </div>
        );
      })}
    </div>

  </div>
</section>

<!-- TAB SWITCH SCRIPT -->
<script is:inline>
  const initLifestyleTabs = () => {
    const tabs = document.querySelectorAll('.lifestyle-tab-btn');
    const panels = document.querySelectorAll('.lifestyle-tab-panel');

    tabs.forEach(tab => {
      tab.onclick = () => {
        const targetId = tab.getAttribute('data-tab-target');

        tabs.forEach(t => {
          t.classList.remove('border-slate-900', 'text-slate-900');
          t.classList.add('border-transparent', 'text-slate-500');
        });
        tab.classList.remove('border-transparent', 'text-slate-500');
        tab.classList.add('border-slate-900', 'text-slate-900');

        panels.forEach(p => {
          if (p.id === `lifestyle-panel-${targetId}`) {
            p.classList.remove('hidden');
            p.classList.add('flex', 'sm:grid');
          } else {
            p.classList.add('hidden');
            p.classList.remove('flex', 'sm:grid');
          }
        });
      };
    });
  };

  document.addEventListener('DOMContentLoaded', initLifestyleTabs);
  document.addEventListener('astro:page-load', initLifestyleTabs);
</script>
