---
// src/components/LatestBlogs.astro (Mobile Side-by-Side 2-Cols & Desktop 3-Cols)
import { getCollection } from 'astro:content';

let allPosts: any[] = [];

// ১. প্রথমে Astro Content Layer দিয়ে চেষ্টা করবে
try {
  const posts = await getCollection('posts');
  if (Array.isArray(posts) && posts.length > 0) {
    allPosts = posts.map((p: any) => ({
      slug: String(p.data?.slug || p.slug || p.id || '').replace(/\.(md|mdx)$/, '').split('/').pop()?.toLowerCase().trim(),
      data: p.data || {}
    }));
  }
} catch (e) {
  allPosts = [];
}

// ২. ফলব্যাক: সরাসরি ফাইল থেকে নিয়ে আসা (১০০% কাজ করবে)
if (allPosts.length === 0) {
  try {
    const rawGlob = import.meta.glob(['/src/content/posts/*.{md,mdx}', '../content/posts/*.{md,mdx}'], { eager: true });
    allPosts = Object.entries(rawGlob).map(([filePath, item]: [string, any]) => ({
      slug: String(item?.frontmatter?.slug || filePath.split('/').pop()?.replace(/\.(md|mdx)$/, '')).toLowerCase().trim(),
      data: item?.frontmatter || item?.data || {}
    }));
  } catch (err) {
    allPosts = [];
  }
}

// তারিখ অনুযায়ী সাজিয়ে লেটেস্ট ৩টি পোস্ট নেওয়া
const latestPosts = allPosts
  .filter(p => (p.data?.title || p.slug))
  .sort((a, b) => new Date(b.data?.date || 0).getTime() - new Date(a.data?.date || 0).getTime())
  .slice(0, 3);
---

{latestPosts.length > 0 && (
  <section id="latest-travel-guides" class="w-full bg-white py-8 sm:py-12 px-3 sm:px-6 lg:px-0 max-w-7xl mx-auto border-b border-slate-200 text-left">
    
    <!-- সেকশন হেডার -->
    <div class="flex items-end justify-between gap-2 border-b border-slate-100 pb-3 sm:pb-5 mb-5 sm:mb-8">
      <div>
        <span class="text-[10px] sm:text-xs font-black uppercase tracking-widest text-emerald-800 block">
          Editorial Travel Hub
        </span>
        <h2 class="text-xl sm:text-3xl lg:text-4xl font-sans font-black text-slate-900 tracking-tight leading-tight mt-1">
          Latest Travel Guides & Insights
        </h2>
      </div>
      <a href="/blog" class="inline-flex items-center gap-1 text-xs sm:text-sm font-bold text-emerald-800 hover:text-emerald-950 transition shrink-0">
        <span>View all</span>
        <span>➔</span>
      </a>
    </div>

    <!-- 🎯 মোবাইলে পাশাপাশি ২ কলাম (grid-cols-2) এবং ডেক্সটপে ৩ কলাম (md:grid-cols-3) -->
    <div class="grid grid-cols-2 md:grid-cols-3 gap-3 sm:gap-6">
      {latestPosts.map((post) => {
        const pData = post.data || {};
        const pSlug = post.slug;
        const pTitle = pData.title || "Gulshan Travel Guide";
        const pImg = pData.image || "https://images.unsplash.com/photo-1542314831-068cd1dbfeeb?auto=format&fit=crop&w=600&q=75";

        return (
          <article class="group bg-white rounded-2xl sm:rounded-3xl border border-slate-200/90 overflow-hidden shadow-2xs hover:shadow-xl hover:border-emerald-600/40 transition-all duration-300 flex flex-col justify-between">
            <div>
              <!-- ছবি এবং ক্যাটাগরি ব্যাজ -->
              <a href={`/blog/${pSlug}/`} class="block relative aspect-[16/10] overflow-hidden bg-slate-900">
                <img 
                  src={pImg} 
                  alt={pTitle}
                  loading="lazy" 
                  decoding="async"
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" 
                />
                <span class="absolute top-2 left-2 sm:top-3 sm:left-3 bg-[#0d3b23] text-white text-[8px] sm:text-[10px] font-black uppercase px-2 py-0.5 rounded shadow-xs">
                  {pData.category || "Guide"}
                </span>
              </a>

              <!-- কনটেন্ট এরিয়া -->
              <div class="p-2.5 sm:p-5 space-y-1 sm:space-y-2">
                <span class="text-[9px] sm:text-[11px] font-semibold text-slate-400 block truncate">
                  {pData.date || "Recent"} • {pData.readTime || "4 min read"}
                </span>
                
                <h3 class="font-serif text-xs sm:text-lg font-black text-slate-900 group-hover:text-emerald-800 transition line-clamp-2 leading-snug">
                  <a href={`/blog/${pSlug}/`}>{pTitle}</a>
                </h3>

                <!-- মোবাইলে লেখা যাতে বেশি বড় হয়ে কার্ড নষ্ট না করে, তাই ডেসক্রিপশন শুধু বড় স্ক্রিনে দেখাবে -->
                <p class="text-[11px] sm:text-xs text-slate-600 line-clamp-2 leading-relaxed hidden sm:block">
                  {pData.description || "In-depth guide and local advice for your stay in Gulshan, Dhaka."}
                </p>
              </div>
            </div>

            <!-- নিচে লিংক বাটন -->
            <div class="p-2.5 sm:p-5 pt-0">
              <a href={`/blog/${pSlug}/`} class="inline-flex items-center gap-1 text-[10px] sm:text-xs font-bold text-emerald-800 group-hover:underline pt-1.5 sm:pt-2 border-t border-slate-100 w-full justify-between">
                <span>Read Guide</span>
                <span>➔</span>
              </a>
            </div>
          </article>
        );
      })}
    </div>

  </section>
)}
