---

<!-- HOTELS.COM STYLE LIFESTYLE SECTION (PAGESPEED 100 & MOBILE SIDE-BY-SIDE) -->
<section 
  id="gulshan-lifestyle" 
  class="w-full bg-white pt-8 pb-14 text-slate-900 border-b border-slate-100"
  style="content-visibility: auto; contain-intrinsic-size: 1px 400px;"
>
  <div class="max-w-[1550px] mx-auto px-4 sm:px-8 lg:px-12 space-y-6">
    
    <!-- Section Title & Subtitle -->
    <div class="space-y-1 text-left">
      <h2 class="text-3xl sm:text-4xl lg:text-[40px] font-serif font-black text-slate-900 tracking-tight leading-tight">
        {title}
      </h2>
      <p class="text-xs sm:text-sm text-slate-500 font-medium">
        {subtitle}
      </p>
    </div>

    <!-- Category Tabs with Underline Indicator -->
    <div class="flex items-center gap-6 sm:gap-8 border-b border-slate-200 overflow-x-auto scroll-smooth [scrollbar-width:none] [-ms-overflow-style:none] [&::-webkit-scrollbar]:hidden">
      {lifestyleCategories.map((cat, idx) => (
        <button
          type="button"
          data-tab-target={cat.id}
          class={`lifestyle-tab-btn pb-3 text-xs sm:text-sm font-bold tracking-tight whitespace-nowrap transition-all cursor-pointer border-b-2 -mb-[1px] ${idx === 0 ? 'border-slate-900 text-slate-900' : 'border-transparent text-slate-500 hover:text-slate-900'}`}
        >
          {cat.name}
        </button>
      ))}
    </div>

    <!-- Category Content Panels -->
    <div id="lifestyleTabContentContainer" class="text-left">
      {lifestyleCategories.map((cat, idx) => (
        <div 
          id={`lifestyle-panel-${cat.id}`} 
          class={`lifestyle-tab-panel flex overflow-x-auto sm:grid sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6 pb-2 sm:pb-0 scroll-smooth [scrollbar-width:none] [-ms-overflow-style:none] [&::-webkit-scrollbar]:hidden ${idx === 0 ? 'flex sm:grid' : 'hidden'}`}
        >
          {cat.items.map((item) => (
            <!-- কার্ডগুলো ফোনে w-[240px] থাকবে (পাশাপাশি) এবং কম্পিউটারে সম্পূর্ণ গ্রিড হবে -->
            <a 
              href={item.link} 
              target={item.link.startsWith('http') ? '_blank' : '_self'}
              rel="noopener noreferrer"
              class="group block text-left cursor-pointer transition-opacity hover:opacity-95 w-[240px] sm:w-auto shrink-0 sm:shrink"
            >
              <!-- Rounded Photo (CLS 0 & Speed Optimized) -->
              <div class="relative aspect-[16/10] w-full rounded-2xl overflow-hidden bg-slate-100">
                <img 
                  src={item.image} 
                  alt={`${item.name} Location`} 
                  loading="lazy" 
                  decoding="async" 
                  fetchpriority="low"
                  width="400"
                  height="250"
                  class="w-full h-full object-cover group-hover:scale-102 transition-transform duration-300" 
                />
              </div>

              <!-- Editorial Details Directly Below Photo -->
              <div class="pt-3 space-y-0.5">
                <h3 class="font-bold text-slate-900 text-base sm:text-lg leading-snug group-hover:text-emerald-800 transition-colors truncate">
                  {item.name}
                </h3>

                <p class="text-xs sm:text-sm text-slate-500 font-normal truncate">
                  {item.location}
                </p>

                <!-- Status & Timing -->
                <div class="pt-1.5">
                  <span class="text-base sm:text-lg font-black text-slate-900 block leading-tight">
                    {item.status}
                  </span>
                  <span class="text-[11px] text-slate-500 font-normal">
                    {item.meta}
                  </span>
                </div>
              </div>
            </a>
          ))}
        </div>
      ))}
    </div>

  </div>
</section>

<!-- TAB SWITCH SCRIPT (MEMORY LEAK-FREE) -->
<script is:inline>
  const initLifestyleTabs = () => {
    const tabs = document.querySelectorAll('.lifestyle-tab-btn');
    const panels = document.querySelectorAll('.lifestyle-tab-panel');

    if (!tabs.length || tabs[0].dataset.tabBound) return;
    tabs[0].dataset.tabBound = 'true';

    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        const targetId = tab.getAttribute('data-tab-target');

        tabs.forEach(t => {
          t.classList.remove('border-slate-900', 'text-slate-900');
          t.classList.add('border-transparent', 'text-slate-500');
        });
        tab.classList.remove('border-transparent', 'text-slate-500');
        tab.classList.add('border-slate-900', 'text-slate-900');

        panels.forEach(p => {
          if (p.id === `lifestyle-panel-${targetId}`) {
            p.classList.remove('hidden');
            p.classList.add('flex', 'sm:grid');
          } else {
            p.classList.add('hidden');
            p.classList.remove('flex', 'sm:grid');
          }
        });
      });
    });
  };

  document.addEventListener('DOMContentLoaded', initLifestyleTabs);
  document.addEventListener('astro:page-load', initLifestyleTabs);
</script>
