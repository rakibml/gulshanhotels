// src/components/BrowsePropertyTypes.astro (100% RFC Valid URLs, Zero Fake Counts & CLS Safe)
{/*import { getCollection } from 'astro:content';

interface Props {
  title?: string;
}

const { 
  title = "Browse by Property Type in Gulshan"
} = Astro.props;

const isProd = import.meta.env.PROD;

// ১. ড্রাফট ফিল্টারসহ রিয়েল হোটেল ডাটা লোডার (গুগল ভুয়া সংখ্যা রোধ)
let allHotels: any[] = [];

try {
  const collection = await getCollection('hotels', ({ data }) => {
    return isProd ? data?.draft !== true : true;
  });
  if (Array.isArray(collection) && collection.length > 0) {
    allHotels = collection;
  }
} catch (e) {
  allHotels = [];
}

if (allHotels.length === 0) {
  try {
    const rawGlob = import.meta.glob(['/src/content/hotels/*.{md,mdx}', '../content/hotels/*.{md,mdx}'], { eager: true });
    allHotels = Object.entries(rawGlob)
      .filter(([_, item]: [string, any]) => (isProd ? item?.frontmatter?.draft !== true : true))
      .map(([_, item]: [string, any]) => ({
        data: item?.frontmatter || item?.data || {}
      }));
  } catch (e) {
    allHotels = [];
  }
}

// ২. খাঁটি প্রপার্টি সংখ্যা গণনা (১০০% আসল ও লাইভ ডাটা)
const totalHotelsCount = allHotels.filter(h => {
  const cat = String(h.data?.category || "").toLowerCase();
  const titleStr = String(h.data?.title || h.data?.name || "").toLowerCase();
  return !cat.includes('guest') && !titleStr.includes('guest');
}).length;

const totalGuestHousesCount = allHotels.filter(h => {
  const cat = String(h.data?.category || "").toLowerCase();
  const titleStr = String(h.data?.title || h.data?.name || "").toLowerCase();
  return cat.includes('guest') || titleStr.includes('guest');
}).length;

// ৩. ডাইনামিক ক্যাটাগরি অবজেক্ট (সঠিক ইউআরএল সিনট্যাক্স: হ্যাশের আগে কুয়েরি বসানো)
const propertyTypes = [
  {
    title: "Hotels & Luxury Stays",
    count: totalHotelsCount > 0 ? `${totalHotelsCount} verified properties` : "Verified stays",
    image: "https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&w=600&q=75&fm=webp",
    link: "/?type=hotel#hotels"
  },
  {
    title: "Executive Guest Houses",
    count: totalGuestHousesCount > 0 ? `${totalGuestHousesCount} verified properties` : (totalHotelsCount > 0 ? "Available on request" : "Verified stays"),
    image: "https://images.unsplash.com/photo-1590381105924-c72589b9ef3f?auto=format&fit=crop&w=600&q=75&fm=webp",
    link: "/?type=guest-house#hotels"
  }
];
