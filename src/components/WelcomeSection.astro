---
// src/components/WelcomeSection.astro (Authentic Vintage Destination Authority - True Gatlinburg Art Style)
---

<section class="relative bg-[#FAF6F0] pt-28 sm:pt-36 lg:pt-40 pb-16 sm:pb-24 border-b border-amber-900/10 overflow-hidden text-center">
  
  <!-- ================= 1. AUTHENTIC SUNBURST RAYS & VINTAGE SKYLINE ARTWORK ================= -->
  
  <!-- Radiating Sunburst Rays (Center Glow) -->
  <div class="absolute inset-0 flex items-center justify-center pointer-events-none opacity-40">
    <svg class="w-full h-full max-w-[1400px] text-amber-600/15 fill-current" viewBox="0 0 1000 600" preserveAspectRatio="none">
      <!-- Radiating Sunbeams -->
      <polygon points="500,300 0,0 70,0" />
      <polygon points="500,300 160,0 250,0" />
      <polygon points="500,300 360,0 460,0" />
      <polygon points="500,300 540,0 640,0" />
      <polygon points="500,300 750,0 840,0" />
      <polygon points="500,300 930,0 1000,0" />
      <polygon points="500,300 1000,100 1000,180" />
      <polygon points="500,300 1000,280 1000,380" />
      <polygon points="500,300 1000,480 1000,600" />
      <polygon points="500,300 0,100 0,180" />
      <polygon points="500,300 0,280 0,380" />
      <polygon points="500,300 0,480 0,600" />
      <polygon points="500,300 150,600 260,600" />
      <polygon points="500,300 380,600 500,600" />
      <polygon points="500,300 620,600 740,600" />
      <polygon points="500,300 850,600 950,600" />
    </svg>
  </div>

  <!-- Left Authentic Detailed Botanical Tree Art -->
  <div class="absolute -bottom-2 -left-4 sm:left-0 w-36 sm:w-60 lg:w-72 h-52 sm:h-80 opacity-45 pointer-events-none text-slate-700">
    <svg viewBox="0 0 200 300" fill="currentColor" class="w-full h-full object-bottom object-contain">
      <!-- Detailed Tree Trunk & Layered Foliage -->
      <path d="M70,300 L75,220 C60,200 40,190 25,170 C40,165 55,165 65,150 C50,135 30,125 20,105 C35,100 50,102 60,90 C45,75 35,60 25,40 C40,42 55,48 65,35 C55,20 60,10 70,0 C80,10 85,20 75,35 C85,48 100,42 115,40 C105,60 95,75 80,90 C90,102 105,100 120,105 C110,125 90,135 75,150 C85,165 100,165 115,170 C100,190 80,200 65,220 L70,300 Z"/>
      <path d="M140,300 L145,240 C135,220 120,210 110,190 C125,185 135,185 140,170 C130,155 115,145 105,125 C120,120 130,122 135,110 C125,95 118,80 110,65 C120,67 130,70 135,60 C130,48 135,40 140,30 C145,40 150,48 145,60 C150,70 160,67 170,65 C162,80 155,95 145,110 C150,122 160,120 175,125 C165,145 150,155 140,170 C145,185 155,185 170,190 C160,210 145,220 135,240 L140,300 Z" opacity="0.65"/>
    </svg>
  </div>

  <!-- Right Botanical Silhouette (Flipped) -->
  <div class="absolute -bottom-2 -right-4 sm:right-0 w-36 sm:w-60 lg:w-72 h-52 sm:h-80 opacity-45 pointer-events-none text-slate-700 scale-x-[-1]">
    <svg viewBox="0 0 200 300" fill="currentColor" class="w-full h-full object-bottom object-contain">
      <path d="M70,300 L75,220 C60,200 40,190 25,170 C40,165 55,165 65,150 C50,135 30,125 20,105 C35,100 50,102 60,90 C45,75 35,60 25,40 C40,42 55,48 65,35 C55,20 60,10 70,0 C80,10 85,20 75,35 C85,48 100,42 115,40 C105,60 95,75 80,90 C90,102 105,100 120,105 C110,125 90,135 75,150 C85,165 100,165 115,170 C100,190 80,200 65,220 L70,300 Z"/>
      <path d="M140,300 L145,240 C135,220 120,210 110,190 C125,185 135,185 140,170 C130,155 115,145 105,125 C120,120 130,122 135,110 C125,95 118,80 110,65 C120,67 130,70 135,60 C130,48 135,40 140,30 C145,40 150,48 145,60 C150,70 160,67 170,65 C162,80 155,95 145,110 C150,122 160,120 175,125 C165,145 150,155 140,170 C145,185 155,185 170,190 C160,210 145,220 135,240 L140,300 Z" opacity="0.65"/>
    </svg>
  </div>

  <!-- ================= 2. CORE CONTENT ================= -->
  <div class="relative z-10 max-w-[1140px] mx-auto px-4 sm:px-6 lg:px-8 space-y-6 sm:space-y-8">
    
    <!-- Big Bold Gatlinburg Stamped Title -->
    <div class="space-y-2 sm:space-y-3">
      <h2 
        class="text-6xl sm:text-7xl md:text-8xl lg:text-9xl font-black text-[#1e293b] tracking-tight uppercase leading-none select-none drop-shadow-xs"
        style="font-family: 'Impact', 'Arial Black', sans-serif; letter-spacing: 0.04em;"
      >
        GULSHAN
      </h2>
      
      <span class="text-xs sm:text-sm md:text-base font-black uppercase tracking-[0.25em] text-[#8C5828] block">
        OFFICIAL "DIPLOMATIC & HOSPITALITY ENCLAVE"
      </span>
    </div>

    <!-- Editorial Narrative Text -->
    <div class="max-w-3xl mx-auto space-y-3 text-slate-700 font-normal leading-relaxed text-xs sm:text-base">
      <p>
        Where international diplomacy meets world-class hospitality. For foreign diplomats, global corporate leaders, and discerning travelers, Gulshan stands as Bangladesh's most guarded and vibrant metropolitan destination. Experience premier lakeside stays, high-end culinary avenues, and walking access to major foreign embassies.
      </p>

      <!-- Expandable In-Depth SEO Details -->
      <div id="extended-content" class="hidden space-y-3 pt-2 text-xs sm:text-sm text-slate-600 leading-relaxed border-t border-amber-900/10 text-left sm:text-center">
        <p>
          Whether visiting for embassy visa interviews (<strong>US Embassy, IVAC Indian Visa Application Centre, UK Visa Centre, Saudi Embassy</strong>), corporate summits, or a weekend urban retreat, our independent guide tracks verified room rates, high-speed Wi-Fi, and direct reservation lines for <em>The Westin Dhaka, Amari Dhaka, Renaissance Dhaka Gulshan, and Lakeshore Hotel</em>.
        </p>
      </div>

      <!-- Read More Button -->
      <div>
        <button 
          id="read-more-btn" 
          type="button" 
          class="inline-flex items-center gap-1.5 text-xs sm:text-sm font-black text-[#8C5828] hover:text-[#6d411b] underline underline-offset-4 transition cursor-pointer"
        >
          <span id="read-more-text">Read Complete District Narrative</span>
          <span id="read-more-arrow" class="text-xs">▼</span>
        </button>
      </div>
    </div>

    <!-- ================= 3. THREE VINTAGE CIRCULAR ACTION BADGES ================= -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 sm:gap-8 pt-4 sm:pt-8 max-w-3xl mx-auto">
      
      <!-- Badge 1: Official Directory -->
      <a href="/hotels" class="group flex flex-col items-center text-center space-y-2.5 transition transform hover:-translate-y-1">
        <div class="w-14 h-14 sm:w-16 sm:h-16 rounded-full bg-[#8C5828] text-white flex items-center justify-center shadow-md ring-4 ring-[#8C5828]/20 group-hover:bg-[#72451d] group-hover:ring-[#8C5828]/40 group-hover:scale-105 transition-all">
          <svg class="w-6 h-6 sm:w-7 sm:h-7 fill-current" viewBox="0 0 24 24">
            <path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-7 3c1.66 0 3 1.34 3 3s-1.34 3-3 3-3-1.34-3-3 1.34-3 3-3zm3 10H9v-1c0-1 2-1.9 3-1.9s3 .9 3 1.9v1z"/>
          </svg>
        </div>
        <div>
          <span class="text-xs font-semibold text-slate-600 block italic leading-tight">Explore the Official</span>
          <span class="text-sm sm:text-base font-black text-slate-900 uppercase tracking-tight group-hover:text-[#8C5828] transition">HOTEL DIRECTORY</span>
        </div>
      </a>

      <!-- Badge 2: Direct WhatsApp Desk -->
      <a href="https://wa.me/8801700000000?text=Hi!%20I%20need%20help%20with%20Gulshan%20Hotels%20booking" target="_blank" rel="noopener noreferrer" class="group flex flex-col items-center text-center space-y-2.5 transition transform hover:-translate-y-1">
        <div class="w-14 h-14 sm:w-16 sm:h-16 rounded-full bg-[#8C5828] text-white flex items-center justify-center shadow-md ring-4 ring-[#8C5828]/20 group-hover:bg-[#72451d] group-hover:ring-[#8C5828]/40 group-hover:scale-105 transition-all">
          <svg class="w-6 h-6 sm:w-7 sm:h-7 fill-current" viewBox="0 0 24 24">
            <path d="M12.012 2c-5.506 0-9.989 4.478-9.99 9.984 0 1.763.459 3.48 1.332 5.001l-1.416 5.163 5.281-1.388c1.464.798 3.118 1.22 4.79 1.22h.004c5.506 0 9.989-4.478 9.99-9.984 0-2.668-1.038-5.176-2.923-7.062a9.923 9.923 0 0 0-7.058-2.934z"/>
          </svg>
        </div>
        <div>
          <span class="text-xs font-semibold text-slate-600 block italic leading-tight">Direct WhatsApp</span>
          <span class="text-sm sm:text-base font-black text-slate-900 uppercase tracking-tight group-hover:text-[#8C5828] transition">HOTEL CONCIERGE</span>
        </div>
      </a>

      <!-- Badge 3: Verified Stays -->
      <a href="/hotels?area=gulshan-2" class="group flex flex-col items-center text-center space-y-2.5 transition transform hover:-translate-y-1">
        <div class="w-14 h-14 sm:w-16 sm:h-16 rounded-full bg-[#8C5828] text-white flex items-center justify-center shadow-md ring-4 ring-[#8C5828]/20 group-hover:bg-[#72451d] group-hover:ring-[#8C5828]/40 group-hover:scale-105 transition-all">
          <svg class="w-6 h-6 sm:w-7 sm:h-7 fill-current" viewBox="0 0 24 24">
            <path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm-2 16l-4-4 1.41-1.41L10 14.17l6.59-6.59L18 9l-8 8z"/>
          </svg>
        </div>
        <div>
          <span class="text-xs font-semibold text-slate-600 block italic leading-tight">Diplomatic Zone</span>
          <span class="text-sm sm:text-base font-black text-slate-900 uppercase tracking-tight group-hover:text-[#8C5828] transition">VERIFIED STAYS</span>
        </div>
      </a>

    </div>

  </div>
</section>

<!-- SCRIPT -->
<script is:inline>
  const initGatlinburgAccordion = () => {
    const readBtn = document.getElementById('read-more-btn');
    const extContent = document.getElementById('extended-content');
    const readText = document.getElementById('read-more-text');
    const readArrow = document.getElementById('read-more-arrow');

    if (readBtn && extContent && !readBtn.dataset.bound) {
      readBtn.dataset.bound = 'true';
      readBtn.addEventListener('click', () => {
        const isHidden = extContent.classList.contains('hidden');
        if (isHidden) {
          extContent.classList.remove('hidden');
          if (readText) readText.textContent = 'Hide District Narrative';
          if (readArrow) readArrow.textContent = '▲';
        } else {
          extContent.classList.add('hidden');
          if (readText) readText.textContent = 'Read Complete District Narrative';
          if (readArrow) readArrow.textContent = '▼';
        }
      });
    }
  };

  document.addEventListener('DOMContentLoaded', initGatlinburgAccordion);
  document.addEventListener('astro:page-load', initGatlinburgAccordion);
</script>
