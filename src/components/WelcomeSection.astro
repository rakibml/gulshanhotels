---
// src/components/WelcomeSection.astro (Official Authority & Local SEO Section - Hero Overlap Safe)
---

<!-- WELCOME & AUTHORITY OVERVIEW SECTION -->
<section class="relative bg-white pt-24 sm:pt-32 lg:pt-36 pb-14 sm:pb-20 border-b border-slate-100 text-left">
  <div class="max-w-[1240px] mx-auto px-4 sm:px-6 lg:px-8 space-y-8 sm:space-y-10">
    
    <!-- Section Header & Brand Identity -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 border-b border-slate-100 pb-6">
      <div class="space-y-2 max-w-2xl">
        <div class="inline-flex items-center gap-2 bg-blue-50 border border-blue-200/80 px-3 py-1 rounded-full">
          <span class="w-2 h-2 rounded-full bg-[#006ce4]"></span>
          <span class="text-[10px] sm:text-xs font-black uppercase tracking-widest text-[#003b95]">
            About GulshanHotels.com
          </span>
        </div>
        
        <h2 class="text-2xl sm:text-4xl lg:text-5xl font-black font-serif text-slate-900 tracking-tight leading-tight">
          Where Business Meets Diplomatic Luxury
        </h2>
      </div>

      <!-- Verified Authority Tag -->
      <div class="flex items-center gap-2 shrink-0 text-xs font-bold text-slate-500 bg-slate-50 border border-slate-200/80 px-3.5 py-2 rounded-xl">
        <svg class="w-4 h-4 text-emerald-600 shrink-0" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm-2 16l-4-4 1.41-1.41L10 14.17l6.59-6.59L18 9l-8 8z"/>
        </svg>
        <span>Independent Local Guide</span>
      </div>
    </div>

    <!-- 3 Core Authority Feature Pillars (Visual & High-Converting) -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 sm:gap-6">
      
      <!-- Pillar 1 -->
      <div class="p-5 sm:p-6 rounded-2xl bg-slate-50/70 border border-slate-200/80 space-y-2.5 hover:border-slate-300 transition">
        <div class="w-10 h-10 rounded-xl bg-blue-100/80 text-[#006ce4] flex items-center justify-center shrink-0 shadow-2xs">
          <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24"><path d="M12 2L1 7l11 5 9-4.09V17h2V7L12 2zm0 13l-9-4.09V17l9 5 9-5v-6.09L12 15z"/></svg>
        </div>
        <h3 class="text-base font-black text-slate-900">Embassy & Corporate Hub</h3>
        <p class="text-xs sm:text-sm text-slate-600 leading-relaxed font-normal">
          Immediate walking and driving proximity to the US Embassy, IVAC Indian Visa Centre, Saudi Embassy, and multinational corporate headquarters.
        </p>
      </div>

      <!-- Pillar 2 -->
      <div class="p-5 sm:p-6 rounded-2xl bg-slate-50/70 border border-slate-200/80 space-y-2.5 hover:border-slate-300 transition">
        <div class="w-10 h-10 rounded-xl bg-emerald-100/80 text-emerald-800 flex items-center justify-center shrink-0 shadow-2xs">
          <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24"><path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4z"/></svg>
        </div>
        <h3 class="text-base font-black text-slate-900">Diplomatic Security</h3>
        <p class="text-xs sm:text-sm text-slate-600 leading-relaxed font-normal">
          Gulshan 1 and Gulshan 2 boast Bangladesh's most guarded perimeter with 24/7 law enforcement patrols and diplomatic-tier surveillance.
        </p>
      </div>

      <!-- Pillar 3 -->
      <div class="p-5 sm:p-6 rounded-2xl bg-slate-50/70 border border-slate-200/80 space-y-2.5 hover:border-slate-300 transition">
        <div class="w-10 h-10 rounded-xl bg-amber-100/80 text-amber-800 flex items-center justify-center shrink-0 shadow-2xs">
          <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24"><path d="M21.41 11.58l-9-9C12.05 2.22 11.55 2 11 2H4c-1.1 0-2 .9-2 2v7c0 .55.22 1.05.59 1.42l9 9c.36.36.86.58 1.41.58.55 0 1.05-.22 1.41-.59l7-7c.37-.36.59-.86.59-1.41 0-.55-.23-1.06-.59-1.42zM5.5 7C4.67 7 4 6.33 4 5.5S4.67 4 5.5 4 7 4.67 7 5.5 6.33 7 5.5 7z"/></svg>
        </div>
        <h3 class="text-base font-black text-slate-900">Verified Direct Rates</h3>
        <p class="text-xs sm:text-sm text-slate-600 leading-relaxed font-normal">
          Compare OTA rates with direct hotel WhatsApp deals to uncover zero-commission rates and avoid hidden checkout charges.
        </p>
      </div>

    </div>

    <!-- SEO Content Body with Smooth Expandable Accordion -->
    <div class="bg-slate-50 p-6 sm:p-8 rounded-2xl border border-slate-200/80 space-y-4">
      
      <!-- Always Visible Core Introduction -->
      <p class="text-xs sm:text-base leading-relaxed text-slate-700 font-normal">
        For international business leaders, foreign diplomats, non-resident Bangladeshis (NRBs), and discerning travelers, <strong class="font-bold text-slate-900">GulshanHotels.com</strong> serves as the definitive gateway to premier lodging. Whether you require five-star suites overlooking Gulshan Lake or boutique executive residences near Banani, this directory provides unbiased rate tracking, verified guest experiences, and live booking pathways.
      </p>

      <!-- Expandable In-Depth SEO Details (100% Crawlable by Google) -->
      <div id="extended-content" class="hidden space-y-3.5 pt-2 border-t border-slate-200 text-xs sm:text-sm text-slate-600 leading-relaxed">
        <p>
          Whether visiting for international diplomatic missions, corporate summits, or visa interviews at the <strong>US Embassy, IVAC Indian Visa Application Centre, UK Visa Centre, or Saudi Embassy</strong>, our guide simplifies property selection based on proximity and transit ease.
        </p>
        <p>
          Our independent team inspects property safety measures, high-speed Wi-Fi reliability, power backup systems, executive conference facilities, and airport shuttle logistics across renowned establishments including <em>The Westin Dhaka, Renaissance Dhaka Gulshan, Amari Dhaka, and Lakeshore Hotel</em>. We continuously monitor consumer review trends to ensure travelers book with transparent terms.
        </p>
      </div>

      <!-- Action Footer: Read More & Social Channels -->
      <div class="pt-2 flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-t border-slate-200/60">
        <button 
          id="read-more-btn" 
          type="button" 
          class="inline-flex items-center gap-1.5 text-xs sm:text-sm font-bold text-[#006ce4] hover:text-[#003b95] transition cursor-pointer"
        >
          <span id="read-more-text">Read Complete District Guide</span>
          <svg id="read-more-arrow" class="w-3.5 h-3.5 transform transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
          </svg>
        </button>

        <!-- Elegant Official Social Links -->
        <div class="flex items-center gap-2">
          <span class="text-[10px] uppercase font-bold text-slate-400 tracking-wider">Connect:</span>
          
          <a href="https://facebook.com" target="_blank" rel="noopener noreferrer" title="Facebook" class="w-7 h-7 rounded-lg bg-white border border-slate-200 text-slate-600 hover:text-[#1877F2] hover:border-[#1877F2] flex items-center justify-center transition shadow-2xs">
            <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 3.865 10.99 9.1 11.823v-8.367h-3.04v-3.456h3.04v-2.636c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953h-1.513c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.456h-2.796v8.367c5.235-.833 9.1-5.833 9.1-11.823z"/></svg>
          </a>

          <a href="https://instagram.com" target="_blank" rel="noopener noreferrer" title="Instagram" class="w-7 h-7 rounded-lg bg-white border border-slate-200 text-slate-600 hover:text-rose-600 hover:border-rose-300 flex items-center justify-center transition shadow-2xs">
            <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
          </a>

          <a href="https://twitter.com" target="_blank" rel="noopener noreferrer" title="Twitter" class="w-7 h-7 rounded-lg bg-white border border-slate-200 text-slate-600 hover:text-black hover:border-slate-800 flex items-center justify-center transition shadow-2xs">
            <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
          </a>
        </div>
      </div>

    </div>

  </div>
</section>

<!-- ROBUST TOGGLE SCRIPT FOR EXPANDABLE SEO TEXT -->
<script is:inline>
  const initWelcomeAccordion = () => {
    const readBtn = document.getElementById('read-more-btn');
    const extContent = document.getElementById('extended-content');
    const readText = document.getElementById('read-more-text');
    const readArrow = document.getElementById('read-more-arrow');

    if (readBtn && extContent && !readBtn.dataset.bound) {
      readBtn.dataset.bound = 'true';
      readBtn.addEventListener('click', () => {
        const isHidden = extContent.classList.contains('hidden');
        if (isHidden) {
          extContent.classList.remove('hidden');
          if (readText) readText.textContent = 'Show Less Overview';
          if (readArrow) readArrow.classList.add('rotate-180');
        } else {
          extContent.classList.add('hidden');
          if (readText) readText.textContent = 'Read Complete District Guide';
          if (readArrow) readArrow.classList.remove('rotate-180');
        }
      });
    }
  };

  document.addEventListener('DOMContentLoaded', initWelcomeAccordion);
  document.addEventListener('astro:page-load', initWelcomeAccordion);
</script>
