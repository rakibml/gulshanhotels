---
// src/components/WelcomeSection.astro (Prestigious Destination Authority Style - Gatlinburg Inspired)
---

<!-- DESTINATION AUTHORITY WELCOME SECTION -->
<section class="relative bg-[#FAF7F2] pt-28 sm:pt-36 lg:pt-40 pb-16 sm:pb-24 border-b border-amber-900/10 overflow-hidden text-center">
  
  <!-- ================= BACKGROUND GRAPHICS (VINTAGE SUNBURST & SKYLINE SILHOUETTES) ================= -->
  
  <!-- Central Subtle Sunburst Glow Behind Typography -->
  <div class="absolute inset-0 flex items-center justify-center pointer-events-none">
    <div class="w-[320px] sm:w-[600px] lg:w-[800px] h-[320px] sm:h-[600px] bg-[radial-gradient(circle,_rgba(217,119,6,0.08)_0%,_rgba(250,247,242,0)_70%)] rounded-full"></div>
  </div>

  <!-- Left Architectural & Nature Silhouette (Gulshan Avenue & Lakefront Trees) -->
  <div class="absolute bottom-0 -left-6 sm:left-0 w-36 sm:w-64 lg:w-80 h-44 sm:h-72 opacity-20 pointer-events-none text-slate-800">
    <svg viewBox="0 0 300 300" fill="currentColor" class="w-full h-full object-contain object-bottom">
      <!-- Stylized Urban Buildings & Evergreen Silhouette -->
      <path d="M0,300 L0,180 L25,180 L25,140 L50,140 L50,200 L70,200 L70,110 L95,110 L95,80 L115,80 L115,220 L135,220 L135,160 L160,160 L160,300 Z" opacity="0.7"/>
      <path d="M20,300 C30,240 50,200 70,160 C90,200 110,240 120,300 Z" opacity="0.9"/>
      <path d="M80,300 C95,230 115,180 135,140 C155,180 175,230 190,300 Z" opacity="0.85"/>
    </svg>
  </div>

  <!-- Right Skyline & Botanical Silhouette -->
  <div class="absolute bottom-0 -right-6 sm:right-0 w-36 sm:w-64 lg:w-80 h-44 sm:h-72 opacity-20 pointer-events-none text-slate-800 scale-x-[-1]">
    <svg viewBox="0 0 300 300" fill="currentColor" class="w-full h-full object-contain object-bottom">
      <path d="M0,300 L0,190 L30,190 L30,130 L55,130 L55,210 L80,210 L80,95 L105,95 L105,65 L125,65 L125,230 L150,230 L150,170 L175,170 L175,300 Z" opacity="0.7"/>
      <path d="M30,300 C45,235 65,190 85,150 C105,190 125,235 140,300 Z" opacity="0.9"/>
      <path d="M90,300 C110,220 130,170 150,125 C170,170 190,220 210,300 Z" opacity="0.85"/>
    </svg>
  </div>

  <!-- ================= CORE CONTENT CONTAINER ================= -->
  <div class="relative z-10 max-w-[1140px] mx-auto px-4 sm:px-6 lg:px-8 space-y-6 sm:space-y-8">
    
    <!-- 1. Massive Stamped Destination Headline (Gatlinburg Style) -->
    <div class="space-y-2 sm:space-y-3">
      <h2 
        class="font-sans text-5xl sm:text-7xl md:text-8xl lg:text-9xl font-black text-slate-900 tracking-tight uppercase leading-none select-none"
        style="font-family: 'Impact', 'Arial Black', sans-serif; letter-spacing: 0.02em;"
      >
        GULSHAN
      </h2>
      
      <span class="text-xs sm:text-sm md:text-base font-black uppercase tracking-[0.25em] text-amber-900/80 block">
        OFFICIAL "DIPLOMATIC & HOSPITALITY ENCLAVE"
      </span>
    </div>

    <!-- 2. Authoritative Destination Narrative (Rich SEO Context) -->
    <div class="max-w-3xl mx-auto space-y-4 text-slate-700 font-normal leading-relaxed text-xs sm:text-base">
      <p>
        Where international diplomacy meets world-class hospitality. For foreign diplomats, global corporate leaders, and discerning leisure travelers, Gulshan stands as Bangladesh's most guarded and vibrant metropolitan destination. Experience premier lakeside stays, high-end culinary avenues, and walking access to major foreign embassies.
      </p>

      <!-- Expandable In-Depth SEO Details -->
      <div id="extended-content" class="hidden space-y-3 pt-2 text-xs sm:text-sm text-slate-600 leading-relaxed border-t border-amber-900/10 text-left sm:text-center">
        <p>
          Whether visiting for embassy visa interviews (<strong>US Embassy, IVAC Indian Visa Application Centre, UK Visa Centre, Saudi Embassy</strong>), corporate summits, or a weekend urban retreat, our independent guide tracks verified room rates, high-speed Wi-Fi hygiene, and direct reservation lines for <em>The Westin Dhaka, Amari Dhaka, Renaissance Dhaka Gulshan, and Lakeshore Hotel</em>.
        </p>
      </div>

      <!-- Subtle Read More Trigger -->
      <div>
        <button 
          id="read-more-btn" 
          type="button" 
          class="inline-flex items-center gap-1.5 text-xs sm:text-sm font-bold text-amber-900 hover:text-amber-700 underline underline-offset-4 transition cursor-pointer"
        >
          <span id="read-more-text">Read Complete District Narrative</span>
          <span id="read-more-arrow" class="text-xs">▼</span>
        </button>
      </div>
    </div>

    <!-- ================= 3. THREE VINTAGE CIRCULAR ACTION BADGES (EXACT GATLINBURG BENCHMARK) ================= -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 sm:gap-8 pt-6 sm:pt-10 max-w-3xl mx-auto">
      
      <!-- Badge 1: Official Guide -->
      <a href="/hotels" class="group flex flex-col items-center text-center space-y-2.5 transition transform hover:-translate-y-1">
        <div class="w-14 h-14 sm:w-16 sm:h-16 rounded-full bg-[#8C5828] text-white flex items-center justify-center shadow-lg group-hover:bg-[#72451d] group-hover:scale-105 transition-all">
          <svg class="w-6 h-6 sm:w-7 sm:h-7 fill-current" viewBox="0 0 24 24">
            <path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-7 3c1.66 0 3 1.34 3 3s-1.34 3-3 3-3-1.34-3-3 1.34-3 3-3zm3 10H9v-1c0-1 2-1.9 3-1.9s3 .9 3 1.9v1z"/>
          </svg>
        </div>
        <div>
          <span class="text-xs font-semibold text-slate-600 block italic leading-tight">Explore the Official</span>
          <span class="text-sm sm:text-base font-black text-slate-900 uppercase tracking-tight group-hover:text-amber-900 transition">HOTEL DIRECTORY</span>
        </div>
      </a>

      <!-- Badge 2: Direct WhatsApp Desk -->
      <a href="https://wa.me/8801700000000?text=Hi!%20I%20need%20help%20with%20Gulshan%20Hotels%20booking" target="_blank" rel="noopener noreferrer" class="group flex flex-col items-center text-center space-y-2.5 transition transform hover:-translate-y-1">
        <div class="w-14 h-14 sm:w-16 sm:h-16 rounded-full bg-[#8C5828] text-white flex items-center justify-center shadow-lg group-hover:bg-[#72451d] group-hover:scale-105 transition-all">
          <svg class="w-6 h-6 sm:w-7 sm:h-7 fill-current" viewBox="0 0 24 24">
            <path d="M12.012 2c-5.506 0-9.989 4.478-9.99 9.984 0 1.763.459 3.48 1.332 5.001l-1.416 5.163 5.281-1.388c1.464.798 3.118 1.22 4.79 1.22h.004c5.506 0 9.989-4.478 9.99-9.984 0-2.668-1.038-5.176-2.923-7.062a9.923 9.923 0 0 0-7.058-2.934z"/>
          </svg>
        </div>
        <div>
          <span class="text-xs font-semibold text-slate-600 block italic leading-tight">Direct WhatsApp</span>
          <span class="text-sm sm:text-base font-black text-slate-900 uppercase tracking-tight group-hover:text-amber-900 transition">HOTEL CONCIERGE</span>
        </div>
      </a>

      <!-- Badge 3: Verified Stays -->
      <a href="/hotels?area=gulshan-2" class="group flex flex-col items-center text-center space-y-2.5 transition transform hover:-translate-y-1">
        <div class="w-14 h-14 sm:w-16 sm:h-16 rounded-full bg-[#8C5828] text-white flex items-center justify-center shadow-lg group-hover:bg-[#72451d] group-hover:scale-105 transition-all">
          <svg class="w-6 h-6 sm:w-7 sm:h-7 fill-current" viewBox="0 0 24 24">
            <path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm-2 16l-4-4 1.41-1.41L10 14.17l6.59-6.59L18 9l-8 8z"/>
          </svg>
        </div>
        <div>
          <span class="text-xs font-semibold text-slate-600 block italic leading-tight">Diplomatic Zone</span>
          <span class="text-sm sm:text-base font-black text-slate-900 uppercase tracking-tight group-hover:text-amber-900 transition">VERIFIED STAYS</span>
        </div>
      </a>

    </div>

  </div>
</section>

<!-- SCRIPT FOR READ MORE TOGGLE -->
<script is:inline>
  const initGatlinburgAccordion = () => {
    const readBtn = document.getElementById('read-more-btn');
    const extContent = document.getElementById('extended-content');
    const readText = document.getElementById('read-more-text');
    const readArrow = document.getElementById('read-more-arrow');

    if (readBtn && extContent && !readBtn.dataset.bound) {
      readBtn.dataset.bound = 'true';
      readBtn.addEventListener('click', () => {
        const isHidden = extContent.classList.contains('hidden');
        if (isHidden) {
          extContent.classList.remove('hidden');
          if (readText) readText.textContent = 'Hide District Narrative';
          if (readArrow) readArrow.textContent = '▲';
        } else {
          extContent.classList.add('hidden');
          if (readText) readText.textContent = 'Read Complete District Narrative';
          if (readArrow) readArrow.textContent = '▼';
        }
      });
    }
  };

  document.addEventListener('DOMContentLoaded', initGatlinburgAccordion);
  document.addEventListener('astro:page-load', initGatlinburgAccordion);
</script>
