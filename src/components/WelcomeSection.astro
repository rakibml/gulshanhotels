---
// src/components/BrowsePropertyTypes.astro (Clean 2-Column Property Type Showcase)

interface Props {
  title?: string;
  subtitle?: string;
}

const { 
  title = "Browse by Property Type", 
  subtitle = "Whether you seek full-service 5-star hotel luxury or quiet, boutique guest house privacy in Gulshan."
} = Astro.props;

const propertyTypes = [
  {
    title: "Gulshan Hotels",
    typeBadge: "Full-Service Luxury",
    badgeColor: "bg-emerald-50 text-emerald-800 border-emerald-200",
    description: "Experience world-class hospitality featuring 24/7 room service, rooftop infinity pools, multi-cuisine breakfast buffets, and diplomatic-grade security.",
    highlights: ["24/7 Concierge", "Rooftop Pools & Spa", "Executive Boardrooms"],
    meta: "15+ Verified Properties • From $60 / night",
    image: "https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&w=900&q=80",
    link: "/#hotels",
    btnText: "Explore Gulshan Hotels ➔"
  },
  {
    title: "Gulshan Guest Houses",
    typeBadge: "Homely & Private Stays",
    badgeColor: "bg-amber-50 text-amber-800 border-amber-200",
    description: "Intimate boutique guest houses nestled in quiet diplomatic avenues. Ideal for long stays, family visits, and embassy interviews with home-style comfort.",
    highlights: ["Quiet Residential Zones", "Kitchenette Options", "Long-Stay Friendly"],
    meta: "8+ Curated Guest Houses • From $35 / night",
    image: "https://images.unsplash.com/photo-1582719478250-c89cae4dc85b?auto=format&fit=crop&w=900&q=80",
    link: "/#hotels",
    btnText: "Explore Guest Houses ➔"
  }
];
---

<!-- BROWSE BY PROPERTY TYPE (CLEAN SHADOW-FREE LUXURY) -->
<section id="property-types" class="w-full bg-white pt-8 pb-14 text-slate-900 border-b border-slate-100">
  <div class="max-w-[1550px] mx-auto px-4 sm:px-8 lg:px-12 space-y-8">
    
    <!-- Section Header -->
    <div class="space-y-1.5 text-left">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-50 text-emerald-800 text-[11px] font-black uppercase tracking-wider mb-0.5">
        <span>🏨 Accommodations Style</span>
      </div>
      <h2 class="text-3xl sm:text-4xl font-serif font-black text-slate-900 tracking-tight leading-tight">
        {title}
      </h2>
      <p class="text-xs sm:text-sm text-slate-500 font-medium max-w-2xl">
        {subtitle}
      </p>
    </div>

    <!-- 2-COLUMN BALANCED SHOWCASE GRID -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 text-left">
      {propertyTypes.map((item) => (
        <a 
          href={item.link} 
          class="group block bg-white rounded-3xl border border-slate-200 hover:border-slate-400 p-5 sm:p-7 transition-all duration-300 cursor-pointer"
        >
          <!-- Photo Header (Clean Aspect Ratio with subtle zoom) -->
          <div class="relative aspect-[16/9] w-full rounded-2xl overflow-hidden bg-slate-100 mb-6">
            <img 
              src={item.image} 
              alt={item.title} 
              loading="lazy" 
              decoding="async" 
              class="w-full h-full object-cover group-hover:scale-103 transition-transform duration-500" 
            />

            <!-- Top Badge -->
            <div class="absolute top-3 left-3 z-10">
              <span class={`inline-block text-[11px] font-black uppercase tracking-wider px-3 py-1 rounded-full border backdrop-blur-md ${item.badgeColor}`}>
                {item.typeBadge}
              </span>
            </div>
          </div>

          <!-- Card Content Body -->
          <div class="space-y-3">
            <div class="space-y-1">
              <h3 class="text-2xl sm:text-3xl font-black text-slate-900 tracking-tight group-hover:text-emerald-800 transition-colors">
                {item.title}
              </h3>
              <p class="text-xs sm:text-sm text-slate-600 font-normal leading-relaxed">
                {item.description}
              </p>
            </div>

            <!-- Perks / Highlights Tags -->
            <div class="flex flex-wrap gap-2 pt-1">
              {item.highlights.map((h) => (
                <span class="text-[11px] font-bold text-slate-700 bg-slate-50 border border-slate-200 px-2.5 py-1 rounded-lg">
                  ✓ {h}
                </span>
              ))}
            </div>

            <!-- Price & Count Info -->
            <div class="pt-2 border-t border-slate-100 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
              <span class="text-xs font-bold text-slate-500">
                {item.meta}
              </span>

              <!-- Action Link -->
              <span class="inline-flex items-center gap-1 text-xs font-black text-[#0d3b23] group-hover:text-emerald-700 uppercase tracking-wider transition-colors">
                {item.btnText}
              </span>
            </div>
          </div>
        </a>
      ))}
    </div>

  </div>
</section>
