---
// src/components/BrowsePropertyTypes.astro (Clean & Compact Property Types)

interface Props {
  title?: string;
}

const { 
  title = "Browse by Property Type"
} = Astro.props;

// গুলশানের বাস্তবসম্মত ও মার্জিত ছবি
const propertyTypes = [
  {
    title: "Gulshan Hotels",
    count: "15+ properties",
    image: "https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&w=600&q=80",
    link: "/#hotels"
  },
  {
    title: "Gulshan Guest Houses",
    count: "8+ properties",
    image: "https://images.unsplash.com/photo-1590381105924-c72589b9ef3f?auto=format&fit=crop&w=600&q=80",
    link: "/#hotels"
  }
];
---

<!-- BROWSE BY PROPERTY TYPE (COMPACT & CLEAN) -->
<section id="property-types" class="w-full bg-white pt-6 pb-12 text-slate-900 border-b border-slate-100">
  <div class="max-w-[1550px] mx-auto px-4 sm:px-8 lg:px-12 space-y-4">
    
    <!-- শুধুমাত্র ক্লিন টাইটেল (ব্যাজ ও সাব-টাইটেল বাদ) -->
    <div class="text-left">
      <h2 class="text-2xl sm:text-3xl font-serif font-black text-slate-900 tracking-tight">
        {title}
      </h2>
    </div>

    <!-- ছোট ও পরিচ্ছন্ন থাম্বনেইল কার্ড (Booking.com স্টাইল) -->
    <div class="flex flex-wrap gap-5 sm:gap-6 text-left">
      {propertyTypes.map((item) => (
        <a 
          href={item.link} 
          class="group block w-[calc(50%-10px)] sm:w-[280px] lg:w-[300px] cursor-pointer"
        >
          <!-- ছোট কম্প্যাক্ট ইমেজ (Aspect 4:3) -->
          <div class="relative aspect-[4/3] w-full rounded-2xl overflow-hidden bg-slate-100 border border-slate-200/80 group-hover:border-slate-400 transition-colors">
            <img 
              src={item.image} 
              alt={item.title} 
              loading="lazy" 
              decoding="async" 
              class="w-full h-full object-cover group-hover:scale-104 transition-transform duration-300" 
            />
          </div>

          <!-- শুধুমাত্র টাইটেল এবং প্রপার্টি সংখ্যা -->
          <div class="pt-2.5">
            <h3 class="font-bold text-slate-900 text-base sm:text-lg leading-tight group-hover:text-emerald-800 transition-colors">
              {item.title}
            </h3>
            <span class="text-xs text-slate-500 font-normal block mt-0.5">
              {item.count}
            </span>
          </div>
        </a>
      ))}
    </div>

  </div>
</section>
