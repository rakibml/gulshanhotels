---
// src/components/WelcomeSection.astro
---

<!-- GOOGLE FONTS FOR LUXURY SCRIPT & SERIF -->
<style>
  @import url('https://fonts.googleapis.com/css2?family=Alex+Brush&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&display=swap');
  
  .font-script {
    font-family: 'Alex Brush', cursive;
  }
  .font-luxury-serif {
    font-family: 'Playfair Display', Georgia, serif;
  }
</style>

<!-- LUXURY CENTERED WELCOME SECTION -->
<section class="bg-white py-14 sm:py-20 border-b border-slate-100 text-center relative overflow-hidden">
  
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- 1. TOP ACCENT CURSIVE/SCRIPT TEXT (ইমেজের মতো) -->
    <span class="block font-script text-3xl sm:text-4xl text-[#c06b52] mb-1 font-normal tracking-wide">
      A Diplomatic Icon
    </span>

    <!-- 2. MAIN ELEGANT HEADING -->
    <h2 class="font-luxury-serif text-3xl sm:text-4xl lg:text-5xl font-normal text-slate-900 tracking-tight leading-tight mb-6">
      Hotels In Gulshan, Dhaka
    </h2>

    <!-- 3. CENTERED LUXURY DESCRIPTION -->
    <div class="text-slate-600 text-sm sm:text-[15px] lg:text-base leading-relaxed space-y-4 font-normal max-w-2xl mx-auto">
      <p>
        At Gulshan, business meets diplomatic luxury. For international leaders, foreign diplomats, non-resident Bangladeshis, and discerning travelers, <strong class="font-semibold text-slate-800">GulshanHotels.com</strong> is where your journey begins. As the premier accommodation directory for Gulshan 1, Gulshan 2, and the Diplomatic Zone, this is your trusted source for verified 5-star stays, embassy proximity, and fine dining.
      </p>

      <!-- Expandable In-Depth SEO Details -->
      <div id="extended-content" class="hidden space-y-4 pt-2 text-slate-500 text-xs sm:text-sm leading-relaxed border-t border-slate-100 mt-3">
        <p>
          Whether you are visiting Gulshan for foreign embassy visa interviews (US Embassy, IVAC Indian Visa Center, UK Visa Application Centre, Saudi Embassy), high-profile corporate summits, or a weekend urban getaway, Gulshan offers Bangladesh's most secure and vibrant hospitality ecosystem.
        </p>
        <p>
          Our independent audit team routinely inspects room amenities, high-speed Wi-Fi speeds, swimming pool hygiene, rooftop dining options, and airport shuttle reliability across all major properties including The Westin Dhaka, Renaissance Dhaka, Amari Dhaka, and Lakeshore Hotel.
        </p>
      </div>

      <!-- READ MORE BUTTON (CENTERED & ELEGANT) -->
      <div class="pt-2">
        <button 
          id="read-more-btn" 
          type="button" 
          class="inline-flex items-center gap-1.5 font-medium text-xs tracking-widest uppercase text-slate-800 hover:text-[#c06b52] border-b border-slate-300 pb-0.5 transition cursor-pointer"
        >
          <span id="read-more-text">Read More</span>
          <span id="read-more-arrow" class="text-[9px] inline-block transition-transform duration-300">▼</span>
        </button>
      </div>
    </div>

    <!-- 4. SUBTLE CENTERED SOCIAL ICONS -->
    <div class="flex items-center justify-center gap-4 mt-8 pt-6 border-t border-slate-100 max-w-xs mx-auto">
      <a href="https://facebook.com" target="_blank" rel="noopener noreferrer" title="Facebook" class="w-8 h-8 rounded-full bg-slate-50 hover:bg-[#1877F2] text-slate-500 hover:text-white flex items-center justify-center transition-all duration-300 border border-slate-200">
        <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 3.865 10.99 9.1 11.823v-8.367h-3.04v-3.456h3.04v-2.636c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953h-1.513c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.456h-2.796v8.367c5.235-.833 9.1-5.833 9.1-11.823z"/></svg>
      </a>

      <a href="https://instagram.com" target="_blank" rel="noopener noreferrer" title="Instagram" class="w-8 h-8 rounded-full bg-slate-50 hover:bg-gradient-to-tr hover:from-amber-500 hover:via-rose-500 hover:to-purple-600 text-slate-500 hover:text-white flex items-center justify-center transition-all duration-300 border border-slate-200">
        <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
      </a>

      <a href="https://twitter.com" target="_blank" rel="noopener noreferrer" title="Twitter (X)" class="w-8 h-8 rounded-full bg-slate-50 hover:bg-black text-slate-500 hover:text-white flex items-center justify-center transition-all duration-300 border border-slate-200">
        <svg class="w-3 h-3 fill-current" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
      </a>
    </div>

  </div>
</section>

<!-- READ MORE TOGGLE SCRIPT -->
<script is:inline>
  const initWelcomeSectionToggle = () => {
    const readBtn = document.getElementById('read-more-btn');
    const extContent = document.getElementById('extended-content');
    const readText = document.getElementById('read-more-text');
    const readArrow = document.getElementById('read-more-arrow');

    if (readBtn && extContent && !readBtn.dataset.bound) {
      readBtn.dataset.bound = 'true';
      readBtn.addEventListener('click', () => {
        const isHidden = extContent.classList.contains('hidden');
        if (isHidden) {
          extContent.classList.remove('hidden');
          if (readText) readText.innerText = 'Read Less';
          if (readArrow) readArrow.style.transform = 'rotate(180deg)';
        } else {
          extContent.classList.add('hidden');
          if (readText) readText.innerText = 'Read More';
          if (readArrow) readArrow.style.transform = 'rotate(0deg)';
        }
      });
    }
  };

  document.addEventListener('DOMContentLoaded', initWelcomeSectionToggle);
  document.addEventListener('astro:page-load', initWelcomeSectionToggle);
</script>
