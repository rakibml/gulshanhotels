---
// src/components/AllHotelsDirectory.astro (100% Booking.com Exact Pattern)
import { getCollection } from 'astro:content';

interface Props {
  title?: string;
  subtitle?: string;
}

const { 
  title = "All Hotels in Gulshan", 
  subtitle = "Handpicked & verified stays in Gulshan. Explore, filter, and book your ideal stay." 
} = Astro.props;

// 1. Fetch Hotels
let rawHotels: any[] = [];
try {
  const allHotels = await getCollection('hotels');
  if (Array.isArray(allHotels)) rawHotels = allHotels;
} catch (e) {
  rawHotels = [];
}

if (!rawHotels || rawHotels.length === 0) {
  try {
    const rawGlob = import.meta.glob('/src/content/hotels/*.md', { eager: true });
    rawHotels = Object.entries(rawGlob).map(([filePath, item]: [string, any]) => ({
      slug: filePath.split('/').pop()?.replace('.md', ''),
      data: item.frontmatter || {}
    }));
  } catch (e) {
    rawHotels = [];
  }
}

// Deduplicate Hotels
const uniqueHotelsMap = new Map();
rawHotels.forEach(h => {
  const key = String(h.data?.title || h.data?.name || h.slug || h.id || '').trim().toLowerCase();
  if (key && !uniqueHotelsMap.has(key)) {
    uniqueHotelsMap.set(key, h);
  }
});
const hotels = Array.from(uniqueHotelsMap.values());
const totalHotelsCount = hotels.length;

// 2. Fetch Reviews
let allCmsReviews: any[] = [];
try {
  const reviewsCol = await getCollection('reviews');
  if (Array.isArray(reviewsCol) && reviewsCol.length > 0) {
    allCmsReviews = reviewsCol.map(r => r.data || {});
  }
} catch (e) {}

if (allCmsReviews.length === 0) {
  try {
    const rawGlob = import.meta.glob('/src/content/reviews/*.md', { eager: true });
    Object.values(rawGlob).forEach((mod: any) => {
      if (mod && mod.frontmatter) {
        allCmsReviews.push(mod.frontmatter);
      }
    });
  } catch (err) {
    allCmsReviews = [];
  }
}

// Star Counts
let count5Star = 0;
let count4Star = 0;
let count3Star = 0;

hotels.forEach(h => {
  const cat = String(h.data?.starCategory || h.data?.category || '').toLowerCase();
  if (cat.includes('5')) count5Star++;
  else if (cat.includes('4')) count4Star++;
  else count3Star++;
});

// Helpers
const toTitleCase = (str: string) => {
  return str.toLowerCase().split(' ').map(w => w.charAt(0).toUpperCase() + w.slice(1)).join(' ');
};

const extractAmenityName = (item: any): string => {
  if (!item) return '';
  if (typeof item === 'string') return item;
  if (typeof item === 'object') {
    return item.name || item.title || item.label || item.amenity || Object.values(item)[0] || '';
  }
  return String(item);
};

const cleanPriceString = (priceRaw: string) => {
  if (!priceRaw) return 'Contact for Rates';
  let p = priceRaw.replace(/night/gi, '').replace(/\//g, '').trim();
  if (p.startsWith('$') || p.startsWith('৳')) return p;
  if (/^\d/.test(p)) return `৳ ${p}`;
  return priceRaw;
};

// SVG Vector Icons
const svgMap: Record<string, string> = {
  locationPin: `<svg class="w-3.5 h-3.5 fill-slate-700 shrink-0" viewBox="0 0 24 24"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>`,
  search: `<svg class="w-4 h-4 fill-slate-400 shrink-0" viewBox="0 0 24 24"><path d="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/></svg>`,
  gridIcon: `<svg class="w-4 h-4 fill-current shrink-0" viewBox="0 0 24 24"><path d="M4 11h6a1 1 0 0 0 1-1V4a1 1 0 0 0-1-1H4a1 1 0 0 0-1 1v6a1 1 0 0 0 1 1zm10 0h6a1 1 0 0 0 1-1V4a1 1 0 0 0-1-1h-6a1 1 0 0 0-1 1v6a1 1 0 0 0 1 1zM4 21h6a1 1 0 0 0 1-1v-6a1 1 0 0 0-1-1H4a1 1 0 0 0-1 1v6a1 1 0 0 0 1 1zm10 0h6a1 1 0 0 0 1-1v-6a1 1 0 0 0-1-1h-6a1 1 0 0 0-1 1v6a1 1 0 0 0 1 1z"/></svg>`,
  listIcon: `<svg class="w-4 h-4 fill-current shrink-0" viewBox="0 0 24 24"><path d="M4 10.5c-.83 0-1.5.67-1.5 1.5s.67 1.5 1.5 1.5 1.5-.67 1.5-1.5-.67-1.5-1.5-1.5zm0-6c-.83 0-1.5.67-1.5 1.5S3.17 7.5 4 7.5 5.5 6.83 5.5 6 4.83 4.5 4 4.5zm0 12c-.83 0-1.5.68-1.5 1.5s.68 1.5 1.5 1.5 1.5-.68 1.5-1.5-.67-1.5-1.5-1.5zM7 19h14v-2H7v2zm0-6h14v-2H7v2zm0-8v2h14V5H7z"/></svg>`
};
---

<!-- ALL HOTELS DIRECTORY SECTION -->
<section id="all-hotels-directory" class="bg-[#F8FAF9] py-8 px-4 sm:px-8 lg:px-12 max-w-[1550px] mx-auto text-slate-900 border-b border-slate-200/80">
  <div class="space-y-5">
    
    <!-- TOP HEADER -->
    <div class="flex flex-col lg:flex-row justify-between items-start lg:items-center gap-4 bg-white p-4 rounded-xl border border-slate-200 shadow-2xs">
      <div>
        <div class="flex items-center gap-2">
          <h2 class="text-xl sm:text-2xl font-black font-sans text-slate-900 tracking-tight">
            {title}
          </h2>
          <span class="bg-[#003b95]/10 text-[#003b95] text-xs font-black px-2.5 py-0.5 rounded-full" id="dirTotalHotelsDisplay">
            {totalHotelsCount} properties found
          </span>
        </div>
        {subtitle && (
          <p class="text-xs sm:text-sm text-slate-500 font-medium mt-0.5">
            {subtitle}
          </p>
        )}
      </div>

      <!-- SEARCH, SORT & VIEW TOGGLES -->
      <div class="flex flex-wrap items-center gap-3 w-full lg:w-auto">
        <!-- Search Input -->
        <div class="relative flex-1 sm:w-64">
          <input 
            type="text" 
            id="dirSearchInput" 
            placeholder="Search property name..." 
            class="w-full bg-slate-50 border border-slate-200 rounded-lg pl-9 pr-4 py-2 text-xs text-slate-800 focus:bg-white focus:outline-none focus:ring-2 focus:ring-[#006ce4]/20 focus:border-[#006ce4] transition font-medium"
          />
          <div class="absolute left-3 top-1/2 -translate-y-1/2 pointer-events-none">
            <span set:html={svgMap.search} class="inline-flex"></span>
          </div>
        </div>

        <!-- Sort Select -->
        <div class="flex items-center gap-1.5 text-xs font-bold text-slate-700 bg-slate-50 border border-slate-200 rounded-lg px-3 py-2">
          <span class="text-slate-400 font-normal">Sort by:</span>
          <select id="dirSortSelect" class="bg-transparent text-slate-900 font-extrabold focus:outline-none cursor-pointer">
            <option value="recommended">Top picks</option>
            <option value="rating-high">Review score (highest first)</option>
            <option value="price-low">Price (lowest first)</option>
            <option value="price-high">Price (highest first)</option>
          </select>
        </div>

        <!-- View Toggles -->
        <div class="hidden sm:flex items-center bg-slate-100 border border-slate-200 rounded-lg p-1">
          <button id="viewListBtn" aria-label="List View" class="p-1.5 rounded-md bg-[#006ce4] text-white transition cursor-pointer shadow-xs">
            <span set:html={svgMap.listIcon} class="inline-flex"></span>
          </button>
          <button id="viewGridBtn" aria-label="Grid View" class="p-1.5 rounded-md text-slate-500 hover:text-slate-900 transition cursor-pointer">
            <span set:html={svgMap.gridIcon} class="inline-flex"></span>
          </button>
        </div>
      </div>
    </div>

    <!-- MAIN CONTENT LAYOUT -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
      
      <!-- LEFT SIDEBAR FILTER PANEL -->
      <aside class="lg:col-span-3 bg-white rounded-xl border border-slate-200 p-5 space-y-6 shadow-2xs text-left sticky top-24">
        
        <div class="flex items-center justify-between border-b border-slate-100 pb-3">
          <h3 class="font-bold text-slate-900 text-sm">
            Filter by:
          </h3>
          <button id="resetAllFiltersBtn" class="text-xs font-bold text-[#006ce4] hover:underline cursor-pointer">
            Reset all
          </button>
        </div>

        <!-- Star Rating -->
        <div class="space-y-3">
          <h4 class="font-bold text-slate-900 text-xs uppercase tracking-wider">
            Property rating
          </h4>

          <div class="space-y-2 text-xs font-medium text-slate-700">
            {count5Star > 0 && (
              <label class="flex items-center justify-between cursor-pointer p-1 rounded hover:bg-slate-50">
                <div class="flex items-center gap-2">
                  <input type="checkbox" class="filter-star-cb w-4 h-4 accent-[#006ce4] rounded cursor-pointer" value="5" />
                  <span class="flex items-center gap-1 font-semibold text-slate-800">
                    5 stars <span class="text-[#febb02] text-sm">★★★★★</span>
                  </span>
                </div>
                <span class="text-slate-400 text-[11px]">{count5Star}</span>
              </label>
            )}

            {count4Star > 0 && (
              <label class="flex items-center justify-between cursor-pointer p-1 rounded hover:bg-slate-50">
                <div class="flex items-center gap-2">
                  <input type="checkbox" class="filter-star-cb w-4 h-4 accent-[#006ce4] rounded cursor-pointer" value="4" />
                  <span class="flex items-center gap-1 font-semibold text-slate-800">
                    4 stars <span class="text-[#febb02] text-sm">★★★★</span>
                  </span>
                </div>
                <span class="text-slate-400 text-[11px]">{count4Star}</span>
              </label>
            )}

            {count3Star > 0 && (
              <label class="flex items-center justify-between cursor-pointer p-1 rounded hover:bg-slate-50">
                <div class="flex items-center gap-2">
                  <input type="checkbox" class="filter-star-cb w-4 h-4 accent-[#006ce4] rounded cursor-pointer" value="3" />
                  <span class="flex items-center gap-1 font-semibold text-slate-800">
                    3 stars <span class="text-[#febb02] text-sm">★★★</span>
                  </span>
                </div>
                <span class="text-slate-400 text-[11px]">{count3Star}</span>
              </label>
            )}
          </div>
        </div>

        <!-- Budget Slider -->
        <div class="space-y-3 border-t border-slate-100 pt-4">
          <div class="flex justify-between items-center">
            <h4 class="font-bold text-slate-900 text-xs uppercase tracking-wider">
              Your budget (per night)
            </h4>
            <span id="priceRangeValueDisplay" class="text-xs font-bold text-[#006ce4]">
              ৳60,000+
            </span>
          </div>

          <div class="space-y-2 pt-1">
            <input 
              type="range" 
              id="priceRangeSlider" 
              min="2000" 
              max="60000" 
              step="1000" 
              value="60000" 
              class="w-full accent-[#006ce4] cursor-pointer h-1.5 bg-slate-200 rounded-lg" 
            />
            <div class="flex justify-between text-[11px] text-slate-400">
              <span>৳2,000</span>
              <span>৳60,000</span>
            </div>
          </div>
        </div>

      </aside>

      <!-- RIGHT SIDE: BOOKING.COM CARDS -->
      <div class="lg:col-span-9">
        
        <div id="directoryCardsGrid" class="grid grid-cols-1 gap-4 items-stretch">
          {hotels.map((hotelItem: any) => {
            const hData = hotelItem.data || {};
            const rawTitle = String(hData.title || hData.name || "").trim();
            const hTitle = toTitleCase(rawTitle);
            const hSlug = String(hData.slug || hotelItem.slug || hotelItem.id || "").trim();
            const hImage = hData.image || (Array.isArray(hData.gallery) ? hData.gallery[0] : "");
            
            // Location
            let hLocation = String(hData.location || hData.category || "Gulshan, Dhaka").trim();
            if (hLocation.includes('Gulshan 2')) hLocation = 'Gulshan 2, Dhaka';
            else if (hLocation.includes('Gulshan 1')) hLocation = 'Gulshan 1, Dhaka';
            else if (hLocation.length > 30) hLocation = 'Gulshan, Dhaka';

            const rawPrice = hData.price ? String(hData.price).trim() : "";
            const displayPrice = cleanPriceString(rawPrice);

            // Star Count
            const rawCat = String(hData.starCategory || hData.category || '').toLowerCase();
            const starCount = rawCat.includes('5') ? 5 : (rawCat.includes('4') ? 4 : (rawCat.includes('3') ? 3 : 0));
            const starCategory = starCount > 0 ? `${starCount}-Star Hotel` : '';

            // Description / Snippet
            const hSnippet = hData.description || hData.excerpt || hData.about || `${hTitle} offers air-conditioned rooms, free WiFi, and top-tier hospitality in the heart of Gulshan, Dhaka.`;

            const hTitleLower = rawTitle.toLowerCase();
            const hSlugLower = hSlug.toLowerCase();

            // Real Reviews
            const matchedCmsReviews = allCmsReviews.filter(r => {
              if (!r) return false;
              const isApproved = r.approved === true || String(r.approved).toLowerCase() === 'true';
              if (!isApproved) return false;

              const rHotel = String(r.hotel || '').trim().toLowerCase();
              const rSlug = String(r.slug || r.hotelSlug || '').trim().toLowerCase();

              return (rSlug && rSlug === hSlugLower) || (rHotel && rHotel === hTitleLower);
            });

            const embedded = Array.isArray(hData.reviews) ? hData.reviews : [];
            const finalReviewsList = matchedCmsReviews.length > 0 ? matchedCmsReviews : embedded;

            const realCount = finalReviewsList.length;
            let realRating: string | null = null;

            if (realCount > 0) {
              const totalStars = finalReviewsList.reduce((sum: number, r: any) => {
                const num = parseFloat(r.rating);
                return sum + (!isNaN(num) && num > 0 && num <= 5 ? num : 5);
              }, 0);
              // Scale to 10 if 5-point, or keep exact score
              const avg = totalStars / realCount;
              realRating = (avg >= 4.5) ? (avg * 2).toFixed(1) : (avg * 2).toFixed(1);
            }

            const numRating = parseFloat(realRating || '0');
            const numericPrice = parseFloat(rawPrice.replace(/[^0-9]/g, '')) || 0;

            let ratingLabel = 'Wonderful';
            if (numRating < 9.0 && numRating >= 8.0) ratingLabel = 'Very Good';
            else if (numRating < 8.0 && numRating > 0) ratingLabel = 'Good';

            return (
              <div 
                class="directory-card-item bg-white rounded-xl border border-slate-200/90 overflow-hidden shadow-2xs hover:shadow-md transition duration-200 text-left relative flex flex-col md:flex-row p-4 gap-4"
                data-title={hTitleLower}
                data-stars={starCount.toString()}
                data-numeric-price={numericPrice}
                data-numeric-rating={numRating}
              >
                <!-- LEFT: Image Box -->
                <div class="relative w-full md:w-56 h-48 md:h-auto shrink-0 rounded-lg overflow-hidden bg-slate-100">
                  {hImage ? (
                    <img 
                      src={hImage} 
                      alt={`${hTitle} Photo`} 
                      loading="lazy" 
                      decoding="async" 
                      class="w-full h-full object-cover hover:scale-105 transition duration-500" 
                    />
                  ) : (
                    <div class="w-full h-full flex items-center justify-center bg-slate-100 text-slate-400 text-xs font-bold">
                      Hotel Photo
                    </div>
                  )}

                  <!-- Wishlist Heart Button -->
                  <button 
                    type="button"
                    class="card-wishlist-btn absolute top-2.5 right-2.5 w-7 h-7 rounded-full bg-white/90 hover:bg-white text-slate-800 flex items-center justify-center shadow transition cursor-pointer hover:scale-110 z-20"
                    data-title={hTitle}
                    data-image={hImage}
                    data-url={`/${hSlug}`}
                    data-price={displayPrice}
                    aria-label="Save to Wishlist"
                  >
                    <svg class="w-3.5 h-3.5 text-slate-700 transition" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path></svg>
                  </button>
                </div>

                <!-- RIGHT: Middle Info & Booking Column -->
                <div class="flex-1 flex flex-col justify-between">
                  
                  <!-- Top Row: Title, Stars & Review Score -->
                  <div>
                    <div class="flex items-start justify-between gap-3">
                      <div>
                        <!-- Title & Yellow Stars -->
                        <div class="flex items-center gap-1.5 flex-wrap">
                          <a href={`/${hSlug}`} class="text-base sm:text-lg font-bold text-[#006ce4] hover:text-[#003b95] hover:underline transition">
                            {hTitle}
                          </a>
                          {starCount > 0 && (
                            <span class="text-[#febb02] text-sm tracking-tight inline-block">
                              {'★'.repeat(starCount)}
                            </span>
                          )}
                        </div>

                        <!-- Location with Map Pin -->
                        <div class="flex items-center gap-1 text-xs text-slate-600 font-medium mt-1">
                          <span set:html={svgMap.locationPin} class="inline-flex"></span>
                          <span class="hover:underline cursor-pointer">{hLocation}</span>
                        </div>
                      </div>

                      <!-- Booking.com Navy Blue Score Box -->
                      {realRating ? (
                        <div class="flex items-center gap-2 shrink-0">
                          <div class="text-right">
                            <div class="text-xs font-bold text-slate-900 leading-tight">{ratingLabel}</div>
                            <div class="text-[11px] text-slate-500 leading-tight">{realCount} reviews</div>
                          </div>
                          <div class="bg-[#003b95] text-white font-bold text-sm px-2 py-1 rounded-t-lg rounded-br-lg leading-none shadow-2xs">
                            {realRating}
                          </div>
                        </div>
                      ) : (
                        <div class="bg-slate-100 text-slate-600 text-[11px] font-bold px-2 py-1 rounded-md">
                          New to site
                        </div>
                      )}
                    </div>

                    <!-- Description Snippet -->
                    <p class="text-xs text-slate-600 mt-2.5 line-clamp-2 leading-relaxed">
                      {hSnippet}
                    </p>
                    <a href={`/${hSlug}`} class="text-xs font-bold text-[#006ce4] hover:underline inline-block mt-0.5">
                      Show more
                    </a>
                  </div>

                  <!-- Bottom Row: Price & Check Availability Button -->
                  <div class="mt-4 pt-3 border-t border-slate-100 flex items-end justify-between gap-3">
                    <div>
                      <span class="bg-emerald-50 text-emerald-800 text-[10px] font-bold px-2 py-0.5 rounded border border-emerald-200 inline-block mb-1">
                        Free cancellation available
                      </span>
                    </div>

                    <div class="text-right shrink-0">
                      <span class="text-[11px] text-slate-500 block leading-tight">Price from</span>
                      <span class="text-lg sm:text-xl font-extrabold text-[#008234] block leading-tight my-0.5">
                        {displayPrice}
                      </span>
                      <span class="text-[10px] text-slate-400 block mb-2 leading-tight">1 night, 2 adults</span>

                      <a 
                        href={`/${hSlug}`} 
                        class="bg-[#006ce4] hover:bg-[#0057b8] text-white text-xs font-bold px-4 py-2 rounded-lg transition inline-flex items-center justify-center gap-1 shadow-2xs hover:shadow"
                      >
                        <span>Check availability</span>
                        <span class="text-xs">›</span>
                      </a>
                    </div>

                  </div>

                </div>

              </div>
            );
          })}
        </div>

      </div>

    </div>

  </div>
</section>

<!-- CLIENT SIDE JAVASCRIPT -->
<script is:inline>
  function initAllHotelsDirectory() {
    const searchInput = document.getElementById('dirSearchInput');
    const sortSelect = document.getElementById('dirSortSelect');
    const priceSlider = document.getElementById('priceRangeSlider');
    const priceDisplay = document.getElementById('priceRangeValueDisplay');
    const resetBtn = document.getElementById('resetAllFiltersBtn');
    const cardsGrid = document.getElementById('directoryCardsGrid');
    const viewGridBtn = document.getElementById('viewGridBtn');
    const viewListBtn = document.getElementById('viewListBtn');

    if (!cardsGrid) return;
    const cards = document.querySelectorAll('.directory-card-item');
    const starCbs = document.querySelectorAll('.filter-star-cb');

    function filterDirectory() {
      const query = (searchInput?.value || '').trim().toLowerCase();
      const maxPrice = parseFloat(priceSlider?.value || '60000');
      
      const selectedStars = Array.from(starCbs)
        .filter(cb => cb.checked)
        .map(cb => cb.value);

      cards.forEach(card => {
        const title = card.getAttribute('data-title') || '';
        const stars = card.getAttribute('data-stars') || '0';
        const price = parseFloat(card.getAttribute('data-numeric-price') || '0');

        const matchSearch = !query || title.includes(query);
        const matchStars = selectedStars.length === 0 || selectedStars.includes(stars);
        const matchPrice = price === 0 || price <= maxPrice;

        if (matchSearch && matchStars && matchPrice) {
          card.classList.remove('hidden');
        } else {
          card.classList.add('hidden');
        }
      });
    }

    if (searchInput) searchInput.oninput = filterDirectory;
    if (priceSlider) {
      priceSlider.oninput = (e) => {
        if (priceDisplay) priceDisplay.textContent = `৳${parseInt(e.target.value).toLocaleString()}+`;
        filterDirectory();
      };
    }

    starCbs.forEach(cb => cb.onchange = filterDirectory);

    if (resetBtn) {
      resetBtn.onclick = () => {
        if (searchInput) searchInput.value = '';
        if (priceSlider) {
          priceSlider.value = '60000';
          if (priceDisplay) priceDisplay.textContent = '৳60,000+';
        }
        starCbs.forEach(cb => cb.checked = false);
        filterDirectory();
      };
    }

    if (sortSelect) {
      sortSelect.onchange = (e) => {
        const val = e.target.value;
        const cardsArr = Array.from(cards);
        cardsArr.sort((a, b) => {
          const pA = parseFloat(a.getAttribute('data-numeric-price') || '0');
          const pB = parseFloat(b.getAttribute('data-numeric-price') || '0');
          const rA = parseFloat(a.getAttribute('data-numeric-rating') || '0');
          const rB = parseFloat(b.getAttribute('data-numeric-rating') || '0');

          if (val === 'price-low') return pA - pB;
          if (val === 'price-high') return pB - pA;
          if (val === 'rating-high') return rB - rA;
          return 0;
        });

        cardsArr.forEach(c => cardsGrid.appendChild(c));
      };
    }

    // Grid vs List Toggle
    if (viewGridBtn && viewListBtn) {
      viewGridBtn.onclick = () => {
        cardsGrid.className = 'grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-5 items-stretch';
        viewGridBtn.className = 'p-1.5 rounded-md bg-[#006ce4] text-white transition cursor-pointer shadow-xs';
        viewListBtn.className = 'p-1.5 rounded-md text-slate-500 hover:text-slate-900 transition cursor-pointer';
        
        cards.forEach(card => {
          card.classList.remove('md:flex-row');
          card.classList.add('flex-col');
        });
      };

      viewListBtn.onclick = () => {
        cardsGrid.className = 'grid grid-cols-1 gap-4 items-stretch';
        viewListBtn.className = 'p-1.5 rounded-md bg-[#006ce4] text-white transition cursor-pointer shadow-xs';
        viewGridBtn.className = 'p-1.5 rounded-md text-slate-500 hover:text-slate-900 transition cursor-pointer';

        cards.forEach(card => {
          card.classList.remove('flex-col');
          card.classList.add('md:flex-row');
        });
      };
    }

    // Wishlist Logic
    const wishlistBtns = document.querySelectorAll('.card-wishlist-btn');
    wishlistBtns.forEach(btn => {
      const title = btn.getAttribute('data-title') || '';
      let list = [];
      try { list = JSON.parse(localStorage.getItem('gh_wishlist') || '[]'); } catch (e) { list = []; }

      const isSaved = list.some(item => item.title === title);
      const iconSvg = btn.querySelector('svg');
      if (isSaved && iconSvg) {
        iconSvg.setAttribute('fill', 'currentColor');
        iconSvg.classList.add('text-rose-600');
        iconSvg.classList.remove('text-slate-700');
      }

      btn.onclick = (e) => {
        e.preventDefault();
        const image = btn.getAttribute('data-image') || '';
        const url = btn.getAttribute('data-url') || '';
        const price = btn.getAttribute('data-price') || '';

        try { list = JSON.parse(localStorage.getItem('gh_wishlist') || '[]'); } catch (err) { list = []; }

        const idx = list.findIndex(item => item.title === title);
        if (idx > -1) {
          list.splice(idx, 1);
          if (iconSvg) {
            iconSvg.setAttribute('fill', 'none');
            iconSvg.classList.remove('text-rose-600');
            iconSvg.classList.add('text-slate-700');
          }
        } else {
          list.push({ title, image, url, price });
          if (iconSvg) {
            iconSvg.setAttribute('fill', 'currentColor');
            iconSvg.classList.remove('text-slate-700');
            iconSvg.classList.add('text-rose-600');
          }
        }

        localStorage.setItem('gh_wishlist', JSON.stringify(list));
        const countEl = document.getElementById('wishlist-count');
        if (countEl) {
          countEl.textContent = list.length.toString();
          countEl.classList.toggle('hidden', list.length === 0);
        }
      };
    });
  }

  document.addEventListener('astro:page-load', initAllHotelsDirectory);
  if (document.readyState !== 'loading') {
    initAllHotelsDirectory();
  } else {
    document.addEventListener('DOMContentLoaded', initAllHotelsDirectory);
  }
</script>
