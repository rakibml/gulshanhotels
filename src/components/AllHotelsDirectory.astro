---
// src/components/AllHotelsDirectory.astro (Top 4 Amenities Under Location Edition)
import { getCollection } from 'astro:content';

interface Props {
  title?: string;
  subtitle?: string;
}

const { 
  title = "All Hotels in Gulshan", 
  subtitle = "The official directory of verified stays in Gulshan. Compare rates and find the best booking options." 
} = Astro.props;

// 1. Fetch Hotels
let rawHotels: any[] = [];
try {
  const allHotels = await getCollection('hotels');
  if (Array.isArray(allHotels)) rawHotels = allHotels;
} catch (e) {
  rawHotels = [];
}

if (!rawHotels || rawHotels.length === 0) {
  try {
    const rawGlob = import.meta.glob('/src/content/hotels/*.md', { eager: true });
    rawHotels = Object.entries(rawGlob).map(([filePath, item]: [string, any]) => ({
      slug: filePath.split('/').pop()?.replace('.md', ''),
      data: item.frontmatter || {},
      body: typeof item.rawContent === 'function' ? item.rawContent() : (item.compiledContent ? item.compiledContent() : '')
    }));
  } catch (e) {
    rawHotels = [];
  }
}

// Deduplicate Hotels
const uniqueHotelsMap = new Map();
rawHotels.forEach(h => {
  const key = String(h.data?.title || h.data?.name || h.slug || h.id || '').trim().toLowerCase();
  if (key && !uniqueHotelsMap.has(key)) {
    uniqueHotelsMap.set(key, h);
  }
});
const hotels = Array.from(uniqueHotelsMap.values());
const totalHotelsCount = hotels.length;

// 2. Fetch Reviews
let allCmsReviews: any[] = [];
try {
  const reviewsCol = await getCollection('reviews');
  if (Array.isArray(reviewsCol) && reviewsCol.length > 0) {
    allCmsReviews = reviewsCol.map(r => r.data || {});
  }
} catch (e) {}

if (allCmsReviews.length === 0) {
  try {
    const globModules = import.meta.glob('/src/content/reviews/*.md', { eager: true });
    Object.values(globModules).forEach((mod: any) => {
      if (mod && mod.frontmatter) {
        allCmsReviews.push(mod.frontmatter);
      }
    });
  } catch (err) {
    allCmsReviews = [];
  }
}

// 3. Dynamic Counters
let count5Star = 0;
let count4Star = 0;
let count3Star = 0;

let countGulshan1 = 0;
let countGulshan2 = 0;
let countNearGulshan = 0;

hotels.forEach(h => {
  const cat = String(h.data?.starCategory || h.data?.category || '').toLowerCase();
  if (cat.includes('5')) count5Star++;
  else if (cat.includes('4')) count4Star++;
  else count3Star++;

  const loc = String(h.data?.address || h.data?.location || h.data?.category || '').toLowerCase();
  if (loc.includes('gulshan 1') || loc.includes('gulshan-1') || loc.includes('gulshan1')) {
    countGulshan1++;
  } else if (loc.includes('gulshan 2') || loc.includes('gulshan-2') || loc.includes('gulshan2')) {
    countGulshan2++;
  } else {
    countNearGulshan++;
  }
});

// Helpers
const toTitleCase = (str: string) => {
  return str.toLowerCase().split(' ').map(w => w.charAt(0).toUpperCase() + w.slice(1)).join(' ');
};

// Safe Amenity Helper
const extractAmenityName = (item: any): string => {
  if (!item) return '';
  if (typeof item === 'string') return item;
  if (typeof item === 'object') {
    return item.name || item.title || item.label || item.amenity || item.text || Object.values(item)[0] || '';
  }
  return String(item);
};

// 25 Words Extractor from Markdown Body
const getFirst25Words = (text: string): string => {
  if (!text) return "Experience world-class luxury suites, exceptional hospitality, fine dining, and prime comfort in the heart of Gulshan, Dhaka.";
  const clean = text.replace(/<[^>]*>?/gm, '').replace(/[#*`_~]/g, '').replace(/---[\s\S]*?---/g, '').trim();
  const words = clean.split(/\s+/).filter(Boolean);
  if (words.length <= 25) return words.join(' ');
  return words.slice(0, 25).join(' ') + '...';
};

const cleanPriceString = (priceRaw: string) => {
  if (!priceRaw) return 'Contact for Rates';
  const clean = String(priceRaw).replace(/night/gi, '').replace(/\//g, '').trim();
  const digits = clean.replace(/[^0-9.,]/g, '').trim();
  
  if (clean.includes('$')) return `$${digits}`;
  return `৳ ${digits}`;
};

// Pure Vector SVG Icons
const svgMap: Record<string, string> = {
  locationPin: `<svg class="w-3.5 h-3.5 fill-slate-700 shrink-0 mt-0.5" viewBox="0 0 24 24"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>`,
  search: `<svg class="w-4 h-4 fill-slate-400 shrink-0" viewBox="0 0 24 24"><path d="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/></svg>`,
  gridIcon: `<svg class="w-4 h-4 fill-current shrink-0" viewBox="0 0 24 24"><path d="M4 11h6a1 1 0 0 0 1-1V4a1 1 0 0 0-1-1H4a1 1 0 0 0-1 1v6a1 1 0 0 0 1 1zm10 0h6a1 1 0 0 0 1-1V4a1 1 0 0 0-1-1h-6a1 1 0 0 0-1 1v6a1 1 0 0 0 1 1zM4 21h6a1 1 0 0 0 1-1v-6a1 1 0 0 0-1-1H4a1 1 0 0 0-1 1v6a1 1 0 0 0 1 1zm10 0h6a1 1 0 0 0 1-1v-6a1 1 0 0 0-1-1h-6a1 1 0 0 0-1 1v6a1 1 0 0 0 1 1z"/></svg>`,
  listIcon: `<svg class="w-4 h-4 fill-current shrink-0" viewBox="0 0 24 24"><path d="M4 10.5c-.83 0-1.5.67-1.5 1.5s.67 1.5 1.5 1.5 1.5-.67 1.5-1.5-.67-1.5-1.5-1.5zm0-6c-.83 0-1.5.67-1.5 1.5S3.17 7.5 4 7.5 5.5 6.83 5.5 6 4.83 4.5 4 4.5zm0 12c-.83 0-1.5.68-1.5 1.5s.68 1.5 1.5 1.5 1.5-.68 1.5-1.5-.67-1.5-1.5-1.5zM7 19h14v-2H7v2zm0-6h14v-2H7v2zm0-8v2h14V5H7z"/></svg>`,
  verifiedShield: `<svg class="w-3.5 h-3.5 fill-emerald-800 shrink-0" viewBox="0 0 24 24"><path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm-2 16l-4-4 1.41-1.41L10 14.17l6.59-6.59L18 9l-8 8z"/></svg>`,
  tagIcon: `<svg class="w-2.5 h-2.5 fill-emerald-800 shrink-0" viewBox="0 0 24 24"><path d="M21.41 11.58l-9-9C12.05 2.22 11.55 2 11 2H4c-1.1 0-2 .9-2 2v7c0 .55.22 1.05.59 1.42l9 9c.36.36.86.58 1.41.58.55 0 1.05-.22 1.41-.59l7-7c.37-.36.59-.86.59-1.41 0-.55-.23-1.06-.59-1.42zM5.5 7C4.67 7 4 6.33 4 5.5S4.67 4 5.5 4 7 4.67 7 5.5 6.33 7 5.5 7z"/></svg>`,
  wifi: `<svg class="w-3 h-3 fill-slate-600 shrink-0" viewBox="0 0 24 24"><path d="M12 3C7.95 3 4.21 4.34 1.2 6.6L3 8.8C5.46 6.81 8.58 5.7 12 5.7c3.42 0 6.54 1.11 9 3.1l1.8-2.2C19.79 4.34 16.05 3 12 3zm0 5c-2.92 0-5.61.96-7.8 2.58l1.8 2.22C7.62 11.53 9.71 10.7 12 10.7c2.29 0 4.38.83 6 2.1l1.8-2.22C17.61 8.96 14.92 8 12 8zm0 5c-1.87 0-3.58.62-4.98 1.67L12 21l4.98-6.33C15.58 13.62 13.87 13 12 13z"/></svg>`,
  pool: `<svg class="w-3 h-3 fill-slate-600 shrink-0" viewBox="0 0 24 24"><path d="M22 17c-1.1 0-2 .12-.3-3-.83-.88.53-1.9.83-3 .83s-2.12-.3-3-.83c-.88.53-1.9.83-3 .83s-2.12-.3-3-.83c-.88.53-1.9.83-3 .83v-2c.67 0 1.3-.19 1.83-.53.88-.53 1.9-.83 3-.83s2.12.3 3 .83c.88.53 1.9.83 3 .83s2.12-.3 3-.83c-.88-.53 1.9-.83 3-.83s2.12.3 3 .83c.53.34 1.16.53 1.83.53v2zm0-5c-1.1 0-2 .12-.3-3-.83-.88.53-1.9.83-3 .83s-2.12-.3-3-.83c-.88.53-1.9.83-3 .83s-2.12-.3-3-.83c-.88.53-1.9.83-3 .83v-2c.67 0 1.3-.19 1.83-.53.88-.53 1.9-.83 3-.83s2.12.3 3 .83c.88.53 1.9.83 3 .83s2.12-.3 3-.83c-.88-.53 1.9-.83 3-.83s2.12.3 3 .83c.53.34 1.16.53 1.83.53v2zM15 7.5a2.5 2.5 0 1 0-5 0 2.5 2.5 0 0 0 5 0z"/></svg>`,
  spa: `<svg class="w-3 h-3 fill-slate-600 shrink-0" viewBox="0 0 24 24"><path d="M12 3c-1.5 2.5-3 5.5-3 8 0 1.66 1.34 3 3 3s3-1.34 3-3c0-2.5-1.5-5.5-3-8zm-5.5 5.5c-2.5 1.5-5.5 3-8 3 0 1.66 1.34 3 3 3 2.5 0 5.5-1.5 8-3-1.34 0-3-1.34-3-3zm11 0c0 1.66-1.66 3-3 3 2.5 1.5 5.5 3 8 3 0-1.66-1.34-3-3-3-2.5 0-5.5-1.5-8-3z"/></svg>`,
  gym: `<svg class="w-3 h-3 fill-slate-600 shrink-0" viewBox="0 0 24 24"><path d="M20.57 14.86L22 13.43 20.57 12 17 15.57 8.43 7 12 3.43 10.57 2 9.14 3.43 7.71 2 5.57 4.14 4.14 2.71 2.71 4.14l1.43 1.43L2 7.71l1.43 1.43L2 10.57 3.43 12 7 8.43 15.57 17 12 20.57 13.43 22l1.43-1.43 1.43 1.43 2.14-2.14 1.43 1.43 1.43-1.43-1.43-1.43L22 16.29l-1.43-1.43z"/></svg>`,
  restaurant: `<svg class="w-3 h-3 fill-slate-600 shrink-0" viewBox="0 0 24 24"><path d="M11 9H9V2H7v7H5V2H3v7c0 2.12 1.66 3.84 3.75 3.97V22h2.5v-9.03C11.34 12.84 13 11.12 13 9V2h-2v7zm5-3v8h2.5v8H21V2c-2.76 0-5 2.24-5 4z"/></svg>`,
  parking: `<svg class="w-3 h-3 fill-slate-600 shrink-0" viewBox="0 0 24 24"><path d="M13.2 4H6v16h4v-5h3.2c3.75 0 6.8-3.05 6.8-5.5S16.95 4 13.2 4zm-.2 7H10V8h3c1.65 0 3 1.35 3 1.5S14.65 11 13 11z"/></svg>`,
  checkDot: `<svg class="w-2.5 h-2.5 fill-emerald-700 shrink-0" viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/></svg>`
};
---

<!-- ALL HOTELS DIRECTORY SECTION -->
<section id="all-hotels-directory" class="bg-[#F8FAF9] py-6 sm:py-8 px-3 sm:px-8 lg:px-12 max-w-[1550px] mx-auto text-slate-900 border-b border-slate-200/80">
  <div class="space-y-4 sm:space-y-5">
    
    <!-- TOP HEADER -->
    <div class="flex flex-col lg:flex-row justify-between items-start lg:items-center gap-3 sm:gap-4 bg-white p-4 rounded-xl border border-slate-200 shadow-2xs">
      <div>
        <div class="flex items-center gap-2">
          <h2 class="text-lg sm:text-2xl font-black font-sans text-slate-900 tracking-tight">
            {title}
          </h2>
          <span class="bg-[#003b95]/10 text-[#003b95] text-xs font-black px-2.5 py-0.5 rounded-full" id="dirTotalHotelsDisplay">
            {totalHotelsCount} properties
          </span>
        </div>
        {subtitle && (
          <p class="text-xs sm:text-sm text-slate-500 font-medium mt-0.5 line-clamp-1 sm:line-clamp-none">
            {subtitle}
          </p>
        )}
      </div>

      <!-- SEARCH & SORT -->
      <div class="flex flex-wrap items-center gap-2 sm:gap-3 w-full lg:w-auto">
        <div class="relative flex-1 sm:w-64">
          <input 
            type="text" 
            id="dirSearchInput" 
            placeholder="Search hotel name..." 
            class="w-full bg-slate-50 border border-slate-200 rounded-lg pl-8 pr-3 py-2 text-xs text-slate-800 focus:bg-white focus:outline-none focus:ring-2 focus:ring-[#006ce4]/20 focus:border-[#006ce4] transition font-medium"
          />
          <div class="absolute left-2.5 top-1/2 -translate-y-1/2 pointer-events-none">
            <span set:html={svgMap.search} class="inline-flex"></span>
          </div>
        </div>

        <div class="flex items-center gap-1 text-xs font-bold text-slate-700 bg-slate-50 border border-slate-200 rounded-lg px-2.5 py-2">
          <span class="text-slate-400 font-normal hidden sm:inline">Sort:</span>
          <select id="dirSortSelect" class="bg-transparent text-slate-900 font-extrabold focus:outline-none cursor-pointer text-xs">
            <option value="recommended">Top picks</option>
            <option value="rating-high">Rating (highest)</option>
            <option value="price-low">Price (lowest)</option>
            <option value="price-high">Price (highest)</option>
          </select>
        </div>
      </div>
    </div>

    <!-- MAIN CONTENT LAYOUT -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-5 items-start">
      
      <!-- LEFT SIDEBAR FILTER PANEL -->
      <aside class="hidden lg:block lg:col-span-3 bg-white rounded-xl border border-slate-200 p-5 space-y-6 shadow-2xs text-left sticky top-24">
        
        <div class="flex items-center justify-between border-b border-slate-100 pb-3">
          <h3 class="font-bold text-slate-900 text-sm">Filter by:</h3>
          <button id="resetAllFiltersBtn" class="text-xs font-bold text-[#006ce4] hover:underline cursor-pointer">Reset all</button>
        </div>

        <!-- Filter: Area -->
        <div class="space-y-3">
          <h4 class="font-bold text-slate-900 text-xs uppercase tracking-wider">Popular Areas</h4>
          <div class="space-y-2 text-xs font-medium text-slate-700">
            <label class="flex items-center justify-between cursor-pointer p-1 rounded hover:bg-slate-50">
              <div class="flex items-center gap-2">
                <input type="radio" name="areaFilter" class="filter-area-radio w-4 h-4 accent-[#006ce4] cursor-pointer" value="all" checked />
                <span class="font-semibold text-slate-800">All Gulshan Hotels</span>
              </div>
              <span class="text-slate-400 text-[11px]">{totalHotelsCount}</span>
            </label>

            <label class="flex items-center justify-between cursor-pointer p-1 rounded hover:bg-slate-50">
              <div class="flex items-center gap-2">
                <input type="radio" name="areaFilter" class="filter-area-radio w-4 h-4 accent-[#006ce4] cursor-pointer" value="gulshan-1" />
                <span class="text-slate-800">Gulshan 1 Hotels</span>
              </div>
              <span class="text-slate-400 text-[11px]">{countGulshan1}</span>
            </label>

            <label class="flex items-center justify-between cursor-pointer p-1 rounded hover:bg-slate-50">
              <div class="flex items-center gap-2">
                <input type="radio" name="areaFilter" class="filter-area-radio w-4 h-4 accent-[#006ce4] cursor-pointer" value="gulshan-2" />
                <span class="text-slate-800">Gulshan 2 Hotels</span>
              </div>
              <span class="text-slate-400 text-[11px]">{countGulshan2}</span>
            </label>

            {countNearGulshan > 0 && (
              <label class="flex items-center justify-between cursor-pointer p-1 rounded hover:bg-slate-50">
                <div class="flex items-center gap-2">
                  <input type="radio" name="areaFilter" class="filter-area-radio w-4 h-4 accent-[#006ce4] cursor-pointer" value="near" />
                  <span class="text-slate-800">Hotels near Gulshan</span>
                </div>
                <span class="text-slate-400 text-[11px]">{countNearGulshan}</span>
              </label>
            )}
          </div>
        </div>

        <!-- Filter: Star Rating -->
        <div class="space-y-3 border-t border-slate-100 pt-4">
          <h4 class="font-bold text-slate-900 text-xs uppercase tracking-wider">Property rating</h4>
          <div class="space-y-2 text-xs font-medium text-slate-700">
            {count5Star > 0 && (
              <label class="flex items-center justify-between cursor-pointer p-1 rounded hover:bg-slate-50">
                <div class="flex items-center gap-2">
                  <input type="checkbox" class="filter-star-cb w-4 h-4 accent-[#006ce4] rounded cursor-pointer" value="5" />
                  <span class="flex items-center gap-1 font-semibold text-slate-800">5 stars <span class="text-[#febb02] text-sm">★★★★★</span></span>
                </div>
                <span class="text-slate-400 text-[11px]">{count5Star}</span>
              </label>
            )}
            {count4Star > 0 && (
              <label class="flex items-center justify-between cursor-pointer p-1 rounded hover:bg-slate-50">
                <div class="flex items-center gap-2">
                  <input type="checkbox" class="filter-star-cb w-4 h-4 accent-[#006ce4] rounded cursor-pointer" value="4" />
                  <span class="flex items-center gap-1 font-semibold text-slate-800">4 stars <span class="text-[#febb02] text-sm">★★★★</span></span>
                </div>
                <span class="text-slate-400 text-[11px]">{count4Star}</span>
              </label>
            )}
            {count3Star > 0 && (
              <label class="flex items-center justify-between cursor-pointer p-1 rounded hover:bg-slate-50">
                <div class="flex items-center gap-2">
                  <input type="checkbox" class="filter-star-cb w-4 h-4 accent-[#006ce4] rounded cursor-pointer" value="3" />
                  <span class="flex items-center gap-1 font-semibold text-slate-800">3 stars <span class="text-[#febb02] text-sm">★★★</span></span>
                </div>
                <span class="text-slate-400 text-[11px]">{count3Star}</span>
              </label>
            )}
          </div>
        </div>

        <!-- Filter: Budget Slider -->
        <div class="space-y-3 border-t border-slate-100 pt-4">
          <div class="flex justify-between items-center">
            <h4 class="font-bold text-slate-900 text-xs uppercase tracking-wider">Your budget (per night)</h4>
            <span id="priceRangeValueDisplay" class="text-xs font-bold text-[#006ce4]">৳60,000+</span>
          </div>
          <div class="space-y-2 pt-1">
            <input type="range" id="priceRangeSlider" min="2000" max="60000" step="1000" value="60000" class="w-full accent-[#006ce4] cursor-pointer h-1.5 bg-slate-200 rounded-lg" />
            <div class="flex justify-between text-[11px] text-slate-400">
              <span>৳2,000</span>
              <span>৳60,000</span>
            </div>
          </div>
        </div>

      </aside>

      <!-- RIGHT SIDE: DIRECTORY CARDS (ALWAYS LEFT-IMAGE ROW ON MOBILE & DESKTOP) -->
      <div class="lg:col-span-9">
        
        <div id="directoryCardsGrid" class="grid grid-cols-1 gap-4 items-stretch">
          {hotels.map((hotelItem: any) => {
            const hData = hotelItem.data || {};
            const rawTitle = String(hData.title || hData.name || "").trim();
            const hTitle = toTitleCase(rawTitle);
            const hSlug = String(hData.slug || hotelItem.slug || hotelItem.id || "").trim();
            const hImage = hData.image || (Array.isArray(hData.gallery) ? hData.gallery[0] : "");
            
            // 1. FULL ADDRESS
            const hFullAddress = String(hData.address || hData.location || hData.category || "Gulshan, Dhaka").trim();
            const locLower = hFullAddress.toLowerCase();
            let areaType = 'near';

            if (locLower.includes('gulshan 1') || locLower.includes('gulshan-1') || locLower.includes('gulshan1')) {
              areaType = 'gulshan-1';
            } else if (locLower.includes('gulshan 2') || locLower.includes('gulshan-2') || locLower.includes('gulshan2')) {
              areaType = 'gulshan-2';
            } else {
              areaType = 'near';
            }

            // 2. 25 WORDS FROM SINGLE HOTEL'S ACTUAL BODY
            const rawAbout = hotelItem.body || (typeof hotelItem.rawContent === 'function' ? hotelItem.rawContent() : '') || hData.about || hData.description || '';
            const hSnippet25Words = getFirst25Words(rawAbout);

            // 3. EXTRACT AMENITIES (Top 4 for under the location)
            const rawAmenities = Array.isArray(hData.amenities) ? hData.amenities : (Array.isArray(hData.features) ? hData.features : (Array.isArray(hData.facilities) ? hData.facilities : []));
            const uniqueAmenities: string[] = [];
            rawAmenities.forEach(a => {
              const name = extractAmenityName(a);
              if (name && !uniqueAmenities.includes(name)) {
                uniqueAmenities.push(name);
              }
            });

            // Price Calculation & Price Anchoring
            const rawPrice = hData.price ? String(hData.price).trim() : "";
            const displayPrice = cleanPriceString(rawPrice);
            const numericPrice = parseFloat(rawPrice.replace(/[^0-9]/g, '')) || 0;
            const isDollar = rawPrice.includes('$');

            let originalPriceNum = hData.originalPrice ? parseFloat(String(hData.originalPrice).replace(/[^0-9]/g, '')) : 0;
            if (!originalPriceNum || originalPriceNum <= numericPrice) {
              originalPriceNum = isDollar ? Math.round(numericPrice * 1.20) : Math.round(numericPrice * 1.20 / 100) * 100;
            }
            const displayOriginalPrice = isDollar ? `$${originalPriceNum}` : `৳ ${originalPriceNum.toLocaleString()}`;

            // Star Count
            const rawCat = String(hData.starCategory || hData.category || '').toLowerCase();
            const starCount = rawCat.includes('5') ? 5 : (rawCat.includes('4') ? 4 : (rawCat.includes('3') ? 3 : 0));

            const hTitleLower = rawTitle.toLowerCase();
            const hSlugLower = hSlug.toLowerCase();

            // Real Reviews
            const matchedCmsReviews = allCmsReviews.filter(r => {
              if (!r) return false;
              const isApproved = r.approved === true || String(r.approved).toLowerCase() === 'true';
              if (!isApproved) return false;

              const rHotel = String(r.hotel || '').trim().toLowerCase();
              const rSlug = String(r.slug || r.hotelSlug || '').trim().toLowerCase();

              return (rSlug && rSlug === hSlugLower) || (rHotel && rHotel === hTitleLower);
            });

            const embedded = Array.isArray(hData.reviews) ? hData.reviews : [];
            const finalReviewsList = matchedCmsReviews.length > 0 ? matchedCmsReviews : embedded;

            const realCount = finalReviewsList.length;
            let realRating: string | null = null;

            if (realCount > 0) {
              const totalStars = finalReviewsList.reduce((sum: number, r: any) => {
                const num = parseFloat(r.rating);
                return sum + (!isNaN(num) && num > 0 && num <= 5 ? num : 5);
              }, 0);
              const avg = totalStars / realCount;
              realRating = (avg * 2).toFixed(1);
            }

            const numRating = parseFloat(realRating || '0');

            let ratingLabel = 'Wonderful';
            if (numRating < 9.0 && numRating >= 8.0) ratingLabel = 'Very Good';
            else if (numRating < 8.0 && numRating > 0) ratingLabel = 'Good';

            return (
              <div 
                class="directory-card-item bg-white rounded-2xl border border-slate-200/90 overflow-hidden shadow-2xs hover:shadow-md transition duration-200 text-left relative flex flex-row p-3.5 sm:p-5 gap-3.5 sm:gap-5 min-h-[195px]"
                data-title={hTitleLower}
                data-stars={starCount.toString()}
                data-area={areaType}
                data-numeric-price={numericPrice}
                data-numeric-rating={numRating}
              >
                <!-- LEFT COLUMN: BIG IMAGE (ALWAYS ON LEFT) -->
                <div class="card-img-box relative w-36 sm:w-48 md:w-56 shrink-0 rounded-xl overflow-hidden bg-slate-100 self-stretch">
                  {hImage ? (
                    <img 
                      src={hImage} 
                      alt={`${hTitle} Photo`} 
                      loading="lazy" 
                      decoding="async" 
                      class="w-full h-full object-cover hover:scale-105 transition duration-500" 
                    />
                  ) : (
                    <div class="w-full h-full flex items-center justify-center bg-slate-100 text-slate-400 text-xs font-bold">
                      Hotel Photo
                    </div>
                  )}

                  <!-- Wishlist Button -->
                  <button 
                    type="button"
                    class="card-wishlist-btn absolute top-2 right-2 w-7 h-7 sm:w-8 sm:h-8 rounded-full bg-white/90 hover:bg-white text-slate-800 flex items-center justify-center shadow transition cursor-pointer hover:scale-110 z-20"
                    data-title={hTitle}
                    data-image={hImage}
                    data-url={`/${hSlug}`}
                    data-price={displayPrice}
                    aria-label="Save to Wishlist"
                  >
                    <svg class="w-3.5 h-3.5 text-slate-700 transition" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke_linecap="round" stroke_linejoin="round" stroke_width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path></svg>
                  </button>
                </div>

                <!-- RIGHT COLUMN: ALL INFORMATION -->
                <div class="flex-1 flex flex-col justify-between min-w-0 py-0.5">
                  
                  <!-- Top Details -->
                  <div>
                    <div class="flex items-start justify-between gap-1.5 sm:gap-2">
                      <div class="min-w-0">
                        <!-- Title & Stars -->
                        <div class="flex items-center gap-1.5 flex-wrap">
                          <a href={`/${hSlug}`} class="text-sm sm:text-lg font-bold text-[#006ce4] hover:text-[#003b95] hover:underline transition line-clamp-1">
                            {hTitle}
                          </a>
                          {starCount > 0 && (
                            <span class="text-[#febb02] text-xs sm:text-sm tracking-tight shrink-0">
                              {'★'.repeat(starCount)}
                            </span>
                          )}
                        </div>

                        <!-- FULL HOTEL ADDRESS -->
                        <div class="flex items-start gap-1 text-[11px] sm:text-xs text-slate-600 font-medium mt-1 leading-snug">
                          <span set:html={svgMap.locationPin} class="inline-flex shrink-0"></span>
                          <span class="hover:underline cursor-pointer">{hFullAddress}</span>
                        </div>
                      </div>

                      <!-- Blue Score Badge -->
                      {realRating ? (
                        <div class="flex items-center gap-1.5 shrink-0">
                          <div class="text-right hidden sm:block">
                            <div class="text-xs font-bold text-slate-900 leading-tight">{ratingLabel}</div>
                            <div class="text-[10px] text-slate-500 leading-tight">{realCount} reviews</div>
                          </div>
                          <div class="bg-[#003b95] text-white font-bold text-xs sm:text-sm px-1.5 py-0.5 sm:py-1 rounded-t-md rounded-br-md leading-none shadow-2xs">
                            {realRating}
                          </div>
                        </div>
                      ) : (
                        <div class="bg-slate-100 text-slate-600 text-[10px] sm:text-[11px] font-bold px-1.5 py-0.5 rounded shrink-0">
                          New
                        </div>
                      )}
                    </div>

                    <!-- 4 AMENITIES UNDER LOCATION -->
                    {uniqueAmenities.length > 0 && (
                      <div class="flex flex-wrap items-center gap-1.5 mt-2">
                        {uniqueAmenities.slice(0, 4).map((name: string) => {
                          const aLow = name.toLowerCase();
                          const iconSvg = aLow.includes('wifi') ? svgMap.wifi 
                            : (aLow.includes('pool') ? svgMap.pool 
                            : (aLow.includes('spa') || aLow.includes('well') ? svgMap.spa 
                            : (aLow.includes('gym') || aLow.includes('fit') ? svgMap.gym 
                            : (aLow.includes('food') || aLow.includes('dine') || aLow.includes('rest') || aLow.includes('break') ? svgMap.restaurant 
                            : (aLow.includes('park') ? svgMap.parking : svgMap.checkDot)))));
                          return (
                            <span class="inline-flex items-center gap-1 bg-slate-100/90 text-slate-700 text-[10px] font-bold px-2 py-0.5 rounded-md border border-slate-200/60">
                              {iconSvg && <span set:html={iconSvg} class="inline-flex"></span>}
                              <span>{name}</span>
                            </span>
                          );
                        })}
                      </div>
                    )}

                    <!-- 25 WORDS FROM SINGLE HOTEL'S ACTUAL BODY -->
                    <p class="text-xs text-slate-600 mt-2 leading-relaxed line-clamp-2 sm:line-clamp-3">
                      {hSnippet25Words}
                    </p>

                    <!-- Official Partner Deal Strip -->
                    <div class="mt-2.5 py-1 px-2 sm:py-1.5 sm:px-2.5 bg-emerald-50/80 border border-emerald-200/80 rounded-lg flex items-center justify-between gap-1.5">
                      <div class="flex items-center gap-1 text-[10px] sm:text-xs text-emerald-950 font-bold truncate">
                        <span set:html={svgMap.verifiedShield} class="inline-flex shrink-0"></span>
                        <span class="truncate">Official Partner Deal</span>
                      </div>
                      <span class="inline-flex items-center gap-0.5 sm:gap-1 bg-emerald-700 text-white text-[9px] sm:text-[10px] font-black px-1.5 py-0.5 rounded shadow-2xs shrink-0">
                        <span set:html={svgMap.tagIcon} class="inline-flex text-white"></span>
                        <span>10% OFF</span>
                      </span>
                    </div>
                  </div>

                  <!-- Bottom Row: Price & Spacious CTA Button -->
                  <div class="mt-3 pt-2 sm:pt-2.5 border-t border-slate-100 flex items-center justify-between gap-2">
                    <div>
                      <div class="flex items-baseline gap-1">
                        <span class="text-[10px] sm:text-xs text-slate-400 line-through font-semibold leading-none">
                          {displayOriginalPrice}
                        </span>
                        <span class="text-base sm:text-xl font-extrabold text-[#008234] leading-none">
                          {displayPrice}
                        </span>
                      </div>
                      <span class="text-[9px] sm:text-[10px] text-slate-500 font-medium block mt-0.5">
                        Best rate found
                      </span>
                    </div>

                    <a 
                      href={`/${hSlug}`} 
                      class="bg-[#006ce4] hover:bg-[#0057b8] text-white text-xs font-bold px-3.5 py-1.5 sm:px-4 sm:py-2 rounded-lg transition inline-flex items-center justify-center gap-1 shadow-2xs hover:shadow whitespace-nowrap shrink-0"
                    >
                      <span>See Options</span>
                      <span class="text-xs">›</span>
                    </a>
                  </div>

                </div>

              </div>
            );
          })}
        </div>

      </div>

    </div>

  </div>
</section>

<!-- CLIENT SIDE JAVASCRIPT -->
<script is:inline>
  function initAllHotelsDirectory() {
    const searchInput = document.getElementById('dirSearchInput');
    const sortSelect = document.getElementById('dirSortSelect');
    const priceSlider = document.getElementById('priceRangeSlider');
    const priceDisplay = document.getElementById('priceRangeValueDisplay');
    const resetBtn = document.getElementById('resetAllFiltersBtn');
    const cardsGrid = document.getElementById('directoryCardsGrid');

    if (!cardsGrid) return;
    const cards = document.querySelectorAll('.directory-card-item');
    const starCbs = document.querySelectorAll('.filter-star-cb');
    const areaRadios = document.querySelectorAll('.filter-area-radio');

    function filterDirectory() {
      const query = (searchInput?.value || '').trim().toLowerCase();
      const maxPrice = parseFloat(priceSlider?.value || '60000');
      
      const selectedStars = Array.from(starCbs)
        .filter(cb => cb.checked)
        .map(cb => cb.value);

      const selectedArea = Array.from(areaRadios).find(r => r.checked)?.value || 'all';

      cards.forEach(card => {
        const title = card.getAttribute('data-title') || '';
        const stars = card.getAttribute('data-stars') || '0';
        const area = card.getAttribute('data-area') || 'near';
        const price = parseFloat(card.getAttribute('data-numeric-price') || '0');

        const matchSearch = !query || title.includes(query);
        const matchStars = selectedStars.length === 0 || selectedStars.includes(stars);
        const matchArea = selectedArea === 'all' || area === selectedArea;
        const matchPrice = price === 0 || price <= maxPrice;

        if (matchSearch && matchStars && matchArea && matchPrice) {
          card.classList.remove('hidden');
        } else {
          card.classList.add('hidden');
        }
      });
    }

    if (searchInput) searchInput.oninput = filterDirectory;
    if (priceSlider) {
      priceSlider.oninput = (e) => {
        if (priceDisplay) priceDisplay.textContent = `৳${parseInt(e.target.value).toLocaleString()}+`;
        filterDirectory();
      };
    }

    starCbs.forEach(cb => cb.onchange = filterDirectory);
    areaRadios.forEach(r => r.onchange = filterDirectory);

    if (resetBtn) {
      resetBtn.onclick = () => {
        if (searchInput) searchInput.value = '';
        if (priceSlider) {
          priceSlider.value = '60000';
          if (priceDisplay) priceDisplay.textContent = '৳60,000+';
        }
        starCbs.forEach(cb => cb.checked = false);
        if (areaRadios.length > 0) areaRadios[0].checked = true;
        filterDirectory();
      };
    }

    if (sortSelect) {
      sortSelect.onchange = (e) => {
        const val = e.target.value;
        const cardsArr = Array.from(cards);
        cardsArr.sort((a, b) => {
          const pA = parseFloat(a.getAttribute('data-numeric-price') || '0');
          const pB = parseFloat(b.getAttribute('data-numeric-price') || '0');
          const rA = parseFloat(a.getAttribute('data-numeric-rating') || '0');
          const rB = parseFloat(b.getAttribute('data-numeric-rating') || '0');

          if (val === 'price-low') return pA - pB;
          if (val === 'price-high') return pB - pA;
          if (val === 'rating-high') return rB - rA;
          return 0;
        });

        cardsArr.forEach(c => cardsGrid.appendChild(c));
      };
    }

    // Wishlist Logic
    const wishlistBtns = document.querySelectorAll('.card-wishlist-btn');
    wishlistBtns.forEach(btn => {
      const title = btn.getAttribute('data-title') || '';
      let list = [];
      try { list = JSON.parse(localStorage.getItem('gh_wishlist') || '[]'); } catch (e) { list = []; }

      const isSaved = list.some(item => item.title === title);
      const iconSvg = btn.querySelector('svg');
      if (isSaved && iconSvg) {
        iconSvg.setAttribute('fill', 'currentColor');
        iconSvg.classList.add('text-rose-600');
        iconSvg.classList.remove('text-slate-700');
      }

      btn.onclick = (e) => {
        e.preventDefault();
        const image = btn.getAttribute('data-image') || '';
        const url = btn.getAttribute('data-url') || '';
        const price = btn.getAttribute('data-price') || '';

        try { list = JSON.parse(localStorage.getItem('gh_wishlist') || '[]'); } catch (err) { list = []; }

        const idx = list.findIndex(item => item.title === title);
        if (idx > -1) {
          list.splice(idx, 1);
          if (iconSvg) {
            iconSvg.setAttribute('fill', 'none');
            iconSvg.classList.remove('text-rose-600');
            iconSvg.classList.add('text-slate-700');
          }
        } else {
          list.push({ title, image, url, price });
          if (iconSvg) {
            iconSvg.setAttribute('fill', 'currentColor');
            iconSvg.classList.remove('text-slate-700');
            iconSvg.classList.add('text-rose-600');
          }
        }

        localStorage.setItem('gh_wishlist', JSON.stringify(list));
        const countEl = document.getElementById('wishlist-count');
        if (countEl) {
          countEl.textContent = list.length.toString();
          countEl.classList.toggle('hidden', list.length === 0);
        }
      };
    });
  }

  document.addEventListener('astro:page-load', initAllHotelsDirectory);
  if (document.readyState !== 'loading') {
    initAllHotelsDirectory();
  } else {
    document.addEventListener('DOMContentLoaded', initAllHotelsDirectory);
  }
</script>
