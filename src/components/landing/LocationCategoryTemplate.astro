---
// src/components/landing/LocationCategoryTemplate.astro
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

interface Props {
  entry: any;
  Content?: any; // CMS Markdown বডি রেন্ডার করার জন্য
}

const { entry, Content } = Astro.props;
const data = entry?.data || {};

const pageTitle = (data.title || "Hotels Guide").trim();
const headingTitle = (data.heading || pageTitle).trim();
const description = (data.description || data.seo_description || `Explore verified hotels, lodging and executive stays in ${pageTitle}.`).trim();
const cleanSlug = (entry?.slug || entry?.id || "").replace(/\.(md|mdx)$/, '').split('/').pop()?.toLowerCase() || "";

const badge = data.badge || "Verified Area & Stays Guide";
const heroImage = data.hero_image || "https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&w=1400&q=80";

// ১. সব হোটেল লোড করা
const hotelCol = await getCollection('hotels');
const allHotels = hotelCol.map(h => ({
  slug: (h.slug || h.id || '').replace(/\.(md|mdx)$/, '').split('/').pop()?.toLowerCase(),
  data: h.data || {}
}));

// ২. সম্পূর্ণ ডাইনামিক ফিল্টারিং লজিক (কোনো হার্ডকোড ছাড়া)
const manualSlugs = Array.isArray(data.selected_hotels) ? data.selected_hotels.map((s: string) => String(s).toLowerCase().trim()) : [];
const matchKeyword = String(data.filter_keyword || cleanSlug).replace(/-/g, ' ').toLowerCase().trim();

const displayHotels = allHotels.filter(h => {
  const hSlug = String(h.slug || '').toLowerCase();
  const hTitle = String(h.data?.title || h.data?.name || '').toLowerCase();
  const hLoc = String(h.data?.location || h.data?.address || '').toLowerCase();
  const hCat = String(h.data?.category || '').toLowerCase();
  const hTags = Array.isArray(h.data?.tags) ? h.data.tags.map((t: string) => t.toLowerCase()) : [];

  // ১. CMS থেকে যদি নির্দিষ্ট হোটেল সিলেক্ট করে দেওয়া থাকে
  if (manualSlugs.length > 0) {
    return manualSlugs.includes(hSlug);
  }

  // ২. ডায়নামিক অটো-ফিল্টার: লোকেশন, ক্যাটাগরি, টাইটেল বা ট্যাগে কি-ওয়ার্ড মিললে
  return hLoc.includes(matchKeyword) || 
         hCat.includes(matchKeyword) || 
         hTitle.includes(matchKeyword) || 
         hTags.some((tag: string) => tag.includes(matchKeyword));
});

// কোনো ম্যাচ না পেলে ফলব্যাক হিসেবে লেটেস্ট ৬টি হোটেল
const finalHotels = displayHotels.length > 0 ? displayHotels : allHotels.slice(0, 6);

const areaTips = Array.isArray(data.area_tips) ? data.area_tips : [];
const faqs = Array.isArray(data.faqs) ? data.faqs : [];

// ডাইনামিক ডোমেন
const siteOrigin = Astro.site ? Astro.site.origin : "https://gulshanhotels.com";
const canonicalUrl = `${siteOrigin}/${cleanSlug}`;

// ================= GOOGLE SCHEMA =================
const masterSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "@id": `${canonicalUrl}#breadcrumb`,
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": `${siteOrigin}/` },
        { "@type": "ListItem", "position": 2, "name": pageTitle }
      ]
    },
    {
      "@type": "ItemList",
      "@id": `${canonicalUrl}#itemlist`,
      "name": pageTitle,
      "description": description,
      "numberOfItems": finalHotels.length,
      "itemListElement": finalHotels.map((h, idx) => ({
        "@type": "ListItem",
        "position": idx + 1,
        "name": h.data?.title || "Hotel",
        "url": `${siteOrigin}/hotels/${h.slug}`
      }))
    },
    ...(faqs.length > 0 ? [{
      "@type": "FAQPage",
      "@id": `${canonicalUrl}#faq`,
      "mainEntity": faqs.map((f: any) => ({
        "@type": "Question",
        "name": f.question,
        "acceptedAnswer": { "@type": "Answer", "text": f.answer }
      }))
    }] : [])
  ]
};
---

<Layout title={`${pageTitle} — Verified Stays & Guide`} description={description} image={heroImage}>
  <script type="application/ld+json" set:html={JSON.stringify(masterSchema)} />

  <main class="w-full bg-white text-slate-900 pt-6 pb-20">
    <div class="max-w-[1550px] mx-auto px-4 sm:px-8 lg:px-12 space-y-10">
      
      <!-- BREADCRUMBS -->
      <nav aria-label="Breadcrumb" class="flex items-center gap-2 text-xs font-semibold text-slate-400 text-left">
        <a href="/" class="hover:text-emerald-800 transition">Home</a>
        <span>/</span>
        <span class="text-slate-800 truncate" aria-current="page">{pageTitle}</span>
      </nav>

      <!-- 1. HERO HEADER -->
      <header class="relative rounded-3xl overflow-hidden bg-slate-950 text-white min-h-[320px] sm:min-h-[380px] flex items-center p-6 sm:p-12 lg:p-16 text-left border border-slate-200">
        <img src={heroImage} alt={pageTitle} class="absolute inset-0 w-full h-full object-cover opacity-35" fetchpriority="high" />
        <div class="absolute inset-0 bg-gradient-to-r from-black/85 via-black/60 to-transparent"></div>

        <div class="relative z-10 max-w-2xl space-y-3">
          <span class="bg-emerald-500/20 text-emerald-300 border border-emerald-400/30 text-[10px] sm:text-xs font-black uppercase tracking-widest px-3 py-1 rounded-full inline-block">
            {badge}
          </span>
          <h1 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-black text-white tracking-tight leading-tight">
            {headingTitle}
          </h1>
          <p class="text-xs sm:text-base text-slate-300 font-normal leading-relaxed">
            {description}
          </p>
          <div class="pt-2 flex items-center gap-4 text-xs font-bold text-slate-300">
            <span class="flex items-center gap-1.5">
              <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
              <span>{finalHotels.length} Properties Available</span>
            </span>
          </div>
        </div>
      </header>

      <!-- 2. HOTEL CARDS GRID -->
      <section class="space-y-6 text-left">
        <div class="border-b border-slate-200 pb-3 flex items-end justify-between">
          <div>
            <h2 class="text-xl sm:text-3xl font-serif font-black text-slate-900 tracking-tight">
              Recommended Accommodations in this Area
            </h2>
            <p class="text-xs text-slate-500 font-medium mt-0.5">Rates updated with verified direct contact and partner reservation channels</p>
          </div>
        </div>

        <div class="grid grid-cols-2 lg:grid-cols-3 gap-3.5 sm:gap-6 lg:gap-8">
          {finalHotels.map((h) => {
            const hd = h.data || {};
            const hTitle = hd.title || hd.name || "Hotel";
            const rawPrice = String(hd.price || "120");
            const hPrice = rawPrice.startsWith('$') || rawPrice.startsWith('৳') ? rawPrice : `$${rawPrice}`;
            const hImage = hd.image || (Array.isArray(hd.gallery) ? hd.gallery[0] : heroImage);
            const hLoc = hd.location || "Dhaka, Bangladesh";
            const hotelUrl = `/hotels/${h.slug}`; // আপনার সাইটের পাথ অনুযায়ী সেট করুন

            return (
              <div class="group flex flex-col justify-between bg-white rounded-2xl sm:rounded-3xl border border-slate-200 overflow-hidden shadow-xs hover:shadow-xl hover:border-emerald-600/40 transition-all duration-300">
                <div>
                  <a href={hotelUrl} class="block relative aspect-[16/10] w-full overflow-hidden bg-slate-900">
                    <img src={hImage} alt={hTitle} loading="lazy" decoding="async" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
                    <span class="absolute top-2.5 left-2.5 bg-[#0d3b23] text-white text-[9px] font-black uppercase px-2 py-0.5 rounded shadow-sm">
                      Verified
                    </span>
                  </a>

                  <div class="p-3 sm:p-5 space-y-1 sm:space-y-2">
                    <h3 class="font-black text-slate-900 text-xs sm:text-lg group-hover:text-emerald-800 transition line-clamp-1">
                      <a href={hotelUrl}>{hTitle}</a>
                    </h3>
                    <p class="text-[10px] sm:text-xs text-slate-500 font-medium truncate flex items-center gap-1">
                      <span>📍</span>
                      <span>{hLoc}</span>
                    </p>
                    <div class="pt-1 border-t border-slate-100 flex items-baseline justify-between">
                      <span class="text-[9px] sm:text-xs text-slate-400 font-bold uppercase">From</span>
                      <span class="text-xs sm:text-base font-black text-emerald-900">{hPrice}</span>
                    </div>
                  </div>
                </div>

                <div class="p-3 sm:p-5 pt-0">
                  <a href={hotelUrl} class="block w-full bg-slate-50 hover:bg-[#0d3b23] border border-slate-200 text-slate-900 hover:text-white font-black text-[11px] sm:text-xs text-center py-2 sm:py-2.5 rounded-xl transition duration-200">
                    Check Rates ➔
                  </a>
                </div>
              </div>
            );
          })}
        </div>
      </section>

      <!-- 3. CMS ARTICLE BODY (Markdown Content) -->
      {Content && (
        <article class="prose max-w-none pt-6 border-t border-slate-200">
          <Content />
        </article>
      )}

      <!-- 4. LOCAL AREA TIPS -->
      {areaTips.length > 0 && (
        <section class="bg-slate-50 border border-slate-200 rounded-3xl p-6 sm:p-10 text-left space-y-4">
          <div class="space-y-1">
            <span class="text-[10px] font-black uppercase tracking-wider text-emerald-800">Local Area Insights</span>
            <h3 class="font-serif text-2xl font-black text-slate-900">Travel Advice for {pageTitle}</h3>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 pt-2">
            {areaTips.map((tip: any) => (
              <div class="bg-white p-4 sm:p-5 rounded-2xl border border-slate-200/80 space-y-1.5 shadow-2xs">
                <h4 class="font-bold text-slate-900 text-sm sm:text-base flex items-center gap-2">
                  <span class="w-2 h-2 rounded-full bg-emerald-600"></span>
                  <span>{tip.title}</span>
                </h4>
                <p class="text-xs text-slate-600 leading-relaxed font-normal">{tip.desc}</p>
              </div>
            ))}
          </div>
        </section>
      )}

      <!-- 5. FAQS ACCORDION -->
      {faqs.length > 0 && (
        <section class="space-y-4 text-left pt-6 border-t border-slate-200">
          <h3 class="font-serif text-2xl font-black text-slate-900">Frequently Asked Questions</h3>
          <div class="space-y-2.5 max-w-4xl">
            {faqs.map((f: any, i: number) => (
              <details class="group bg-slate-50 rounded-2xl border border-slate-200 p-4 transition-all cursor-pointer" open={i === 0}>
                <summary class="flex justify-between items-center list-none font-bold text-sm sm:text-base text-slate-900 group-hover:text-emerald-800 select-none">
                  <span>{f.question}</span>
                  <span class="text-slate-400 group-open:rotate-180 transition-transform">▼</span>
                </summary>
                <p class="pt-3 text-xs sm:text-sm text-slate-600 leading-relaxed border-t border-slate-200/60 mt-3">{f.answer}</p>
              </details>
            ))}
          </div>
        </section>
      )}

    </div>
  </main>
</Layout>
