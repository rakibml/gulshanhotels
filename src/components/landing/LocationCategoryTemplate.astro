---
// src/components/landing/LocationCategoryTemplate.astro
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

interface Props {
  entry: any;
  Content?: any;
}

const { entry, Content } = Astro.props;
const data = entry?.data || {};

// পেজ মেটাডাটা
const pageTitle = (data.title || "Hotels in Gulshan 1").trim();
const locationSubtitle = data.location_subtitle || "Dhaka, Bangladesh";
const description = (data.description || data.seo_description || `Discover the best hotels in ${pageTitle} — from luxury 5-star hotels to comfortable stays, all in one place.`).trim();
const cleanSlug = (entry?.slug || entry?.id || "").replace(/\.(md|mdx)$/, '').split('/').pop()?.toLowerCase() || "";
const heroImage = data.hero_image || "https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&w=1600&q=80";

// ১. হোটেল লোডার ও ডাইনামিক ফিল্টার
const hotelCol = await getCollection('hotels');
const allHotels = hotelCol.map(h => ({
  slug: (h.slug || h.id || '').replace(/\.(md|mdx)$/, '').split('/').pop()?.toLowerCase(),
  data: h.data || {}
}));

const manualSlugs = Array.isArray(data.selected_hotels) ? data.selected_hotels.map((s: string) => String(s).toLowerCase().trim()) : [];
const matchKeyword = String(data.filter_keyword || cleanSlug).replace(/-/g, ' ').toLowerCase().trim();

const displayHotels = allHotels.filter(h => {
  const hSlug = String(h.slug || '').toLowerCase();
  const hTitle = String(h.data?.title || h.data?.name || '').toLowerCase();
  const hLoc = String(h.data?.location || h.data?.address || '').toLowerCase();
  const hCat = String(h.data?.category || '').toLowerCase();

  if (manualSlugs.length > 0) return manualSlugs.includes(hSlug);
  return hLoc.includes(matchKeyword) || hCat.includes(matchKeyword) || hTitle.includes(matchKeyword);
});

const finalHotels = displayHotels.length > 0 ? displayHotels : allHotels.slice(0, 6);

// ২. "Why Stay" সেকশন ডাটা
const aboutImage = data.about_image || "https://images.unsplash.com/photo-1582719478250-c89cae4dc85b?auto=format&fit=crop&w=800&q=80";
const aboutText = data.about_text || `${pageTitle} is one of the most prestigious and upscale areas in Dhaka, known for its modern lifestyle, business hubs, and premium hotels. Whether you're visiting for business, leisure, or a special occasion, you'll find world-class accommodation, excellent dining, and easy access to shopping and embassies.`;

const siteOrigin = Astro.site ? Astro.site.origin : "https://gulshanhotels.com";
const canonicalUrl = `${siteOrigin}/${cleanSlug}`;

// ৩. এসইও স্কিমা (Google Rich Snippets)
const masterSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "ItemList",
      "@id": `${canonicalUrl}#itemlist`,
      "name": pageTitle,
      "description": description,
      "numberOfItems": finalHotels.length,
      "itemListElement": finalHotels.map((h, idx) => ({
        "@type": "ListItem",
        "position": idx + 1,
        "name": h.data?.title || "Hotel",
        "url": `${siteOrigin}/hotels/${h.slug}`
      }))
    }
  ]
};
---

<Layout title={`${pageTitle} — Top Luxury & Budget Stays`} description={description} image={heroImage}>
  <script type="application/ld+json" set:html={JSON.stringify(masterSchema)} />

  <div class="w-full bg-[#f8faf9] text-slate-800 font-sans pb-16">
    
    <!-- ================= 1. HERO BANNER WITH SEARCH ================= -->
    <header class="relative bg-slate-900 text-white min-h-[460px] flex items-center justify-center pb-14 pt-10 px-4">
      <!-- Background Image with Gradient Overlay -->
      <img src={heroImage} alt={pageTitle} class="absolute inset-0 w-full h-full object-cover opacity-45" fetchpriority="high" />
      <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/50 to-black/30"></div>

      <div class="relative z-10 max-w-4xl mx-auto text-center space-y-4">
        <!-- Location Tag -->
        <div class="flex items-center justify-center gap-1.5 text-xs sm:text-sm text-slate-300 font-medium tracking-wide">
          <svg class="w-4 h-4 text-emerald-400" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd"></path></svg>
          <span>{locationSubtitle}</span>
        </div>

        <!-- Main Title -->
        <h1 class="font-serif text-3xl sm:text-5xl lg:text-6xl font-bold text-white tracking-tight">
          {pageTitle}
        </h1>

        <!-- Subtitle -->
        <p class="max-w-2xl mx-auto text-xs sm:text-base text-slate-300 font-light leading-relaxed">
          {description}
        </p>

        <!-- Feature Badges Row -->
        <div class="flex flex-wrap items-center justify-center gap-4 sm:gap-8 pt-2 text-xs sm:text-sm text-slate-200">
          <span class="flex items-center gap-1.5 font-medium">💎 Luxury Hotels</span>
          <span class="flex items-center gap-1.5 font-medium">⭐ Top Rated</span>
          <span class="flex items-center gap-1.5 font-medium">📍 Prime Location</span>
          <span class="flex items-center gap-1.5 font-medium">🛡️ Trusted Directory</span>
        </div>
      </div>

      <!-- Floating Search Bar (Card over hero bottom) -->
      <div class="absolute -bottom-7 left-4 right-4 max-w-3xl mx-auto z-20">
        <form action="/search" method="GET" class="bg-white rounded-2xl shadow-xl p-2 sm:p-2.5 flex items-center border border-slate-100">
          <div class="pl-3 pr-2 text-slate-400">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
          </div>
          <input 
            type="text" 
            name="q" 
            placeholder={`Search hotels in ${pageTitle}...`} 
            class="w-full text-xs sm:text-sm text-slate-800 placeholder-slate-400 bg-transparent focus:outline-none"
          />
          <button type="submit" class="bg-[#0d3b23] hover:bg-[#082817] text-white p-2.5 sm:px-4 sm:py-2.5 rounded-xl transition duration-200 shrink-0">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
          </button>
        </form>
      </div>
    </header>


    <!-- ================= 2. FEATURED HOTELS SECTION ================= -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-20 space-y-8">
      
      <!-- Section Header -->
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 border-b border-slate-200/80 pb-4">
        <div>
          <span class="text-[11px] font-bold tracking-widest uppercase text-[#0d3b23]">— FEATURED HOTELS</span>
          <h2 class="text-2xl sm:text-3xl font-serif font-bold text-slate-900 mt-0.5">Top {pageTitle}</h2>
          <p class="text-xs sm:text-sm text-slate-500 mt-1">Handpicked hotels with the best reviews, amenities and location.</p>
        </div>
        <a href="/hotels" class="text-xs sm:text-sm font-semibold text-[#0d3b23] hover:underline flex items-center gap-1 self-start sm:self-auto">
          View All Hotels <span>&rarr;</span>
        </a>
      </div>

      <!-- 3-Column Hotel Cards Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-7">
        {finalHotels.map((h) => {
          const hd = h.data || {};
          const title = hd.title || hd.name || "Hotel";
          const stars = hd.stars || 5;
          const rating = hd.rating || "4.8";
          const reviewsCount = hd.reviews_count || "1,250";
          const location = hd.location || "Gulshan 1, Dhaka";
          const rawPrice = String(hd.price || "15,000");
          const formattedPrice = rawPrice.startsWith('৳') || rawPrice.startsWith('$') ? rawPrice : `৳ ${rawPrice}`;
          const image = hd.image || (Array.isArray(hd.gallery) ? hd.gallery[0] : heroImage);
          const amenities = Array.isArray(hd.amenities) ? hd.amenities.slice(0, 4) : ['Pool', 'Gym', 'Restaurant', 'Free WiFi'];
          const hotelUrl = `/hotels/${h.slug}`;

          return (
            <div class="bg-white rounded-2xl border border-slate-200/80 overflow-hidden shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col justify-between group">
              <div>
                <!-- Image Wrapper with Badges -->
                <div class="relative aspect-[16/10] overflow-hidden bg-slate-100">
                  <a href={hotelUrl}>
                    <img src={image} alt={title} loading="lazy" decoding="async" class="w-full h-full object-cover group-hover:scale-105 transition duration-500" />
                  </a>
                  <!-- Star Badge -->
                  <div class="absolute top-3 left-3 bg-[#0d3b23] text-white text-[11px] font-bold px-2 py-0.5 rounded-md flex items-center gap-0.5 shadow">
                    <span>{stars}★</span>
                  </div>
                  <!-- Wishlist Heart Button -->
                  <button aria-label="Save to Wishlist" class="absolute top-3 right-3 w-8 h-8 rounded-full bg-black/20 hover:bg-black/40 backdrop-blur text-white flex items-center justify-center transition">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path></svg>
                  </button>
                </div>

                <!-- Hotel Details -->
                <div class="p-4 sm:p-5 space-y-2.5">
                  <div>
                    <h3 class="font-bold text-base sm:text-lg text-slate-900 group-hover:text-[#0d3b23] transition line-clamp-1">
                      <a href={hotelUrl}>{title}</a>
                    </h3>
                    <p class="text-xs text-slate-500 flex items-center gap-1 mt-0.5">
                      <svg class="w-3.5 h-3.5 text-emerald-600 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd"></path></svg>
                      <span class="truncate">{location}</span>
                    </p>
                  </div>

                  <!-- Ratings & Reviews -->
                  <div class="flex items-center gap-1.5 text-xs">
                    <span class="text-amber-500 font-bold">★ {rating}</span>
                    <span class="text-slate-400 font-normal">({reviewsCount} reviews)</span>
                  </div>

                  <!-- Amenities Row with icons -->
                  <div class="flex flex-wrap items-center gap-2 pt-1 text-[11px] text-slate-600">
                    {amenities.map((item: string) => (
                      <span class="bg-slate-50 px-2 py-0.5 rounded border border-slate-100">{item}</span>
                    ))}
                  </div>
                </div>
              </div>

              <!-- Price & CTA Footer -->
              <div class="px-4 sm:px-5 py-3 border-t border-slate-100 flex items-center justify-between bg-slate-50/50">
                <div>
                  <span class="text-[10px] text-slate-400 block font-medium">From</span>
                  <span class="text-sm sm:text-base font-extrabold text-[#0d3b23]">{formattedPrice}</span>
                  <span class="text-[10px] text-slate-400 font-normal"> / night</span>
                </div>
                <a href={hotelUrl} class="text-xs font-bold text-slate-800 hover:text-[#0d3b23] flex items-center gap-1 transition">
                  View Details &rarr;
                </a>
              </div>
            </div>
          );
        })}
      </div>
    </section>


    <!-- ================= 3. "WHY STAY IN..." (ABOUT AREA) SECTION ================= -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-16">
      <div class="bg-white rounded-3xl p-6 sm:p-10 border border-slate-200/80 shadow-sm">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
          
          <!-- Left: Area Image -->
          <div class="lg:col-span-4 rounded-2xl overflow-hidden aspect-[4/3] bg-slate-100 shadow-inner">
            <img src={aboutImage} alt={pageTitle} class="w-full h-full object-cover" />
          </div>

          <!-- Middle: Text Content -->
          <div class="lg:col-span-5 space-y-3">
            <span class="text-[11px] font-bold tracking-widest uppercase text-[#0d3b23]">ABOUT {pageTitle.toUpperCase()}</span>
            <h2 class="text-2xl sm:text-3xl font-serif font-bold text-slate-900 leading-tight">
              Why Stay in {pageTitle}?
            </h2>
            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed font-normal">
              {aboutText}
            </p>
          </div>

          <!-- Right: 4 Highlights / USPs -->
          <div class="lg:col-span-3 space-y-4">
            
            <div class="flex items-start gap-3">
              <div class="w-9 h-9 rounded-full bg-emerald-50 text-emerald-800 flex items-center justify-center shrink-0 text-sm font-bold">📍</div>
              <div>
                <h4 class="text-xs sm:text-sm font-bold text-slate-900">Prime Location</h4>
                <p class="text-[11px] text-slate-500">Close to business & shopping hubs</p>
              </div>
            </div>

            <div class="flex items-start gap-3">
              <div class="w-9 h-9 rounded-full bg-emerald-50 text-emerald-800 flex items-center justify-center shrink-0 text-sm font-bold">👥</div>
              <div>
                <h4 class="text-xs sm:text-sm font-bold text-slate-900">Top-Class Amenities</h4>
                <p class="text-[11px] text-slate-500">Pools, gyms, spas, fine dining</p>
              </div>
            </div>

            <div class="flex items-start gap-3">
              <div class="w-9 h-9 rounded-full bg-emerald-50 text-emerald-800 flex items-center justify-center shrink-0 text-sm font-bold">🛡️</div>
              <div>
                <h4 class="text-xs sm:text-sm font-bold text-slate-900">Safe & Secure</h4>
                <p class="text-[11px] text-slate-500">Well-planned and peaceful area</p>
              </div>
            </div>

            <div class="flex items-start gap-3">
              <div class="w-9 h-9 rounded-full bg-emerald-50 text-emerald-800 flex items-center justify-center shrink-0 text-sm font-bold">🚗</div>
              <div>
                <h4 class="text-xs sm:text-sm font-bold text-slate-900">Easy Transportation</h4>
                <p class="text-[11px] text-slate-500">Quick access to all parts of Dhaka</p>
              </div>
            </div>

          </div>

        </div>
      </div>
    </section>

    <!-- 4. Optional Markdown Body (যদি আরও বড় আর্টিকেল CMS থেকে লিখতে চান) -->
    {Content && (
      <section class="max-w-4xl mx-auto px-4 pt-12">
        <article class="prose prose-slate max-w-none">
          <Content />
        </article>
      </section>
    )}

  </div>
</Layout>
