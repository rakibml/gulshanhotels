---
// src/components/landing/LocationCategoryTemplate.astro (Compact Card + Equal Height Map Layout)
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

interface Props {
  entry: any;
  Content?: any;
}

const { entry, Content } = Astro.props;
const data = entry?.data || {};

// ১. সাইট অরিজিন ও ক্যানোনিক্যাল URL
const siteOrigin = Astro.site ? Astro.site.origin : "https://gulshanhotels.com";

const rawSlug = entry?.slug || entry?.id || "";
const cleanSlug = rawSlug
  .replace(/\.(md|mdx)$/, '')
  .split('/')
  .pop()
  ?.toLowerCase()
  .trim()
  .replace(/\s+/g, '-') || "";

const canonicalUrl = `${siteOrigin}/${cleanSlug}`;

// ২. মেটাডাটা
const pageTitle = (data.title || "").trim();
const locationSubtitle = data.location_subtitle || "";
const description = (data.description || data.seo_description || "").trim();
const heroImage = data.hero_image || data.image || "";

// ৩. সব হোটেল ডাটা লোডার
let allHotels: any[] = [];
try {
  const hotelCol = await (getCollection as any)('hotels');
  if (Array.isArray(hotelCol)) {
    allHotels = hotelCol.map((h: any) => ({
      slug: (h.slug || h.id || '').replace(/\.(md|mdx)$/, '').split('/').pop()?.toLowerCase().trim(),
      data: { ...(h.data || {}), ...((h as any).frontmatter || {}) }
    }));
  }
} catch (err) {
  try {
    const rawGlob = import.meta.glob(['/src/content/hotels/*.{md,mdx}', '../../content/hotels/*.{md,mdx}'], { eager: true });
    allHotels = Object.entries(rawGlob).map(([filePath, item]: [string, any]) => ({
      slug: filePath.split('/').pop()?.replace(/\.(md|mdx)$/, '')?.toLowerCase().trim(),
      data: item?.frontmatter || item?.data || {}
    }));
  } catch (e) {}
}

// ৪. রিভিউ ডাটা লোডার
let rawReviewsList: any[] = [];
try {
  const globFiles = import.meta.glob(['/src/content/reviews/*.{md,mdx}', '../../content/reviews/*.{md,mdx}'], { eager: true });
  rawReviewsList = Object.values(globFiles).map((item: any) => item?.frontmatter || item?.data || item || {});
} catch (e) {
  rawReviewsList = [];
}

const reviewsByKey = new Map<string, any[]>();
for (const item of rawReviewsList) {
  if (!item) continue;
  const isApproved = item.approved === true || String(item.approved).trim().toLowerCase() === 'true';
  if (!isApproved) continue;

  const rSlug = String(item.slug || item.hotelSlug || item.hotel_slug || '').replace(/\.(md|mdx)$/, '').split('/').pop()?.trim().toLowerCase() || "";
  const rId = String(item.id || '').replace(/\.(md|mdx)$/, '').split('/').pop()?.trim().toLowerCase() || "";
  const rHotel = String(item.hotel || item.hotelTitle || item.hotel_name || '').trim().toLowerCase();

  const keys = new Set([rSlug, rId, rHotel].filter(Boolean));
  for (const k of keys) {
    if (!reviewsByKey.has(k)) reviewsByKey.set(k, []);
    reviewsByKey.get(k)!.push(item);
  }
}

// ৫. টেক্সট নরম্যালাইজার ও ফিল্টারিং
const normalizeText = (val: any) =>
  String(val || '')
    .toLowerCase()
    .replace(/[-_]/g, ' ')
    .replace(/\s+/g, ' ')
    .trim();

const manualSlugs = Array.isArray(data.selected_hotels)
  ? data.selected_hotels
      .map((s: any) => String(s || '').replace(/\.(md|mdx)$/, '').split('/').pop()?.toLowerCase().trim())
      .filter((s: string | undefined): s is string => Boolean(s && s.length > 0))
  : [];

const rawKeyword = String(data.filter_keyword || cleanSlug)
  .replace(/^(luxury|best|top|budget|cheap)-/i, '')
  .replace(/^hotels?-(in|near)-/i, '')
  .replace(/^hotels?-/i, '')
  .replace(/-hotels?$/i, '');

const normalizedKeyword = normalizeText(rawKeyword);

const displayHotels = allHotels.filter(h => {
  const hSlug = String(h.slug || '').toLowerCase();
  if (manualSlugs.length > 0) return manualSlugs.includes(hSlug);
  if (!normalizedKeyword) return true;

  const hLoc = normalizeText(h.data?.location || h.data?.address);
  const hCat = normalizeText(h.data?.category);
  const hTitle = normalizeText(h.data?.title || h.data?.name);

  return hLoc.includes(normalizedKeyword) || hCat.includes(normalizedKeyword) || hTitle.includes(normalizedKeyword);
});

// ৬. হেল্পার ফাংশনসমূহ
function toTitleCase(str: string) {
  if (!str) return "";
  return str.replace(/\b\w/g, char => char.toUpperCase());
}

function extractStarsNumber(category: string, stars?: any) {
  if (stars && !isNaN(Number(stars))) return String(stars);
  const match = String(category || '').match(/(\d+)\s*[-_ ]*star/i);
  return match ? match[1] : null;
}

function formatShortLocation(loc: string) {
  if (!loc) return "";
  const parts = loc.split(',').map(s => s.trim());
  return parts.length >= 2 ? `${parts[0]}, ${parts[1]}` : loc;
}

function formatPriceDisplay(rawPrice: any) {
  if (!rawPrice) return null;
  const pStr = String(rawPrice).trim();
  return pStr.includes('/') ? pStr.split('/')[0].trim() : pStr;
}

function plainText(str: any) {
  return String(str || '')
    .replace(/<[^>]*>/g, '')
    .replace(/[*_`#>]/g, '')
    .replace(/\s+/g, ' ')
    .trim();
}

// ৭. স্মার্ট টাইটেল ও ম্যাপ কুয়েরি
const cleanTitleName = pageTitle
  .replace(/^hotels?\s+in\s+/i, '')
  .replace(/^hotels?\s+near\s+/i, '')
  .trim();

const hotelsTag = data.hotels_tag || "CURATED STAYS";
const hotelsTitle = data.hotels_title || (cleanTitleName ? `Verified Stays in ${toTitleCase(cleanTitleName)}` : `Top Accommodations`);

const mapQuery = encodeURIComponent(`${cleanTitleName || pageTitle}, Dhaka, Bangladesh`);
const googleMapUrl = `https://maps.google.com/maps?q=${mapQuery}&t=&z=14&ie=UTF8&iwloc=&output=embed`;

const rawFaqs = Array.isArray(data.faqs) ? data.faqs : [];
const faqs = rawFaqs.filter((f: any) => f && plainText(f.question).length > 0 && plainText(f.answer).length > 0);

// ৮. গুগল কমপ্লায়েন্ট JSON-LD স্কিমা
const schemaGraph: any[] = [
  {
    "@type": "BreadcrumbList",
    "@id": `${canonicalUrl}#breadcrumb`,
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": `${siteOrigin}/` },
      { "@type": "ListItem", "position": 2, "name": toTitleCase(pageTitle) || "Destinations", "item": canonicalUrl }
    ]
  }
];

if (displayHotels.length > 0) {
  schemaGraph.push({
    "@type": "ItemList",
    "@id": `${canonicalUrl}#itemlist`,
    "name": toTitleCase(pageTitle),
    ...(description ? { "description": description } : {}),
    "numberOfItems": displayHotels.length,
    "itemListElement": displayHotels.map((h, idx) => ({
      "@type": "ListItem",
      "position": idx + 1,
      "name": toTitleCase(h.data?.title || h.data?.name || `Hotel Stay`),
      "url": `${siteOrigin}/${h.slug}`
    }))
  });
}

if (faqs.length > 0) {
  schemaGraph.push({
    "@type": "FAQPage",
    "@id": `${canonicalUrl}#faq`,
    "mainEntity": faqs.map((f: any) => ({
      "@type": "Question",
      "name": plainText(f.question),
      "acceptedAnswer": {
        "@type": "Answer",
        "text": plainText(f.answer)
      }
    }))
  });
}

const masterSchemaJson = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": schemaGraph
}).replace(/</g, "\\u003c");
---

<Layout 
  title={`${toTitleCase(pageTitle)} — Verified Hotels & Area Guide`} 
  description={description} 
  image={heroImage}
  canonical={canonicalUrl}
>
  <script type="application/ld+json" set:html={masterSchemaJson} />

  <div class="w-full bg-[#fcfbfa] text-slate-800 font-sans pb-24">

    <!-- ================= ১. সিনেমাটিক ব্যানার (স্থায়ী লকড অংশ) ================= -->
    <header class="relative w-full aspect-[21/9] min-h-[300px] sm:min-h-[420px] max-h-[520px] bg-slate-950 overflow-hidden">
      {heroImage ? (
        <img
          src={heroImage}
          alt={pageTitle}
          class="w-full h-full object-cover"
          fetchpriority="high"
        />
      ) : (
        <div class="w-full h-full bg-slate-900" />
      )}
      
      <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/30 to-transparent"></div>

      <!-- ব্যানারের বাম কোণায় টাইটেল ও সাবটাইটেল -->
      <div class="absolute bottom-6 sm:bottom-10 left-4 sm:left-8 lg:left-12 z-10 text-white space-y-1 text-left max-w-2xl">
        <span class="block font-serif text-2xl sm:text-4xl lg:text-5xl font-black tracking-tight drop-shadow-md text-white">
          {toTitleCase(pageTitle)}
        </span>
        
        {locationSubtitle && (
          <p class="text-xs sm:text-sm font-bold uppercase tracking-wider text-slate-200 flex items-center gap-1.5 drop-shadow">
            <span>{locationSubtitle}</span>
            <span class="text-amber-400 font-black text-base leading-none">›</span>
          </p>
        )}
      </div>
    </header>

    <!-- ================= ২. ব্রেডক্রাম্ব ও H1 + আর্টিকেল (স্থায়ী লকড অংশ) ================= -->
    <section class="w-full px-4 sm:px-8 lg:px-12 pt-8 sm:pt-12 text-left">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start">
        
        <!-- বাম কলাম: ব্রেডক্রাম্ব -->
        <div class="lg:col-span-3 pt-2">
          <nav aria-label="Breadcrumb" class="flex flex-wrap items-center gap-1.5 text-xs sm:text-sm text-[#0d3b23] font-semibold tracking-wide">
            <a href="/" class="hover:underline">Home</a>
            <span class="text-slate-400">›</span>
            <a href="/#hotels" class="hover:underline">Hotels</a>
            <span class="text-slate-400">›</span>
            <span class="text-slate-600 font-normal">{toTitleCase(pageTitle)}</span>
          </nav>
        </div>

        <!-- ডান কলাম: H1 হেডিং ও আর্টিকেল -->
        <div class="lg:col-span-9 max-w-4xl">
          <h1 class="font-serif text-3xl sm:text-5xl lg:text-6xl font-black text-slate-900 tracking-tight leading-tight mb-6">
            {toTitleCase(pageTitle)}
          </h1>

          {description && (
            <div class="text-base sm:text-lg text-slate-700 font-normal leading-relaxed mb-6">
              <p>{description}</p>
            </div>
          )}

          {Content && (
            <div class="prose prose-slate prose-lg max-w-none prose-headings:font-serif prose-headings:font-bold prose-headings:text-slate-900 prose-p:leading-relaxed prose-a:text-emerald-800 border-b border-slate-200/80 pb-10">
              <Content />
            </div>
          )}
        </div>

      </div>
    </section>

    <!-- ================= ৩. কমপ্যাক্ট হোটেল কার্ড ও সমান উচ্চতার ছোট ম্যাপ ================= -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-8 pb-16 text-left">
      
      <!-- হেডার ও সার্চবার -->
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 border-b border-slate-200 pb-4 mb-8">
        <div>
          <span class="text-[11px] font-bold tracking-widest uppercase text-[#0d3b23] block">— {hotelsTag}</span>
          <h2 class="text-2xl sm:text-3xl font-serif font-black text-slate-900 mt-0.5">
            {hotelsTitle}
          </h2>
          <p class="text-xs text-slate-500 font-medium mt-1">
            Showing {displayHotels.length} verified {displayHotels.length === 1 ? 'property' : 'properties'} in {toTitleCase(cleanTitleName)}
          </p>
        </div>

        <!-- অন-পেজ সার্চ ইনপুট -->
        <div class="w-full sm:w-72 bg-white rounded-xl shadow-xs px-3 py-2 flex items-center border border-slate-200">
          <svg aria-hidden="true" class="w-4 h-4 text-slate-400 mr-2 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <circle cx="11" cy="11" r="8"/>
            <path d="m21 21-4.35-4.35"/>
          </svg>
          <input
            type="text"
            id="onPageHotelFilterInput"
            aria-label="Filter hotels on this page"
            placeholder="Search hotel or amenity..."
            class="w-full text-xs text-slate-800 placeholder-slate-400 bg-transparent focus:outline-none font-medium"
          />
        </div>
      </div>

      <!-- ২-কলাম স্প্লিট: বামে হোটেল কার্ড + ডানে সমান উচ্চতার কমপ্যাক্ট ম্যাপ -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
        
        <!-- বাম পাশ (৭ কলাম): কমপ্যাক্ট হোটেল কার্ড -->
        <div class="lg:col-span-7 space-y-4">
          <div id="landingHotelsGrid" class="space-y-4">
            {displayHotels.length === 0 ? (
              <div class="text-center py-12 text-slate-500 text-sm bg-white rounded-2xl border border-dashed border-slate-300">
                No accommodations match the selected criteria.
              </div>
            ) : (
              displayHotels.map((h) => {
                const hd = h.data || {};
                const hotelTitle = (hd.title || hd.name || "").trim();
                const hotelSlug = String(h.slug || "").trim();
                const hotelUrl = `/${hotelSlug}`;

                const starCount = extractStarsNumber(hd.category, hd.stars);
                const shortLoc = formatShortLocation(hd.location || hd.address || "");
                const price = formatPriceDisplay(hd.price);
                const cardImage = hd.image || (Array.isArray(hd.gallery) ? hd.gallery[0] : "");
                
                const rawAmenities = Array.isArray(hd.amenities) ? hd.amenities : [];
                const topAmenities = rawAmenities.slice(0, 3).map((a: any) => {
                  if (typeof a === 'string') return a.trim();
                  if (typeof a === 'object') return (a?.name || a?.title || '').trim();
                  return '';
                }).filter(Boolean);

                const searchTitle = hotelTitle.toLowerCase();
                const searchSlug = hotelSlug.toLowerCase();
                const approvedSet = new Set<any>([
                  ...(searchSlug ? (reviewsByKey.get(searchSlug) || []) : []),
                  ...(searchTitle ? (reviewsByKey.get(searchTitle) || []) : [])
                ]);
                const combinedRawReviews = [...Array.from(approvedSet), ...(Array.isArray(hd.reviews) ? hd.reviews : [])];

                const validReviews = combinedRawReviews.map((rev: any) => ({
                  rating: Number(rev.rating) || 0,
                  comment: String(rev.comment || rev.review || rev.body || '').trim()
                })).filter(r => r.comment.length > 1 && r.rating > 0);

                const reviewCount = validReviews.length;
                const reviewScore = reviewCount > 0
                  ? (validReviews.reduce((sum: number, r: any) => sum + r.rating, 0) / reviewCount).toFixed(1)
                  : (hd.rating ? Number(hd.rating).toFixed(1) : null);

                return (
                  <div 
                    class="landing-hotel-card bg-white rounded-2xl border border-slate-200/90 overflow-hidden shadow-xs hover:shadow-md hover:border-emerald-700/40 transition-all duration-300 flex flex-col sm:flex-row group text-left h-auto sm:h-52"
                    data-name={hotelTitle.toLowerCase()}
                    data-location={shortLoc.toLowerCase()}
                  >
                    <!-- ইমেজ -->
                    <div class="w-full sm:w-56 md:w-60 h-44 sm:h-full relative shrink-0 overflow-hidden bg-slate-100">
                      {cardImage && (
                        <a href={hotelUrl} class="block w-full h-full">
                          <img
                            src={cardImage}
                            alt={hotelTitle}
                            loading="lazy"
                            decoding="async"
                            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                          />
                        </a>
                      )}
                      
                      {starCount && (
                        <div class="absolute top-2.5 left-2.5 bg-[#0d3b23] text-white text-[10px] font-bold px-2 py-0.5 rounded flex items-center gap-1 shadow">
                          <span>{starCount}</span>
                          <svg aria-hidden="true" class="w-3 h-3 fill-amber-300" viewBox="0 0 24 24">
                            <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                          </svg>
                        </div>
                      )}
                    </div>

                    <!-- ডিটেইলস -->
                    <div class="flex-1 p-4 sm:p-4.5 flex flex-col justify-between space-y-2 overflow-hidden">
                      
                      <div class="space-y-1.5">
                        <div class="flex items-center gap-1.5 text-[9px] font-bold">
                          <span class="px-2 py-0.5 rounded-full bg-emerald-50 text-emerald-800 border border-emerald-200/70">
                            Verified Property
                          </span>
                          <span class="px-2 py-0.5 rounded-full bg-slate-100 text-slate-600">
                            Diplomatic Zone
                          </span>
                        </div>

                        <div>
                          <h3 class="font-serif font-black text-base sm:text-lg text-slate-900 group-hover:text-[#0d3b23] transition truncate">
                            <a href={hotelUrl}>{toTitleCase(hotelTitle)}</a>
                          </h3>
                          {shortLoc && (
                            <p class="text-[11px] text-slate-500 flex items-center gap-1 mt-0.5 truncate">
                              <svg aria-hidden="true" class="w-3 h-3 text-emerald-700 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M12 2a8 8 0 0 0-8 8c0 5.25 8 12 8 12s8-6.75 8-12a8 8 0 0 0-8-8z"/>
                                <circle cx="12" cy="10" r="3"/>
                              </svg>
                              <span class="truncate">{shortLoc}</span>
                            </p>
                          )}
                        </div>

                        <!-- রেটিং -->
                        {reviewCount > 0 ? (
                          <div class="flex items-center gap-1.5 text-xs">
                            <span class="text-amber-500 font-bold flex items-center gap-0.5">
                              ★ {reviewScore}
                            </span>
                            <span class="text-slate-400 text-[11px]">
                              ({reviewCount} reviews)
                            </span>
                          </div>
                        ) : null}

                        <!-- ৩টি প্রধান সুবিধা -->
                        {topAmenities.length > 0 && (
                          <div class="flex flex-wrap items-center gap-x-2.5 gap-y-1 text-[10px] text-slate-600 font-medium pt-0.5">
                            {topAmenities.map((item: string) => (
                              <span class="flex items-center gap-1">
                                <svg aria-hidden="true" class="w-2.5 h-2.5 text-emerald-700 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>
                                <span class="truncate">{item}</span>
                              </span>
                            ))}
                          </div>
                        )}
                      </div>

                      <!-- প্রাইস ও বাটন বার -->
                      <div class="pt-2.5 border-t border-slate-100 flex items-center justify-between">
                        {price ? (
                          <div>
                            <span class="text-[9px] text-slate-400 block font-medium uppercase leading-none">From</span>
                            <div class="flex items-baseline gap-1 mt-0.5">
                              <span class="text-base sm:text-lg font-black text-[#0d3b23]">{price}</span>
                              <span class="text-[10px] text-slate-500">/ night</span>
                            </div>
                          </div>
                        ) : (
                          <span class="text-xs font-bold text-slate-700">Check Rates</span>
                        )}

                        <a 
                          href={hotelUrl} 
                          class="inline-flex items-center justify-center gap-1 bg-[#0d3b23] hover:bg-[#134e30] text-white px-3.5 py-1.5 rounded-lg text-xs font-bold transition-all shadow-2xs"
                        >
                          <span>View Details</span>
                          <span class="text-xs">→</span>
                        </a>
                      </div>

                    </div>
                  </div>
                );
              })
            )}
          </div>

          <div id="filterEmptyState" class="hidden text-center py-10 text-slate-500 text-xs bg-white rounded-2xl border border-dashed border-slate-300">
            No hotels match your search.
          </div>
        </div>

        <!-- 🔥 ডান পাশ (৫ কলাম): হুবহু হোটেল কার্ডের সমান ছোট ম্যাপ (উচ্চতা ২০৮px / sm:h-52) 🔥 -->
        <aside class="lg:col-span-5 lg:sticky lg:top-6">
          <div class="bg-white rounded-2xl border border-slate-200/90 overflow-hidden shadow-xs flex flex-col h-auto sm:h-52">
            
            <!-- ম্যাপ হেডার -->
            <div class="px-3.5 py-1.5 border-b border-slate-100 flex items-center justify-between bg-slate-50/80 shrink-0">
              <span class="text-[11px] font-bold text-slate-800 flex items-center gap-1.5">
                <span>📍</span>
                <span>{toTitleCase(cleanTitleName)} Area Map</span>
              </span>
              <a 
                href={`https://maps.google.com/?q=${mapQuery}`} 
                target="_blank" 
                rel="noopener noreferrer" 
                class="text-[10px] font-bold text-emerald-800 hover:underline"
              >
                Open Full Map ↗
              </a>
            </div>

            <!-- লাইভ ইন্টারেক্টিভ ম্যাপ ফ্রেম (বাকি অংশ পূরণ করে একদম সমান থাকবে) -->
            <div class="relative w-full flex-1 min-h-[160px] bg-slate-100">
              <iframe
                title={`Map of ${pageTitle}`}
                width="100%"
                height="100%"
                style="border:0;"
                loading="lazy"
                allowfullscreen
                referrerpolicy="no-referrer-when-downgrade"
                src={googleMapUrl}
                class="w-full h-full filter contrast-[1.02]"
              ></iframe>
            </div>

          </div>
        </aside>

      </div>
    </section>

    <!-- ================= ৪. FAQ সেকশন ================= -->
    {faqs.length > 0 && (
      <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-16 sm:pt-20 text-left border-t border-slate-200 mt-16">
        <h2 class="font-serif text-2xl sm:text-4xl font-black text-slate-900 tracking-tight leading-tight mb-8">
          Frequently Asked Questions
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-0 items-start">
          {faqs.map((f: any, i: number) => (
            <details class="group border-b border-slate-200 py-4 sm:py-5 transition-all text-left" open={i === 0}>
              <summary class="flex justify-between items-center list-none font-bold text-sm sm:text-base text-slate-900 group-hover:text-[#0d3b23] cursor-pointer select-none gap-4">
                <span class="leading-snug pr-2 font-serif font-bold">{f.question}</span>
                <span class="w-6 h-6 rounded-full border border-slate-200 bg-slate-50 group-hover:border-emerald-600 group-hover:bg-emerald-50 text-slate-500 group-hover:text-[#0d3b23] flex items-center justify-center shrink-0 transition-colors">
                  <span class="block group-open:hidden text-sm leading-none font-bold">+</span>
                  <span class="hidden group-open:block text-sm leading-none font-bold">−</span>
                </span>
              </summary>
              <p class="pt-3 text-xs sm:text-sm text-slate-600 leading-relaxed font-normal">
                {f.answer}
              </p>
            </details>
          ))}
        </div>
      </section>
    )}

  </div>
</Layout>

<!-- লাইভ সার্চ ফিল্টার স্ক্রিপ্ট -->
<script is:inline>
  const initOnPageFilter = () => {
    const input = document.getElementById('onPageHotelFilterInput');
    const cards = document.querySelectorAll('.landing-hotel-card');
    const emptyState = document.getElementById('filterEmptyState');

    if (input && !input.dataset.listenerAttached) {
      input.dataset.listenerAttached = 'true';
      input.addEventListener('input', () => {
        const query = input.value.trim().toLowerCase();
        let visibleCount = 0;

        cards.forEach(card => {
          const name = (card.getAttribute('data-name') || '').toLowerCase();
          const loc = (card.getAttribute('data-location') || '').toLowerCase();

          if (!query || name.includes(query) || loc.includes(query)) {
            card.classList.remove('hidden');
            visibleCount++;
          } else {
            card.classList.add('hidden');
          }
        });

        if (emptyState) {
          if (visibleCount === 0) {
            emptyState.classList.remove('hidden');
          } else {
            emptyState.classList.add('hidden');
          }
        }
      });
    }
  };

  document.addEventListener('DOMContentLoaded', initOnPageFilter);
  document.addEventListener('astro:page-load', initOnPageFilter);
</script>
