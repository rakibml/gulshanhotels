---
// src/components/landing/LocationCategoryTemplate.astro
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

interface Props {
  entry: any;
  Content?: any;
}

const { entry, Content } = Astro.props;
const data = entry?.data || {};

// ১. পেজের মেটাডাটা
const pageTitle = (data.title || "").trim();
const locationSubtitle = data.location_subtitle || "Dhaka, Bangladesh";
const description = (data.description || data.seo_description || "").trim();
const cleanSlug = (entry?.slug || entry?.id || "").replace(/\.(md|mdx)$/, '').split('/').pop()?.toLowerCase() || "";
const heroImage = data.hero_image || data.image || "";

// ২. সব হোটেল লোডার (প্রথমে getCollection, না হলে glob fallback)
let allHotels: any[] = [];
try {
  const hotelCol = await (getCollection as any)('hotels');
  if (Array.isArray(hotelCol)) {
    allHotels = hotelCol.map((h: any) => ({
      slug: (h.slug || h.id || '').replace(/\.(md|mdx)$/, '').split('/').pop()?.toLowerCase(),
      data: { ...(h.data || {}), ...((h as any).frontmatter || {}) }
    }));
  }
} catch (err) {
  console.warn('[LocationCategoryTemplate] getCollection(hotels) failed, using glob:', err);
  try {
    const rawGlob = import.meta.glob(['/src/content/hotels/*.{md,mdx}', '../../content/hotels/*.{md,mdx}'], { eager: true });
    allHotels = Object.entries(rawGlob).map(([filePath, item]: [string, any]) => ({
      slug: filePath.split('/').pop()?.replace(/\.(md|mdx)$/, '')?.toLowerCase(),
      data: item?.frontmatter || item?.data || {}
    }));
  } catch (e) {
    console.warn('[LocationCategoryTemplate] hotels glob failed:', e);
  }
}

// ৩. সব রিভিউ ডাটা ফেচিং
let rawReviewsList: any[] = [];
try {
  const globFiles = import.meta.glob('/src/content/reviews/*.{md,mdx}', { eager: true });
  const entries = Object.values(globFiles);

  if (entries.length > 0) {
    rawReviewsList = entries.map((item: any) => item?.frontmatter || item?.data || item || {});
  } else {
    const relFiles = import.meta.glob('../../content/reviews/*.{md,mdx}', { eager: true });
    rawReviewsList = Object.values(relFiles).map((item: any) => item?.frontmatter || item?.data || item || {});
  }
} catch (e) {
  console.warn('[LocationCategoryTemplate] reviews glob failed:', e);
  rawReviewsList = [];
}

// ৩.১ রিভিউগুলো একবারই হোটেল অনুযায়ী গ্রুপ করা (দ্রুত build এর জন্য)
const reviewsByKey = new Map<string, any[]>();
for (const item of rawReviewsList) {
  if (!item) continue;
  const isApproved = item.approved === true || String(item.approved).trim().toLowerCase() === 'true';
  if (!isApproved) continue;

  const rSlug = String(item.slug || item.hotelSlug || item.hotel_slug || '').replace(/\.(md|mdx)$/, '').split('/').pop()?.trim().toLowerCase() || "";
  const rId = String(item.id || '').replace(/\.(md|mdx)$/, '').split('/').pop()?.trim().toLowerCase() || "";
  const rHotel = String(item.hotel || item.hotelTitle || item.hotel_name || '').trim().toLowerCase();

  // একই রিভিউ একই key তে দুইবার যেন না যায়
  const keys = new Set([rSlug, rId, rHotel].filter(Boolean));
  for (const k of keys) {
    if (!reviewsByKey.has(k)) reviewsByKey.set(k, []);
    reviewsByKey.get(k)!.push(item);
  }
}

// ৪. হোটেল ফিল্টারিং (title দিয়ে আর ফিল্টার হবে না, শুধু location আর category)
const manualSlugs = Array.isArray(data.selected_hotels)
  ? data.selected_hotels.map((s: string) => String(s).toLowerCase().trim())
  : [];
const matchKeyword = String(data.filter_keyword || cleanSlug).replace(/-/g, ' ').toLowerCase().trim();

const displayHotels = allHotels.filter(h => {
  const hSlug = String(h.slug || '').toLowerCase();
  const hLoc = String(h.data?.location || '').toLowerCase();
  const hCat = String(h.data?.category || '').toLowerCase();

  if (manualSlugs.length > 0) return manualSlugs.includes(hSlug);
  if (!matchKeyword) return false;
  return hLoc.includes(matchKeyword) || hCat.includes(matchKeyword);
});

// ৫. টেক্সট ও ডাটা হেল্পার ফাংশন
function toTitleCase(str: string) {
  if (!str) return "";
  return str.replace(/\b\w/g, char => char.toUpperCase());
}

function extractStarsNumber(category: string) {
  const match = String(category || '').match(/(\d+)\s*[-_ ]*star/i);
  return match ? match[1] : null;
}

function formatShortLocation(loc: string) {
  if (!loc) return "";
  const parts = loc.split(',').map(s => s.trim());
  if (parts.length >= 2) return `${parts[1] || parts[0]}, Dhaka`;
  return loc;
}

function formatPriceDisplay(rawPrice: any) {
  if (!rawPrice) return null;
  const pStr = String(rawPrice).trim();
  const base = pStr.includes('/') ? pStr.split('/')[0].trim() : pStr;
  return base;
}

// HTML / markdown সরিয়ে plain text বানায় (Google FAQ schema এর জন্য)
function plainText(str: any) {
  return String(str || '')
    .replace(/\[([^\]]+)\]\([^)]+\)/g, '$1')
    .replace(/<[^>]*>/g, '')
    .replace(/[*_`#>]/g, '')
    .replace(/\s+/g, ' ')
    .trim();
}

// ৬. "Why Stay" এবং FAQs ডাটা
const aboutImage = data.about_image || heroImage;
const aboutText = data.about_text || description;
const faqs = Array.isArray(data.faqs) ? data.faqs : [];

const siteOrigin = Astro.site ? Astro.site.origin : "";
const canonicalUrl = siteOrigin ? `${siteOrigin}/${cleanSlug}` : `/${cleanSlug}`;

// ৭. গুগল এসইও স্কিমা (Breadcrumb + ItemList + FAQPage)
const schemaGraph: any[] = [
  {
    "@type": "BreadcrumbList",
    "@id": `${canonicalUrl}#breadcrumb`,
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": siteOrigin ? `${siteOrigin}/` : "/" },
      { "@type": "ListItem", "position": 2, "name": toTitleCase(pageTitle), "item": canonicalUrl }
    ]
  }
];

// হোটেল থাকলেই শুধু ItemList যাবে
if (displayHotels.length > 0) {
  schemaGraph.push({
    "@type": "ItemList",
    "@id": `${canonicalUrl}#itemlist`,
    "name": pageTitle,
    "description": description,
    "numberOfItems": displayHotels.length,
    "itemListElement": displayHotels.map((h, idx) => ({
      "@type": "ListItem",
      "position": idx + 1,
      "name": toTitleCase(h.data?.title || ""),
      "url": `${siteOrigin}/${h.slug}`
    }))
  });
}

if (faqs.length > 0) {
  schemaGraph.push({
    "@type": "FAQPage",
    "@id": `${canonicalUrl}#faq`,
    "mainEntity": faqs.map((f: any) => ({
      "@type": "Question",
      "name": plainText(f.question),
      "acceptedAnswer": {
        "@type": "Answer",
        "text": plainText(f.answer)
      }
    }))
  });
}

const masterSchema = {
  "@context": "https://schema.org",
  "@graph": schemaGraph
};
---

<Layout title={`${toTitleCase(pageTitle)} — Verified Stays & Guide`} description={description} image={heroImage}>
  <script type="application/ld+json" set:html={JSON.stringify(masterSchema)} />

  <div class="w-full bg-[#f8faf9] text-slate-800 font-sans pb-20">

    <!-- ================= 1. HERO BANNER WITH SEARCH (LEFT-ALIGNED) ================= -->
    <header class="relative bg-slate-950 text-white min-h-[460px] flex items-center pb-20 pt-14 px-4 sm:px-6 lg:px-8">
      {heroImage && (
        <img
          src={heroImage}
          alt={pageTitle}
          class="absolute inset-0 w-full h-full object-cover opacity-40"
          fetchpriority="high"
        />
      )}
      <div class="absolute inset-0 bg-gradient-to-r from-black/95 via-black/75 to-black/30"></div>

      <div class="relative z-10 max-w-7xl mx-auto w-full text-left space-y-4">

        <!-- Location Subtitle with Map Pin SVG -->
        <div class="flex items-center justify-start gap-1.5 text-xs sm:text-sm text-slate-300 font-medium tracking-wide">
          <svg class="w-4 h-4 text-emerald-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 2a8 8 0 0 0-8 8c0 5.25 8 12 8 12s8-6.75 8-12a8 8 0 0 0-8-8z"/>
            <circle cx="12" cy="10" r="3"/>
          </svg>
          <span>{locationSubtitle}</span>
        </div>

        <!-- Heading -->
        <h1 class="font-serif text-3xl sm:text-5xl lg:text-6xl font-black text-white tracking-tight">
          {toTitleCase(pageTitle)}
        </h1>

        <!-- Subtitle Description -->
        {description && (
          <p class="max-w-2xl text-xs sm:text-base text-slate-300 font-light leading-relaxed">
            {description}
          </p>
        )}

        <!-- Feature Badges Row -->
        <div class="flex flex-wrap items-center justify-start gap-4 sm:gap-7 pt-3 text-xs sm:text-sm text-slate-200">

          <span class="flex items-center gap-1.5 font-medium">
            <svg class="w-4 h-4 text-emerald-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M6 3h12l4 6-10 12L2 9z"/>
              <path d="M11 3 8 9l4 12 4-12-3-6"/>
            </svg>
            <span>Luxury Hotels</span>
          </span>

          <span class="flex items-center gap-1.5 font-medium">
            <svg class="w-4 h-4 text-amber-400 shrink-0" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
            </svg>
            <span>Top Rated</span>
          </span>

          <span class="flex items-center gap-1.5 font-medium">
            <svg class="w-4 h-4 text-emerald-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 2a8 8 0 0 0-8 8c0 5.25 8 12 8 12s8-6.75 8-12a8 8 0 0 0-8-8z"/>
              <circle cx="12" cy="10" r="3"/>
            </svg>
            <span>Prime Location</span>
          </span>

          <span class="flex items-center gap-1.5 font-medium">
            <svg class="w-4 h-4 text-emerald-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
              <path d="m9 12 2 2 4-4"/>
            </svg>
            <span>Trusted Directory</span>
          </span>

        </div>
      </div>

      <!-- Floating Search Bar -->
      <div class="absolute -bottom-7 left-4 right-4 max-w-7xl mx-auto z-20 px-0 sm:px-6 lg:px-8">
        <form action="/search" method="GET" class="bg-white rounded-2xl shadow-xl p-2 sm:p-2.5 flex items-center border border-slate-100 max-w-3xl">
          <div class="pl-3 pr-2 text-slate-400">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <circle cx="11" cy="11" r="8"/>
              <path d="m21 21-4.35-4.35"/>
            </svg>
          </div>
          <input
            type="text"
            name="q"
            placeholder={`Search hotels in ${toTitleCase(pageTitle)}...`}
            class="w-full text-xs sm:text-sm text-slate-800 placeholder-slate-400 bg-transparent focus:outline-none"
          />
          <button type="submit" aria-label="Search" class="bg-[#0d3b23] hover:bg-[#082918] text-white p-2.5 sm:px-4 sm:py-2.5 rounded-xl transition duration-200 shrink-0">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
              <circle cx="11" cy="11" r="8"/>
              <path d="m21 21-4.35-4.35"/>
            </svg>
          </button>
        </form>
      </div>
    </header>


    <!-- ================= 2. FEATURED HOTELS SECTION ================= -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-20 space-y-8">

      <!-- Section Header -->
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 border-b border-slate-200 pb-4 text-left">
        <div>
          <span class="text-[11px] font-bold tracking-widest uppercase text-[#0d3b23]">— FEATURED HOTELS</span>
          <h2 class="text-2xl sm:text-3xl font-serif font-black text-slate-900 mt-0.5">Top {toTitleCase(pageTitle)}</h2>
          <p class="text-xs sm:text-sm text-slate-500 mt-1">Handpicked hotels with verified amenities and locations.</p>
        </div>
        <a href="/hotels" class="text-xs sm:text-sm font-bold text-[#0d3b23] hover:underline flex items-center gap-1 self-start sm:self-auto">
          <span>View All Hotels</span>
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      </div>

      <!-- Hotels Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-7">
        {displayHotels.length === 0 ? (
          <div class="col-span-full text-center py-12 text-slate-500 text-sm">
            No hotels currently listed for this area.
          </div>
        ) : (
          displayHotels.map((h) => {
            const hd = h.data || {};
            const hotelTitle = (hd.title || hd.name || "Hotel Details").trim();

            // এক জায়গা থেকেই slug (উপরে ready করা h.slug)
            const hotelSlug = String(h.slug || "").trim();
            const hotelUrl = `/${hotelSlug}`;

            const starCount = extractStarsNumber(hd.category);
            const shortLoc = formatShortLocation(hd.location || "");
            const price = formatPriceDisplay(hd.price);
            const cardImage = hd.image || (Array.isArray(hd.gallery) ? hd.gallery[0] : "");
            const rawAmenities = Array.isArray(hd.amenities) ? hd.amenities : [];
            const topAmenities = rawAmenities.slice(0, 4).map((a: any) => typeof a === 'object' ? a.name : a);

            // ================= রিভিউ (আগে থেকে গ্রুপ করা map থেকে) =================
            const searchTitle = hotelTitle.toLowerCase();
            const searchSlug = hotelSlug.toLowerCase();

            const approvedSet = new Set<any>([
              ...(searchSlug ? (reviewsByKey.get(searchSlug) || []) : []),
              ...(searchTitle ? (reviewsByKey.get(searchTitle) || []) : [])
            ]);
            const approvedCmsReviews = Array.from(approvedSet);

            const hotelEmbeddedReviews = Array.isArray(hd.reviews) ? hd.reviews : [];
            const combinedRawReviews = [...approvedCmsReviews, ...hotelEmbeddedReviews];

            // rating না থাকলে ওই রিভিউ বাদ (আর 5 ধরা হবে না)
            const validReviews = combinedRawReviews.map((rev: any) => ({
              rating: Number(rev.rating) || 0,
              comment: String(rev.comment || rev.review || rev.body || '').trim()
            })).filter(r => r.comment.length > 1 && r.rating > 0);

            const reviewCount = validReviews.length;
            const reviewScore = reviewCount > 0
              ? (validReviews.reduce((sum: number, r: any) => sum + r.rating, 0) / reviewCount).toFixed(1)
              : (hd.rating || "");

            return (
              <div class="bg-white rounded-2xl border border-slate-200/85 overflow-hidden shadow-xs hover:shadow-xl hover:border-emerald-700/30 transition-all duration-300 flex flex-col justify-between group">
                <div>

                  <!-- Hotel Cover Image -->
                  <div class="relative aspect-[16/10] overflow-hidden bg-slate-100">
                    {cardImage && (
                      <a href={hotelUrl} class="block w-full h-full">
                        <img
                          src={cardImage}
                          alt={hotelTitle}
                          loading="lazy"
                          decoding="async"
                          class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                        />
                      </a>
                    )}

                    <!-- Star Badge -->
                    {starCount && (
                      <div class="absolute top-3 left-3 bg-[#0d3b23] text-white text-[11px] font-bold px-2 py-0.5 rounded-md flex items-center gap-1 shadow">
                        <span>{starCount}</span>
                        <svg class="w-3 h-3 fill-amber-300" viewBox="0 0 24 24">
                          <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                        </svg>
                      </div>
                    )}
                  </div>

                  <!-- Details Body -->
                  <div class="p-4 sm:p-5 space-y-2 text-left">

                    <!-- Title & Location -->
                    <div>
                      <h3 class="font-serif font-bold text-base sm:text-lg text-slate-900 group-hover:text-[#0d3b23] transition line-clamp-1">
                        <a href={hotelUrl}>{toTitleCase(hotelTitle)}</a>
                      </h3>
                      {shortLoc && (
                        <p class="text-xs text-slate-500 flex items-center gap-1 mt-0.5">
                          <svg class="w-3.5 h-3.5 text-emerald-600 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M12 2a8 8 0 0 0-8 8c0 5.25 8 12 8 12s8-6.75 8-12a8 8 0 0 0-8-8z"/>
                            <circle cx="12" cy="10" r="3"/>
                          </svg>
                          <span class="truncate">{shortLoc}</span>
                        </p>
                      )}
                    </div>

                    <!-- REAL REVIEW ROW -->
                    {reviewCount > 0 ? (
                      <div class="flex items-center gap-1.5 text-xs pt-0.5">
                        {reviewScore && (
                          <div class="flex items-center gap-1 text-amber-500 font-bold">
                            <svg class="w-3.5 h-3.5 fill-amber-400 shrink-0" viewBox="0 0 24 24">
                              <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                            </svg>
                            <span>{reviewScore}</span>
                          </div>
                        )}
                        <span class="text-slate-400 font-normal">
                          ({reviewCount} {reviewCount === 1 ? "review" : "reviews"})
                        </span>
                      </div>
                    ) : (
                      <div class="flex items-center gap-1 text-[11px] text-slate-400 pt-0.5">
                        <svg class="w-3 h-3 fill-slate-300" viewBox="0 0 24 24">
                          <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                        </svg>
                        <span>No reviews yet</span>
                      </div>
                    )}

                    <!-- Amenities with Clean SVG Icons -->
                    {topAmenities.length > 0 && (
                      <div class="flex flex-wrap items-center gap-x-3.5 gap-y-1 pt-1.5 text-[11px] text-slate-600">
                        {topAmenities.map((item: string) => {
                          const lower = String(item).toLowerCase();
                          return (
                            <span class="flex items-center gap-1">
                              {lower.includes('pool') && (
                                <svg class="w-3.5 h-3.5 text-emerald-600 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                  <path d="M2 12c1.5 0 2.5.8 4 1 1.5.2 2.5-.8 4-1 1.5-.2 2.5.8 4 1 1.5.2 2.5-.8 4-1 1.5-.2 2.5.8 4 1"/>
                                  <path d="M2 18c1.5 0 2.5.8 4 1 1.5.2 2.5-.8 4-1 1.5-.2 2.5.8 4 1 1.5.2 2.5-.8 4-1 1.5-.2 2.5.8 4 1"/>
                                  <circle cx="12" cy="5" r="2"/>
                                </svg>
                              )}

                              {(lower.includes('wi-fi') || lower.includes('wifi')) && (
                                <svg class="w-3.5 h-3.5 text-emerald-600 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                  <path d="M5 12.55a11 11 0 0 1 14.08 0"/>
                                  <path d="M1.42 9a16 16 0 0 1 21.16 0"/>
                                  <path d="M8.53 16.11a6 6 0 0 1 6.95 0"/>
                                  <circle cx="12" cy="20" r="1" fill="currentColor"/>
                                </svg>
                              )}

                              {(lower.includes('spa') || lower.includes('wellness')) && (
                                <svg class="w-3.5 h-3.5 text-emerald-600 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                  <path d="M12 2a5 5 0 0 0-5 5c0 4 5 10 5 10s5-6 5-10a5 5 0 0 0-5-5z"/>
                                  <path d="M7 14c-3 1-5 4-5 6h20c0-2-2-5-5-6"/>
                                </svg>
                              )}

                              {(lower.includes('gym') || lower.includes('fitness')) && (
                                <svg class="w-3.5 h-3.5 text-emerald-600 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                  <path d="m6.5 6.5 11 11M4 9l2-2 4 4-2 2zM14 19l2-2 4 4-2 2zM2 13l3-3M19 6l3-3"/>
                                </svg>
                              )}

                              {lower.includes('restaurant') && (
                                <svg class="w-3.5 h-3.5 text-emerald-600 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                  <path d="M18 2v20M2 2v6a4 4 0 0 0 4 4v10M6 2v6M10 2v6"/>
                                </svg>
                              )}

                              <span>{item}</span>
                            </span>
                          );
                        })}
                      </div>
                    )}

                  </div>
                </div>

                <!-- Price & Details CTA Button -->
                <div class="px-4 sm:px-5 py-3 border-t border-slate-100 flex items-center justify-between bg-slate-50/50">
                  {price ? (
                    <div>
                      <span class="text-[10px] text-slate-400 block font-medium">From</span>
                      <div class="flex items-baseline gap-1">
                        <span class="text-sm sm:text-base font-extrabold text-[#0d3b23]">{price}</span>
                        <span class="text-[10px] text-slate-400 font-normal">/ night</span>
                      </div>
                    </div>
                  ) : <div></div>}

                  <a href={hotelUrl} class="text-xs font-bold text-slate-800 hover:text-[#0d3b23] flex items-center gap-1 transition">
                    <span>View Details</span>
                    <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                  </a>
                </div>

              </div>
            );
          })
        )}
      </div>
    </section>


    <!-- ================= 3. "WHY STAY IN..." (ABOUT AREA) SECTION ================= -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-16 text-left">
      <div class="bg-white rounded-3xl p-6 sm:p-10 border border-slate-200/80 shadow-xs">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">

          <!-- Left: Area Cover Image -->
          <div class="lg:col-span-4 rounded-2xl overflow-hidden aspect-[4/3] bg-slate-100">
            {aboutImage && (
              <img src={aboutImage} alt={pageTitle} class="w-full h-full object-cover" />
            )}
          </div>

          <!-- Middle: Real Text Content -->
          <div class="lg:col-span-5 space-y-3">
            <span class="text-[11px] font-bold tracking-widest uppercase text-[#0d3b23]">ABOUT {pageTitle.toUpperCase()}</span>
            <h2 class="text-2xl sm:text-3xl font-serif font-black text-slate-900 leading-tight">
              Why Stay in {toTitleCase(pageTitle)}?
            </h2>
            {aboutText && (
              <p class="text-xs sm:text-sm text-slate-600 leading-relaxed font-normal">
                {aboutText}
              </p>
            )}
          </div>

          <!-- Right: 4 Highlights / USPs -->
          <div class="lg:col-span-3 space-y-4">

            <div class="flex items-start gap-3">
              <div class="w-9 h-9 rounded-full bg-emerald-50 text-[#0d3b23] flex items-center justify-center shrink-0">
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M12 2a8 8 0 0 0-8 8c0 5.25 8 12 8 12s8-6.75 8-12a8 8 0 0 0-8-8z"/>
                  <circle cx="12" cy="10" r="3"/>
                </svg>
              </div>
              <div>
                <h4 class="text-xs sm:text-sm font-bold text-slate-900">Prime Location</h4>
                <p class="text-[11px] text-slate-500">Close to business & shopping hubs</p>
              </div>
            </div>

            <div class="flex items-start gap-3">
              <div class="w-9 h-9 rounded-full bg-emerald-50 text-[#0d3b23] flex items-center justify-center shrink-0">
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                </svg>
              </div>
              <div>
                <h4 class="text-xs sm:text-sm font-bold text-slate-900">Top-Class Amenities</h4>
                <p class="text-[11px] text-slate-500">Pools, gyms, spas, fine dining</p>
              </div>
            </div>

            <div class="flex items-start gap-3">
              <div class="w-9 h-9 rounded-full bg-emerald-50 text-[#0d3b23] flex items-center justify-center shrink-0">
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                  <path d="m9 12 2 2 4-4"/>
                </svg>
              </div>
              <div>
                <h4 class="text-xs sm:text-sm font-bold text-slate-900">Safe & Secure</h4>
                <p class="text-[11px] text-slate-500">Well-planned and peaceful area</p>
              </div>
            </div>

            <div class="flex items-start gap-3">
              <div class="w-9 h-9 rounded-full bg-emerald-50 text-[#0d3b23] flex items-center justify-center shrink-0">
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M19 17h2c.6 0 1-.4 1-1v-3c0-.9-.7-1.7-1.5-1.9C18.7 10.6 16 10 16 10s-1.3-1.4-2.2-2.3c-.5-.4-1.1-.7-1.8-.7H5c-.6 0-1.1.4-1.4.9l-1.5 2.8C2.1 11 2 11.5 2 12v4c0 .6.4 1 1 1h2"/>
                  <circle cx="7" cy="17" r="2"/>
                  <path d="M9 17h6"/>
                  <circle cx="17" cy="17" r="2"/>
                </svg>
              </div>
              <div>
                <h4 class="text-xs sm:text-sm font-bold text-slate-900">Easy Transportation</h4>
                <p class="text-[11px] text-slate-500">Quick access to all parts of Dhaka</p>
              </div>
            </div>

          </div>

        </div>
      </div>
    </section>


    <!-- ================= 4. LOCATION FAQS ACCORDION ================= -->
    {faqs.length > 0 && (
      <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-16 text-left">
        <div class="border-b border-slate-200 pb-4 mb-6">
          <span class="text-[11px] font-bold tracking-widest uppercase text-[#0d3b23]">— FREQUENTLY ASKED QUESTIONS</span>
          <h2 class="text-2xl sm:text-3xl font-serif font-black text-slate-900 mt-0.5">
            Everything you need to know about stays in {toTitleCase(pageTitle)}
          </h2>
          <p class="text-xs sm:text-sm text-slate-500 mt-1">Verified answers to common traveler queries</p>
        </div>

        <div class="space-y-3 max-w-4xl">
          {faqs.map((f: any, i: number) => (
            <details class="group bg-white rounded-2xl border border-slate-200/90 p-5 transition-all shadow-xs cursor-pointer" open={i === 0}>
              <summary class="flex justify-between items-center list-none font-bold text-sm sm:text-base text-slate-900 group-hover:text-[#0d3b23] select-none">
                <span>{f.question}</span>
                <span class="w-6 h-6 rounded-full bg-slate-100 group-open:bg-emerald-50 text-slate-500 group-open:text-[#0d3b23] flex items-center justify-center shrink-0 transition-transform group-open:rotate-180">
                  <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M6 9l6 6 6-6"/></svg>
                </span>
              </summary>
              <p class="pt-3 text-xs sm:text-sm text-slate-600 leading-relaxed border-t border-slate-100 mt-3 font-normal">
                {f.answer}
              </p>
            </details>
          ))}
        </div>
      </section>
    )}


    <!-- 5. Markdown Article Body (CMS থেকে আর্টিকেল লিখলে দেখাবে) -->
    {Content && (
      <section class="max-w-4xl mx-auto px-4 pt-12 text-left">
        <article class="prose prose-slate max-w-none">
          <Content />
        </article>
      </section>
    )}

  </div>
</Layout>
