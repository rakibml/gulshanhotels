---
// src/components/landing/LocationCategoryTemplate.astro (Forbes & Michelin-Grade Luxury Travel Editorial)
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

interface Props {
  entry: any;
}

const { entry } = Astro.props;
const data = entry?.data || {};

const pageTitle = (data.title || "Hotels in Gulshan").trim();
const headingTitle = (data.heading || data.title || pageTitle).trim();
const description = (data.description || data.seo_description || `Discover handpicked luxury lodging, 5-star executive suites, and verified boutique stays in ${pageTitle}.`).trim();

const rawSlug = String(entry?.slug || entry?.id || "").trim();
const cleanSlug = rawSlug.replace(/\.(md|mdx)$/, '').split('/').pop()?.toLowerCase() || "";

const badge = data.badge || "Diplomatic Enclave Guide";
const heroImage = data.hero_image || "https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&w=1400&q=80";

// ১. সব হোটেল ডাটা লোডার
let allHotels: any[] = [];
try {
  const hotelCol = await getCollection('hotels');
  if (Array.isArray(hotelCol) && hotelCol.length > 0) {
    allHotels = hotelCol.map(h => ({
      slug: (h.slug || h.id || '').replace(/\.(md|mdx)$/, '').split('/').pop()?.toLowerCase(),
      data: h.data || {}
    }));
  }
} catch (e) {}

if (allHotels.length === 0) {
  try {
    const rawGlob = import.meta.glob(['/src/content/hotels/*.{md,mdx}', '../../content/hotels/*.{md,mdx}'], { eager: true });
    allHotels = Object.entries(rawGlob).map(([filePath, item]: [string, any]) => ({
      slug: filePath.split('/').pop()?.replace(/\.(md|mdx)$/, '')?.toLowerCase(),
      data: item?.frontmatter || item?.data || {}
    }));
  } catch (e) {}
}

// ২. স্মার্ট ফিল্টারিং
const manualSlugs = Array.isArray(data.selected_hotels) ? data.selected_hotels.map((s: string) => s.toLowerCase()) : [];
const matchKeyword = String(data.filter_keyword || cleanSlug).replace(/-/g, ' ').toLowerCase();

const matchedHotels = allHotels.filter(h => {
  const hSlug = String(h.slug || '').toLowerCase();
  const hTitle = String(h.data?.title || h.data?.name || '').toLowerCase();
  const hLoc = String(h.data?.location || h.data?.address || '').toLowerCase();
  const hCat = String(h.data?.category || '').toLowerCase();

  if (manualSlugs.length > 0) return manualSlugs.includes(hSlug);

  if (cleanSlug.includes('gulshan-1') || matchKeyword.includes('gulshan 1')) {
    return hLoc.includes('gulshan 1') || hLoc.includes('gulshan-1');
  }
  if (cleanSlug.includes('gulshan-2') || matchKeyword.includes('gulshan 2')) {
    return hLoc.includes('gulshan 2') || hLoc.includes('gulshan-2');
  }
  if (cleanSlug.includes('5-star') || matchKeyword.includes('5 star') || cleanSlug.includes('luxury')) {
    return hCat.includes('5-star') || hCat.includes('luxury');
  }
  if (cleanSlug.includes('embassy') || cleanSlug.includes('ivac') || matchKeyword.includes('embassy')) {
    return hLoc.includes('gulshan 2') || hLoc.includes('diplomatic') || hTitle.includes('westin') || hTitle.includes('amari') || hTitle.includes('midori');
  }

  return hLoc.includes(matchKeyword) || hCat.includes(matchKeyword) || hTitle.includes(matchKeyword);
});

const displayHotels = matchedHotels.length > 0 ? matchedHotels : allHotels.slice(0, 6);

// ৩. হেল্পার: ডাবল ডলার ($120$) ফিক্স করা
function cleanPriceDisplay(p: string) {
  if (!p) return "$120 / night";
  const num = p.replace(/[^0-9.]/g, '').trim();
  const symbol = p.includes('৳') ? '৳' : '$';
  return `${symbol}${num || '120'} / night`;
}

// ৪. হেল্পার: টাইটেল ক্যাপিটালাইজেশন
function toProperTitle(str: string) {
  if (!str) return "Luxury Hotel";
  return str.replace(/\b\w/g, l => l.toUpperCase());
}

// লোকাল এরিয়া টিপস ও এফএকিউ
const areaTips = Array.isArray(data.area_tips) ? data.area_tips : [];
const faqs = Array.isArray(data.faqs) ? data.faqs : [];

const siteOrigin = "https://gulshanhotels.com";
const canonicalUrl = `${siteOrigin}/${cleanSlug}`;

// SCHEMA
const masterSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "@id": `${canonicalUrl}#breadcrumb`,
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": `${siteOrigin}/` },
        { "@type": "ListItem", "position": 2, "name": pageTitle }
      ]
    },
    {
      "@type": "ItemList",
      "@id": `${canonicalUrl}#itemlist`,
      "name": pageTitle,
      "description": description,
      "numberOfItems": displayHotels.length,
      "itemListElement": displayHotels.map((h, idx) => ({
        "@type": "ListItem",
        "position": idx + 1,
        "name": toProperTitle(h.data?.title || h.data?.name || "Hotel"),
        "url": `${siteOrigin}/${h.slug}`
      }))
    },
    ...(faqs.length > 0 ? [{
      "@type": "FAQPage",
      "@id": `${canonicalUrl}#faq`,
      "mainEntity": faqs.map((f: any) => ({
        "@type": "Question",
        "name": f.question,
        "acceptedAnswer": { "@type": "Answer", "text": f.answer }
      }))
    }] : [])
  ]
};

const starsArray = [1, 2, 3, 4, 5];
---

<Layout title={`${pageTitle} — Curated Luxury Accommodations`} description={description} image={heroImage}>

  <script type="application/ld+json" set:html={JSON.stringify(masterSchema)} />

  <main class="w-full bg-white text-slate-900 pt-6 pb-20">
    <div class="max-w-[1550px] mx-auto px-4 sm:px-8 lg:px-12 space-y-12 sm:space-y-16">
      
      <!-- BREADCRUMBS -->
      <nav aria-label="Breadcrumb" class="flex items-center gap-2 text-xs font-semibold text-slate-400 text-left">
        <a href="/" class="hover:text-emerald-800 transition">Home</a>
        <span>/</span>
        <span class="text-slate-800 font-bold capitalize truncate" aria-current="page">{pageTitle}</span>
      </nav>

      <!-- ================= 1. LUXURY CINEMATIC HERO BANNER ================= -->
      <header class="relative rounded-3xl overflow-hidden bg-slate-950 text-white min-h-[360px] sm:min-h-[420px] flex items-center p-6 sm:p-12 lg:p-16 text-left border border-slate-200/90 shadow-lg">
        
        <!-- Background Layer -->
        <img 
          src={heroImage} 
          alt={pageTitle} 
          class="absolute inset-0 w-full h-full object-cover scale-105" 
          fetchpriority="high"
        />
        <!-- Rich Dark Gradient Overlay (লেখা স্পষ্ট ও সিনেমাটিক করার জন্য) -->
        <div class="absolute inset-0 bg-gradient-to-r from-slate-950/95 via-slate-950/80 to-transparent"></div>

        <div class="relative z-10 max-w-2xl space-y-4">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/20 border border-emerald-400/40 backdrop-blur-md">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
            <span class="text-emerald-300 text-[10px] sm:text-xs font-black uppercase tracking-widest">{badge}</span>
          </div>

          <h1 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-black text-white tracking-tight leading-[1.15]">
            {headingTitle}
          </h1>

          <p class="text-xs sm:text-sm md:text-base text-slate-300 font-normal leading-relaxed max-w-xl">
            {description}
          </p>

          <!-- Quick Trust Stats Pill -->
          <div class="pt-2 flex flex-wrap items-center gap-4 text-xs font-bold text-slate-200">
            <span class="bg-white/10 backdrop-blur-md border border-white/20 px-3 py-1 rounded-lg">
              {displayHotels.length} Verified Properties
            </span>
            <span class="bg-white/10 backdrop-blur-md border border-white/20 px-3 py-1 rounded-lg">
              Zero Booking Fees
            </span>
            <span class="bg-white/10 backdrop-blur-md border border-white/20 px-3 py-1 rounded-lg">
              Direct Partner Rates
            </span>
          </div>
        </div>
      </header>

      <!-- ================= 2. HOTEL CARDS GRID (PREMIUM FORBES STYLE) ================= -->
      <section class="space-y-6 text-left">
        <div class="border-b border-slate-200 pb-4 flex flex-col sm:flex-row sm:items-end justify-between gap-2">
          <div>
            <span class="text-[10px] sm:text-xs font-black uppercase tracking-widest text-emerald-800 block">Curated Selection</span>
            <h2 class="text-2xl sm:text-3xl font-serif font-black text-slate-900 tracking-tight">
              Top Accommodations in this Area
            </h2>
          </div>
          <p class="text-xs text-slate-500 font-medium">Audited for diplomatic security, hygiene, and guest satisfaction</p>
        </div>

        <!-- 3-COLUMNS DESKTOP, 2-COLUMNS MOBILE (SIDE-BY-SIDE) -->
        <div class="grid grid-cols-2 lg:grid-cols-3 gap-3.5 sm:gap-6 lg:gap-8">
          {displayHotels.map((h, idx) => {
            const hd = h.data || {};
            const hTitle = toProperTitle(hd.title || hd.name || "Luxury Stay");
            const hPriceFormatted = cleanPriceDisplay(hd.price);
            const hImage = hd.image || (Array.isArray(hd.gallery) ? hd.gallery[0] : "https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&w=600&q=80");
            const hLoc = hd.location || "Gulshan, Dhaka";
            const ratingScore = hd.rating ? Number(hd.rating).toFixed(1) : "4.8";

            return (
              <div class="group flex flex-col justify-between bg-white rounded-2xl sm:rounded-3xl border border-slate-200/90 overflow-hidden shadow-xs hover:shadow-xl hover:border-emerald-600/50 transition-all duration-300">
                <div>
                  
                  <!-- Card Image & Badges -->
                  <a href={`/${h.slug}`} class="block relative aspect-[16/10] w-full overflow-hidden bg-slate-900">
                    <img 
                      src={hImage} 
                      alt={`${hTitle} in ${pageTitle}`} 
                      loading="lazy" 
                      decoding="async" 
                      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 ease-out" 
                    />
                    
                    <div class="absolute top-2.5 left-2.5 flex items-center gap-1.5">
                      <span class="bg-[#0d3b23] text-white text-[9px] font-black uppercase tracking-wider px-2.5 py-0.5 rounded shadow-md">
                        {idx === 0 ? "Top Pick" : "Verified"}
                      </span>
                    </div>
                  </a>

                  <!-- Content Details -->
                  <div class="p-3.5 sm:p-5 space-y-2">
                    
                    <!-- Star Rating Bar -->
                    <div class="flex items-center gap-1 text-xs">
                      <div class="flex items-center gap-0.5">
                        {starsArray.map(() => (
                          <svg class="w-3 h-3 fill-amber-400 shrink-0" viewBox="0 0 24 24">
                            <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/>
                          </svg>
                        ))}
                      </div>
                      <span class="text-[10px] sm:text-xs font-black text-slate-800">{ratingScore}</span>
                    </div>

                    <!-- Hotel Title (Always Proper Case) -->
                    <h3 class="font-bold text-slate-900 text-sm sm:text-lg group-hover:text-emerald-800 transition line-clamp-1 leading-snug">
                      <a href={`/${h.slug}`}>{hTitle}</a>
                    </h3>

                    <!-- Location with Clean Pin -->
                    <p class="text-[11px] sm:text-xs text-slate-500 font-medium truncate flex items-center gap-1">
                      <svg class="w-3.5 h-3.5 fill-emerald-600 shrink-0" viewBox="0 0 24 24"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>
                      <span class="truncate">{hLoc}</span>
                    </p>

                    <!-- Clean Price Line (No $120$ bug) -->
                    <div class="pt-2 border-t border-slate-100 flex items-baseline justify-between">
                      <span class="text-[10px] sm:text-xs text-slate-400 font-bold uppercase">From</span>
                      <span class="text-xs sm:text-base font-black text-emerald-950">
                        {hPriceFormatted}
                      </span>
                    </div>

                  </div>
                </div>

                <!-- CTA Action Button -->
                <div class="p-3.5 sm:p-5 pt-0">
                  <a 
                    href={`/${h.slug}`} 
                    class="block w-full bg-[#0d3b23] hover:bg-[#061e14] text-white font-extrabold text-[11px] sm:text-xs text-center py-2.5 sm:py-3 rounded-xl transition duration-200 shadow-xs hover:shadow-md active:scale-95 uppercase tracking-wider"
                  >
                    View Hotel & Rates ➔
                  </a>
                </div>

              </div>
            );
          })}
        </div>
      </section>

      <!-- ================= 3. INSIDER CONCIERGE TRAVEL ADVICE (MICHELIN STYLE) ================= -->
      {areaTips.length > 0 && (
        <section class="bg-[#f7faf8] border border-emerald-900/10 rounded-3xl p-6 sm:p-10 text-left space-y-6">
          <div class="space-y-1 border-b border-emerald-950/10 pb-4">
            <span class="text-[10px] sm:text-xs font-black uppercase tracking-widest text-emerald-800 block">
              Editorial Concierge Insights
            </span>
            <h3 class="font-serif text-2xl sm:text-3xl font-black text-slate-900 tracking-tight">
              Essential Travel Advice for {pageTitle}
            </h3>
            <p class="text-xs sm:text-sm text-slate-600 font-medium">Local security protocols, airport connection routes, and timing tips</p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6 pt-1">
            {areaTips.map((tip: any) => (
              <div class="bg-white p-5 sm:p-6 rounded-2xl border border-slate-200/80 space-y-2 shadow-2xs hover:border-emerald-600/40 transition">
                <h4 class="font-bold text-slate-900 text-sm sm:text-base flex items-center gap-2">
                  <span class="w-2.5 h-2.5 rounded-full bg-emerald-600 shrink-0"></span>
                  <span>{tip.title}</span>
                </h4>
                <p class="text-xs sm:text-sm text-slate-600 leading-relaxed font-normal">{tip.desc}</p>
              </div>
            ))}
          </div>
        </section>
      )}

      <!-- ================= 4. STREAMLINED FAQ ACCORDION ================= -->
      {faqs.length > 0 && (
        <section class="space-y-6 text-left pt-6 border-t border-slate-200">
          <div class="space-y-1">
            <span class="text-[10px] sm:text-xs font-black uppercase tracking-widest text-emerald-800 block">Traveler Queries</span>
            <h3 class="font-serif text-2xl sm:text-3xl font-black text-slate-900 tracking-tight">Frequently Asked Questions</h3>
          </div>

          <div class="space-y-3 max-w-4xl">
            {faqs.map((f: any, i: number) => (
              <details class="group bg-white rounded-2xl border border-slate-200 p-4 sm:p-5 transition-all cursor-pointer hover:border-slate-300" open={i === 0}>
                <summary class="flex justify-between items-center list-none font-bold text-sm sm:text-base text-slate-900 group-hover:text-emerald-800 transition select-none">
                  <span class="pr-3 leading-snug">{f.question}</span>
                  <svg class="w-4 h-4 text-slate-400 group-open:rotate-180 transition-transform duration-200 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <path d="M6 9l6 6 6-6"/>
                  </svg>
                </summary>
                <p class="pt-3 text-xs sm:text-sm text-slate-600 leading-relaxed border-t border-slate-100 mt-3 font-normal">{f.answer}</p>
              </details>
            ))}
          </div>
        </section>
      )}

    </div>
  </main>
</Layout>
