---
// src/components/landing/LocationCategoryTemplate.astro (Michelin & Editorial Ranked Guide Pattern)
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

interface Props {
  entry: any;
}

const { entry } = Astro.props;
const data = entry?.data || {};

const pageTitle = (data.title || "Hotels in Gulshan").trim();
const headingTitle = (data.heading || `The Best ${pageTitle}`).trim();
const description = (data.description || data.seo_description || `An independent, verified selection of luxury and executive stays in ${pageTitle}, audited for safety, comfort, and seamless connectivity.`).trim();

const rawSlug = String(entry?.slug || entry?.id || "").trim();
const cleanSlug = rawSlug.replace(/\.(md|mdx)$/, '').split('/').pop()?.toLowerCase() || "";

// ১. হোটেল ডাটা লোডার
let allHotels: any[] = [];
try {
  const hotelCol = await getCollection('hotels');
  if (Array.isArray(hotelCol) && hotelCol.length > 0) {
    allHotels = hotelCol.map(h => ({
      slug: (h.slug || h.id || '').replace(/\.(md|mdx)$/, '').split('/').pop()?.toLowerCase(),
      data: h.data || {}
    }));
  }
} catch (e) {}

if (allHotels.length === 0) {
  try {
    const rawGlob = import.meta.glob(['/src/content/hotels/*.{md,mdx}', '../../content/hotels/*.{md,mdx}'], { eager: true });
    allHotels = Object.entries(rawGlob).map(([filePath, item]: [string, any]) => ({
      slug: filePath.split('/').pop()?.replace(/\.(md|mdx)$/, '')?.toLowerCase(),
      data: item?.frontmatter || item?.data || {}
    }));
  } catch (e) {}
}

// ২. ফিল্টারিং লজিক
const manualSlugs = Array.isArray(data.selected_hotels) ? data.selected_hotels.map((s: string) => s.toLowerCase()) : [];
const matchKeyword = String(data.filter_keyword || cleanSlug).replace(/-/g, ' ').toLowerCase();

const matchedHotels = allHotels.filter(h => {
  const hSlug = String(h.slug || '').toLowerCase();
  const hTitle = String(h.data?.title || h.data?.name || '').toLowerCase();
  const hLoc = String(h.data?.location || h.data?.address || '').toLowerCase();
  const hCat = String(h.data?.category || '').toLowerCase();

  if (manualSlugs.length > 0) return manualSlugs.includes(hSlug);

  if (cleanSlug.includes('gulshan-1') || matchKeyword.includes('gulshan 1')) {
    return hLoc.includes('gulshan 1') || hLoc.includes('gulshan-1');
  }
  if (cleanSlug.includes('gulshan-2') || matchKeyword.includes('gulshan 2')) {
    return hLoc.includes('gulshan 2') || hLoc.includes('gulshan-2');
  }
  if (cleanSlug.includes('5-star') || matchKeyword.includes('5 star') || cleanSlug.includes('luxury')) {
    return hCat.includes('5-star') || hCat.includes('luxury');
  }
  if (cleanSlug.includes('embassy') || cleanSlug.includes('ivac') || matchKeyword.includes('embassy')) {
    return hLoc.includes('gulshan 2') || hLoc.includes('diplomatic') || hTitle.includes('westin') || hTitle.includes('amari') || hTitle.includes('midori');
  }

  return hLoc.includes(matchKeyword) || hCat.includes(matchKeyword) || hTitle.includes(matchKeyword);
});

const displayHotels = matchedHotels.length > 0 ? matchedHotels : allHotels.slice(0, 5);

// ৩. প্রাইস ও টেক্সট ক্লিনার
function cleanPriceDisplay(p: string) {
  if (!p) return "$120 / night";
  const num = p.replace(/[^0-9.]/g, '').trim();
  const symbol = p.includes('৳') ? '৳' : '$';
  return `${symbol}${num || '120'} / night`;
}

function toProperTitle(str: string) {
  if (!str) return "Luxury Hotel";
  return str.replace(/\b\w/g, l => l.toUpperCase());
}

const faqs = Array.isArray(data.faqs) ? data.faqs : [];
const siteOrigin = "https://gulshanhotels.com";
const canonicalUrl = `${siteOrigin}/${cleanSlug}`;

// SCHEMA
const masterSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "@id": `${canonicalUrl}#breadcrumb`,
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": `${siteOrigin}/` },
        { "@type": "ListItem", "position": 2, "name": pageTitle }
      ]
    },
    {
      "@type": "ItemList",
      "@id": `${canonicalUrl}#itemlist`,
      "name": pageTitle,
      "description": description,
      "numberOfItems": displayHotels.length,
      "itemListElement": displayHotels.map((h, idx) => ({
        "@type": "ListItem",
        "position": idx + 1,
        "name": toProperTitle(h.data?.title || h.data?.name || "Hotel"),
        "url": `${siteOrigin}/${h.slug}`
      }))
    },
    ...(faqs.length > 0 ? [{
      "@type": "FAQPage",
      "@id": `${canonicalUrl}#faq`,
      "mainEntity": faqs.map((f: any) => ({
        "@type": "Question",
        "name": f.question,
        "acceptedAnswer": { "@type": "Answer", "text": f.answer }
      }))
    }] : [])
  ]
};

const starsArray = [1, 2, 3, 4, 5];
---

<Layout title={`${pageTitle} — Verified Guide & Stays`} description={description}>

  <script type="application/ld+json" set:html={JSON.stringify(masterSchema)} />

  <main class="w-full bg-white text-slate-900 pt-6 pb-24">
    <div class="max-w-[1280px] mx-auto px-4 sm:px-8 space-y-12 sm:space-y-16">
      
      <!-- ================= 1. CLEAN EDITORIAL HEADER (NO CHEAP DARK BOXES) ================= -->
      <header class="text-left space-y-4 pt-2 border-b border-slate-200 pb-10">
        
        <!-- Breadcrumb & Year Tag -->
        <div class="flex items-center gap-2 text-xs font-semibold text-slate-400">
          <a href="/" class="hover:text-emerald-800 transition">Home</a>
          <span>/</span>
          <span class="text-slate-900 font-bold capitalize">{pageTitle}</span>
        </div>

        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-50 text-emerald-800 text-[11px] font-black uppercase tracking-wider">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-600"></span>
          <span>Curated District Guide • 2026 Edition</span>
        </div>

        <!-- Big Prestigious Headline -->
        <h1 class="font-serif text-3xl sm:text-5xl lg:text-6xl font-black text-slate-900 tracking-tight leading-[1.1]">
          {headingTitle}
        </h1>

        <p class="text-base sm:text-lg text-slate-600 font-normal leading-relaxed max-w-3xl">
          {description}
        </p>

        <!-- Area Metrics Bar (Snapshot) -->
        <div class="pt-4 flex flex-wrap items-center gap-6 text-xs text-slate-600 border-t border-slate-100">
          <div class="flex items-center gap-2">
            <span class="font-black text-slate-900 text-base">{displayHotels.length}</span>
            <span class="font-medium">Handpicked Stays</span>
          </div>
          <span class="text-slate-300">•</span>
          <div class="flex items-center gap-2">
            <span class="font-black text-emerald-800 text-base">100%</span>
            <span class="font-medium">Direct Rate Verification</span>
          </div>
          <span class="text-slate-300">•</span>
          <div class="flex items-center gap-2">
            <span class="font-black text-slate-900 text-base">Diplomatic</span>
            <span class="font-medium">Armed Security Zone</span>
          </div>
        </div>

      </header>

      <!-- ================= 2. THE CURATED RANKED LIST (01, 02, 03 PATTERN) ================= -->
      <section class="space-y-8 text-left">
        <div class="flex items-center justify-between">
          <h2 class="font-serif text-2xl sm:text-3xl font-black text-slate-900 tracking-tight">
            The Curated Selection
          </h2>
          <span class="text-xs font-bold text-slate-400">Ranked by inspection score</span>
        </div>

        <div class="space-y-6 sm:space-y-8">
          {displayHotels.map((h, idx) => {
            const hd = h.data || {};
            const hTitle = toProperTitle(hd.title || hd.name || "Luxury Hotel");
            const hPrice = cleanPriceDisplay(hd.price);
            const hImage = hd.image || (Array.isArray(hd.gallery) ? hd.gallery[0] : "https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&w=600&q=80");
            const hLoc = hd.location || "Gulshan, Dhaka";
            const ratingScore = hd.rating ? Number(hd.rating).toFixed(1) : "4.9";
            const rankNumber = String(idx + 1).padStart(2, '0');
            
            // হোটেলের আসল অ্যামেনিটিস থেকে প্রথম ৩টি ট্যাগ
            const rawAmens = Array.isArray(hd.amenities) ? hd.amenities : [];
            const quickTags = rawAmens.slice(0, 3).map((a: any) => typeof a === 'string' ? a : (a?.name || 'Amenity'));

            return (
              <article class="group bg-white rounded-3xl border border-slate-200 hover:border-emerald-700/40 p-4 sm:p-6 transition-all duration-300 hover:shadow-xl flex flex-col md:flex-row gap-6 items-stretch">
                
                <!-- Left: Curated Photo with Rank Badge -->
                <div class="relative w-full md:w-[320px] lg:w-[380px] aspect-[16/10] md:aspect-auto rounded-2xl overflow-hidden bg-slate-900 shrink-0">
                  <img 
                    src={hImage} 
                    alt={hTitle} 
                    loading="lazy" 
                    decoding="async" 
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 ease-out" 
                  />
                  <!-- Rank Watermark (01, 02, 03) -->
                  <div class="absolute top-3 left-3 bg-slate-950/85 backdrop-blur-md text-white text-xs font-black px-3 py-1 rounded-full border border-white/20">
                    #{rankNumber} Pick
                  </div>
                </div>

                <!-- Right: Editorial Content & Specs -->
                <div class="flex-1 flex flex-col justify-between py-1 text-left space-y-4">
                  
                  <div class="space-y-2">
                    <!-- Star Rating & Location -->
                    <div class="flex items-center gap-2 flex-wrap">
                      <div class="flex items-center gap-0.5">
                        {starsArray.map(() => (
                          <svg class="w-3.5 h-3.5 fill-amber-400 shrink-0" viewBox="0 0 24 24">
                            <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/>
                          </svg>
                        ))}
                      </div>
                      <span class="text-xs font-black text-slate-800">{ratingScore} / 5.0</span>
                      <span class="text-slate-300">•</span>
                      <span class="text-xs text-slate-500 font-medium">{hLoc}</span>
                    </div>

                    <!-- Hotel Big Title -->
                    <h3 class="font-serif text-2xl sm:text-3xl font-black text-slate-900 leading-tight group-hover:text-emerald-800 transition-colors">
                      <a href={`/${h.slug}`}>
                        {hTitle}
                      </a>
                    </h3>

                    <!-- Short Description -->
                    <p class="text-xs sm:text-sm text-slate-600 font-normal leading-relaxed line-clamp-2">
                      {hd.description || "Executive 5-star lodging featuring fine dining restaurants, high-speed Wi-Fi, and diplomatic protection."}
                    </p>

                    <!-- Feature Tags -->
                    {quickTags.length > 0 && (
                      <div class="flex flex-wrap gap-1.5 pt-1">
                        {quickTags.map((tag: string) => (
                          <span class="text-[10px] font-bold text-slate-700 bg-slate-100 px-2.5 py-0.5 rounded-md">
                            {tag}
                          </span>
                        ))}
                      </div>
                    )}
                  </div>

                  <!-- Bottom: Pricing & CTA Button -->
                  <div class="pt-4 border-t border-slate-100 flex items-center justify-between gap-4">
                    <div>
                      <span class="text-[10px] text-slate-400 font-bold uppercase block">Starting rate</span>
                      <span class="text-lg sm:text-xl font-black text-emerald-950">{hPrice}</span>
                    </div>

                    <a 
                      href={`/${h.slug}`} 
                      class="inline-flex items-center gap-2 bg-[#0d3b23] hover:bg-[#061e14] text-white font-black text-xs px-5 py-3 rounded-xl transition duration-200 uppercase tracking-wider shadow-sm hover:shadow-md shrink-0"
                    >
                      <span>View Details & Prices</span>
                      <span>➔</span>
                    </a>
                  </div>

                </div>

              </article>
            );
          })}
        </div>
      </section>

      <!-- ================= 3. NEIGHBORHOOD CHEAT-SHEET (CLEAN & PRACTICAL) ================= -->
      <section class="pt-6 border-t border-slate-200 text-left space-y-6">
        <div class="space-y-1">
          <span class="text-[10px] sm:text-xs font-black uppercase tracking-widest text-emerald-800 block">District Insights</span>
          <h2 class="font-serif text-2xl sm:text-3xl font-black text-slate-900 tracking-tight">
            {pageTitle} Fast Facts & Advice
          </h2>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
          <div class="p-5 rounded-2xl bg-slate-50 border border-slate-200/80 space-y-1.5">
            <span class="text-xs font-black text-slate-900 uppercase tracking-wider block">🚗 Airport Transit</span>
            <p class="text-xs text-slate-600 leading-relaxed font-normal">18-20 mins direct connection via Dhaka Elevated Expressway.</p>
          </div>
          <div class="p-5 rounded-2xl bg-slate-50 border border-slate-200/80 space-y-1.5">
            <span class="text-xs font-black text-slate-900 uppercase tracking-wider block">🛡️ Security Level</span>
            <p class="text-xs text-slate-600 leading-relaxed font-normal">Highest protected diplomatic zone with 24/7 armed patrol checkpoints.</p>
          </div>
          <div class="p-5 rounded-2xl bg-slate-50 border border-slate-200/80 space-y-1.5">
            <span class="text-xs font-black text-slate-900 uppercase tracking-wider block">🍽️ Dining & Cafes</span>
            <p class="text-xs text-slate-600 leading-relaxed font-normal">Walking distance to upscale Italian, Japanese, and international dining.</p>
          </div>
          <div class="p-5 rounded-2xl bg-slate-50 border border-slate-200/80 space-y-1.5">
            <span class="text-xs font-black text-slate-900 uppercase tracking-wider block">🏛️ Embassies</span>
            <p class="text-xs text-slate-600 leading-relaxed font-normal">Fast access to US, UK, German and European embassy consular offices.</p>
          </div>
        </div>
      </section>

      <!-- ================= 4. STREAMLINED MINIMALIST FAQ ================= -->
      {faqs.length > 0 && (
        <section class="pt-6 border-t border-slate-200 text-left space-y-6">
          <div class="space-y-1">
            <span class="text-[10px] sm:text-xs font-black uppercase tracking-widest text-emerald-800 block">Frequently Asked</span>
            <h2 class="font-serif text-2xl sm:text-3xl font-black text-slate-900 tracking-tight">Questions About {pageTitle}</h2>
          </div>

          <div class="divide-y divide-slate-200 max-w-3xl">
            {faqs.map((f: any, i: number) => (
              <details class="group py-4 transition-all cursor-pointer" open={i === 0}>
                <summary class="flex justify-between items-center list-none font-bold text-sm sm:text-base text-slate-900 group-hover:text-emerald-800 select-none">
                  <span class="pr-3 leading-snug">{f.question}</span>
                  <svg class="w-4 h-4 text-slate-400 group-open:rotate-180 transition-transform duration-200 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <path d="M6 9l6 6 6-6"/>
                  </svg>
                </summary>
                <p class="pt-3 text-xs sm:text-sm text-slate-600 leading-relaxed font-normal">{f.answer}</p>
              </details>
            ))}
          </div>
        </section>
      )}

    </div>
  </main>
</Layout>
