---
// src/components/landing/LocationCategoryTemplate.astro
// Luxury Magazine-Grade Design, Auto-Generated Google Table Snippet & Live Agoda Price
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

interface Props {
  entry: any;
  Content?: any;
}

const { entry, Content } = Astro.props;
const data = entry?.data || {};

const siteOrigin = Astro.site ? Astro.site.origin : "https://gulshanhotels.com";

const rawSlug = entry?.slug || entry?.id || "";
const cleanSlug = rawSlug
  .replace(/\.(md|mdx)$/, '')
  .split('/')
  .pop()
  ?.toLowerCase()
  .trim()
  .replace(/\s+/g, '-') || "";

const canonicalUrl = `${siteOrigin}/${cleanSlug}/`;

const pageTitle = (data.title || "").trim();
const locationSubtitle = (data.location_subtitle || "").trim();
const description = (data.description || data.seo_description || "").trim();
const heroImage = data.hero_image || data.image || "";
const metaTitle = (data.seo_title || data.meta_title || `${toTitleCase(pageTitle)} — Stays & Travel Guide`).trim();

let allHotels: any[] = [];
try {
  const hotelCol = await (getCollection as any)('hotels');
  if (Array.isArray(hotelCol)) {
    allHotels = hotelCol.map((h: any) => ({
      slug: (h.slug || h.id || '').replace(/\.(md|mdx)$/, '').split('/').pop()?.toLowerCase().trim(),
      data: { ...(h.data || {}), ...((h as any).frontmatter || {}) }
    }));
  }
} catch (err) {
  try {
    const rawGlob = import.meta.glob(['/src/content/hotels/*.{md,mdx}', '../../content/hotels/*.{md,mdx}'], { eager: true });
    allHotels = Object.entries(rawGlob).map(([filePath, item]: [string, any]) => ({
      slug: filePath.split('/').pop()?.replace(/\.(md|mdx)$/, '')?.toLowerCase().trim(),
      data: item?.frontmatter || item?.data || {}
    }));
  } catch (e) {}
}

let rawReviewsList: any[] = [];
try {
  const globFiles = import.meta.glob(['/src/content/reviews/*.{md,mdx}', '../../content/reviews/*.{md,mdx}'], { eager: true });
  rawReviewsList = Object.values(globFiles).map((item: any) => item?.frontmatter || item?.data || item || {});
} catch (e) {
  rawReviewsList = [];
}

const reviewsByKey = new Map<string, any[]>();
for (const item of rawReviewsList) {
  if (!item) continue;
  const isApproved = item.approved === true || String(item.approved).trim().toLowerCase() === 'true';
  if (!isApproved) continue;

  const rSlug = String(item.slug || item.hotelSlug || item.hotel_slug || '').replace(/\.(md|mdx)$/, '').split('/').pop()?.trim().toLowerCase() || "";
  const rId = String(item.id || '').replace(/\.(md|mdx)$/, '').split('/').pop()?.trim().toLowerCase() || "";
  const rHotel = String(item.hotel || item.hotelTitle || item.hotel_name || '').trim().toLowerCase();

  const keys = new Set([rSlug, rId, rHotel].filter(Boolean));
  for (const k of keys) {
    if (!reviewsByKey.has(k)) reviewsByKey.set(k, []);
    reviewsByKey.get(k)!.push(item);
  }
}

const normalizeText = (val: any) =>
  String(val || '')
    .toLowerCase()
    .replace(/[-_]/g, ' ')
    .replace(/\s+/g, ' ')
    .trim();

const manualSlugs = Array.isArray(data.selected_hotels)
  ? data.selected_hotels
      .map((s: any) => String(s || '').replace(/\.(md|mdx)$/, '').split('/').pop()?.toLowerCase().trim())
      .filter((s: string | undefined): s is string => Boolean(s && s.length > 0))
  : [];

const rawKeyword = String(data.filter_keyword || cleanSlug)
  .replace(/^(luxury|best|top|budget|cheap)-/i, '')
  .replace(/^hotels?-(in|near)-/i, '')
  .replace(/^hotels?-/i, '')
  .replace(/-hotels?$/i, '');

const normalizedKeyword = normalizeText(rawKeyword);

const displayHotels = allHotels.filter(h => {
  const hSlug = String(h.slug || '').toLowerCase();
  if (manualSlugs.length > 0) return manualSlugs.includes(hSlug);
  if (!normalizedKeyword) return true;

  const hLoc = normalizeText(h.data?.location || h.data?.address);
  const hCat = normalizeText(h.data?.category);
  const hTitle = normalizeText(h.data?.title || h.data?.name);

  return hLoc.includes(normalizedKeyword) || hCat.includes(normalizedKeyword) || hTitle.includes(normalizedKeyword);
});

function toTitleCase(str: string) {
  if (!str) return "";
  return str.replace(/\b\w/g, char => char.toUpperCase());
}

function extractStarsNumber(category: string, stars?: any) {
  if (stars && !isNaN(Number(stars))) return String(stars);
  const match = String(category || '').match(/(\d+)\s*[-_ ]*star/i);
  return match ? match[1] : null;
}

function formatShortLocation(loc: string) {
  if (!loc) return "";
  const parts = loc.split(',').map(s => s.trim());
  return parts.length >= 2 ? `${parts[0]}, ${parts[1]}` : loc;
}

function formatPriceDisplay(rawPrice: any) {
  if (!rawPrice) return null;
  const pStr = String(rawPrice).trim();
  return pStr.includes('/') ? pStr.split('/')[0].trim() : pStr;
}

function plainText(str: any) {
  return String(str || '')
    .replace(/<[^>]*>/g, '')
    .replace(/[*_`#>]/g, '')
    .replace(/\s+/g, ' ')
    .trim();
}

const cleanTitleName = pageTitle
  .replace(/^hotels?\s+in\s+/i, '')
  .replace(/^hotels?\s+near\s+/i, '')
  .trim();

const hotelsTag = (data.hotels_tag || "").trim();
const hotelsTitle = (data.hotels_title || (cleanTitleName ? `Accommodations in ${toTitleCase(cleanTitleName)}` : `Available Accommodations`)).trim();

// CMS থেকে টেবিল কন্ট্রোল (ডিফল্ট: true)
const showComparisonTable = data.enable_comparison_table !== false && displayHotels.length > 0;
const comparisonTableTitle = data.comparison_title || `Quick Comparison of Hotels in ${toTitleCase(cleanTitleName || pageTitle)}`;

const rawFaqs = Array.isArray(data.faqs) ? data.faqs : [];
const faqs = rawFaqs.filter((f: any) => f && plainText(f.question).length > 0 && plainText(f.answer).length > 0);

const schemaGraph: any[] = [
  {
    "@type": "BreadcrumbList",
    "@id": `${canonicalUrl}#breadcrumb`,
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": `${siteOrigin}/` },
      { "@type": "ListItem", "position": 2, "name": toTitleCase(pageTitle) || "Destinations", "item": canonicalUrl }
    ]
  }
];

if (displayHotels.length > 0) {
  schemaGraph.push({
    "@type": "ItemList",
    "@id": `${canonicalUrl}#itemlist`,
    "name": toTitleCase(pageTitle),
    ...(description ? { "description": description } : {}),
    "numberOfItems": displayHotels.length,
    "itemListElement": displayHotels.map((h, idx) => ({
      "@type": "ListItem",
      "position": idx + 1,
      "name": toTitleCase(h.data?.title || h.data?.name || `Hotel Stay`),
      "url": `${siteOrigin}/${h.slug}/`
    }))
  });
}

if (faqs.length > 0) {
  schemaGraph.push({
    "@type": "FAQPage",
    "@id": `${canonicalUrl}#faq`,
    "mainEntity": faqs.map((f: any) => ({
      "@type": "Question",
      "name": plainText(f.question),
      "acceptedAnswer": {
        "@type": "Answer",
        "text": plainText(f.answer)
      }
    }))
  });
}

const masterSchemaJson = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": schemaGraph
}).replace(/</g, "\\u003c");
---

<Layout 
  title={metaTitle} 
  description={description} 
  image={heroImage}
  canonical={canonicalUrl}
>
  <script type="application/ld+json" set:html={masterSchemaJson} />

  <div class="w-full bg-[#fbfbf9] text-slate-800 font-sans pb-24">

    <!-- 1. CINEMATIC HERO BANNER (With H1 Title Included) -->
    <header class="relative w-full aspect-[21/9] min-h-[320px] sm:min-h-[420px] max-h-[500px] bg-slate-950 overflow-hidden shadow-sm">
      {heroImage ? (
        <img
          src={heroImage}
          alt={pageTitle}
          class="w-full h-full object-cover scale-102"
          fetchpriority="high"
        />
      ) : (
        <div class="w-full h-full bg-slate-900" />
      )}
      
      <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/45 to-transparent"></div>

      <div class="absolute bottom-6 sm:bottom-12 left-4 sm:left-8 lg:left-12 z-10 text-white space-y-2.5 text-left max-w-4xl pr-4">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/20 backdrop-blur-md border border-emerald-400/30 text-[11px] font-black uppercase tracking-widest text-emerald-300">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          <span>Verified Area Guide</span>
        </div>

        <!-- H1 টাইটেল ব্যানারে যুক্ত করা হলো -->
        <h1 class="font-serif text-3xl sm:text-5xl lg:text-6xl font-black text-white tracking-tight leading-tight drop-shadow-md">
          {toTitleCase(pageTitle)}
        </h1>
        
        {locationSubtitle && (
          <p class="text-xs sm:text-sm font-bold tracking-wider text-slate-200 flex items-center gap-1.5 drop-shadow">
            <span>{locationSubtitle}</span>
            <span class="text-emerald-400 font-black text-sm">›</span>
            <span class="text-slate-300">Dhaka, Bangladesh</span>
          </p>
        )}
      </div>
    </header>

    <!-- 2. BREADCRUMB & EDITORIAL INTRO SECTION -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-6 sm:pt-8 text-left">
      <nav aria-label="Breadcrumb" class="flex items-center gap-2 text-xs text-slate-500 font-medium mb-6">
        <a href="/" class="hover:text-emerald-800 transition">Home</a>
        <span class="text-slate-300">/</span>
        <a href="/#hotels" class="hover:text-emerald-800 transition">Hotels</a>
        <span class="text-slate-300">/</span>
        <span class="text-slate-900 font-bold truncate">{toTitleCase(pageTitle)}</span>
      </nav>

      <div class="max-w-4xl space-y-5">
        {description && (
          <p class="text-base sm:text-lg text-slate-700 font-normal leading-relaxed border-l-4 border-emerald-800 pl-4 py-1">
            {description}
          </p>
        )}

        <!-- বডি কন্টেন্ট রেন্ডার (Content না থাকলেও body fallback) -->
        {Content ? (
          <div class="prose prose-slate prose-lg max-w-none prose-headings:font-serif prose-headings:font-bold prose-headings:text-slate-900 prose-p:leading-relaxed prose-a:text-emerald-800 pt-4 border-b border-slate-200/80 pb-8">
            <Content />
          </div>
        ) : (entry?.body && (
          <div class="prose prose-slate prose-lg max-w-none prose-headings:font-serif prose-headings:font-bold prose-headings:text-slate-900 prose-p:leading-relaxed prose-a:text-emerald-800 pt-4 border-b border-slate-200/80 pb-8 whitespace-pre-line">
            {entry.body}
          </div>
        ))}

        <!-- ৩. GOOGLE TABLE SNIPPET COMPLIANT AUTO COMPARISON TABLE -->
        {showComparisonTable && (
          <div class="pt-6 pb-4 space-y-3">
            <h3 class="font-serif text-xl sm:text-2xl font-black text-slate-900 tracking-tight">
              {comparisonTableTitle}
            </h3>

            <div class="overflow-x-auto border border-slate-200 rounded-2xl bg-white shadow-2xs">
              <table class="w-full text-left text-xs sm:text-sm text-slate-700 border-collapse">
                <thead>
                  <tr class="border-b border-slate-200 bg-slate-50/80 text-[11px] font-black uppercase tracking-wider text-slate-600">
                    <th scope="col" class="py-3.5 px-4 sm:px-5">Hotel Name</th>
                    <th scope="col" class="py-3.5 px-4 sm:px-5">Star & Class</th>
                    <th scope="col" class="py-3.5 px-4 sm:px-5">Starting Rate</th>
                    <th scope="col" class="py-3.5 px-4 sm:px-5">Key Highlights</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                  {displayHotels.map((h) => {
                    const hd = h.data || {};
                    const hTitle = (hd.title || hd.name || "").trim();
                    const hSlug = String(h.slug || "").trim();
                    const hUrl = `/${hSlug}/`;
                    const starCount = extractStarsNumber(hd.category, hd.stars);
                    const price = formatPriceDisplay(hd.price);
                    
                    const rawAmenities = Array.isArray(hd.amenities) ? hd.amenities : [];
                    const topAmenities = rawAmenities.slice(0, 2).map((a: any) => typeof a === 'string' ? a.trim() : (a?.name || '').trim()).filter(Boolean);
                    const highlightText = hd.ranking || hd.badge || (topAmenities.length > 0 ? topAmenities.join(' • ') : "Luxury stay in Gulshan");

                    return (
                      <tr class="hover:bg-slate-50/70 transition-colors">
                        <td class="py-3.5 px-4 sm:px-5 font-bold text-slate-900">
                          <a href={hUrl} class="hover:text-emerald-800 hover:underline">
                            {toTitleCase(hTitle)}
                          </a>
                        </td>
                        <td class="py-3.5 px-4 sm:px-5 font-semibold text-slate-700">
                          {starCount ? `${starCount}-Star Luxury` : (hd.category || "Hotel")}
                        </td>
                        <td class="py-3.5 px-4 sm:px-5 font-black text-[#0d3b23] whitespace-nowrap">
                          {price ? `${price} / night` : "Check rates"}
                        </td>
                        <td class="py-3.5 px-4 sm:px-5 text-slate-600 font-medium text-xs leading-snug">
                          {highlightText}
                        </td>
                      </tr>
                    );
                  })}
                </tbody>
              </table>
            </div>
            <p class="text-[11px] text-slate-400 font-normal italic">
              * Rates are indicative starting prices and may vary based on dates, room selection, and partner discounts.
            </p>
          </div>
        )}

      </div>
    </section>

    <!-- ৪. HOTEL LISTINGS SECTION -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-8 pb-16 text-left">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 border-b border-slate-200 pb-5 mb-8">
        <div>
          {hotelsTag && (
            <span class="text-[11px] font-black tracking-widest uppercase text-emerald-800 block mb-0.5">
              — {hotelsTag}
            </span>
          )}
          <h2 class="text-2xl sm:text-3xl font-serif font-black text-slate-900">
            {hotelsTitle}
          </h2>
          <p class="text-xs sm:text-sm text-slate-500 font-medium mt-1">
            Showing <strong class="text-slate-800">{displayHotels.length}</strong> accommodations in this area
          </p>
        </div>

        <div class="w-full sm:w-80 bg-white rounded-2xl shadow-xs px-3.5 py-2.5 flex items-center border border-slate-200 focus-within:border-emerald-600 transition">
          <svg aria-hidden="true" class="w-4 h-4 text-emerald-700 mr-2.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
            <circle cx="11" cy="11" r="8"/>
            <path d="m21 21-4.35-4.35"/>
          </svg>
          <input
            type="text"
            id="onPageHotelFilterInput"
            aria-label="Filter hotels on this page"
            placeholder="Filter by hotel name..."
            class="w-full text-xs sm:text-sm text-slate-800 placeholder-slate-400 bg-transparent focus:outline-none font-medium"
          />
        </div>
      </div>

      <!-- Hotel Grid Cards -->
      <div id="landingHotelsGrid" class="grid grid-cols-1 lg:grid-cols-2 gap-5 sm:gap-6">
        {displayHotels.length === 0 ? (
          <div class="col-span-full text-center py-16 text-slate-500 text-sm bg-white rounded-3xl border border-dashed border-slate-300 space-y-2">
            <p class="font-bold text-slate-700">No accommodations listed yet for this category.</p>
            <p class="text-xs">We are actively verifying and adding more hotels in this zone.</p>
          </div>
        ) : (
          displayHotels.map((h) => {
            const hd = h.data || {};
            const hotelTitle = (hd.title || hd.name || "").trim();
            const hotelSlug = String(h.slug || "").trim();
            const hotelUrl = `/${hotelSlug}/`;
            const agodaId = hd.agoda_id || hd.agodaId || "";

            const starCount = extractStarsNumber(hd.category, hd.stars);
            const shortLoc = formatShortLocation(hd.location || hd.address || "");
            const price = formatPriceDisplay(hd.price);
            const cardImage = hd.image || (Array.isArray(hd.gallery) ? hd.gallery[0] : "");
            
            const rawAmenities = Array.isArray(hd.amenities) ? hd.amenities : [];
            const topAmenities = rawAmenities.slice(0, 3).map((a: any) => {
              if (typeof a === 'string') return a.trim();
              if (typeof a === 'object') return (a?.name || a?.title || '').trim();
              return '';
            }).filter(Boolean);

            const searchTitle = hotelTitle.toLowerCase();
            const searchSlug = hotelSlug.toLowerCase();
            const approvedSet = new Set<any>([
              ...(searchSlug ? (reviewsByKey.get(searchSlug) || []) : []),
              ...(searchTitle ? (reviewsByKey.get(searchTitle) || []) : [])
            ]);
            const combinedRawReviews = [...Array.from(approvedSet), ...(Array.isArray(hd.reviews) ? hd.reviews : [])];

            const validReviews = combinedRawReviews.map((rev: any) => ({
              rating: Number(rev.rating) || 0,
              comment: String(rev.comment || rev.review || rev.body || '').trim()
            })).filter(r => r.comment.length > 1 && r.rating > 0);

            const reviewCount = validReviews.length;
            const reviewScore = reviewCount > 0
              ? (validReviews.reduce((sum: number, r: any) => sum + r.rating, 0) / reviewCount).toFixed(1)
              : null;

            const realBadge = hd.badge || hd.tag || (hd.is_verified === true ? "Verified Stay" : "");

            return (
              <div 
                class="landing-hotel-card bg-white rounded-3xl border border-slate-200/90 overflow-hidden shadow-2xs hover:shadow-lg hover:border-emerald-600/40 transition-all duration-300 flex flex-col sm:flex-row group text-left min-h-[210px]"
                data-name={hotelTitle.toLowerCase()}
                data-location={shortLoc.toLowerCase()}
                data-slug={hotelSlug}
                data-hotel-name={hotelTitle}
                data-agoda-id={agodaId}
              >
                <!-- Thumbnail -->
                <div class="w-full sm:w-52 h-48 sm:h-auto relative shrink-0 overflow-hidden bg-slate-900">
                  {cardImage && (
                    <a href={hotelUrl} class="block w-full h-full" aria-label={`View ${hotelTitle}`}>
                      <img
                        src={cardImage}
                        alt={hotelTitle}
                        loading="lazy"
                        decoding="async"
                        width="300"
                        height="210"
                        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                      />
                    </a>
                  )}
                  
                  {starCount && (
                    <div class="absolute top-3 left-3 bg-[#0d3b23] text-white text-[10px] font-black px-2.5 py-0.5 rounded-full flex items-center gap-1 shadow-sm">
                      <span>{starCount} Star</span>
                    </div>
                  )}
                </div>

                <!-- Info Column -->
                <div class="flex-1 p-5 flex flex-col justify-between space-y-3">
                  <div class="space-y-1.5">
                    <div class="flex items-center gap-2">
                      {realBadge && (
                        <span class="px-2.5 py-0.5 rounded-full bg-emerald-50 text-emerald-800 border border-emerald-200 text-[10px] font-black uppercase tracking-wider">
                          {realBadge}
                        </span>
                      )}
                      <span class="agoda-discount-badge hidden px-2 py-0.5 rounded-full bg-rose-50 text-rose-700 border border-rose-200 text-[10px] font-extrabold animate-pulse"></span>
                    </div>

                    <h3 class="font-serif font-black text-lg sm:text-xl text-slate-900 group-hover:text-emerald-800 transition line-clamp-1">
                      <a href={hotelUrl}>{toTitleCase(hotelTitle)}</a>
                    </h3>

                    {shortLoc && (
                      <p class="text-xs text-slate-500 flex items-center gap-1 truncate font-medium">
                        <svg aria-hidden="true" class="w-3.5 h-3.5 text-emerald-700 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                          <path d="M12 2a8 8 0 0 0-8 8c0 5.25 8 12 8 12s8-6.75 8-12a8 8 0 0 0-8-8z"/>
                          <circle cx="12" cy="10" r="3"/>
                        </svg>
                        <span class="truncate">{shortLoc}</span>
                      </p>
                    )}

                    {reviewCount > 0 && reviewScore && (
                      <div class="flex items-center gap-1.5 text-xs pt-0.5">
                        <span class="bg-[#0d3b23] text-white text-[10px] font-black px-2 py-0.5 rounded">
                          {reviewScore}
                        </span>
                        <span class="text-slate-500 text-[11px] font-medium">
                          ({reviewCount} {reviewCount === 1 ? 'review' : 'reviews'})
                        </span>
                      </div>
                    )}

                    {topAmenities.length > 0 && (
                      <div class="flex flex-wrap items-center gap-2 text-[11px] text-slate-600 font-semibold pt-1">
                        {topAmenities.map((item: string) => (
                          <span class="bg-slate-50 border border-slate-200/80 px-2 py-0.5 rounded-md flex items-center gap-1">
                            <svg aria-hidden="true" class="w-3 h-3 text-emerald-700 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>
                            <span>{item}</span>
                          </span>
                        ))}
                      </div>
                    )}
                  </div>

                  <!-- Price & View Button -->
                  <div class="pt-3 border-t border-slate-100 flex items-center justify-between">
                    <div>
                      <span class="hotel-rate-status text-[9px] text-slate-400 font-bold uppercase leading-none block">
                        Direct Rate
                      </span>
                      
                      <div class="flex items-baseline gap-1 mt-0.5">
                        <span class="agoda-original-price hidden text-xs text-slate-400 line-through"></span>
                        <span class="hotel-live-price text-lg font-black text-[#0d3b23]">
                          {price ? price : "Check Rates"}
                        </span>
                        <span class="hotel-per-night text-[10px] text-slate-500 font-medium">
                          {price ? "/ night" : ""}
                        </span>
                      </div>
                    </div>

                    <a 
                      href={hotelUrl} 
                      class="inline-flex items-center justify-center gap-1.5 bg-[#0d3b23] hover:bg-[#061e14] text-white px-4 py-2.5 rounded-xl text-xs font-bold transition shadow-xs active:scale-95"
                    >
                      <span>View Details</span>
                      <span aria-hidden="true">➔</span>
                    </a>
                  </div>

                </div>
              </div>
            );
          })
        )}
      </div>

      <div id="filterEmptyState" class="hidden text-center py-12 text-slate-500 text-xs bg-white rounded-3xl border border-dashed border-slate-300">
        No hotels found matching your search.
      </div>
    </section>

    <!-- 5. FAQ SECTION -->
    {faqs.length > 0 && (
      <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-12 border-t border-slate-200 text-left">
        <div class="space-y-1 mb-8">
          <span class="text-xs font-black uppercase tracking-wider text-emerald-800">Traveler Questions</span>
          <h2 class="font-serif text-2xl sm:text-3xl font-black text-slate-900 tracking-tight">
            Frequently Asked Questions
          </h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-0 items-start">
          {faqs.map((f: any, i: number) => (
            <details class="group border-b border-slate-200 py-4 transition-all text-left" open={i === 0}>
              <summary class="flex justify-between items-center list-none font-bold text-sm sm:text-base text-slate-900 group-hover:text-emerald-800 cursor-pointer select-none gap-4">
                <span class="leading-snug pr-2 font-serif font-bold">{f.question}</span>
                <span class="w-6 h-6 rounded-full border border-slate-200 bg-slate-50 group-hover:border-emerald-600 text-slate-500 flex items-center justify-center shrink-0 transition-colors">
                  <span class="block group-open:hidden text-sm leading-none font-bold">+</span>
                  <span class="hidden group-open:block text-sm leading-none font-bold">−</span>
                </span>
              </summary>
              <p class="pt-3 text-xs sm:text-sm text-slate-600 leading-relaxed font-normal">
                {f.answer}
              </p>
            </details>
          ))}
        </div>
      </section>
    )}

  </div>
</Layout>

<script is:inline>
  const initOnPageFilter = () => {
    const input = document.getElementById('onPageHotelFilterInput');
    const cards = document.querySelectorAll('.landing-hotel-card');
    const emptyState = document.getElementById('filterEmptyState');

    if (input && !input.dataset.listenerAttached) {
      input.dataset.listenerAttached = 'true';
      input.addEventListener('input', () => {
        const query = input.value.trim().toLowerCase();
        let visibleCount = 0;

        cards.forEach(card => {
          const name = (card.getAttribute('data-name') || '').toLowerCase();
          const loc = (card.getAttribute('data-location') || '').toLowerCase();

          if (!query || name.includes(query) || loc.includes(query)) {
            card.classList.remove('hidden');
            visibleCount++;
          } else {
            card.classList.add('hidden');
          }
        });

        if (emptyState) {
          if (visibleCount === 0) {
            emptyState.classList.remove('hidden');
          } else {
            emptyState.classList.add('hidden');
          }
        }
      });
    }
  };

  const getDhakaDates = () => {
    const now = new Date();
    const utcMillis = now.getTime() + (now.getTimezoneOffset() * 60000);
    const dhaka = new Date(utcMillis + (6 * 3600000));
    const pad = (n) => String(n).padStart(2, '0');
    
    const d1 = `${dhaka.getFullYear()}-${pad(dhaka.getMonth() + 1)}-${pad(dhaka.getDate())}`;
    dhaka.setDate(dhaka.getDate() + 1);
    const d2 = `${dhaka.getFullYear()}-${pad(dhaka.getMonth() + 1)}-${pad(dhaka.getDate())}`;
    return { checkIn: d1, checkOut: d2 };
  };

  const syncAgodaLivePrices = async () => {
    const cards = document.querySelectorAll('.landing-hotel-card');
    if (!cards || cards.length === 0) return;

    const WORKER_ENDPOINT = "https://gulshanhotels.rmollah394.workers.dev";
    const { checkIn, checkOut } = getDhakaDates();

    cards.forEach(async (card) => {
      const slug = card.getAttribute('data-slug') || '';
      const hotelName = card.getAttribute('data-hotel-name') || '';
      const agodaId = card.getAttribute('data-agoda-id') || '';

      const queryParam = agodaId ? `id=${agodaId}` : `hotel=${encodeURIComponent(slug || hotelName)}`;
      const requestUrl = `${WORKER_ENDPOINT}?${queryParam}&checkIn=${checkIn}&checkOut=${checkOut}&currency=USD`;

      try {
        const response = await fetch(requestUrl);
        if (!response.ok) return;

        const data = await response.json();
        let startingPrice = '';
        let originalPrice = '';
        let discountText = '';

        if (data.success && data.rates && data.rates.startingPrice) {
          startingPrice = data.rates.startingPrice;
          originalPrice = data.rates.originalPrice || '';
          discountText = data.rates.discountText || '';
        } else if (data.results && Array.isArray(data.results) && data.results.length > 0) {
          const item = data.results[0];
          startingPrice = item.dailyRate ? `$${Math.round(item.dailyRate)}` : '';
          originalPrice = item.crossedOutRate ? `$${Math.round(item.crossedOutRate)}` : '';
          discountText = item.discountPercentage ? `${Math.round(item.discountPercentage)}% OFF` : '';
        }

        if (startingPrice) {
          const priceEl = card.querySelector('.hotel-live-price');
          const perNightEl = card.querySelector('.hotel-per-night');
          const statusEl = card.querySelector('.hotel-rate-status');
          const origPriceEl = card.querySelector('.agoda-original-price');
          const discountEl = card.querySelector('.agoda-discount-badge');

          if (priceEl) priceEl.textContent = startingPrice;
          if (perNightEl) perNightEl.textContent = "/ night";

          if (origPriceEl && originalPrice) {
            origPriceEl.textContent = originalPrice;
            origPriceEl.classList.remove('hidden');
          }

          if (discountEl && discountText) {
            discountEl.textContent = discountText;
            discountEl.classList.remove('hidden');
          }

          if (statusEl) {
            statusEl.innerHTML = `
              <span class="inline-block w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
              <span class="text-emerald-700 font-bold">Agoda Live Rate</span>
            `;
          }
        }
      } catch (e) {}
    });
  };

  document.addEventListener('DOMContentLoaded', () => {
    initOnPageFilter();
    syncAgodaLivePrices();
  });

  document.addEventListener('astro:page-load', () => {
    initOnPageFilter();
    syncAgodaLivePrices();
  });
</script>
