---
// src/components/layout/TopBanner.astro
---

<section class="relative bg-[#0d3b23] text-white py-6 sm:py-10 px-4 overflow-hidden border-b border-white/10">
  
  <!-- ব্যাকগ্রাউন্ডে হালকা ডিজাইন (Optional Decoration) -->
  <div class="absolute top-0 right-0 -mt-10 -mr-10 w-40 h-40 bg-emerald-500/10 rounded-full blur-3xl"></div>
  <div class="absolute bottom-0 left-0 -mb-10 -ml-10 w-40 h-40 bg-emerald-500/10 rounded-full blur-3xl"></div>

  <div class="max-w-[1280px] mx-auto relative z-10">
    <div class="flex flex-col md:flex-row items-center justify-between gap-6 text-center md:text-left">
      
      <!-- টেক্সট কন্টেন্ট -->
      <div class="space-y-2">
        <div class="flex items-center justify-center md:justify-start gap-2 mb-2">
            <span class="bg-emerald-500 text-[#0d3b23] text-[10px] font-black px-2 py-0.5 rounded-full uppercase tracking-tighter">
                Exclusive Deal
            </span>
            <span class="flex h-2 w-2">
                <span class="animate-ping absolute inline-flex h-2 w-2 rounded-full bg-emerald-400 opacity-75"></span>
                <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
            </span>
        </div>
        <h2 class="text-2xl sm:text-4xl font-black leading-tight tracking-tight">
          Book Directly & Save <span class="text-emerald-400">Up to 20%</span>
        </h2>
        <p class="text-sm sm:text-lg text-emerald-100/80 font-medium max-w-2xl mx-auto md:mx-0">
          Experience the best of Gulshan with our handpicked premium hotels. No hidden fees, just the best rates guaranteed.
        </p>
      </div>

      <!-- কল টু অ্যাকশন বাটন -->
      <div class="shrink-0">
        <a href="/deals" class="inline-flex items-center gap-2 bg-white text-[#0d3b23] hover:bg-emerald-50 px-8 py-4 rounded-2xl font-black text-sm sm:text-base uppercase tracking-wider transition-all shadow-xl active:scale-95 group">
          Browse All Deals
          <svg class="w-5 h-5 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
          </svg>
        </a>
        <p class="text-[10px] text-emerald-300/50 mt-3 uppercase tracking-widest font-bold text-center">
            *Limited time offer for this month
        </p>
      </div>

    </div>
  </div>
</section>

<style>
  /* বড় ব্যানারের জন্য সুন্দর ফন্ট এবং স্পেসিং */
  section {
    font-family: 'Plus Jakarta Sans', sans-serif;
  }
</style>
