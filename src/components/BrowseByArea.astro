---
// src/components/BrowseByArea.astro (Compact 4-Zone Destination Navigator)
interface Props {
  title?: string;
  subtitle?: string;
}

const { 
  title = "Browse Hotels by Area", 
  subtitle = "Choose your preferred neighborhood across Gulshan, Banani & Baridhara diplomatic enclave."
} = Astro.props;

// গুলশানের ৪টি প্রধান এলাকা ও তাদের তথ্য
const areas = [
  {
    name: "Gulshan 2",
    tagline: "Diplomatic Zone & 5-Star Luxury",
    hotelCount: "15+ Hotels",
    highlights: "The Westin • Amari • Lake Park",
    // মডার্ন সিটি ও লেকভিউ স্কাইলাইন
    image: "https://images.unsplash.com/photo-1514565131-fce0801e5785?auto=format&fit=crop&w=700&q=80",
    link: "/#hotels"
  },
  {
    name: "Gulshan 1",
    tagline: "Commercial Hub & Shopping",
    hotelCount: "10+ Hotels",
    highlights: "Renaissance • DCC Market • MNC Offices",
    // আধুনিক কমার্শিয়াল আর্কিটেকচার
    image: "https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?auto=format&fit=crop&w=700&q=80",
    link: "/#hotels"
  },
  {
    name: "Banani",
    tagline: "Road 11 Cafes & Boutique Stays",
    hotelCount: "12+ Hotels",
    highlights: "Hotel Sarina • Golden Tulip • Food Street",
    // প্রিমিয়াম বুটিক ও ক্যাফে লাইফস্টাইল
    image: "https://images.unsplash.com/photo-1551882547-ff40c63fe5fa?auto=format&fit=crop&w=700&q=80",
    link: "/#hotels"
  },
  {
    name: "Baridhara Enclave",
    tagline: "Ultra-Secure Diplomatic Suites",
    hotelCount: "8+ Suites",
    highlights: "Ascott • Embassy Enclave • Quiet Stays",
    // নিরিবিলি ও গ্রিন ডিপ্লোম্যাটিক জোন
    image: "https://images.unsplash.com/photo-1590381105924-c72589b9ef3f?auto=format&fit=crop&w=700&q=80",
    link: "/#hotels"
  }
];
---

<!-- BROWSE BY AREA (COMPACT DESTINATION TILES) -->
<section id="areas" class="w-full bg-white pt-6 pb-10 text-slate-900 border-b border-slate-100">
  <div class="max-w-[1550px] mx-auto px-4 sm:px-8 lg:px-12 space-y-4">
    
    <!-- Section Header -->
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-end gap-2 text-left">
      <div class="space-y-0.5">
        <h2 class="text-2xl sm:text-3xl font-black font-sans text-slate-900 tracking-tight">
          {title}
        </h2>
        <p class="text-xs sm:text-sm text-slate-500 font-medium">
          {subtitle}
        </p>
      </div>

      <span class="text-xs font-semibold text-slate-400 hidden sm:block">
        4 Strategic Locations in North Dhaka
      </span>
    </div>

    <!-- 4 COMPACT DESTINATION TILES (হালকা ও স্লিম উচ্চতা: h-[210px]) -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-5 text-left">
      {areas.map((area) => (
        <a 
          href={area.link} 
          class="group relative h-[200px] sm:h-[220px] rounded-2xl overflow-hidden block border border-slate-200/90 hover:border-slate-400 transition-all duration-300 cursor-pointer"
        >
          <!-- Background Photo with subtle zoom -->
          <img 
            src={area.image} 
            alt={`${area.name} Area`} 
            loading="lazy" 
            decoding="async" 
            class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 ease-out" 
          />

          <!-- Dark Gradient Overlay -->
          <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/40 to-transparent"></div>

          <!-- Top-Left Hotel Count Badge -->
          <div class="absolute top-3.5 left-3.5 z-10">
            <span class="inline-block text-[10px] font-black uppercase tracking-wider px-2.5 py-0.5 rounded-full bg-black/40 backdrop-blur-md text-white border border-white/20">
              {area.hotelCount}
            </span>
          </div>

          <!-- Bottom Content -->
          <div class="absolute inset-x-0 bottom-0 p-4 z-10 space-y-1">
            <div>
              <h3 class="text-xl sm:text-2xl font-black text-white tracking-tight leading-tight group-hover:text-emerald-300 transition-colors">
                {area.name}
              </h3>
              <p class="text-xs text-slate-200 font-medium truncate mt-0.5">
                {area.tagline}
              </p>
            </div>

            <!-- Key Landmarks Line -->
            <div class="pt-1 flex items-center justify-between text-[11px] text-slate-300/80">
              <span class="truncate pr-2">{area.highlights}</span>
              <span class="text-white group-hover:text-emerald-300 font-bold shrink-0 transition-transform group-hover:translate-x-1">➔</span>
            </div>
          </div>
        </a>
      ))}
    </div>

  </div>
</section>
