---
// src/components/BrandStrip.astro (Clean Monochrome Luxury Hotel Brand Strip)

const hotelBrands = [
  {
    name: "THE WESTIN",
    sub: "DHAKA",
    group: "MARRIOTT INTERNATIONAL",
    link: "/the-westin-dhaka"
  },
  {
    name: "RENAISSANCE",
    sub: "HOTELS",
    group: "MARRIOTT BONVOY",
    link: "/#hotels"
  },
  {
    name: "AMARI",
    sub: "DHAKA",
    group: "ONYX HOSPITALITY",
    link: "/amari-dhaka"
  },
  {
    name: "CROWNE PLAZA",
    sub: "GULSHAN",
    group: "IHG HOTELS & RESORTS",
    link: "/#hotels"
  },
  {
    name: "LAKESHORE",
    sub: "HOTEL & APARTMENTS",
    group: "LAKESHORE COLLECTION",
    link: "/#hotels"
  },
  {
    name: "ASCOTT",
    sub: "THE RESIDENCE",
    group: "THE ASCOTT LIMITED",
    link: "/#hotels"
  }
];
---

<!-- LUXURY BRAND / HOTEL CHAINS STRIP -->
<section class="w-full bg-white py-7 sm:py-8 border-b border-slate-100 text-slate-900">
  <div class="max-w-[1550px] mx-auto px-4 sm:px-8 lg:px-12 space-y-4">
    
    <!-- Subtle Tagline -->
    <div class="text-center">
      <span class="text-[10px] sm:text-[11px] font-black uppercase tracking-[0.25em] text-slate-400">
        Featuring Global Hospitality Chains & Diplomatic Partners in Gulshan
      </span>
    </div>

    <!-- Minimalist Typography Brand Row -->
    <div class="flex flex-wrap items-center justify-center sm:justify-between gap-6 sm:gap-8 lg:gap-10 pt-2">
      {hotelBrands.map((brand) => (
        <a 
          href={brand.link}
          class="group flex flex-col items-center justify-center text-center opacity-65 hover:opacity-100 transition-opacity duration-300 cursor-pointer select-none py-1"
        >
          <!-- Brand Main Name -->
          <span class="font-serif text-lg sm:text-xl lg:text-2xl font-black text-slate-800 tracking-wider group-hover:text-[#0d3b23] transition-colors leading-none">
            {brand.name}
          </span>

          <!-- Sub Brand Line -->
          <span class="text-[9px] font-black tracking-[0.25em] text-slate-500 uppercase mt-1">
            {brand.sub}
          </span>

          <!-- Subtle Parent Group -->
          <span class="text-[7px] font-bold tracking-widest text-slate-400 uppercase mt-0.5 opacity-0 group-hover:opacity-100 transition-opacity duration-300">
            {brand.group}
          </span>
        </a>
      ))}
    </div>

  </div>
</section>
