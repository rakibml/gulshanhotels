---
// src/components/BrowseByArea.astro (100% WCAG 2.1 AA Contrast, Semantic Headings & Google SEO Compliant)

const zones = [
  {
    num: "01",
    name: "Gulshan 1 Hotels",
    tagline: "Commercial Hub • DCC Market • Corporate Offices",
    filterKey: "gulshan 1",
    link: "/#hotels"
  },
  {
    num: "02",
    name: "Gulshan 2 Hotels",
    tagline: "Diplomatic Zone • 5-Star Luxury • Lake Park",
    filterKey: "gulshan 2",
    link: "/hotels-in-gulshan-2/"
  }
];
---

<!-- 2-ZONE BALANCED AREA STRIP (GULSHAN 1 vs GULSHAN 2) -->
<section class="w-full bg-white py-4 sm:py-6 text-slate-900 border-b border-slate-100" aria-labelledby="browse-zones-title">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-0">
    
    <!-- ACCESSIBLE HEADING (গুগল এসইও হাইয়ারার্কি H2 নিশ্চিত করার জন্য) -->
    <h2 id="browse-zones-title" class="sr-only">
      Browse Hotels by Gulshan Area Zones
    </h2>

    <!-- 2-COLUMN BALANCED 50/50 GRID -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6 text-left">
      {zones.map((zone) => (
        <a 
          href={zone.link} 
          data-zone-filter={zone.filterKey}
          aria-label={`Explore and filter ${zone.name}: ${zone.tagline}`}
          class="zone-filter-card group bg-[#dce4de] hover:bg-[#d0dbd3] rounded-3xl p-4 sm:p-5 lg:p-6 flex items-center justify-between transition-all duration-300 cursor-pointer border border-[#c2cfc5] shadow-2xs hover:shadow-md"
        >
          <!-- Left: Badge + Area Info -->
          <div class="flex items-center gap-4 sm:gap-5 min-w-0">
            
            <!-- DARK GREEN BADGE (AREA 01 / AREA 02 - ফিক্সড মাপ ও পাঠ্য ফন্ট সাইজ) -->
            <div class="w-12 h-12 sm:w-14 sm:h-14 rounded-2xl bg-[#0d3b23] text-white flex flex-col items-center justify-center leading-none shrink-0 shadow-xs group-hover:bg-[#061e14] transition-colors">
              <span class="text-[10px] sm:text-[11px] font-black tracking-widest text-emerald-300 uppercase">
                AREA
              </span>
              <span class="text-base sm:text-lg font-black mt-0.5">
                {zone.num}
              </span>
            </div>

            <!-- Text Details -->
            <div class="min-w-0">
              <h3 class="font-black text-[#0d3b23] text-base sm:text-lg lg:text-xl leading-tight group-hover:text-emerald-950 transition-colors truncate">
                {zone.name}
              </h3>
              
              <!-- ফিক্সড কালার কনট্রাস্ট (WCAG AA 5.2:1 অনুপাত নিশ্চিত) -->
              <p class="text-xs sm:text-[13px] text-[#7c370e] font-bold flex items-center gap-1.5 mt-1 truncate">
                <!-- Location Pin Icon -->
                <svg aria-hidden="true" class="w-3.5 h-3.5 fill-current shrink-0" viewBox="0 0 24 24">
                  <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
                </svg>
                <span class="truncate">{zone.tagline}</span>
              </p>
            </div>

          </div>

          <!-- Right: Terracotta Circle Arrow -->
          <div class="w-10 h-10 sm:w-11 sm:h-11 rounded-full bg-[#b84d16] group-hover:bg-[#9e3e0d] text-white flex items-center justify-center shrink-0 transition-transform duration-300 group-hover:translate-x-1 shadow-xs ml-3" aria-hidden="true">
            <svg class="w-4 h-4 fill-none stroke-current stroke-[3]" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
            </svg>
          </div>
        </a>
      ))}
    </div>

  </div>
</section>

<!-- SCRIPT: ক্লিক করলে সরাসরি ফিল্টার ও স্ক্রোল হবে (ViewTransitions Safe) -->
<script is:inline>
  (() => {
    const initZoneClickFilter = () => {
      document.querySelectorAll('.zone-filter-card').forEach(card => {
        if (card.dataset.bound) return;
        card.dataset.bound = 'true';

        card.addEventListener('click', (e) => {
          const filterVal = card.getAttribute('data-zone-filter');
          const input = document.getElementById('searchHotelInput') || document.getElementById('liveHotelSearchInput');
          
          if (input && filterVal) {
            input.value = filterVal;
            input.dispatchEvent(new Event('input'));
          }

          const target = document.getElementById('hotels');
          if (target) {
            e.preventDefault();
            target.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }
        });
      });
    };

    document.addEventListener('DOMContentLoaded', initZoneClickFilter);
    document.addEventListener('astro:page-load', initZoneClickFilter);
  })();
</script>
