---
// src/components/hotel/HotelSubNav.astro (Aligned to max-w-7xl, Clean Modern Typography & Smooth ScrollSpy)
interface Props {
  hotel: any;
}

const { hotel } = Astro.props;
const data = hotel?.data || {};
const hotelTitle = data.title || data.name || "Hotel Details";

// Dynamic section controls from CMS
const showRates = data.enable_view_prices !== false;
const hasReviews = data.enable_reviews !== false;
const hasFaqs = Array.isArray(data.faqs) ? data.faqs.length > 0 : data.enable_faqs !== false;
---

<nav
  id="hotelSubNav"
  aria-label="Hotel Section Jump Navigation"
  class="sticky top-0 z-40 bg-white/95 backdrop-blur-md border-b border-slate-200 shadow-xs transition-all duration-300"
>
  <!-- কন্টেইনার উইডথ max-w-6xl করে হেডারের ছবির সাথে একদম সমান্তরাল করা হলো -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-0 flex items-center justify-between h-13 text-xs sm:text-[13px] font-semibold text-slate-600">
    
    <!-- Left Jump Links with Horizontal Scroll on Mobile -->
    <div
      id="subNavLinksContainer"
      class="flex items-center gap-5 sm:gap-7 overflow-x-auto [scrollbar-width:none] [-ms-overflow-style:none] [&::-webkit-scrollbar]:hidden h-full py-0"
    >
      <!-- Modern Sans-Serif Hotel Title (Aligned with Header Font) -->
      <span class="font-sans font-black text-[#002b11] text-xs sm:text-sm hidden lg:inline-block truncate max-w-[210px] border-r border-slate-200 pr-5 shrink-0 select-none tracking-tight">
        {hotelTitle}
      </span>

      <!-- Jump Anchors (Sleek Airbnb/Booking Tab Style) -->
      <a 
        href="#about-and-rates" 
        class="subnav-link h-full inline-flex items-center text-emerald-900 border-b-[2.5px] border-emerald-800 font-bold hover:text-emerald-800 transition-colors shrink-0"
      >
        Overview
      </a>

      <a 
        href="#amenities-and-rooms" 
        class="subnav-link h-full inline-flex items-center text-slate-600 border-b-[2.5px] border-transparent font-medium hover:text-emerald-800 transition-colors shrink-0"
      >
        Amenities & Rooms
      </a>

      <a 
        href="#location-map" 
        class="subnav-link h-full inline-flex items-center text-slate-600 border-b-[2.5px] border-transparent font-medium hover:text-emerald-800 transition-colors shrink-0"
      >
        Location
      </a>

      {hasReviews && (
        <a 
          href="#guest-reviews" 
          class="subnav-link h-full inline-flex items-center text-slate-600 border-b-[2.5px] border-transparent font-medium hover:text-emerald-800 transition-colors shrink-0"
        >
          Reviews
        </a>
      )}

      {hasFaqs && (
        <a 
          href="#faqs" 
          class="subnav-link h-full inline-flex items-center text-slate-600 border-b-[2.5px] border-transparent font-medium hover:text-emerald-800 transition-colors shrink-0"
        >
          FAQs
        </a>
      )}
    </div>

    <!-- Right Quick Action Button (Matches Brand Dark Green Pill) -->
    {showRates && (
      <div class="shrink-0 pl-4 hidden sm:block">
        <a
          href="#rates-card"
          class="bg-[#0d3b23] hover:bg-[#061e14] text-white font-bold text-xs uppercase tracking-wider px-5 py-2 rounded-full shadow-xs transition hover:scale-105 active:scale-95 inline-flex items-center gap-1.5"
        >
          <span>View Prices</span>
          <span class="text-sm">➔</span>
        </a>
      </div>
    )}

  </div>
</nav>

<!-- CLIENT SCRIPT FOR SMOOTH SCROLLSPY & ACTIVE LINK HIGHLIGHTING -->
<script>
  let subNavAbortCtrl: AbortController | null = null;

  function initSubNavScrollSpy() {
    if (subNavAbortCtrl) subNavAbortCtrl.abort();
    subNavAbortCtrl = new AbortController();

    const links = document.querySelectorAll<HTMLAnchorElement>('.subnav-link');
    const container = document.getElementById('subNavLinksContainer');
    if (!links.length) return;

    const linkMap: { link: HTMLAnchorElement; section: HTMLElement }[] = [];
    links.forEach((link) => {
      const targetId = link.getAttribute('href');
      if (targetId && targetId.startsWith('#')) {
        const section = document.querySelector<HTMLElement>(targetId);
        if (section) {
          linkMap.push({ link, section });
        }
      }
    });

    if (!linkMap.length) return;

    function setActiveLink(activeLink: HTMLAnchorElement) {
      links.forEach((l) => {
        l.classList.remove('text-emerald-900', 'border-emerald-800', 'font-bold');
        l.classList.add('text-slate-600', 'border-transparent', 'font-medium');
      });

      activeLink.classList.remove('text-slate-600', 'border-transparent', 'font-medium');
      activeLink.classList.add('text-emerald-900', 'border-emerald-800', 'font-bold');

      if (container) {
        const linkRect = activeLink.getBoundingClientRect();
        const containerRect = container.getBoundingClientRect();
        if (linkRect.left < containerRect.left || linkRect.right > containerRect.right) {
          activeLink.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
        }
      }
    }

    const observer = new IntersectionObserver(
      (entries) => {
        const visibleEntries = entries.filter((e) => e.isIntersecting);
        if (visibleEntries.length > 0) {
          const topEntry = visibleEntries.reduce((prev, curr) =>
            Math.abs(curr.boundingClientRect.top - 60) < Math.abs(prev.boundingClientRect.top - 60) ? curr : prev
          );

          const matched = linkMap.find((item) => item.section === topEntry.target);
          if (matched) {
            setActiveLink(matched.link);
          }
        }
      },
      {
        rootMargin: '-60px 0px -70% 0px',
        threshold: [0, 0.2, 0.5]
      }
    );

    linkMap.forEach(({ section }) => observer.observe(section));

    subNavAbortCtrl.signal.addEventListener('abort', () => {
      observer.disconnect();
    });
  }

  document.addEventListener('DOMContentLoaded', initSubNavScrollSpy);
  document.addEventListener('astro:page-load', initSubNavScrollSpy);
</script>
