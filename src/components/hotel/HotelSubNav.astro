---
// src/components/hotel/HotelSubNav.astro (Sticky Anchor Jump Navigation for Google Sitelinks)
interface Props {
  hotel: any;
}

const { hotel } = Astro.props;
const data = hotel?.data || {};
const hotelTitle = data.title || data.name || "Hotel Details";
---

<nav id="hotelSubNav" class="sticky top-0 z-40 bg-white/95 backdrop-blur-md border-b border-slate-200/80 shadow-2xs transition-all duration-300">
  <div class="max-w-[1550px] mx-auto px-4 sm:px-8 lg:px-12 flex items-center justify-between h-12 text-xs font-bold text-slate-700 overflow-x-auto [scrollbar-width:none] [-ms-overflow-style:none] [&::-webkit-scrollbar]:hidden">
    
    <!-- Left Jump Links -->
    <div class="flex items-center gap-6 sm:gap-8 shrink-0">
      <span class="font-serif font-black text-slate-900 text-sm hidden lg:inline-block truncate max-w-[200px] border-r border-slate-200 pr-6">
        {hotelTitle}
      </span>
      <a href="#about-and-rates" class="hover:text-emerald-800 transition py-3">Overview & Rates</a>
      <a href="#amenities-and-rooms" class="hover:text-emerald-800 transition py-3">Amenities</a>
      <a href="#amenities-and-rooms" class="hover:text-emerald-800 transition py-3">Rooms</a>
      <a href="#location-map" class="hover:text-emerald-800 transition py-3">Location</a>
      <a href="#guest-reviews" class="hover:text-emerald-800 transition py-3">Reviews</a>
      <a href="#faqs" class="hover:text-emerald-800 transition py-3">FAQs</a>
    </div>

    <!-- Right Quick Action Button -->
    <div class="shrink-0 pl-4 hidden sm:block">
      <a href="#rates-card" class="bg-[#0d3b23] hover:bg-[#061e14] text-white font-extrabold text-[11px] px-4 py-1.5 rounded-lg shadow-2xs transition">
        View Prices ➔
      </a>
    </div>

  </div>
</nav>
