---
// src/components/hotel/HotelAboutAndRates.astro (About Hotel & Sticky Live Rates Only)
interface Props {
  hotel: any;
}

const { hotel } = Astro.props;
const data = hotel?.data || {};

const hotelTitle = data.title || data.name || "Hotel Details";
const hotelPrice = data.price || "$120 / night";

// Reservation Channels from CMS
const whatsapp = data.whatsapp || "";
const phone = data.phone || "";
const cleanWhatsapp = whatsapp.replace(/[^0-9]/g, '');
const cleanPhone = phone.replace(/[^0-9+]/g, '');

const customChannels = Array.isArray(data.booking_channels) ? data.booking_channels : [];

// Vector Brand SVG Badges
const presetSvgs: Record<string, string> = {
  agoda: `<div class="w-8 h-8 rounded-xl bg-[#1d3557] text-white font-black text-[10px] flex items-center justify-center shrink-0 shadow-xs tracking-tighter"><span class="text-rose-400 font-serif italic text-xs">a</span>goda</div>`,
  booking: `<div class="w-8 h-8 rounded-xl bg-[#003580] text-white font-black text-xs flex items-center justify-center shrink-0 shadow-xs">B.</div>`,
  expedia: `<div class="w-8 h-8 rounded-xl bg-[#ffe600] text-slate-950 font-black text-xs flex items-center justify-center shrink-0 shadow-xs"><svg class="w-4 h-4 fill-slate-950" viewBox="0 0 24 24"><path d="M21 16v-2l-8-5V3.5c0-.83-.67-1.5-1.5-1.5S10 2.67 10 3.5V9l-8 5v2l8-2.5V19l-2 1.5V22l3.5-1 3.5 1v-1.5L13 19v-5.5l8 2.5z"/></svg></div>`,
  direct: `<div class="w-8 h-8 rounded-xl bg-emerald-100 border border-emerald-300 text-emerald-900 flex items-center justify-center shrink-0 shadow-xs"><svg class="w-4 h-4 fill-emerald-800" viewBox="0 0 24 24"><path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-7 3c1.66 0 3 1.34 3 3s-1.34 3-3 3-3-1.34-3-3 1.34-3 3-3zm3 10H9v-1c0-1 2-1.9 3-1.9s3 .9 3 1.9v1z"/></svg></div>`,
  whatsapp: `<div class="w-8 h-8 rounded-xl bg-[#25D366] text-white flex items-center justify-center shrink-0 shadow-xs"><svg class="w-4 h-4 fill-white" viewBox="0 0 24 24"><path d="M12.012 2c-5.506 0-9.989 4.478-9.99 9.984 0 1.763.459 3.48 1.332 5.001l-1.416 5.163 5.281-1.388c1.464.798 3.118 1.22 4.79 1.22h.004c5.506 0 9.989-4.478 9.99-9.984 0-2.668-1.038-5.176-2.923-7.062a9.923 9.923 0 0 0-7.058-2.934z"/></svg></div>`,
  phone: `<div class="w-8 h-8 rounded-xl bg-slate-800 text-white flex items-center justify-center shrink-0 shadow-xs"><svg class="w-4 h-4 fill-white" viewBox="0 0 24 24"><path d="M6.62 10.79c1.44 2.83 2.62 4.2 5.45 5.64l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/></svg></div>`
};

function sanitizeLink(rawUrl: string = "", preset: string = "", pName: string = "", hName: string = "") {
  if (!rawUrl) return "#";
  let url = rawUrl.trim();
  const lowerName = pName.toLowerCase();

  if (preset === 'whatsapp' || lowerName.includes('whatsapp') || preset === 'phone' || lowerName.includes('call') || /^[0-9+\s\-()]+$/.test(url)) {
    if (preset === 'phone' || lowerName.includes('call')) {
      const cleanP = url.replace(/[^0-9+]/g, '');
      return `tel:${cleanP}`;
    }
    let digits = url.replace(/[^0-9]/g, '');
    if (digits.startsWith('01')) digits = '88' + digits;
    return `https://wa.me/${digits}?text=${encodeURIComponent('Hi! I want to book a room at ' + hName)}`;
  }

  if (!url.startsWith('http://') && !url.startsWith('https://') && !url.startsWith('tel:') && !url.startsWith('mailto:')) {
    return `https://${url}`;
  }

  return url;
}
---

<!-- ABOUT HOTEL & LIVE RATE COMPARISON -->
<section id="about-and-rates" class="bg-white py-12 px-4 sm:px-6 lg:px-0 max-w-6xl mx-auto text-slate-800 border-b border-slate-200 scroll-mt-14 sm:scroll-mt-16">
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-start">
    
    <!-- LEFT COLUMN: ABOUT HOTEL -->
    <div class="lg:col-span-7 space-y-5 text-left">
      <div>
        <span class="text-[10px] sm:text-xs font-black uppercase tracking-widest text-emerald-800 bg-emerald-50 border border-emerald-200 px-3 py-1 rounded-full inline-block mb-3">
          Property Overview
        </span>
        <h2 class="font-sans text-2xl sm:text-3xl lg:text-4xl font-black text-[#002b11] tracking-tight leading-tight">
          About {hotelTitle}
        </h2>
      </div>

      <!-- Overview Text with Gradient Fade -->
      <div id="overview-wrapper" class="relative">
        <div id="overview-text" class="prose prose-slate max-w-none text-xs sm:text-sm md:text-base leading-relaxed text-slate-700 font-normal [&_a]:text-emerald-800 [&_a]:font-bold [&_a]:underline hover:[&_a]:text-emerald-600 transition-all duration-300">
          {hotel?.body ? <Fragment set:html={hotel.body} /> : (
            <p>
              Located in the heart of Gulshan 2, {hotelTitle} offers executive 5-star lodging with world-class hospitality, high-speed Wi-Fi, fine dining restaurants, and diplomatic security.
            </p>
          )}
        </div>
      </div>

      <button 
        type="button"
        id="toggleOverviewBtn" 
        class="hidden text-xs sm:text-sm font-bold text-emerald-800 hover:text-emerald-950 transition items-center gap-1.5 cursor-pointer bg-emerald-50 hover:bg-emerald-100 px-4 py-2 rounded-xl border border-emerald-300 shadow-xs inline-flex select-none"
      >
        <span id="readMoreText">Read More ➔</span>
      </button>

      <!-- Key Property Highlights Pill Bar -->
      <div class="pt-4 grid grid-cols-2 sm:grid-cols-3 gap-2.5 text-xs font-bold text-slate-700">
        <div class="flex items-center gap-2 bg-slate-50 border border-slate-200/80 p-2.5 rounded-xl">
          <span class="text-emerald-700">✓</span>
          <span>Verified Luxury Stay</span>
        </div>
        <div class="flex items-center gap-2 bg-slate-50 border border-slate-200/80 p-2.5 rounded-xl">
          <span class="text-emerald-700">✓</span>
          <span>Diplomatic Zone</span>
        </div>
        <div class="flex items-center gap-2 bg-slate-50 border border-slate-200/80 p-2.5 rounded-xl">
          <span class="text-emerald-700">✓</span>
          <span>Free High-Speed Wi-Fi</span>
        </div>
      </div>
    </div>

    <!-- RIGHT COLUMN: STICKY BOOKING & RATES CARD -->
    <div class="lg:col-span-5 lg:sticky lg:top-16 z-20">
      <div id="rates-card" class="bg-white rounded-3xl p-6 sm:p-7 border border-slate-200 shadow-lg space-y-4 text-left scroll-mt-20">
        
        <!-- Card Header -->
        <div class="space-y-3 border-b border-slate-100 pb-4">
          <h3 class="font-sans text-xl sm:text-2xl font-black text-[#002b11] tracking-tight">
            Where can you book this hotel?
          </h3>
          
          <!-- Starting Price Box -->
          <div class="bg-emerald-50 border border-emerald-200 rounded-2xl p-3.5 flex items-center justify-between">
            <div>
              <span class="text-[10px] font-bold text-emerald-800 uppercase tracking-wider block">Starting From</span>
              <span id="cardStartingPriceDisplay" class="text-2xl sm:text-3xl font-black text-[#002b11] block leading-none mt-0.5">
                {hotelPrice}
              </span>
            </div>
            
            <span class="inline-flex items-center gap-1.5 bg-white border border-emerald-300 text-emerald-900 text-[10px] font-black px-2.5 py-1 rounded-full shadow-xs">
              <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
              <span>Updated Today</span>
            </span>
          </div>
        </div>

        <!-- Direct Reservation Channels (WhatsApp & Phone) -->
        {(whatsapp || phone) && (
          <div id="staticReservationChannels" class="grid grid-cols-1 sm:grid-cols-2 gap-2 pb-1">
            {whatsapp && (
              <a 
                href={`https://wa.me/${cleanWhatsapp}?text=${encodeURIComponent('Hi! I want to book a room at ' + hotelTitle)}`} 
                target="_blank" 
                rel="noopener noreferrer"
                class="flex items-center gap-2 p-2.5 rounded-xl bg-emerald-50 hover:bg-emerald-100/90 border border-emerald-200 transition text-emerald-950 font-bold text-xs"
              >
                <div class="w-7 h-7 rounded-lg bg-[#25D366] text-white flex items-center justify-center shrink-0">
                  <svg class="w-3.5 h-3.5 fill-white" viewBox="0 0 24 24"><path d="M12.012 2c-5.506 0-9.989 4.478-9.99 9.984 0 1.763.459 3.48 1.332 5.001l-1.416 5.163 5.281-1.388c1.464.798 3.118 1.22 4.79 1.22h.004c5.506 0 9.989-4.478 9.99-9.984 0-2.668-1.038-5.176-2.923-7.062a9.923 9.923 0 0 0-7.058-2.934z"/></svg>
                </div>
                <span class="truncate">WhatsApp Booking</span>
              </a>
            )}

            {phone && (
              <a 
                href={`tel:${cleanPhone}`} 
                class="flex items-center gap-2 p-2.5 rounded-xl bg-slate-50 hover:bg-slate-100 border border-slate-200 transition text-slate-900 font-bold text-xs"
              >
                <div class="w-7 h-7 rounded-lg bg-slate-800 text-white flex items-center justify-center shrink-0">
                  <svg class="w-3.5 h-3.5 fill-white" viewBox="0 0 24 24"><path d="M6.62 10.79c1.44 2.83 2.62 4.2 5.45 5.64l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/></svg>
                </div>
                <span class="truncate">Call Hotel Direct</span>
              </a>
            )}
          </div>
        )}

        <!-- Booking Channels List -->
        <div id="aboutRatesTableContainer" data-hotel-title={hotelTitle} class="space-y-2.5 min-h-[120px]">
          {customChannels.length > 0 ? (
            customChannels.map((item: any) => {
              const pName = item.provider_name || "Booking Partner";
              const pPrice = item.price || "";
              const showPriceTag = item.show_price !== false;
              const btnText = item.button_text || "Book Now ➔";
              const rawUrl = item.button_url || "#";
              const badgeText = item.badge || "";
              const customSvg = item.custom_svg || "";
              const iconPreset = item.icon_preset || "direct";
              const finalUrl = sanitizeLink(rawUrl, iconPreset, pName, hotelTitle);

              return (
                <div class="relative pt-1.5">
                  {badgeText && (
                    <span class="absolute -top-1 left-3 z-10 bg-[#002b11] text-emerald-200 text-[9px] font-black uppercase tracking-wider px-2 py-0.5 rounded-full border border-emerald-800 shadow-xs">
                      {badgeText}
                    </span>
                  )}
                  <div class="flex items-center justify-between p-3 rounded-2xl border border-slate-200 bg-slate-50/70 hover:bg-slate-100 transition">
                    <div class="flex items-center gap-2.5 min-w-0">
                      {customSvg ? (
                        <div class="w-7 h-7 shrink-0 flex items-center justify-center [&_svg]:w-full [&_svg]:h-full [&_svg]:max-w-full [&_svg]:max-h-full">
                          <Fragment set:html={customSvg} />
                        </div>
                      ) : (
                        <Fragment set:html={presetSvgs[iconPreset] || presetSvgs.direct} />
                      )}
                      <span class="text-xs sm:text-sm font-bold text-slate-900 truncate">{pName}</span>
                    </div>

                    <div class="flex items-center gap-2.5 sm:gap-3 shrink-0">
                      {showPriceTag && pPrice && (
                        <span class="text-sm font-black text-slate-900">
                          {pPrice.startsWith('$') || pPrice.startsWith('৳') ? pPrice : '$' + pPrice}
                        </span>
                      )}
                      <a 
                        href={finalUrl} 
                        target={finalUrl.startsWith('http') ? "_blank" : "_self"} 
                        rel="noopener noreferrer" 
                        class="bg-[#0d3b23] hover:bg-[#061e14] text-white font-black text-xs px-4 py-2 rounded-full transition shadow-xs hover:scale-105 active:scale-95 inline-flex items-center gap-1"
                      >
                        {btnText}
                      </a>
                    </div>
                  </div>
                </div>
              );
            })
          ) : (
            <div id="ratesFallbackLoader" class="text-center py-5 bg-slate-50 rounded-2xl border border-slate-200 space-y-2">
              <span class="inline-block w-5 h-5 border-2 border-emerald-600 border-t-transparent rounded-full animate-spin"></span>
              <p class="text-xs font-bold text-slate-600">Checking latest verified room rates...</p>
            </div>
          )}
        </div>

        <!-- Disclaimer -->
        <div class="bg-amber-50/80 border border-amber-200 rounded-2xl p-3 flex items-start gap-2 text-[11px] text-amber-950 font-medium">
          <svg class="w-4 h-4 fill-amber-700 shrink-0 mt-0.5" viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z"/></svg>
          <p class="leading-relaxed text-slate-700">
            Rates depend on travel dates & room type. Click <strong class="text-slate-900 font-bold">'Book Now'</strong> for exact checkout prices.
          </p>
        </div>

      </div>
    </div>

  </div>
</section>

<!-- HIDDEN SCRIPT FOR PRESET SVGS -->
<script type="application/json" id="preset-svgs-data" set:html={JSON.stringify(presetSvgs)}></script>

<!-- CLIENT SCRIPT -->
<script>
  let aboutAbortCtrl: AbortController | null = null;

  async function initHotelAboutSection() {
    if (aboutAbortCtrl) aboutAbortCtrl.abort();
    aboutAbortCtrl = new AbortController();
    const { signal } = aboutAbortCtrl;

    const ratesContainer = document.getElementById('aboutRatesTableContainer');
    const startingPriceEl = document.getElementById('cardStartingPriceDisplay');
    const loaderEl = document.getElementById('ratesFallbackLoader');

    const svgScript = document.getElementById('preset-svgs-data');
    let presetSvgs: Record<string, string> = {};
    try {
      presetSvgs = JSON.parse(svgScript?.textContent || '{}');
    } catch {
      presetSvgs = {};
    }

    if (ratesContainer && !ratesContainer.dataset.fetched && loaderEl) {
      ratesContainer.dataset.fetched = 'true';
      const hotelName = ratesContainer.getAttribute('data-hotel-title') || '';
      const kvApiUrl = `https://gatlin.rmollah394.workers.dev/api/prices?hotel=${encodeURIComponent(hotelName)}`;

      const timeoutId = setTimeout(() => {
        showFallbackDirectBooking();
      }, 4000);

      try {
        const res = await fetch(kvApiUrl, { signal });
        clearTimeout(timeoutId);

        if (res.ok) {
          const json = await res.json();
          if (json && json.success && json.rates) {
            const rates = json.rates;
            
            if (rates.startingPrice && startingPriceEl) {
              startingPriceEl.textContent = rates.startingPrice;
            }

            const dealsList = Array.isArray(rates.channelsList) ? rates.channelsList : [];

            if (dealsList.length > 0) {
              ratesContainer.innerHTML = dealsList.map((item: any) => {
                const badgeHtml = item.badge 
                  ? `<span class="absolute -top-1 left-3 z-10 bg-[#002b11] text-emerald-200 text-[9px] font-black uppercase tracking-wider px-2 py-0.5 rounded-full border border-emerald-800 shadow-xs">${item.badge}</span>` 
                  : '';
                
                let iconHtml = presetSvgs[item.icon_preset] || presetSvgs.direct || '';
                if (item.custom_svg) {
                  iconHtml = `<div class="w-7 h-7 shrink-0 flex items-center justify-center [&_svg]:w-full [&_svg]:h-full [&_svg]:max-w-full [&_svg]:max-h-full">${item.custom_svg}</div>`;
                }

                const priceDisplay = (item.showPrice !== false && item.price) 
                  ? `<span class="text-sm font-black text-slate-900">${item.price.startsWith('$') || item.price.startsWith('৳') ? item.price : '$' + item.price}</span>` 
                  : '';

                let finalUrl = item.button_url || '#';
                const providerLower = (item.provider_name || '').toLowerCase();

                if (item.icon_preset === 'whatsapp' || providerLower.includes('whatsapp')) {
                  if (!finalUrl.startsWith('http')) {
                    const cleanWa = finalUrl.replace(/[^0-9]/g, '');
                    finalUrl = cleanWa ? `https://wa.me/${cleanWa}?text=${encodeURIComponent('Hi! I want to book a stay at ' + hotelName)}` : '#';
                  }
                } else if (item.icon_preset === 'phone' || providerLower.includes('call')) {
                  if (!finalUrl.startsWith('tel:') && !finalUrl.startsWith('http')) {
                    const cleanP = finalUrl.replace(/[^0-9+]/g, '');
                    finalUrl = cleanP ? `tel:${cleanP}` : '#';
                  }
                }

                return `
                  <div class="relative pt-1.5">
                    ${badgeHtml}
                    <div class="flex items-center justify-between p-3 rounded-2xl border border-slate-200 bg-slate-50/70 hover:bg-slate-100 transition">
                      <div class="flex items-center gap-2.5 min-w-0">
                        ${iconHtml}
                        <span class="text-xs sm:text-sm font-bold text-slate-900 truncate">${item.provider_name || 'Booking Partner'}</span>
                      </div>
                      <div class="flex items-center gap-2.5 sm:gap-3 shrink-0">
                        ${priceDisplay}
                        <a href="${finalUrl}" target="${finalUrl.startsWith('http') ? '_blank' : '_self'}" rel="noopener noreferrer" class="bg-[#0d3b23] hover:bg-[#061e14] text-white font-black text-xs px-4 py-2 rounded-full transition shadow-xs hover:scale-105 active:scale-95 inline-flex items-center gap-1">
                          ${item.button_text || 'Book Now ➔'}
                        </a>
                      </div>
                    </div>
                  </div>
                `;
              }).join('');
              
              applyLinkAttributes();
              setupOverviewTruncator();
              return;
            }
          }
        }
        showFallbackDirectBooking();
      } catch (e: any) {
        if (e.name !== 'AbortError') {
          showFallbackDirectBooking();
        }
      }
    }

    function showFallbackDirectBooking() {
      if (!ratesContainer || !ratesContainer.querySelector('#ratesFallbackLoader')) return;
      ratesContainer.innerHTML = `
        <div class="text-left p-3.5 bg-emerald-50/60 border border-emerald-200/80 rounded-2xl space-y-1.5">
          <p class="text-xs font-bold text-emerald-950">
            For best rate guarantee & immediate confirmation, please contact the hotel directly via WhatsApp or Phone above.
          </p>
        </div>
      `;
    }

    applyLinkAttributes();
    setupOverviewTruncator();
  }

  function applyLinkAttributes() {
    document.querySelectorAll('#overview-text a').forEach(link => {
      link.classList.add('text-emerald-800', 'font-extrabold', 'underline', 'hover:text-emerald-600');
      const href = link.getAttribute('href');
      if (href && (href.startsWith('http') || href.startsWith('//'))) {
        link.setAttribute('target', '_blank');
        link.setAttribute('rel', 'noopener noreferrer');
      }
    });
  }

  function setupOverviewTruncator() {
    const textEl = document.getElementById('overview-text');
    const wrapperEl = document.getElementById('overview-wrapper');
    const toggleBtn = document.getElementById('toggleOverviewBtn');
    const toggleBtnText = document.getElementById('readMoreText');

    if (textEl && toggleBtn && wrapperEl) {
      const isLongText = textEl.scrollHeight > 220;

      if (isLongText) {
        textEl.classList.add('max-h-[190px]', 'overflow-hidden');
        wrapperEl.classList.add('after:absolute', 'after:bottom-0', 'after:inset-x-0', 'after:h-16', 'after:bg-gradient-to-t', 'after:from-white', 'after:to-transparent', 'after:pointer-events-none');
        
        toggleBtn.classList.remove('hidden');
        let isExpanded = false;

        toggleBtn.onclick = () => {
          isExpanded = !isExpanded;
          if (isExpanded) {
            textEl.classList.remove('max-h-[190px]', 'overflow-hidden');
            wrapperEl.classList.remove('after:absolute', 'after:bottom-0', 'after:inset-x-0', 'after:h-16', 'after:bg-gradient-to-t', 'after:from-white', 'after:to-transparent', 'after:pointer-events-none');
            if (toggleBtnText) toggleBtnText.textContent = 'Show Less ↩';
          } else {
            textEl.classList.add('max-h-[190px]', 'overflow-hidden');
            wrapperEl.classList.add('after:absolute', 'after:bottom-0', 'after:inset-x-0', 'after:h-16', 'after:bg-gradient-to-t', 'after:from-white', 'after:to-transparent', 'after:pointer-events-none');
            if (toggleBtnText) toggleBtnText.textContent = 'Read More ➔';
            wrapperEl.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
          }
        };
      } else {
        toggleBtn.classList.add('hidden');
      }
    }
  }

  document.addEventListener('DOMContentLoaded', initHotelAboutSection);
  document.addEventListener('astro:page-load', initHotelAboutSection);
</script>
