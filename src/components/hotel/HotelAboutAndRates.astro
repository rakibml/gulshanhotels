---
// src/components/hotel/HotelAboutAndRates.astro (Centered Rates Card, Pure Dynamic CMS Policies & HTML Link Protection)
interface Props {
  hotel: any;
}

const { hotel } = Astro.props;
const data = hotel?.data || {};

const hotelTitle = data.title || data.name || "Hotel Details";
const hotelPrice = data.price || "Check Price";
const hotelCategory = data.category || "Luxury Hotel";

// 100% Admin CMS Controllable Policies
const checkIn = data.checkIn || "2:00 PM";
const checkOut = data.checkOut || "12:00 PM";
const powerBackup = data.powerBackup || "24/7 Generator";
const smokingPolicy = data.smokingPolicy || "Non-Smoking";
---

<!-- 2ND COMPONENT: ABOUT HOTEL & LIVE STAY22 RATE COMPARISON -->
<section id="about-and-rates" class="bg-[#F8FAF9] py-10 px-4 sm:px-8 lg:px-12 max-w-[1550px] mx-auto text-slate-800 border-b border-slate-200/80">
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start">
    
    <!-- LEFT COLUMN (ABOUT {HOTEL TITLE} & HOTEL POLICIES) -->
    <div class="lg:col-span-7 space-y-8 text-left">
      
      <!-- About Hotel Section with Dynamic Title -->
      <div class="space-y-4">
        <h2 class="text-2xl sm:text-4xl font-black font-serif text-slate-900">
          About {hotelTitle}
        </h2>

        <!-- Hotel Description Container with Forced Link Styling ([&_a]) -->
        <div id="overview-wrapper" class="relative">
          <div id="overview-text" class="prose prose-slate max-w-none text-xs sm:text-base leading-relaxed text-slate-700 font-normal [&_a]:text-emerald-800 [&_a]:font-bold [&_a]:underline hover:[&_a]:text-emerald-600 transition-all duration-300">
            {hotel?.body ? <Fragment set:html={hotel.body} /> : (
              <p>
                Located in the heart of Gulshan, {hotelTitle} offers executive lodging with world-class hospitality, high-speed Wi-Fi, fine dining restaurants, and diplomatic security.
              </p>
            )}
          </div>
        </div>

        <!-- Read More Button (Hidden by default, shown ONLY if text > 150 words) -->
        <button 
          id="toggleOverviewBtn" 
          style="display: none;"
          class="mt-2 text-xs sm:text-sm font-black text-emerald-800 hover:text-emerald-900 transition items-center gap-1.5 cursor-pointer bg-emerald-100/70 hover:bg-emerald-200/80 px-4 py-2 rounded-xl border border-emerald-300/80 shadow-sm"
        >
          Read More ➔
        </button>
      </div>

      <!-- Hotel Policies & Quick Information Grid -->
      <div class="pt-4 border-t border-slate-200/80 space-y-4">
        <h3 class="text-xs font-black uppercase tracking-wider text-slate-800">Hotel Policies & Essential Info</h3>

        <div class="grid grid-cols-2 sm:grid-cols-3 gap-4 text-xs sm:text-sm">
          
          <!-- Check-In SVG -->
          <div class="flex items-center gap-3">
            <div class="w-9 h-9 rounded-xl bg-white border border-slate-200 flex items-center justify-center shrink-0 shadow-sm">
              <svg class="w-4 h-4 fill-slate-800" width="16" height="16" viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67z"/></svg>
            </div>
            <div>
              <span class="text-slate-600 text-[11px] block font-extrabold uppercase">Check-In</span>
              <span class="font-black text-slate-900">{checkIn}</span>
            </div>
          </div>

          <!-- Check-Out SVG -->
          <div class="flex items-center gap-3">
            <div class="w-9 h-9 rounded-xl bg-white border border-slate-200 flex items-center justify-center shrink-0 shadow-sm">
              <svg class="w-4 h-4 fill-slate-700" width="16" height="16" viewBox="0 0 24 24"><path d="M19 3H5c-1.11 0-2 .9-2 2v14c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16H5V5h14v14zm-5-7h-3v3H9v-3H6v-2h3V7h2v3h3z"/></svg>
            </div>
            <div>
              <span class="text-slate-600 text-[11px] block font-extrabold uppercase">Check-Out</span>
              <span class="font-black text-slate-900">{checkOut}</span>
            </div>
          </div>

          <!-- Price SVG -->
          <div class="flex items-center gap-3">
            <div class="w-9 h-9 rounded-xl bg-emerald-100/70 border border-emerald-300 flex items-center justify-center shrink-0 shadow-sm">
              <svg class="w-4 h-4 fill-emerald-800" width="16" height="16" viewBox="0 0 24 24"><path d="M21.41 11.58l-9-9C12.05 2.22 11.55 2 11 2H4c-1.1 0-2 .9-2 2v7c0 .55.22 1.05.59 1.42l9 9c.36.36.86.58 1.41.58.55 0 1.05-.22 1.41-.59l7-7c.37-.36.59-.86.59-1.41 0-.55-.23-1.06-.59-1.42zM5.5 7C4.67 7 4 6.33 4 5.5S4.67 4 5.5 4 7 4.67 7 5.5 6.33 7 5.5 7z"/></svg>
            </div>
            <div>
              <span class="text-slate-600 text-[11px] block font-extrabold uppercase">Starting Price</span>
              <span class="font-black text-emerald-900">{hotelPrice}</span>
            </div>
          </div>

          <!-- Property Type SVG -->
          <div class="flex items-center gap-3">
            <div class="w-9 h-9 rounded-xl bg-white border border-slate-200 flex items-center justify-center shrink-0 shadow-sm">
              <svg class="w-4 h-4 fill-slate-700" width="16" height="16" viewBox="0 0 24 24"><path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-7 3c1.66 0 3 1.34 3 3s-1.34 3-3 3-3-1.34-3-3 1.34-3 3-3zm3 10H9v-1c0-1 2-1.9 3-1.9s3 .9 3 1.9v1z"/></svg>
            </div>
            <div>
              <span class="text-slate-600 text-[11px] block font-extrabold uppercase">Property Type</span>
              <span class="font-black text-slate-900">{hotelCategory}</span>
            </div>
          </div>

          <!-- Power Backup SVG -->
          <div class="flex items-center gap-3">
            <div class="w-9 h-9 rounded-xl bg-white border border-slate-200 flex items-center justify-center shrink-0 shadow-sm">
              <svg class="w-4 h-4 fill-emerald-800" width="16" height="16" viewBox="0 0 24 24"><path d="M7 2v11h3v9l7-12h-4l4-8z"/></svg>
            </div>
            <div>
              <span class="text-slate-600 text-[11px] block font-extrabold uppercase">Power Backup</span>
              <span class="font-black text-emerald-900">{powerBackup}</span>
            </div>
          </div>

          <!-- Smoking Policy SVG -->
          <div class="flex items-center gap-3">
            <div class="w-9 h-9 rounded-xl bg-white border border-slate-200 flex items-center justify-center shrink-0 shadow-sm">
              <svg class="w-4 h-4 fill-slate-700" width="16" height="16" viewBox="0 0 24 24"><path d="M14.5 9H18c.83 0 1.5.67 1.5 1.5v2c0 .83-.67 1.5-1.5 1.5h-3.5V9zM2 10h11.5v3H2v-3zm18 0c.28 0 .5.22.5.5v2c0 .28-.22.5-.5.5s-.5-.22-.5-.5v-2c0-.28.22-.5.5-.5z"/></svg>
            </div>
            <div>
              <span class="text-slate-600 text-[11px] block font-extrabold uppercase">Smoking</span>
              <span class="font-black text-slate-900">{smokingPolicy}</span>
            </div>
          </div>

        </div>
      </div>

    </div>

    <!-- RIGHT COLUMN (WHERE CAN YOU BOOK THIS HOTEL? - DIRECT TARGET WITH SCROLL-MT-24 FOR PERFECT CENTERED ALIGNMENT) -->
    <div class="lg:col-span-5">
      <div id="rates-card" class="bg-white rounded-3xl p-6 sm:p-8 border border-slate-200/90 shadow-xl space-y-5 min-h-[380px] scroll-mt-24 sm:scroll-mt-28">
        
        <!-- Card Header -->
        <div class="space-y-1 text-left border-b border-slate-100 pb-4">
          <h3 class="text-xl sm:text-2xl font-black font-serif text-slate-900">
            Where can you book this hotel?
          </h3>
          <p class="text-xs text-slate-500 font-medium">
            Compare prices from trusted travel partners.
          </p>
        </div>

        <!-- Live Stay22 API Rates List Container -->
        <div id="aboutRatesTableContainer" data-hotel-title={hotelTitle} class="space-y-2.5 min-h-[220px]">
          <div class="text-center py-8 bg-slate-50 rounded-2xl border border-slate-200 space-y-2">
            <span class="inline-block w-5 h-5 border-2 border-emerald-600 border-t-transparent rounded-full animate-spin"></span>
            <p class="text-xs font-bold text-slate-600">Connecting to Stay22 Direct API for live rates...</p>
          </div>
        </div>

        <!-- Amber Deal Tip Box -->
        <div class="bg-amber-50/80 border border-amber-200/70 rounded-2xl p-4 flex items-center gap-3 text-xs text-amber-900 font-bold shadow-sm">
          <svg class="w-5 h-5 fill-amber-700 shrink-0" width="20" height="20" viewBox="0 0 24 24">
            <path d="M21.41 11.58l-9-9C12.05 2.22 11.55 2 11 2H4c-1.1 0-2 .9-2 2v7c0 .55.22 1.05.59 1.42l9 9c.36.36.86.58 1.41.58.55 0 1.05-.22 1.41-.59l7-7c.37-.36.59-.86.59-1.41 0-.55-.23-1.06-.59-1.42zM5.5 7C4.67 7 4 6.33 4 5.5S4.67 4 5.5 4 7 4.67 7 5.5 6.33 7 5.5 7z"/>
          </svg>
          <p class="leading-tight">
            Compare prices before you book and get the best deal.
          </p>
        </div>

      </div>
    </div>

  </div>
</section>

<!-- CLIENT SCRIPTS WITH SINGLE-STATE HISTORY CLEANUP -->
<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    // 1. Amenities Modal Script
    const amenModal = document.getElementById('allAmenitiesModal');
    const openAmenBtn = document.getElementById('openAmenitiesModalBtn');
    const closeAmenBtn = document.getElementById('closeAmenitiesModalBtn');

    let isAmenModalPushed = false;

    function openAmenModalSafe() {
      if (!amenModal) return;
      amenModal.classList.remove('hidden');
      if (!isAmenModalPushed) {
        try {
          history.pushState({ amenModalOpen: true }, '');
          isAmenModalPushed = true;
        } catch (e) {}
      }
    }

    function closeAmenModalSafe() {
      if (!amenModal) return;
      amenModal.classList.add('hidden');
      if (isAmenModalPushed) {
        isAmenModalPushed = false;
        try { history.back(); } catch (e) {}
      }
    }

    // 2. Selected Room Modal Script
    const roomModal = document.getElementById('selectedRoomModal');
    const closeRoomModalBtn = document.getElementById('closeSelectedRoomModalBtn');
    const modalRoomTitle = document.getElementById('modalSelectedRoomName');
    const modalRoomImg = document.getElementById('modalRoomMainImg');
    const modalHighlightsGrid = document.getElementById('modalFeaturedHighlightsGrid');
    const modalRoomSpecs = document.getElementById('modalRoomSpecs');
    const modalRoomGrid = document.getElementById('modalRoomChecklistGrid');
    const modalBadge = document.getElementById('modalRoomPhotoBadge');
    const modalPrevPhotoBtn = document.getElementById('modalRoomPrevPhotoBtn');
    const modalNextPhotoBtn = document.getElementById('modalRoomNextPhotoBtn');
    const modalCheckRatesBtn = document.getElementById('modalCheckRatesBtn');

    const allRoomsData = JSON.parse(roomModal?.dataset.allRooms || '[]');
    let modalPhotos = [];
    let modalActivePhotoIdx = 0;
    let isRoomModalPushed = false;

    function openRoomModalSafe(roomObj) {
      if (!roomModal || !roomObj) return;
      if (modalRoomTitle) modalRoomTitle.textContent = roomObj.name || 'Room Details';
      
      if (modalRoomSpecs) {
        modalRoomSpecs.innerHTML = `
          ${roomObj.size ? `<span>📐 ${roomObj.size}</span><span>•</span>` : ''}
          ${roomObj.guests ? `<span>👤 ${roomObj.guests}</span><span>•</span>` : ''}
          ${roomObj.bed ? `<span>🛏️ ${roomObj.bed}</span>` : ''}
        `;
      }

      if (modalRoomGrid) {
        const list = roomObj.checklist || roomObj.fullAmenities || [];
        if (list && list.length > 0) {
          modalRoomGrid.innerHTML = list.map(item => `<div class="flex items-center gap-1.5"><span class="text-emerald-400">✔</span><span>${typeof item === 'string' ? item : (item?.name || 'Feature')}</span></div>`).join('');
        }
      }

      modalPhotos = (roomObj.photos && roomObj.photos.length > 0) ? roomObj.photos : (roomObj.image ? [roomObj.image] : []);
      modalActivePhotoIdx = 0;
      if (modalPhotos.length > 0) {
        updateModalPhoto(0);
      }

      roomModal.classList.remove('hidden');
      if (!isRoomModalPushed) {
        try {
          history.pushState({ roomModalOpen: true }, '');
          isRoomModalPushed = true;
        } catch (e) {}
      }
    }

    function updateModalPhoto(idx) {
      if (!modalRoomImg || !modalPhotos.length) return;
      modalActivePhotoIdx = (idx + modalPhotos.length) % modalPhotos.length;
      modalRoomImg.src = modalPhotos[modalActivePhotoIdx];
      if (modalBadge) modalBadge.textContent = `${modalActivePhotoIdx + 1} / ${modalPhotos.length}`;
    }

    function closeRoomModalSafe() {
      if (!roomModal) return;
      roomModal.classList.add('hidden');
      if (isRoomModalPushed) {
        isRoomModalPushed = false;
        try { history.back(); } catch (e) {}
      }
    }

    // INTERCEPT MOBILE PHYSICAL / GESTURE BACK BUTTON (POPSTATE)
    window.addEventListener('popstate', () => {
      if (amenModal && !amenModal.classList.contains('hidden')) {
        amenModal.classList.add('hidden');
        isAmenModalPushed = false;
      }
      if (roomModal && !roomModal.classList.contains('hidden')) {
        roomModal.classList.add('hidden');
        isRoomModalPushed = false;
      }
    });

    if (openAmenBtn) openAmenBtn.addEventListener('click', () => openAmenModalSafe());
    if (closeAmenBtn) closeAmenBtn.addEventListener('click', () => closeAmenModalSafe());

    if (amenModal) {
      amenModal.addEventListener('click', (e) => {
        if (e.target === amenModal) closeAmenModalSafe();
      });
    }

    if (closeRoomModalBtn) closeRoomModalBtn.addEventListener('click', () => closeRoomModalSafe());
    if (roomModal) {
      roomModal.addEventListener('click', (e) => {
        if (e.target === roomModal) closeRoomModalSafe();
      });
    }

    if (modalPrevPhotoBtn) modalPrevPhotoBtn.addEventListener('click', () => updateModalPhoto(modalActivePhotoIdx - 1));
    if (modalNextPhotoBtn) modalNextPhotoBtn.addEventListener('click', () => updateModalPhoto(modalActivePhotoIdx + 1));

    if (modalCheckRatesBtn) {
      modalCheckRatesBtn.addEventListener('click', () => closeRoomModalSafe());
    }

    // 3. Room Card Photo Slider & Details Click
    document.querySelectorAll('.room-card-box').forEach((card, index) => {
      const img = card.querySelector('.room-card-main-img');
      const prevBtn = card.querySelector('.card-img-prev-btn');
      const nextBtn = card.querySelector('.card-img-next-btn');
      const badge = card.querySelector('.card-img-badge');

      const roomObj = allRoomsData[index] || {};

      if (img) {
        const photos = (roomObj.photos && roomObj.photos.length > 0) ? roomObj.photos : (roomObj.image ? [roomObj.image] : [img.src]);
        let currentPhotoIdx = 0;

        function updateCardPhoto(idx) {
          if (!photos.length) return;
          currentPhotoIdx = (idx + photos.length) % photos.length;
          img.src = photos[currentPhotoIdx];
          if (badge) badge.textContent = `${currentPhotoIdx + 1} / ${photos.length}`;
        }

        if (prevBtn) {
          prevBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            updateCardPhoto(currentPhotoIdx - 1);
          });
        }

        if (nextBtn) {
          nextBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            updateCardPhoto(currentPhotoIdx + 1);
          });
        }

        img.addEventListener('click', () => openRoomModalSafe(roomObj));
      }

      card.querySelectorAll('.open-room-detail-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          openRoomModalSafe(roomObj);
        });
      });
    });

    // 4. Room Carousel Track Side Floating Arrows
    const track = document.getElementById('roomsCarouselTrack');
    const prevTrackBtn = document.getElementById('roomPrevBtn');
    const nextTrackBtn = document.getElementById('roomNextBtn');

    if (track && prevTrackBtn && nextTrackBtn) {
      prevTrackBtn.addEventListener('click', () => {
        track.scrollBy({ left: -320, behavior: 'smooth' });
      });

      nextTrackBtn.addEventListener('click', () => {
        track.scrollBy({ left: 320, behavior: 'smooth' });
      });
    }
  });
</script>
