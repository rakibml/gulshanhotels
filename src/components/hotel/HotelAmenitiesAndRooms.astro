---
// src/components/hotel/HotelAmenitiesAndRooms.astro (Side Floating Arrows & Mobile Back Button Safety)
interface Props {
  hotel: any;
}

const { hotel } = Astro.props;
const data = hotel?.data || {};

const hotelTitle = data.title || data.name || "Hotel Details";

// All Available Room Types
const allRoomTypes = [
  {
    name: "Deluxe King Room",
    price: "$120",
    guests: "2 Guests",
    bed: "1 King Bed",
    size: "42 m²",
    image: "https://images.unsplash.com/photo-1618773928121-c32242e63f39?auto=format&fit=crop&w=600&q=80"
  },
  {
    name: "Deluxe Twin Room",
    price: "$130",
    guests: "2 Guests",
    bed: "2 Twin Beds",
    size: "42 m²",
    image: "https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&w=600&q=80"
  },
  {
    name: "Executive Suite",
    price: "$145",
    guests: "2 Guests",
    bed: "1 King Bed",
    size: "58 m²",
    image: "https://images.unsplash.com/photo-1591088398332-8a7791972843?auto=format&fit=crop&w=600&q=80"
  },
  {
    name: "Diplomatic Corner Suite",
    price: "$220",
    guests: "3 Guests",
    bed: "1 King Bed",
    size: "72 m²",
    image: "https://images.unsplash.com/photo-1571896349842-33c89424de2d?auto=format&fit=crop&w=600&q=80"
  },
  {
    name: "Presidential Westin Suite",
    price: "$290",
    guests: "3 Guests",
    bed: "1 Super King Bed",
    size: "95 m²",
    image: "https://images.unsplash.com/photo-1582719478250-c89cae4dc85b?auto=format&fit=crop&w=600&q=80"
  }
];
---

<!-- 3RD COMPONENT: AMENITIES & SMART ROOM TYPES SLIDER (SIDE FLOATING ARROWS) -->
<section id="amenities-and-rooms" class="bg-[#F8FAF9] py-10 px-4 sm:px-8 lg:px-12 max-w-[1550px] mx-auto text-slate-800 border-b border-slate-200/80">
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start">
    
    <!-- LEFT COLUMN: AMENITIES & SERVICES -->
