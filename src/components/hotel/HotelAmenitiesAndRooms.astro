---
// src/components/hotel/HotelAmenitiesAndRooms.astro (100% Pure Vector SVG Icons, Zero Emojis)
interface Props {
  hotel: any;
}

const { hotel } = Astro.props;
const data = hotel?.data || {};

const hotelTitle = data.title || data.name || "Hotel Details";

// Agoda Signature Detailed Room Types Data
const agodaRoomTypes = [
  {
    name: "Deluxe Guest Room, 1 King Bed",
    price: "$120",
    size: "42 m² / 452 ft²",
    guests: "Max 2 Adults",
    bed: "1 King Bed",
    badges: ["Recommended", "Preferred Choice"],
    checklist: ["City view", "Air conditioning", "Private bathroom", "Electric kettle", "Hair dryer", "Free toiletries"],
    photos: [
      "https://images.unsplash.com/photo-1618773928121-c32242e63f39?auto=format&fit=crop&w=600&q=80",
      "https://images.unsplash.com/photo-1591088398332-8a7791972843?auto=format&fit=crop&w=600&q=80",
      "https://images.unsplash.com/photo-1582719478250-c89cae4dc85b?auto=format&fit=crop&w=600&q=80"
    ]
  },
  {
    name: "Deluxe Guest Room, 2 Twin Beds",
    price: "$130",
    size: "42 m² / 452 ft²",
    guests: "Max 2 Adults",
    bed: "2 Twin Beds",
    badges: ["Popular with Families"],
    checklist: ["City view", "Walk-in shower", "Private bathroom", "Work desk", "Coffee maker", "In-room safe"],
    photos: [
      "https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&w=600&q=80",
      "https://images.unsplash.com/photo-1571896349842-33c89424de2d?auto=format&fit=crop&w=600&q=80"
    ]
  },
  {
    name: "Club Lounge Access, Larger Suite, 1 King",
    price: "$185",
    size: "58 m² / 624 ft²",
    guests: "Max 2 Adults",
    bed: "1 King Bed",
    badges: ["Club Lounge Access", "High Floor View"],
    checklist: ["Panoramic city view", "Club Lounge breakfast", "Bathtub & Jacuzzi", "Espresso machine", "Bathrobes & slippers", "Free minibar"],
    photos: [
      "https://images.unsplash.com/photo-1591088398332-8a7791972843?auto=format&fit=crop&w=600&q=80",
      "https://images.unsplash.com/photo-1582719478250-c89cae4dc85b?auto=format&fit=crop&w=600&q=80"
    ]
  },
  {
    name: "Presidential Westin Suite, City View",
    price: "$290",
    size: "95 m² / 1022 ft²",
    guests: "Max 3 Adults",
    bed: "1 Super King Bed",
    badges: ["VIP Diplomatic Suite", "Luxury Pick"],
    checklist: ["Private living room", "Dining hall table", "Separate guest toilet", "Luxury Jacuzzi bath", "Personal butler service", "24/7 Room service"],
    photos: [
      "https://images.unsplash.com/photo-1582719478250-c89cae4dc85b?auto=format&fit=crop&w=600&q=80",
      "https://images.unsplash.com/photo-1618773928121-c32242e63f39?auto=format&fit=crop&w=600&q=80"
    ]
  }
];
---

<!-- 3RD COMPONENT: AMENITIES & AGODA SIGNATURE ROOM CARDS -->
<section id="amenities-and-rooms" class="bg-[#F8FAF9] py-10 px-4 sm:px-8 lg:px-12 max-w-[1550px] mx-auto text-slate-800 border-b border-slate-200/80">
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start">
    
    <!-- LEFT COLUMN: AMENITIES & SERVICES -->
    <div class="lg:col-span-5 space-y-6 text-left">
      <div class="border-b border-slate-200/80 pb-3">
        <h2 class="text-2xl sm:text-3xl font-black font-serif text-slate-900">
          Amenities & Services
        </h2>
      </div>

      <!-- 9 Circular Vector Amenity Badges Grid -->
      <div class="grid grid-cols-3 gap-3 text-center">
        
        <!-- Swimming Pool -->
        <div class="flex flex-col items-center justify-center p-3 rounded-2xl bg-white border border-slate-200/80 hover:border-emerald-500/50 hover:shadow-md transition group cursor-pointer">
          <div class="w-10 h-10 rounded-full bg-slate-100 flex items-center justify-center text-slate-700 group-hover:scale-110 transition shrink-0">
            <svg class="w-5 h-5 fill-slate-700" width="20" height="20" viewBox="0 0 24 24"><path d="M22 17c-1.1 0-2.12-.3-3-.83-.88.53-1.9.83-3 .83s-2.12-.3-3-.83c-.88.53-1.9.83-3 .83s-2.12-.3-3-.83c-.88.53-1.9.83-3 .83v-2c.67 0 1.3-.19 1.83-.53.88-.53 1.9-.83 3-.83s2.12.3 3 .83c.88.53 1.9.83 3 .83s2.12-.3 3-.83c.88-.53 1.9-.83 3-.83s2.12.3 3 .83c.53.34 1.16.53 1.83.53v2zm0-5c-1.1 0-2.12-.3-3-.83-.88.53-1.9.83-3 .83s-2.12-.3-3-.83c-.88.53-1.9.83-3 .83s-2.12-.3-3-.83c-.88.53-1.9.83-3 .83v-2c.67 0 1.3-.19 1.83-.53.88-.53 1.9-.83 3-.83s2.12.3 3 .83c.88.53 1.9.83 3 .83s2.12-.3 3-.83c.88-.53 1.9-.83 3-.83s2.12.3 3 .83c.53.34 1.16.53 1.83.53v2zM15 7.5a2.5 2.5 0 1 0-5 0 2.5 2.5 0 0 0 5 0z"/></svg>
          </div>
          <span class="text-xs font-bold text-slate-800 mt-2 line-clamp-1">Swimming Pool</span>
        </div>

        <!-- Spa & Wellness -->
        <div class="flex flex-col items-center justify-center p-3 rounded-2xl bg-white border border-slate-200/80 hover:border-emerald-500/50 hover:shadow-md transition group cursor-pointer">
          <div class="w-10 h-10 rounded-full bg-slate-100 flex items-center justify-center text-slate-700 group-hover:scale-110 transition shrink-0">
            <svg class="w-5 h-5 fill-slate-700" width="20" height="20" viewBox="0 0 24 24"><path d="M12 3c-1.5 2.5-3 5.5-3 8 0 1.66 1.34 3 3 3s3-1.34 3-3c0-2.5-1.5-5.5-3-8zm-5.5 5.5c-2.5 1.5-5.5 3-8 3 0 1.66 1.34 3 3 3 2.5 0 5.5-1.5 8-3-1.34 0-3-1.34-3-3zm11 0c0 1.66-1.66 3-3 3 2.5 1.5 5.5 3 8 3 0-1.66-1.34-3-3-3-2.5 0-5.5-1.5-8-3z"/></svg>
          </div>
          <span class="text-xs font-bold text-slate-800 mt-2 line-clamp-1">Spa & Wellness</span>
        </div>

        <!-- Fitness Center -->
        <div class="flex flex-col items-center justify-center p-3 rounded-2xl bg-white border border-slate-200/80 hover:border-emerald-500/50 hover:shadow-md transition group cursor-pointer">
          <div class="w-10 h-10 rounded-full bg-slate-100 flex items-center justify-center text-slate-700 group-hover:scale-110 transition shrink-0">
            <svg class="w-5 h-5 fill-slate-700" width="20" height="20" viewBox="0 0 24 24"><path d="M20.57 14.86L22 13.43 20.57 12 17 15.57 8.43 7 12 3.43 10.57 2 9.14 3.43 7.71 2 6.29 3.43 7.71 4.86 3.43 9.14 2 7.71 0.57 9.14 2 10.57 0.57 12 2 13.43 3.43 12 12 20.57 15.57 17 17 18.43 18.43 17 17 15.57 20.57 12z"/></svg>
          </div>
          <span class="text-xs font-bold text-slate-800 mt-2 line-clamp-1">Fitness Center</span>
        </div>

        <!-- 3 Restaurants -->
        <div class="flex flex-col items-center justify-center p-3 rounded-2xl bg-white border border-slate-200/80 hover:border-emerald-500/50 hover:shadow-md transition group cursor-pointer">
          <div class="w-10 h-10 rounded-full bg-slate-100 flex items-center justify-center text-slate-700 group-hover:scale-110 transition shrink-0">
            <svg class="w-5 h-5 fill-slate-700" width="20" height="20" viewBox="0 0 24 24"><path d="M11 9H9V2H7v7H5V2H3v7c0 2.12 1.55 3.87 3.56 4.17L6 22h2l-.56-8.83C9.45 12.87 11 11.12 11 9zm9-7h-2c-1.1 0-2 .9-2 2v7h2v13h2V2z"/></svg>
          </div>
          <span class="text-xs font-bold text-slate-800 mt-2 line-clamp-1">3 Restaurants</span>
        </div>

        <!-- Free Wi-Fi -->
        <div class="flex flex-col items-center justify-center p-3 rounded-2xl bg-white border border-slate-200/80 hover:border-emerald-500/50 hover:shadow-md transition group cursor-pointer">
          <div class="w-10 h-10 rounded-full bg-slate-100 flex items-center justify-center text-slate-700 group-hover:scale-110 transition shrink-0">
            <svg class="w-5 h-5 fill-slate-700" width="20" height="20" viewBox="0 0 24 24"><path d="M12 3C7.95 3 4.21 4.34 1.2 6.6L3 8.8C5.46 6.81 8.58 5.7 12 5.7c3.42 0 6.54 1.11 9 3.1l1.8-2.2C19.79 4.34 16.05 3 12 3zm0 5c-2.92 0-5.61.96-7.8 2.58l1.8 2.22C7.62 11.53 9.71 10.7 12 10.7c2.29 0 4.38.83 6 2.1l1.8-2.22C17.61 8.96 14.92 8 12 8zm0 5c-1.87 0-3.58.62-4.98 1.67L12 21l4.98-6.33C15.58 13.62 13.87 13 12 13z"/></svg>
          </div>
          <span class="text-xs font-bold text-slate-800 mt-2 line-clamp-1">Free Wi-Fi</span>
        </div>

        <!-- Free Parking -->
        <div class="flex flex-col items-center justify-center p-3 rounded-2xl bg-white border border-slate-200/80 hover:border-emerald-500/50 hover:shadow-md transition group cursor-pointer">
          <div class="w-10 h-10 rounded-full bg-slate-100 flex items-center justify-center text-slate-700 group-hover:scale-110 transition shrink-0">
            <svg class="w-5 h-5 fill-slate-700" width="20" height="20" viewBox="0 0 24 24"><path d="M13.2 11H10V7h3.2c1.1 0 2 .9 2 2s-.9 2-2 2zM19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-5.8 10H10v4H8V5h5.2c2.2 0 4 1.8 4 4s-1.8 4-4 4z"/></svg>
          </div>
          <span class="text-xs font-bold text-slate-800 mt-2 line-clamp-1">Free Parking</span>
        </div>

        <!-- Airport Transfer -->
        <div class="flex flex-col items-center justify-center p-3 rounded-2xl bg-white border border-slate-200/80 hover:border-emerald-500/50 hover:shadow-md transition group cursor-pointer">
          <div class="w-10 h-10 rounded-full bg-slate-100 flex items-center justify-center text-slate-700 group-hover:scale-110 transition shrink-0">
            <svg class="w-5 h-5 fill-slate-700" width="20" height="20" viewBox="0 0 24 24"><path d="M21 16v-2l-8-5V3.5c0-.83-.67-1.5-1.5-1.5S10 2.67 10 3.5V9l-8 5v2l8-2.5V19l-2 1.5V22l3.5-1 3.5 1v-1.5L13 19v-5.5l8 2.5z"/></svg>
          </div>
          <span class="text-xs font-bold text-slate-800 mt-2 line-clamp-1">Airport Transfer</span>
        </div>

        <!-- Meeting & Events -->
        <div class="flex flex-col items-center justify-center p-3 rounded-2xl bg-white border border-slate-200/80 hover:border-emerald-500/50 hover:shadow-md transition group cursor-pointer">
          <div class="w-10 h-10 rounded-full bg-slate-100 flex items-center justify-center text-slate-700 group-hover:scale-110 transition shrink-0">
            <svg class="w-5 h-5 fill-slate-700" width="20" height="20" viewBox="0 0 24 24"><path d="M20 6h-4V4c0-1.11-.89-2-2-2h-4c-1.11 0-2 .89-2 2v2H4c-1.11 0-1.99.89-1.99 2L2 19c0 1.11.89 2 2 2h16c1.11 0 2-.89 2-2V8c0-1.11-.89-2-2-2zm-6 0h-4V4h4v2z"/></svg>
          </div>
          <span class="text-xs font-bold text-slate-800 mt-2 line-clamp-1">Meeting & Events</span>
        </div>

        <!-- 24/7 Room Service -->
        <div class="flex flex-col items-center justify-center p-3 rounded-2xl bg-white border border-slate-200/80 hover:border-emerald-500/50 hover:shadow-md transition group cursor-pointer">
          <div class="w-10 h-10 rounded-full bg-slate-100 flex items-center justify-center text-slate-700 group-hover:scale-110 transition shrink-0">
            <svg class="w-5 h-5 fill-slate-700" width="20" height="20" viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67z"/></svg>
          </div>
          <span class="text-xs font-bold text-slate-800 mt-2 line-clamp-1">24/7 Room Service</span>
        </div>

      </div>

      <!-- See More Amenities Button -->
      <div>
        <button 
          id="openAmenitiesModalBtn" 
          class="w-full sm:w-auto bg-white hover:bg-slate-100 text-slate-900 font-extrabold text-xs uppercase tracking-wider px-6 py-3 rounded-xl border border-slate-300 transition shadow-sm flex items-center justify-center gap-2 cursor-pointer"
        >
          <span>See More Amenities (28+)</span>
          <span>➔</span>
        </button>
      </div>
    </div>

    <!-- RIGHT COLUMN: SMART ALL ROOM TYPES CAROUSEL (VECTOR SVG SPECS & BADGES) -->
    <div class="lg:col-span-7 space-y-4 text-left">
      
      <!-- Section Header -->
      <div class="border-b border-slate-200/80 pb-3">
        <h2 class="text-2xl sm:text-3xl font-black font-serif text-slate-900">
          Room Types
        </h2>
        <p class="text-xs text-slate-500 font-medium mt-0.5">Explore all available rooms & suites</p>
      </div>

      <!-- CAROUSEL TRACK WITH SIDE FLOATING ARROW BUTTONS -->
      <div class="relative group">
        
        <!-- Left Floating Arrow Button -->
        <button 
          id="roomPrevBtn" 
          aria-label="Previous Room" 
          class="absolute -left-3 sm:-left-5 top-1/2 -translate-y-1/2 w-9 h-9 sm:w-11 sm:h-11 rounded-full bg-white border border-slate-200 shadow-xl text-slate-800 hover:bg-[#0d3b23] hover:text-white transition z-20 cursor-pointer flex items-center justify-center text-sm font-bold active:scale-95"
        >
          ❮
        </button>

        <!-- Right Floating Arrow Button -->
        <button 
          id="roomNextBtn" 
          aria-label="Next Room" 
          class="absolute -right-3 sm:-right-5 top-1/2 -translate-y-1/2 w-9 h-9 sm:w-11 sm:h-11 rounded-full bg-white border border-slate-200 shadow-xl text-slate-800 hover:bg-[#0d3b23] hover:text-white transition z-20 cursor-pointer flex items-center justify-center text-sm font-bold active:scale-95"
        >
          ❯
        </button>

        <!-- AGODA SIGNATURE ROOM CARDS SLIDER -->
        <div id="roomsCarouselTrack" class="flex gap-4 overflow-x-auto scroll-smooth py-2 px-1 [scrollbar-width:none] [-ms-overflow-style:none] [&::-webkit-scrollbar]:hidden">
          {agodaRoomTypes.map((room) => (
            <div class="room-card-box w-[300px] sm:w-[330px] shrink-0 bg-white rounded-3xl border border-slate-200/90 overflow-hidden shadow-sm hover:shadow-xl transition duration-300 flex flex-col justify-between group">
              
              <div>
                <!-- PHOTO CAROUSEL HEADER -->
                <div class="h-44 w-full overflow-hidden relative group/roomimg">
                  <img 
                    src={room.photos[0]} 
                    alt={room.name} 
                    loading="lazy"
                    decoding="async"
                    data-photos={JSON.stringify(room.photos)}
                    class="room-card-main-img w-full h-full object-cover group-hover/roomimg:scale-105 transition duration-500 cursor-pointer" 
                  />
                  
                  <!-- Card Image Arrow Left -->
                  <button class="card-img-prev-btn absolute left-2 top-1/2 -translate-y-1/2 w-7 h-7 rounded-full bg-slate-950/70 hover:bg-slate-950 text-white text-xs flex items-center justify-center backdrop-blur-md opacity-0 group-hover/roomimg:opacity-100 transition z-10 cursor-pointer">❮</button>
                  
                  <!-- Card Image Arrow Right -->
                  <button class="card-img-next-btn absolute right-2 top-1/2 -translate-y-1/2 w-7 h-7 rounded-full bg-slate-950/70 hover:bg-slate-950 text-white text-xs flex items-center justify-center backdrop-blur-md opacity-0 group-hover/roomimg:opacity-100 transition z-10 cursor-pointer">❯</button>

                  <!-- Photo Counter Badge -->
                  <span class="card-img-badge absolute bottom-2.5 left-3 bg-slate-950/80 backdrop-blur-md text-white text-[10px] font-bold px-2.5 py-0.5 rounded-full border border-white/20 pointer-events-none">
                    1 / {room.photos.length}
                  </span>
                </div>

                <!-- ROOM CONTENT -->
                <div class="p-5 space-y-2 text-left">
                  <!-- Room Photos and Details Link -->
                  <button 
                    class="open-room-detail-btn text-[11px] font-bold text-emerald-800 hover:underline inline-block cursor-pointer"
                    data-room-name={room.name}
                    data-room-photos={JSON.stringify(room.photos)}
                  >
                    Room photos and details ➔
                  </button>

                  <h3 class="font-bold text-slate-900 text-base leading-tight group-hover:text-emerald-800 transition line-clamp-2">
                    {room.name}
                  </h3>

                  <!-- Specs Sub-bar (Vector SVG Icons) -->
                  <div class="text-[11px] text-slate-500 font-semibold flex flex-wrap items-center gap-2 pt-0.5">
                    <!-- Size SVG -->
                    <span class="bg-slate-100 px-2 py-0.5 rounded flex items-center gap-1">
                      <svg class="w-3.5 h-3.5 fill-slate-500 shrink-0" width="14" height="14" viewBox="0 0 24 24"><path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16H5V5h14v14zM8 7h2v3H8zm0 5h2v3H8zm5-5h2v3h-2zm0 5h2v3h-2z"/></svg>
                      {room.size}
                    </span>

                    <!-- Guests SVG -->
                    <span class="bg-slate-100 px-2 py-0.5 rounded flex items-center gap-1">
                      <svg class="w-3.5 h-3.5 fill-slate-500 shrink-0" width="14" height="14" viewBox="0 0 24 24"><path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/></svg>
                      {room.guests}
                    </span>

                    <!-- Bed SVG -->
                    <span class="bg-slate-100 px-2 py-0.5 rounded flex items-center gap-1">
                      <svg class="w-3.5 h-3.5 fill-slate-500 shrink-0" width="14" height="14" viewBox="0 0 24 24"><path d="M20 9.557V3h-2v2H6V3H4v6.557C2.81 10.25 2 11.525 2 13v8h2v-2h16v2h2v-8c0-1.475-.81-2.75-2-3.443zM18 7v2.05A3.486 3.486 0 0 0 16.5 9c-.83 0-1.58.29-2.18.78A3.47 3.48 0 0 0 12 9c-.83 0-1.58.29-2.18.78A3.486 3.486 0 0 0 8.5 9C7.67 9 6.92 9.29 6.32 9.78V7h11.68z"/></svg>
                      {room.bed}
                    </span>
                  </div>

                  <!-- Agoda Badges (Vector Thumbs Up SVG) -->
                  <div class="flex flex-wrap items-center gap-1.5 pt-1">
                    {room.badges.map((b) => (
                      <span class="bg-indigo-50 text-indigo-900 border border-indigo-200 text-[10px] font-extrabold px-2.5 py-0.5 rounded-md flex items-center gap-1">
                        <svg class="w-3 h-3 fill-indigo-700 shrink-0" width="12" height="12" viewBox="0 0 24 24"><path d="M1 21h4V9H1v12zm22-11c0-1.1-.9-2-2-2h-6.31l.95-4.57.03-.32c0-.41-.17-.79-.44-1.06L14.17 1 7.58 7.59C7.22 7.95 7 8.45 7 9v10c0 1.1.9 2 2 2h9c.83 0 1.54-.5 1.84-1.22l3.02-7.05c.09-.23.14-.47.14-.73v-2z"/></svg>
                        <span>{b}</span>
                      </span>
                    ))}
                  </div>

                  <!-- 2-Column Vector Checklist -->
                  <div class="grid grid-cols-2 gap-x-2 gap-y-1 pt-2 border-t border-slate-100 text-[11px] text-slate-700">
                    {room.checklist.map((item) => (
                      <div class="flex items-center gap-1.5">
                        <svg class="w-3.5 h-3.5 fill-emerald-600 shrink-0" viewBox="0 0 24 24"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
                        <span class="truncate">{item}</span>
                      </div>
                    ))}
                  </div>
                </div>
              </div>

              <!-- FULL-WIDTH ACTION BUTTON -->
              <div class="p-5 pt-0">
                <a href="#about-and-rates" class="block w-full bg-[#0d3b23] hover:bg-[#061e14] text-white font-extrabold text-xs text-center py-3 rounded-xl transition shadow-md">
                  Check Live Rates ➔
                </a>
              </div>

            </div>
          ))}
        </div>

      </div>

    </div>

  </div>
</section>

<!-- POPUP MODAL: ALL 28+ CATEGORIZED AMENITIES -->
<div id="allAmenitiesModal" class="fixed inset-0 z-50 bg-slate-950/80 backdrop-blur-md hidden flex items-center justify-center p-4">
  <div class="bg-white border border-slate-200 rounded-3xl p-6 sm:p-8 w-full max-w-2xl text-slate-900 space-y-6 shadow-2xl relative max-h-[85vh] overflow-y-auto">
    
    <div class="flex items-center justify-between border-b border-slate-200 pb-4">
      <div>
        <span class="text-[10px] font-black uppercase text-emerald-800 tracking-widest block">Complete List</span>
        <h3 class="text-2xl font-black font-serif text-slate-900">All Hotel Amenities & Services</h3>
      </div>
      <button id="closeAmenitiesModalBtn" class="text-slate-400 hover:text-slate-900 text-3xl font-bold p-1 cursor-pointer">&times;</button>
    </div>

    <!-- Categorized Amenities Grid -->
    <div class="space-y-6 text-xs sm:text-sm text-slate-800">
      <div>
        <h4 class="font-bold text-emerald-800 uppercase tracking-wider text-xs mb-2.5">Pool, Spa & Wellness</h4>
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-2">
          <div class="flex items-center gap-2 bg-slate-50 p-2.5 rounded-xl border"><svg class="w-3.5 h-3.5 fill-emerald-600" viewBox="0 0 24 24"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg> Swimming Pool</div>
