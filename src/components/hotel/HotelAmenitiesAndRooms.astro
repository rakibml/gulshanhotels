---
// src/components/hotel/HotelAmenitiesAndRooms.astro (100% Pure CMS Driven - Zero Hardcoded Arrays)
interface Props {
  hotel: any;
}

const { hotel } = Astro.props;
const data = hotel?.data || {};

const hotelTitle = data.title || data.name || "Hotel Details";
const amenitiesList = data.amenities || [];
const roomsList = data.rooms || [];

const showAmenities = data.enable_amenities !== false && amenitiesList.length > 0;
const showRooms = roomsList.length > 0;
---

<!-- RENDER ONLY IF CMS HAS AMENITIES OR ROOMS DATA -->
{(showAmenities || showRooms) && (
  <section id="amenities-and-rooms" class="bg-[#F8FAF9] py-10 px-4 sm:px-8 lg:px-12 max-w-[1550px] mx-auto text-slate-800 border-b border-slate-200/80">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start">
      
      <!-- LEFT COLUMN: AMENITIES & SERVICES (RENDERED ONLY IF CMS HAS AMENITIES) -->
      {showAmenities && (
        <div class={showRooms ? "lg:col-span-5 space-y-6 text-left" : "lg:col-span-12 space-y-6 text-left"}>
          <div class="border-b border-slate-200/80 pb-3">
            <h2 class="text-2xl sm:text-3xl font-black font-serif text-slate-900">
              Amenities & Services
            </h2>
          </div>

          <!-- Dynamic CMS Amenities Grid -->
          <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 text-center">
            {amenitiesList.map((item: string) => (
              <div class="flex items-center gap-2.5 font-bold text-slate-800 bg-white p-3.5 rounded-2xl border border-slate-200/80 shadow-sm text-xs sm:text-sm">
                <svg class="w-4 h-4 fill-emerald-600 shrink-0" width="16" height="16" viewBox="0 0 24 24">
                  <path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/>
                </svg>
                <span class="line-clamp-1">{item}</span>
              </div>
            ))}
          </div>
        </div>
      )}

      <!-- RIGHT COLUMN: ROOM TYPES (RENDERED ONLY IF CMS HAS ROOMS DATA) -->
      {showRooms && (
        <div class={showAmenities ? "lg:col-span-7 space-y-4 text-left" : "lg:col-span-12 space-y-4 text-left"}>
          
          <!-- Section Header -->
          <div class="border-b border-slate-200/80 pb-3">
            <h2 class="text-2xl sm:text-3xl font-black font-serif text-slate-900">
              Room Types
            </h2>
            <p class="text-xs text-slate-500 font-medium mt-0.5">Explore available rooms & suites</p>
          </div>

          <!-- CAROUSEL TRACK WITH SIDE FLOATING ARROW BUTTONS -->
          <div class="relative group">
            
            {roomsList.length > 2 && (
              <button 
                id="roomPrevBtn" 
                aria-label="Previous Room" 
                class="absolute -left-3 sm:-left-5 top-1/2 -translate-y-1/2 w-9 h-9 sm:w-11 sm:h-11 rounded-full bg-white border border-slate-200 shadow-xl text-slate-800 hover:bg-[#0d3b23] hover:text-white transition z-20 cursor-pointer flex items-center justify-center text-sm font-bold active:scale-95"
              >
                ❮
              </button>
            )}

            {roomsList.length > 2 && (
              <button 
                id="roomNextBtn" 
                aria-label="Next Room" 
                class="absolute -right-3 sm:-right-5 top-1/2 -translate-y-1/2 w-9 h-9 sm:w-11 sm:h-11 rounded-full bg-white border border-slate-200 shadow-xl text-slate-800 hover:bg-[#0d3b23] hover:text-white transition z-20 cursor-pointer flex items-center justify-center text-sm font-bold active:scale-95"
              >
                ❯
              </button>
            )}

            <!-- PURE CMS ROOM CARDS SLIDER -->
            <div id="roomsCarouselTrack" class="flex gap-4 overflow-x-auto scroll-smooth py-2 px-1 [scrollbar-width:none] [-ms-overflow-style:none] [&::-webkit-scrollbar]:hidden">
              {roomsList.map((room: any) => (
                <div class="room-card-box w-[280px] sm:w-[310px] shrink-0 bg-white rounded-3xl border border-slate-200/90 overflow-hidden shadow-sm hover:shadow-xl transition duration-300 flex flex-col justify-between group">
                  
                  <div>
                    {room.image && (
                      <div class="h-44 w-full overflow-hidden relative">
                        <img 
                          src={room.image} 
                          alt={`${room.name || 'Room'} - ${hotelTitle}`} 
                          loading="lazy"
                          decoding="async"
                          class="w-full h-full object-cover group-hover:scale-105 transition duration-500" 
                        />
                      </div>
                    )}

                    <div class="p-5 space-y-2 text-left">
                      <h3 class="font-bold text-slate-900 text-base leading-tight group-hover:text-emerald-800 transition line-clamp-2">
                        {room.name || 'Standard Room'}
                      </h3>

                      {room.price && (
                        <div class="text-xs text-slate-500">
                          From <span class="font-black text-slate-900">{room.price}</span>
                        </div>
                      )}

                      <!-- Specs Sub-bar -->
                      <div class="text-[11px] text-slate-500 font-semibold flex flex-wrap items-center gap-2 pt-1">
                        {room.size && (
                          <span class="bg-slate-100 px-2 py-0.5 rounded flex items-center gap-1">
                            <svg class="w-3.5 h-3.5 fill-slate-500 shrink-0" width="14" height="14" viewBox="0 0 24 24"><path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16H5V5h14v14zM8 7h2v3H8zm0 5h2v3H8zm5-5h2v3h-2zm0 5h2v3h-2z"/></svg>
                            {room.size}
                          </span>
                        )}

                        {room.guests && (
                          <span class="bg-slate-100 px-2 py-0.5 rounded flex items-center gap-1">
                            <svg class="w-3.5 h-3.5 fill-slate-500 shrink-0" width="14" height="14" viewBox="0 0 24 24"><path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/></svg>
                            {room.guests}
                          </span>
                        )}

                        {room.bed && (
                          <span class="bg-slate-100 px-2 py-0.5 rounded flex items-center gap-1">
                            <svg class="w-3.5 h-3.5 fill-slate-500 shrink-0" width="14" height="14" viewBox="0 0 24 24"><path d="M20 9.557V3h-2v2H6V3H4v6.557C2.81 10.25 2 11.525 2 13v8h2v-2h16v2h2v-8c0-1.475-.81-2.75-2-3.443zM18 7v2.05A3.486 3.486 0 0 0 16.5 9c-.83 0-1.58.29-2.18.78A3.47 3.48 0 0 0 12 9c-.83 0-1.58.29-2.18.78A3.486 3.486 0 0 0 8.5 9C7.67 9 6.92 9.29 6.32 9.78V7h11.68z"/></svg>
                            {room.bed}
                          </span>
                        )}
                      </div>
                    </div>
                  </div>

                  <!-- FULL-WIDTH ACTION BUTTON -->
                  <div class="p-5 pt-0">
                    <a href="#rates-card" class="block w-full bg-[#0d3b23] hover:bg-[#061e14] text-white font-extrabold text-xs text-center py-3 rounded-xl transition shadow-md">
                      Check Live Rates ➔
                    </a>
                  </div>

                </div>
              ))}
            </div>

          </div>

        </div>
      )}

    </div>
  </section>
)}

<!-- CLIENT SCRIPT FOR ROOM CAROUSEL ARROWS -->
<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const track = document.getElementById('roomsCarouselTrack');
    const prevTrackBtn = document.getElementById('roomPrevBtn');
    const nextTrackBtn = document.getElementById('roomNextBtn');

    if (track && prevTrackBtn && nextTrackBtn) {
      prevTrackBtn.addEventListener('click', () => {
        track.scrollBy({ left: -320, behavior: 'smooth' });
      });

      nextTrackBtn.addEventListener('click', () => {
        track.scrollBy({ left: 320, behavior: 'smooth' });
      });
    }
  });
</script>
