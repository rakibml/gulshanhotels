<!-- POPUP MODAL: SELECTED ROOM PHOTOS & DETAILS -->
<div id="selectedRoomModal" class="fixed inset-0 z-50 bg-slate-950/90 backdrop-blur-md hidden flex flex-col justify-between p-4 sm:p-8 text-white">
  <div class="flex items-center justify-between max-w-5xl mx-auto w-full border-b border-slate-800 pb-4">
    <div>
      <h3 id="modalSelectedRoomName" class="text-lg font-black font-serif text-white">Room Details</h3>
      <span class="text-xs text-slate-400">Room Photos Gallery</span>
    </div>
    <button id="closeSelectedRoomModalBtn" class="text-slate-400 hover:text-white text-3xl font-bold p-1 cursor-pointer">&times;</button>
  </div>

  <div class="relative max-w-4xl mx-auto my-auto w-full h-[60vh] flex items-center justify-center">
    <img id="selectedRoomModalImg" src="" alt="Room Photo" loading="lazy" decoding="async" class="max-w-full max-h-full object-contain rounded-2xl shadow-2xl" />
  </div>
</div>

<!-- CLIENT SCRIPTS -->
<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    // 1. Amenities Modal
    const amenModal = document.getElementById('allAmenitiesModal');
    const openAmenBtn = document.getElementById('openAmenitiesModalBtn');
    const closeAmenBtn = document.getElementById('closeAmenitiesModalBtn');

    function openAmenModalSafe() {
      if (!amenModal) return;
      amenModal.classList.remove('hidden');
      try { history.pushState({ amenModalOpen: true }, ''); } catch (e) {}
    }

    function closeAmenModalSafe() {
      if (!amenModal) return;
      amenModal.classList.add('hidden');
    }

    if (openAmenBtn) openAmenBtn.addEventListener('click', () => openAmenModalSafe());
    if (closeAmenBtn) closeAmenBtn.addEventListener('click', () => closeAmenModalSafe());

    if (amenModal) {
      amenModal.addEventListener('click', (e) => {
        if (e.target === amenModal) closeAmenModalSafe();
      });
    }

    // 2. Selected Room Modal
    const roomModal = document.getElementById('selectedRoomModal');
    const closeRoomModalBtn = document.getElementById('closeSelectedRoomModalBtn');
    const modalRoomTitle = document.getElementById('modalSelectedRoomName');
    const modalRoomImg = document.getElementById('selectedRoomModalImg');

    function openRoomModalSafe(title, photoUrl) {
      if (!roomModal) return;
      if (modalRoomTitle) modalRoomTitle.textContent = title;
      if (modalRoomImg) modalRoomImg.src = photoUrl;
      roomModal.classList.remove('hidden');
      try { history.pushState({ roomModalOpen: true }, ''); } catch (e) {}
    }

    function closeRoomModalSafe() {
      if (!roomModal) return;
      roomModal.classList.add('hidden');
    }

    // Intercept Mobile Back Button
    window.addEventListener('popstate', () => {
      if (amenModal && !amenModal.classList.contains('hidden')) {
        amenModal.classList.add('hidden');
      }
      if (roomModal && !roomModal.classList.contains('hidden')) {
        roomModal.classList.add('hidden');
      }
    });

    if (closeRoomModalBtn) closeRoomModalBtn.addEventListener('click', () => closeRoomModalSafe());
    if (roomModal) {
      roomModal.addEventListener('click', (e) => {
        if (e.target === roomModal) closeRoomModalSafe();
      });
    }

    // 3. Room Card Photo Slider & Details Click
    document.querySelectorAll('.room-card-box').forEach((card) => {
      const img = card.querySelector('.room-card-main-img');
      const prevBtn = card.querySelector('.card-img-prev-btn');
      const nextBtn = card.querySelector('.card-img-next-btn');
      const badge = card.querySelector('.card-img-badge');
      const detailsBtn = card.querySelector('.open-room-detail-btn');

      if (img) {
        const photos = JSON.parse(img.dataset.photos || '[]');
        let currentPhotoIdx = 0;

        function updateCardPhoto(idx) {
          if (!photos.length) return;
          currentPhotoIdx = (idx + photos.length) % photos.length;
          img.src = photos[currentPhotoIdx];
          if (badge) badge.textContent = `${currentPhotoIdx + 1} / ${photos.length}`;
        }

        if (prevBtn) {
          prevBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            updateCardPhoto(currentPhotoIdx - 1);
          });
        }

        if (nextBtn) {
          nextBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            updateCardPhoto(currentPhotoIdx + 1);
          });
        }

        img.addEventListener('click', () => {
          const roomTitle = detailsBtn?.getAttribute('data-room-name') || 'Room Details';
          openRoomModalSafe(roomTitle, photos[currentPhotoIdx] || img.src);
        });

        if (detailsBtn) {
          detailsBtn.addEventListener('click', () => {
            const roomTitle = detailsBtn.getAttribute('data-room-name') || 'Room Details';
            openRoomModalSafe(roomTitle, photos[currentPhotoIdx] || img.src);
          });
        }
      }
    });

    // 4. Room Carousel Track Side Floating Arrows
    const track = document.getElementById('roomsCarouselTrack');
    const prevTrackBtn = document.getElementById('roomPrevBtn');
    const nextTrackBtn = document.getElementById('roomNextBtn');

    if (track && prevTrackBtn && nextTrackBtn) {
      prevTrackBtn.addEventListener('click', () => {
        track.scrollBy({ left: -320, behavior: 'smooth' });
      });

      nextTrackBtn.addEventListener('click', () => {
        track.scrollBy({ left: 320, behavior: 'smooth' });
      });
    }
  });
</script>
