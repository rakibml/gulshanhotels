---
// src/components/hotel/HotelAmenitiesAndRooms.astro
interface Props {
  hotel: any;
}

const { hotel } = Astro.props;
const data = hotel?.data || {};

const hotelTitle = data.title || data.name || "Hotel Details";

// Admin-Safe Data Fetching
const amenitiesList = Array.isArray(data.amenities) ? data.amenities : [];
const categorizedList = Array.isArray(data.categorized_amenities) ? data.categorized_amenities : [];
const roomsList = Array.isArray(data.rooms) ? data.rooms : [];

// Top 9 Amenities for Main Page Grid
const top9Amenities = amenitiesList.slice(0, 9);
const totalAmenitiesCount = categorizedList.length > 0
  ? categorizedList.reduce((acc: number, cat: any) => acc + (cat.items?.length || 0), 0)
  : amenitiesList.length;

const showAmenities = amenitiesList.length > 0;
const showRooms = roomsList.length > 0;

// Refined Vector SVG Icons (TripAdvisor Style)
const iconMap: Record<string, string> = {
  pool: `<svg viewBox="0 0 24 24"><path d="M2 17.5C2 17.5 4 15.5 7 15.5C10 15.5 11 17.5 14 17.5C17 17.5 18 15.5 21 15.5C23 15.5 24 16.5 24 16.5V18.5C24 18.5 23 17.5 21 17.5C18 17.5 17 19.5 14 19.5C11 19.5 10 17.5 7 17.5C4 17.5 2 19.5 2 19.5V17.5ZM14.5 11C14.5 12.38 13.38 13.5 12 13.5C10.62 13.5 9.5 12.38 9.5 11C9.5 9.62 10.62 8.5 12 8.5C13.38 8.5 14.5 9.62 14.5 11Z"/></svg>`,
  wifi: `<svg viewBox="0 0 24 24"><path d="M12 21L15.6 16.2C14.6 15.4 13.4 15 12 15C10.6 15 9.4 15.4 8.4 16.2L12 21ZM12 3C7.1 3 2.7 4.9 0 8L3.1 11.5C5.4 9.3 8.5 8 12 8C15.5 8 18.6 9.3 20.9 11.5L24 8C21.3 4.9 16.9 3 12 3ZM12 9C9 9 6.2 10.1 4.1 12L7.2 15.5C8.6 14.6 10.2 14 12 14C13.8 14 15.4 14.6 16.8 15.5L19.9 12C17.8 10.1 15 9 12 9Z"/></svg>`,
  gym: `<svg viewBox="0 0 24 24"><path d="M20.57 14.86L22 13.43 20.57 12 17 15.57 8.43 7 12 3.43 10.57 2 9.14 3.43 7.71 2 6.29 3.43 7.71 4.86 3.43 9.14 2 7.71 0.57 0.57 9.14 2 10.57 0.57 12 2 13.43 3.43 12 12 20.57 15.57 17 17 18.43 18.43 17 17 15.57 20.57 12z"/></svg>`,
  restaurant: `<svg viewBox="0 0 24 24"><path d="M11 9H9V2H7v7H5V2H3v7c0 2.12 1.55 3.87 3.56 4.17L6 22h2l-.56-8.83C9.45 12.87 11 11.12 11 9zm9-7h-2c-1.1 0-2 .9-2 2v7h2v13h2V2z"/></svg>`,
  parking: `<svg viewBox="0 0 24 24"><path d="M13.2 11H10V7h3.2c1.1 0 2 .9-2 2s-.9 2-2 2zM19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-5.8 10H10v4H8V5h5.2c2.2 0 4 1.8 4 4s-1.8 4-4 4z"/></svg>`,
  ac: `<svg viewBox="0 0 24 24"><path d="M19 3H5c-1.1 0-2 .9-2 2v8c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 10H5V5h14v14z"/></svg>`,
  checkmark: `<svg viewBox="0 0 24 24"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>`
};
---

<section id="amenities-rooms" class="bg-[#F8FAF9] py-16 px-4 sm:px-8 max-w-[1450px] mx-auto border-b border-slate-200 font-['Plus_Jakarta_Sans',sans-serif]">
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
    
    <!-- LEFT: AMENITIES (TripAdvisor Style) -->
    {showAmenities && (
      <div class="lg:col-span-5 space-y-8">
        <div class="border-b border-slate-100 pb-4">
          <h2 class="text-2xl sm:text-[28px] font-[800] text-[#00224f] tracking-tight leading-none">
            Property amenities
          </h2>
          <p class="text-[13px] text-slate-500 font-medium mt-2">Discover the top features of {hotelTitle}</p>
        </div>

        <div class="grid grid-cols-3 gap-3">
          {top9Amenities.map((item: any) => {
            const name = typeof item === 'string' ? item : (item.name || 'Feature');
            const iconKey = typeof item === 'object' ? item.icon : 'checkmark';
            return (
              <div class="flex flex-col items-center justify-center p-4 rounded-2xl bg-white border border-slate-200 hover:border-emerald-200 hover:shadow-md transition-all duration-300 group cursor-default">
                <div class="w-10 h-10 rounded-full bg-slate-50 flex items-center justify-center text-[#008234] group-hover:bg-emerald-50 transition-colors duration-300 p-2.5 [&_svg]:w-full [&_svg]:h-full [&_svg]:fill-current">
                   <Fragment set:html={iconMap[iconKey] || iconMap.checkmark} />
                </div>
                <span class="text-[11px] font-[700] text-slate-700 mt-2.5 tracking-tight text-center line-clamp-1 uppercase">{name}</span>
              </div>
            );
          })}
        </div>

        <button id="openAmenitiesModalBtn" class="w-full sm:w-auto bg-white hover:bg-slate-50 text-[#00224f] font-[800] text-xs uppercase tracking-widest px-8 py-3.5 rounded-xl border-2 border-slate-200 transition-all shadow-sm active:scale-95 cursor-pointer">
          See all amenities ({totalAmenitiesCount})
        </button>
      </div>
    )}

    <!-- RIGHT: ROOM TYPES (Agoda Style) -->
    {showRooms && (
      <div class="lg:col-span-7 space-y-6">
        <div class="flex flex-col sm:flex-row justify-between items-start sm:items-end border-b border-slate-100 pb-4 gap-4">
          <div class="space-y-1">
            <h2 class="text-2xl sm:text-[28px] font-[800] text-[#00224f] tracking-tight leading-none">Choose your room</h2>
            <p class="text-[13px] text-slate-500 font-medium">Available room types at {hotelTitle}</p>
          </div>
          
          <div class="flex gap-2">
            <button id="roomPrevBtn" class="w-10 h-10 rounded-full bg-white border border-slate-200 flex items-center justify-center hover:bg-slate-50 transition shadow-sm cursor-pointer">❮</button>
            <button id="roomNextBtn" class="w-10 h-10 rounded-full bg-white border border-slate-200 flex items-center justify-center hover:bg-slate-50 transition shadow-sm cursor-pointer">❯</button>
          </div>
        </div>

        <div id="roomsCarouselTrack" class="flex gap-5 overflow-x-auto scroll-smooth pb-4 no-scrollbar">
          {roomsList.map((room: any, index: number) => (
            <div class="w-[280px] sm:w-[340px] shrink-0 bg-white rounded-3xl border border-slate-200 overflow-hidden shadow-sm hover:shadow-xl transition-all duration-500 group flex flex-col justify-between">
              <div>
                <!-- Room Image -->
                <div class="h-48 w-full overflow-hidden relative">
                  <img src={room.image || 'https://images.unsplash.com/photo-1618773928121-c32242e63f39?w=600'} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" alt={room.name} />
                  <div class="absolute inset-0 bg-gradient-to-t from-black/20 to-transparent"></div>
                </div>

                <!-- Room Info -->
                <div class="p-6 space-y-4">
                  <h3 class="font-[800] text-slate-900 text-lg leading-tight group-hover:text-[#006ce4] transition-colors">{room.name}</h3>
                  
                  <!-- Specs Bar -->
                  <div class="flex flex-wrap gap-2">
                    {room.size && <span class="bg-slate-100 text-[10px] font-bold px-2 py-1 rounded text-slate-500 uppercase">{room.size}</span>}
                    {room.guests && <span class="bg-slate-100 text-[10px] font-bold px-2 py-1 rounded text-slate-500 uppercase">{room.guests} Guests</span>}
                  </div>

                  <!-- Quick Checklist -->
                  <div class="grid grid-cols-2 gap-2 pt-2">
                    {room.checklist?.slice(0, 4).map((item: any) => (
                      <div class="flex items-center gap-1.5 text-[11px] font-semibold text-slate-600">
                        <svg class="w-3.5 h-3.5 text-[#008234]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M5 13l4 4L19 7" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg>
                        <span class="truncate">{typeof item === 'string' ? item : item.name}</span>
                      </div>
                    ))}
                  </div>
                </div>
              </div>

              <!-- Price & Action -->
              <div class="p-6 pt-0 mt-auto">
                <div class="flex items-center justify-between border-t border-slate-50 pt-4">
                  <div class="flex flex-col">
                    <span class="text-[10px] text-slate-400 font-bold uppercase">Starting from</span>
                    <span class="text-xl font-black text-[#008234]">{room.price || 'N/A'}</span>
                  </div>
                  <button class="bg-[#003580] hover:bg-[#00224f] text-white font-[800] text-[10px] uppercase px-4 py-3 rounded-xl transition-all active:scale-95 shadow-md">
                    Choose Room
                  </button>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    )}
  </div>
</section>

<!-- Popups (Amenities & Room Details) - Logic Remains Same but Styled Cleaner -->
<!-- ... [Modal HTML from your original code but apply Plus Jakarta Sans and Emerald Colors] ... -->

<style>
  .no-scrollbar::-webkit-scrollbar { display: none; }
  .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
  
  h2, h3 {
    letter-spacing: -0.03em !important;
  }
</style>

<script is:inline>
  // আপনার স্লাইডার এবং মোডাল লজিক এখানে হুবহু থাকবে
  // শুধুমাত্র UI এলিমেন্টগুলোর ক্লাস আপডেট করে দেওয়া হয়েছে
</script>
