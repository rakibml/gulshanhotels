---
// src/components/hotel/HotelMasterSchema.astro
// 100% Google Schema Compliant, Zero Fake Data, Synced Reviews & Safe Pricing
interface Props {
  hotel: any;
}

const { hotel } = Astro.props;
const data = hotel?.data || {};

const SITE_ORIGIN = "https://gulshanhotels.com";
const HOTELS_LIST_PATH = ""; // যেমন: "/hotels" (যদি থাকে)

const str = (v: any): string => (v === null || v === undefined ? "" : String(v).trim());

function cleanText(raw: any): string {
  return str(raw)
    .replace(/<[^>]*>/g, " ")
    .replace(/&nbsp;/gi, " ")
    .replace(/&amp;/gi, "&")
    .replace(/!\[[^\]]*\]\([^)]*\)/g, "")
    .replace(/\[([^\]]+)\]\([^)]*\)/g, "$1")
    .replace(/^#{1,6}\s*/gm, "")
    .replace(/[*`_~]/g, "")
    .replace(/\s+/g, " ")
    .trim();
}

function truncate(text: string, max = 300): string {
  if (text.length <= max) return text;
  const cut = text.slice(0, max);
  const lastSpace = cut.lastIndexOf(" ");
  return (lastSpace > 150 ? cut.slice(0, lastSpace) : cut).trim() + "...";
}

// ১. ফিক্সড ইমেজ হেল্পার (photo, image, url, src সবই সাপোর্ট করবে)
function toAbsoluteImageUrl(url: any): string {
  const clean = str(typeof url === "string" ? url : url?.photo || url?.image || url?.src || url?.url);
  if (!clean || clean.includes("example-test.site")) return "";
  if (/^https?:\/\//i.test(clean)) return clean;
  return `${SITE_ORIGIN}${clean.startsWith("/") ? "" : "/"}${clean}`;
}

function toIsoDate(dStr: any): string | null {
  const raw = str(dStr);
  if (!raw || raw.toLowerCase().includes("recent")) return null;
  const cleanStr = raw.replace(" at ", " ");
  const parsed = new Date(cleanStr);
  if (!isNaN(parsed.getTime()) && parsed.getTime() <= Date.now()) {
    return parsed.toISOString().split("T")[0];
  }
  const match = raw.match(/^(\d{4}-\d{2}-\d{2})/);
  return match ? match[1] : null;
}

function formatTime(tStr: any): string {
  const m = str(tStr).match(/^(\d{1,2})(?::(\d{2}))?\s*(am|pm)?$/i);
  if (!m) return "";
  let h = Number(m[1]);
  const min = Number(m[2] || 0);
  const ap = (m[3] || "").toLowerCase();
  if (ap === "pm" && h < 12) h += 12;
  if (ap === "am" && h === 12) h = 0;
  if (h > 23 || min > 59) return "";
  return `${String(h).padStart(2, "0")}:${String(min).padStart(2, "0")}`;
}

// ২. গুগল-কমপ্লায়েন্ট নিরাপদ প্রাইসরেঞ্জ হেল্পার
function getSafePriceRange(rawPrice: any, fallbackCurrency = "৳"): string {
  const pStr = str(rawPrice);
  if (!pStr) return "";

  // "Check rates", "N/A" জাতীয় টেক্সট গুগলে পাঠানো নিষেধ
  if (/check\s*rates|contact|call|inquire/i.test(pStr)) {
    return "";
  }

  // ১০০ অক্ষরের নিচে রাখা (গুগল স্পেসিফিকেশন)
  const clean = pStr.slice(0, 80).trim();

  // কারেন্সি চিহ্ন নিশ্চিত করা
  if (/^\d/.test(clean)) {
    return `${fallbackCurrency}${clean}`;
  }

  return clean;
}

// ================= বেসিক ইনফো =================
const hotelTitle = str(data.title || data.name);
const rawSlug = str(data.slug || hotel?.slug || hotel?.id);
const hotelSlug = rawSlug.replace(/\.(md|mdx)$/, "").split("/").pop()?.toLowerCase() || "";
const pageUrl = new URL(Astro.url.pathname, SITE_ORIGIN).href;

const hotelDescription = truncate(cleanText(hotel?.body || data.description || data.overview || data.about));
const hotelPhone = str(data.phone || data.telephone || data.contact_phone);

// অফিসিয়াল সাইট ভ্যালিডেশন (সিনট্যাক্স এরর মুক্ত)
const rawOfficialSite = str(data.officialSite || data.official_site_url);
const isValidOfficialSite =
  /^https?:\/\//i.test(rawOfficialSite) &&
  !rawOfficialSite.includes("youtube.com") &&
  !rawOfficialSite.includes("youtu.be/");

// ================= গ্যালারি ছবি =================
const rawGalleryItems: any[] = Array.isArray(data.gallery) && data.gallery.length > 0
  ? data.gallery.filter(Boolean)
  : (data.image ? [data.image] : []);
const images = Array.from(new Set(rawGalleryItems.map(toAbsoluteImageUrl).filter(Boolean))).slice(0, 10);

// ================= রিভিউ (হেডার ও রিভিউ কম্পোনেন্টের সাথে পুরোপুরি সিঙ্কড) =================
let allReviewsList: any[] = [];
try {
  const globReviews = import.meta.glob("/src/content/reviews/*.{md,mdx}", { eager: true });
  allReviewsList = Object.values(globReviews).map((item: any) => item?.frontmatter || item?.data || item || {});
} catch {
  allReviewsList = [];
}

const searchTitle = hotelTitle.toLowerCase();
const searchSlug = hotelSlug;

const approvedReviews = allReviewsList.filter((item: any) => {
  if (!item) return false;
  const isApproved = item.approved === true || str(item.approved).toLowerCase() === "true";
  if (!isApproved) return false;

  const rSlug = str(item.slug || item.hotelSlug || item.hotel_slug).replace(/\.(md|mdx)$/, "").split("/").pop()?.toLowerCase() || "";
  const rId = str(item.id).replace(/\.(md|mdx)$/, "").split("/").pop()?.toLowerCase() || "";
  const rHotel = str(item.hotel || item.hotelTitle || item.hotel_name).toLowerCase();

  return (
    (searchSlug !== "" && (rSlug === searchSlug || rId === searchSlug || rHotel === searchSlug)) ||
    (searchTitle !== "" && rHotel === searchTitle)
  );
});

const embeddedRevs = (Array.isArray(data.reviews) ? data.reviews : []).filter((r: any) => {
  return r && (r.approved === undefined || r.approved === true || str(r.approved).toLowerCase() === "true");
});

const seenReviews = new Set<string>();
const validReviews = [...approvedReviews, ...embeddedRevs]
  .map((r: any) => ({
    author: str(r?.name || r?.author) || "Guest",
    body: cleanText(r?.comment || r?.review || r?.body),
    rating: Number(r?.rating),
    date: toIsoDate(r?.date),
  }))
  .filter((r) => Number.isFinite(r.rating) && r.rating >= 1 && r.rating <= 5 && r.body.length >= 10)
  .filter((r) => {
    const key = `${r.author}|${r.body}`;
    if (seenReviews.has(key)) return false;
    seenReviews.add(key);
    return true;
  });

const reviewCount = validReviews.length;
const ratingValue = reviewCount > 0
  ? Number((validReviews.reduce((sum, r) => sum + r.rating, 0) / reviewCount).toFixed(1))
  : null;

// ================= অ্যামেনিটিস =================
function extractName(item: any): string {
  if (typeof item === "string") return item.trim();
  if (item && typeof item === "object") {
    const n = item.name || item.title || item.label;
    return typeof n === "string" ? n.trim() : "";
  }
  return "";
}

const amenityNames: string[] = [];
(Array.isArray(data.amenities) ? data.amenities : []).forEach((item: any) => {
  const n = extractName(item);
  if (n) amenityNames.push(n);
});
(Array.isArray(data.categorized_amenities) ? data.categorized_amenities : []).forEach((cat: any) => {
  if (Array.isArray(cat?.items)) {
    cat.items.forEach((sub: any) => {
      const n = extractName(sub);
      if (n) amenityNames.push(n);
    });
  }
});
const uniqueAmenities = Array.from(new Set(amenityNames));

// ================= রুম ও জিও =================
const roomsList = (Array.isArray(data.rooms) ? data.rooms : [])
  .map((room: any) => ({
    name: str(typeof room === "string" ? room : room?.name),
    price: typeof room === "object" ? str(room?.price) : "",
    bed: typeof room === "object" ? str(room?.bed) : "",
  }))
  .filter((r: any) => r.name);

const checkIn = formatTime(data.checkIn || data.check_in);
const checkOut = formatTime(data.checkOut || data.check_out);

const latNum = Number(data.latitude ?? data.lat ?? data.geo?.lat);
const lngNum = Number(data.longitude ?? data.lng ?? data.geo?.lng);
const hasGeo =
  Number.isFinite(latNum) && Number.isFinite(lngNum) &&
  Math.abs(latNum) <= 90 && Math.abs(lngNum) <= 180 &&
  !(latNum === 0 && lngNum === 0);

// ================= স্কিমা নোডস (পেনাল্টি প্রটেক্টেড) =================
const hotelId = `${pageUrl}#hotel`;

const hotelNode: any = {
  "@type": "Hotel",
  "@id": hotelId,
  name: hotelTitle,
  url: isValidOfficialSite ? rawOfficialSite : pageUrl,
};

if (hotelDescription) hotelNode.description = hotelDescription;
if (images.length > 0) hotelNode.image = images;
if (hotelPhone) hotelNode.telephone = hotelPhone;

// নিরাপদ প্রাইসরেঞ্জ
const safePriceRange = getSafePriceRange(data.price);
if (safePriceRange) hotelNode.priceRange = safePriceRange;

if (checkIn) hotelNode.checkinTime = checkIn;
if (checkOut) hotelNode.checkoutTime = checkOut;
if (isValidOfficialSite) hotelNode.sameAs = [rawOfficialSite];

// অ্যাড্রেস
const streetAddress = str(data.address || data.location);
const locality = str(data.locality || data.area || "Gulshan");
const region = str(data.region || data.state || "Dhaka");
const postalCode = str(data.postal_code || data.postalCode || data.zip);

if (streetAddress || locality) {
  hotelNode.address = {
    "@type": "PostalAddress",
    streetAddress: streetAddress || locality,
    addressLocality: locality,
    addressRegion: region,
    ...(postalCode ? { postalCode } : {}),
    addressCountry: "BD",
  };
}

if (hasGeo) {
  hotelNode.geo = {
    "@type": "GeoCoordinates",
    latitude: latNum,
    longitude: lngNum,
  };
}

// অ্যাগ্রিগেট রেটিং ও রিভিউ
if (reviewCount > 0 && ratingValue !== null) {
  hotelNode.aggregateRating = {
    "@type": "AggregateRating",
    ratingValue,
    reviewCount,
    bestRating: 5,
    worstRating: 1,
  };

  hotelNode.review = validReviews.slice(0, 5).map((r) => {
    const rev: any = {
      "@type": "Review",
      author: { "@type": "Person", name: r.author },
      reviewBody: r.body,
      reviewRating: {
        "@type": "Rating",
        ratingValue: r.rating,
        bestRating: 5,
        worstRating: 1,
      },
    };
    if (r.date) rev.datePublished = r.date;
    return rev;
  });
}

if (uniqueAmenities.length > 0) {
  hotelNode.amenityFeature = uniqueAmenities.map((name) => ({
    "@type": "LocationFeatureSpecification",
    name,
    value: true,
  }));
}

if (roomsList.length > 0) {
  hotelNode.containsPlace = roomsList.map((room: any) => ({
    "@type": "HotelRoom",
    name: room.name,
    ...(room.bed ? { bed: room.bed } : {}),
    ...(room.price ? { description: `Starting from ${room.price}` } : {}),
  }));
}

// ব্রেডক্রাম্ব
const crumbs: { name: string; item: string }[] = [{ name: "Home", item: `${SITE_ORIGIN}/` }];
if (HOTELS_LIST_PATH) {
  crumbs.push({ name: "Hotels in Gulshan", item: `${SITE_ORIGIN}${HOTELS_LIST_PATH}` });
}
crumbs.push({ name: hotelTitle, item: pageUrl });

// ওয়েবপেজ নোড (গুগলকে স্পষ্ট করে যে এটি ডিরেক্টরি পেজ)
const webPageNode: any = {
  "@type": "WebPage",
  "@id": pageUrl,
  url: pageUrl,
  name: `${hotelTitle} - Overview, Rates & Reviews`,
  mainEntity: { "@id": hotelId },
};

const graph: any[] = [
  {
    "@type": "BreadcrumbList",
    "@id": `${pageUrl}#breadcrumb`,
    itemListElement: crumbs.map((c, i) => ({
      "@type": "ListItem",
      position: i + 1,
      name: c.name,
      item: c.item,
    })),
  },
  webPageNode,
  hotelNode,
];

const jsonLd = hotelTitle
  ? JSON.stringify({ "@context": "https://schema.org", "@graph": graph }).replace(/</g, "\\u003c")
  : "";
---

{jsonLd && <script type="application/ld+json" set:html={jsonLd} />}
