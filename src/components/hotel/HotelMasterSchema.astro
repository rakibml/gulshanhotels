---
// src/components/hotel/HotelMasterSchema.astro
// 100% Google Search Central & Schema.org Compliant (Hotel / LodgingBusiness)
interface Props {
  hotel: any;
}

const { hotel } = Astro.props;
const data = hotel?.data || {};

const SITE_ORIGIN = "https://gulshanhotels.com";

// ================= ১. ক্লিনআপ ও স্মার্ট টেক্সট হেল্পার =================
const str = (v: any): string => (v === null || v === undefined ? "" : String(v).trim());

function cleanText(raw: any): string {
  return str(raw)
    .replace(/<[^>]*>/g, " ")
    .replace(/&nbsp;/gi, " ")
    .replace(/&amp;/gi, "&")
    .replace(/!\[[^\]]*\]\([^)]*\)/g, "")
    .replace(/\[([^\]]+)\]\([^)]*\)/g, "$1")
    .replace(/^#{1,6}\s*/gm, "")
    .replace(/[*`_~]/g, "")
    .replace(/\s+/g, " ")
    .trim();
}

function truncate(text: string, max = 300): string {
  if (text.length <= max) return text;
  const cut = text.slice(0, max);
  const lastSpace = cut.lastIndexOf(" ");
  return (lastSpace > 150 ? cut.slice(0, lastSpace) : cut).trim() + "...";
}

// কাটা বাক্য রোধে প্রথম সম্পূর্ণ প্যারাগ্রাফ নেওয়ার ফাংশন
function getCompleteSnippetDescription(rawBody: any, fallbackDesc: any): string {
  const fallback = cleanText(fallbackDesc);
  if (fallback && fallback.length >= 60 && fallback.length <= 350) {
    return fallback;
  }

  const raw = str(rawBody);
  if (!raw) return fallback ? truncate(fallback, 280) : "";

  const paragraphs = raw.split(/\r?\n\r?\n|\r?\n/).map(cleanText).filter(p => p.length >= 60);

  if (paragraphs.length > 0) {
    const firstP = paragraphs[0];
    if (firstP.length <= 350) {
      return firstP;
    }
    return truncate(firstP, 300);
  }

  return truncate(cleanText(raw), 280);
}

function toAbsoluteImageUrl(url: any): string {
  const clean = str(typeof url === "string" ? url : url?.photo || url?.image || url?.src || url?.url);
  if (!clean || clean.includes("example-test.site")) return "";
  if (/^https?:\/\//i.test(clean)) return clean;
  return `${SITE_ORIGIN}${clean.startsWith("/") ? "" : "/"}${clean}`;
}

// 🔥 ফিক্সড টাইম এক্সট্রাক্টর: আগে ১২-ঘণ্টা (AM/PM), তারপর ২৪-ঘণ্টা ফরম্যাট চেক করবে 🔥
function formatTime(tStr: any): string {
  const clean = str(tStr);
  if (!clean || /available\s*24/i.test(clean)) return "";

  // ১. আগে ১২ ঘণ্টার ফরম্যাট খোঁজা (যেমন: "2:00 PM" -> "14:00")
  const match12 = clean.match(/\b(\d{1,2}):([0-5]\d)\s*(am|pm)\b/i);
  if (match12) {
    let h = parseInt(match12[1], 10);
    const m = match12[2];
    const meridiem = match12[3].toLowerCase();
    if (meridiem === "pm" && h < 12) h += 12;
    if (meridiem === "am" && h === 12) h = 0;
    return `${String(h).padStart(2, "0")}:${m}`;
  }

  // ২. তারপর ২৪ ঘণ্টার ফরম্যাট খোঁজা (যেমন: "14:00")
  const match24 = clean.match(/\b([01]?\d|2[0-3]):([0-5]\d)(?::([0-5]\d))?\b/);
  if (match24) {
    return `${match24[1].padStart(2, "0")}:${match24[2]}`;
  }

  return "";
}

// গুগলের অফিশিয়াল প্রাইস টায়ার হেল্পার ($$$$)
function getSafePriceRange(rawCategory: any, rawPrice: any): string {
  const cat = str(rawCategory).toLowerCase();
  const pStr = str(rawPrice);

  if (pStr.includes("-") && !/check\s*rates|contact|call|inquire/i.test(pStr)) {
    return pStr.slice(0, 50).trim();
  }

  if (cat.includes("5") || cat.includes("luxury")) {
    return "$$$$";
  } else if (cat.includes("4") || cat.includes("executive") || cat.includes("upscale")) {
    return "$$$";
  } else if (cat.includes("3") || cat.includes("boutique")) {
    return "$$";
  } else if (cat.includes("budget") || cat.includes("guest")) {
    return "$";
  }

  return "$$$$";
}

// ================= ২. বেসিক পেজ ও হোটেল আইডেন্টিফায়ার =================
const hotelTitle = str(data.title || data.name);
const rawSlug = str(data.slug || hotel?.slug || hotel?.id);
const hotelSlug = rawSlug.replace(/\.(md|mdx)$/, "").split("/").pop()?.toLowerCase() || "";

// ট্রেইলিং স্ল্যাশসহ ক্যানোনিকাল URL
const pageUrl = `${SITE_ORIGIN}/${hotelSlug}/`;

const hotelDescription = getCompleteSnippetDescription(hotel?.body, data.description || data.overview || data.about);
const hotelPhone = str(data.phone || data.telephone || data.contact_phone);

const rawOfficialSite = str(data.officialSite || data.official_site_url);
const isValidOfficialSite =
  /^https?:\/\//i.test(rawOfficialSite) &&
  !rawOfficialSite.includes("youtube.com") &&
  !rawOfficialSite.includes("youtu.be/");

// ================= ৩. গ্যালারি ইমেজ অ্যারে =================
const rawGalleryItems: any[] = Array.isArray(data.gallery) && data.gallery.length > 0
  ? data.gallery.filter(Boolean)
  : (data.image ? [data.image] : []);
const images = Array.from(new Set(rawGalleryItems.map(toAbsoluteImageUrl).filter(Boolean))).slice(0, 10);

// ================= ৪. সুবিধাসমূহ (LocationFeatureSpecification) =================
function extractName(item: any): string {
  if (typeof item === "string") return item.trim();
  if (item && typeof item === "object") {
    const n = item.name || item.title || item.label;
    return typeof n === "string" ? n.trim() : "";
  }
  return "";
}

const amenityNames: string[] = [];
(Array.isArray(data.amenities) ? data.amenities : []).forEach((item: any) => {
  const n = extractName(item);
  if (n) amenityNames.push(n);
});
(Array.isArray(data.categorized_amenities) ? data.categorized_amenities : []).forEach((cat: any) => {
  if (Array.isArray(cat?.items)) {
    cat.items.forEach((sub: any) => {
      const n = extractName(sub);
      if (n) amenityNames.push(n);
    });
  }
});
const uniqueAmenities = Array.from(new Set(amenityNames));

// ================= ৫. রুম, সময় ও জিও কোঅর্ডিনেট =================
const roomsList = (Array.isArray(data.rooms) ? data.rooms : [])
  .map((room: any) => ({
    name: str(typeof room === "string" ? room : room?.name),
    bed: typeof room === "object" ? str(room?.bed) : "",
  }))
  .filter((r: any) => r.name);

const checkIn = formatTime(data.check_in || data.checkIn);
const checkOut = formatTime(data.check_out || data.checkOut);

const latNum = Number(data.latitude ?? data.lat ?? data.geo?.lat);
const lngNum = Number(data.longitude ?? data.lng ?? data.geo?.lng);
const hasGeo =
  Number.isFinite(latNum) && Number.isFinite(lngNum) &&
  Math.abs(latNum) <= 90 && Math.abs(lngNum) <= 180 &&
  !(latNum === 0 && lngNum === 0);

// ================= ৬. অ্যাড্রেস অবজেক্ট =================
const rawLocation = str(data.location || data.address);
let streetAddress = str(data.street_address || data.streetAddress || data.address || rawLocation);
let locality = str(data.locality || data.area);
let region = str(data.region || data.state);
let postalCode = str(data.postal_code || data.postalCode || data.zip);

if (!postalCode && rawLocation) {
  const pMatch = rawLocation.match(/\b([1-9]\d{3})\b/);
  if (pMatch) postalCode = pMatch[1];
}
if (!locality && rawLocation) {
  const parts = rawLocation.split(',').map((p: string) => p.trim()).filter(Boolean);
  if (parts.length >= 1) locality = parts[0];
  if (!region && parts.length >= 2) {
    const cleanRegion = parts[1].replace(/\b[1-9]\d{3}\b/, '').replace(/bangladesh/i, '').trim();
    if (cleanRegion) region = cleanRegion;
  }
}

// ================= ৭. পূর্ণাঙ্গ নলেজ গ্রাফ গঠন =================
const hotelId = `${pageUrl}#hotel`;
const webpageId = `${pageUrl}#webpage`;
const breadcrumbId = `${pageUrl}#breadcrumb`;

const hotelNode: any = {
  "@type": "Hotel",
  "@id": hotelId,
  "name": hotelTitle,
  "url": pageUrl
};

if (isValidOfficialSite) {
  hotelNode.sameAs = [rawOfficialSite];
}

if (hotelDescription) hotelNode.description = hotelDescription;
if (images.length > 0) hotelNode.image = images;
if (hotelPhone) hotelNode.telephone = hotelPhone;

const safePriceTier = getSafePriceRange(data.category, data.price);
if (safePriceTier) hotelNode.priceRange = safePriceTier;

if (checkIn) hotelNode.checkinTime = checkIn;
if (checkOut) hotelNode.checkoutTime = checkOut;

if (streetAddress || locality || region || postalCode) {
  const addressObj: any = {
    "@type": "PostalAddress",
    "addressCountry": str(data.country || data.country_code) || "BD",
  };
  if (streetAddress) addressObj.streetAddress = streetAddress;
  if (locality) addressObj.addressLocality = locality;
  if (region) addressObj.addressRegion = region;
  if (postalCode) addressObj.postalCode = postalCode;

  hotelNode.address = addressObj;
}

if (hasGeo) {
  hotelNode.geo = {
    "@type": "GeoCoordinates",
    "latitude": latNum,
    "longitude": lngNum,
  };
}

if (uniqueAmenities.length > 0) {
  hotelNode.amenityFeature = uniqueAmenities.map((name) => ({
    "@type": "LocationFeatureSpecification",
    "name": name,
    "value": true,
  }));
}

if (roomsList.length > 0) {
  hotelNode.containsPlace = roomsList.map((room: any) => ({
    "@type": "HotelRoom",
    "name": room.name,
    ...(room.bed ? { "bed": room.bed } : {})
  }));
}

const graph: any[] = [
  {
    "@type": "BreadcrumbList",
    "@id": breadcrumbId,
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": `${SITE_ORIGIN}/`
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": hotelTitle,
        "item": pageUrl
      }
    ]
  },
  {
    "@type": "ItemPage",
    "@id": webpageId,
    "url": pageUrl,
    "name": `${hotelTitle} — Overview, Photos & Room Rates`,
    ...(images.length > 0 ? {
      "primaryImageOfPage": {
        "@type": "ImageObject",
        "@id": `${pageUrl}#primaryimage`,
        "url": images[0],
        "contentUrl": images[0]
      }
    } : {}),
    "isPartOf": {
      "@type": "WebSite",
      "@id": `${SITE_ORIGIN}/#website`,
      "name": "GulshanHotels.com",
      "url": `${SITE_ORIGIN}/`
    },
    "breadcrumb": { "@id": breadcrumbId },
    "mainEntity": { "@id": hotelId }
  },
  hotelNode
];

// XSS-Safe JSON-LD স্ট্রিং তৈরি
const jsonLd = hotelTitle
  ? JSON.stringify({ "@context": "https://schema.org", "@graph": graph })
      .replace(/</g, "\\u003c")
      .replace(/\u2028/g, "\\u2028")
      .replace(/\u2029/g, "\\u2029")
  : "";
---

{jsonLd && <script type="application/ld+json" set:html={jsonLd} />}
