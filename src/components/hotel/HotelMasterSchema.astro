---
// src/components/hotel/HotelMasterSchema.astro (Master Connected Knowledge Graph for Google & AI Engines)
interface Props {
  hotel: any;
}

const { hotel } = Astro.props;
const data = hotel?.data || {};

// ১. বেসিক ডাটা ক্লিনআপ
const hotelTitle = (data.title || data.name || "Hotel Details").trim();
const rawSlug = String(data.slug || hotel?.slug || hotel?.id || "").trim();
const hotelSlug = rawSlug.replace(/\.(md|mdx)$/, '').split('/').pop()?.toLowerCase() || "";

const hotelDescription = data.description || `${hotelTitle} is a premier luxury stay located in Gulshan, Dhaka, offering world-class hospitality, executive suites, and dining.`;
const hotelLocation = data.location || "Gulshan 2, Dhaka 1212, Bangladesh";
const hotelPrice = data.price || "$120";
const officialSite = data.officialSite || data.official_site_url || "";
const hotelCategory = data.category || "Luxury Hotel";

// ডোমেইন ইউআরএল
const siteOrigin = Astro.site ? Astro.site.origin : (Astro.url ? Astro.url.origin : "https://gulshanhotels.com");
const canonicalUrl = `${siteOrigin}/${hotelSlug}`;

// ২. ছবি সংগ্রহ
const rawGallery: string[] = Array.isArray(data.gallery) && data.gallery.length > 0 
  ? data.gallery 
  : (data.image ? [data.image] : ["https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&w=1200&q=80"]);

// ৩. আসল রিভিউ সংগ্রহ (রিয়েল ডাটা ফেচিং)
let allReviewsList: any[] = [];
try {
  const globReviews = import.meta.glob(['/src/content/reviews/*.{md,mdx}', '../../content/reviews/*.{md,mdx}'], { eager: true });
  allReviewsList = Object.values(globReviews).map((item: any) => item?.frontmatter || item?.data || item || {});
} catch (e) {
  allReviewsList = [];
}

const searchTitle = hotelTitle.toLowerCase();
const searchSlug = hotelSlug.toLowerCase();

const approvedReviews = allReviewsList.filter((item: any) => {
  if (!item) return false;
  const isApproved = item.approved === true || String(item.approved).trim().toLowerCase() === 'true';
  if (!isApproved) return false;

  const rSlug = String(item.slug || item.hotelSlug || item.hotel_slug || '').replace(/\.(md|mdx)$/, '').split('/').pop()?.trim().toLowerCase() || "";
  const rId = String(item.id || '').replace(/\.(md|mdx)$/, '').split('/').pop()?.trim().toLowerCase() || "";
  const rHotel = String(item.hotel || item.hotelTitle || item.hotel_name || '').trim().toLowerCase();

  return (searchSlug !== "" && (rSlug === searchSlug || rId === searchSlug || rHotel === searchSlug)) ||
         (searchTitle !== "" && rHotel === searchTitle);
});

const embeddedRevs = Array.isArray(data.reviews) ? data.reviews : [];
const totalRealReviews = [...approvedReviews, ...embeddedRevs];

const reviewCount = totalRealReviews.length;
const ratingValue = reviewCount > 0 
  ? (totalRealReviews.reduce((sum, r) => sum + (Number(r.rating) || 5), 0) / reviewCount).toFixed(1)
  : (data.rating ? Number(data.rating).toFixed(1) : null);

// ৪. অ্যামেনিটিস সংগ্রহ
const amenitiesList: string[] = Array.isArray(data.amenities) ? data.amenities : [];
const categorizedList = Array.isArray(data.categorized_amenities) ? data.categorized_amenities : [];

let flattenedAmenities: string[] = [...amenitiesList];
if (categorizedList.length > 0) {
  categorizedList.forEach((cat: any) => {
    if (Array.isArray(cat.items)) {
      cat.items.forEach((sub: any) => {
        flattenedAmenities.push(typeof sub === 'string' ? sub : (sub?.name || ''));
      });
    }
  });
}
flattenedAmenities = Array.from(new Set(flattenedAmenities.filter(Boolean)));

// ৫. রুম টাইপ সংগ্রহ
const roomsList = Array.isArray(data.rooms) ? data.rooms : [];

// ৬. পলিসি (চেক-ইন / চেক-আউট)
const checkIn = data.checkIn || data.check_in || "14:00";
const checkOut = data.checkOut || data.check_out || "12:00";

// ৭. এফএকিউ (FAQs)
const rawFaqs = Array.isArray(data.faqs) ? data.faqs : [];
const cleanFaqs = rawFaqs.map((faq: any) => ({
  question: typeof faq === 'string' ? faq : (faq?.question || ''),
  answer: typeof faq === 'object' ? String(faq?.answer || '').replace(/<[^>]*>?/gm, '').trim() : ''
})).filter((f: any) => f.question && f.answer);

// ৮. জিপিএস কোঅর্ডিনেট
const lat = data.latitude || data.lat || data.geo?.lat || 23.7925;
const lng = data.longitude || data.lng || data.geo?.lng || 90.4078;

// ================= MASTER JSON-LD KNOWLEDGE GRAPH =================
const masterGraph: any = {
  "@context": "https://schema.org",
  "@graph": [
    // 1. Breadcrumbs
    {
      "@type": "BreadcrumbList",
      "@id": `${canonicalUrl}#breadcrumb`,
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": `${siteOrigin}/`
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Hotels in Gulshan",
          "item": `${siteOrigin}/#hotels`
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": hotelTitle
        }
      ]
    },

    // 2. Hotel / Lodging Entity
    {
      "@type": ["Hotel", "LodgingBusiness"],
      "@id": `${canonicalUrl}#hotel`,
      "name": hotelTitle,
      "description": hotelDescription,
      "url": canonicalUrl,
      "image": rawGallery,
      "priceRange": hotelPrice,
      "currenciesAccepted": "USD, BDT",
      "paymentAccepted": "Cash, Credit Card, bKash",
      "checkinTime": checkIn,
      "checkoutTime": checkOut,
      "petsAllowed": false,
      ...(officialSite ? { "sameAs": [officialSite] } : {}),

      // Address
      "address": {
        "@type": "PostalAddress",
        "streetAddress": hotelLocation,
        "addressLocality": "Gulshan, Dhaka",
        "addressRegion": "Dhaka Division",
        "postalCode": "1212",
        "addressCountry": "BD"
      },

      // Geo Coordinates
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": Number(lat),
        "longitude": Number(lng)
      },

      // Real Reviews & Rating (Only added if real reviews exist)
      ...(ratingValue && reviewCount > 0 ? {
        "aggregateRating": {
          "@type": "AggregateRating",
          "ratingValue": ratingValue,
          "reviewCount": reviewCount,
          "bestRating": "5",
          "worstRating": "1"
        },
        "review": totalRealReviews.slice(0, 5).map((rev: any) => ({
          "@type": "Review",
          "author": {
            "@type": "Person",
            "name": rev.name || rev.author || "Verified Guest"
          },
          "datePublished": rev.date || new Date().toISOString().split('T')[0],
          "reviewBody": String(rev.comment || rev.review || '').trim(),
          "reviewRating": {
            "@type": "Rating",
            "ratingValue": Number(rev.rating) || 5,
            "bestRating": "5",
            "worstRating": "1"
          }
        }))
      } : {}),

      // Amenities (AI & Google Entity Extraction)
      ...(flattenedAmenities.length > 0 ? {
        "amenityFeature": flattenedAmenities.map((amenity: string) => ({
          "@type": "LocationFeatureSpecification",
          "name": amenity,
          "value": true
        }))
      } : {}),

      // Room Types
      ...(roomsList.length > 0 ? {
        "containsPlace": roomsList.map((room: any) => ({
          "@type": "HotelRoom",
          "name": room.name || "Executive Suite",
          "description": room.price ? `Rate starting from ${room.price}` : "Spacious luxury room",
          ...(room.guests ? {
            "occupancy": {
              "@type": "QuantitativeValue",
              "value": room.guests
            }
          } : {}),
          ...(room.bed ? {
            "bed": {
              "@type": "BedDetails",
              "typeOfBed": room.bed
            }
          } : {})
        }))
      } : {})
    },

    // 3. FAQPage Schema (Linked directly into Knowledge Graph)
    ...(cleanFaqs.length > 0 ? [{
      "@type": "FAQPage",
      "@id": `${canonicalUrl}#faq`,
      "isPartOf": { "@id": `${canonicalUrl}#hotel` },
      "mainEntity": cleanFaqs.map((faq: any) => ({
        "@type": "Question",
        "name": faq.question,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": faq.answer
        }
      }))
    }] : [])
  ]
};
---

<!-- MASTER CONNECTED GOOGLE & AI JSON-LD SCHEMA -->
<script type="application/ld+json" set:html={JSON.stringify(masterGraph)} />
