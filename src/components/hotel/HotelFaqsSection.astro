---
// src/components/hotel/HotelFaqsSection.astro (100% Dynamic CMS FAQs - 0ms Forced Reflow Pure CSS Grid Accordion)
interface Props {
  hotel: any;
}

const { hotel } = Astro.props;
const data = hotel?.data || {};

const hotelTitle = data.title || data.name || "Hotel Details";
const sectionTitle = data.faqs_title || `FAQs about ${hotelTitle}`;

// Fetch Dynamic FAQs from CMS (Zero Demo Questions)
const rawFaqs = Array.isArray(data.faqs) ? data.faqs : [];
const showSection = data.enable_faqs !== false && rawFaqs.length > 0;

// Slice Initial Top 4 FAQs for Compact View + Remaining Hidden
const initialTop4 = rawFaqs.slice(0, 4);
const remainingFaqs = rawFaqs.slice(4);

// Dynamic Google FAQPage Schema Script for REAL FAQs ONLY
const faqSchema = showSection ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": rawFaqs.map((item: any) => ({
    "@type": "Question",
    "name": typeof item === 'string' ? item : (item?.question || ''),
    "acceptedAnswer": {
      "@type": "Answer",
      "text": typeof item === 'object' ? (item?.answer || '') : ''
    }
  }))
} : null;
---

<!-- GOOGLE FAQ SCHEMA FOR SEARCH ENGINE RICH SNIPPETS -->
{faqSchema && (
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
)}

<!-- 7TH COMPONENT: FAQS SECTION (RENDERED ONLY IF CMS FAQS EXIST) -->
{showSection && (
  <section id="faqs" class="bg-[#F8FAF9] py-10 px-4 sm:px-8 lg:px-12 max-w-[1550px] mx-auto text-slate-800 border-b border-slate-200/80">
    <div class="space-y-6">
      
      <!-- Section Header -->
      <div class="border-b border-slate-200/80 pb-3 text-left">
        <h2 class="text-2xl sm:text-4xl font-black font-serif text-slate-900">
          {sectionTitle}
        </h2>
        <p class="text-xs text-slate-500 mt-1">Frequently asked questions by guests and travelers</p>
      </div>

      <!-- INITIAL TOP 4 FAQS GRID (PURE CSS GRID ACCORDION - ZERO REFLOW) -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 items-start">
        {initialTop4.map((faq: any) => {
          const qText = typeof faq === 'string' ? faq : (faq?.question || 'Question');
          const aText = typeof faq === 'object' ? (faq?.answer || 'Answer details') : '';

          return (
            <div class="faq-item-wrapper bg-white rounded-2xl border border-slate-200/90 shadow-sm overflow-hidden group transition duration-300">
              <button 
                class="faq-accordion-trigger w-full flex justify-between items-center p-4 sm:p-5 cursor-pointer select-none font-bold text-slate-900 text-xs sm:text-sm hover:text-emerald-800 transition text-left"
                aria-expanded="false"
              >
                <span class="pr-2">{qText}</span>
                <span class="faq-arrow-icon text-slate-400 text-xs shrink-0 transition-transform duration-300">▼</span>
              </button>
              
              <div class="faq-accordion-answer grid grid-rows-[0fr] transition-all duration-300">
                <div class="overflow-hidden">
                  <div class="p-4 sm:p-5 pt-1 text-xs sm:text-sm text-slate-600 border-t border-slate-100 leading-relaxed bg-slate-50/50 text-left">
                    {aText}
                  </div>
                </div>
              </div>
            </div>
          );
        })}
      </div>

      <!-- REMAINING HIDDEN FAQS (EXPANDED ON READ MORE BUTTON CLICK) -->
      {remainingFaqs.length > 0 && (
        <div id="extraFaqsContainer" class="hidden grid grid-cols-1 md:grid-cols-2 gap-4 items-start pt-1">
          {remainingFaqs.map((faq: any) => {
            const qText = typeof faq === 'string' ? faq : (faq?.question || 'Question');
            const aText = typeof faq === 'object' ? (faq?.answer || 'Answer details') : '';

            return (
              <div class="faq-item-wrapper bg-white rounded-2xl border border-slate-200/90 shadow-sm overflow-hidden group transition duration-300">
                <button 
                  class="faq-accordion-trigger w-full flex justify-between items-center p-4 sm:p-5 cursor-pointer select-none font-bold text-slate-900 text-xs sm:text-sm hover:text-emerald-800 transition text-left"
                  aria-expanded="false"
                >
                  <span class="pr-2">{qText}</span>
                  <span class="faq-arrow-icon text-slate-400 text-xs shrink-0 transition-transform duration-300">▼</span>
                </button>

                <div class="faq-accordion-answer grid grid-rows-[0fr] transition-all duration-300">
                  <div class="overflow-hidden">
                    <div class="p-4 sm:p-5 pt-1 text-xs sm:text-sm text-slate-600 border-t border-slate-100 leading-relaxed bg-slate-50/50 text-left">
                      {aText}
                    </div>
                  </div>
                </div>
              </div>
            );
          })}
        </div>
      )}

      <!-- READ MORE FAQS BUTTON -->
      {remainingFaqs.length > 0 && (
        <div class="flex justify-center pt-2">
          <button 
            id="toggleFaqsBtn" 
            class="text-xs font-black uppercase text-emerald-800 tracking-wider bg-emerald-100/70 hover:bg-emerald-200/80 px-6 py-3 rounded-2xl border border-emerald-300/80 transition cursor-pointer flex items-center gap-2 shadow-sm"
          >
            <span id="toggleFaqsText">Read More FAQs ({remainingFaqs.length}+)</span>
            <span id="toggleFaqsArrow">➔</span>
          </button>
        </div>
      )}

    </div>
  </section>
)}

<!-- CLIENT SCRIPT WITH PURE CSS GRID TOGGLE (ZERO REFLOW) -->
<script is:inline>
  const initHotelFaqs = () => {
    // Pure CSS Grid Accordion - 0ms Forced Reflow
    document.querySelectorAll('.faq-accordion-trigger').forEach(trigger => {
      trigger.addEventListener('click', (e) => {
        e.preventDefault();
        const wrapper = trigger.closest('.faq-item-wrapper');
        const answer = wrapper ? wrapper.querySelector('.faq-accordion-answer') : null;
        const arrow = trigger.querySelector('.faq-arrow-icon');

        const isOpen = trigger.getAttribute('aria-expanded') === 'true';

        if (isOpen) {
          trigger.setAttribute('aria-expanded', 'false');
          if (answer) {
            answer.classList.remove('grid-rows-[1fr]');
            answer.classList.add('grid-rows-[0fr]');
          }
          if (arrow) arrow.style.transform = 'rotate(0deg)';
        } else {
          trigger.setAttribute('aria-expanded', 'true');
          if (answer) {
            answer.classList.remove('grid-rows-[0fr]');
            answer.classList.add('grid-rows-[1fr]');
          }
          if (arrow) arrow.style.transform = 'rotate(180deg)';
        }
      });
    });

    // Read More Toggle
    const toggleBtn = document.getElementById('toggleFaqsBtn');
    const container = document.getElementById('extraFaqsContainer');
    const toggleText = document.getElementById('toggleFaqsText');
    const toggleArrow = document.getElementById('toggleFaqsArrow');

    if (toggleBtn && container && toggleText && toggleArrow) {
      if (!toggleBtn.dataset.listenerSet) {
        toggleBtn.dataset.listenerSet = 'true';

        toggleBtn.addEventListener('click', () => {
          const isHidden = container.classList.contains('hidden');
          if (isHidden) {
            container.classList.remove('hidden');
            toggleText.textContent = 'Show Less FAQs';
            toggleArrow.textContent = '▲';
          } else {
            container.classList.add('hidden');
            toggleText.textContent = `Read More FAQs (${container.children.length}+)`;
            toggleArrow.textContent = '➔';
          }
        });
      }
    }
  };

  document.addEventListener('DOMContentLoaded', initHotelFaqs);
  document.addEventListener('astro:page-load', initHotelFaqs);
</script>
