---
// src/components/hotel/HotelFaqsSection.astro
// 100% Dynamic CMS FAQs, SVG Accordion, XSS-Safe, Google FAQPage compliant
interface Props {
  hotel: any;
}

const { hotel } = Astro.props;
const data = hotel?.data || {};

const hotelTitle = String(data.title || data.name || "Hotel Details").trim();
const sectionTitle = data.faqs_title || `FAQs about ${hotelTitle}`;

// HTML tag + entity cleanup (page text ar schema text jate hubohu ek hoy)
const stripHtml = (html: string) =>
  String(html || "")
    .replace(/<[^>]*>/g, " ")
    .replace(/&nbsp;/g, " ")
    .replace(/&amp;/g, "&")
    .replace(/&lt;/g, "<")
    .replace(/&gt;/g, ">")
    .replace(/&quot;/g, '"')
    .replace(/&#39;/g, "'")
    .replace(/\s+/g, " ")
    .trim();

// 1. Shudhu question + answer duto thaka valid FAQ rakha
const rawFaqs = Array.isArray(data.faqs) ? data.faqs : [];
const cleanFaqs = rawFaqs
  .map((item: any) => ({
    question: stripHtml(typeof item === "string" ? item : item?.question || ""),
    answer: stripHtml(typeof item === "object" && item ? item?.answer || "" : ""),
  }))
  .filter((f) => f.question.length > 0 && f.answer.length > 0);

const showSection = data.enable_faqs !== false && cleanFaqs.length > 0;

const VISIBLE_COUNT = 4;
const extraCount = Math.max(cleanFaqs.length - VISIBLE_COUNT, 0);

// 2. Google FAQPage schema (visible content-er sathe 100% match kore)
const faqSchema = showSection
  ? {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      mainEntity: cleanFaqs.map((item) => ({
        "@type": "Question",
        name: item.question,
        acceptedAnswer: {
          "@type": "Answer",
          text: item.answer,
        },
      })),
    }
  : null;

// XSS-safe JSON-LD serialization
const faqJsonLd = faqSchema
  ? JSON.stringify(faqSchema)
      .replace(/</g, "\\u003c")
      .replace(/\u2028/g, "\\u2028")
      .replace(/\u2029/g, "\\u2029")
  : "";
---

{faqJsonLd && <script type="application/ld+json" set:html={faqJsonLd} />}

{showSection && (
  <section
    id="faqs"
    class="bg-white py-12 px-4 sm:px-6 lg:px-0 max-w-7xl mx-auto text-slate-800 border-b border-slate-200 scroll-mt-14 sm:scroll-mt-16"
  >
    <div class="space-y-6">
      <!-- Section Header -->
      <div class="border-b border-slate-200 pb-3 text-left">
        <h2 class="text-2xl sm:text-3xl font-black font-sans text-[#002b11] tracking-tight">
          {sectionTitle}
        </h2>
        <p class="text-xs sm:text-sm text-slate-500 font-medium mt-1">
          Frequently asked questions by guests and travelers
        </p>
      </div>

      <!-- FAQ GRID (prothom 4-ta visible, baki gulo hidden) -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 items-start">
        {cleanFaqs.map((faq, idx) => (
          <div
            class:list={[
              "faq-item-wrapper bg-white rounded-2xl border border-slate-200 shadow-2xs overflow-hidden group transition duration-300",
              idx >= VISIBLE_COUNT && "extra-faq hidden",
            ]}
          >
            <h3 class="m-0">
              <button
                type="button"
                id={`faq-btn-${idx}`}
                aria-controls={`faq-ans-${idx}`}
                aria-expanded="false"
                class="faq-accordion-trigger w-full flex justify-between items-center p-4 sm:p-5 cursor-pointer select-none font-bold text-slate-900 text-xs sm:text-sm hover:text-emerald-800 transition text-left"
              >
                <span class="pr-3 leading-snug">{faq.question}</span>
                <svg
                  aria-hidden="true"
                  class="faq-chevron w-4 h-4 text-slate-400 group-hover:text-emerald-800 transition-transform duration-300 shrink-0"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M6 9l6 6 6-6" />
                </svg>
              </button>
            </h3>

            <div
              id={`faq-ans-${idx}`}
              role="region"
              aria-labelledby={`faq-btn-${idx}`}
              class="faq-accordion-answer grid grid-rows-[0fr] transition-all duration-300"
            >
              <div class="overflow-hidden">
                <div class="p-4 sm:p-5 pt-2 text-xs sm:text-sm text-slate-600 border-t border-slate-100 leading-relaxed bg-slate-50/60 text-left">
                  {faq.answer}
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>

      <!-- READ MORE / LESS BUTTON -->
      {extraCount > 0 && (
        <div class="flex justify-center pt-2">
          <button
            type="button"
            id="toggleFaqsBtn"
            data-count={extraCount}
            aria-expanded="false"
            class="text-xs font-black uppercase text-emerald-800 tracking-wider bg-emerald-50 hover:bg-emerald-100 px-6 py-3 rounded-2xl border border-emerald-300 transition cursor-pointer flex items-center gap-2 shadow-2xs select-none active:scale-95"
          >
            <span id="toggleFaqsText">Read More FAQs (+{extraCount})</span>
            <svg
              aria-hidden="true"
              id="toggleFaqsIcon"
              class="w-3.5 h-3.5 shrink-0 transition-transform duration-300"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M5 12h14M12 5l7 7-7 7" />
            </svg>
          </button>
        </div>
      )}
    </div>
  </section>
)}

<script>
  let faqsAbortCtrl: AbortController | null = null;

  function initHotelFaqs() {
    if (faqsAbortCtrl) faqsAbortCtrl.abort();
    faqsAbortCtrl = new AbortController();
    const { signal } = faqsAbortCtrl;

    // Accordion toggle
    document.querySelectorAll<HTMLButtonElement>(".faq-accordion-trigger").forEach((trigger) => {
      trigger.addEventListener(
        "click",
        (e) => {
          e.preventDefault();
          const wrapper = trigger.closest(".faq-item-wrapper");
          const answer = wrapper?.querySelector(".faq-accordion-answer") as HTMLElement | null;
          const chevron = trigger.querySelector(".faq-chevron") as HTMLElement | null;
          const willOpen = trigger.getAttribute("aria-expanded") !== "true";

          trigger.setAttribute("aria-expanded", String(willOpen));
          if (answer) {
            answer.classList.toggle("grid-rows-[1fr]", willOpen);
            answer.classList.toggle("grid-rows-[0fr]", !willOpen);
          }
          if (chevron) chevron.style.transform = willOpen ? "rotate(180deg)" : "rotate(0deg)";
        },
        { signal }
      );
    });

    // Read More / Show Less toggle
    const toggleBtn = document.getElementById("toggleFaqsBtn");
    const toggleText = document.getElementById("toggleFaqsText");
    const toggleIcon = document.getElementById("toggleFaqsIcon");
    const extraItems = document.querySelectorAll<HTMLElement>(".extra-faq");

    if (toggleBtn && toggleText && toggleIcon && extraItems.length > 0) {
      const remainingCount = toggleBtn.getAttribute("data-count") || String(extraItems.length);

      toggleBtn.addEventListener(
        "click",
        () => {
          const willShow = toggleBtn.getAttribute("aria-expanded") !== "true";

          extraItems.forEach((el) => el.classList.toggle("hidden", !willShow));
          toggleText.textContent = willShow ? "Show Less FAQs" : `Read More FAQs (+${remainingCount})`;
          toggleIcon.style.transform = willShow ? "rotate(-90deg)" : "rotate(0deg)";
          toggleBtn.setAttribute("aria-expanded", String(willShow));
        },
        { signal }
      );
    }
  }

  document.addEventListener("DOMContentLoaded", initHotelFaqs);
  document.addEventListener("astro:page-load", initHotelFaqs);
</script>
