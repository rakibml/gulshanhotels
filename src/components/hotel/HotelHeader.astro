---
// src/components/hotel/HotelHeader.astro (Booking.com Style 5-Photo Mosaic Grid)
interface Props {
  hotel: any;
}

const { hotel } = Astro.props;
const data = hotel?.data || {};

const hotelTitle = data.title || data.name || "Hotel Details";
const hotelCategory = data.category || "5-Star Luxury Stay";
const hotelLocation = data.location || "Main Gulshan Avenue, Gulshan 2, Dhaka 1212, Bangladesh";
const hotelRating = data.rating || "4.8";
const reviewsCount = data.reviewsCount || "1,248";
const hotelImage = data.image || "https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&w=1200&q=80";
const officialSite = data.officialSite || "https://www.agoda.com";

// 5 Main Photos for Booking.com Mosaic Grid
const galleryImages = (data.gallery && data.gallery.length > 0) 
  ? data.gallery 
  : [
      hotelImage,
      "https://images.unsplash.com/photo-1582719478250-c89cae4dc85b?auto=format&fit=crop&w=800&q=80",
      "https://images.unsplash.com/photo-1542314831-068cd1dbfeeb?auto=format&fit=crop&w=800&q=80",
      "https://images.unsplash.com/photo-1571896349842-33c89424de2d?auto=format&fit=crop&w=800&q=80",
      "https://images.unsplash.com/photo-1512917774080-9991f1c4c750?auto=format&fit=crop&w=800&q=80"
    ];

const totalPhotos = galleryImages.length;
---

<!-- BOOKING.COM STYLE 5-PHOTO MOSAIC HEADER (EXACT MATCH TO REFERENCE IMAGE) -->
<section class="bg-white text-slate-900 pt-6 pb-10 px-4 sm:px-8 lg:px-12 max-w-[1550px] mx-auto border-b border-slate-200">
  <div class="space-y-6">
    
    <!-- TOP HEADER & TITLE AREA (CENTERED ELEGANT ALIGNMENT) -->
    <div class="text-center max-w-4xl mx-auto space-y-3">
      
      <!-- Breadcrumbs -->
      <div class="flex items-center justify-center gap-2 text-xs text-slate-500 font-medium">
        <a href="/" class="hover:text-emerald-700 transition">Home</a>
        <span>›</span>
        <a href="/#hotels" class="hover:text-emerald-700 transition">Hotels</a>
        <span>›</span>
        <span class="text-slate-800 font-bold">{hotelTitle}</span>
      </div>

      <!-- Category Pill Badge -->
      <div>
        <span class="bg-emerald-50 text-emerald-800 border border-emerald-200 text-[10px] sm:text-xs font-black uppercase tracking-widest px-3 py-1 rounded-full inline-block">
          {hotelCategory}
        </span>
      </div>

      <!-- Hotel Title -->
      <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black font-serif text-slate-900 tracking-tight leading-tight">
        {hotelTitle}
      </h1>

      <!-- Location Line with Interactive Map Link -->
      <p class="text-xs sm:text-sm text-slate-600 font-medium flex flex-wrap items-center justify-center gap-2">
        <span class="flex items-center gap-1">
          <svg class="w-4 h-4 fill-emerald-600 shrink-0" viewBox="0 0 24 24"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>
          <span>{hotelLocation}</span>
        </span>
        <a href="#location-map" class="text-emerald-800 font-black hover:underline inline-flex items-center gap-0.5">
          <span>View in a map</span>
          <span>➔</span>
        </a>
      </p>

      <!-- Rating Line with Interactive Reviews Link -->
      <div class="flex items-center justify-center gap-2 text-xs sm:text-sm font-bold pt-1">
        <span class="bg-amber-100 text-amber-900 border border-amber-300 font-black px-2 py-0.5 rounded-lg text-xs">
          {hotelRating}
        </span>
        <a href="#guest-reviews" class="text-slate-700 font-black hover:text-emerald-800 hover:underline inline-flex items-center gap-1">
          <span>{reviewsCount} reviews</span>
          <span>➔</span>
        </a>
      </div>

      <!-- Action Buttons -->
      <div class="flex items-center justify-center gap-3 pt-3">
        <a href="#about-and-rates" class="bg-[#0d3b23] hover:bg-[#061e14] text-white font-black text-xs sm:text-sm uppercase tracking-wider px-7 py-3 rounded-2xl shadow-lg transition hover:scale-105">
          View Prices ➔
        </a>

        <a href={officialSite} target="_blank" rel="noopener noreferrer" class="bg-slate-100 hover:bg-slate-200 text-slate-900 font-black text-xs sm:text-sm uppercase tracking-wider px-6 py-3 rounded-2xl transition border border-slate-300 hover:scale-105 flex items-center gap-1.5">
          <span>Official Website</span>
          <span>↗</span>
        </a>
      </div>

    </div>

    <!-- BOOKING.COM ICONIC 5-PHOTO MOSAIC GRID (EXACT MATCH TO REFERENCE IMAGE) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-2.5 sm:gap-3.5 pt-2">
      
      <!-- LEFT BIG MAIN COVER PHOTO (50% WIDTH) -->
      <div class="lg:col-span-6 h-[300px] sm:h-[420px] lg:h-[460px] rounded-2xl sm:rounded-3xl overflow-hidden shadow-md group relative cursor-pointer open-lightbox-trigger" data-index="0">
        <img 
          src={galleryImages[0]} 
          alt={hotelTitle} 
          class="w-full h-full object-cover group-hover:scale-105 transition duration-500" 
        />
        <div class="absolute inset-0 bg-slate-950/20 opacity-0 group-hover:opacity-100 transition flex items-center justify-center text-white text-xs sm:text-sm font-bold backdrop-blur-[1px]">
          🔍 Zoom Photo
        </div>
      </div>

      <!-- RIGHT 4-PHOTO GRID (50% WIDTH - 2x2 GRID) -->
      <div class="lg:col-span-6 grid grid-cols-2 gap-2.5 sm:gap-3.5 h-[300px] sm:h-[420px] lg:h-[460px]">
        
        {galleryImages[1] && (
          <div class="rounded-2xl overflow-hidden shadow-sm border border-slate-200/80 group relative cursor-pointer open-lightbox-trigger" data-index="1">
            <img src={galleryImages[1]} alt={`${hotelTitle} Photo 2`} class="w-full h-full object-cover group-hover:scale-105 transition duration-500" />
          </div>
        )}

        {galleryImages[2] && (
          <div class="rounded-2xl overflow-hidden shadow-sm border border-slate-200/80 group relative cursor-pointer open-lightbox-trigger" data-index="2">
            <img src={galleryImages[2]} alt={`${hotelTitle} Photo 3`} class="w-full h-full object-cover group-hover:scale-105 transition duration-500" />
          </div>
        )}

        {galleryImages[3] && (
          <div class="rounded-2xl overflow-hidden shadow-sm border border-slate-200/80 group relative cursor-pointer open-lightbox-trigger" data-index="3">
            <img src={galleryImages[3]} alt={`${hotelTitle} Photo 4`} class="w-full h-full object-cover group-hover:scale-105 transition duration-500" />
          </div>
        )}

        {galleryImages[4] && (
          <div class="rounded-2xl overflow-hidden shadow-sm border border-slate-200/80 group relative cursor-pointer open-lightbox-trigger" data-index="4">
            <img src={galleryImages[4]} alt={`${hotelTitle} Photo 5`} class="w-full h-full object-cover group-hover:scale-105 transition duration-500" />
            
            <!-- FLOATING PHOTO COUNTER BADGE (MATCHING SCREENSHOT) -->
            <div class="absolute bottom-3 right-3 bg-slate-950/85 backdrop-blur-md text-white text-xs font-bold px-3 py-1.5 rounded-xl shadow-lg border border-white/20 flex items-center gap-1.5">
              <svg class="w-4 h-4 fill-white" viewBox="0 0 24 24"><path d="M21 19V5c0-1.1-.9-2-2-2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2zM8.5 13.5l2.5 3.01L14.5 12l4.5 6H5l3.5-4.5z"/></svg>
              <span>{totalPhotos > 5 ? `${totalPhotos}+` : `${totalPhotos} Photos`}</span>
            </div>
          </div>
        )}

      </div>

    </div>

  </div>
</section>

<!-- FULL SCREEN PHOTO LIGHTBOX MODAL -->
<div id="headerGalleryModal" class="fixed inset-0 z-50 bg-slate-950/90 backdrop-blur-md hidden flex flex-col justify-between p-4 sm:p-8 text-white">
  <div class="flex items-center justify-between max-w-6xl mx-auto w-full border-b border-slate-800 pb-4">
    <div>
      <h3 class="text-lg font-black font-serif text-white">{hotelTitle}</h3>
      <span class="text-xs text-slate-400">Photo Gallery</span>
    </div>
    <div class="flex items-center gap-4">
      <span class="text-xs font-bold bg-slate-800 px-3 py-1 rounded-full border border-slate-700">
        <span id="headerModalIdx">1</span> / <span>{totalPhotos}</span>
      </span>
      <button id="closeHeaderModalBtn" class="text-slate-400 hover:text-white text-3xl font-bold p-1 cursor-pointer">&times;</button>
    </div>
  </div>

  <div class="relative max-w-5xl mx-auto my-auto w-full h-[60vh] sm:h-[70vh] flex items-center justify-center">
    <img id="headerModalImg" src={galleryImages[0]} alt={hotelTitle} class="max-w-full max-h-full object-contain rounded-2xl shadow-2xl" />
    <button id="headerModalPrevBtn" class="absolute left-2 sm:left-4 top-1/2 -translate-y-1/2 w-10 h-10 rounded-full bg-slate-900/80 hover:bg-slate-800 text-white flex items-center justify-center text-lg font-bold shadow-xl transition cursor-pointer">❮</button>
    <button id="headerModalNextBtn" class="absolute right-2 sm:right-4 top-1/2 -translate-y-1/2 w-10 h-10 rounded-full bg-slate-900/80 hover:bg-slate-800 text-white flex items-center justify-center text-lg font-bold shadow-xl transition cursor-pointer">❯</button>
  </div>
</div>

<!-- LIGHTBOX JS SCRIPT -->
<script is:inline define:vars={{ galleryImages }}>
  document.addEventListener('DOMContentLoaded', () => {
    const modal = document.getElementById('headerGalleryModal');
    const closeBtn = document.getElementById('closeHeaderModalBtn');
    const modalImg = document.getElementById('headerModalImg');
    const idxSpan = document.getElementById('headerModalIdx');
    const prevBtn = document.getElementById('headerModalPrevBtn');
    const nextBtn = document.getElementById('headerModalNextBtn');

    const images = galleryImages && galleryImages.length > 0 ? galleryImages : [];
    let activeIdx = 0;

    function showImage(idx) {
      if (!modalImg || images.length === 0) return;
      activeIdx = (idx + images.length) % images.length;
      modalImg.src = images[activeIdx];
      if (idxSpan) idxSpan.textContent = (activeIdx + 1).toString();
    }

    document.querySelectorAll('.open-lightbox-trigger').forEach(item => {
      item.addEventListener('click', (e) => {
        const idx = parseInt(e.currentTarget.getAttribute('data-index') || '0', 10);
        if (modal) modal.classList.remove('hidden');
        showImage(idx);
      });
    });

    if (closeBtn && modal) {
      closeBtn.addEventListener('click', () => modal.classList.add('hidden'));
    }

    if (modal) {
      modal.addEventListener('click', (e) => {
        if (e.target === modal) modal.classList.add('hidden');
      });
    }

    if (prevBtn) prevBtn.addEventListener('click', () => showImage(activeIdx - 1));
    if (nextBtn) nextBtn.addEventListener('click', () => showImage(activeIdx + 1));
  });
</script>
