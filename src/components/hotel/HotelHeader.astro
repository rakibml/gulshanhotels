---
// src/components/hotel/HotelHeader.astro
interface Props {
  hotel: any;
}

const { hotel } = Astro.props;
const data = hotel?.data || {};

const hotelTitle = data.title || data.name || "Hotel Details";
const hotelCategory = data.category || "5-Star Luxury Stay";
const hotelLocation = data.location || "Gulshan 2, Dhaka 1212, Bangladesh";
const hotelImage = data.image || "https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&w=1600&q=80";
const officialSite = data.officialSite || "https://www.agoda.com";
const hotelDescription = data.description || "Experience timeless luxury and exceptional Bangladeshi hospitality in the heart of Gulshan, Dhaka.";
---

<!-- HOTEL HERO & HEADER (MATCHING INPUT_FILE_35.PNG MOBILE APP MOCKUP + DESKTOP ALIGNMENT) -->
<section class="relative bg-[#F8FAF9] text-slate-900 pb-8 border-b border-slate-200">
  
  <!-- HERO PHOTO CONTAINER WITH CURVED BOTTOM (MATCHING MOCKUP) -->
  <div class="relative w-full h-[420px] xs:h-[460px] sm:h-[520px] lg:h-[580px] bg-slate-950 rounded-b-[36px] sm:rounded-b-[48px] overflow-hidden shadow-xl group">
    
    <!-- Hero Cover Photo -->
    <img 
      id="heroCoverImg"
      src={hotelImage} 
      alt={hotelTitle} 
      class="w-full h-full object-cover opacity-90 transition duration-500" 
    />

    <!-- Dark Gradient Overlay for Typography & Buttons -->
    <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/40 to-slate-950/30"></div>

    <!-- TOP FLOATING BUTTONS (BACK, SHARE, FAVORITE) -->
    <div class="absolute top-4 left-4 right-4 z-30 flex justify-between items-center max-w-[1550px] mx-auto">
      <!-- Back Button -->
      <a href="/#all-hotels" title="Back to Hotels" class="w-10 h-10 rounded-full bg-slate-900/60 hover:bg-slate-900 text-white backdrop-blur-md border border-white/20 flex items-center justify-center transition shadow-lg">
        <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24"><path d="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z"/></svg>
      </a>

      <!-- Right Share & Wishlist Floating Buttons -->
      <div class="flex items-center gap-2.5">
        <!-- Share Button -->
        <button id="shareHotelBtn" title="Share Hotel" class="w-10 h-10 rounded-full bg-white/90 hover:bg-white text-slate-900 backdrop-blur-md flex items-center justify-center transition shadow-lg cursor-pointer">
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M18 16.08c-.76 0-1.44.3-1.96.77L8.91 12.7c.05-.23.09-.46.09-.7s-.04-.47-.09-.7l7.05-4.11c.54.5 1.25.81 2.04.81 1.66 0 3-1.34 3-3s-1.34-3-3-3-3 1.34-3 3c0 .24.04.47.09.7L8.04 9.81C7.5 9.31 6.79 9 6 9c-1.66 0-3 1.34-3 3s1.34 3 3 3c.79 0 1.5-.31 2.04-.81l7.12 4.16c-.05.21-.08.43-.08.65 0 1.61 1.31 2.92 2.92 2.92 1.61 0 2.92-1.31 2.92-2.92s-1.31-2.92-2.92-2.92z"/></svg>
        </button>

        <!-- Wishlist Heart Button -->
        <button id="heroWishlistBtn" title="Add to Favorites" class="w-10 h-10 rounded-full bg-white/90 hover:bg-white text-slate-900 backdrop-blur-md flex items-center justify-center transition shadow-lg cursor-pointer">
          <svg class="w-5 h-5 fill-rose-500 stroke-rose-500" viewBox="0 0 24 24"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>
        </button>
      </div>
    </div>

    <!-- HERO TEXT OVERLAY (LEFT BOTTOM OF PHOTO MATCHING MOCKUP) -->
    <div class="absolute bottom-6 left-4 sm:left-8 lg:left-12 right-4 z-20 max-w-[1550px] mx-auto text-left space-y-2 text-white">
      
      <!-- Small Category Badge -->
      <div class="flex items-center gap-2">
        <span class="bg-white/20 border border-white/30 text-white text-[10px] sm:text-xs font-extrabold px-3 py-0.5 rounded-full backdrop-blur-md inline-flex items-center gap-1.5">
          <span>🏠</span>
          <span>{hotelCategory}</span>
        </span>
      </div>

      <!-- Hotel Name Title -->
      <h1 class="text-2xl sm:text-4xl lg:text-5xl font-black font-serif text-white leading-tight tracking-tight drop-shadow-md">
        {hotelTitle}
      </h1>

      <!-- Location Line -->
      <p class="text-xs sm:text-sm text-slate-200 font-medium flex items-center gap-1.5">
        <svg class="w-3.5 h-3.5 fill-amber-400 shrink-0" viewBox="0 0 24 24"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>
        <span>{hotelLocation}</span>
      </p>

      <!-- Pagination Dots Centered At Bottom of Photo -->
      <div class="pt-2 flex justify-center items-center gap-1.5">
        <span class="w-2.5 h-2.5 rounded-full bg-white shadow"></span>
        <span class="w-2 h-2 rounded-full bg-white/50"></span>
        <span class="w-2 h-2 rounded-full bg-white/50"></span>
      </div>

    </div>

  </div>

  <!-- BELOW THE CURVED PHOTO: POPULAR AMENITIES & DESCRIPTION (MATCHING MOCKUP) -->
  <div class="max-w-[1550px] mx-auto px-4 sm:px-8 lg:px-12 pt-6 space-y-6 text-left">
    
    <!-- Popular Amenities Pill Badges Horizontal Scroll -->
    <div class="space-y-2.5">
      <h3 class="text-base sm:text-lg font-black font-serif text-slate-900">
        Popular Amenities
      </h3>

      <div class="flex items-center gap-2.5 overflow-x-auto pb-2 [scrollbar-width:none]">
        <div class="flex items-center gap-2 bg-white border border-slate-200 px-4 py-2 rounded-2xl shadow-sm text-xs font-bold text-slate-800 shrink-0">
          <svg class="w-4 h-4 fill-slate-700" viewBox="0 0 24 24"><path d="M20 9.557V3h-2v2H6V3H4v6.557C2.81 10.25 2 11.525 2 13v8h2v-2h16v2h2v-8c0-1.475-.81-2.75-2-3.443zM18 7v2.05A3.486 3.486 0 0 0 16.5 9c-.83 0-1.58.29-2.18.78A3.47 3.48 0 0 0 12 9c-.83 0-1.58.29-2.18.78A3.486 3.486 0 0 0 8.5 9C7.67 9 6.92 9.29 6.32 9.78V7h11.68z"/></svg>
          <span>2 Beds</span>
        </div>

        <div class="flex items-center gap-2 bg-white border border-slate-200 px-4 py-2 rounded-2xl shadow-sm text-xs font-bold text-slate-800 shrink-0">
          <svg class="w-4 h-4 fill-slate-700" viewBox="0 0 24 24"><path d="M21 3H3c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h5v2h8v-2h5c1.1 0 1.99-.9 1.99-2L23 5c0-1.1-.9-2-2-2zm0 14H3V5h18v12z"/></svg>
          <span>HDTV</span>
        </div>

        <div class="flex items-center gap-2 bg-white border border-slate-200 px-4 py-2 rounded-2xl shadow-sm text-xs font-bold text-slate-800 shrink-0">
          <svg class="w-4 h-4 fill-slate-700" viewBox="0 0 24 24"><path d="M12 3C7.95 3 4.21 4.34 1.2 6.6L3 8.8C5.46 6.81 8.58 5.7 12 5.7c3.42 0 6.54 1.11 9 3.1l1.8-2.2C19.79 4.34 16.05 3 12 3zm0 5c-2.92 0-5.61.96-7.8 2.58l1.8 2.22C7.62 11.53 9.71 10.7 12 10.7c2.29 0 4.38.83 6 2.1l1.8-2.22C17.61 8.96 14.92 8 12 8zm0 5c-1.87 0-3.58.62-4.98 1.67L12 21l4.98-6.33C15.58 13.62 13.87 13 12 13z"/></svg>
          <span>Free wifi</span>
        </div>

        <div class="flex items-center gap-2 bg-white border border-slate-200 px-4 py-2 rounded-2xl shadow-sm text-xs font-bold text-slate-800 shrink-0">
          <svg class="w-4 h-4 fill-slate-700" viewBox="0 0 24 24"><path d="M22 17c-1.1 0-2.12-.3-3-.83-.88.53-1.9.83-3 .83s-2.12-.3-3-.83c-.88.53-1.9.83-3 .83s-2.12-.3-3-.83c-.88.53-1.9.83-3 .83v-2c.67 0 1.3-.19 1.83-.53.88-.53 1.9-.83 3-.83s2.12.3 3 .83c.88.53 1.9.83 3 .83s2.12-.3 3-.83c.88-.53 1.9-.83 3-.83s2.12.3 3 .83c.53.34 1.16.53 1.83.53v2zm0-5c-1.1 0-2.12-.3-3-.83-.88.53-1.9.83-3 .83s-2.12-.3-3-.83c-.88.53-1.9.83-3 .83s-2.12-.3-3-.83c-.88.53-1.9.83-3 .83v-2c.67 0 1.3-.19 1.83-.53.88-.53 1.9-.83 3-.83s2.12.3 3 .83c.88.53 1.9.83 3 .83s2.12-.3 3-.83c.88-.53 1.9-.83 3-.83s2.12.3 3 .83c.53.34 1.16.53 1.83.53v2zM15 7.5a2.5 2.5 0 1 0-5 0 2.5 2.5 0 0 0 5 0z"/></svg>
          <span>Swimming Pool</span>
        </div>
      </div>
    </div>

    <!-- Description Section -->
    <div class="space-y-2 pt-2 border-t border-slate-200/80">
      <h3 class="text-base sm:text-lg font-black font-serif text-slate-900">
        Description
      </h3>

      <p class="text-xs sm:text-sm text-slate-600 leading-relaxed font-normal">
        {hotelTitle} offers luxury stays, stunning city views, fine dining, a spa, and elegant event spaces for unforgettable stays. <a href="#about-and-rates" class="text-emerald-800 font-extrabold hover:underline">See More....</a>
      </p>
    </div>

    <!-- Action Buttons -->
    <div class="flex flex-wrap items-center gap-3 pt-2">
      <a href="#about-and-rates" class="bg-[#0d3b23] hover:bg-[#061e14] text-white font-extrabold text-xs sm:text-sm uppercase tracking-wider px-7 py-3 rounded-2xl shadow-lg transition hover:scale-105">
        View Prices ➔
      </a>

      <a href={officialSite} target="_blank" rel="noopener noreferrer" class="bg-white hover:bg-slate-100 border border-slate-300 text-slate-900 font-extrabold text-xs sm:text-sm uppercase tracking-wider px-6 py-3 rounded-2xl transition shadow-sm flex items-center gap-2">
        <span>Official Website</span>
        <span>↗</span>
      </a>
    </div>

  </div>

</section>

<!-- SHARE SCRIPT FOR MOBILE SHARE BUTTON -->
<script is:inline define:vars={{ hotelTitle }}>
  document.addEventListener('DOMContentLoaded', () => {
    const shareBtn = document.getElementById('shareHotelBtn');
    if (shareBtn) {
      shareBtn.addEventListener('click', async () => {
        if (navigator.share) {
          try {
            await navigator.share({
              title: hotelTitle,
              text: `Check out ${hotelTitle} on GulshanHotels.com`,
              url: window.location.href,
            });
          } catch (e) {
            console.log('Share canceled or error:', e);
          }
        } else {
          navigator.clipboard.writeText(window.location.href);
          alert('Hotel link copied to clipboard!');
        }
      });
    }
  });
</script>
