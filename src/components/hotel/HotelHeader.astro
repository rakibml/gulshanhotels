---
// src/components/hotel/HotelHeader.astro
interface Props {
  hotel: any;
}

const { hotel } = Astro.props;
const data = hotel?.data || {};

const hotelTitle = data.title || data.name || "Hotel Details";
const hotelCategory = data.category || "5-Star Hotel";
const hotelLocation = data.location || "Gulshan 2, Dhaka 1212, Bangladesh";
const hotelImage = data.image || "https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&w=1600&q=80";
const officialSite = data.officialSite || "https://www.agoda.com";
const hotelDescription = data.description || "Experience timeless luxury and exceptional Bangladeshi hospitality in the heart of Gulshan, Dhaka.";
---

<!-- 1ST COMPONENT: HOTEL HERO & HEADER (MATCHING SCREENSHOT PERFECTLY) -->
<section class="relative bg-slate-950 text-white min-h-[550px] sm:min-h-[620px] flex flex-col justify-between overflow-hidden">
  
  <!-- High-Resolution Hotel Exterior Cover Image -->
  <div class="absolute inset-0 w-full h-full pointer-events-none">
    <img 
      src={hotelImage} 
      alt={hotelTitle} 
      class="w-full h-full object-cover opacity-85 scale-105" 
    />
    <!-- Dark Gradient Overlay on Left Side for Typography Readability -->
    <div class="absolute inset-0 bg-gradient-to-r from-slate-950 via-slate-950/80 to-transparent"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-slate-950/90 via-transparent to-slate-950/40"></div>
  </div>

  <!-- TOP NAVIGATION BAR -->
  <header class="relative z-30 w-full border-b border-white/10 bg-transparent py-4 px-4 sm:px-8 lg:px-12">
    <div class="max-w-[1600px] mx-auto flex justify-between items-center">
      
      <!-- Logo -->
      <a href="/" class="flex items-center gap-3 group">
        <div class="w-10 h-10 rounded-xl bg-[#e52429] flex items-center justify-center text-white font-serif font-black text-xl shadow-lg">
          G
        </div>
        <div class="flex flex-col text-left">
          <span class="text-xl sm:text-2xl font-black font-serif tracking-tight text-white leading-none">
            Gulshan<span class="text-[#e52429]">Hotels</span>.com
          </span>
        </div>
      </a>

      <!-- Center Nav Links -->
      <nav class="hidden lg:flex items-center space-x-8 text-xs font-bold tracking-wider uppercase text-slate-100">
        <a href="/#all-hotels" class="hover:text-emerald-400 transition">All Hotels</a>
        <a href="/#all-hotels?zone=gulshan-1" class="hover:text-emerald-400 transition">Gulshan 1</a>
        <a href="/#all-hotels?zone=gulshan-2" class="hover:text-emerald-400 transition">Gulshan 2</a>
        <a href="/#all-hotels?zone=banani" class="hover:text-emerald-400 transition">Banani</a>
        <a href="/about" class="hover:text-emerald-400 transition">About Us</a>
        <a href="/about" class="hover:text-emerald-400 transition">Blog</a>
      </nav>

      <!-- Right Favorites Button -->
      <div class="flex items-center space-x-4">
        <button id="open-wishlist-btn" class="text-slate-200 hover:text-rose-500 transition flex items-center gap-1.5 text-xs font-bold bg-white/10 hover:bg-white/20 px-3.5 py-2 rounded-full backdrop-blur-md cursor-pointer border border-white/15">
          <span class="text-rose-500 text-sm">♡</span>
          <span>Favorites</span>
        </button>
      </div>

    </div>
  </header>

  <!-- MAIN HERO TEXT OVERLAY (LEFT SIDE CONTENT) -->
  <div class="relative z-20 max-w-[1600px] mx-auto px-4 sm:px-8 lg:px-12 w-full my-auto py-12 space-y-5">
    <div class="max-w-2xl space-y-4 text-left">
      
      <!-- Breadcrumbs -->
      <div class="flex items-center gap-2 text-xs text-slate-300">
        <a href="/" class="hover:text-emerald-400 transition">Home</a>
        <span>›</span>
        <a href="/#all-hotels" class="hover:text-emerald-400 transition">Hotels</a>
        <span>›</span>
        <span class="text-white font-bold">{hotelTitle}</span>
      </div>

      <!-- Category Pill Badge -->
      <div>
        <span class="bg-white/10 border border-white/20 text-slate-200 text-[11px] font-bold px-3.5 py-1 rounded-full backdrop-blur-md inline-block">
          {hotelCategory}
        </span>
      </div>

      <!-- Main Hotel Name Title -->
      <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black text-white font-serif leading-tight tracking-tight drop-shadow-lg">
        {hotelTitle}
      </h1>

      <!-- Location Line -->
      <p class="text-xs sm:text-sm text-slate-200 font-medium flex items-center gap-2">
        <svg class="w-4 h-4 fill-emerald-400 shrink-0" viewBox="0 0 24 24"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>
        <span>{hotelLocation}</span>
      </p>

      <!-- (4.8 STAR RATING DELETED AS PER YOUR INSTRUCTION) -->

      <!-- Short Description -->
      <p class="text-xs sm:text-sm text-slate-300 leading-relaxed max-w-xl font-normal">
        {hotelDescription}
      </p>

      <!-- Amenities Quick Icons Row -->
      <div class="flex flex-wrap items-center gap-4 text-xs text-slate-200 pt-1">
        <span class="flex items-center gap-1.5"><svg class="w-4 h-4 fill-emerald-400" viewBox="0 0 24 24"><path d="M12 3C6.95 3 2.55 5.8 0 10c2.55 4.2 6.95 7 12 7s9.45-2.8 12-7c-2.55-4.2-6.95-7-12-7z"/></svg> Free Wi-Fi</span>
        <span class="flex items-center gap-1.5"><svg class="w-4 h-4 fill-emerald-400" viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2z"/></svg> Pool</span>
        <span class="flex items-center gap-1.5"><svg class="w-4 h-4 fill-emerald-400" viewBox="0 0 24 24"><path d="M12 2L2 22h20L12 2z"/></svg> Spa</span>
        <span class="flex items-center gap-1.5"><svg class="w-4 h-4 fill-emerald-400" viewBox="0 0 24 24"><path d="M20.57 14.86L22 13.43 20.57 12 17 15.57 8.43 7 12 3.43 10.57 2 9.14 3.43 7.71 2 6.29 3.43 7.71 4.86 3.43 9.14 2 7.71 0.57 9.14 2 10.57 0.57 12 2 13.43 3.43 12 12 20.57 15.57 17 17 18.43 18.43 17 17 15.57 20.57 12z"/></svg> Fitness Center</span>
        <span class="flex items-center gap-1.5"><svg class="w-4 h-4 fill-emerald-400" viewBox="0 0 24 24"><path d="M18.92 6.01C18.72 5.42 18.16 5 17.5 5h-11c-.66 0-1.21.42-1.42 1.01L3 12v8c0 .55.45 1 1 1h1c.55 0 1-.45 1-1v-1h12v1c0 .55.45 1 1 1h1c.55 0 1-.45 1-1v-8l-2.08-5.99z"/></svg> Free Parking</span>
      </div>

      <!-- Action Buttons -->
      <div class="flex flex-wrap items-center gap-3 pt-3">
        <!-- Red Primary Button -->
        <a href="#rates" class="bg-[#e52429] hover:bg-[#c91d22] text-white font-black text-xs sm:text-sm uppercase tracking-wider px-7 py-3.5 rounded-2xl shadow-xl transition hover:scale-105">
          View Prices
        </a>

        <!-- Outlined Glass Secondary Button -->
        <a href={officialSite} target="_blank" rel="noopener noreferrer" class="bg-white/10 hover:bg-white/20 border border-white/30 text-white font-black text-xs sm:text-sm uppercase tracking-wider px-6 py-3.5 rounded-2xl transition backdrop-blur-md hover:scale-105 flex items-center gap-2">
          <span>Official Website</span>
          <span>↗</span>
        </a>
      </div>

    </div>
  </div>

</section>
