---
// src/components/hotel/HotelHeader.astro
interface Props {
  hotel: any;
}

const { hotel } = Astro.props;
const data = hotel?.data || {};

const hotelTitle = data.title || data.name || "Hotel Details";
const hotelCategory = data.category || "5-Star Hotel";
const hotelLocation = data.location || "Gulshan 2, Dhaka 1212, Bangladesh";
const hotelImage = data.image || "https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&w=1600&q=80";
const officialSite = data.officialSite || "https://www.agoda.com";
const hotelDescription = data.description || "Experience timeless luxury and exceptional Bangladeshi hospitality in the heart of Gulshan, Dhaka.";
---

<!-- 1ST COMPONENT: HOTEL HERO & HEADER (MATCHING ALIGNMENT & VECTOR SVG ICONS) -->
<section class="relative bg-slate-950 text-white min-h-[480px] sm:min-h-[540px] flex items-center overflow-hidden border-b border-slate-800">
  
  <!-- High-Resolution Hotel Cover Image -->
  <div class="absolute inset-0 w-full h-full pointer-events-none">
    <img 
      src={hotelImage} 
      alt={hotelTitle} 
      class="w-full h-full object-cover opacity-80 scale-105" 
    />
    <!-- Dark Gradient Overlay for High Text Readability -->
    <div class="absolute inset-0 bg-gradient-to-r from-slate-950 via-slate-950/85 to-transparent"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-transparent to-slate-950/30"></div>
  </div>

  <!-- MAIN HERO OVERLAY (PERFECT LEFT ALIGNMENT MATCHING GLOBAL HEADER) -->
  <div class="relative z-20 max-w-[1550px] mx-auto px-6 sm:px-20 lg:px-28 w-full py-12 space-y-4">
    <div class="max-w-2xl space-y-3.5 text-left">
      
      <!-- Breadcrumbs -->
      <div class="flex items-center gap-2 text-xs text-slate-300 font-medium">
        <a href="/" class="hover:text-emerald-400 transition">Home</a>
        <span>›</span>
        <a href="/#all-hotels" class="hover:text-emerald-400 transition">Hotels</a>
        <span>›</span>
        <span class="text-white font-bold">{hotelTitle}</span>
      </div>

      <!-- Category Pill Badge -->
      <div>
        <span class="bg-white/10 border border-white/20 text-slate-200 text-[11px] font-bold px-3.5 py-1 rounded-full backdrop-blur-md inline-block">
          {hotelCategory}
        </span>
      </div>

      <!-- Main Hotel Title -->
      <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black text-white font-serif leading-tight tracking-tight drop-shadow-md">
        {hotelTitle}
      </h1>

      <!-- Location Line with Vector SVG Pin Icon -->
      <p class="text-xs sm:text-sm text-slate-200 font-medium flex items-center gap-2">
        <svg class="w-4 h-4 fill-emerald-400 shrink-0" viewBox="0 0 24 24">
          <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
        </svg>
        <span>{hotelLocation}</span>
      </p>

      <!-- Short Catchphrase -->
      <p class="text-xs sm:text-sm text-slate-300 leading-relaxed max-w-xl font-normal pt-1">
        {hotelDescription}
      </p>

      <!-- Vector SVG Amenities Quick Icons Row (No Emojis/Stickers) -->
      <div class="flex flex-wrap items-center gap-4 text-xs text-slate-200 pt-2">
        <!-- Free Wi-Fi SVG -->
        <span class="flex items-center gap-1.5 font-semibold">
          <svg class="w-4 h-4 fill-emerald-400 shrink-0" viewBox="0 0 24 24"><path d="M12 3C6.95 3 2.55 5.8 0 10c2.55 4.2 6.95 7 12 7s9.45-2.8 12-7c-2.55-4.2-6.95-7-12-7zm0 11.5c-2.48 0-4.5-2.02-4.5-4.5s2.02-4.5 4.5-4.5 4.5 2.02 4.5 4.5-2.02 4.5-4.5 4.5z"/></svg>
          Free Wi-Fi
        </span>

        <!-- Pool SVG -->
        <span class="flex items-center gap-1.5 font-semibold">
          <svg class="w-4 h-4 fill-emerald-400 shrink-0" viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8z"/></svg>
          Pool
        </span>

        <!-- Spa SVG -->
        <span class="flex items-center gap-1.5 font-semibold">
          <svg class="w-4 h-4 fill-emerald-400 shrink-0" viewBox="0 0 24 24"><path d="M12 2L2 22h20L12 2zm0 4.2L18.8 20H5.2L12 6.2z"/></svg>
          Spa
        </span>

        <!-- Fitness Center SVG -->
        <span class="flex items-center gap-1.5 font-semibold">
          <svg class="w-4 h-4 fill-emerald-400 shrink-0" viewBox="0 0 24 24"><path d="M20.57 14.86L22 13.43 20.57 12 17 15.57 8.43 7 12 3.43 10.57 2 9.14 3.43 7.71 2 6.29 3.43 7.71 4.86 3.43 9.14 2 7.71 0.57 9.14 2 10.57 0.57 12 2 13.43 3.43 12 12 20.57 15.57 17 17 18.43 18.43 17 17 15.57 20.57 12z"/></svg>
          Fitness Center
        </span>

        <!-- Free Parking SVG -->
        <span class="flex items-center gap-1.5 font-semibold">
          <svg class="w-4 h-4 fill-emerald-400 shrink-0" viewBox="0 0 24 24"><path d="M18.92 6.01C18.72 5.42 18.16 5 17.5 5h-11c-.66 0-1.21.42-1.42 1.01L3 12v8c0 .55.45 1 1 1h1c.55 0 1-.45 1-1v-1h12v1c0 .55.45 1 1 1h1c.55 0 1-.45 1-1v-8l-2.08-5.99z"/></svg>
          Free Parking
        </span>
      </div>

      <!-- Action Buttons (Eye-Soothing Soft Forest Emerald & Glass) -->
      <div class="flex flex-wrap items-center gap-3 pt-4">
        <!-- Soft Forest Emerald Button -->
        <a href="#about-and-rates" class="bg-[#0d3b23] hover:bg-[#061e14] text-white font-extrabold text-xs sm:text-sm uppercase tracking-wider px-7 py-3.5 rounded-2xl shadow-xl transition hover:scale-105 border border-emerald-600/30">
          View Prices
        </a>

        <!-- Outlined Glass Secondary Button with Vector SVG Arrow -->
        <a href={officialSite} target="_blank" rel="noopener noreferrer" class="bg-white/10 hover:bg-white/20 border border-white/25 text-white font-extrabold text-xs sm:text-sm uppercase tracking-wider px-6 py-3.5 rounded-2xl transition backdrop-blur-md hover:scale-105 flex items-center gap-2">
          <span>Official Website</span>
          <svg class="w-3.5 h-3.5 fill-current shrink-0" viewBox="0 0 24 24">
            <path d="M19 19H5V5h7V3H5c-1.11 0-2 .9-2 2v14c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2v-7h-2v7zM14 3v2h3.59l-9.83 9.83 1.41 1.41L19 6.41V10h2V3h-7z"/>
          </svg>
        </a>
      </div>

    </div>
  </div>

</section>
