---
// src/components/hotel/HotelHeader.astro
interface Props {
  hotel: any;
}

const { hotel } = Astro.props;
const data = hotel?.data || {};

// Dynamic Hotel Data
const hotelTitle = data.title || data.name || "Hotel Details";
const hotelCategory = data.category;
const hotelLocation = data.location;
const hotelImage = data.image || "https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&w=1200&q=80";
const officialSite = data.officialSite || "";
const hotelDescription = data.description;

// Smart Dynamic SEO Alt Text (Admin Input OR Automatic Fallback)
const heroAltText = data.image_alt || `${hotelTitle} - Main Exterior Cover Photo`;

// Controls
const showViewPrices = data.enable_view_prices !== false;
const showOfficialSite = data.enable_official_site !== false && Boolean(officialSite);

// Title Typography Style
const selectedStyle = data.title_style || "style_1";
const titleStyleMap: Record<string, string> = {
  style_1: "font-serif text-3xl sm:text-5xl lg:text-6xl font-black text-slate-900 tracking-tight leading-tight",
  // ... ৩০টি স্টাইল
};
const titleCssClass = titleStyleMap[selectedStyle] || titleStyleMap.style_1;

// Image Optimizer Helper
function getOptimizedImageUrl(url: string, width = 800, quality = 80) {
  if (!url) return '';
  if (url.includes('unsplash.com')) {
    const cleanUrl = url.split('?')[0];
    return `${cleanUrl}?auto=format&fit=crop&w=${width}&q=${quality}&fm=webp`;
  }
  return url;
}

const rawGallery = (Array.isArray(data.gallery) && data.gallery.length > 0)
  ? data.gallery
  : (hotelImage ? [hotelImage] : []);

const totalPhotos = rawGallery.length;
const remainingPhotos = totalPhotos > 5 ? totalPhotos - 5 : 0;

const gridColsClass = totalPhotos >= 5
  ? 'grid-cols-5'
  : totalPhotos === 4
    ? 'grid-cols-4'
    : totalPhotos === 3
      ? 'grid-cols-3'
      : 'grid-cols-2';

const mainHeroUrlMobile = getOptimizedImageUrl(rawGallery[0], 640, 75);
const mainHeroUrlDesktop = getOptimizedImageUrl(rawGallery[0], 1200, 80);
const thumbUrls = rawGallery.map((img: string) => getOptimizedImageUrl(img, 160, 65));
const lightboxUrls = rawGallery.map((img: string) => getOptimizedImageUrl(img, 1400, 82));
---

<!-- EARLY LCP PRECONNECT & PRELOAD DIRECTIVES -->
{totalPhotos > 0 && (
  <>
    <link rel="preconnect" href="https://images.unsplash.com" crossorigin />
    <link rel="preconnect" href="https://picsum.photos" crossorigin />
    <link
      rel="preload"
      as="image"
      href={mainHeroUrlDesktop}
      imagesrcset={`${mainHeroUrlMobile} 640w, ${mainHeroUrlDesktop} 1200w`}
      imagesizes="(max-width: 1024px) 100vw, 1024px"
      fetchpriority="high"
    />
  </>
)}

<!-- 1ST COMPONENT: HOTEL HERO BANNER -->
<section class="bg-[#F8FAF9] text-slate-900 pt-6 pb-10 px-4 sm:px-6 lg:px-10 max-w-[1680px] mx-auto border-b border-slate-200/80">
  <div class="space-y-6">

    <!-- TOP HEADER & TITLE AREA -->
    <div class="text-center max-w-4xl mx-auto space-y-3">

      <!-- Breadcrumbs Navigation -->
      <div class="flex items-center justify-center gap-2 text-xs text-slate-500 font-medium">
        <a href="/" class="hover:text-emerald-700 transition">Home</a>
        <span>›</span>
        <a href="/#hotels" class="hover:text-emerald-700 transition">Hotels</a>
        <span>›</span>
        <span class="text-slate-800 font-bold">{hotelTitle}</span>
      </div>

      <!-- Category Pill Badge -->
      {hotelCategory && (
        <div>
          <span class="bg-emerald-100/80 text-emerald-800 border border-emerald-300/80 text-[10px] sm:text-xs font-black uppercase tracking-widest px-3 py-1 rounded-full inline-block">
            {hotelCategory}
          </span>
        </div>
      )}

      <!-- PRIMARY SEO HEADING (H1) -->
      <h1 class={titleCssClass}>
        {hotelTitle}
      </h1>

      <!-- Location Line -->
      {hotelLocation && (
        <p class="text-xs sm:text-sm text-slate-600 font-medium flex flex-wrap items-center justify-center gap-2">
          <span class="flex items-center gap-1">
            <svg class="w-4 h-4 fill-emerald-600 shrink-0" viewBox="0 0 24 24"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>
            <span>{hotelLocation}</span>
          </span>
          <a href="#location-map" class="text-emerald-800 font-black hover:underline inline-flex items-center gap-0.5">
            <span>View in a map</span>
            <span>➔</span>
          </a>
        </p>
      )}

      <!-- Description -->
      {hotelDescription && (
        <p class="text-xs sm:text-sm text-slate-600 max-w-xl mx-auto leading-relaxed">
          {hotelDescription}
        </p>
      )}

      <!-- Action Buttons -->
      {(showViewPrices || showOfficialSite) && (
        <div class="flex items-center justify-center gap-3 pt-3">
          {showViewPrices && (
            <a href="#rates-card" class="bg-[#0d3b23] hover:bg-[#061e14] text-white font-black text-xs sm:text-sm uppercase tracking-wider px-7 py-3 rounded-2xl shadow-lg transition hover:scale-105">
              View Prices ➔
            </a>
          )}

          {showOfficialSite && (
            <a href={officialSite} target="_blank" rel="noopener noreferrer" class="bg-white hover:bg-slate-100 text-slate-900 font-black text-xs sm:text-sm uppercase tracking-wider px-6 py-3 rounded-2xl transition border border-slate-300 hover:scale-105 flex items-center gap-1.5 shadow-sm">
              <span>Official Website</span>
              <span>↗</span>
            </a>
          )}
        </div>
      )}

    </div>

    <!-- RESPONSIVE HERO GALLERY -->
    {totalPhotos > 0 && (
      <div class="max-w-5xl mx-auto space-y-3 pt-2">

        <!-- 1. MAIN HERO PHOTO WITH DYNAMIC SEO ALT TEXT -->
        <div class="relative w-full h-[280px] xs:h-[320px] sm:h-[420px] lg:h-[480px] rounded-2xl sm:rounded-3xl overflow-hidden shadow-md group border border-slate-200/80 bg-slate-900">
          <img
            id="heroMainViewImg"
            src={mainHeroUrlDesktop}
            srcset={`${mainHeroUrlMobile} 640w, ${mainHeroUrlDesktop} 1200w`}
            sizes="(max-width: 1024px) 100vw, 1024px"
            width="1200"
            height="480"
            alt={heroAltText}
            loading="eager"
            fetchpriority="high"
            decoding="async"
            class="w-full h-full object-cover transition-all duration-300 group-hover:scale-105 cursor-pointer"
          />

          {totalPhotos > 1 && (
            <button id="heroPrevImgBtn" aria-label="Previous Image" class="absolute left-3 top-1/2 -translate-y-1/2 w-9 h-9 sm:w-11 sm:h-11 rounded-full bg-slate-950/70 hover:bg-slate-950 text-white backdrop-blur-md border border-white/20 flex items-center justify-center transition active:scale-95 text-base sm:text-lg font-bold cursor-pointer z-10">❮</button>
          )}

          {totalPhotos > 1 && (
            <button id="heroNextImgBtn" aria-label="Next Image" class="absolute right-3 top-1/2 -translate-y-1/2 w-9 h-9 sm:w-11 sm:h-11 rounded-full bg-slate-950/70 hover:bg-slate-950 text-white backdrop-blur-md border border-white/20 flex items-center justify-center transition active:scale-95 text-base sm:text-lg font-bold cursor-pointer z-10">❯</button>
          )}

          <div class="absolute bottom-3 right-3 bg-slate-950/85 backdrop-blur-md text-white text-xs font-bold px-3 py-1 rounded-full shadow border border-white/20">
            <span id="heroCurrentIdx">1</span> / <span>{totalPhotos}</span>
          </div>
        </div>

        <!-- 2. THUMBNAILS WITH DYNAMIC SEO ALT TEXT -->
        {thumbUrls.length > 1 && (
          <div class={`grid gap-2 sm:gap-3 ${gridColsClass}`}>
            {thumbUrls.slice(0, 4).map((img: string, idx: number) => (
              <button
                class={`hero-thumb-btn h-16 sm:h-20 lg:h-24 rounded-xl sm:rounded-2xl overflow-hidden relative border-2 transition cursor-pointer shrink-0 group ${idx === 0 ? 'border-emerald-600' : 'border-transparent'}`}
                data-index={idx}
              >
                <img
                  src={img}
                  alt={`${hotelTitle} - Gallery Photo ${idx + 1}`}
                  width="160"
                  height="120"
                  loading="lazy"
                  decoding="async"
                  class="w-full h-full object-cover group-hover:scale-110 transition duration-300"
                />
              </button>
            ))}

            <!-- 5th Thumbnail -->
            {thumbUrls[4] && (
              <button
                id="triggerFullGalleryBtn"
                class="hero-thumb-btn h-16 sm:h-20 lg:h-24 rounded-xl sm:rounded-2xl overflow-hidden relative border-2 border-transparent hover:border-emerald-600 transition cursor-pointer shrink-0 group text-white"
                data-index="4"
              >
                <img
                  src={thumbUrls[4]}
                  alt={`${hotelTitle} - Gallery Photo 5`}
                  width="160"
                  height="120"
                  loading="lazy"
                  decoding="async"
                  class="w-full h-full object-cover group-hover:scale-110 transition duration-300"
                />
                {remainingPhotos > 0 ? (
                  <div class="absolute inset-0 bg-slate-950/80 backdrop-blur-[2px] flex flex-col items-center justify-center p-1 text-center">
                    <span class="text-xs sm:text-base font-black text-white">+{remainingPhotos}</span>
                    <span class="text-[9px] sm:text-[11px] font-bold text-slate-300">Photos</span>
                  </div>
                ) : (
                  <div class="absolute inset-0 bg-slate-950/20 group-hover:bg-transparent transition"></div>
                )}
              </button>
            )}
          </div>
        )}

      </div>
    )}

  </div>
</section>

<!-- LIGHTBOX MODAL WITH SEO ALT TEXT -->
<script type="application/json" id="hotel-gallery-data" set:html={JSON.stringify(lightboxUrls)}></script>

<div id="heroLightboxModal" role="dialog" aria-modal="true" class="fixed inset-0 z-50 bg-slate-950/90 backdrop-blur-md hidden flex flex-col justify-between p-4 sm:p-8 text-white">
  <div class="flex items-center justify-between max-w-6xl mx-auto w-full border-b border-slate-800 pb-4">
    <div>
      <h3 class="text-lg font-black font-serif text-white">{hotelTitle}</h3>
      <span class="text-xs text-slate-400">Photo Gallery</span>
    </div>
    <div class="flex items-center gap-4">
      <span class="text-xs font-bold bg-slate-800 px-3 py-1 rounded-full border border-slate-700">
        <span id="lightboxModalIdx">1</span> / <span>{totalPhotos}</span>
      </span>
      <button id="closeHeroLightboxBtn" aria-label="Close Lightbox" class="text-slate-400 hover:text-white text-3xl font-bold p-1 cursor-pointer">&times;</button>
    </div>
  </div>

  <div class="relative max-w-5xl mx-auto my-auto w-full h-[60vh] sm:h-[70vh] flex items-center justify-center">
    <img id="lightboxModalImg" src={lightboxUrls[0]} alt={`${hotelTitle} - Fullscreen Gallery View`} loading="lazy" decoding="async" class="max-w-full max-h-full object-contain rounded-2xl shadow-2xl" />
    
    {totalPhotos > 1 && (
      <button id="lightboxPrevBtn" aria-label="Previous Lightbox Photo" class="absolute left-2 sm:left-4 top-1/2 -translate-y-1/2 w-10 h-10 rounded-full bg-slate-900/80 hover:bg-slate-800 text-white flex items-center justify-center text-lg font-bold shadow-xl transition cursor-pointer">❮</button>
    )}
    
    {totalPhotos > 1 && (
      <button id="lightboxNextBtn" aria-label="Next Lightbox Photo" class="absolute right-2 sm:left-auto sm:right-4 top-1/2 -translate-y-1/2 w-10 h-10 rounded-full bg-slate-900/80 hover:bg-slate-800 text-white flex items-center justify-center text-lg font-bold shadow-xl transition cursor-pointer">❯</button>
    )}
  </div>
</div>

<!-- CLIENT SCRIPT -->
<script is:inline>
  const initHotelHeader = () => {
    const mainImg = document.getElementById('heroMainViewImg');
    const prevBtn = document.getElementById('heroPrevImgBtn');
    const nextBtn = document.getElementById('heroNextImgBtn');
    const currentIdxSpan = document.getElementById('heroCurrentIdx');
    const thumbBtns = document.querySelectorAll('.hero-thumb-btn');

    const modal = document.getElementById('heroLightboxModal');
    const closeModalBtn = document.getElementById('closeHeroLightboxBtn');
    const modalImg = document.getElementById('lightboxModalImg');
    const modalIdxSpan = document.getElementById('lightboxModalIdx');
    const modalPrevBtn = document.getElementById('lightboxPrevBtn');
    const modalNextBtn = document.getElementById('lightboxNextBtn');

    const galleryScript = document.getElementById('hotel-gallery-data');
    let images = [];
    try {
      images = JSON.parse(galleryScript?.textContent || '[]');
    } catch (e) {
      images = [];
    }

    let activeIdx = 0;

    function updateMainImage(idx) {
      if (!mainImg || !images.length) return;
      activeIdx = (idx + images.length) % images.length;
      mainImg.src = images[activeIdx];
      mainImg.removeAttribute('srcset');
      
      if (currentIdxSpan) currentIdxSpan.textContent = (activeIdx + 1).toString();

      thumbBtns.forEach((btn, i) => {
        if (i === activeIdx) {
          btn.classList.add('border-emerald-600');
          btn.classList.remove('border-transparent');
        } else {
          btn.classList.add('border-transparent');
          btn.classList.remove('border-emerald-600');
        }
      });
    }

    function hideLightboxDOM() {
      if (modal) modal.classList.add('hidden');
    }

    function openLightbox(startIdx) {
      if (!modal) return;
      const idxToOpen = startIdx !== undefined ? startIdx : activeIdx;
      updateModalImage(idxToOpen);
      modal.classList.remove('hidden');

      if (window.location.hash !== '#gallery') {
        window.location.hash = 'gallery';
      }
    }

    function closeLightboxByUI() {
      if (window.location.hash === '#gallery') {
        history.back();
      } else {
        hideLightboxDOM();
      }
    }

    function updateModalImage(idx) {
      if (!modalImg || !images.length) return;
      activeIdx = (idx + images.length) % images.length;
      modalImg.src = images[activeIdx];
      if (modalIdxSpan) modalIdxSpan.textContent = (activeIdx + 1).toString();
    }

    window.addEventListener('hashchange', () => {
      if (window.location.hash !== '#gallery') {
        hideLightboxDOM();
      } else if (modal && modal.classList.contains('hidden')) {
        modal.classList.remove('hidden');
      }
    });

    if (window.location.hash === '#gallery') {
      openLightbox(0);
    }

    if (prevBtn) prevBtn.addEventListener('click', (e) => { e.stopPropagation(); updateMainImage(activeIdx - 1); });
    if (nextBtn) nextBtn.addEventListener('click', (e) => { e.stopPropagation(); updateMainImage(activeIdx + 1); });

    thumbBtns.forEach((btn, i) => {
      btn.addEventListener('click', () => {
        updateMainImage(i);
        if (i === 4 && images.length > 5) {
          openLightbox(4);
        }
      });
    });

    if (mainImg) {
      mainImg.addEventListener('click', () => openLightbox(activeIdx));
    }

    if (closeModalBtn) closeModalBtn.addEventListener('click', closeLightboxByUI);

    if (modal) {
      modal.addEventListener('click', (e) => {
        if (e.target === modal) closeLightboxByUI();
      });
    }

    if (modalPrevBtn) modalPrevBtn.addEventListener('click', () => updateModalImage(activeIdx - 1));
    if (modalNextBtn) modalNextBtn.addEventListener('click', () => updateModalImage(activeIdx + 1));
  };

  document.addEventListener('DOMContentLoaded', initHotelHeader);
  document.addEventListener('astro:page-load', initHotelHeader);
</script>
