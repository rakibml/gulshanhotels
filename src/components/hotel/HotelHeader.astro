---
// src/components/hotel/HotelHeader.astro (Bulletproof Dialog, Mobile Swipe, Cloudflare Optimized & Zero Fake Reviews)
interface Props {
  hotel: any;
}

const { hotel } = Astro.props;
const data = hotel?.data || {};

// ================= 1. HOTEL BASIC INFO & DRAFT-AWARE ASSERTION =================
const hotelTitle = String(data.title || data.name || "").trim();
const hotelLocation = String(data.location || "").trim();
const rawSlug = String(data.slug || hotel?.slug || hotel?.id || "").trim();
const hotelSlug = rawSlug.replace(/\.(md|mdx)$/, '').split('/').pop()?.toLowerCase() || "";
const isDraft = data.draft === true || String(data.draft).toLowerCase() === 'true';

// ড্রাফট না হলে এবং টাইটেল না থাকলে বিল্ড সরাসরি আটকে যাবে (ভুল পেজ লাইভ হওয়া রোধ)
if (!hotelTitle && !isDraft) {
  throw new Error(`[HotelHeader] Hotel title missing in slug: "${hotelSlug || 'unknown'}". Please define title in frontmatter.`);
}

const searchTitle = hotelTitle.toLowerCase();
const searchSlug = hotelSlug.toLowerCase();
const isVerified = data.is_verified === true;

// ================= 2. 100% GENUINE GUEST REVIEWS (NO SELF-WRITTEN REVIEWS) =================
let rawReviewsList: any[] = [];
try {
  const globFiles = import.meta.glob('/src/content/reviews/*.{md,mdx}', { eager: true });
  const entries = Object.values(globFiles);
  
  if (entries.length > 0) {
    rawReviewsList = entries.map((item: any) => item?.frontmatter || item?.data || item || {});
  } else {
    const relFiles = import.meta.glob('../../content/reviews/*.{md,mdx}', { eager: true });
    rawReviewsList = Object.values(relFiles).map((item: any) => item?.frontmatter || item?.data || item || {});
  }
} catch (e) {
  rawReviewsList = [];
}

// শুধুমাত্র অতিথিদের পাঠানো এবং অ্যাডমিনের যাচাইকৃত আসল রিভিউ
const seenReviews = new Set<string>();
const approvedReviews = rawReviewsList.filter((item: any) => {
  if (!item) return false;
  const isApproved = item.approved === true || String(item.approved).trim().toLowerCase() === 'true';
  if (!isApproved) return false;

  const rSlug = String(item.slug || item.hotelSlug || item.hotel_slug || '').replace(/\.(md|mdx)$/, '').split('/').pop()?.trim().toLowerCase() || "";
  const rId = String(item.id || '').replace(/\.(md|mdx)$/, '').split('/').pop()?.trim().toLowerCase() || "";
  const rHotel = String(item.hotel || item.hotelTitle || item.hotel_name || '').trim().toLowerCase();

  const matchSlug = searchSlug !== "" && (rSlug === searchSlug || rId === searchSlug || rHotel === searchSlug);
  const matchTitle = searchTitle !== "" && (rHotel === searchTitle);

  if (!matchSlug && !matchTitle) return false;

  const comment = String(item.comment || item.review || item.body || '').trim();
  const rating = Number(item.rating);
  if (comment.length < 10) return false;
  if (isNaN(rating) || rating < 1 || rating > 5) return false;

  const key = `${comment}_${item.name || item.author || ''}`;
  if (seenReviews.has(key)) return false;
  seenReviews.add(key);
  return true;
});

const reviewsCount = approvedReviews.length;
const avgRatingNum = reviewsCount > 0
  ? approvedReviews.reduce((sum: number, r: any) => sum + Number(r.rating), 0) / reviewsCount
  : 0;
const avgRating = avgRatingNum > 0 ? avgRatingNum.toFixed(1) : "";

const hotelRanking = String(data.ranking || data.ranking_text || "").trim();
const locationMapUrl = data.map_url || "#location-map";

// ================= 3. CLOUDFLARE RESILIENT RESPONSIVE IMAGES =================
const coverImage = data.image ? String(data.image).trim() : "";
const coverAlt = String(data.image_alt || `${hotelTitle} - Photo 1`).trim();

function getOptimizedImageUrl(url: string, width = 800, quality = 80) {
  if (!url) return '';
  const cleanUrl = url.trim();
  
  // Unsplash fallback
  if (cleanUrl.includes('unsplash.com')) {
    const base = cleanUrl.split('?')[0];
    return `${base}?auto=format&fit=crop&w=${width}&q=${quality}&fm=webp`;
  }
  
  // Cloudflare Transformations with onerror=redirect (কোটা পার হলেও ছবি ভাঙবে না)
  if (cleanUrl.startsWith('https://media.gulshanhotels.com/')) {
    const path = cleanUrl.replace('https://media.gulshanhotels.com/', '');
    return `https://media.gulshanhotels.com/cdn-cgi/image/width=${width},quality=${quality},format=auto,onerror=redirect/${path}`;
  }

  return cleanUrl;
}

const rawGalleryData: any[] = (Array.isArray(data.gallery) && data.gallery.length > 0)
  ? data.gallery
  : (coverImage ? [{ photo: coverImage, alt: coverAlt }] : []);

const processedGallery = rawGalleryData.map((item: any, idx: number) => {
  const isObj = typeof item === 'object' && item !== null;
  const rawUrl = isObj ? (item.photo || item.image || item.url || '') : String(item);
  const altText = isObj && item.alt 
    ? String(item.alt).trim() 
    : (idx === 0 && coverAlt ? coverAlt : `${hotelTitle || 'Hotel'} - Photo ${idx + 1}`);

  const desktopUrl = getOptimizedImageUrl(rawUrl, 1200, 80);

  return {
    url: rawUrl,
    alt: altText,
    mobile: getOptimizedImageUrl(rawUrl, 640, 75),
    desktop: desktopUrl,
    // Lightbox-এর জন্য আলাদা 1600 বাদ দিয়ে Desktop 1200 রি-ইউজ (ক্যাশ সেভ ও কোটা বাঁচানো)
    lightbox: desktopUrl
  };
}).filter(g => Boolean(g.url));

const totalPhotos = processedGallery.length;

const galleryPayload = {
  photos: processedGallery.map(g => ({ src: g.lightbox, alt: g.alt }))
};

// ================= 4. WISHLIST PAYLOAD =================
const rawPrice = data.price || data.starting_price;
const hotelPrice = rawPrice 
  ? (String(rawPrice).trim().startsWith('$') || String(rawPrice).trim().startsWith('৳') ? String(rawPrice).trim() : `$${String(rawPrice).trim()}`)
  : "Check rates";

const currentHotelWishlistData = {
  title: hotelTitle,
  slug: hotelSlug,
  price: hotelPrice,
  image: processedGallery[0]?.mobile || coverImage || "",
  url: hotelSlug ? `/${hotelSlug}/` : "#"
};
---

<!-- পেছনের পেজ স্ক্রল হওয়া বন্ধ করতে আধুনিক CSS :has() -->
<style is:global>
  html:has(#heroLightboxModal[open]) {
    overflow: hidden !important;
  }
</style>

<!-- MAIN HOTEL HEADER & GALLERY SECTION -->
<section class="bg-white text-slate-900 pt-6 pb-8 px-4 sm:px-6 lg:px-8 max-w-[1550px] mx-auto border-b border-slate-200">
  <div class="max-w-7xl mx-auto space-y-4">

    <!-- ================= 1. HEADER INFO AREA ================= -->
    <div class="space-y-3 pb-2">
      
      <!-- ROW 1: TITLE & ACTION BUTTONS -->
      <div class="flex flex-wrap items-center justify-between gap-4">
        <div class="flex items-center gap-2">
          <h1 class="font-sans text-2xl sm:text-3xl lg:text-[34px] font-black text-[#002b11] tracking-tight leading-tight">
            {hotelTitle}
          </h1>

          {isVerified && (
            <span class="inline-flex items-center justify-center text-[#002b11] shrink-0" title="Verified Hotel">
              <svg aria-hidden="true" class="w-5 h-5 sm:w-6 sm:h-6" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 2l2.4 2.1 3.2-.4 1.2 3 2.9 1.4-.7 3.1 1.9 2.5-1.9 2.5.7 3.1-2.9 1.4-1.2 3-3.2-.4L12 22l-2.4-2.1-3.2.4-1.2-3-2.9-1.4.7-3.1-1.9-2.5 1.9-2.5-.7-3.1 2.9-1.4 1.2-3 3.2.4L12 2z"/>
                <path d="M9.5 12l2 2 4.5-4.5" fill="none" stroke="#ffffff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
          )}
        </div>

        <!-- Right Side: Desktop Action Buttons -->
        <div class="hidden sm:flex items-center gap-4 sm:gap-5">
          {hotelSlug && (
            <button
              type="button"
              class="hotel-wishlist-toggle-btn flex items-center gap-1.5 text-slate-900 hover:text-emerald-800 transition cursor-pointer select-none"
              aria-pressed="false"
            >
              <svg class="wishlist-heart-icon w-4 h-4 fill-none stroke-slate-900 stroke-2 shrink-0 transition-all duration-200" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
              </svg>
              <span class="wishlist-label-text text-xs sm:text-sm font-bold underline underline-offset-4">Save</span>
            </button>
          )}

          <button
            type="button"
            class="open-write-review-trigger border border-slate-900 hover:bg-slate-100 text-slate-900 font-bold text-xs sm:text-sm px-4 py-1.5 rounded-full flex items-center gap-1.5 transition active:scale-95 cursor-pointer"
          >
            <svg aria-hidden="true" class="w-3.5 h-3.5 stroke-slate-900 fill-none stroke-2 shrink-0" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 20h9"/>
              <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/>
            </svg>
            <span>Review</span>
          </button>
        </div>
      </div>

      <!-- ROW 2: RATINGS, REVIEWS & LOCATION -->
      <div class="space-y-1.5 text-left pt-1">
        <div class="flex flex-wrap items-center gap-2 text-xs sm:text-sm">
          {reviewsCount > 0 && avgRating ? (
            <>
              <span class="font-bold text-slate-900">{avgRating}</span>

              <!-- নির্ভুল ফ্র্যাকশনাল স্টার -->
              <div class="flex items-center gap-0.5" role="img" aria-label={`Rated ${avgRating} out of 5 stars`}>
                {Array.from({ length: 5 }).map((_, i) => {
                  const pct = Math.round(Math.max(0, Math.min(1, avgRatingNum - i)) * 100);
                  return (
                    <span class="relative inline-block w-3.5 h-3.5 shrink-0" aria-hidden="true">
                      <svg class="absolute inset-0 w-3.5 h-3.5 fill-slate-200" viewBox="0 0 24 24">
                        <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/>
                      </svg>
                      <span class="absolute inset-y-0 left-0 overflow-hidden" style={`width:${pct}%`}>
                        <svg class="w-3.5 h-3.5 fill-amber-400" viewBox="0 0 24 24">
                          <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/>
                        </svg>
                      </span>
                    </span>
                  );
                })}
              </div>

              <a href="#guest-reviews" class="text-slate-800 font-medium underline underline-offset-2 hover:text-emerald-800 transition">
                ({reviewsCount.toLocaleString()} {reviewsCount === 1 ? 'review' : 'reviews'})
              </a>
            </>
          ) : (
            <a href="#guest-reviews" class="text-slate-500 font-medium underline underline-offset-2 hover:text-emerald-800 transition">
              (No reviews yet)
            </a>
          )}

          <!-- Mobile Only Action Buttons -->
          <div class="flex sm:hidden items-center gap-2 ml-1">
            <button
              type="button"
              class="open-write-review-trigger border border-slate-900 hover:bg-slate-100 text-slate-900 font-bold text-[11px] px-2.5 py-1 rounded-full flex items-center gap-1 active:scale-95 cursor-pointer"
            >
              <svg aria-hidden="true" class="w-3 h-3 stroke-slate-900 fill-none stroke-2 shrink-0" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 20h9"/>
                <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/>
              </svg>
              <span>Review</span>
            </button>

            {hotelSlug && (
              <button
                type="button"
                class="hotel-wishlist-toggle-btn flex items-center gap-1 text-slate-900 hover:text-red-600 cursor-pointer select-none text-[11px] font-bold"
                aria-pressed="false"
              >
                <svg class="wishlist-heart-icon w-3.5 h-3.5 stroke-slate-900 fill-none stroke-2 shrink-0 transition-colors" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
                </svg>
                <span class="wishlist-label-text underline underline-offset-2">Save</span>
              </button>
            )}
          </div>

          {hotelRanking && (
            <a href="#about-and-rates" class="text-slate-800 font-medium underline underline-offset-2 hover:text-emerald-800 transition">
              {hotelRanking}
            </a>
          )}
        </div>

        {hotelLocation && (
          <div class="flex items-center gap-1.5 text-xs sm:text-sm">
            <svg aria-hidden="true" class="w-4 h-4 text-[#002b11] shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
              <circle cx="12" cy="10" r="3"/>
            </svg>
            <a href={locationMapUrl} class="text-slate-900 font-semibold underline underline-offset-2 hover:text-emerald-800 transition">
              View location
            </a>
          </div>
        )}
      </div>

    </div>

    <!-- ================= 2. RESPONSIVE HERO GALLERY COLLAGE ================= -->
    {totalPhotos > 0 && (
      <div class="pt-2">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-1 h-[280px] sm:h-[400px] md:h-[450px] lg:h-[480px] rounded-2xl sm:rounded-3xl overflow-hidden shadow-sm bg-slate-100">
          
          <!-- 1. MAIN LARGE IMAGE -->
          <div 
            class={`relative h-full overflow-hidden group cursor-pointer ${totalPhotos >= 2 ? 'md:col-span-2' : 'md:col-span-3'}`}
            data-gallery-trigger="0"
            role="button"
            tabindex="0"
            aria-label={`Open photo gallery (${totalPhotos} photos), viewing photo 1: ${processedGallery[0].alt}`}
          >
            <img
              id="heroMainViewImg"
              src={processedGallery[0].desktop}
              srcset={`${processedGallery[0].mobile} 640w, ${processedGallery[0].desktop} 1200w`}
              sizes="(max-width: 768px) 100vw, 850px"
              width="850"
              height="480"
              alt={processedGallery[0].alt}
              loading="eager"
              fetchpriority="high"
              decoding="async"
              class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
            />

            <!-- Visual Badge -->
            <div
              aria-hidden="true"
              class="absolute bottom-3 sm:bottom-4 right-3 sm:right-4 bg-[#002b11]/90 text-white backdrop-blur-md px-3.5 py-1.5 rounded-full flex items-center gap-2 shadow-lg border border-white/20 transition group-hover:scale-105 pointer-events-none z-10"
            >
              <svg class="w-4 h-4 fill-none stroke-currentColor stroke-2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
                <rect width="18" height="18" x="3" y="3" rx="2" ry="2"/>
                <circle cx="9" cy="9" r="2"/>
                <path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/>
              </svg>
              <span class="text-xs sm:text-sm font-bold tracking-wide">{totalPhotos}</span>
            </div>
          </div>

          <!-- 2. RIGHT SIDE: STACKED PHOTOS -->
          {totalPhotos >= 2 && (
            <div class="hidden md:grid grid-rows-2 gap-1 h-full">
              <!-- Photo 2 (Row-span-2 if exactly 2 photos) -->
              <div 
                class={`relative h-full overflow-hidden group cursor-pointer ${totalPhotos === 2 ? 'row-span-2' : ''}`}
                data-gallery-trigger="1"
                role="button"
                tabindex="0"
                aria-label={`Open photo gallery (${totalPhotos} photos), viewing photo 2: ${processedGallery[1].alt}`}
              >
                <img
                  src={processedGallery[1].desktop}
                  alt={processedGallery[1].alt}
                  width="400"
                  height={totalPhotos === 2 ? 480 : 240}
                  loading="lazy"
                  decoding="async"
                  class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                />
              </div>

              <!-- Photo 3 -->
              {totalPhotos >= 3 && (
                <div 
                  class="relative h-full overflow-hidden group cursor-pointer"
                  data-gallery-trigger="2"
                  role="button"
                  tabindex="0"
                  aria-label={`Open photo gallery (${totalPhotos} photos), viewing photo 3: ${processedGallery[2].alt}`}
                >
                  <img
                    src={processedGallery[2].desktop}
                    alt={processedGallery[2].alt}
                    width="400"
                    height="240"
                    loading="lazy"
                    decoding="async"
                    class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                  />
                </div>
              )}
            </div>
          )}

        </div>
      </div>
    )}

  </div>
</section>

<!-- HIDDEN SECURE JSON PAYLOADS -->
<script type="application/json" id="hotel-gallery-data" set:html={JSON.stringify(galleryPayload).replace(/</g, '\\u003c')} />
<script type="application/json" id="hotel-wishlist-data" set:html={JSON.stringify(currentHotelWishlistData).replace(/</g, '\\u003c')} />

<!-- NATIVE <dialog> MODAL (Zero Heading Conflicts) -->
<dialog
  id="heroLightboxModal"
  aria-label="Image Gallery Lightbox"
  class="fixed inset-0 m-auto z-50 w-full h-full max-w-none max-h-none p-4 sm:p-8 bg-slate-950/95 backdrop:bg-slate-950/80 backdrop:backdrop-blur-md text-white select-none border-0 overflow-hidden [&:not([open])]:hidden [&[open]]:flex flex-col justify-between"
>
  <div class="flex items-center justify-between max-w-7xl mx-auto w-full border-b border-slate-800 pb-4">
    <div>
      <!-- H2 বাদ দিয়ে clean p ট্যাগ যাতে পেজের হেডিং স্ট্রাকচার নষ্ট না হয় -->
      <p class="text-base sm:text-lg font-black font-sans text-white">{hotelTitle}</p>
      <span class="text-xs text-slate-400">Photo Gallery</span>
    </div>
    <div class="flex items-center gap-4">
      <span class="text-xs font-bold bg-slate-800 px-3 py-1 rounded-full border border-slate-700">
        <span id="lightboxModalIdx">1</span> / <span>{totalPhotos}</span>
      </span>
      <button
        type="button"
        id="closeHeroLightboxBtn"
        aria-label="Close Lightbox"
        class="text-slate-400 hover:text-white text-3xl font-bold p-1 cursor-pointer transition active:scale-90"
      >
        &times;
      </button>
    </div>
  </div>

  <div id="lightboxTouchArea" class="relative max-w-5xl mx-auto my-auto w-full h-[60vh] sm:h-[70vh] flex items-center justify-center touch-pan-y">
    <img
      id="lightboxModalImg"
      src={processedGallery[0]?.lightbox || coverImage}
      alt={processedGallery[0]?.alt || hotelTitle}
      loading="lazy"
      decoding="async"
      class="max-w-full max-h-full object-contain rounded-2xl shadow-2xl transition-opacity duration-200 pointer-events-none"
    />
    
    {totalPhotos > 1 && (
      <>
        <button
          type="button"
          id="lightboxPrevBtn"
          aria-label="Previous Photo"
          class="absolute left-2 sm:left-4 top-1/2 -translate-y-1/2 w-11 h-11 rounded-full bg-slate-900/80 hover:bg-slate-800 text-white flex items-center justify-center text-lg font-bold shadow-xl transition active:scale-95 cursor-pointer z-10"
        >
          ❮
        </button>
        <button
          type="button"
          id="lightboxNextBtn"
          aria-label="Next Photo"
          class="absolute right-2 sm:right-4 top-1/2 -translate-y-1/2 w-11 h-11 rounded-full bg-slate-900/80 hover:bg-slate-800 text-white flex items-center justify-center text-lg font-bold shadow-xl transition active:scale-95 cursor-pointer z-10"
        >
          ❯
        </button>
      </>
    )}
  </div>
</dialog>

<!-- CLIENT SCRIPT -->
<script>
  let abortCtrl: AbortController | null = null;

  function initHotelHeader() {
    if (abortCtrl) abortCtrl.abort();
    abortCtrl = new AbortController();
    const { signal } = abortCtrl;

    const modal = document.getElementById('heroLightboxModal') as HTMLDialogElement | null;
    const closeModalBtn = document.getElementById('closeHeroLightboxBtn');
    const modalImg = document.getElementById('lightboxModalImg') as HTMLImageElement | null;
    const modalIdxSpan = document.getElementById('lightboxModalIdx');
    const modalPrevBtn = document.getElementById('lightboxPrevBtn');
    const modalNextBtn = document.getElementById('lightboxNextBtn');
    const galleryTriggers = document.querySelectorAll('[data-gallery-trigger]');
    const touchArea = document.getElementById('lightboxTouchArea');

    const galleryScript = document.getElementById('hotel-gallery-data');
    let galleryData = { photos: [] as { src: string; alt: string }[] };
    try {
      galleryData = JSON.parse(galleryScript?.textContent || '{}');
    } catch {
      galleryData = { photos: [] };
    }

    const photosList = galleryData.photos || [];
    const count = photosList.length;
    let activeIdx = 0;
    let pushedByUs = false;

    function updateModalImage(idx: number) {
      if (!modalImg || count === 0) return;
      activeIdx = (idx + count) % count;
      const current = photosList[activeIdx];
      modalImg.src = current.src;
      modalImg.alt = current.alt || 'Hotel Photo';
      if (modalIdxSpan) modalIdxSpan.textContent = (activeIdx + 1).toString();
    }

    function hideLightboxDOM() {
      if (!modal) return;
      pushedByUs = false; // Reset pushed flag
      if (modal.open) {
        modal.close();
      }
    }

    function openLightbox(startIdx: number = 0) {
      if (!modal || count === 0) return;
      updateModalImage(startIdx);
      if (!modal.open) {
        modal.showModal();
      }

      if (window.location.hash !== '#gallery') {
        history.pushState({ modalOpen: true }, '', '#gallery');
        pushedByUs = true;
      }
    }

    function closeLightboxByUI() {
      if (pushedByUs) {
        pushedByUs = false;
        history.back();
      } else {
        if (window.location.hash === '#gallery') {
          history.replaceState(null, '', window.location.pathname + window.location.search);
        }
        hideLightboxDOM();
      }
    }

    window.addEventListener('popstate', () => {
      if (window.location.hash !== '#gallery') {
        hideLightboxDOM();
      } else if (modal && !modal.open) {
        openLightbox(activeIdx);
      }
    }, { signal });

    modal?.addEventListener('cancel', (e) => {
      e.preventDefault();
      closeLightboxByUI();
    }, { signal });

    window.addEventListener('keydown', (e: KeyboardEvent) => {
      if (!modal || !modal.open) return;
      if (e.key === 'ArrowLeft') updateModalImage(activeIdx - 1);
      if (e.key === 'ArrowRight') updateModalImage(activeIdx + 1);
    }, { signal });

    // ================= MOBILE TOUCH SWIPE SUPPORT =================
    let touchStartX = 0;
    let touchEndX = 0;

    touchArea?.addEventListener('touchstart', (e: TouchEvent) => {
      touchStartX = e.changedTouches[0].screenX;
    }, { passive: true, signal });

    touchArea?.addEventListener('touchend', (e: TouchEvent) => {
      touchEndX = e.changedTouches[0].screenX;
      const swipeDistance = touchEndX - touchStartX;
      if (Math.abs(swipeDistance) > 45) {
        if (swipeDistance < 0) updateModalImage(activeIdx + 1); // সোয়াইপ লেফট -> পরের ছবি
        else updateModalImage(activeIdx - 1); // সোয়াইপ রাইট -> আগের ছবি
      }
    }, { passive: true, signal });

    if (window.location.hash === '#gallery') {
      openLightbox(0);
    }

    galleryTriggers.forEach((trigger) => {
      const openTrigger = () => {
        const idx = parseInt(trigger.getAttribute('data-gallery-trigger') || '0', 10);
        openLightbox(idx);
      };
      trigger.addEventListener('click', openTrigger, { signal });
      trigger.addEventListener('keydown', (e: any) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          openTrigger();
        }
      }, { signal });
    });

    closeModalBtn?.addEventListener('click', closeLightboxByUI, { signal });
    
    modal?.addEventListener('click', (e) => {
      if (e.target === modal) closeLightboxByUI();
    }, { signal });

    modalPrevBtn?.addEventListener('click', () => updateModalImage(activeIdx - 1), { signal });
    modalNextBtn?.addEventListener('click', () => updateModalImage(activeIdx + 1), { signal });

    // ================= WISHLIST ENGINE =================
    const wishlistDataScript = document.getElementById('hotel-wishlist-data');
    let hotelInfo: any = null;
    try {
      hotelInfo = JSON.parse(wishlistDataScript?.textContent || '{}');
    } catch {
      hotelInfo = null;
    }

    if (hotelInfo && hotelInfo.slug) {
      const toggleBtns = document.querySelectorAll('.hotel-wishlist-toggle-btn');

      function getWishlist(): any[] {
        try {
          return JSON.parse(localStorage.getItem('gh_wishlist') || '[]');
        } catch {
          return [];
        }
      }

      function updateWishlistButtonUI() {
        const list = getWishlist();
        const isSaved = list.some((item: any) => item.slug === hotelInfo.slug);

        toggleBtns.forEach(btn => {
          btn.setAttribute('aria-pressed', String(isSaved));
          const heart = btn.querySelector('.wishlist-heart-icon');
          const label = btn.querySelector('.wishlist-label-text');

          if (isSaved) {
            heart?.classList.add('fill-red-600', 'stroke-red-600');
            heart?.classList.remove('fill-none', 'stroke-slate-900');
            if (label) label.textContent = 'Saved';
          } else {
            heart?.classList.remove('fill-red-600', 'stroke-red-600');
            heart?.classList.add('fill-none', 'stroke-slate-900');
            if (label) label.textContent = 'Save';
          }
        });

        const globalCount = document.getElementById('wishlist-count');
        if (globalCount) {
          if (list.length > 0) {
            globalCount.textContent = list.length.toString();
            globalCount.classList.remove('hidden');
          } else {
            globalCount.classList.add('hidden');
          }
        }
      }

      updateWishlistButtonUI();

      window.addEventListener('wishlist-updated', updateWishlistButtonUI, { signal });

      toggleBtns.forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          e.stopPropagation();

          let list = getWishlist();
          const existingIdx = list.findIndex((item: any) => item.slug === hotelInfo.slug);

          if (existingIdx > -1) {
            list.splice(existingIdx, 1);
          } else {
            list.push({
              title: hotelInfo.title,
              slug: hotelInfo.slug,
              price: hotelInfo.price,
              image: hotelInfo.image,
              url: hotelInfo.url
            });
          }

          localStorage.setItem('gh_wishlist', JSON.stringify(list));
          updateWishlistButtonUI();

          window.dispatchEvent(new CustomEvent('wishlist-updated'));
        }, { signal });
      });
    }
  }

  document.addEventListener('DOMContentLoaded', initHotelHeader);
  document.addEventListener('astro:page-load', initHotelHeader);
</script>
