---
// src/components/hotel/HotelHeader.astro (100% Speed Optimized & LCP Boosted)
interface Props {
  hotel: any;
}

const { hotel } = Astro.props;
const data = hotel?.data || {};

const hotelTitle = data.title || data.name || "Hotel Details";
const hotelCategory = data.category || "5-Star Luxury Stay";
const hotelLocation = data.location || "Main Gulshan Avenue, Gulshan 2, Dhaka 1212, Bangladesh";
const hotelImage = data.image || "https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&w=1200&q=80";
const officialSite = data.officialSite || "";
const hotelDescription = data.description || "Experience timeless luxury and exceptional Bangladeshi hospitality in the heart of Gulshan, Dhaka.";

// Button Controls from CMS (100% Admin Controllable)
const showViewPrices = data.enable_view_prices !== false; // Default true
const showOfficialSite = data.enable_official_site !== false && Boolean(officialSite); // Default true if link exists

// 30 Preset Typography & Color Styles for Hotel Title
const selectedStyle = data.title_style || "style_1";

const titleStyleMap: Record<string, string> = {
  style_1: "font-serif text-3xl sm:text-5xl lg:text-6xl font-black text-slate-900 tracking-tight leading-tight",
  style_2: "font-serif text-3xl sm:text-5xl lg:text-6xl font-black bg-gradient-to-r from-amber-600 via-yellow-500 to-amber-700 bg-clip-text text-transparent tracking-tight leading-tight",
  style_3: "font-serif text-3xl sm:text-5xl lg:text-6xl font-black bg-gradient-to-r from-emerald-800 via-teal-700 to-emerald-950 bg-clip-text text-transparent tracking-tight leading-tight",
  style_4: "font-sans text-3xl sm:text-5xl lg:text-6xl font-extrabold text-slate-900 uppercase tracking-wider leading-tight",
  style_5: "font-serif italic text-3xl sm:text-5xl lg:text-6xl font-extrabold text-slate-900 tracking-normal leading-tight",
  style_6: "font-serif text-3xl sm:text-5xl lg:text-6xl font-black text-slate-950 tracking-tighter leading-tight",
  style_7: "font-serif text-3xl sm:text-5xl lg:text-6xl font-black text-slate-900 drop-shadow-sm leading-tight",
  style_8: "font-sans text-3xl sm:text-5xl lg:text-6xl font-light text-slate-800 tracking-widest uppercase leading-tight",
  style_9: "font-serif text-3xl sm:text-5xl lg:text-6xl font-bold text-slate-900 border-b-2 border-amber-400 pb-2 inline-block leading-tight",
  style_10: "font-serif text-3xl sm:text-5xl lg:text-6xl font-black text-slate-900 decoration-emerald-500 underline underline-offset-8 decoration-4 leading-tight",
  style_11: "font-sans text-3xl sm:text-5xl lg:text-6xl font-black text-slate-900 tracking-tight leading-tight",
  style_12: "font-serif text-3xl sm:text-5xl lg:text-6xl font-bold text-amber-900 tracking-tight leading-tight",
  style_13: "font-serif text-3xl sm:text-5xl lg:text-6xl font-black text-[#0d3b23] tracking-tight leading-tight",
  style_14: "font-serif text-3xl sm:text-5xl lg:text-6xl font-normal text-slate-900 tracking-wide leading-tight",
  style_15: "font-sans text-3xl sm:text-5xl lg:text-6xl font-black text-slate-950 tracking-tighter uppercase leading-tight",
  style_16: "font-serif text-3xl sm:text-5xl lg:text-6xl font-black bg-gradient-to-r from-rose-700 via-amber-600 to-yellow-600 bg-clip-text text-transparent leading-tight",
  style_17: "font-serif text-3xl sm:text-5xl lg:text-6xl font-extrabold text-slate-800 tracking-tight leading-tight",
  style_18: "font-serif text-3xl sm:text-5xl lg:text-6xl font-black text-slate-900 border-l-4 border-emerald-600 pl-4 leading-tight",
  style_19: "font-serif text-3xl sm:text-5xl lg:text-6xl font-black text-slate-900 border-l-4 border-amber-500 pl-4 leading-tight",
  style_20: "font-sans text-3xl sm:text-5xl lg:text-6xl font-bold text-slate-900 tracking-normal leading-tight",
  style_21: "font-serif text-3xl sm:text-5xl lg:text-6xl font-black text-slate-900 tracking-tight leading-tight",
  style_22: "font-sans text-3xl sm:text-5xl lg:text-6xl font-black text-slate-900 tracking-widest uppercase leading-tight",
  style_23: "font-serif text-3xl sm:text-5xl lg:text-6xl font-black text-slate-900 border-b-4 border-amber-500/80 pb-2 inline-block leading-tight",
  style_24: "font-serif text-3xl sm:text-5xl lg:text-6xl font-bold text-slate-700 tracking-tight leading-tight",
  style_25: "font-serif text-3xl sm:text-5xl lg:text-6xl font-black text-stone-900 tracking-tight leading-tight",
  style_26: "font-serif text-3xl sm:text-5xl lg:text-6xl font-black text-teal-950 tracking-tight leading-tight",
  style_27: "font-sans text-3xl sm:text-5xl lg:text-6xl font-black text-black tracking-normal leading-tight",
  style_28: "font-serif italic text-3xl sm:text-5xl lg:text-6xl font-black text-slate-900 tracking-tight leading-tight",
  style_29: "font-serif text-3xl sm:text-5xl lg:text-6xl font-black text-slate-900 drop-shadow leading-tight",
  style_30: "font-serif text-3xl sm:text-5xl lg:text-6xl font-black text-amber-800 tracking-tight leading-tight"
};

const titleCssClass = titleStyleMap[selectedStyle] || titleStyleMap.style_1;

// IMAGE RESIZING & WEBP SPEED OPTIMIZER HELPER FUNCTION
function getOptimizedImageUrl(url: string, width = 800, quality = 80) {
  if (!url) return 'https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&w=800&q=80';
  if (url.includes('unsplash.com')) {
    const cleanUrl = url.split('?')[0];
    return `${cleanUrl}?auto=format&fit=crop&w=${width}&q=${quality}`;
  }
  return url;
}

// Raw Gallery Images
const rawGallery = (data.gallery && data.gallery.length > 0) 
  ? data.gallery 
  : [
      hotelImage,
      "https://images.unsplash.com/photo-1582719478250-c89cae4dc85b",
      "https://images.unsplash.com/photo-1542314831-068cd1dbfeeb",
      "https://images.unsplash.com/photo-1571896349842-33c89424de2d",
      "https://images.unsplash.com/photo-1512917774080-9991f1c4c750",
      "https://images.unsplash.com/photo-1618773928121-c32242e63f39",
      "https://images.unsplash.com/photo-1591088398332-8a7791972843"
    ];

const totalPhotos = rawGallery.length;
const remainingPhotos = totalPhotos > 4 ? totalPhotos - 4 : 0;

// High-Res & Thumbnail Optimized Arrays
const mainHeroUrl = getOptimizedImageUrl(rawGallery[0], 800, 80);
const thumbUrls = rawGallery.map((img: string) => getOptimizedImageUrl(img, 200, 70));
const lightboxUrls = rawGallery.map((img: string) => getOptimizedImageUrl(img, 1200, 85));
---

<!-- 1ST COMPONENT: HOTEL HERO BANNER (100% SPEED OPTIMIZED & WEBP COMPRESSED) -->
<section class="bg-[#F8FAF9] text-slate-900 pt-6 pb-10 px-4 sm:px-6 lg:px-10 max-w-[1680px] mx-auto border-b border-slate-200/80">
  <div class="space-y-6">
    
    <!-- TOP HEADER & TITLE AREA -->
    <div class="text-center max-w-4xl mx-auto space-y-3">
      
      <!-- Breadcrumbs -->
      <div class="flex items-center justify-center gap-2 text-xs text-slate-500 font-medium">
        <a href="/" class="hover:text-emerald-700 transition">Home</a>
        <span>›</span>
        <a href="/#hotels" class="hover:text-emerald-700 transition">Hotels</a>
        <span>›</span>
        <span class="text-slate-800 font-bold">{hotelTitle}</span>
      </div>

      <!-- Category Pill Badge -->
      {hotelCategory && (
        <div>
          <span class="bg-emerald-100/80 text-emerald-800 border border-emerald-300/80 text-[10px] sm:text-xs font-black uppercase tracking-widest px-3 py-1 rounded-full inline-block">
            {hotelCategory}
          </span>
        </div>
      )}

      <!-- Hotel Title with Selected 30 Typography Styles -->
      <h1 class={titleCssClass}>
        {hotelTitle}
      </h1>

      <!-- Location Line with Interactive Map Link -->
      {hotelLocation && (
        <p class="text-xs sm:text-sm text-slate-600 font-medium flex flex-wrap items-center justify-center gap-2">
          <span class="flex items-center gap-1">
            <svg class="w-4 h-4 fill-emerald-600 shrink-0" viewBox="0 0 24 24"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>
            <span>{hotelLocation}</span>
          </span>
          <a href="#location-map" class="text-emerald-800 font-black hover:underline inline-flex items-center gap-0.5">
            <span>View in a map</span>
            <span>➔</span>
          </a>
        </p>
      )}

      <!-- Action Buttons (Full Admin Control) -->
      {(showViewPrices || showOfficialSite) && (
        <div class="flex items-center justify-center gap-3 pt-3">
          {showViewPrices && (
            <a href="#about-and-rates" class="bg-[#0d3b23] hover:bg-[#061e14] text-white font-black text-xs sm:text-sm uppercase tracking-wider px-7 py-3 rounded-2xl shadow-lg transition hover:scale-105">
              View Prices ➔
            </a>
          )}

          {showOfficialSite && (
            <a href={officialSite} target="_blank" rel="noopener noreferrer" class="bg-white hover:bg-slate-100 text-slate-900 font-black text-xs sm:text-sm uppercase tracking-wider px-6 py-3 rounded-2xl transition border border-slate-300 hover:scale-105 flex items-center gap-1.5 shadow-sm">
              <span>Official Website</span>
              <span>↗</span>
            </a>
          )}
        </div>
      )}

    </div>

    <!-- RESPONSIVE HERO GALLERY (LCP PRIORITY MAIN IMAGE + 200PX LIGHTWEIGHT THUMBNAILS) -->
    <div class="max-w-5xl mx-auto space-y-3 pt-2">
      
      <!-- 1. MAIN LARGE HERO COVER PHOTO (LCP PRIORITY EAGER LOADED) -->
      <div class="relative w-full h-[280px] xs:h-[320px] sm:h-[420px] lg:h-[480px] rounded-2xl sm:rounded-3xl overflow-hidden shadow-md group border border-slate-200/80 bg-slate-900">
        <img 
          id="heroMainViewImg" 
          src={mainHeroUrl} 
          alt={hotelTitle} 
          loading="eager"
          fetchpriority="high"
          decoding="async"
          data-images={JSON.stringify(lightboxUrls)}
          class="w-full h-full object-cover transition-all duration-300 group-hover:scale-105 cursor-pointer" 
        />

        <!-- Left/Right Arrow Navigation over Main Image -->
        {totalPhotos > 1 && (
          <button id="heroPrevImgBtn" aria-label="Previous Image" class="absolute left-3 top-1/2 -translate-y-1/2 w-9 h-9 sm:w-11 sm:h-11 rounded-full bg-slate-950/70 hover:bg-slate-950 text-white backdrop-blur-md border border-white/20 flex items-center justify-center transition active:scale-95 text-base sm:text-lg font-bold cursor-pointer z-10">
            ❮
          </button>
        )}

        {totalPhotos > 1 && (
          <button id="heroNextImgBtn" aria-label="Next Image" class="absolute right-3 top-1/2 -translate-y-1/2 w-9 h-9 sm:w-11 sm:h-11 rounded-full bg-slate-950/70 hover:bg-slate-950 text-white backdrop-blur-md border border-white/20 flex items-center justify-center transition active:scale-95 text-base sm:text-lg font-bold cursor-pointer z-10">
            ❯
          </button>
        )}

        <!-- Photo Counter Badge -->
        <div class="absolute bottom-3 right-3 bg-slate-950/85 backdrop-blur-md text-white text-xs font-bold px-3 py-1 rounded-full shadow border border-white/20">
          <span id="heroCurrentIdx">1</span> / <span>{totalPhotos}</span>
        </div>
      </div>

      <!-- 2. EXACTLY 5 SMALL THUMBNAIL PHOTOS IN 1 ROW (LIGHTWEIGHT 200PX WEBP) -->
      <div class="grid grid-cols-5 gap-2 sm:gap-3">
        {thumbUrls.slice(0, 4).map((img: string, idx: number) => (
          <button 
            class="hero-thumb-btn h-16 sm:h-20 lg:h-24 rounded-xl sm:rounded-2xl overflow-hidden relative border-2 border-transparent hover:border-emerald-600 transition cursor-pointer shrink-0 group ${idx === 0 ? 'border-emerald-600' : ''}"
            data-index={idx}
          >
            <img 
              src={img} 
              alt={`Thumb ${idx + 1}`} 
              width="200"
              height="150"
              loading="lazy" 
              decoding="async" 
              class="w-full h-full object-cover group-hover:scale-110 transition duration-300" 
            />
          </button>
        ))}

        <!-- 5th Thumbnail with 'More Photos' Pop-up Badge -->
        {thumbUrls[4] && (
          <button 
            id="triggerFullGalleryBtn"
            class="h-16 sm:h-20 lg:h-24 rounded-xl sm:rounded-2xl overflow-hidden relative border-2 border-transparent hover:border-emerald-600 transition cursor-pointer shrink-0 group text-white"
            data-index="4"
          >
            <img 
              src={thumbUrls[4]} 
              alt="More Photos" 
              width="200"
              height="150"
              loading="lazy" 
              decoding="async" 
              class="w-full h-full object-cover group-hover:scale-110 transition duration-300" 
            />
            <div class="absolute inset-0 bg-slate-950/80 backdrop-blur-[2px] flex flex-col items-center justify-center p-1 text-center">
              <span class="text-xs sm:text-base font-black text-white">+{remainingPhotos > 0 ? remainingPhotos : totalPhotos}</span>
              <span class="text-[9px] sm:text-[11px] font-bold text-slate-300">Photos</span>
            </div>
          </button>
        )}
      </div>

    </div>

  </div>
</section>

<!-- FULL SCREEN PHOTO LIGHTBOX POP-UP MODAL -->
<div id="heroLightboxModal" class="fixed inset-0 z-50 bg-slate-950/90 backdrop-blur-md hidden flex flex-col justify-between p-4 sm:p-8 text-white">
  <div class="flex items-center justify-between max-w-6xl mx-auto w-full border-b border-slate-800 pb-4">
    <div>
      <h3 class="text-lg font-black font-serif text-white">{hotelTitle}</h3>
      <span class="text-xs text-slate-400">Photo Gallery</span>
    </div>
    <div class="flex items-center gap-4">
      <span class="text-xs font-bold bg-slate-800 px-3 py-1 rounded-full border border-slate-700">
        <span id="lightboxModalIdx">1</span> / <span>{totalPhotos}</span>
      </span>
      <button id="closeHeroLightboxBtn" class="text-slate-400 hover:text-white text-3xl font-bold p-1 cursor-pointer">&times;</button>
    </div>
  </div>

  <div class="relative max-w-5xl mx-auto my-auto w-full h-[60vh] sm:h-[70vh] flex items-center justify-center">
    <img id="lightboxModalImg" src={lightboxUrls[0]} alt={hotelTitle} class="max-w-full max-h-full object-contain rounded-2xl shadow-2xl" />
    <button id="lightboxPrevBtn" class="absolute left-2 sm:left-4 top-1/2 -translate-y-1/2 w-10 h-10 rounded-full bg-slate-900/80 hover:bg-slate-800 text-white flex items-center justify-center text-lg font-bold shadow-xl transition cursor-pointer">❮</button>
    <button id="lightboxNextBtn" class="absolute right-2 sm:right-4 top-1/2 -translate-y-1/2 w-10 h-10 rounded-full bg-slate-900/80 hover:bg-slate-800 text-white flex items-center justify-center text-lg font-bold shadow-xl transition cursor-pointer">❯</button>
  </div>
</div>

<!-- CLIENT SCRIPT WITH CLICK LISTENERS & MOBILE BACK-BUTTON SAFETY -->
<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const mainImg = document.getElementById('heroMainViewImg');
    const prevBtn = document.getElementById('heroPrevImgBtn');
    const nextBtn = document.getElementById('heroNextImgBtn');
    const currentIdxSpan = document.getElementById('heroCurrentIdx');
    const thumbBtns = document.querySelectorAll('.hero-thumb-btn');

    const modal = document.getElementById('heroLightboxModal');
    const openModalBtn = document.getElementById('triggerFullGalleryBtn');
    const closeModalBtn = document.getElementById('closeHeroLightboxBtn');
    const modalImg = document.getElementById('lightboxModalImg');
    const modalIdxSpan = document.getElementById('lightboxModalIdx');
    const modalPrevBtn = document.getElementById('lightboxPrevBtn');
    const modalNextBtn = document.getElementById('lightboxNextBtn');

    if (mainImg) {
      const images = JSON.parse(mainImg.dataset.images || '[]');
      let activeIdx = 0;

      function updateMainImage(idx) {
        if (!mainImg || !images.length) return;
        activeIdx = (idx + images.length) % images.length;
        mainImg.src = images[activeIdx];
        if (currentIdxSpan) currentIdxSpan.textContent = (activeIdx + 1).toString();

        thumbBtns.forEach((btn, i) => {
          if (i === activeIdx) {
            btn.classList.add('border-emerald-600');
            btn.classList.remove('border-transparent');
          } else {
            btn.classList.add('border-transparent');
            btn.classList.remove('border-emerald-600');
          }
        });
      }

      if (prevBtn) prevBtn.addEventListener('click', (e) => { e.stopPropagation(); updateMainImage(activeIdx - 1); });
      if (nextBtn) nextBtn.addEventListener('click', (e) => { e.stopPropagation(); updateMainImage(activeIdx + 1); });

      thumbBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          const idx = parseInt(btn.getAttribute('data-index') || '0', 10);
          updateMainImage(idx);
        });
      });

      function openModalSafe(startIdx) {
        if (!modal) return;
        updateModalImage(startIdx !== undefined ? startIdx : activeIdx);
        modal.classList.remove('hidden');
        try {
          history.pushState({ modalOpen: true }, '');
        } catch (e) {}
      }

      function closeModalSafe() {
        if (!modal) return;
        modal.classList.add('hidden');
      }

      window.addEventListener('popstate', () => {
        if (modal && !modal.classList.contains('hidden')) {
          modal.classList.add('hidden');
        }
      });

      mainImg.addEventListener('click', () => {
        openModalSafe(activeIdx);
      });

      if (openModalBtn) {
        openModalBtn.addEventListener('click', () => {
          openModalSafe(4);
        });
      }

      if (closeModalBtn) {
        closeModalBtn.addEventListener('click', () => closeModalSafe());
      }

      if (modal) {
        modal.addEventListener('click', (e) => {
          if (e.target === modal) closeModalSafe();
        });
      }

      function updateModalImage(idx) {
        if (!modalImg || !images.length) return;
        activeIdx = (idx + images.length) % images.length;
        modalImg.src = images[activeIdx];
        if (modalIdxSpan) modalIdxSpan.textContent = (activeIdx + 1).toString();
      }

      if (modalPrevBtn) modalPrevBtn.addEventListener('click', () => updateModalImage(activeIdx - 1));
      if (modalNextBtn) modalNextBtn.addEventListener('click', () => updateModalImage(activeIdx + 1));
    }
  });
</script>
