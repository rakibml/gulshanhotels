---
// src/components/hotel/HotelHeader.astro (100% Dynamic, 1000% Speed & SEO Optimized, Back-Button Safe, Pure White Background)
interface Props {
  hotel: any;
}

const { hotel } = Astro.props;
const data = hotel?.data || {};

// 1. Pure Dynamic CMS Data
const hotelTitle = data.title || data.name || "Hotel Details";
const hotelCategory = data.category;
const hotelLocation = data.location;
const hotelImage = data.image || "https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&w=1200&q=80";
const officialSite = data.officialSite || "";
const hotelDescription = data.description;

// 2. Button Controls from CMS (100% Admin Controllable)
const showViewPrices = data.enable_view_prices !== false;
const showOfficialSite = data.enable_official_site !== false && Boolean(officialSite);

// 3. 30 Preset Typography & Color Styles for Hotel Title (H1)
const selectedStyle = data.title_style || "style_1";

const titleStyleMap: Record<string, string> = {
  style_1: "font-serif text-3xl sm:text-5xl lg:text-6xl font-black text-slate-900 tracking-tight leading-tight",
  style_2: "font-serif text-3xl sm:text-5xl lg:text-6xl font-black bg-gradient-to-r from-amber-600 via-yellow-500 to-amber-700 bg-clip-text text-transparent tracking-tight leading-tight",
  style_3: "font-serif text-3xl sm:text-5xl lg:text-6xl font-black bg-gradient-to-r from-emerald-800 via-teal-700 to-emerald-950 bg-clip-text text-transparent tracking-tight leading-tight",
  style_4: "font-sans text-3xl sm:text-5xl lg:text-6xl font-extrabold text-slate-900 uppercase tracking-wider leading-tight",
  style_5: "font-serif italic text-3xl sm:text-5xl lg:text-6xl font-extrabold text-slate-900 tracking-normal leading-tight",
  style_6: "font-serif text-3xl sm:text-5xl lg:text-6xl font-black text-slate-950 tracking-tighter leading-tight",
  style_7: "font-serif text-3xl sm:text-5xl lg:text-6xl font-black text-slate-900 drop-shadow-sm leading-tight",
  style_8: "font-sans text-3xl sm:text-5xl lg:text-6xl font-light text-slate-800 tracking-widest uppercase leading-tight",
  style_9: "font-serif text-3xl sm:text-5xl lg:text-6xl font-bold text-slate-900 border-b-2 border-amber-400 pb-2 inline-block leading-tight",
  style_10: "font-serif text-3xl sm:text-5xl lg:text-6xl font-black text-slate-900 decoration-emerald-500 underline underline-offset-8 decoration-4 leading-tight",
  style_11: "font-sans text-3xl sm:text-5xl lg:text-6xl font-black text-slate-900 tracking-tight leading-tight",
  style_12: "font-serif text-3xl sm:text-5xl lg:text-6xl font-bold text-amber-900 tracking-tight leading-tight",
  style_13: "font-serif text-3xl sm:text-5xl lg:text-6xl font-black text-[#0d3b23] tracking-tight leading-tight",
  style_14: "font-serif text-3xl sm:text-5xl lg:text-6xl font-normal text-slate-900 tracking-wide leading-tight",
  style_15: "font-sans text-3xl sm:text-5xl lg:text-6xl font-black text-slate-950 tracking-tighter uppercase leading-tight",
  style_16: "font-serif text-3xl sm:text-5xl lg:text-6xl font-black bg-gradient-to-r from-rose-700 via-amber-600 to-yellow-600 bg-clip-text text-transparent leading-tight",
  style_17: "font-serif text-3xl sm:text-5xl lg:text-6xl font-extrabold text-slate-800 tracking-tight leading-tight",
  style_18: "font-serif text-3xl sm:text-5xl lg:text-6xl font-black text-slate-900 border-l-4 border-emerald-600 pl-4 leading-tight",
  style_19: "font-serif text-3xl sm:text-5xl lg:text-6xl font-black text-slate-900 border-l-4 border-amber-500 pl-4 leading-tight",
  style_20: "font-sans text-3xl sm:text-5xl lg:text-6xl font-bold text-slate-900 tracking-normal leading-tight",
  style_21: "font-serif text-3xl sm:text-5xl lg:text-6xl font-black text-slate-900 tracking-tight leading-tight",
  style_22: "font-sans text-3xl sm:text-5xl lg:text-6xl font-black text-slate-900 tracking-widest uppercase leading-tight",
  style_23: "font-serif text-3xl sm:text-5xl lg:text-6xl font-black text-slate-900 border-b-4 border-amber-500/80 pb-2 inline-block leading-tight",
  style_24: "font-serif text-3xl sm:text-5xl lg:text-6xl font-bold text-slate-700 tracking-tight leading-tight",
  style_25: "font-serif text-3xl sm:text-5xl lg:text-6xl font-black text-stone-900 tracking-tight leading-tight",
  style_26: "font-serif text-3xl sm:text-5xl lg:text-6xl font-black text-teal-950 tracking-tight leading-tight",
  style_27: "font-sans text-3xl sm:text-5xl lg:text-6xl font-black text-black tracking-normal leading-tight",
  style_28: "font-serif italic text-3xl sm:text-5xl lg:text-6xl font-black text-slate-900 tracking-tight leading-tight",
  style_29: "font-serif text-3xl sm:text-5xl lg:text-6xl font-black text-slate-900 drop-shadow leading-tight",
  style_30: "font-serif text-3xl sm:text-5xl lg:text-6xl font-black text-amber-800 tracking-tight leading-tight"
};

const titleCssClass = titleStyleMap[selectedStyle] || titleStyleMap.style_1;

// Image Resizer Helper
function getOptimizedImageUrl(url: string, width = 800, quality = 80) {
  if (!url) return '';
  if (url.includes('unsplash.com')) {
    const cleanUrl = url.split('?')[0];
    return `${cleanUrl}?auto=format&fit=crop&w=${width}&q=${quality}&fm=webp`;
  }
  return url;
}

// Pure Dynamic Gallery Images
const rawGallery: string[] = (Array.isArray(data.gallery) && data.gallery.length > 0)
  ? data.gallery
  : (hotelImage ? [hotelImage] : []);

const totalPhotos = rawGallery.length;
const remainingPhotos = totalPhotos > 5 ? totalPhotos - 5 : 0;

// Dynamic Grid Layout based on thumbnail count
const gridColsClass = totalPhotos >= 5
  ? 'grid-cols-5'
  : totalPhotos === 4
    ? 'grid-cols-4'
    : totalPhotos === 3
      ? 'grid-cols-3'
      : 'grid-cols-2';

// Responsive Image Sets
const heroMobileUrls = rawGallery.map((img: string) => getOptimizedImageUrl(img, 640, 75));
const heroDesktopUrls = rawGallery.map((img: string) => getOptimizedImageUrl(img, 1200, 80));
const thumbUrls = rawGallery.map((img: string) => getOptimizedImageUrl(img, 200, 70));
const lightboxUrls = rawGallery.map((img: string) => getOptimizedImageUrl(img, 1600, 85));

// Gallery Payload for JS Client
const galleryPayload = {
  mobile: heroMobileUrls,
  desktop: heroDesktopUrls,
  lightbox: lightboxUrls
};

// Dynamic Domain Fallback for SEO Schema
const siteUrl = Astro.site ? Astro.site.origin : (Astro.url ? Astro.url.origin : 'https://gulshanhotels.com');
---

<!-- EARLY LCP PRECONNECT & PRELOAD DIRECTIVES -->
{totalPhotos > 0 && (
  <>
    <link rel="preconnect" href="https://images.unsplash.com" crossorigin />
    <link rel="preconnect" href="https://picsum.photos" crossorigin />
    <link
      rel="preload"
      as="image"
      href={heroDesktopUrls[0]}
      imagesrcset={`${heroMobileUrls[0]} 640w, ${heroDesktopUrls[0]} 1200w`}
      imagesizes="(max-width: 1024px) 100vw, 1024px"
      fetchpriority="high"
    />
  </>
)}

<!-- 1ST COMPONENT: HOTEL HERO BANNER (PURE WHITE BACKGROUND) -->
<section class="bg-white text-slate-900 pt-6 pb-10 px-4 sm:px-6 lg:px-10 max-w-[1680px] mx-auto border-b border-slate-200">
  <div class="space-y-6">

    <!-- TOP HEADER & TITLE AREA -->
    <div class="text-center max-w-4xl mx-auto space-y-3">

      <!-- Breadcrumbs Navigation -->
      <nav aria-label="Breadcrumb" class="flex items-center justify-center gap-2 text-xs text-slate-500 font-medium">
        <a href="/" class="hover:text-emerald-700 transition">Home</a>
        <span>›</span>
        <a href="/#hotels" class="hover:text-emerald-700 transition">Hotels</a>
        <span>›</span>
        <span class="text-slate-800 font-bold" aria-current="page">{hotelTitle}</span>
      </nav>

      <!-- Category Pill Badge -->
      {hotelCategory && (
        <div>
          <span class="bg-emerald-50 text-emerald-800 border border-emerald-200 text-[10px] sm:text-xs font-black uppercase tracking-widest px-3 py-1 rounded-full inline-block">
            {hotelCategory}
          </span>
        </div>
      )}

      <!-- PRIMARY SEO HEADING (H1) -->
      <h1 class={titleCssClass}>
        {hotelTitle}
      </h1>

      <!-- Location Line with Interactive Map Link -->
      {hotelLocation && (
        <p class="text-xs sm:text-sm text-slate-600 font-medium flex flex-wrap items-center justify-center gap-2">
          <span class="flex items-center gap-1">
            <svg class="w-4 h-4 fill-emerald-600 shrink-0" viewBox="0 0 24 24"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>
            <span>{hotelLocation}</span>
          </span>
          <a href="#location-map" class="text-emerald-800 font-black hover:underline inline-flex items-center gap-0.5">
            <span>View in a map</span>
            <span>➔</span>
          </a>
        </p>
      )}

      <!-- Short Tagline Description -->
      {hotelDescription && (
        <p class="text-xs sm:text-sm text-slate-600 max-w-xl mx-auto leading-relaxed">
          {hotelDescription}
        </p>
      )}

      <!-- Action Buttons -->
      {(showViewPrices || showOfficialSite) && (
        <div class="flex items-center justify-center gap-3 pt-3">
          {showViewPrices && (
            <a href="#rates-card" class="bg-[#0d3b23] hover:bg-[#061e14] text-white font-black text-xs sm:text-sm uppercase tracking-wider px-7 py-3 rounded-2xl shadow-lg transition hover:scale-105">
              View Prices ➔
            </a>
          )}

          {showOfficialSite && (
            <a href={officialSite} target="_blank" rel="noopener noreferrer" class="bg-white hover:bg-slate-50 text-slate-900 font-black text-xs sm:text-sm uppercase tracking-wider px-6 py-3 rounded-2xl transition border border-slate-300 hover:scale-105 flex items-center gap-1.5 shadow-sm">
              <span>Official Website</span>
              <span>↗</span>
            </a>
          )}
        </div>
      )}

    </div>

   <!-- RESPONSIVE HERO GALLERY (COLLAGE PATTERN) -->
    {totalPhotos > 0 && (
      <div class="max-w-6xl mx-auto pt-2">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-1 h-[280px] xs:h-[340px] sm:h-[400px] md:h-[450px] lg:h-[480px] rounded-2xl sm:rounded-3xl overflow-hidden shadow-sm bg-slate-100">
          
          <!-- 1. LEFT MAIN LARGE IMAGE (Spans 2 cols on desktop) -->
          <div 
            class={`relative h-full overflow-hidden group cursor-pointer ${totalPhotos >= 2 ? 'md:col-span-2' : 'md:col-span-3'}`}
            data-gallery-trigger="0"
          >
            <img
              id="heroMainViewImg"
              src={heroDesktopUrls[0]}
              srcset={`${heroMobileUrls[0]} 640w, ${heroDesktopUrls[0]} 1200w`}
              sizes="(max-width: 768px) 100vw, (max-width: 1200px) 66vw, 850px"
              width="850"
              height="480"
              alt={hotelTitle}
              loading="eager"
              fetchpriority="high"
              decoding="async"
              class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
            />

            <!-- Photo Count Pill Badge (Bottom-Right of Main Image) -->
            <button
              type="button"
              id="heroGalleryBadgeBtn"
              aria-label={`View all ${totalPhotos} photos`}
              class="absolute bottom-3 sm:bottom-4 right-3 sm:right-4 bg-[#062c19]/90 hover:bg-[#062c19] text-white backdrop-blur-md px-3.5 py-1.5 rounded-full flex items-center gap-2 shadow-lg border border-white/20 transition hover:scale-105 z-10 cursor-pointer"
            >
              <!-- Photo Gallery Icon -->
              <svg class="w-4 h-4 fill-none stroke-currentColor stroke-2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
                <rect width="18" height="18" x="3" y="3" rx="2" ry="2"/>
                <circle cx="9" cy="9" r="2"/>
                <path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/>
              </svg>
              <span class="text-xs sm:text-sm font-bold tracking-wide">{totalPhotos}</span>
            </button>
          </div>

          <!-- 2. RIGHT SIDE: 2 STACKED IMAGES -->
          {totalPhotos >= 2 && (
            <div class="hidden md:grid grid-rows-2 gap-1 h-full">
              <!-- Top-Right Image -->
              <div 
                class="relative h-full overflow-hidden group cursor-pointer"
                data-gallery-trigger="1"
              >
                <img
                  src={heroDesktopUrls[1]}
                  alt={`${hotelTitle} Photo 2`}
                  width="400"
                  height="240"
                  loading="eager"
                  decoding="async"
                  class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                />
              </div>

              <!-- Bottom-Right Image -->
              {totalPhotos >= 3 && (
                <div 
                  class="relative h-full overflow-hidden group cursor-pointer"
                  data-gallery-trigger="2"
                >
                  <img
                    src={heroDesktopUrls[2]}
                    alt={`${hotelTitle} Photo 3`}
                    width="400"
                    height="240"
                    loading="lazy"
                    decoding="async"
                    class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                  />
                </div>
              )}
            </div>
          )}

        </div>
      </div>
    )}

  </div>
</section>

<!-- HIDDEN SCRIPT TAG FOR OPTIMIZED GALLERY DATA -->
<script type="application/json" id="hotel-gallery-data" set:html={JSON.stringify(galleryPayload)}></script>

<!-- FULL SCREEN PHOTO LIGHTBOX MODAL -->
<div
  id="heroLightboxModal"
  role="dialog"
  aria-modal="true"
  aria-label="Image Gallery Lightbox"
  class="fixed inset-0 z-50 bg-slate-950/95 backdrop-blur-md hidden flex-col justify-between p-4 sm:p-8 text-white select-none"
>
  <div class="flex items-center justify-between max-w-6xl mx-auto w-full border-b border-slate-800 pb-4">
    <div>
      <h3 class="text-base sm:text-lg font-black font-serif text-white">{hotelTitle}</h3>
      <span class="text-xs text-slate-400">Photo Gallery</span>
    </div>
    <div class="flex items-center gap-4">
      <span class="text-xs font-bold bg-slate-800 px-3 py-1 rounded-full border border-slate-700">
        <span id="lightboxModalIdx">1</span> / <span>{totalPhotos}</span>
      </span>
      <button
        type="button"
        id="closeHeroLightboxBtn"
        aria-label="Close Lightbox"
        class="text-slate-400 hover:text-white text-3xl font-bold p-1 cursor-pointer transition active:scale-90"
      >
        &times;
      </button>
    </div>
  </div>

  <div class="relative max-w-5xl mx-auto my-auto w-full h-[60vh] sm:h-[70vh] flex items-center justify-center">
    <img
      id="lightboxModalImg"
      src={lightboxUrls[0]}
      alt={hotelTitle}
      loading="lazy"
      decoding="async"
      class="max-w-full max-h-full object-contain rounded-2xl shadow-2xl transition-opacity duration-200"
    />
    
    {totalPhotos > 1 && (
      <>
        <button
          type="button"
          id="lightboxPrevBtn"
          aria-label="Previous Lightbox Photo"
          class="absolute left-2 sm:left-4 top-1/2 -translate-y-1/2 w-11 h-11 rounded-full bg-slate-900/80 hover:bg-slate-800 text-white flex items-center justify-center text-lg font-bold shadow-xl transition active:scale-95 cursor-pointer z-10"
        >
          ❮
        </button>
        <button
          type="button"
          id="lightboxNextBtn"
          aria-label="Next Lightbox Photo"
          class="absolute right-2 sm:right-4 top-1/2 -translate-y-1/2 w-11 h-11 rounded-full bg-slate-900/80 hover:bg-slate-800 text-white flex items-center justify-center text-lg font-bold shadow-xl transition active:scale-95 cursor-pointer z-10"
        >
          ❯
        </button>
      </>
    )}
  </div>
</div>

<!-- CLIENT SCRIPT -->
<script>
  let abortCtrl: AbortController | null = null;

  function initHotelGallery() {
    if (abortCtrl) abortCtrl.abort();
    abortCtrl = new AbortController();
    const { signal } = abortCtrl;

    const modal = document.getElementById('heroLightboxModal');
    const closeModalBtn = document.getElementById('closeHeroLightboxBtn');
    const modalImg = document.getElementById('lightboxModalImg') as HTMLImageElement | null;
    const modalIdxSpan = document.getElementById('lightboxModalIdx');
    const modalPrevBtn = document.getElementById('lightboxPrevBtn');
    const modalNextBtn = document.getElementById('lightboxNextBtn');
    const galleryTriggers = document.querySelectorAll('[data-gallery-trigger]');
    const badgeBtn = document.getElementById('heroGalleryBadgeBtn');

    const galleryScript = document.getElementById('hotel-gallery-data');
    let gallery = { mobile: [] as string[], desktop: [] as string[], lightbox: [] as string[] };
    try {
      gallery = JSON.parse(galleryScript?.textContent || '{}');
    } catch {
      gallery = { mobile: [], desktop: [], lightbox: [] };
    }

    const count = gallery.lightbox?.length || 0;
    if (count === 0) return;

    let activeIdx = 0;

    function toggleBodyScroll(disable: boolean) {
      document.body.style.overflow = disable ? 'hidden' : '';
    }

    function updateModalImage(idx: number) {
      if (!modalImg) return;
      activeIdx = (idx + count) % count;
      modalImg.src = gallery.lightbox[activeIdx];
      if (modalIdxSpan) modalIdxSpan.textContent = (activeIdx + 1).toString();
    }

    function hideLightboxDOM() {
      if (!modal) return;
      modal.classList.add('hidden');
      modal.classList.remove('flex');
      toggleBodyScroll(false);
    }

    function openLightbox(startIdx: number = 0) {
      if (!modal) return;
      updateModalImage(startIdx);
      
      modal.classList.remove('hidden');
      modal.classList.add('flex');
      toggleBodyScroll(true);

      if (window.location.hash !== '#gallery') {
        history.pushState({ modalOpen: true }, '', '#gallery');
      }
    }

    function closeLightboxByUI() {
      if (window.location.hash === '#gallery') {
        history.back();
      } else {
        hideLightboxDOM();
      }
    }

    window.addEventListener('popstate', () => {
      if (window.location.hash !== '#gallery') {
        hideLightboxDOM();
      } else if (modal && modal.classList.contains('hidden')) {
        openLightbox(activeIdx);
      }
    }, { signal });

    window.addEventListener('keydown', (e: KeyboardEvent) => {
      if (!modal || modal.classList.contains('hidden')) return;

      if (e.key === 'Escape') closeLightboxByUI();
      if (e.key === 'ArrowLeft') updateModalImage(activeIdx - 1);
      if (e.key === 'ArrowRight') updateModalImage(activeIdx + 1);
    }, { signal });

    if (window.location.hash === '#gallery') {
      openLightbox(0);
    }

    // Bind click events to collage items
    galleryTriggers.forEach((trigger) => {
      trigger.addEventListener('click', () => {
        const idx = parseInt(trigger.getAttribute('data-gallery-trigger') || '0', 10);
        openLightbox(idx);
      });
    });

    badgeBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      openLightbox(0);
    });

    closeModalBtn?.addEventListener('click', closeLightboxByUI);

    modal?.addEventListener('click', (e) => {
      if (e.target === modal) closeLightboxByUI();
    });

    modalPrevBtn?.addEventListener('click', () => updateModalImage(activeIdx - 1));
    modalNextBtn?.addEventListener('click', () => updateModalImage(activeIdx + 1));
  }

  document.addEventListener('DOMContentLoaded', initHotelGallery);
  document.addEventListener('astro:page-load', initHotelGallery);
</script>
