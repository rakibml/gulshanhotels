---
// src/components/hotel/HotelHeader.astro (100% Dynamic, Clean Header without Price/Deal Option)
interface Props {
  hotel: any;
}

const { hotel } = Astro.props;
const data = hotel?.data || {};

// ================= 1. HOTEL BASIC INFO & CLEAN SLUG =================
const hotelTitle = (data.title || data.name || "").trim();
const hotelLocation = (data.location || "").trim();
const rawSlug = String(data.slug || hotel?.slug || hotel?.id || "").trim();
const hotelSlug = rawSlug.replace(/\.(md|mdx)$/, '').split('/').pop()?.toLowerCase() || "";

const searchTitle = hotelTitle.toLowerCase();
const searchSlug = hotelSlug.toLowerCase();
const isVerified = data.is_verified !== false;

// ================= 2. DYNAMIC REVIEWS CALCULATION =================
let rawReviewsList: any[] = [];
try {
  const globFiles = import.meta.glob('/src/content/reviews/*.{md,mdx}', { eager: true });
  const entries = Object.values(globFiles);
  
  if (entries.length > 0) {
    rawReviewsList = entries.map((item: any) => item?.frontmatter || item?.data || item || {});
  } else {
    const relFiles = import.meta.glob('../../content/reviews/*.{md,mdx}', { eager: true });
    rawReviewsList = Object.values(relFiles).map((item: any) => item?.frontmatter || item?.data || item || {});
  }
} catch (e) {
  rawReviewsList = [];
}

const approvedCmsReviews = rawReviewsList.filter((item: any) => {
  if (!item) return false;
  const isApproved = item.approved === true || String(item.approved).trim().toLowerCase() === 'true';
  if (!isApproved) return false;

  const rSlug = String(item.slug || item.hotelSlug || item.hotel_slug || '').replace(/\.(md|mdx)$/, '').split('/').pop()?.trim().toLowerCase() || "";
  const rId = String(item.id || '').replace(/\.(md|mdx)$/, '').split('/').pop()?.trim().toLowerCase() || "";
  const rHotel = String(item.hotel || item.hotelTitle || item.hotel_name || '').trim().toLowerCase();

  const matchSlug = searchSlug !== "" && (rSlug === searchSlug || rId === searchSlug || rHotel === searchSlug);
  const matchTitle = searchTitle !== "" && (rHotel === searchTitle);

  return matchSlug || matchTitle;
});

const hotelEmbeddedReviews = Array.isArray(data.reviews) ? data.reviews : [];
const combinedReviews = [...approvedCmsReviews, ...hotelEmbeddedReviews].filter(
  (r: any) => String(r.comment || r.review || r.body || '').trim().length > 1
);

const reviewsCount = combinedReviews.length;
const avgRatingNum = reviewsCount > 0 
  ? (combinedReviews.reduce((sum: number, r: any) => sum + (Number(r.rating) || 5), 0) / reviewsCount)
  : (data.rating ? Number(data.rating) : 0);
const avgRating = avgRatingNum > 0 ? avgRatingNum.toFixed(1) : "";

const hotelRanking = (data.ranking || data.ranking_text || "").trim();
const locationMapUrl = data.map_url || "#location-map";

// ================= 3. GALLERY & LCP OPTIMIZATION =================
const hotelImage = data.image || "https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&w=1200&q=80";

function getOptimizedImageUrl(url: string, width = 800, quality = 80) {
  if (!url) return '';
  if (url.includes('unsplash.com')) {
    const cleanUrl = url.split('?')[0];
    return `${cleanUrl}?auto=format&fit=crop&w=${width}&q=${quality}&fm=webp`;
  }
  return url;
}

const rawGallery: string[] = (Array.isArray(data.gallery) && data.gallery.length > 0)
  ? data.gallery
  : (hotelImage ? [hotelImage] : []);

const totalPhotos = rawGallery.length;

const heroMobileUrls = rawGallery.map((img: string) => getOptimizedImageUrl(img, 640, 75));
const heroDesktopUrls = rawGallery.map((img: string) => getOptimizedImageUrl(img, 1200, 80));
const lightboxUrls = rawGallery.map((img: string) => getOptimizedImageUrl(img, 1600, 85));

const galleryPayload = {
  mobile: heroMobileUrls,
  desktop: heroDesktopUrls,
  lightbox: lightboxUrls
};
---

<!-- EARLY LCP PRELOAD DIRECTIVE -->
{totalPhotos > 0 && (
  <>
    <link rel="preconnect" href="https://images.unsplash.com" crossorigin />
    <link
      rel="preload"
      as="image"
      href={heroDesktopUrls[0]}
      imagesrcset={`${heroMobileUrls[0]} 640w, ${heroDesktopUrls[0]} 1200w`}
      imagesizes="(max-width: 768px) 100vw, 850px"
      fetchpriority="high"
    />
  </>
)}

<!-- MAIN HOTEL HEADER & GALLERY SECTION -->
<section class="bg-white text-slate-900 pt-6 pb-8 px-4 sm:px-6 lg:px-8 max-w-[1550px] mx-auto border-b border-slate-200">
  <div class="max-w-7xl mx-auto space-y-4">

    <!-- ================= 1. HEADER INFO AREA ================= -->
    <div class="space-y-3 pb-2">
      
      <!-- ROW 1: TITLE & HEADER ACTION BUTTONS -->
      <div class="flex flex-wrap items-center justify-between gap-4">
        <!-- Hotel Title with Verified Rosette Badge -->
        <div class="flex items-center gap-2">
          <h1 class="font-sans text-2xl sm:text-3xl lg:text-[34px] font-black text-[#002b11] tracking-tight leading-tight">
            {hotelTitle}
          </h1>
          {isVerified && (
            <span class="inline-flex items-center justify-center text-[#002b11] shrink-0" title="Verified Hotel Stay">
              <svg class="w-5 h-5 sm:w-6 sm:h-6" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 2l2.4 2.1 3.2-.4 1.2 3 2.9 1.4-.7 3.1 1.9 2.5-1.9 2.5.7 3.1-2.9 1.4-1.2 3-3.2-.4L12 22l-2.4-2.1-3.2.4-1.2-3-2.9-1.4.7-3.1-1.9-2.5 1.9-2.5-.7-3.1 2.9-1.4 1.2-3 3.2.4L12 2z"/>
                <path d="M9.5 12l2 2 4.5-4.5" fill="none" stroke="#ffffff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
          )}
        </div>

        <!-- Right Side: Saved & Review Buttons -->
        <div class="hidden sm:flex items-center gap-4 sm:gap-5">
          <!-- Saved Button -->
          <button
            type="button"
            id="headerSaveHotelBtn"
            data-hotel-slug={hotelSlug}
            class="flex items-center gap-1.5 text-slate-900 hover:text-emerald-800 transition cursor-pointer select-none"
          >
            <svg id="headerHeartIcon" class="w-4 h-4 fill-red-600 text-red-600 shrink-0 transition-transform active:scale-125" viewBox="0 0 24 24">
              <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
            </svg>
            <span id="headerSaveText" class="text-xs sm:text-sm font-bold underline underline-offset-4">Saved</span>
          </button>

          <!-- Review Button -->
          <button
            type="button"
            class="open-write-review-trigger border border-slate-900 hover:bg-slate-100 text-slate-900 font-bold text-xs sm:text-sm px-4 py-1.5 rounded-full flex items-center gap-1.5 transition active:scale-95 cursor-pointer"
          >
            <svg class="w-3.5 h-3.5 stroke-slate-900 fill-none stroke-2 shrink-0" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 20h9"/>
              <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/>
            </svg>
            <span>Review</span>
          </button>
        </div>
      </div>

      <!-- ROW 2: RATINGS, REVIEWS & LOCATION -->
      <div class="space-y-1.5 text-left pt-1">
        
        <!-- Rating Line -->
        <div class="flex flex-wrap items-center gap-2 text-xs sm:text-sm">
          {reviewsCount > 0 && avgRating && (
            <>
              <span class="font-bold text-slate-900">{avgRating}</span>

              <!-- Tripadvisor 5 Green Bubbles -->
              <div class="flex items-center gap-1">
                {Array.from({ length: 5 }).map((_, i) => {
                  const diff = avgRatingNum - i;
                  if (diff >= 0.75) {
                    return <span class="w-3.5 h-3.5 rounded-full bg-[#00852f] shrink-0 inline-block" />;
                  } else if (diff >= 0.25) {
                    return (
                      <span class="relative w-3.5 h-3.5 rounded-full border-[1.5px] border-[#00852f] overflow-hidden shrink-0 inline-block bg-white">
                        <span class="absolute inset-y-0 left-0 w-1/2 bg-[#00852f]" />
                      </span>
                    );
                  } else {
                    return <span class="w-3.5 h-3.5 rounded-full border-[1.5px] border-[#00852f] shrink-0 inline-block bg-white" />;
                  }
                })}
              </div>
            </>
          )}

          <!-- Review Count Link -->
          <a href="#guest-reviews" class="text-slate-800 font-medium underline underline-offset-2 hover:text-emerald-800 transition">
            ({reviewsCount > 0 ? `${reviewsCount.toLocaleString()} reviews` : 'No reviews yet'})
          </a>

          <!-- শুধুমাত্র মোবাইলের জন্য: Review & Save বাটন -->
          <div class="flex sm:hidden items-center gap-2 ml-1">
            <!-- Review Button -->
            <button
              type="button"
              class="open-write-review-trigger border border-slate-900 hover:bg-slate-100 text-slate-900 font-bold text-[11px] px-2.5 py-1 rounded-full flex items-center gap-1 active:scale-95 cursor-pointer"
            >
              <svg class="w-3 h-3 stroke-slate-900 fill-none stroke-2 shrink-0" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 20h9"/>
                <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/>
              </svg>
              <span>Review</span>
            </button>

            <!-- Save Button (Mobile) -->
            <button
              type="button"
              class="header-save-btn flex items-center gap-1 text-slate-900 hover:text-red-600 cursor-pointer select-none text-[11px] font-bold"
              data-hotel-id={hotelSlug || hotelTitle}
            >
              <svg class="heart-icon w-3.5 h-3.5 stroke-slate-900 fill-none stroke-2 shrink-0 transition-colors" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
              </svg>
              <span class="save-label underline underline-offset-2">Save</span>
            </button>
          </div>

          <!-- Ranking (Only if available) -->
          {hotelRanking && (
            <a href="#about-and-rates" class="text-slate-800 font-medium underline underline-offset-2 hover:text-emerald-800 transition">
              {hotelRanking}
            </a>
          )}
        </div>

        <!-- Location Pin Line -->
        {hotelLocation && (
          <div class="flex items-center gap-1.5 text-xs sm:text-sm">
            <svg class="w-4 h-4 text-[#002b11] shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
              <circle cx="12" cy="10" r="3"/>
            </svg>
            <a href={locationMapUrl} class="text-slate-900 font-semibold underline underline-offset-2 hover:text-emerald-800 transition">
              View location
            </a>
          </div>
        )}
      </div>

    </div>

    <!-- ================= 2. RESPONSIVE HERO GALLERY COLLAGE ================= -->
    {totalPhotos > 0 && (
      <div class="pt-2">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-1 h-[280px] xs:h-[340px] sm:h-[400px] md:h-[450px] lg:h-[480px] rounded-2xl sm:rounded-3xl overflow-hidden shadow-sm bg-slate-100">
          
          <!-- 1. MAIN LARGE IMAGE (Spans 2 cols on desktop) -->
          <div 
            class={`relative h-full overflow-hidden group cursor-pointer ${totalPhotos >= 2 ? 'md:col-span-2' : 'md:col-span-3'}`}
            data-gallery-trigger="0"
          >
            <img
              id="heroMainViewImg"
              src={heroDesktopUrls[0]}
              srcset={`${heroMobileUrls[0]} 640w, ${heroDesktopUrls[0]} 1200w`}
              sizes="(max-width: 768px) 100vw, (max-width: 1200px) 66vw, 850px"
              width="850"
              height="480"
              alt={hotelTitle}
              loading="eager"
              fetchpriority="high"
              decoding="async"
              class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
            />

            <!-- Dark Green Photo Count Pill Badge (Bottom-Right) -->
            <button
              type="button"
              id="heroGalleryBadgeBtn"
              aria-label={`View all ${totalPhotos} photos`}
              class="absolute bottom-3 sm:bottom-4 right-3 sm:right-4 bg-[#002b11]/90 hover:bg-[#002b11] text-white backdrop-blur-md px-3.5 py-1.5 rounded-full flex items-center gap-2 shadow-lg border border-white/20 transition hover:scale-105 z-10 cursor-pointer"
            >
              <svg class="w-4 h-4 fill-none stroke-currentColor stroke-2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
                <rect width="18" height="18" x="3" y="3" rx="2" ry="2"/>
                <circle cx="9" cy="9" r="2"/>
                <path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/>
              </svg>
              <span class="text-xs sm:text-sm font-bold tracking-wide">{totalPhotos}</span>
            </button>
          </div>

          <!-- 2. RIGHT SIDE: 2 STACKED PHOTOS -->
          {totalPhotos >= 2 && (
            <div class="hidden md:grid grid-rows-2 gap-1 h-full">
              <!-- Top-Right Photo -->
              <div 
                class="relative h-full overflow-hidden group cursor-pointer"
                data-gallery-trigger="1"
              >
                <img
                  src={heroDesktopUrls[1]}
                  alt={`${hotelTitle} Photo 2`}
                  width="400"
                  height="240"
                  loading="eager"
                  decoding="async"
                  class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                />
              </div>

              <!-- Bottom-Right Photo -->
              {totalPhotos >= 3 && (
                <div 
                  class="relative h-full overflow-hidden group cursor-pointer"
                  data-gallery-trigger="2"
                >
                  <img
                    src={heroDesktopUrls[2]}
                    alt={`${hotelTitle} Photo 3`}
                    width="400"
                    height="240"
                    loading="lazy"
                    decoding="async"
                    class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                  />
                </div>
              )}
            </div>
          )}

        </div>
      </div>
    )}

  </div>
</section>

<!-- HIDDEN JSON PAYLOAD FOR LIGHTBOX SCRIPT -->
<script type="application/json" id="hotel-gallery-data" set:html={JSON.stringify(galleryPayload)}></script>

<!-- FULL SCREEN PHOTO LIGHTBOX MODAL -->
<div
  id="heroLightboxModal"
  role="dialog"
  aria-modal="true"
  aria-label="Image Gallery Lightbox"
  class="fixed inset-0 z-50 bg-slate-950/95 backdrop-blur-md hidden flex-col justify-between p-4 sm:p-8 text-white select-none"
>
  <div class="flex items-center justify-between max-w-7xl mx-auto w-full border-b border-slate-800 pb-4">
    <div>
      <h3 class="text-base sm:text-lg font-black font-sans text-white">{hotelTitle}</h3>
      <span class="text-xs text-slate-400">Photo Gallery</span>
    </div>
    <div class="flex items-center gap-4">
      <span class="text-xs font-bold bg-slate-800 px-3 py-1 rounded-full border border-slate-700">
        <span id="lightboxModalIdx">1</span> / <span>{totalPhotos}</span>
      </span>
      <button
        type="button"
        id="closeHeroLightboxBtn"
        aria-label="Close Lightbox"
        class="text-slate-400 hover:text-white text-3xl font-bold p-1 cursor-pointer transition active:scale-90"
      >
        &times;
      </button>
    </div>
  </div>

  <div class="relative max-w-5xl mx-auto my-auto w-full h-[60vh] sm:h-[70vh] flex items-center justify-center">
    <img
      id="lightboxModalImg"
      src={lightboxUrls[0]}
      alt={hotelTitle}
      loading="lazy"
      decoding="async"
      class="max-w-full max-h-full object-contain rounded-2xl shadow-2xl transition-opacity duration-200"
    />
    
    {totalPhotos > 1 && (
      <>
        <button
          type="button"
          id="lightboxPrevBtn"
          aria-label="Previous Lightbox Photo"
          class="absolute left-2 sm:left-4 top-1/2 -translate-y-1/2 w-11 h-11 rounded-full bg-slate-900/80 hover:bg-slate-800 text-white flex items-center justify-center text-lg font-bold shadow-xl transition active:scale-95 cursor-pointer z-10"
        >
          ❮
        </button>
        <button
          type="button"
          id="lightboxNextBtn"
          aria-label="Next Lightbox Photo"
          class="absolute right-2 sm:right-4 top-1/2 -translate-y-1/2 w-11 h-11 rounded-full bg-slate-900/80 hover:bg-slate-800 text-white flex items-center justify-center text-lg font-bold shadow-xl transition active:scale-95 cursor-pointer z-10"
        >
          ❯
        </button>
      </>
    )}
  </div>
</div>

<!-- CLIENT SCRIPT -->
<script>
  let abortCtrl: AbortController | null = null;

  function initHotelHeader() {
    if (abortCtrl) abortCtrl.abort();
    abortCtrl = new AbortController();
    const { signal } = abortCtrl;

    // 1. Gallery Lightbox Logic
    const modal = document.getElementById('heroLightboxModal');
    const closeModalBtn = document.getElementById('closeHeroLightboxBtn');
    const modalImg = document.getElementById('lightboxModalImg') as HTMLImageElement | null;
    const modalIdxSpan = document.getElementById('lightboxModalIdx');
    const modalPrevBtn = document.getElementById('lightboxPrevBtn');
    const modalNextBtn = document.getElementById('lightboxNextBtn');
    const galleryTriggers = document.querySelectorAll('[data-gallery-trigger]');
    const badgeBtn = document.getElementById('heroGalleryBadgeBtn');

    const galleryScript = document.getElementById('hotel-gallery-data');
    let gallery = { mobile: [] as string[], desktop: [] as string[], lightbox: [] as string[] };
    try {
      gallery = JSON.parse(galleryScript?.textContent || '{}');
    } catch {
      gallery = { mobile: [], desktop: [], lightbox: [] };
    }

    const count = gallery.lightbox?.length || 0;
    let activeIdx = 0;

    function toggleBodyScroll(disable: boolean) {
      document.body.style.overflow = disable ? 'hidden' : '';
    }

    function updateModalImage(idx: number) {
      if (!modalImg || count === 0) return;
      activeIdx = (idx + count) % count;
      modalImg.src = gallery.lightbox[activeIdx];
      if (modalIdxSpan) modalIdxSpan.textContent = (activeIdx + 1).toString();
    }

    function hideLightboxDOM() {
      if (!modal) return;
      modal.classList.add('hidden');
      modal.classList.remove('flex');
      toggleBodyScroll(false);
    }

    function openLightbox(startIdx: number = 0) {
      if (!modal || count === 0) return;
      updateModalImage(startIdx);
      modal.classList.remove('hidden');
      modal.classList.add('flex');
      toggleBodyScroll(true);

      if (window.location.hash !== '#gallery') {
        history.pushState({ modalOpen: true }, '', '#gallery');
      }
    }

    function closeLightboxByUI() {
      if (window.location.hash === '#gallery') {
        history.back();
      } else {
        hideLightboxDOM();
      }
    }

    window.addEventListener('popstate', () => {
      if (window.location.hash !== '#gallery') {
        hideLightboxDOM();
      } else if (modal && modal.classList.contains('hidden')) {
        openLightbox(activeIdx);
      }
    }, { signal });

    window.addEventListener('keydown', (e: KeyboardEvent) => {
      if (!modal || modal.classList.contains('hidden')) return;
      if (e.key === 'Escape') closeLightboxByUI();
      if (e.key === 'ArrowLeft') updateModalImage(activeIdx - 1);
      if (e.key === 'ArrowRight') updateModalImage(activeIdx + 1);
    }, { signal });

    if (window.location.hash === '#gallery') {
      openLightbox(0);
    }

    galleryTriggers.forEach((trigger) => {
      trigger.addEventListener('click', () => {
        const idx = parseInt(trigger.getAttribute('data-gallery-trigger') || '0', 10);
        openLightbox(idx);
      });
    });

    badgeBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      openLightbox(0);
    });

    closeModalBtn?.addEventListener('click', closeLightboxByUI);
    modal?.addEventListener('click', (e) => {
      if (e.target === modal) closeLightboxByUI();
    });

    modalPrevBtn?.addEventListener('click', () => updateModalImage(activeIdx - 1));
    modalNextBtn?.addEventListener('click', () => updateModalImage(activeIdx + 1));

    // 2. Saved Hotel (LocalStorage State Toggle)
    const saveBtns = document.querySelectorAll('.header-save-btn, #headerSaveHotelBtn');
    if (saveBtns.length > 0) {
      const hotelId = saveBtns[0].getAttribute('data-hotel-id') || saveBtns[0].getAttribute('data-hotel-slug') || 'hotel';

      function getSavedList(): string[] {
        try {
          return JSON.parse(localStorage.getItem('saved_hotels') || '[]');
        } catch {
          return [];
        }
      }

      function updateSaveUI() {
        const savedList = getSavedList();
        const isSaved = savedList.includes(hotelId);

        saveBtns.forEach(btn => {
          const heart = btn.querySelector('svg');
          const label = btn.querySelector('.save-label') || btn.querySelector('#headerSaveText');

          if (isSaved) {
            heart?.classList.add('fill-red-600', 'stroke-red-600');
            heart?.classList.remove('fill-none', 'stroke-slate-900');
            if (label) label.textContent = 'Saved';
          } else {
            heart?.classList.remove('fill-red-600', 'stroke-red-600');
            heart?.classList.add('fill-none', 'stroke-slate-900');
            if (label) label.textContent = 'Save';
          }
        });
      }

      updateSaveUI();

      saveBtns.forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          e.stopPropagation();

          let savedList = getSavedList();
          if (savedList.includes(hotelId)) {
            savedList = savedList.filter(id => id !== hotelId);
          } else {
            savedList.push(hotelId);
          }

          localStorage.setItem('saved_hotels', JSON.stringify(savedList));
          updateSaveUI();
        });
      });
    }
  }

  document.addEventListener('DOMContentLoaded', initHotelHeader);
  document.addEventListener('astro:page-load', initHotelHeader);
</script>
