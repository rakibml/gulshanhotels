---
// src/components/hotel/HotelHeader.astro
interface Props {
  hotel: any;
}

const { hotel } = Astro.props;
const data = hotel?.data || {};

const hotelTitle = data.title || data.name || "Hotel Details";
const hotelCategory = data.category || "5-Star Hotel";
const hotelLocation = data.location || "Gulshan 2, Dhaka 1212, Bangladesh";
const hotelImage = data.image || "https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&w=1600&q=80";
const officialSite = data.officialSite || "https://www.agoda.com";
const hotelDescription = data.description || "Experience timeless luxury and exceptional Bangladeshi hospitality in the heart of Gulshan, Dhaka.";
---

<!-- WORLD-CLASS LUXURY HOTEL HERO BANNER -->
<section class="relative bg-slate-950 text-white min-h-[460px] sm:min-h-[520px] flex items-center overflow-hidden border-b border-slate-800">
  
  <!-- High-Resolution Hotel Cover Image -->
  <div class="absolute inset-0 w-full h-full pointer-events-none">
    <img 
      src={hotelImage} 
      alt={hotelTitle} 
      class="w-full h-full object-cover opacity-80 scale-105" 
    />
    <!-- Dark Gradient Overlay for High Text Readability -->
    <div class="absolute inset-0 bg-gradient-to-r from-slate-950 via-slate-950/85 to-transparent"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-transparent to-slate-950/30"></div>
  </div>

  <!-- MAIN HERO CONTENT (PERFECT LEFT ALIGNMENT MATCHING GLOBAL HEADER LOGO) -->
  <div class="relative z-20 max-w-[1550px] mx-auto px-4 sm:px-8 lg:px-12 w-full py-12 space-y-4">
    <div class="max-w-2xl space-y-3.5 text-left">
      
      <!-- Breadcrumbs -->
      <div class="flex items-center gap-2 text-xs text-slate-300 font-medium">
        <a href="/" class="hover:text-emerald-400 transition">Home</a>
        <span>›</span>
        <a href="/#hotels" class="hover:text-emerald-400 transition">Hotels</a>
        <span>›</span>
        <span class="text-white font-bold">{hotelTitle}</span>
      </div>

      <!-- Category Pill Badge -->
      <div>
        <span class="bg-white/10 border border-white/20 text-slate-200 text-[11px] font-bold px-3.5 py-1 rounded-full backdrop-blur-md inline-block">
          {hotelCategory}
        </span>
      </div>

      <!-- Main Hotel Title -->
      <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black text-white font-serif leading-tight tracking-tight drop-shadow-md">
        {hotelTitle}
      </h1>

      <!-- Location Line with Vector SVG Pin Icon -->
      <p class="text-xs sm:text-sm text-slate-200 font-medium flex items-center gap-2">
        <svg class="w-4 h-4 fill-amber-400 shrink-0" width="16" height="16" viewBox="0 0 24 24">
          <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
        </svg>
        <span>{hotelLocation}</span>
      </p>

      <!-- Short Catchphrase Description -->
      <p class="text-xs sm:text-sm text-slate-300 leading-relaxed max-w-xl font-normal pt-1">
        {hotelDescription}
      </p>

      <!-- Official Vector SVG Amenities Quick Icons Row (Monochrome Soft White) -->
      <div class="flex flex-wrap items-center gap-4 text-xs text-slate-200 pt-2">
        
        <!-- Wi-Fi -->
        <span class="flex items-center gap-1.5 font-semibold">
          <svg class="w-4 h-4 fill-white shrink-0" width="16" height="16" viewBox="0 0 24 24">
            <path d="M12 3C7.95 3 4.21 4.34 1.2 6.6L3 8.8C5.46 6.81 8.58 5.7 12 5.7c3.42 0 6.54 1.11 9 3.1l1.8-2.2C19.79 4.34 16.05 3 12 3zm0 5c-2.92 0-5.61.96-7.8 2.58l1.8 2.22C7.62 11.53 9.71 10.7 12 10.7c2.29 0 4.38.83 6 2.1l1.8-2.22C17.61 8.96 14.92 8 12 8zm0 5c-1.87 0-3.58.62-4.98 1.67L12 21l4.98-6.33C15.58 13.62 13.87 13 12 13z"/>
          </svg>
          Free Wi-Fi
        </span>

        <!-- Pool -->
        <span class="flex items-center gap-1.5 font-semibold">
          <svg class="w-4 h-4 fill-white shrink-0" width="16" height="16" viewBox="0 0 24 24">
            <path d="M22 17c-1.1 0-2.12-.3-3-.83-.88.53-1.9.83-3 .83s-2.12-.3-3-.83c-.88.53-1.9.83-3 .83s-2.12-.3-3-.83c-.88.53-1.9.83-3 .83v-2c.67 0 1.3-.19 1.83-.53.88-.53 1.9-.83 3-.83s2.12.3 3 .83c.88.53 1.9.83 3 .83s2.12-.3 3-.83c.88-.53 1.9-.83 3-.83s2.12.3 3 .83c.53.34 1.16.53 1.83.53v2zm0-5c-1.1 0-2.12-.3-3-.83-.88.53-1.9.83-3 .83s-2.12-.3-3-.83c-.88.53-1.9.83-3 .83s-2.12-.3-3-.83c-.88.53-1.9.83-3 .83v-2c.67 0 1.3-.19 1.83-.53.88-.53 1.9-.83 3-.83s2.12.3 3 .83c.88.53 1.9.83 3 .83s2.12-.3 3-.83c.88-.53 1.9-.83 3-.83s2.12.3 3 .83c.53.34 1.16.53 1.83.53v2zM15 7.5a2.5 2.5 0 1 0-5 0 2.5 2.5 0 0 0 5 0z"/>
          </svg>
          Pool
        </span>

        <!-- Spa -->
        <span class="flex items-center gap-1.5 font-semibold">
          <svg class="w-4 h-4 fill-white shrink-0" width="16" height="16" viewBox="0 0 24 24">
            <path d="M12 3c-1.5 2.5-3 5.5-3 8 0 1.66 1.34 3 3 3s3-1.34 3-3c0-2.5-1.5-5.5-3-8zm-5.5 5.5c-2.5 1.5-5.5 3-8 3 0 1.66 1.34 3 3 3 2.5 0 5.5-1.5 8-3-1.34 0-3-1.34-3-3zm11 0c0 1.66-1.66 3-3 3 2.5 1.5 5.5 3 8 3 0-1.66-1.34-3-3-3-2.5 0-5.5-1.5-8-3z"/>
          </svg>
          Spa
        </span>

        <!-- Fitness Gym -->
        <span class="flex items-center gap-1.5 font-semibold">
          <svg class="w-4 h-4 fill-white shrink-0" width="16" height="16" viewBox="0 0 24 24">
            <path d="M20.57 14.86L22 13.43 20.57 12 17 15.57 8.43 7 12 3.43 10.57 2 9.14 3.43 7.71 2 6.29 3.43 7.71 4.86 3.43 9.14 2 7.71 0.57 9.14 2 10.57 0.57 12 2 13.43 3.43 12 12 20.57 15.57 17 17 18.43 18.43 17 17 15.57 20.57 12z"/>
          </svg>
          Fitness Center
        </span>

        <!-- Parking -->
        <span class="flex items-center gap-1.5 font-semibold">
          <svg class="w-4 h-4 fill-white shrink-0" width="16" height="16" viewBox="0 0 24 24">
            <path d="M13.2 11H10V7h3.2c1.1 0 2 .9 2 2s-.9 2-2 2zM19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-5.8 10H10v4H8V5h5.2c2.2 0 4 1.8 4 4s-1.8 4-4 4z"/>
          </svg>
          Free Parking
        </span>
      </div>

      <!-- Action Buttons (Eye-Soothing Soft Forest Emerald & Glass) -->
      <div class="flex flex-wrap items-center gap-3 pt-4">
        <!-- Soft Forest Emerald Button -->
        <a href="#about-and-rates" class="bg-[#0d3b23] hover:bg-[#061e14] text-white font-extrabold text-xs sm:text-sm uppercase tracking-wider px-7 py-3.5 rounded-2xl shadow-xl transition hover:scale-105 border border-emerald-600/30">
          View Prices ➔
        </a>

        <!-- Outlined Glass Secondary Button -->
        <a href={officialSite} target="_blank" rel="noopener noreferrer" class="bg-white/10 hover:bg-white/20 border border-white/25 text-white font-extrabold text-xs sm:text-sm uppercase tracking-wider px-6 py-3.5 rounded-2xl transition backdrop-blur-md hover:scale-105 flex items-center gap-2">
          <span>Official Website</span>
          <svg class="w-3.5 h-3.5 fill-current shrink-0" width="14" height="14" viewBox="0 0 24 24">
            <path d="M19 19H5V5h7V3H5c-1.11 0-2 .9-2 2v14c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2v-7h-2v7zM14 3v2h3.59l-9.83 9.83 1.41 1.41L19 6.41V10h2V3h-7z"/>
          </svg>
        </a>
      </div>

    </div>
  </div>

</section>
