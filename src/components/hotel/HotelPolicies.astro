---
// src/components/hotel/HotelPolicies.astro (100% Authentic Booking.com Layout & Brand Payment Logos)
interface Props {
  hotel: any;
}

const { hotel } = Astro.props;
const data = hotel?.data || {};

const hotelTitle = data.title || data.name || "Hotel Details";
const showPolicies = data.enable_policies !== false;

// 1. Core Schedules
const checkIn = data.check_in || data.checkIn || "Available 24 hours";
const checkOut = data.check_out || data.checkOut || "Available 24 hours";

// 2. Cancellation
const cancellationRaw = data.cancellation_policy || data.cancellation || "Cancellation and prepayment policies vary according to accommodation type. Please check what conditions apply to each option when making your selection.";

// Regex parser to convert [text](link) to clickable <a> in cancellation
function parseMarkdownLinks(text: string) {
  if (!text) return "";
  return text.replace(/\[(.*?)\]\((.*?)\)/g, '<a href="$2" class="text-blue-600 hover:underline font-semibold">$1</a>');
}
const cancellationHtml = parseMarkdownLinks(cancellationRaw);

// 3. Children & Beds
const childPolicyText = data.child_policy_text || "Children of all ages are welcome.\nChildren 9 and above will be charged as adults at this property.\nTo see correct prices and occupancy info, add the number and ages of children in your group to your search.";

const extraBedsList: Array<{ age: string; type: string; price: string }> = Array.isArray(data.extra_beds) && data.extra_beds.length > 0
  ? data.extra_beds
  : [
      { age: "1 - 6 years", type: "Crib upon request", price: "Free" },
      { age: "12+ years", type: "Extra bed upon request", price: "US$25 per person, per night" }
    ];

const extraBedsNotes = data.extra_beds_notes || "Prices for cribs and extra beds aren't included in the total price. They'll have to be paid for separately during your stay.\nThe number of extra beds and cribs allowed depends on the option you choose. Check your selected option for more info.\nAll cribs and extra beds are subject to availability.";

// 4. Age Restriction & Pets
const ageRestriction = data.age_restriction || data.ageRestriction || "The minimum age for check-in is 18";
const petsPolicy = data.pets_policy || data.petsPolicy || data.pets || "Pets are not allowed.";

// 5. Accepted Payment Methods
const acceptedPayments: string[] = Array.isArray(data.payment_methods) && data.payment_methods.length > 0
  ? data.payment_methods
  : ["amex", "visa", "mastercard", "unionpay", "cash"];

// 6. Custom Extra Policies (Backwards-compatible with data.policies)
const customPolicies = Array.isArray(data.custom_policies) ? data.custom_policies : (Array.isArray(data.policies) ? data.policies : []);
---

{showPolicies && (
  <section id="hotel-policies" class="bg-white py-12 px-4 sm:px-6 lg:px-8 max-w-6xl mx-auto text-slate-800 border-b border-slate-200 scroll-mt-14 sm:scroll-mt-16 text-left">
    
    <!-- Top Header -->
    <div class="flex items-center justify-between pb-6 border-b border-slate-100">
      <div>
        <h2 class="font-sans text-2xl sm:text-3xl font-black text-slate-900 tracking-tight">
          Property policies
        </h2>
        <p class="text-xs sm:text-sm text-slate-500 font-medium mt-0.5">
          {hotelTitle} takes special requests – add in the next step!
        </p>
      </div>

      <a 
        href="#rates-card" 
        class="bg-[#0071c2] hover:bg-[#005999] text-white text-xs sm:text-sm font-bold px-4 py-2 rounded-lg transition shadow-xs hidden sm:inline-block"
      >
        See availability
      </a>
    </div>

    <!-- Booking.com Unified Policies Container -->
    <div class="border border-slate-200 rounded-2xl overflow-hidden shadow-xs divide-y divide-slate-200 mt-6 bg-white text-xs sm:text-sm">
      
      <!-- 1. CHECK-IN ROW -->
      <div class="p-5 grid grid-cols-1 md:grid-cols-12 gap-3 sm:gap-6 items-start hover:bg-slate-50/50 transition">
        <div class="md:col-span-4 lg:col-span-3 flex items-center gap-2.5 font-bold text-slate-900">
          <svg class="w-4 h-4 text-slate-700 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
          <span>Check-in</span>
        </div>
        <div class="md:col-span-8 lg:col-span-9 text-slate-700 leading-relaxed">
          {checkIn}
        </div>
      </div>

      <!-- 2. CHECK-OUT ROW -->
      <div class="p-5 grid grid-cols-1 md:grid-cols-12 gap-3 sm:gap-6 items-start hover:bg-slate-50/50 transition">
        <div class="md:col-span-4 lg:col-span-3 flex items-center gap-2.5 font-bold text-slate-900">
          <svg class="w-4 h-4 text-slate-700 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2"><path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
          <span>Check-out</span>
        </div>
        <div class="md:col-span-8 lg:col-span-9 text-slate-700 leading-relaxed">
          {checkOut}
        </div>
      </div>

      <!-- 3. CANCELLATION / PREPAYMENT ROW -->
      <div class="p-5 grid grid-cols-1 md:grid-cols-12 gap-3 sm:gap-6 items-start hover:bg-slate-50/50 transition">
        <div class="md:col-span-4 lg:col-span-3 flex items-center gap-2.5 font-bold text-slate-900">
          <svg class="w-4 h-4 text-slate-700 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
          <span>Cancellation/ prepayment</span>
        </div>
        <div class="md:col-span-8 lg:col-span-9 text-slate-700 leading-relaxed" set:html={cancellationHtml}>
        </div>
      </div>

      <!-- 4. CHILDREN & BEDS ROW (WITH STRUCTURED TABLE) -->
      <div class="p-5 grid grid-cols-1 md:grid-cols-12 gap-3 sm:gap-6 items-start hover:bg-slate-50/50 transition">
        <div class="md:col-span-4 lg:col-span-3 flex items-center gap-2.5 font-bold text-slate-900">
          <svg class="w-4 h-4 text-slate-700 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
          <span>Children & Beds</span>
        </div>
        <div class="md:col-span-8 lg:col-span-9 space-y-4 text-slate-700 leading-relaxed">
          
          <!-- General Child Policy Intro -->
          <div class="space-y-1.5 whitespace-pre-line">
            <h4 class="font-bold text-slate-900 text-sm">Child policies</h4>
            <p class="text-slate-700">{childPolicyText}</p>
          </div>

          <!-- Structured Crib and Extra Bed Table (Exact Booking.com Box) -->
          {extraBedsList.length > 0 && (
            <div class="space-y-2 pt-1">
              <h4 class="font-bold text-slate-900 text-sm">Crib and extra bed policies</h4>
              
              <div class="border border-slate-200 rounded-xl overflow-hidden divide-y divide-slate-200 bg-white shadow-2xs">
                {extraBedsList.map((tier) => (
                  <div class="p-3.5 space-y-1.5">
                    <span class="font-bold text-slate-900 text-xs block">{tier.age}</span>
                    <div class="flex items-center justify-between text-xs sm:text-sm">
                      <div class="flex items-center gap-2 text-slate-700">
                        <!-- Bed/Crib Icon -->
                        <svg class="w-4 h-4 text-slate-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 10h18M3 14h18M5 18v2m14-2v2M5 6v4m14-4v4"/></svg>
                        <span>{tier.type}</span>
                      </div>
                      <span class={`font-bold ${tier.price.toLowerCase() === 'free' ? 'text-emerald-700 font-extrabold' : 'text-slate-800'}`}>
                        {tier.price}
                      </span>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          )}

          <!-- Disclaimer Footnotes -->
          {extraBedsNotes && (
            <p class="text-slate-600 text-xs whitespace-pre-line leading-relaxed pt-1">
              {extraBedsNotes}
            </p>
          )}

        </div>
      </div>

      <!-- 5. AGE RESTRICTION ROW -->
      <div class="p-5 grid grid-cols-1 md:grid-cols-12 gap-3 sm:gap-6 items-start hover:bg-slate-50/50 transition">
        <div class="md:col-span-4 lg:col-span-3 flex items-center gap-2.5 font-bold text-slate-900">
          <svg class="w-4 h-4 text-slate-700 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
          <span>Age restriction</span>
        </div>
        <div class="md:col-span-8 lg:col-span-9 text-slate-700 leading-relaxed">
          {ageRestriction}
        </div>
      </div>

      <!-- 6. PETS ROW -->
      <div class="p-5 grid grid-cols-1 md:grid-cols-12 gap-3 sm:gap-6 items-start hover:bg-slate-50/50 transition">
        <div class="md:col-span-4 lg:col-span-3 flex items-center gap-2.5 font-bold text-slate-900">
          <svg class="w-4 h-4 text-slate-700 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M12 2a4 4 0 0 0-4 4c0 2 2 3 4 5 2-2 4-3 4-5a4 4 0 0 0-4-4zm-6 8a3 3 0 0 0-3 3c0 1.5 1.5 2.5 3 4 1.5-1.5 3-2.5 3-4a3 3 0 0 0-3-3zm12 0a3 3 0 0 0-3 3c0 1.5 1.5 2.5 3 4 1.5-1.5 3-2.5 3-4a3 3 0 0 0-3-3z"/></svg>
          <span>Pets</span>
        </div>
        <div class="md:col-span-8 lg:col-span-9 text-slate-700 leading-relaxed">
          {petsPolicy}
        </div>
      </div>

      <!-- 7. ACCEPTED PAYMENT METHODS (WITH AUTHENTIC LOGOS) -->
      <div class="p-5 grid grid-cols-1 md:grid-cols-12 gap-3 sm:gap-6 items-start hover:bg-slate-50/50 transition">
        <div class="md:col-span-4 lg:col-span-3 flex items-center gap-2.5 font-bold text-slate-900">
          <svg class="w-4 h-4 text-slate-700 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg>
          <span>Accepted payment methods</span>
        </div>
        
        <!-- Real Brand Badges -->
        <div class="md:col-span-8 lg:col-span-9 flex flex-wrap items-center gap-2">
          {acceptedPayments.includes("amex") && (
            <span class="h-6 px-2 bg-[#002663] text-white font-black text-[9px] rounded flex items-center justify-center tracking-tighter shadow-2xs select-none">
              AMERICAN EXPRESS
            </span>
          )}

          {acceptedPayments.includes("visa") && (
            <span class="h-6 px-2.5 bg-[#1434CB] text-white font-black italic text-xs rounded flex items-center justify-center shadow-2xs select-none tracking-wider">
              VISA
            </span>
          )}

          {acceptedPayments.includes("mastercard") && (
            <span class="h-6 px-2 bg-slate-900 text-white font-bold text-[10px] rounded flex items-center justify-center gap-1 shadow-2xs select-none">
              <span class="flex items-center -space-x-1.5">
                <span class="w-3 h-3 rounded-full bg-[#EB001B] inline-block"></span>
                <span class="w-3 h-3 rounded-full bg-[#F79E1B]/90 inline-block"></span>
              </span>
              <span class="text-[9px]">Mastercard</span>
            </span>
          )}

          {acceptedPayments.includes("unionpay") && (
            <span class="h-6 px-2 bg-[#007b83] text-white font-extrabold text-[9px] rounded flex items-center justify-center shadow-2xs select-none">
              UnionPay
            </span>
          )}

          {acceptedPayments.includes("cash") && (
            <span class="h-6 px-2.5 bg-[#00875a] text-white font-bold text-[10px] rounded flex items-center justify-center shadow-2xs select-none">
              Cash
            </span>
          )}

          {acceptedPayments.includes("bkash") && (
            <span class="h-6 px-2.5 bg-[#E2136E] text-white font-black text-[10px] rounded flex items-center justify-center shadow-2xs select-none">
              bKash
            </span>
          )}

          {acceptedPayments.includes("nagad") && (
            <span class="h-6 px-2.5 bg-[#F7931E] text-white font-black text-[10px] rounded flex items-center justify-center shadow-2xs select-none">
              Nagad
            </span>
          )}
        </div>
      </div>

      <!-- 8. ANY EXTRA CUSTOM POLICIES -->
      {customPolicies.map((item: any) => (
        <div class="p-5 grid grid-cols-1 md:grid-cols-12 gap-3 sm:gap-6 items-start hover:bg-slate-50/50 transition">
          <div class="md:col-span-4 lg:col-span-3 font-bold text-slate-900 capitalize">
            {item.label}
          </div>
          <div class="md:col-span-8 lg:col-span-9 text-slate-700 leading-relaxed whitespace-pre-line font-normal">
            {item.value}
          </div>
        </div>
      ))}

    </div>
  </section>
)}
