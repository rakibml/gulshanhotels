---
// src/components/hotel/HotelInsiderTips.astro (lite)
// No JS, no icons. Show more uses native <details>.

const data = Astro.props.hotel?.data ?? {};
const hotelTitle = (data.title || data.name || "").trim();
const clean = (v: unknown) => String(v ?? "").trim().replace(/\s{2,}/g, " ");

const raw = data.insider_tips ?? data.tips ?? [];
const tips = (Array.isArray(raw) ? raw : [])
  .map((t: any) =>
    typeof t === "string"
      ? { title: "", tip: clean(t), tag: "" }
      : { title: clean(t?.title), tip: clean(t?.tip || t?.description || t?.text), tag: clean(t?.tag || t?.category) }
  )
  .filter((t) => t.tip.length > 3);

const MAX = 9;
const shown = tips.slice(0, MAX);
const more = tips.slice(MAX);

const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: hotelTitle ? `Insider tips for ${hotelTitle}` : "Insider tips",
  numberOfItems: tips.length,
  itemListElement: tips.map((t, i) => ({
    "@type": "ListItem",
    position: i + 1,
    name: t.title || `Tip ${i + 1}`,
    description: t.tip,
  })),
}).replace(/</g, "\\u003c");

const listClass = "grid gap-4 md:grid-cols-2 lg:grid-cols-3 list-none p-0 m-0";
const cardClass = "h-full rounded-2xl border border-slate-200 bg-slate-50 p-5";
---

{data.enable_insider_tips !== false && tips.length > 0 && (
  <section
    id="insider-tips"
    class="max-w-7xl mx-auto bg-white py-12 px-4 sm:px-6 lg:px-0 border-b border-slate-200 scroll-mt-16 text-left text-slate-800"
    aria-labelledby="insider-tips-heading"
  >
    <script type="application/ld+json" set:html={jsonLd} />

    <h2 id="insider-tips-heading" class="text-2xl sm:text-3xl font-black text-[#002b11]">
      Insider tips{hotelTitle && ` for ${hotelTitle}`}
    </h2>

    <ul class={`${listClass} mt-6`}>
      {shown.map((t) => (
        <li>
          <article class={cardClass}>
            {t.tag && <span class="text-xs font-bold uppercase text-emerald-800">{t.tag}</span>}
            {t.title && <p class="font-black text-slate-900 mt-1">{t.title}</p>}
            <p class="text-sm text-slate-600 leading-relaxed mt-2">{t.tip}</p>
          </article>
        </li>
      ))}
    </ul>

    {more.length > 0 && (
      <details class="mt-4">
        <summary class="cursor-pointer text-center text-sm font-bold text-emerald-800">
          Show {more.length} more {more.length === 1 ? "tip" : "tips"}
        </summary>
        <ul class={`${listClass} mt-4`}>
          {more.map((t) => (
            <li>
              <article class={cardClass}>
                {t.tag && <span class="text-xs font-bold uppercase text-emerald-800">{t.tag}</span>}
                {t.title && <p class="font-black text-slate-900 mt-1">{t.title}</p>}
                <p class="text-sm text-slate-600 leading-relaxed mt-2">{t.tip}</p>
              </article>
            </li>
          ))}
        </ul>
      </details>
    )}
  </section>
)}
