---
// src/components/hotel/HotelLocationMap.astro (100% Speed Optimized & Expandable Nearby Area)
interface Props {
  hotel: any;
}

const { hotel } = Astro.props;
const data = hotel?.data || {};

const hotelTitle = data.title || data.name || "Hotel Details";
const hotelLocation = data.location || "Gulshan 2, Dhaka, Bangladesh";

// All Nearby Landmarks
const allNearbyPlaces = (data.nearby_places && data.nearby_places.length > 0) ? data.nearby_places : [
  { name: "Gulshan Lake Park", distance: "5 min drive" },
  { name: "United Hospital", distance: "6 min drive" },
  { name: "Dhaka Airport (DAC)", distance: "15 min drive" },
  { name: "Jamuna Future Park", distance: "12 min drive" },
  { name: "US Embassy Dhaka", distance: "8 min drive" },
  { name: "Baridhara Diplomatic Zone", distance: "7 min drive" },
  { name: "IVAC Indian Visa Application Center", distance: "10 min drive" },
  { name: "Banani Club & Commercial Area", distance: "6 min drive" }
];

// Top 5 Initially Visible & Remaining Hidden
const initialTop5 = allNearbyPlaces.slice(0, 5);
const remainingPlaces = allNearbyPlaces.slice(5);
---

<!-- 5TH COMPONENT: EXPLORE THE AREA (EXPANDABLE NEARBY LIST & SPEED OPTIMIZED MAP) -->
<section id="location-map" class="bg-[#F8FAF9] py-10 px-4 sm:px-8 lg:px-12 max-w-[1550px] mx-auto text-slate-800 border-b border-slate-200/80">
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
    
    <!-- LEFT COLUMN: EXPLORE THE AREA NARRATIVE & EXPANDABLE LIST -->
    <div class="lg:col-span-5 space-y-6 text-left">
      
      <div class="space-y-2">
        <h2 class="text-2xl sm:text-4xl font-black font-serif text-slate-900">
          Explore the area
        </h2>
        <p class="text-xs sm:text-sm text-slate-600 leading-relaxed font-normal">
          Located in the heart of {hotelLocation}, {hotelTitle} is close to embassies, business centers, shopping malls, and popular restaurants.
        </p>
      </div>

      <!-- Nearby Places List -->
      <div class="space-y-2 pt-1">
        
        <!-- Top 5 Visible Landmarks -->
        <div class="space-y-2.5">
          {initialTop5.map((item: any) => (
            <div class="flex items-center justify-between py-1.5 border-b border-slate-200/60 last:border-0">
              <div class="flex items-center gap-3 font-bold text-xs sm:text-sm text-slate-800">
                <svg class="w-4 h-4 fill-amber-600 shrink-0" width="16" height="16" viewBox="0 0 24 24">
                  <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
                </svg>
                <span>{item.name}</span>
              </div>
              <span class="text-xs font-semibold text-slate-400 shrink-0 ml-2">
                {item.distance}
              </span>
            </div>
          ))}
        </div>

        <!-- Remaining Hidden Landmarks (Expanded on Button Click) -->
        {remainingPlaces.length > 0 && (
          <div id="extraNearbyList" class="hidden space-y-2.5 pt-1">
            {remainingPlaces.map((item: any) => (
              <div class="flex items-center justify-between py-1.5 border-b border-slate-200/60 last:border-0">
                <div class="flex items-center gap-3 font-bold text-xs sm:text-sm text-slate-800">
                  <svg class="w-4 h-4 fill-emerald-700 shrink-0" width="16" height="16" viewBox="0 0 24 24">
                    <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
                  </svg>
                  <span>{item.name}</span>
                </div>
                <span class="text-xs font-semibold text-slate-400 shrink-0 ml-2">
                  {item.distance}
                </span>
              </div>
            ))}
          </div>
        )}

        <!-- See All About This Area Button -->
        {remainingPlaces.length > 0 && (
          <div class="pt-2">
            <button 
              id="toggleNearbyBtn" 
              class="text-xs font-black uppercase text-emerald-800 tracking-wider bg-emerald-100/70 hover:bg-emerald-200/80 px-4 py-2.5 rounded-xl border border-emerald-300/80 transition cursor-pointer flex items-center gap-1.5 shadow-sm"
            >
              <span id="toggleNearbyText">See All About This Area</span>
              <span id="toggleNearbyArrow">➔</span>
            </button>
          </div>
        )}

      </div>

    </div>

    <!-- RIGHT COLUMN: SPEED OPTIMIZED EMBEDDED GOOGLE MAP (LAZY LOADED) -->
    <div class="lg:col-span-7">
      <div class="rounded-3xl overflow-hidden border border-slate-200/90 shadow-md h-[280px] sm:h-[350px] lg:h-[390px] relative group bg-slate-100">
        <iframe 
          src={`https://maps.google.com/maps?q=${encodeURIComponent(hotelTitle + ' ' + hotelLocation)}&t=&z=15&ie=UTF8&iwloc=&output=embed`}
          class="w-full h-full border-0 contrast-[105%]" 
          loading="lazy"
          decoding="async"
          referrerpolicy="no-referrer-when-downgrade"
          title={`${hotelTitle} Location Map`}
        ></iframe>
      </div>
    </div>

  </div>
</section>

<!-- CLIENT SCRIPT FOR SEE ALL EXPAND/COLLAPSE TOGGLE -->
<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const toggleBtn = document.getElementById('toggleNearbyBtn');
    const extraList = document.getElementById('extraNearbyList');
    const toggleText = document.getElementById('toggleNearbyText');
    const toggleArrow = document.getElementById('toggleNearbyArrow');

    if (toggleBtn && extraList && toggleText && toggleArrow) {
      toggleBtn.addEventListener('click', () => {
        const isHidden = extraList.classList.contains('hidden');
        if (isHidden) {
          extraList.classList.remove('hidden');
          toggleText.textContent = 'Show Less';
          toggleArrow.textContent = '▲';
        } else {
          extraList.classList.add('hidden');
          toggleText.textContent = 'See All About This Area';
          toggleArrow.textContent = '➔';
        }
      });
    }
  });
</script>
