---
// src/components/hotel/HotelLocationMap.astro (Accurate Map Pin, Smooth Mobile GPU, Get Directions CTA & WCAG A11y)
interface Props {
  hotel: any;
}

const { hotel } = Astro.props;
const data = hotel?.data || {};

const hotelTitle = String(data.title || data.name || "Hotel").trim();
const hotelLocation = String(data.location || "Gulshan 2, Dhaka, Bangladesh").trim();

// Fetch Dynamic Nearby Landmarks from CMS
const allNearbyPlaces: any[] = Array.isArray(data.nearby_places) ? data.nearby_places : [];
const showNearbyList = allNearbyPlaces.length > 0;

// Top 5 Initially Visible & Remaining Hidden for Toggle
const initialTop5 = allNearbyPlaces.slice(0, 5);
const remainingPlaces = allNearbyPlaces.slice(5);

// CMS Coordinates or Smart Query for Accurate Map Pin
const lat = data.latitude || data.lat || data.geo?.lat;
const lng = data.longitude || data.lng || data.geo?.lng;

// কোঅর্ডিনেট না থাকলে একটি ক্লিন স্মার্ট কুয়েরি যাতে পিন সঠিক জায়গায় পড়ে
function getCleanMapQuery(): string {
  if (lat && lng) return `${lat},${lng}`;
  if (data.map_query) return String(data.map_query).trim();
  
  // বড় ঠিকানা থেকে শহর ও প্রধান অংশ নেওয়া
  const locParts = hotelLocation.split(',').map((p: string) => p.trim());
  const cleanLoc = locParts.length > 2 ? `${locParts[0]}, ${locParts[1]}` : hotelLocation;
  return `${hotelTitle}, ${cleanLoc}`;
}

const mapSearchQuery = getCleanMapQuery();
const googleMapEmbedUrl = `https://maps.google.com/maps?q=${encodeURIComponent(mapSearchQuery)}&t=&z=15&ie=UTF8&iwloc=&output=embed`;
const googleMapsAppUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(mapSearchQuery)}`;

// Smart Auto-Icon Detector for Nearby Places
const getPlaceIcon = (name: string) => {
  const n = String(name || '').toLowerCase();
  if (n.includes('airport') || n.includes('terminal') || n.includes('aviation')) {
    return `<svg aria-hidden="true" class="w-4 h-4 fill-emerald-700 shrink-0" viewBox="0 0 24 24"><path d="M21 16v-2l-8-5V3.5c0-.83-.67-1.5-1.5-1.5S10 2.67 10 3.5V9l-8 5v2l8-2.5V19l-2 1.5V22l3.5-1 3.5 1v-1.5L13 19v-5.5l8 2.5z"/></svg>`;
  }
  if (n.includes('metro') || n.includes('station') || n.includes('train') || n.includes('bus') || n.includes('transit')) {
    return `<svg aria-hidden="true" class="w-4 h-4 fill-emerald-700 shrink-0" viewBox="0 0 24 24"><path d="M12 2c-4.42 0-8 .5-8 4v10c0 1.86 1.28 3.41 3 3.86V21a1 1 0 0 0 1 1h1a1 1 0 0 0 1-1v-1h4v1a1 1 0 0 0 1 1h1a1 1 0 0 0 1-1v-1.14c1.72-.45 3-2 3-3.86V6c0-3.5-3.58-4-8-4zm0 2c3.71 0 5.13.46 5.67 1H6.33c.54-.54 1.96-1 5.67-1zm6 12H6v-7h12v7zm-9.5 2a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3zm7 0a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3z"/></svg>`;
  }
  if (n.includes('park') || n.includes('lake') || n.includes('garden')) {
    return `<svg aria-hidden="true" class="w-4 h-4 fill-emerald-700 shrink-0" viewBox="0 0 24 24"><path d="M12 2L4 14h3v6h10v-6h3L12 2zm0 3.8L15.5 10H8.5L12 5.8z"/></svg>`;
  }
  if (n.includes('mall') || n.includes('market') || n.includes('shopping') || n.includes('plaza')) {
    return `<svg aria-hidden="true" class="w-4 h-4 fill-emerald-700 shrink-0" viewBox="0 0 24 24"><path d="M18 6h-2c0-2.21-1.79-4-4-4S8 3.79 8 6H6c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2zm-6-2c1.1 0 2 .9 2 2h-4c0-1.1.9-2 2-2zm6 16H6V8h2v2c0 .55.45 1 1 1s1-.45 1-1V8h4v2c0 .55.45 1 1 1s1-.45 1-1V8h2v12z"/></svg>`;
  }
  if (n.includes('restaurant') || n.includes('cafe') || n.includes('coffee') || n.includes('food')) {
    return `<svg aria-hidden="true" class="w-4 h-4 fill-emerald-700 shrink-0" viewBox="0 0 24 24"><path d="M11 9H9V2H7v7H5V2H3v7c0 2.12 1.55 3.87 3.56 4.17L6 22h2l-.56-8.83C9.45 12.87 11 11.12 11 9zm9-7h-2c-1.1 0-2 .9-2 2v7h2v13h2V2z"/></svg>`;
  }
  return `<svg aria-hidden="true" class="w-4 h-4 fill-emerald-700 shrink-0" viewBox="0 0 24 24"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>`;
};
---

<!-- 5TH COMPONENT: EXPLORE THE AREA -->
<section id="location-map" class="bg-white py-12 px-4 sm:px-8 lg:px-0 max-w-7xl mx-auto text-slate-800 border-b border-slate-200 scroll-mt-14 sm:scroll-mt-16">
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
    
    <!-- LEFT COLUMN: EXPLORE THE AREA NARRATIVE & EXPANDABLE LIST -->
    <div class={showNearbyList ? "lg:col-span-5 space-y-6 text-left" : "lg:col-span-12 max-w-3xl mx-auto space-y-4 text-center"}>
      
      <div class="space-y-2">
        <h2 class="text-2xl sm:text-3xl font-black font-serif text-slate-900">
          Explore the area
        </h2>
        <p class="text-xs sm:text-sm text-slate-600 leading-relaxed font-normal">
          Located at <strong class="text-slate-800 font-semibold">{hotelLocation}</strong>, {hotelTitle} provides easy access to key business hubs, embassies, transport links, and shopping destinations.
        </p>
      </div>

      <!-- Nearby Places List -->
      {showNearbyList && (
        <div class="space-y-2 pt-1 text-left">
          
          <!-- Top 5 Visible Landmarks -->
          <div class="space-y-2.5">
            {initialTop5.map((item: any) => {
              const pName = typeof item === 'string' ? item : (item?.name || 'Landmark');
              const pDist = typeof item === 'object' ? (item?.distance || '') : '';

              return (
                <div class="flex items-center justify-between py-2 border-b border-slate-100 last:border-0 hover:bg-slate-50/60 px-2 rounded-xl transition">
                  <div class="flex items-center gap-3 font-bold text-xs sm:text-sm text-slate-800 min-w-0">
                    <span set:html={getPlaceIcon(pName)} class="inline-flex shrink-0"></span>
                    <span class="truncate">{pName}</span>
                  </div>
                  {pDist && (
                    <span class="text-xs font-semibold text-slate-500 shrink-0 ml-2 bg-slate-50 border border-slate-200 px-2 py-0.5 rounded-md">
                      {pDist}
                    </span>
                  )}
                </div>
              );
            })}
          </div>

          <!-- Remaining Hidden Landmarks -->
          {remainingPlaces.length > 0 && (
            <div id="extraNearbyList" class="hidden space-y-2.5 pt-1">
              {remainingPlaces.map((item: any) => {
                const pName = typeof item === 'string' ? item : (item?.name || 'Landmark');
                const pDist = typeof item === 'object' ? (item?.distance || '') : '';

                return (
                  <div class="flex items-center justify-between py-2 border-b border-slate-100 last:border-0 hover:bg-slate-50/60 px-2 rounded-xl transition">
                    <div class="flex items-center gap-3 font-bold text-xs sm:text-sm text-slate-800 min-w-0">
                      <span set:html={getPlaceIcon(pName)} class="inline-flex shrink-0"></span>
                      <span class="truncate">{pName}</span>
                    </div>
                    {pDist && (
                      <span class="text-xs font-semibold text-slate-500 shrink-0 ml-2 bg-slate-50 border border-slate-200 px-2 py-0.5 rounded-md">
                        {pDist}
                      </span>
                    )}
                  </div>
                );
              })}
            </div>
          )}

          <!-- See All Button -->
          {remainingPlaces.length > 0 && (
            <div class="pt-2">
              <button 
                type="button"
                id="toggleNearbyBtn" 
                aria-expanded="false"
                aria-controls="extraNearbyList"
                data-count={remainingPlaces.length}
                class="text-xs font-black uppercase text-emerald-800 tracking-wider bg-emerald-50 hover:bg-emerald-100 px-4 py-2.5 rounded-xl border border-emerald-300 transition cursor-pointer flex items-center gap-1.5 shadow-xs select-none active:scale-95"
              >
                <span id="toggleNearbyText">See All About This Area (+{remainingPlaces.length})</span>
                <span id="toggleNearbyArrow" aria-hidden="true">➔</span>
              </button>
            </div>
          )}

        </div>
      )}

    </div>

    <!-- RIGHT COLUMN: GOOGLE MAP WITH GET DIRECTIONS CTA -->
    <div class={showNearbyList ? "lg:col-span-7" : "lg:col-span-12 max-w-4xl mx-auto w-full"}>
      <div class="rounded-3xl overflow-hidden border border-slate-200 shadow-md relative group bg-slate-100">
        
        <!-- Map Iframe (No contrast filter for smooth GPU scrolling) -->
        <div class="h-[300px] sm:h-[360px] lg:h-[400px] w-full">
          <iframe 
            src={googleMapEmbedUrl}
            class="w-full h-full border-0" 
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title={`${hotelTitle} Location Map`}
          ></iframe>
        </div>

        <!-- Practical UX CTA: Open in Google Maps Navigation App -->
        <div class="p-3 bg-white border-t border-slate-100 flex items-center justify-between text-xs">
          <div class="flex items-center gap-1.5 text-slate-600 truncate pr-2">
            <svg aria-hidden="true" class="w-4 h-4 text-emerald-700 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
              <circle cx="12" cy="11" r="3"/>
            </svg>
            <span class="truncate font-medium">{hotelLocation}</span>
          </div>

          <a 
            href={googleMapsAppUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="bg-[#0d3b23] hover:bg-[#061e14] text-white font-bold text-[11px] px-3.5 py-1.5 rounded-full shrink-0 flex items-center gap-1 transition shadow-xs active:scale-95"
            aria-label={`Get directions to ${hotelTitle} on Google Maps`}
          >
            <span>Get Directions</span>
            <span aria-hidden="true">➔</span>
          </a>
        </div>

      </div>
    </div>

  </div>
</section>

<!-- CLIENT SCRIPT -->
<script>
  let mapAbortCtrl: AbortController | null = null;

  function initHotelLocationMap() {
    if (mapAbortCtrl) mapAbortCtrl.abort();
    mapAbortCtrl = new AbortController();
    const { signal } = mapAbortCtrl;

    const toggleBtn = document.getElementById('toggleNearbyBtn');
    const extraList = document.getElementById('extraNearbyList');
    const toggleText = document.getElementById('toggleNearbyText');
    const toggleArrow = document.getElementById('toggleNearbyArrow');

    if (toggleBtn && extraList && toggleText && toggleArrow) {
      const extraCount = toggleBtn.getAttribute('data-count') || '';

      toggleBtn.addEventListener('click', () => {
        const isHidden = extraList.classList.contains('hidden');
        if (isHidden) {
          extraList.classList.remove('hidden');
          toggleText.textContent = 'Show Less';
          toggleArrow.textContent = '▲';
          toggleBtn.setAttribute('aria-expanded', 'true');
        } else {
          extraList.classList.add('hidden');
          toggleText.textContent = `See All About This Area (+${extraCount})`;
          toggleArrow.textContent = '➔';
          toggleBtn.setAttribute('aria-expanded', 'false');
        }
      }, { signal });
    }
  }

  document.addEventListener('DOMContentLoaded', initHotelLocationMap);
  document.addEventListener('astro:page-load', initHotelLocationMap);
</script>
