---
// src/components/hotel/HotelReviews.astro (100% Strict Hotel-Specific Matching & Cloudflare Build-Safe)
interface Props {
  hotel: any;
}

const { hotel } = Astro.props;
const data = hotel?.data || {};

// ১. হোটেলের নাম ও নিখুঁত ক্লিন স্লাগ তৈরি
const hotelTitle = (data.title || data.name || "Hotel Details").trim();
const rawSlug = String(data.slug || hotel?.slug || hotel?.id || "").trim();
const hotelSlug = rawSlug.replace(/\.(md|mdx)$/, '').split('/').pop()?.toLowerCase() || "";

const searchTitle = hotelTitle.toLowerCase();
const searchSlug = hotelSlug.toLowerCase();

// ২. ডাটা ফেচিং (Vite Glob দিয়ে সব ফাইল সিঙ্গেল ইনস্ট্যান্সে রিড)
let rawReviewsList: any[] = [];
try {
  const globFiles = import.meta.glob('/src/content/reviews/*.{md,mdx}', { eager: true });
  const entries = Object.values(globFiles);
  
  if (entries.length > 0) {
    rawReviewsList = entries.map((item: any) => item?.frontmatter || item?.data || item || {});
  } else {
    // ফলব্যাক পাথ যদি রুট পাথ খালি পায়
    const relFiles = import.meta.glob('../../content/reviews/*.{md,mdx}', { eager: true });
    rawReviewsList = Object.values(relFiles).map((item: any) => item?.frontmatter || item?.data || item || {});
  }
} catch (e) {
  rawReviewsList = [];
}

// ৩. STRICT EXACT MATCHING (যাতে এক হোটেলের রিভিউ কোনোভাবেই অন্য হোটেলে না যায়)
const approvedCmsReviews = rawReviewsList.filter((item: any) => {
  if (!item) return false;

  // Strict Approval: অবশ্যই approved: true থাকতে হবে
  const isApproved = item.approved === true || String(item.approved).trim().toLowerCase() === 'true';
  if (!isApproved) return false;

  // রিভিউ ফাইলের ফিল্ডগুলো ক্লিন ও লোয়ারকেস করা
  const rSlug = String(item.slug || item.hotelSlug || item.hotel_slug || '').replace(/\.(md|mdx)$/, '').split('/').pop()?.trim().toLowerCase() || "";
  const rId = String(item.id || '').replace(/\.(md|mdx)$/, '').split('/').pop()?.trim().toLowerCase() || "";
  const rHotel = String(item.hotel || item.hotelTitle || item.hotel_name || '').trim().toLowerCase();

  // হুবহু এক্স্যাক্ট ম্যাচ (কোনো includes নেই)
  const matchSlug = searchSlug !== "" && (rSlug === searchSlug || rId === searchSlug || rHotel === searchSlug);
  const matchTitle = searchTitle !== "" && (rHotel === searchTitle);

  return matchSlug || matchTitle;
});

// ৪. লোকাল (hotel.data.reviews) এবং সিএমএস রিভিউ মার্জ
const hotelEmbeddedReviews = Array.isArray(data.reviews) ? data.reviews : [];
const combinedRawReviews = [...approvedCmsReviews, ...hotelEmbeddedReviews];

// ৫. ফরম্যাটিং ও ডাটা ক্লিনআপ
const allReviews = combinedRawReviews.map((rev: any) => ({
  name: rev.name || rev.author || 'Verified Guest',
  date: rev.date || 'Recent',
  rating: Number(rev.rating) || 5,
  comment: String(rev.comment || rev.review || rev.body || '').trim()
})).filter(r => r.comment.length > 1);

// রেটিং ও কাউন্ট ক্যালকুলেশন
const reviewsCount = allReviews.length;
const avgRating = reviewsCount > 0 
  ? (allReviews.reduce((sum, r) => sum + r.rating, 0) / reviewsCount).toFixed(1) 
  : "5.0";

const starsArray = [1, 2, 3, 4, 5];
---

<!-- GUEST REVIEWS SECTION (PURE WHITE & SCROLL-MT ALIGNED) -->
<section id="guest-reviews" class="bg-white py-12 px-4 sm:px-8 lg:px-12 max-w-[1550px] mx-auto text-slate-800 border-b border-slate-200 scroll-mt-14 sm:scroll-mt-16">
  <div class="space-y-8">
    
    <!-- Section Header -->
    <div class="flex flex-col md:flex-row justify-between items-start md:items-end gap-6 border-b border-slate-200 pb-6 text-left">
      <div class="space-y-1">
        <h2 class="text-2xl sm:text-3xl font-black font-serif text-slate-900 tracking-tight leading-tight">
          Guest reviews & experiences
        </h2>
        <p class="text-xs sm:text-sm text-slate-500 font-medium">
          Verified stays and ratings for <strong class="text-slate-800 font-bold">{hotelTitle}</strong>
        </p>
      </div>

      <div class="flex flex-wrap items-center gap-3">
        {reviewsCount > 0 && (
          <div class="flex items-center gap-3 bg-slate-50 px-4 py-2 rounded-2xl border border-slate-200 shadow-xs">
            <div class="bg-[#0d3b23] text-white font-black px-2.5 py-1 rounded-t-lg rounded-br-lg text-lg leading-none">
              {avgRating}
            </div>
            <div class="flex flex-col justify-center">
              <div class="flex items-center gap-0.5 mb-1">
                {starsArray.map(s => (
                  <svg class={`w-3.5 h-3.5 shrink-0 ${s <= Math.round(Number(avgRating)) ? 'fill-amber-400' : 'fill-slate-200'}`} viewBox="0 0 24 24">
                    <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/>
                  </svg>
                ))}
              </div>
              <span class="text-[10px] font-extrabold text-slate-600 uppercase tracking-wider">{reviewsCount} Verified Reviews</span>
            </div>
          </div>
        )}

        {reviewsCount > 1 && (
          <div class="flex items-center gap-1.5">
            <button id="reviewPrevBtn" type="button" aria-label="Previous Review" class="w-9 h-9 rounded-full bg-slate-50 border border-slate-200 shadow-xs flex items-center justify-center hover:bg-[#0d3b23] hover:text-white transition active:scale-95 cursor-pointer font-bold text-xs text-slate-700">❮</button>
            <button id="reviewNextBtn" type="button" aria-label="Next Review" class="w-9 h-9 rounded-full bg-slate-50 border border-slate-200 shadow-xs flex items-center justify-center hover:bg-[#0d3b23] hover:text-white transition active:scale-95 cursor-pointer font-bold text-xs text-slate-700">❯</button>
          </div>
        )}

        <button type="button" class="open-write-review-trigger bg-[#0d3b23] hover:bg-[#061e14] text-white font-black text-xs px-5 py-2.5 rounded-xl transition shadow-xs cursor-pointer uppercase tracking-wider inline-flex items-center gap-2">
          <span>Write a Review</span>
          <svg class="w-3.5 h-3.5 fill-current shrink-0" viewBox="0 0 24 24">
            <path d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34a.9959.9959 0 0 0-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z"/>
          </svg>
        </button>
      </div>
    </div>

    <!-- Carousel Track -->
    {reviewsCount > 0 ? (
      <div id="reviewsCarouselTrack" class="flex gap-5 overflow-x-auto scroll-smooth pb-4 [scrollbar-width:none] [-ms-overflow-style:none] [&::-webkit-scrollbar]:hidden">
        {allReviews.map((rev) => {
          const isLong = rev.comment.length > 180;
          return (
            <div class="w-[290px] sm:w-[350px] shrink-0 bg-white rounded-3xl border border-slate-200 p-6 shadow-xs flex flex-col justify-between hover:border-emerald-600/50 hover:shadow-md transition-all duration-300 min-h-[260px] text-left">
              <div class="space-y-4">
                <div class="flex items-center justify-between">
                  <div class="flex items-center gap-0.5">
                    {starsArray.map(s => (
                      <svg class={`w-3.5 h-3.5 shrink-0 ${s <= rev.rating ? 'fill-amber-400' : 'fill-slate-200'}`} viewBox="0 0 24 24">
                        <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/>
                      </svg>
                    ))}
                  </div>
                  <span class="text-[10px] font-bold text-slate-400 uppercase tracking-widest">{rev.date}</span>
                </div>
                
                <div class="review-content relative">
                  <p class="text-xs sm:text-sm text-slate-700 leading-relaxed font-normal italic">
                    <span class="short-text">{isLong ? rev.comment.substring(0, 180) + '...' : rev.comment}</span>
                    {isLong && <span class="full-text hidden">{rev.comment}</span>}
                  </p>
                  {isLong && (
                    <button type="button" class="see-more-btn text-emerald-800 text-[11px] font-black mt-2 hover:underline cursor-pointer uppercase block">
                      See more ➔
                    </button>
                  )}
                </div>
              </div>

              <div class="mt-6 pt-4 border-t border-slate-100 flex items-center gap-3">
                <div class="w-8 h-8 rounded-full bg-emerald-50 text-emerald-900 flex items-center justify-center text-xs font-black uppercase border border-emerald-200">
                  {rev.name.charAt(0)}
                </div>
                <div class="flex flex-col">
                  <span class="text-xs font-bold text-slate-900 leading-tight">{rev.name}</span>
                  <span class="text-[10px] text-slate-400 font-semibold mt-0.5 uppercase tracking-wider">Verified Guest</span>
                </div>
              </div>
            </div>
          );
        })}
      </div>
    ) : (
      <div class="bg-slate-50/60 rounded-3xl border border-dashed border-slate-300 p-12 sm:p-16 text-center">
        <div class="w-14 h-14 mx-auto mb-3 rounded-2xl bg-white border border-slate-200 shadow-xs flex items-center justify-center text-slate-400">
          <svg class="w-7 h-7 fill-current" viewBox="0 0 24 24">
            <path d="M20 2H4c-1.1 0-2 .9-2 2v18l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm0 14H5.17L4 17.17V4h16v12z"/>
          </svg>
        </div>
        <p class="text-slate-600 font-medium text-sm italic">
          No guest reviews yet. Be the first to share your experience at {hotelTitle}!
        </p>
        <button type="button" class="open-write-review-trigger mt-4 text-emerald-800 hover:text-emerald-950 font-black underline uppercase text-xs tracking-widest cursor-pointer inline-flex items-center gap-1.5">
          <span>Write Review now</span>
          <span>➔</span>
        </button>
      </div>
    )}
  </div>
</section>

<!-- WRITE REVIEW MODAL -->
<div 
  id="writeReviewModal" 
  role="dialog" 
  aria-modal="true" 
  aria-labelledby="writeReviewModalTitle"
  class="fixed inset-0 z-[100] bg-slate-950/80 backdrop-blur-md hidden flex items-center justify-center p-4 text-left select-none"
>
  <div class="bg-white rounded-3xl p-6 sm:p-8 w-full max-w-lg shadow-2xl relative max-h-[92vh] overflow-y-auto border border-slate-200">
    <div class="flex items-center justify-between border-b border-slate-200 pb-4 mb-5">
      <div>
        <span class="text-[10px] font-black uppercase tracking-widest text-emerald-800 block">Verified Stay Feedback</span>
        <h3 id="writeReviewModalTitle" class="text-lg font-black font-serif text-slate-900 leading-tight">Review for {hotelTitle}</h3>
      </div>
      <button id="closeWriteReviewBtn" type="button" aria-label="Close Modal" class="text-slate-400 hover:text-slate-900 text-3xl font-light cursor-pointer">&times;</button>
    </div>

    <form id="submitReviewForm" data-hotel-title={hotelTitle} data-hotel-slug={hotelSlug} class="space-y-4">
      <div>
        <label for="reviewerName" class="text-[10px] font-black uppercase tracking-wider text-slate-500 mb-1 block">Full Name</label>
        <input type="text" id="reviewerName" required placeholder="e.g. Tanvir Ahmed" class="w-full bg-slate-50 border border-slate-200 rounded-xl p-3 outline-none focus:border-emerald-700 text-xs sm:text-sm font-medium" />
      </div>
      <div>
        <label for="reviewerRating" class="text-[10px] font-black uppercase tracking-wider text-slate-500 mb-1 block">Rating Score</label>
        <select id="reviewerRating" class="w-full bg-slate-50 border border-slate-200 rounded-xl p-3 outline-none focus:border-emerald-700 font-bold text-amber-600 text-xs sm:text-sm">
          <option value="5">5 / 5 (Excellent Experience)</option>
          <option value="4">4 / 5 (Very Good Stay)</option>
          <option value="3">3 / 5 (Average Service)</option>
          <option value="2">2 / 5 (Poor Facilities)</option>
          <option value="1">1 / 5 (Terrible Experience)</option>
        </select>
      </div>
      <div>
        <label for="reviewerComment" class="text-[10px] font-black uppercase tracking-wider text-slate-500 mb-1 block">Your Experience</label>
        <textarea id="reviewerComment" rows="4" required placeholder="Tell us about the room comfort, cleanliness, service, and breakfast..." class="w-full bg-slate-50 border border-slate-200 rounded-xl p-3 outline-none focus:border-emerald-700 text-xs sm:text-sm leading-relaxed font-medium"></textarea>
      </div>
      <button type="submit" id="submitReviewBtn" class="w-full bg-[#0d3b23] hover:bg-[#061e14] text-white font-black py-3.5 rounded-xl shadow-md transition uppercase tracking-wider text-xs mt-2 cursor-pointer">
        Submit Review For Approval
      </button>
    </form>
    
    <div id="reviewSuccessMsg" class="hidden p-6 bg-emerald-50 text-emerald-950 font-bold rounded-2xl text-center text-xs sm:text-sm border border-emerald-200 space-y-2">
      <div class="w-12 h-12 mx-auto rounded-full bg-emerald-100 border border-emerald-300 flex items-center justify-center text-emerald-800 shadow-xs">
        <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24">
          <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/>
        </svg>
      </div>
      <p class="text-sm font-black text-emerald-900">Submission Successful!</p>
      <p class="text-xs text-slate-600 font-normal">Thank you for your feedback. Your review will appear once verified by our moderation team.</p>
    </div>
  </div>
</div>

<!-- CLIENT SCRIPT -->
<script>
  let reviewsAbortCtrl: AbortController | null = null;

  function setupReviews() {
    if (reviewsAbortCtrl) reviewsAbortCtrl.abort();
    reviewsAbortCtrl = new AbortController();
    const { signal } = reviewsAbortCtrl;

    const track = document.getElementById('reviewsCarouselTrack');
    const modal = document.getElementById('writeReviewModal');
    const form = document.getElementById('submitReviewForm') as HTMLFormElement | null;
    const successMsg = document.getElementById('reviewSuccessMsg');
    const closeBtn = document.getElementById('closeWriteReviewBtn');
    const prevBtn = document.getElementById('reviewPrevBtn');
    const nextBtn = document.getElementById('reviewNextBtn');

    function toggleBodyScroll(disable: boolean) {
      document.body.style.overflow = disable ? 'hidden' : '';
    }

    function openModal() {
      if (!modal) return;
      modal.classList.remove('hidden');
      modal.classList.add('flex');
      successMsg?.classList.add('hidden');
      form?.classList.remove('hidden');
      toggleBodyScroll(true);
    }

    function closeModal() {
      if (!modal) return;
      modal.classList.add('hidden');
      modal.classList.remove('flex');
      toggleBodyScroll(false);
    }

    prevBtn?.addEventListener('click', () => track?.scrollBy({ left: -360, behavior: 'smooth' }));
    nextBtn?.addEventListener('click', () => track?.scrollBy({ left: 360, behavior: 'smooth' }));

    document.querySelectorAll('.see-more-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const target = e.currentTarget as HTMLElement;
        const content = target.closest('.review-content');
        if (!content) return;
        const short = content.querySelector('.short-text');
        const full = content.querySelector('.full-text');
        const isHidden = full?.classList.contains('hidden');
        
        if (isHidden) {
          full?.classList.remove('hidden');
          short?.classList.add('hidden');
          target.textContent = 'See less ↩';
        } else {
          full?.classList.add('hidden');
          short?.classList.remove('hidden');
          target.textContent = 'See more ➔';
        }
      });
    });

    document.querySelectorAll('.open-write-review-trigger').forEach(btn => {
      btn.addEventListener('click', openModal);
    });

    closeBtn?.addEventListener('click', closeModal);
    modal?.addEventListener('click', (e) => {
      if (e.target === modal) closeModal();
    });

    window.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'Escape' && modal && !modal.classList.contains('hidden')) {
        closeModal();
      }
    }, { signal });

    if (form) {
      form.onsubmit = async (e) => {
        e.preventDefault();
        const submitBtn = document.getElementById('submitReviewBtn') as HTMLButtonElement | null;
        const nameInput = document.getElementById('reviewerName') as HTMLInputElement | null;
        const ratingInput = document.getElementById('reviewerRating') as HTMLSelectElement | null;
        const commentInput = document.getElementById('reviewerComment') as HTMLTextAreaElement | null;

        if (!nameInput || !ratingInput || !commentInput) return;

        const payload = {
          hotel: form.getAttribute('data-hotel-title') || '',
          slug: form.getAttribute('data-hotel-slug') || '',
          name: nameInput.value.trim(),
          rating: ratingInput.value,
          comment: commentInput.value.trim(),
          approved: false,
          date: new Date().toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })
        };

        if (submitBtn) {
          submitBtn.disabled = true;
          submitBtn.textContent = 'Submitting...';
        }

        try {
          const res = await fetch('https://gatlin.rmollah394.workers.dev/api/submit-review', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
            signal
          });

          if (res.ok) {
            form.classList.add('hidden');
            form.reset();
            successMsg?.classList.remove('hidden');
            setTimeout(() => {
              closeModal();
            }, 3500);
          } else {
            alert('Failed to submit review. Please try again.');
          }
        } catch (err: any) {
          if (err.name !== 'AbortError') {
            alert('Network error. Please check your connection.');
          }
        } finally {
          if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.textContent = 'Submit Review For Approval';
          }
        }
      };
    }
  }

  document.addEventListener('DOMContentLoaded', setupReviews);
  document.addEventListener('astro:page-load', setupReviews);
</script>
