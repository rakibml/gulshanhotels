---
// src/components/hotel/HotelReviews.astro (100% Dynamic Auto-Calculated Ratings & Back-Button Safe)
import { getCollection } from 'astro:content';

interface Props {
  hotel: any;
}

const { hotel } = Astro.props;
const data = hotel?.data || {};

const hotelTitle = data.title || data.name || "Hotel Details";

// Default Fallback Guest Reviews
const defaultReviews = [
  {
    name: "Ismat F",
    date: "Aug 2026",
    rating: 5,
    comment: "Excellent location in Gulshan 2, very close to US Embassy & IVAC visa centers. Staff is polite and rooms are sparkling clean."
  },
  {
    name: "Fahimur R",
    date: "Aug 2026",
    rating: 5,
    comment: "Very nice hotel with 24/7 diplomatic security. The food quality at the buffet and rooftop lounge ambience are top notch."
  },
  {
    name: "Kaium Ali A",
    date: "Aug 2026",
    rating: 5,
    comment: "The atmosphere, high-speed Wi-Fi, and corporate meeting facilities are wonderful. Highly recommended for international delegates."
  },
  {
    name: "Tanvir H",
    date: "Aug 2026",
    rating: 5,
    comment: "Great experience staying here. The check-in was smooth, airport shuttle was on time, and breakfast spread was amazing."
  }
];

// Double-Layer Fetching: getCollection + import.meta.glob Fallback
let rawReviewsList: any[] = [];

try {
  const cmsReviews = await getCollection('reviews');
  if (Array.isArray(cmsReviews) && cmsReviews.length > 0) {
    rawReviewsList = cmsReviews.map(r => r.data || {});
  }
} catch (e) {
  console.warn('getCollection(reviews) bypassed, using glob scanner...', e);
}

if (rawReviewsList.length === 0) {
  try {
    const rawGlob = import.meta.glob('../../content/reviews/*.md', { eager: true });
    rawReviewsList = Object.values(rawGlob).map((item: any) => item.frontmatter || {});
  } catch (e) {
    console.warn('Glob scanner error:', e);
  }
}

// Filter Approved Reviews for this Hotel
const currentHotelName = hotelTitle.trim().toLowerCase();

const approvedCmsReviews = rawReviewsList
  .filter(item => {
    if (!item) return false;
    const isApproved = item.approved === true || String(item.approved).toLowerCase() === 'true';
    const reviewHotelName = (item.hotel || '').trim().toLowerCase();
    const isMatch = !reviewHotelName || 
      reviewHotelName === currentHotelName || 
      currentHotelName.includes(reviewHotelName) || 
      reviewHotelName.includes(currentHotelName);

    return isApproved && isMatch;
  })
  .map(item => ({
    name: item.name || 'Verified Guest',
    date: item.date || 'Aug 2026',
    rating: Number(item.rating) || 5,
    comment: item.comment || ''
  }));

const hotelEmbeddedReviews = Array.isArray(data.reviews) ? data.reviews : [];
const approvedReviews = approvedCmsReviews.length > 0 
  ? approvedCmsReviews 
  : (hotelEmbeddedReviews.length > 0 ? hotelEmbeddedReviews : defaultReviews);

// REALTIME AUTOMATIC AVERAGE RATING & COUNT CALCULATION
const reviewsCount = approvedReviews.length;
const totalStarsSum = approvedReviews.reduce((sum, r) => sum + (Number(r.rating) || 5), 0);
const hotelRating = reviewsCount > 0 ? (totalStarsSum / reviewsCount).toFixed(1) : "5.0";

// GOOGLE RICH SNIPPET STARS SCHEMA
const googleRatingSchema = {
  "@context": "https://schema.org",
  "@type": "Hotel",
  "name": hotelTitle,
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": String(hotelRating),
    "reviewCount": String(reviewsCount),
    "bestRating": "5",
    "worstRating": "1"
  },
  "review": approvedReviews.map((r: any) => ({
    "@type": "Review",
    "author": { "@type": "Person", "name": r.name || "Verified Guest" },
    "datePublished": "2026-08-01",
    "reviewBody": r.comment || "",
    "reviewRating": {
      "@type": "Rating",
      "ratingValue": String(r.rating || 5),
      "bestRating": "5"
    }
  }))
};
---

<!-- GOOGLE RICH SNIPPET SCHEMA FOR SERP GOLDEN STARS -->
<script type="application/ld+json" set:html={JSON.stringify(googleRatingSchema)} />

<!-- GUEST REVIEWS SECTION -->
<section id="guest-reviews" class="bg-[#F8FAF9] py-10 px-4 sm:px-8 lg:px-12 max-w-[1550px] mx-auto text-slate-800 border-b border-slate-200/80">
  <div class="space-y-6">
    
    <!-- Section Header -->
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 border-b border-slate-200/80 pb-4">
      <div>
        <h2 class="text-2xl sm:text-3xl font-black font-serif text-slate-900">
          Why guests love this hotel
        </h2>
        <p class="text-xs text-slate-500 mt-1">Real traveler experiences and guest ratings in Gulshan</p>
      </div>

      <!-- Right Rating Summary, Carousel Arrows & Write Review Button -->
      <div class="flex items-center gap-3">
        
        <!-- REALTIME AUTO-CALCULATED SCORE SUMMARY -->
        <div class="flex items-center gap-2 text-xs sm:text-sm font-bold text-slate-800 bg-white px-3.5 py-1.5 rounded-2xl border border-slate-200 shadow-sm">
          <span class="font-black text-slate-900 text-base">{hotelRating}</span>
          <div class="flex items-center text-amber-500 text-xs tracking-wider">
            ★ ★ ★ ★ ★
          </div>
          <span class="text-slate-500 font-normal">({reviewsCount} reviews)</span>
        </div>

        <!-- Carousel Navigation Arrows -->
        <div class="flex items-center gap-1.5">
          <button id="reviewPrevBtn" aria-label="Previous Reviews" class="w-9 h-9 rounded-full bg-white border border-slate-200 shadow-sm flex items-center justify-center text-slate-700 hover:bg-[#0d3b23] hover:text-white transition cursor-pointer text-xs font-bold active:scale-95">
            ❮
          </button>
          <button id="reviewNextBtn" aria-label="Next Reviews" class="w-9 h-9 rounded-full bg-white border border-slate-200 shadow-sm flex items-center justify-center text-slate-700 hover:bg-[#0d3b23] hover:text-white transition cursor-pointer text-xs font-bold active:scale-95">
            ❯
          </button>
        </div>

        <!-- Clean Write Review Button -->
        <button 
          id="openWriteReviewBtn" 
          class="bg-[#0d3b23] hover:bg-[#061e14] text-white font-extrabold text-xs px-4 py-2.5 rounded-xl shadow transition cursor-pointer"
        >
          Write a Review
        </button>
      </div>
    </div>

    <!-- REVIEWS CAROUSEL TRACK -->
    <div class="relative group">
      <div id="reviewsCarouselTrack" class="flex gap-4 overflow-x-auto scroll-smooth py-2 [scrollbar-width:none] [-ms-overflow-style:none] [&::-webkit-scrollbar]:hidden">
        
        {approvedReviews.map((rev: any) => {
          const ratingVal = Math.min(Math.max(Number(rev.rating) || 5, 1), 5);
          return (
            <div class="w-[290px] sm:w-[340px] shrink-0 bg-white rounded-2xl border border-slate-200/90 p-5 shadow-sm space-y-3 flex flex-col justify-between hover:shadow-md transition">
              <div class="space-y-2 text-left">
                <div class="flex items-center justify-between">
                  <!-- Dynamic Star Rating -->
                  <div class="flex items-center text-amber-500 text-xs tracking-wider">
                    {Array.from({ length: 5 }).map((_, i) => (
                      <span>{i < ratingVal ? '★' : '☆'}</span>
                    ))}
                  </div>
                  <span class="text-[11px] font-bold text-slate-500">{rev.name || 'Verified Guest'} • {rev.date || 'Recent'}</span>
                </div>
                <p class="text-xs sm:text-sm text-slate-700 leading-relaxed line-clamp-4 font-normal">
                  "{rev.comment || 'Great experience staying at this hotel.'}"
                </p>
              </div>
            </div>
          );
        })}

      </div>
    </div>

  </div>
</section>

<!-- SUBMIT REVIEW MODAL -->
<div id="writeReviewModal" role="dialog" aria-modal="true" class="fixed inset-0 z-50 bg-slate-950/80 backdrop-blur-md hidden flex items-center justify-center p-4">
  <div class="bg-white border border-slate-200 rounded-3xl p-6 sm:p-8 w-full max-w-lg text-slate-900 space-y-5 shadow-2xl relative max-h-[90vh] overflow-y-auto">
    
    <div class="flex items-center justify-between border-b border-slate-200 pb-3">
      <div>
        <span class="text-[10px] font-black uppercase text-emerald-800 tracking-widest block">Submit Guest Review</span>
        <h3 class="text-xl font-black font-serif text-slate-900">{hotelTitle}</h3>
      </div>
      <button id="closeWriteReviewBtn" class="text-slate-400 hover:text-slate-900 text-3xl font-bold p-1 cursor-pointer">&times;</button>
    </div>

    <!-- Review Form -->
    <form id="submitReviewForm" data-hotel-title={hotelTitle} class="space-y-4 text-xs sm:text-sm text-left">
      <div>
        <label class="block font-bold text-slate-800 uppercase text-[11px] mb-1">Your Name</label>
        <input type="text" id="reviewerName" required placeholder="e.g. Sarah Ahmed" class="w-full bg-slate-50 border border-slate-300 rounded-xl p-3 outline-none focus:border-emerald-600" />
      </div>

      <div>
        <label class="block font-bold text-slate-800 uppercase text-[11px] mb-1">Select Rating</label>
        <select id="reviewerRating" class="w-full bg-slate-50 border border-slate-300 rounded-xl p-3 outline-none focus:border-emerald-600 font-bold text-amber-600">
          <option value="5">★ ★ ★ ★ ★ 5 / 5 Excellent</option>
          <option value="4">★ ★ ★ ★ ☆ 4 / 5 Very Good</option>
          <option value="3">★ ★ ★ ☆ ☆ 3 / 5 Average</option>
          <option value="2">★ ★ ☆ ☆ ☆ 2 / 5 Poor</option>
          <option value="1">★ ☆ ☆ ☆ ☆ 1 / 5 Terrible</option>
        </select>
      </div>

      <div>
        <label class="block font-bold text-slate-800 uppercase text-[11px] mb-1">Your Review Comment</label>
        <textarea id="reviewerComment" rows="4" required placeholder="Share your experience regarding rooms, cleanliness, food, and staff service..." class="w-full bg-slate-50 border border-slate-300 rounded-xl p-3 outline-none focus:border-emerald-600 leading-relaxed"></textarea>
      </div>

      <button type="submit" id="submitReviewBtn" class="w-full bg-[#0d3b23] hover:bg-[#061e14] text-white font-extrabold text-xs uppercase tracking-wider py-3.5 rounded-xl shadow-lg transition cursor-pointer">
        Submit Review For Admin Approval ➔
      </button>
    </form>

    <!-- Success Message Box -->
    <div id="reviewSuccessMsg" class="hidden p-4 bg-emerald-50 border border-emerald-300 rounded-2xl text-emerald-900 text-xs font-bold text-center leading-relaxed">
      Thank you! Your review has been submitted successfully and will be published live as soon as.
    </div>

  </div>
</div>

<!-- CLIENT SCRIPT WITH BACK-BUTTON SAFETY & CAROUSEL -->
<script is:inline>
  const initHotelReviews = () => {
    const track = document.getElementById('reviewsCarouselTrack');
    const prevBtn = document.getElementById('reviewPrevBtn');
    const nextBtn = document.getElementById('reviewNextBtn');

    if (track && prevBtn && nextBtn) {
      prevBtn.addEventListener('click', () => {
        track.scrollBy({ left: -320, behavior: 'smooth' });
      });

      nextBtn.addEventListener('click', () => {
        track.scrollBy({ left: 320, behavior: 'smooth' });
      });
    }

    const modal = document.getElementById('writeReviewModal');
    const openBtn = document.getElementById('openWriteReviewBtn');
    const closeBtn = document.getElementById('closeWriteReviewBtn');
    const form = document.getElementById('submitReviewForm');
    const successMsg = document.getElementById('reviewSuccessMsg');
    const submitBtn = document.getElementById('submitReviewBtn');

    function hideModalDOM() {
      if (modal) modal.classList.add('hidden');
    }

    function openReviewModal() {
      if (!modal) return;
      if (successMsg) successMsg.classList.add('hidden');
      if (form) {
        form.classList.remove('hidden');
        form.reset();
      }
      modal.classList.remove('hidden');

      if (window.location.hash !== '#write-review') {
        window.location.hash = 'write-review';
      }
    }

    function closeReviewModalByUI() {
      if (window.location.hash === '#write-review') {
        history.back();
      } else {
        hideModalDOM();
      }
    }

    window.addEventListener('hashchange', () => {
      if (window.location.hash !== '#write-review') {
        hideModalDOM();
      } else if (modal && modal.classList.contains('hidden')) {
        modal.classList.remove('hidden');
      }
    });

    if (window.location.hash === '#write-review') {
      openReviewModal();
    }

    if (openBtn) openBtn.addEventListener('click', openReviewModal);
    if (closeBtn) closeBtn.addEventListener('click', closeReviewModalByUI);

    if (modal) {
      modal.addEventListener('click', (e) => {
        if (e.target === modal) closeReviewModalByUI();
      });
    }

    // Form Submission
    if (form) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const hotelTitle = form.getAttribute('data-hotel-title') || '';
        const name = document.getElementById('reviewerName')?.value || '';
        const rating = document.getElementById('reviewerRating')?.value || '5';
        const comment = document.getElementById('reviewerComment')?.value || '';

        if (submitBtn) {
          submitBtn.disabled = true;
          submitBtn.innerText = 'Submitting...';
        }

        try {
          const res = await fetch('https://gatlin.rmollah394.workers.dev/api/submit-review', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              hotel: hotelTitle,
              name: name,
              rating: rating,
              comment: comment,
              status: 'pending'
            })
          });

          const resData = await res.json();

          if (res.ok && resData.success) {
            if (form) form.classList.add('hidden');
            if (successMsg) successMsg.classList.remove('hidden');
          } else {
            alert('Review Submission Error: ' + (resData.error || resData.details || 'Failed to write to GitHub. Check GITHUB_TOKEN.'));
          }
        } catch (err) {
          alert('Network Error: ' + err.message);
        } finally {
          if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.innerText = 'Submit Review For Admin Approval ➔';
          }
        }
      });
    }
  };

  document.addEventListener('DOMContentLoaded', initHotelReviews);
  document.addEventListener('astro:page-load', initHotelReviews);
</script>
