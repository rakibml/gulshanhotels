---
// src/components/hotel/HotelReviews.astro
import { getCollection } from 'astro:content';

interface Props {
  hotel: any;
}

const { hotel } = Astro.props;
const data = hotel?.data || {};

const hotelTitle = (data.title || data.name || "Hotel Details").trim();
const hotelSlug = (data.slug || hotel?.slug || hotel?.id || "hotel").trim();

// Layer 1 & 2: Fetching Reviews
let rawReviewsList: any[] = [];
try {
  const cmsReviews = await getCollection('reviews');
  if (cmsReviews) rawReviewsList = cmsReviews.map(r => r.data || {});
} catch (e) {
  const rawGlob = import.meta.glob('../../content/reviews/*.md', { eager: true });
  rawReviewsList = Object.values(rawGlob).map((item: any) => item.frontmatter || {});
}

// Filtering Approved Reviews
const currentHotelTitle = hotelTitle.toLowerCase();
const currentHotelSlug = hotelSlug.toLowerCase();

const approvedCmsReviews = rawReviewsList.filter(item => {
  if (!item || !item.approved) return false;
  const rHotel = (item.hotel || '').toLowerCase();
  const rSlug = (item.slug || item.hotelSlug || '').toLowerCase();
  return rHotel === currentHotelTitle || rSlug === currentHotelSlug;
});

// Merging both CMS reviews and Hardcoded data reviews
const hotelEmbeddedReviews = Array.isArray(data.reviews) ? data.reviews : [];
const allApprovedReviews = [...approvedCmsReviews, ...hotelEmbeddedReviews].map(item => ({
  name: item.name || 'Verified Guest',
  date: item.date || 'Recent',
  rating: Number(item.rating) || 5,
  comment: item.comment || ''
})).filter(r => r.comment.length > 2); // Filter out empty comments

const reviewsCount = allApprovedReviews.length;
const totalStarsSum = allApprovedReviews.reduce((sum, r) => sum + r.rating, 0);
const hotelRating = reviewsCount > 0 ? (totalStarsSum / reviewsCount).toFixed(1) : "5.0";

// SEO Schema
const googleRatingSchema = reviewsCount > 0 ? {
  "@context": "https://schema.org",
  "@type": "Hotel",
  "name": hotelTitle,
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": hotelRating,
    "reviewCount": reviewsCount,
    "bestRating": "5",
    "worstRating": "1"
  },
  "review": allApprovedReviews.slice(0, 5).map(r => ({
    "@type": "Review",
    "author": { "@type": "Person", "name": r.name },
    "datePublished": r.date.includes('-') ? r.date : new Date().toISOString().split('T')[0],
    "reviewBody": r.comment,
    "reviewRating": { "@type": "Rating", "ratingValue": r.rating }
  }))
} : null;

const starsArray = [1, 2, 3, 4, 5];
---

{googleRatingSchema && (
  <script type="application/ld+json" set:html={JSON.stringify(googleRatingSchema)} />
)}

<section id="guest-reviews" class="bg-[#F8FAF9] py-12 px-4 sm:px-8 max-w-[1400px] mx-auto border-b border-slate-200">
  <div class="space-y-8">
    
    <!-- Header -->
    <div class="flex flex-col md:flex-row justify-between items-start md:items-end gap-6 border-b border-slate-200 pb-6">
      <div class="space-y-1">
        <h2 class="text-2xl sm:text-3xl font-black text-slate-900 tracking-tight">
          Guest reviews & experiences
        </h2>
        <p class="text-sm text-slate-500 font-medium">Verified stays and ratings for {hotelTitle}</p>
      </div>

      <div class="flex flex-wrap items-center gap-3">
        {reviewsCount > 0 && (
          <div class="flex items-center gap-3 bg-white px-4 py-2 rounded-2xl border border-slate-200 shadow-sm">
            <div class="bg-[#003580] text-white font-black px-2 py-1 rounded-t-lg rounded-br-lg text-lg leading-none">
              {hotelRating}
            </div>
            <div class="flex flex-col justify-center">
              <div class="flex text-amber-500 text-[10px]">
                {starsArray.map(s => (<span>{s <= Math.round(Number(hotelRating)) ? '★' : '☆'}</span>))}
              </div>
              <span class="text-[11px] font-bold text-slate-700 uppercase">{reviewsCount} Reviews</span>
            </div>
          </div>
        )}

        <div class="flex items-center gap-2">
            <button id="reviewPrevBtn" class="w-10 h-10 rounded-full bg-white border border-slate-200 shadow-sm flex items-center justify-center hover:bg-slate-50 transition active:scale-90 cursor-pointer">❮</button>
            <button id="reviewNextBtn" class="w-10 h-10 rounded-full bg-white border border-slate-200 shadow-sm flex items-center justify-center hover:bg-slate-50 transition active:scale-90 cursor-pointer">❯</button>
        </div>

        <button class="open-write-review-trigger bg-[#003580] hover:bg-[#00224f] text-white font-bold text-xs px-5 py-3 rounded-xl transition shadow-md cursor-pointer">
          Write a Review
        </button>
      </div>
    </div>

    <!-- Carousel -->
    {reviewsCount > 0 ? (
      <div id="reviewsCarouselTrack" class="flex gap-5 overflow-x-auto scroll-smooth pb-4 no-scrollbar">
        {allApprovedReviews.map((rev) => (
          <div class="w-[300px] sm:w-[380px] shrink-0 bg-white rounded-2xl border border-slate-200 p-6 shadow-sm flex flex-col justify-between hover:border-blue-200 transition">
            <div class="space-y-4">
              <div class="flex items-center justify-between">
                <div class="flex text-amber-500 text-xs">
                  {starsArray.map(s => (<span>{s <= rev.rating ? '★' : '☆'}</span>))}
                </div>
                <span class="text-[10px] font-bold text-slate-400 uppercase">{rev.date}</span>
              </div>
              <p class="text-sm text-slate-700 leading-relaxed italic font-medium">
                "{rev.comment}"
              </p>
            </div>
            <div class="mt-6 pt-4 border-t border-slate-50 flex items-center gap-2">
                <div class="w-7 h-7 rounded-full bg-slate-100 flex items-center justify-center text-[10px] font-bold text-slate-500">{rev.name.charAt(0)}</div>
                <span class="text-xs font-black text-slate-900">{rev.name}</span>
            </div>
          </div>
        ))}
      </div>
    ) : (
      <div class="bg-white rounded-3xl border border-dashed border-slate-300 p-12 text-center">
        <p class="text-slate-500 font-medium">No reviews yet. Be the first to share your experience!</p>
      </div>
    )}
  </div>
</section>

<!-- [Keep the Modal and Script part as it was, but ensure the ID matches] -->

<style>
  .no-scrollbar::-webkit-scrollbar { display: none; }
  .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
</style>

<script is:inline>
  function initReviews() {
    const track = document.getElementById('reviewsCarouselTrack');
    document.getElementById('reviewPrevBtn')?.onclick = () => track?.scrollBy({ left: -400, behavior: 'smooth' });
    document.getElementById('reviewNextBtn')?.onclick = () => track?.scrollBy({ left: 400, behavior: 'smooth' });

    // Modal logic (Same as yours, but clean and idempotent)
    const modal = document.getElementById('writeReviewModal');
    const openBtns = document.querySelectorAll('.open-write-review-trigger');
    const closeBtn = document.getElementById('closeWriteReviewBtn');

    openBtns.forEach(btn => {
      btn.onclick = () => modal?.classList.remove('hidden');
    });

    closeBtn.onclick = () => modal?.classList.add('hidden');
    
    // Form Submission (Fetch logic remains same as yours)
  }

  document.addEventListener('DOMContentLoaded', initReviews);
  document.addEventListener('astro:page-load', initReviews);
</script>
