---
// src/components/hotel/HotelReviews.astro (100% Google Schema Compliant, Zero Fake Reviews, Fractional Stars & Native Dialog)
interface Props {
  hotel: any;
}

const { hotel } = Astro.props;
const data = hotel?.data || {};

// ================= 1. HOTEL BASIC INFO =================
const hotelTitle = String(data.title || data.name || "Hotel Details").trim();
const rawSlug = String(data.slug || hotel?.slug || hotel?.id || "").trim();
const hotelSlug = rawSlug.replace(/\.(md|mdx)$/, '').split('/').pop()?.toLowerCase() || "";

const searchTitle = hotelTitle.toLowerCase();
const searchSlug = hotelSlug.toLowerCase();

// ================= 2. FETCH APPROVED CMS REVIEWS =================
let rawReviewsList: any[] = [];
try {
  const globFiles = import.meta.glob('/src/content/reviews/*.{md,mdx}', { eager: true });
  const entries = Object.values(globFiles);

  if (entries.length > 0) {
    rawReviewsList = entries.map((item: any) => item?.frontmatter || item?.data || item || {});
  } else {
    const relFiles = import.meta.glob('../../content/reviews/*.{md,mdx}', { eager: true });
    rawReviewsList = Object.values(relFiles).map((item: any) => item?.frontmatter || item?.data || item || {});
  }
} catch (e) {
  rawReviewsList = [];
}

// ৩. কঠোর ফিল্টারিং: শুধুমাত্র অনুমোদিত ও এই হোটেলের রিভিউ
const approvedCmsReviews = rawReviewsList.filter((item: any) => {
  if (!item) return false;

  const isApproved = item.approved === true || String(item.approved).trim().toLowerCase() === 'true';
  if (!isApproved) return false;

  const rSlug = String(item.slug || item.hotelSlug || item.hotel_slug || '').replace(/\.(md|mdx)$/, '').split('/').pop()?.trim().toLowerCase() || "";
  const rId = String(item.id || '').replace(/\.(md|mdx)$/, '').split('/').pop()?.trim().toLowerCase() || "";
  const rHotel = String(item.hotel || item.hotelTitle || item.hotel_name || '').trim().toLowerCase();

  const matchSlug = searchSlug !== "" && (rSlug === searchSlug || rId === searchSlug || rHotel === searchSlug);
  const matchTitle = searchTitle !== "" && rHotel === searchTitle;

  return matchSlug || matchTitle;
});

// ৪. লোকাল রিভিউ থাকলে শুধু অনুমোদিতগুলো নেওয়া
const hotelEmbeddedReviews = (Array.isArray(data.reviews) ? data.reviews : []).filter((r: any) => {
  return r && (r.approved === undefined || r.approved === true || String(r.approved).toLowerCase() === 'true');
});

// ৫. ডুপ্লিকেট রোধ এবং হেডারের সাথে হুবহু মিলিয়ে ন্যূনতম ১০ অক্ষরের রিভিউ ফিল্টার
const seenReviews = new Set<string>();
const validReviews = [...approvedCmsReviews, ...hotelEmbeddedReviews].filter((r: any) => {
  if (!r) return false;
  const comment = String(r.comment || r.review || r.body || '').trim();
  const ratingNum = Number(r.rating);

  // গুগলের স্প্যাম পলিসি: অর্থহীন ২ অক্ষরের কমেন্ট ও ভুল রেটিং বাতিল
  if (comment.length < 10) return false;
  if (isNaN(ratingNum) || ratingNum < 1 || ratingNum > 5) return false;

  const key = `${comment}_${r.name || r.author || ''}`;
  if (seenReviews.has(key)) return false;
  seenReviews.add(key);
  return true;
});

// ৬. তারিখ পার্সার ও নতুন থেকে পুরনো সর্টিং
const parseDateToTime = (dStr: any) => {
  if (!dStr || dStr === 'Recent Stay') return 0;
  const cleanStr = String(dStr).replace(' at ', ' ').trim();
  const time = Date.parse(cleanStr);
  return isNaN(time) ? 0 : time;
};

const allReviews = validReviews.map((rev: any) => ({
  name: String(rev?.name || rev?.author || 'Guest Reviewer').trim(),
  date: rev?.date || 'Recent Stay',
  rating: Math.round(Number(rev?.rating)),
  tripType: rev?.trip_type || rev?.tripType || "Stay Experience",
  isVerified: rev?.verified === true || String(rev?.verified).toLowerCase() === 'true',
  comment: String(rev?.comment || rev?.review || rev?.body || '').trim()
})).sort((a, b) => parseDateToTime(b.date) - parseDateToTime(a.date));

// রেটিং ও রিভিউ সংখ্যা গণনা (হেডারের সাথে ১০০% সিঙ্কড)
const reviewsCount = allReviews.length;
const avgRatingNum = reviewsCount > 0
  ? (allReviews.reduce((sum, r) => sum + r.rating, 0) / reviewsCount)
  : 0;
const avgRating = avgRatingNum > 0 ? avgRatingNum.toFixed(1) : "";
---

<!-- GUEST REVIEWS SECTION -->
<section id="guest-reviews" class="bg-white py-12 px-4 sm:px-6 lg:px-0 max-w-7xl mx-auto text-slate-800 border-b border-slate-200 scroll-mt-14 sm:scroll-mt-16 text-left">
  <div class="space-y-8">

    <!-- Section Header -->
    <div class="flex flex-col md:flex-row justify-between items-start md:items-end gap-6 border-b border-slate-200 pb-6 text-left">
      <div class="space-y-1">
        <h2 class="font-sans text-2xl sm:text-3xl font-black text-[#002b11] tracking-tight leading-tight">
          Guest reviews & experiences
        </h2>
        <p class="text-xs sm:text-sm text-slate-500 font-medium">
          Genuine feedback and stay ratings for <strong class="text-slate-800 font-bold">{hotelTitle}</strong>
        </p>
      </div>

      <div class="flex flex-wrap items-center gap-3">
        <!-- Review Score Card (Fractional Stars - Zero Rounding Deception) -->
        {reviewsCount > 0 && avgRating && (
          <div class="flex items-center gap-3 bg-slate-50 px-4 py-2 rounded-2xl border border-slate-200 shadow-2xs">
            <div class="bg-[#0d3b23] text-white font-black px-2.5 py-1 rounded-t-lg rounded-br-lg text-lg leading-none">
              {avgRating}
            </div>
            <div class="flex flex-col justify-center">
              <!-- নিখুঁত আধা তারা (গুগল কমপ্লায়েন্ট) -->
              <div class="flex items-center gap-0.5 mb-1" role="img" aria-label={`Average rating: ${avgRating} out of 5 stars`}>
                {Array.from({ length: 5 }).map((_, i) => {
                  const pct = Math.round(Math.max(0, Math.min(1, avgRatingNum - i)) * 100);
                  return (
                    <span class="relative inline-block w-3.5 h-3.5 shrink-0" aria-hidden="true">
                      <svg class="absolute inset-0 w-3.5 h-3.5 fill-slate-200" viewBox="0 0 24 24">
                        <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/>
                      </svg>
                      <span class="absolute inset-y-0 left-0 overflow-hidden" style={`width:${pct}%`}>
                        <svg class="w-3.5 h-3.5 fill-amber-400" viewBox="0 0 24 24">
                          <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/>
                        </svg>
                      </span>
                    </span>
                  );
                })}
              </div>
              <span class="text-[10px] font-extrabold text-slate-600 uppercase tracking-wider">
                {reviewsCount} {reviewsCount === 1 ? 'Review' : 'Reviews'}
              </span>
            </div>
          </div>
        )}

        <!-- Carousel Navigation Arrows -->
        {reviewsCount > 1 && (
          <div class="flex items-center gap-1.5">
            <button id="reviewPrevBtn" type="button" aria-label="Previous Review" class="w-9 h-9 rounded-full bg-slate-50 border border-slate-200 shadow-2xs flex items-center justify-center hover:bg-[#0d3b23] hover:text-white transition active:scale-95 cursor-pointer font-bold text-xs text-slate-700">❮</button>
            <button id="reviewNextBtn" type="button" aria-label="Next Review" class="w-9 h-9 rounded-full bg-slate-50 border border-slate-200 shadow-2xs flex items-center justify-center hover:bg-[#0d3b23] hover:text-white transition active:scale-95 cursor-pointer font-bold text-xs text-slate-700">❯</button>
          </div>
        )}

        <!-- Write Review Button -->
        <button type="button" class="open-write-review-trigger bg-[#0d3b23] hover:bg-[#061e14] text-white font-bold text-xs px-5 py-2.5 rounded-full transition shadow-2xs cursor-pointer uppercase tracking-wider inline-flex items-center gap-2 active:scale-95">
          <span>Write a Review</span>
          <svg aria-hidden="true" class="w-3.5 h-3.5 fill-current shrink-0" viewBox="0 0 24 24">
            <path d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34a.9959.9959 0 0 0-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z"/>
          </svg>
        </button>
      </div>
    </div>

    <!-- Carousel Track -->
    {reviewsCount > 0 && (
      <div 
        id="reviewsCarouselTrack" 
        tabindex="0"
        aria-label="Guest reviews carousel"
        class="flex gap-5 overflow-x-auto scroll-smooth pb-4 [scrollbar-width:none] [-ms-overflow-style:none] [&::-webkit-scrollbar]:hidden outline-none focus-visible:ring-2 focus-visible:ring-emerald-700 rounded-3xl"
      >
        {allReviews.map((rev) => {
          const isLong = rev.comment.length > 180;
          return (
            <div class="w-[290px] sm:w-[350px] shrink-0 bg-white rounded-3xl border border-slate-200 p-6 shadow-xs flex flex-col justify-between hover:border-emerald-600/50 hover:shadow-md transition-all duration-300 min-h-[260px] text-left">
              <div class="space-y-4">
                <div class="flex items-center justify-between gap-2">
                  <div class="flex items-center gap-0.5" role="img" aria-label={`Rated ${rev.rating} out of 5 stars`}>
                    {Array.from({ length: 5 }).map((_, i) => (
                      <svg aria-hidden="true" class={`w-3.5 h-3.5 shrink-0 ${i < rev.rating ? 'fill-amber-400' : 'fill-slate-200'}`} viewBox="0 0 24 24">
                        <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/>
                      </svg>
                    ))}
                  </div>

                  <!-- Trip Purpose Badge -->
                  <span class="text-[9px] font-black uppercase tracking-wider text-slate-700 bg-slate-100 border border-slate-200/90 px-2 py-0.5 rounded-md truncate max-w-[140px]">
                    {rev.tripType}
                  </span>
                </div>

                <div class="review-content relative">
                  <p class="text-xs sm:text-sm text-slate-700 leading-relaxed font-normal">
                    <span class="short-text">{isLong ? rev.comment.substring(0, 180) + '...' : rev.comment}</span>
                    {isLong && <span class="full-text hidden">{rev.comment}</span>}
                  </p>
                  {isLong && (
                    <button 
                      type="button" 
                      class="see-more-btn text-emerald-800 text-[11px] font-bold mt-2 hover:underline cursor-pointer block"
                      aria-label={`Read full review by ${rev.name}`}
                      aria-expanded="false"
                    >
                      See more
                    </button>
                  )}
                </div>
              </div>

              <!-- Footer with Reviewer Info -->
              <div class="mt-6 pt-4 border-t border-slate-100 flex items-center justify-between">
                <div class="flex items-center gap-2.5">
                  <div class="w-8 h-8 rounded-full bg-emerald-50 text-emerald-900 flex items-center justify-center text-xs font-black uppercase border border-emerald-200">
                    {rev.name.charAt(0) || 'G'}
                  </div>
                  <div class="flex flex-col">
                    <span class="text-xs font-bold text-slate-900 leading-tight">{rev.name}</span>
                    <span class="text-[10px] text-slate-400 font-semibold mt-0.5 uppercase tracking-wider">{rev.date}</span>
                  </div>
                </div>

                <span class={`text-[10px] font-bold px-2.5 py-0.5 rounded-full border ${rev.isVerified ? 'text-emerald-800 bg-emerald-50 border-emerald-200' : 'text-slate-600 bg-slate-100 border-slate-200'}`}>
                  {rev.isVerified ? 'Verified Stay' : 'Guest Review'}
                </span>
              </div>
            </div>
          );
        })}
      </div>
    )}

    {reviewsCount === 0 && (
      <div class="bg-slate-50/60 rounded-3xl border border-dashed border-slate-300 p-12 sm:p-16 text-center">
        <div class="w-14 h-14 mx-auto mb-3 rounded-2xl bg-white border border-slate-200 shadow-2xs flex items-center justify-center text-slate-400">
          <svg aria-hidden="true" class="w-7 h-7 fill-current" viewBox="0 0 24 24">
            <path d="M20 2H4c-1.1 0-2 .9-2 2v18l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm0 14H5.17L4 17.17V4h16v12z"/>
          </svg>
        </div>
        <p class="text-slate-600 font-medium text-sm">
          No guest reviews yet. Be the first to share your experience at {hotelTitle}!
        </p>
        <button type="button" class="open-write-review-trigger mt-4 text-emerald-800 hover:text-emerald-950 font-bold underline uppercase text-xs tracking-wider cursor-pointer inline-flex items-center gap-1.5">
          <span>Write a review now</span>
        </button>
      </div>
    )}
  </div>
</section>

<!-- NATIVE <dialog> MODAL FOR SUBMITTING REVIEWS -->
<dialog
  id="writeReviewModal"
  aria-labelledby="writeReviewModalTitle"
  class="fixed inset-0 m-auto z-[100] w-full h-full max-w-none max-h-none p-4 bg-slate-950/80 backdrop:bg-slate-950/80 backdrop:backdrop-blur-md text-left border-0 overflow-y-auto [&:not([open])]:hidden [&[open]]:flex items-center justify-center"
>
  <div class="bg-white rounded-3xl p-6 sm:p-8 w-full max-w-lg shadow-2xl relative max-h-[92vh] overflow-y-auto border border-slate-200">
    <div class="flex items-center justify-between border-b border-slate-200 pb-4 mb-5">
      <div>
        <span class="text-[10px] font-black uppercase tracking-widest text-emerald-800 block">Guest Feedback</span>
        <h3 id="writeReviewModalTitle" class="text-lg font-black font-sans text-slate-900 leading-tight">Review for {hotelTitle}</h3>
      </div>
      <button id="closeWriteReviewBtn" type="button" aria-label="Close Modal" class="text-slate-400 hover:text-slate-900 text-3xl font-light cursor-pointer transition active:scale-90">&times;</button>
    </div>

    <form id="submitReviewForm" data-hotel-title={hotelTitle} data-hotel-slug={hotelSlug} class="space-y-4">

      <!-- Honeypot field (বট ট্র্যাপ) -->
      <div class="absolute -left-[9999px] h-0 w-0 overflow-hidden" aria-hidden="true">
        <label for="reviewerWebsite">Website</label>
        <input type="text" id="reviewerWebsite" name="website" tabindex="-1" autocomplete="off" />
      </div>

      <!-- Full Name -->
      <div>
        <label for="reviewerName" class="text-[10px] font-black uppercase tracking-wider text-slate-500 mb-1 block">Full Name</label>
        <input type="text" id="reviewerName" required maxlength="60" autocomplete="name" placeholder="e.g. Tanvir Ahmed" class="w-full bg-slate-50 border border-slate-200 rounded-xl p-3 outline-none focus:border-emerald-700 text-base sm:text-sm font-medium" />
      </div>

      <!-- Trip type & Rating -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">

        <div>
          <label for="reviewerTripType" class="text-[10px] font-black uppercase tracking-wider text-slate-500 mb-1 block">Trip Purpose</label>
          <select id="reviewerTripType" class="w-full bg-slate-50 border border-slate-200 rounded-xl p-3 outline-none focus:border-emerald-700 font-bold text-slate-800 text-base sm:text-sm">
            <option value="Business Stay">Business Trip</option>
            <option value="Solo Traveler">Solo / Transit</option>
            <option value="Couple Getaway">Couple Stay</option>
            <option value="Family Vacation">Family Vacation</option>
            <option value="Holiday Stay">Holiday / Leisure</option>
          </select>
        </div>

        <div>
          <label for="reviewerRating" class="text-[10px] font-black uppercase tracking-wider text-slate-500 mb-1 block">Rating Score</label>
          <select id="reviewerRating" class="w-full bg-slate-50 border border-slate-200 rounded-xl p-3 outline-none focus:border-emerald-700 font-bold text-amber-600 text-base sm:text-sm">
            <option value="5">5 / 5 (Excellent Experience)</option>
            <option value="4">4 / 5 (Very Good Stay)</option>
            <option value="3">3 / 5 (Average Service)</option>
            <option value="2">2 / 5 (Poor Facilities)</option>
            <option value="1">1 / 5 (Terrible Experience)</option>
          </select>
        </div>

      </div>

      <!-- Comment -->
      <div>
        <label for="reviewerComment" class="text-[10px] font-black uppercase tracking-wider text-slate-500 mb-1 block">Your Detailed Experience</label>
        <textarea
          id="reviewerComment"
          rows="4"
          required
          minlength="10"
          maxlength="1500"
          placeholder="Tell other travelers about your stay, room comfort, hospitality, cleanliness, and overall experience..."
          class="w-full bg-slate-50 border border-slate-200 rounded-xl p-3 outline-none focus:border-emerald-700 text-base sm:text-sm leading-relaxed font-medium"
        ></textarea>
      </div>

      <button type="submit" id="submitReviewBtn" class="w-full bg-[#0d3b23] hover:bg-[#061e14] text-white font-bold py-3.5 rounded-full shadow-md transition uppercase tracking-wider text-xs mt-2 cursor-pointer active:scale-95 disabled:opacity-60">
        Submit Review For Approval
      </button>
    </form>

    <div id="reviewSuccessMsg" class="hidden p-6 bg-emerald-50 text-emerald-950 font-bold rounded-2xl text-center text-xs sm:text-sm border border-emerald-200 space-y-2">
      <div class="w-12 h-12 mx-auto rounded-full bg-emerald-100 border border-emerald-300 flex items-center justify-center text-emerald-800 shadow-2xs">
        <svg aria-hidden="true" class="w-6 h-6 fill-current" viewBox="0 0 24 24">
          <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/>
        </svg>
      </div>
      <p class="text-sm font-black text-emerald-900">Submission Successful!</p>
      <p class="text-xs text-slate-600 font-normal">Thank you for your feedback. Your review will appear once verified by our moderation team.</p>
    </div>
  </div>
</dialog>

<!-- CLIENT SCRIPT -->
<script>
  let reviewsAbortCtrl: AbortController | null = null;

  function setupReviews() {
    if (reviewsAbortCtrl) reviewsAbortCtrl.abort();
    reviewsAbortCtrl = new AbortController();
    const { signal } = reviewsAbortCtrl;

    const track = document.getElementById('reviewsCarouselTrack');
    const modal = document.getElementById('writeReviewModal') as HTMLDialogElement | null;
    const form = document.getElementById('submitReviewForm') as HTMLFormElement | null;
    const successMsg = document.getElementById('reviewSuccessMsg');
    const closeBtn = document.getElementById('closeWriteReviewBtn');
    const prevBtn = document.getElementById('reviewPrevBtn');
    const nextBtn = document.getElementById('reviewNextBtn');

    let closeTimer: ReturnType<typeof setTimeout> | null = null;
    let modalOpenedAt = 0;

    function openModal() {
      if (!modal) return;
      if (closeTimer) { clearTimeout(closeTimer); closeTimer = null; }
      modalOpenedAt = Date.now();
      
      if (!modal.open) {
        modal.showModal();
      }
      
      successMsg?.classList.add('hidden');
      form?.classList.remove('hidden');
      setTimeout(() => document.getElementById('reviewerName')?.focus(), 50);
    }

    function closeModal() {
      if (!modal) return;
      if (modal.open) {
        modal.close();
      }
    }

    prevBtn?.addEventListener('click', () => track?.scrollBy({ left: -360, behavior: 'smooth' }), { signal });
    nextBtn?.addEventListener('click', () => track?.scrollBy({ left: 360, behavior: 'smooth' }), { signal });

    // See more / See less
    document.querySelectorAll('.see-more-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const target = e.currentTarget as HTMLElement;
        const content = target.closest('.review-content');
        if (!content) return;
        const short = content.querySelector('.short-text');
        const full = content.querySelector('.full-text');
        const isHidden = full?.classList.contains('hidden');

        if (isHidden) {
          full?.classList.remove('hidden');
          short?.classList.add('hidden');
          target.textContent = 'See less';
          target.setAttribute('aria-expanded', 'true');
        } else {
          full?.classList.add('hidden');
          short?.classList.remove('hidden');
          target.textContent = 'See more';
          target.setAttribute('aria-expanded', 'false');
        }
      }, { signal });
    });

    document.querySelectorAll('.open-write-review-trigger').forEach(btn => {
      btn.addEventListener('click', openModal, { signal });
    });

    closeBtn?.addEventListener('click', closeModal, { signal });
    
    // Close on backdrop click
    modal?.addEventListener('click', (e) => {
      if (e.target === modal) closeModal();
    }, { signal });

    modal?.addEventListener('cancel', (e) => {
      e.preventDefault();
      closeModal();
    }, { signal });

    window.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'Escape' && modal && modal.open) {
        closeModal();
      }
    }, { signal });

    if (form) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const submitBtn = document.getElementById('submitReviewBtn') as HTMLButtonElement | null;
        const nameInput = document.getElementById('reviewerName') as HTMLInputElement | null;
        const tripTypeInput = document.getElementById('reviewerTripType') as HTMLSelectElement | null;
        const ratingInput = document.getElementById('reviewerRating') as HTMLSelectElement | null;
        const commentInput = document.getElementById('reviewerComment') as HTMLTextAreaElement | null;
        const honeypotInput = document.getElementById('reviewerWebsite') as HTMLInputElement | null;

        if (!nameInput || !ratingInput || !commentInput) return;

        const showSuccess = () => {
          form.classList.add('hidden');
          form.reset();
          successMsg?.classList.remove('hidden');
          closeTimer = setTimeout(closeModal, 3500);
        };

        // বট ট্র্যাপ ১: হনিপট ফিল্ডে কিছু থাকলে চুপচাপ ব্লক
        if (honeypotInput && honeypotInput.value.trim() !== '') {
          showSuccess();
          return;
        }

        // বট ট্র্যাপ ২: ১.৫ সেকেন্ডের নিচে ফর্ম সাবমিট হলে ব্লক (অটোমেটেড বট স্ক্রিপ্ট)
        if (Date.now() - modalOpenedAt < 1500) {
          showSuccess();
          return;
        }

        const ratingValue = Number(ratingInput.value);
        const nameValue = nameInput.value.trim();
        const commentValue = commentInput.value.trim();

        if (!nameValue || commentValue.length < 10 || !(ratingValue >= 1 && ratingValue <= 5)) {
          alert('Please fill in your name, a valid rating and at least 10 characters of feedback.');
          return;
        }

        const payload = {
          hotel: form.getAttribute('data-hotel-title') || '',
          slug: form.getAttribute('data-hotel-slug') || '',
          name: nameValue,
          trip_type: tripTypeInput ? tripTypeInput.value : 'Business Stay',
          rating: ratingValue,
          comment: commentValue,
          approved: false, // Worker এ সবসময় নিশ্চিত false যাবে
          date: new Date().toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })
        };

        if (submitBtn) {
          submitBtn.disabled = true;
          submitBtn.textContent = 'Submitting...';
        }

        try {
          const res = await fetch('https://gatlin.rmollah394.workers.dev/api/submit-review', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
            signal
          });

          if (res.ok) {
            showSuccess();
          } else {
            alert('Failed to submit review. Please try again.');
          }
        } catch (err: any) {
          if (err.name !== 'AbortError') {
            alert('Network error. Please check your connection.');
          }
        } finally {
          if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.textContent = 'Submit Review For Approval';
          }
        }
      }, { signal });
    }
  }

  document.addEventListener('DOMContentLoaded', setupReviews);
  document.addEventListener('astro:page-load', setupReviews);
</script>
