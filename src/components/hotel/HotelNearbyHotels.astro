---
// src/components/hotel/HotelNearbyHotels.astro
// Zone-First Related Hotels + No Empty Review Text + Real Live Agoda Rates
import { getCollection } from 'astro:content';

interface Props {
  currentHotel: any;
}

const { currentHotel } = Astro.props;
const currentData = currentHotel?.data || {};

// ---------- Helpers ----------
const normalizeSlug = (value: any): string =>
  String(value || '')
    .replace(/\.(md|mdx)$/, '')
    .split('/')
    .pop()
    ?.trim()
    .toLowerCase() || '';

const norm = (v: any): string => String(v || '').trim().toLowerCase();

// স্মার্ট জোন শনাক্তকরণ (Gulshan-1 / Gulshan 1 / Gulshan 2, Dhaka সব সাপোর্ট করবে)
const extractZone = (data: any): string => {
  const text = `${data?.zone || ''} ${data?.area || ''} ${data?.locality || ''} ${data?.location || ''}`
    .toLowerCase()
    .trim();
  if (/gulshan[\s-]*1\b/.test(text)) return 'gulshan-1';
  if (/gulshan[\s-]*2\b/.test(text)) return 'gulshan-2';
  return norm(data?.locality || data?.location);
};

const currentCleanSlug = normalizeSlug(currentData.slug || currentHotel?.slug || currentHotel?.id);
const currentCategory = norm(currentData.category);
const currentZone = extractZone(currentData);

const isProd = import.meta.env.PROD;
let allHotels: any[] = [];
let allReviewsList: any[] = [];

// 1. Hotel loader (production-e draft bad)
try {
  const cmsHotels = await getCollection('hotels', ({ data }) => {
    return isProd ? data?.draft !== true : true;
  });

  if (cmsHotels && cmsHotels.length > 0) {
    allHotels = cmsHotels.map((h: any) => ({
      id: h.id,
      slug: normalizeSlug(h.slug || h.id),
      data: h.data || {},
    }));
  }
} catch (e) {
  allHotels = [];
}

if (allHotels.length === 0) {
  try {
    const rawGlob = import.meta.glob(
      ['/src/content/hotels/*.{md,mdx}', '../../content/hotels/*.{md,mdx}'],
      { eager: true }
    );
    allHotels = Object.entries(rawGlob)
      .map(([filePath, item]: [string, any]) => ({
        id: normalizeSlug(filePath),
        slug: normalizeSlug(filePath),
        data: item.frontmatter || item.data || {},
      }))
      .filter((entry: any) => (isProd ? entry.data?.draft !== true : true));
  } catch (e) {
    allHotels = [];
  }
}

// 2. Review loader
try {
  const cmsReviews = await getCollection('reviews');
  allReviewsList = cmsReviews.map((r: any) => ({ id: r.id, ...(r.data || {}) }));
} catch (e) {
  try {
    const globReviews = import.meta.glob(
      ['/src/content/reviews/*.{md,mdx}', '../../content/reviews/*.{md,mdx}'],
      { eager: true }
    );
    allReviewsList = Object.entries(globReviews).map(([filePath, item]: [string, any]) => ({
      id: normalizeSlug(filePath),
      ...(item?.frontmatter || item?.data || {}),
    }));
  } catch (err) {
    allReviewsList = [];
  }
}

// 3. Related hotel selection: একই জোন প্রথম অগ্রাধিকার (+10), এরপর একই ক্যাটাগরি (+2)
const nearbyHotels = allHotels
  .map((h) => {
    const hSlug = normalizeSlug(h.data?.slug || h.slug || h.id);
    const hZone = extractZone(h.data);
    const sameZoneScore = currentZone && hZone === currentZone ? 10 : 0;
    const sameCategoryScore = currentCategory && norm(h.data?.category) === currentCategory ? 2 : 0;
    return { ...h, hSlug, score: sameZoneScore + sameCategoryScore };
  })
  .filter((h) => h.hSlug !== '' && h.hSlug !== currentCleanSlug)
  .sort((a, b) => b.score - a.score)
  .slice(0, 4);

// Cloudflare image optimizer
function getOptimizedThumbnail(url: any): string {
  if (!url || typeof url !== 'string') return '/images/hotel-placeholder.webp';
  const cleanUrl = url.trim();
  if (!cleanUrl) return '/images/hotel-placeholder.webp';
  if (cleanUrl.startsWith('https://media.gulshanhotels.com/')) {
    const path = cleanUrl.replace('https://media.gulshanhotels.com/', '');
    return `https://media.gulshanhotels.com/cdn-cgi/image/width=600,quality=75,format=auto,onerror=redirect/${path}`;
  }
  if (cleanUrl.includes('unsplash.com')) {
    const base = cleanUrl.split('?')[0];
    return `${base}?auto=format&fit=crop&w=600&q=75&fm=webp`;
  }
  return cleanUrl;
}

// Price formatter
function formatPrice(data: any): string {
  const raw = data.price || data.starting_price;
  if (!raw) return 'Check rates';
  const s = String(raw).trim();
  if (!s || /check|contact|inquire/i.test(s)) return 'Check rates';
  if (/^[^\d\s]/.test(s)) return s;
  const currency = String(data.currency || data.currency_symbol || '$').trim();
  return `${currency}${s}`;
}
---

{nearbyHotels.length > 0 && (
  <section
    id="nearby-hotels"
    class="bg-white py-12 px-4 sm:px-6 lg:px-0 max-w-7xl mx-auto text-slate-800 border-b border-slate-200 scroll-mt-14 sm:scroll-mt-16"
  >
    <div class="space-y-6">

      <!-- Section Header -->
      <div class="border-b border-slate-200 pb-4 text-left flex flex-col sm:flex-row sm:items-end justify-between gap-2">
        <div>
          <span class="text-[10px] sm:text-xs font-black uppercase tracking-widest text-emerald-800 block">
            Travellers also viewed
          </span>
          <h2 class="text-xl sm:text-3xl font-black font-sans text-[#002b11] tracking-tight">
            More Hotels in Gulshan
          </h2>
        </div>
        <p class="text-xs sm:text-sm text-slate-500 font-medium">Compare more stays before you book</p>
      </div>

      <!-- 4-HOTEL GRID -->
      <div id="nearbyHotelsGrid" class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-6 text-left">
        {nearbyHotels.map((h) => {
          const hData = h.data || {};
          const hTitle = String(hData.title || hData.name || 'Hotel').trim();
          const hCategory = hData.category || '';
          const hLocation = String(hData.locality || hData.location || '').trim();
          const hPrice = formatPrice(hData);
          const hSlug = h.hSlug;
          const agodaId = String(hData.agoda_id || hData.agodaId || hData.agoda_hotel_id || '').trim();

          const firstGallery = Array.isArray(hData.gallery) ? hData.gallery[0] : null;
          const rawImg =
            hData.image ||
            (firstGallery
              ? typeof firstGallery === 'object'
                ? firstGallery.photo || firstGallery.image
                : firstGallery
              : '');
          const hImage = getOptimizedThumbnail(rawImg);

          // Genuine review calculation
          const targetTitle = norm(hTitle);

          const matchingReviews = allReviewsList.filter((rev: any) => {
            if (!rev) return false;
            const isApproved = rev.approved === true || norm(rev.approved) === 'true';
            if (!isApproved) return false;

            const rSlug = normalizeSlug(rev.slug || rev.hotelSlug || rev.hotel_slug);
            const rHotel = norm(rev.hotel || rev.hotelTitle || rev.hotel_name);

            return (
              (hSlug !== '' && (rSlug === hSlug || normalizeSlug(rev.hotel) === hSlug)) ||
              (targetTitle !== '' && rHotel === targetTitle)
            );
          });

          const embeddedRevs = Array.isArray(hData.reviews) ? hData.reviews : [];

          const seen = new Set<string>();
          const totalRealReviews = [...matchingReviews, ...embeddedRevs]
            .filter((r: any) => r && Number(r.rating) >= 1 && Number(r.rating) <= 5)
            .filter((r: any) => {
              if (!r.id) return true;
              const key = String(r.id);
              if (seen.has(key)) return false;
              seen.add(key);
              return true;
            });

          const realCount = totalRealReviews.length;
          const realRatingNumber =
            realCount > 0
              ? totalRealReviews.reduce((sum: number, r: any) => sum + Number(r.rating), 0) / realCount
              : hData.rating
                ? Number(hData.rating)
                : null;

          const realRatingDisplay = realRatingNumber ? realRatingNumber.toFixed(1) : null;
          const finalCountDisplay = realCount > 0 ? realCount : Number(hData.reviews_count || 0);

          return (
            <div
              class="nearby-hotel-card bg-white rounded-2xl sm:rounded-3xl border border-slate-200 overflow-hidden shadow-2xs hover:shadow-xl hover:border-emerald-600/40 transition-all duration-300 flex flex-col justify-between group"
              data-slug={hSlug}
              data-hotel-name={hTitle}
              data-agoda-id={agodaId}
            >
              <div>

                <!-- CARD PHOTO -->
                <div class="h-32 sm:h-48 w-full overflow-hidden relative bg-slate-900">
                  <img
                    src={hImage}
                    alt={hLocation ? `${hTitle} in ${hLocation}` : hTitle}
                    width="600"
                    height="400"
                    loading="lazy"
                    decoding="async"
                    class="w-full h-full object-cover group-hover:scale-105 transition duration-500"
                  />

                  {hData.badge && (
                    <div class="absolute top-2 left-2 flex flex-col gap-1">
                      <span class="bg-[#0d3b23] text-white text-[10px] font-black uppercase tracking-wider px-2 py-0.5 rounded-md shadow-md inline-block">
                        {hData.badge}
                      </span>
                    </div>
                  )}

                  {hCategory && (
                    <span class="hidden sm:inline-block absolute bottom-2 right-2 bg-slate-950/80 backdrop-blur-md text-white text-[10px] font-extrabold uppercase px-2 py-0.5 rounded-full border border-white/20">
                      {hCategory}
                    </span>
                  )}
                </div>

                <!-- CARD DETAILS -->
                <div class="p-3 sm:p-5 space-y-1.5 sm:space-y-2.5">

                  {/* রিভিউ থাকলেই শুধু দেখাবে; না থাকলে কিছুই দেখাবে না */}
                  {realRatingNumber && (
                    <div class="flex items-center gap-1.5">
                      <div
                        class="flex items-center gap-0.5"
                        role="img"
                        aria-label={`Rated ${realRatingDisplay} out of 5`}
                      >
                        {[1, 2, 3, 4, 5].map((s) => (
                          <span
                            class={`w-2.5 h-2.5 sm:w-3 sm:h-3 rounded-full inline-block ${
                              s <= Math.round(realRatingNumber)
                                ? 'bg-emerald-600'
                                : 'bg-emerald-600/25 border border-emerald-600/40'
                            }`}
                          ></span>
                        ))}
                      </div>
                      <span class="text-[11px] sm:text-xs font-black text-slate-800">{realRatingDisplay}</span>
                      {finalCountDisplay > 0 && (
                        <span class="text-[10px] font-bold text-slate-500">({finalCountDisplay})</span>
                      )}
                    </div>
                  )}

                  <h3 class="font-black text-slate-900 text-xs sm:text-base group-hover:text-emerald-800 transition line-clamp-1 leading-snug">
                    <a href={`/${hSlug}/`} class="hover:underline">{hTitle}</a>
                  </h3>

                  {hLocation && (
                    <p class="text-[11px] sm:text-xs text-slate-500 flex items-center gap-1 font-medium truncate">
                      <svg aria-hidden="true" class="w-3 h-3 text-emerald-600 shrink-0" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
                      </svg>
                      <span class="truncate">{hLocation}</span>
                    </p>
                  )}

                  {/* RATE & LIVE AGODA INDICATOR */}
                  <div class="pt-2 border-t border-slate-100 space-y-1">
                    <div class="nearby-live-badge hidden items-center gap-1.5 leading-none">
                      <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 shrink-0" aria-hidden="true"></span>
                      <span class="text-[9px] sm:text-[10px] font-extrabold uppercase tracking-wider text-emerald-700">
                        Live Rate (Agoda)
                      </span>
                    </div>

                    <div class="flex items-baseline justify-between gap-1">
                      <div class="flex items-baseline gap-1 min-w-0">
                        <span class="nearby-live-price text-sm sm:text-lg font-black text-emerald-900 leading-tight tabular-nums transition-opacity duration-300">
                          {hPrice}
                        </span>
                        <span class="nearby-per-night text-[10px] sm:text-xs text-slate-500 font-medium">
                          {hPrice !== 'Check rates' ? ' / night' : ''}
                        </span>
                      </div>

                      <div class="flex items-center gap-1 shrink-0">
                        <span class="nearby-orig-price hidden text-[10px] sm:text-[11px] text-slate-400 line-through font-semibold tabular-nums"></span>
                        <span class="nearby-discount-badge hidden text-[9px] font-black uppercase text-rose-700 bg-rose-50 border border-rose-200 px-1.5 py-0.5 rounded-full"></span>
                      </div>
                    </div>
                  </div>

                </div>
              </div>

              <!-- VIEW DETAILS CTA -->
              <div class="p-3 sm:p-5 pt-0">
                <a
                  href={`/${hSlug}/`}
                  aria-label={`View details of ${hTitle}`}
                  class="block w-full bg-slate-50 hover:bg-[#0d3b23] border border-slate-200 hover:border-transparent text-slate-800 hover:text-white font-black text-[11px] sm:text-xs text-center py-2 sm:py-2.5 rounded-xl transition duration-200 shadow-2xs hover:shadow-md"
                >
                  View Details <span aria-hidden="true">➔</span>
                </a>
              </div>

            </div>
          );
        })}
      </div>

    </div>
  </section>
)}

<!-- LIVE AGODA RATE CLIENT SCRIPT -->
<script is:inline>
  (() => {
    let nearbyAbortController = null;
    const WORKER_ENDPOINT = "https://gulshanhotels.rmollah394.workers.dev";
    const CACHE_PREFIX = "gh_pop_rate_";
    const CACHE_TTL_MS = 10 * 60 * 1000;

    const getDhakaDates = () => {
      const now = new Date();
      const utcMillis = now.getTime() + (now.getTimezoneOffset() * 60000);
      const dhaka = new Date(utcMillis + (6 * 3600000));
      const pad = (n) => String(n).padStart(2, '0');

      const d1 = `${dhaka.getFullYear()}-${pad(dhaka.getMonth() + 1)}-${pad(dhaka.getDate())}`;
      dhaka.setDate(dhaka.getDate() + 1);
      const d2 = `${dhaka.getFullYear()}-${pad(dhaka.getMonth() + 1)}-${pad(dhaka.getDate())}`;
      return { checkIn: d1, checkOut: d2 };
    };

    const initNearbyHotelsRates = () => {
      if (nearbyAbortController) nearbyAbortController.abort();
      nearbyAbortController = new AbortController();
      const { signal } = nearbyAbortController;

      const section = document.getElementById('nearby-hotels');
      const grid = document.getElementById('nearbyHotelsGrid');
      if (!grid) return;

      const cards = grid.querySelectorAll('.nearby-hotel-card');
      if (cards.length === 0) return;

      const applyCardRate = (card, ratesData) => {
        const priceEl = card.querySelector('.nearby-live-price');
        const origPriceEl = card.querySelector('.nearby-orig-price');
        const discountEl = card.querySelector('.nearby-discount-badge');
        const perNightEl = card.querySelector('.nearby-per-night');
        const liveBadgeEl = card.querySelector('.nearby-live-badge');

        if (!priceEl || !ratesData?.startingPrice) return;

        priceEl.style.opacity = '0.3';
        setTimeout(() => {
          priceEl.textContent = ratesData.startingPrice;
          priceEl.style.opacity = '1';

          if (perNightEl) perNightEl.textContent = ' / night';
          if (liveBadgeEl) {
            liveBadgeEl.classList.remove('hidden');
            liveBadgeEl.classList.add('flex');
          }

          if (ratesData.originalPrice && origPriceEl) {
            origPriceEl.textContent = ratesData.originalPrice;
            origPriceEl.classList.remove('hidden');
          }

          if (ratesData.discountText && discountEl) {
            discountEl.textContent = ratesData.discountText;
            discountEl.classList.remove('hidden');
          }
        }, 120);
      };

      const syncHotelLiveRate = async (card) => {
        const slug = (card.getAttribute('data-slug') || '').trim();
        const hotelName = (card.getAttribute('data-hotel-name') || '').trim();
        const agodaId = (card.getAttribute('data-agoda-id') || '').trim();

        if (!agodaId && !slug && !hotelName) return;

        const cacheKey = CACHE_PREFIX + (agodaId || slug || hotelName);

        try {
          const cached = sessionStorage.getItem(cacheKey);
          if (cached) {
            const parsed = JSON.parse(cached);
            if (Date.now() - parsed.timestamp < CACHE_TTL_MS && parsed.rates) {
              applyCardRate(card, parsed.rates);
              return;
            }
          }
        } catch (_) {}

        const { checkIn, checkOut } = getDhakaDates();
        const queryParams = new URLSearchParams();
        if (agodaId) {
          queryParams.set('id', agodaId);
          queryParams.set('hotelId', agodaId);
        } else {
          queryParams.set('hotel', slug || hotelName);
        }
        queryParams.set('checkIn', checkIn);
        queryParams.set('checkInDate', checkIn);
        queryParams.set('checkOut', checkOut);
        queryParams.set('checkOutDate', checkOut);
        queryParams.set('adults', '2');
        queryParams.set('numberOfAdult', '2');
        queryParams.set('rooms', '1');
        queryParams.set('currency', 'USD');

        const requestUrl = `${WORKER_ENDPOINT}?${queryParams.toString()}`;

        try {
          const res = await fetch(requestUrl, { signal });
          if (!res.ok) return;

          const json = await res.json();
          let normalizedRates = null;

          if (json?.results && Array.isArray(json.results) && json.results.length > 0) {
            const item = json.results[0];
            const curSym = item.currency === 'USD' ? '$' : (item.currency === 'BDT' ? '৳' : (item.currency || '$'));
            const rateVal = item.dailyRate ? Math.round(Number(item.dailyRate)) : null;
            const origVal = item.crossedOutRate ? Math.round(Number(item.crossedOutRate)) : null;
            const discPct = item.discountPercentage && Number(item.discountPercentage) > 0 ? `${Math.round(item.discountPercentage)}% OFF` : '';

            normalizedRates = {
              startingPrice: rateVal ? `${curSym}${rateVal}` : '',
              originalPrice: origVal && origVal > (rateVal || 0) ? `${curSym}${origVal}` : '',
              discountText: discPct
            };
          } else if (json?.rates) {
            normalizedRates = json.rates;
          } else if (json?.dailyRate || json?.startingPrice) {
            normalizedRates = {
              startingPrice: json.startingPrice || `$${Math.round(Number(json.dailyRate))}`,
              originalPrice: json.originalPrice || (json.crossedOutRate ? `$${Math.round(Number(json.crossedOutRate))}` : ''),
              discountText: json.discountText || (json.discountPercentage ? `${json.discountPercentage}% OFF` : '')
            };
          }

          if (normalizedRates && normalizedRates.startingPrice) {
            applyCardRate(card, normalizedRates);
            try {
              sessionStorage.setItem(cacheKey, JSON.stringify({
                timestamp: Date.now(),
                rates: normalizedRates
              }));
            } catch (_) {}
          }
        } catch (err) {}
      };

      let isSynced = false;
      const triggerSync = () => {
        if (isSynced) return;
        isSynced = true;
        cards.forEach((card, index) => {
          setTimeout(() => {
            syncHotelLiveRate(card);
          }, index * 80);
        });
      };

      if ('IntersectionObserver' in window && section) {
        const observer = new IntersectionObserver((entries) => {
          if (entries[0].isIntersecting) {
            observer.disconnect();
            triggerSync();
          }
        }, { rootMargin: '300px 0px' });
        observer.observe(section);
      } else {
        setTimeout(triggerSync, 1000);
      }
    };

    document.addEventListener('DOMContentLoaded', initNearbyHotelsRates);
    document.addEventListener('astro:page-load', initNearbyHotelsRates);
  })();
</script>
