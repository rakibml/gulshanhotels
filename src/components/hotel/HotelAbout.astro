---
// src/components/hotel/HotelAbout.astro (Standalone Hotel About Component)
import { render } from 'astro:content';

interface Props {
  hotel: any;
}

const { hotel } = Astro.props;
const data = hotel?.data || {};

const hotelTitle = String(data.title || data.name || "").trim();
const hotelCategory = String(data.category || "").trim();
const hotelLocation = String(data.location || "").trim();

// মার্কডাউন রেন্ডারিং
let Content: any = null;
if (hotel && typeof hotel === 'object') {
  try {
    const rendered = await render(hotel);
    Content = rendered?.Content || null;
  } catch {
    Content = null;
  }
}

const fallbackDescription = String(data.description || hotel?.body || "").trim();
const hasDescription = Boolean(Content || fallbackDescription);
---

<div class="space-y-4 text-left">
  <div class="space-y-2">
    {hotelCategory && (
      <span class="inline-flex items-center px-3 py-1 rounded-full bg-emerald-50 border border-emerald-200 text-[10px] sm:text-xs font-black uppercase tracking-wider text-emerald-800">
        {hotelCategory}
      </span>
    )}

    <h2 class="font-sans text-2xl sm:text-3xl lg:text-[32px] font-black text-[#002b11] tracking-tight leading-tight">
      About {hotelTitle}
    </h2>

    {hotelLocation && (
      <p class="text-xs sm:text-sm text-slate-600 font-medium flex items-center gap-1.5">
        <svg aria-hidden="true" class="w-4 h-4 text-emerald-800 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
          <circle cx="12" cy="11" r="3"/>
        </svg>
        <span>{hotelLocation}</span>
      </p>
    )}
  </div>

  {hasDescription && (
    <div class="border-t border-slate-100 pt-3 space-y-2">
      <div id="overview-wrapper" class="relative">
        <div
          id="overview-text"
          class="max-h-[190px] overflow-hidden prose prose-slate max-w-none text-xs sm:text-sm md:text-base leading-relaxed text-slate-700 font-normal [&_a]:text-emerald-800 [&_a]:font-bold [&_a]:underline hover:[&_a]:text-emerald-600 transition-all duration-300"
        >
          {Content ? <Content /> : <p class="whitespace-pre-line">{fallbackDescription}</p>}
        </div>
      </div>

      <button
        type="button"
        id="toggleOverviewBtn"
        aria-expanded="false"
        aria-controls="overview-text"
        class="hidden text-xs sm:text-sm font-bold text-emerald-800 hover:text-emerald-950 transition items-center gap-1 cursor-pointer select-none pt-1"
      >
        <span id="readMoreText">Read more</span>
        <svg aria-hidden="true" id="readMoreIcon" class="w-3.5 h-3.5 shrink-0 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
        </svg>
      </button>
    </div>
  )}
</div>

<script>
  function applyLinkAttributes() {
    document.querySelectorAll('#overview-text a').forEach((link) => {
      const href = link.getAttribute('href');
      if (href && (href.startsWith('http') || href.startsWith('//'))) {
        link.setAttribute('target', '_blank');
        link.setAttribute('rel', 'noopener noreferrer');
      }
    });
  }

  const FADE_CLASSES = ['after:absolute', 'after:bottom-0', 'after:inset-x-0', 'after:h-14', 'after:bg-gradient-to-t', 'after:from-white', 'after:to-transparent', 'after:pointer-events-none'];

  function setupOverviewTruncator() {
    const textEl = document.getElementById('overview-text');
    const wrapperEl = document.getElementById('overview-wrapper');
    const toggleBtn = document.getElementById('toggleOverviewBtn');
    const toggleBtnText = document.getElementById('readMoreText');
    const toggleBtnIcon = document.getElementById('readMoreIcon');

    if (!textEl || !toggleBtn || !wrapperEl) return;
    if (toggleBtn.dataset.bound === 'true') return;
    toggleBtn.dataset.bound = 'true';

    if (textEl.scrollHeight > 210) {
      wrapperEl.classList.add(...FADE_CLASSES);
      toggleBtn.classList.remove('hidden');
      toggleBtn.classList.add('inline-flex');

      toggleBtn.addEventListener('click', () => {
        const isExpanded = textEl.dataset.expanded === 'true';

        if (!isExpanded) {
          textEl.classList.remove('max-h-[190px]', 'overflow-hidden');
          wrapperEl.classList.remove(...FADE_CLASSES);
          if (toggleBtnText) toggleBtnText.textContent = 'Show less';
          if (toggleBtnIcon) toggleBtnIcon.classList.add('rotate-180');
          textEl.dataset.expanded = 'true';
          toggleBtn.setAttribute('aria-expanded', 'true');
        } else {
          textEl.classList.add('max-h-[190px]', 'overflow-hidden');
          wrapperEl.classList.add(...FADE_CLASSES);
          if (toggleBtnText) toggleBtnText.textContent = 'Read more';
          if (toggleBtnIcon) toggleBtnIcon.classList.remove('rotate-180');
          textEl.dataset.expanded = 'false';
          toggleBtn.setAttribute('aria-expanded', 'false');
          wrapperEl.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }
      });
    } else {
      textEl.classList.remove('max-h-[190px]', 'overflow-hidden');
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    applyLinkAttributes();
    setupOverviewTruncator();
  });
  document.addEventListener('astro:page-load', () => {
    applyLinkAttributes();
    setupOverviewTruncator();
  });
</script>
