---
// src/components/hotel/HotelRates.astro — TripAdvisor-style "Deals" card
interface Props {
  hotel: any;
}

const { hotel } = Astro.props;
const data = hotel?.data || {};

const hotelTitle = String(data.title || data.name || "").trim();
const rawSlug = String(data.slug || hotel?.slug || hotel?.id || "").trim();
const hotelSlug = rawSlug.replace(/\.(md|mdx)$/, '').split('/').pop()?.toLowerCase() || "";
const agodaId = String(data.agoda_id || data.agodaId || "").trim();

const whatsapp = String(data.whatsapp || "");
const phone = String(data.phone || "");

// 01XXXXXXXXX / 1XXXXXXXXX / 8801XXXXXXXXX / +8801XXXXXXXXX -> 8801XXXXXXXXX
function normalizeBdWhatsapp(raw: string): string {
  const d = String(raw || '').replace(/[^0-9]/g, '');
  if (!d) return '';
  if (d.startsWith('880')) return d;
  if (d.startsWith('0')) return '88' + d;
  if (d.length === 10 && d.startsWith('1')) return '880' + d;
  return d;
}

const cleanWhatsapp = normalizeBdWhatsapp(whatsapp);
const cleanPhone = phone.replace(/[^0-9+]/g, '');
const hasContact = Boolean(cleanPhone || cleanWhatsapp);
const waMessage = 'Hi! I want to book a room at ' + hotelTitle;

const customChannels: any[] = Array.isArray(data.booking_channels) ? data.booking_channels : [];

function detectCurrency(v: any): string | null {
  const s = String(v || "");
  if (s.includes('$')) return '$';
  if (s.includes('৳')) return '৳';
  return null;
}

const rawBasePrice = String(data.price || "").trim();
const mainCurrency =
  detectCurrency(rawBasePrice) ||
  customChannels.map((c) => detectCurrency(c?.price)).find(Boolean) ||
  '$';
const apiCurrency = mainCurrency === '৳' ? 'BDT' : 'USD';

function formatPrice(p: any): string {
  const s = String(p || "").trim();
  if (!s) return "";
  return detectCurrency(s) ? s : mainCurrency + s;
}

function extractNumericPrice(val: any): number | null {
  if (!val) return null;
  const str = String(val).replace(/,/g, '').trim();
  const match = str.match(/(\d+(?:\.\d+)?)/);
  return match ? parseFloat(match[1]) : null;
}

function safeUrl(u: string) {
  const v = String(u || "").trim();
  return /^(https?:|tel:|mailto:)/i.test(v) ? v : "#";
}

function sanitizeLink(rawUrl: any = "", preset: string = "", pName: string = "", hName: string = "") {
  const url = String(rawUrl || "").trim();
  if (!url || url === "#") return "#";
  const lowerName = String(pName).toLowerCase();
  const isPhone = preset === 'phone' || lowerName.includes('call');
  const isWhatsapp = preset === 'whatsapp' || lowerName.includes('whatsapp');

  if (isPhone && !/^(https?:|tel:)/i.test(url)) {
    const p = url.replace(/[^0-9+]/g, '');
    return p ? `tel:${p}` : "#";
  }
  if (isWhatsapp && !/^https?:/i.test(url)) {
    const digits = normalizeBdWhatsapp(url);
    if (!digits) return "#";
    return `https://wa.me/${digits}?text=${encodeURIComponent('Hi! I want to book a room at ' + hName)}`;
  }
  if (!/^(https?:|tel:|mailto:)/i.test(url)) return safeUrl(`https://${url}`);
  return safeUrl(url);
}

// ---------- Deal rows ----------
type Row = {
  name: string;
  kind: string; // booking | trip | agoda | tripadvisor | other
  logoUrl: string;
  note: string;
  priceNum: number | null;
  priceText: string;
  url: string;
  buttonText: string;
  isAgoda: boolean;
  pending: boolean; // লিংক না থাকলে live data আসা পর্যন্ত row লুকানো
  order: number;
  best: boolean;
};

function detectKind(preset: string, name: string, url: string): string {
  const s = `${preset} ${name} ${url}`.toLowerCase();
  if (s.includes('agoda')) return 'agoda';
  if (s.includes('trip.com')) return 'trip';
  if (s.includes('tripadvisor')) return 'tripadvisor';
  if (s.includes('booking')) return 'booking';
  return 'other';
}

const baseRows: Row[] = customChannels
  .map((item: any) => {
    const name = String(item?.provider_name || "Booking Partner");
    const preset = String(item?.icon_preset || "direct");
    const url = sanitizeLink(item?.button_url, preset, name, hotelTitle);
    const showPrice = item?.show_price !== false && item?.showPrice !== false;
    const priceNum = showPrice ? extractNumericPrice(item?.price) : null;
    const kind = detectKind(preset, name, url);
    return {
      name,
      kind,
      logoUrl: /^https?:/i.test(String(item?.logo_url || "")) ? String(item.logo_url) : "",
      note: String(item?.note || "").trim(),
      priceNum: priceNum && priceNum > 0 ? priceNum : null,
      priceText: showPrice ? formatPrice(item?.price) : "",
      url,
      buttonText: String(item?.button_text || "View deal"),
      isAgoda: kind === 'agoda',
      pending: false,
      order: 0,
      best: false,
    } as Row;
  })
  .filter((r) => r.url !== "#");

// Agoda row সবসময় থাকবে (live price এখানে বসবে)
const agodaFallbackUrl = safeUrl(
  String(data.agoda_url || "").trim() ||
  baseRows.find((r) => r.isAgoda)?.url ||
  (agodaId ? `https://www.agoda.com/partners/partnersearch.aspx?hid=${encodeURIComponent(agodaId)}` : "")
);

// worker slug দিয়েও live price আনতে পারে, তাই agoda_id/agoda_url না থাকলেও row থাকবে
if (!baseRows.some((r) => r.isAgoda) && (agodaFallbackUrl !== "#" || agodaId || hotelSlug)) {
  baseRows.push({
    name: "Agoda",
    kind: "agoda",
    logoUrl: "",
    note: "",
    priceNum: null,
    priceText: "",
    url: agodaFallbackUrl,
    buttonText: "View deal",
    isAgoda: true,
    pending: agodaFallbackUrl === "#",
    order: 0,
    best: false,
  });
}

// দাম অনুযায়ী sort (দাম নেই = শেষে), সবচেয়ে কম দাম = best
const rows: Row[] = baseRows
  .map((r, i) => ({ r, i }))
  .sort((a, b) => {
    const ap = a.r.priceNum ?? Infinity;
    const bp = b.r.priceNum ?? Infinity;
    return ap === bp ? a.i - b.i : ap - bp;
  })
  .map(({ r }, idx) => {
    r.order = idx;
    r.best = idx === 0 && r.priceNum !== null;
    return r;
  });
---

<div
  id="rates-card"
  data-hotel-title={hotelTitle}
  data-hotel-slug={hotelSlug}
  data-agoda-id={agodaId}
  data-agoda-fallback={agodaFallbackUrl}
  data-currency={apiCurrency}
  class="bg-white rounded-2xl border border-slate-200 shadow-sm p-5 sm:p-6 text-left"
>
  <h3 class="text-lg font-extrabold text-[#0d3b23] mb-4">Deals</h3>

  <!-- ===== Controls: Check In | Check Out | Rooms/Guests ===== -->
  <div class="relative">
    <div class="grid gap-2 sm:grid-cols-[1.7fr_1fr]">

      <div class="grid grid-cols-2 rounded-xl border border-[#0d3b23]/60 overflow-hidden bg-white">
        <button
          type="button"
          id="checkInBtn"
          aria-haspopup="dialog"
          aria-expanded="false"
          aria-controls="calendarDropdown"
          class="hr-field flex items-center gap-2.5 px-3 py-2 text-left transition-colors hover:bg-slate-50 border-r border-[#0d3b23]/30 min-w-0"
        >
          <svg aria-hidden="true" class="w-4 h-4 text-[#0d3b23] shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
          </svg>
          <span class="min-w-0">
            <span class="block text-[10px] leading-tight text-slate-500">Check In</span>
            <span id="checkInText" class="block text-xs sm:text-[13px] font-bold text-[#0d3b23] truncate">Select date</span>
          </span>
        </button>

        <button
          type="button"
          id="checkOutBtn"
          aria-haspopup="dialog"
          aria-expanded="false"
          aria-controls="calendarDropdown"
          class="hr-field flex items-center gap-2.5 px-3 py-2 text-left transition-colors hover:bg-slate-50 min-w-0"
        >
          <svg aria-hidden="true" class="w-4 h-4 text-[#0d3b23] shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
          </svg>
          <span class="min-w-0">
            <span class="block text-[10px] leading-tight text-slate-500">Check Out</span>
            <span id="checkOutText" class="block text-xs sm:text-[13px] font-bold text-[#0d3b23] truncate">Select date</span>
          </span>
        </button>
      </div>

      <button
        type="button"
        id="guestsBtn"
        aria-haspopup="dialog"
        aria-expanded="false"
        aria-controls="guestsDropdown"
        class="hr-field flex items-center gap-2.5 px-3 py-2 text-left rounded-xl border border-[#0d3b23]/60 bg-white transition-colors hover:bg-slate-50 min-w-0"
      >
        <svg aria-hidden="true" class="w-4 h-4 text-[#0d3b23] shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
        </svg>
        <span class="min-w-0">
          <span class="block text-[10px] leading-tight text-slate-500">Rooms/Guests</span>
          <span id="guestsSummaryText" class="block text-xs sm:text-[13px] font-bold text-[#0d3b23] truncate">1 Room, 2 Guests</span>
        </span>
      </button>
    </div>

    <!-- Calendar popover -->
    <div
      id="calendarDropdown"
      role="dialog"
      aria-label="Choose dates"
      data-open="false"
      class="hr-pop absolute left-0 top-full mt-2 z-50 w-full sm:w-[22rem] bg-white border border-slate-200 rounded-2xl shadow-2xl p-4 space-y-3"
    >
      <div class="flex items-center justify-between">
        <button type="button" id="prevMonthBtn" class="p-1.5 hover:bg-slate-100 rounded-lg text-slate-600 transition disabled:opacity-30 disabled:pointer-events-none" aria-label="Previous month">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
        </button>
        <span id="calendarMonthYear" class="font-bold text-sm text-slate-800" aria-live="polite"></span>
        <button type="button" id="nextMonthBtn" class="p-1.5 hover:bg-slate-100 rounded-lg text-slate-600 transition" aria-label="Next month">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
        </button>
      </div>

      <div class="grid grid-cols-7 text-center text-[10px] font-bold text-slate-400">
        <span>Su</span><span>Mo</span><span>Tu</span><span>We</span><span>Th</span><span>Fr</span><span>Sa</span>
      </div>

      <div id="calendarDaysGrid" class="grid grid-cols-7 gap-y-1 text-center"></div>

      <div class="flex items-center justify-between pt-2 border-t border-slate-100 text-[11px]">
        <span id="calendarHint" class="text-slate-500">Select check-in date</span>
        <button type="button" id="closeCalBtn" class="text-[#0d3b23] font-bold hover:underline">Close</button>
      </div>
    </div>

    <!-- Guests popover -->
    <div
      id="guestsDropdown"
      role="dialog"
      aria-label="Choose guests and rooms"
      data-open="false"
      class="hr-pop absolute right-0 top-full mt-2 z-50 w-full sm:w-72 bg-white border border-slate-200 rounded-2xl shadow-2xl p-4 space-y-3 text-xs"
    >
      <div class="flex items-center justify-between">
        <div>
          <span class="font-bold text-slate-800 block leading-tight">Adults</span>
          <span class="text-[10px] text-slate-400">Ages 18+</span>
        </div>
        <div class="flex items-center gap-2.5">
          <button type="button" id="adultMinus" aria-label="Decrease adults" class="w-8 h-8 rounded-full border border-slate-200 hover:border-[#0d3b23] flex items-center justify-center font-black text-slate-600 transition disabled:opacity-30 disabled:pointer-events-none">−</button>
          <span id="adultCount" class="font-bold w-4 text-center">2</span>
          <button type="button" id="adultPlus" aria-label="Increase adults" class="w-8 h-8 rounded-full border border-slate-200 hover:border-[#0d3b23] flex items-center justify-center font-black text-slate-600 transition disabled:opacity-30 disabled:pointer-events-none">+</button>
        </div>
      </div>

      <div class="flex items-center justify-between border-t border-slate-100 pt-3">
        <div>
          <span class="font-bold text-slate-800 block leading-tight">Children</span>
          <span class="text-[10px] text-slate-400">Ages 0–17</span>
        </div>
        <div class="flex items-center gap-2.5">
          <button type="button" id="childMinus" aria-label="Decrease children" class="w-8 h-8 rounded-full border border-slate-200 hover:border-[#0d3b23] flex items-center justify-center font-black text-slate-600 transition disabled:opacity-30 disabled:pointer-events-none">−</button>
          <span id="childCount" class="font-bold w-4 text-center">0</span>
          <button type="button" id="childPlus" aria-label="Increase children" class="w-8 h-8 rounded-full border border-slate-200 hover:border-[#0d3b23] flex items-center justify-center font-black text-slate-600 transition disabled:opacity-30 disabled:pointer-events-none">+</button>
        </div>
      </div>

      <div class="flex items-center justify-between border-t border-slate-100 pt-3">
        <div>
          <span class="font-bold text-slate-800 block leading-tight">Rooms</span>
          <span class="text-[10px] text-slate-400">Total room count</span>
        </div>
        <div class="flex items-center gap-2.5">
          <button type="button" id="roomMinus" aria-label="Decrease rooms" class="w-8 h-8 rounded-full border border-slate-200 hover:border-[#0d3b23] flex items-center justify-center font-black text-slate-600 transition disabled:opacity-30 disabled:pointer-events-none">−</button>
          <span id="roomCount" class="font-bold w-4 text-center">1</span>
          <button type="button" id="roomPlus" aria-label="Increase rooms" class="w-8 h-8 rounded-full border border-slate-200 hover:border-[#0d3b23] flex items-center justify-center font-black text-slate-600 transition disabled:opacity-30 disabled:pointer-events-none">+</button>
        </div>
      </div>

      <button type="button" id="closeGuestsBtn" class="w-full bg-[#0d3b23] text-white font-bold py-2 rounded-lg text-xs hover:bg-[#124e30] transition">
        Apply
      </button>
    </div>
  </div>

  <div class="flex justify-end mt-4 mb-2">
    <span class="text-xs font-bold text-[#0d3b23]">Nightly price</span>
  </div>

  <!-- ===== Deals list ===== -->
  <ul id="dealsList" class="flex flex-col gap-2.5 list-none p-0 m-0">
    {rows.map((r) => {
      const isExternal = r.url.startsWith('http');
      return (
        <li
          class="hr-row flex items-center gap-3 rounded-xl border border-slate-200 bg-white px-4 py-3.5 sm:px-5 sm:py-4"
          style={`order:${r.order}`}
          data-best={String(r.best)}
          data-price={r.priceNum ?? ''}
          data-price-text={r.priceText}
          data-agoda-row={r.isAgoda ? 'true' : undefined}
          data-pending={r.pending ? 'true' : undefined}
          data-loading="false"
          data-live="false"
        >
          <!-- Logo -->
          <div class="w-24 sm:w-32 shrink-0 min-w-0">
            {r.logoUrl ? (
              <img src={r.logoUrl} alt={r.name} loading="lazy" class="max-h-7 w-auto object-contain" />
            ) : r.kind === 'booking' ? (
              <span class="text-[#003580] font-extrabold tracking-tight text-base sm:text-lg" aria-label={r.name}>Booking<span class="text-[#0a6fd6]">.com</span></span>
            ) : r.kind === 'trip' ? (
              <span class="text-[#287dfa] font-extrabold tracking-tight text-base sm:text-lg" aria-label={r.name}>Trip<span class="text-[#ff8a00]">.</span>com</span>
            ) : r.kind === 'agoda' ? (
              <span class="flex flex-col items-start leading-none" aria-label={r.name}>
                <span class="text-slate-600 font-semibold text-lg tracking-tight">agoda</span>
                <span class="flex gap-0.5 mt-1" aria-hidden="true">
                  <i class="w-2 h-2 rounded-full bg-[#e8384f]"></i><i class="w-2 h-2 rounded-full bg-[#ffb400]"></i><i class="w-2 h-2 rounded-full bg-[#2fb84f]"></i><i class="w-2 h-2 rounded-full bg-[#a23b9c]"></i><i class="w-2 h-2 rounded-full bg-[#1da1e0]"></i>
                </span>
              </span>
            ) : (
              <span class="font-extrabold text-slate-800 text-sm sm:text-base truncate block">{r.name}</span>
            )}
          </div>

          <!-- Note (refundable etc.) -->
          <div class="hidden sm:flex flex-1 items-center gap-1.5 text-xs text-slate-600 min-w-0">
            {r.note ? (
              <>
                <svg aria-hidden="true" class="w-3.5 h-3.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                <span data-note class="truncate">{r.note}</span>
              </>
            ) : (
              <span data-note class="truncate"></span>
            )}
          </div>
          <div class="flex-1 sm:hidden"></div>

          <!-- Price -->
          <div class="text-right shrink-0">
            {r.isAgoda && (
              <div class="flex items-center justify-end gap-1.5 leading-none">
                <span data-orig class="hidden text-[11px] text-slate-400 line-through font-semibold"></span>
                <span data-discount class="hidden text-[9px] font-black uppercase text-rose-700 bg-rose-50 border border-rose-200 px-1.5 py-0.5 rounded-full"></span>
              </div>
            )}
            <div class="flex items-center justify-end gap-1.5">
              <span class="hr-live-dot w-1.5 h-1.5 rounded-full bg-emerald-500" title="Live price" aria-hidden="true"></span>
              <span data-price-el class="text-lg sm:text-xl font-black text-[#0d3b23] leading-none">
                {r.priceText || (r.isAgoda ? 'Check rate' : '')}
              </span>
            </div>
          </div>

          <!-- Button -->
          <a
            href={r.url}
            target={isExternal ? "_blank" : "_self"}
            rel={isExternal ? "sponsored nofollow noopener noreferrer" : undefined}
            class="hr-btn shrink-0 rounded-full border border-[#0d3b23] px-4 sm:px-6 py-2 text-xs sm:text-sm font-bold text-[#0d3b23] bg-white transition-colors hover:bg-slate-50 active:scale-[0.97]"
          >
            {r.buttonText}
          </a>
        </li>
      );
    })}
  </ul>

  {hasContact && (
    <div class={`grid gap-2 mt-3 ${cleanPhone && cleanWhatsapp ? 'grid-cols-2' : 'grid-cols-1'}`}>
      {cleanPhone && (
        <a
          href={`tel:${cleanPhone}`}
          class="border border-slate-200 hover:border-[#0d3b23] text-slate-700 hover:text-[#0d3b23] font-bold text-xs py-2 rounded-xl transition text-center flex items-center justify-center gap-1.5"
        >
          <span aria-hidden="true">📞</span> Call Hotel
        </a>
      )}
      {cleanWhatsapp && (
        <a
          href={`https://wa.me/${cleanWhatsapp}?text=${encodeURIComponent(waMessage)}`}
          target="_blank"
          rel="noopener noreferrer"
          class="border border-[#25D366]/40 bg-[#25D366]/5 hover:bg-[#25D366] text-[#0d3b23] hover:text-white font-bold text-xs py-2 rounded-xl transition text-center flex items-center justify-center gap-1.5"
        >
          <span aria-hidden="true">💬</span> WhatsApp
        </a>
      )}
    </div>
  )}

  <p class="mt-4 text-[11px] leading-snug text-slate-500">
    Prices are provided by our partners and reflect nightly room rates. Taxes may not be included. We may earn a commission at no extra cost to you.
  </p>
</div>

<!-- global: JS দিয়ে বানানো calendar day গুলোতেও style লাগবে -->
<style is:global>
  .hr-pop {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateY(-6px) scale(0.98);
    transform-origin: top;
    transition: opacity 0.18s ease, transform 0.18s ease, visibility 0s linear 0.18s;
  }
  .hr-pop[data-open="true"] {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: none;
    transition: opacity 0.18s ease, transform 0.18s ease, visibility 0s;
  }

  .hr-field[data-active="true"] {
    background: #f0fdf4;
    box-shadow: inset 0 0 0 2px #0d3b23;
  }

  .hr-day {
    height: 2.25rem;
    width: 100%;
    font-size: 0.75rem;
    font-weight: 600;
    color: #334155;
    border-radius: 0.5rem;
    transition: background-color 0.12s, color 0.12s;
  }
  .hr-day:hover:not(:disabled):not([data-state]) { background: #f1f5f9; }
  .hr-day:disabled { color: #cbd5e1; cursor: not-allowed; }
  .hr-day[data-today="true"]:not([data-state]):not(:disabled) { box-shadow: inset 0 0 0 1px #0d3b23; }
  .hr-day[data-state="range"] { background: #d1fae5; color: #064e3b; border-radius: 0; }
  .hr-day[data-state="edge"] { background: #0d3b23; color: #fff; font-weight: 800; }

  .hr-row[data-best="true"] .hr-btn {
    background: #34e0a1;
    border-color: #34e0a1;
    color: #0d3b23;
  }
  .hr-row[data-best="true"] .hr-btn:hover { background: #2dd194; border-color: #2dd194; }

  .hr-row[data-pending="true"] { display: none; }
  .hr-live-dot { display: none; }
  .hr-row[data-live="true"] .hr-live-dot { display: inline-block; }

  .hr-row[data-loading="true"] [data-price-el] {
    opacity: 0.35;
    animation: hr-pulse 1.1s ease-in-out infinite;
  }
  @keyframes hr-pulse { 50% { opacity: 0.12; } }

  @media (prefers-reduced-motion: reduce) {
    .hr-pop, .hr-day { transition: none; }
    .hr-row[data-loading="true"] [data-price-el] { animation: none; }
  }
</style>

<script>
  let ratesAbortCtrl: AbortController | null = null;   // fetch cancel
  let listenersCtrl: AbortController | null = null;    // document-level listeners cleanup
  const ratesMemoryCache = new Map<string, any>();

  const WORKER_ENDPOINT = "https://gulshanhotels.rmollah394.workers.dev";
  const MONTH_NAMES = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];
  const MONTH_SHORT = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
  const DAY_SHORT = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
  const pad = (n: number) => String(n).padStart(2, '0');

  function addDays(dateStr: string, days: number): string {
    const [y, m, d] = dateStr.split('-').map(Number);
    const date = new Date(y, m - 1, d + days);
    return `${date.getFullYear()}-${pad(date.getMonth() + 1)}-${pad(date.getDate())}`;
  }

  function getDhakaDateString(offsetDays = 0): string {
    const base = new Intl.DateTimeFormat('en-CA', {
      timeZone: 'Asia/Dhaka',
      year: 'numeric',
      month: '2-digit',
      day: '2-digit',
    }).format(new Date());
    return offsetDays === 0 ? base : addDays(base, offsetDays);
  }

  // "Tue, Nov 10"
  function formatDayLabel(dateStr: string): string {
    const [y, m, d] = dateStr.split('-').map(Number);
    const wd = new Date(y, m - 1, d).getDay();
    return `${DAY_SHORT[wd]}, ${MONTH_SHORT[m - 1]} ${d}`;
  }

  function nightsBetween(inStr: string, outStr: string): number {
    const [y1, m1, d1] = inStr.split('-').map(Number);
    const [y2, m2, d2] = outStr.split('-').map(Number);
    const diff = Math.round((Date.UTC(y2, m2 - 1, d2) - Date.UTC(y1, m1 - 1, d1)) / 86400000);
    return Math.max(diff, 1);
  }

  function parsePrice(s: string | null | undefined): number {
    const m = String(s || '').replace(/,/g, '').match(/\d+(?:\.\d+)?/);
    return m ? parseFloat(m[0]) : NaN;
  }

  function initHotelRatesCard() {
    listenersCtrl?.abort();
    listenersCtrl = new AbortController();
    const { signal: lsig } = listenersCtrl;

    const card = document.getElementById('rates-card');
    if (!card) return;

    const listEl = document.getElementById('dealsList');
    const agodaRow = card.querySelector<HTMLElement>('[data-agoda-row="true"]');

    const checkInBtn = document.getElementById('checkInBtn');
    const checkOutBtn = document.getElementById('checkOutBtn');
    const checkInText = document.getElementById('checkInText');
    const checkOutText = document.getElementById('checkOutText');
    const calendarDropdown = document.getElementById('calendarDropdown');
    const calendarDaysGrid = document.getElementById('calendarDaysGrid');
    const calendarMonthYear = document.getElementById('calendarMonthYear');
    const calendarHint = document.getElementById('calendarHint');
    const prevMonthBtn = document.getElementById('prevMonthBtn') as HTMLButtonElement | null;
    const nextMonthBtn = document.getElementById('nextMonthBtn');
    const closeCalBtn = document.getElementById('closeCalBtn');

    const guestsBtn = document.getElementById('guestsBtn');
    const guestsDropdown = document.getElementById('guestsDropdown');
    const guestsSummaryText = document.getElementById('guestsSummaryText');
    const closeGuestsBtn = document.getElementById('closeGuestsBtn');

    const adultCountEl = document.getElementById('adultCount');
    const childCountEl = document.getElementById('childCount');
    const roomCountEl = document.getElementById('roomCount');
    const adultMinus = document.getElementById('adultMinus') as HTMLButtonElement | null;
    const adultPlus = document.getElementById('adultPlus') as HTMLButtonElement | null;
    const childMinus = document.getElementById('childMinus') as HTMLButtonElement | null;
    const childPlus = document.getElementById('childPlus') as HTMLButtonElement | null;
    const roomMinus = document.getElementById('roomMinus') as HTMLButtonElement | null;
    const roomPlus = document.getElementById('roomPlus') as HTMLButtonElement | null;

    const hotelSlug = (card.getAttribute('data-hotel-slug') || '').trim();
    const hotelName = (card.getAttribute('data-hotel-title') || '').trim();
    const agodaId = (card.getAttribute('data-agoda-id') || '').trim();
    const apiCurrency = (card.getAttribute('data-currency') || 'USD').trim();
    const agodaFallback = (card.getAttribute('data-agoda-fallback') || '').trim();

    // ---------- State ----------
    const MAX_ADULTS = 8, MAX_CHILDREN = 6, MAX_ROOMS = 5;
    let checkIn = getDhakaDateString(0);
    let checkOut = getDhakaDateString(1);
    let tempCheckIn: string | null = null;  // নতুন range বাছাইয়ের মাঝপথ
    let hoverDate: string | null = null;
    let adults = 2, children = 0, rooms = 1;
    let agodaBaseUrl = agodaFallback && agodaFallback !== '#' ? agodaFallback : '';
    let calYear = Number(checkIn.slice(0, 4));
    let calMonth = Number(checkIn.slice(5, 7)) - 1;

    const isOpen = (el: HTMLElement | null) => el?.getAttribute('data-open') === 'true';

    // ---------- Popover open/close ----------
    function updateActiveField() {
      const open = isOpen(calendarDropdown);
      const stageOut = !!tempCheckIn;
      checkInBtn?.setAttribute('data-active', String(open && !stageOut));
      checkOutBtn?.setAttribute('data-active', String(open && stageOut));
      guestsBtn?.setAttribute('data-active', String(isOpen(guestsDropdown)));
      if (calendarHint) {
        calendarHint.textContent = stageOut ? 'Select check-out date' : 'Select check-in date';
      }
    }

    function openCalendar(stage: 'in' | 'out') {
      closeGuests();
      tempCheckIn = stage === 'out' ? checkIn : null;
      hoverDate = null;
      calYear = Number((stage === 'out' ? checkIn : checkIn).slice(0, 4));
      calMonth = Number(checkIn.slice(5, 7)) - 1;
      renderCalendar();
      calendarDropdown?.setAttribute('data-open', 'true');
      checkInBtn?.setAttribute('aria-expanded', 'true');
      checkOutBtn?.setAttribute('aria-expanded', 'true');
      updateActiveField();
    }

    function closeCalendar() {
      calendarDropdown?.setAttribute('data-open', 'false');
      checkInBtn?.setAttribute('aria-expanded', 'false');
      checkOutBtn?.setAttribute('aria-expanded', 'false');
      tempCheckIn = null;
      hoverDate = null;
      updateActiveField();
    }

    function openGuests() {
      closeCalendar();
      guestsDropdown?.setAttribute('data-open', 'true');
      guestsBtn?.setAttribute('aria-expanded', 'true');
      updateActiveField();
    }

    function closeGuests() {
      guestsDropdown?.setAttribute('data-open', 'false');
      guestsBtn?.setAttribute('aria-expanded', 'false');
      updateActiveField();
    }

    // ---------- Calendar ----------
    function renderCalendar() {
      if (!calendarDaysGrid || !calendarMonthYear) return;
      calendarDaysGrid.innerHTML = '';
      calendarMonthYear.textContent = `${MONTH_NAMES[calMonth]} ${calYear}`;

      const todayStr = getDhakaDateString(0);
      const todayY = Number(todayStr.slice(0, 4));
      const todayM = Number(todayStr.slice(5, 7)) - 1;
      if (prevMonthBtn) prevMonthBtn.disabled = calYear < todayY || (calYear === todayY && calMonth <= todayM);

      const firstDay = new Date(calYear, calMonth, 1).getDay();
      const daysInMonth = new Date(calYear, calMonth + 1, 0).getDate();

      for (let i = 0; i < firstDay; i++) calendarDaysGrid.appendChild(document.createElement('div'));

      const frag = document.createDocumentFragment();
      for (let day = 1; day <= daysInMonth; day++) {
        const dateStr = `${calYear}-${pad(calMonth + 1)}-${pad(day)}`;
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'hr-day';
        btn.textContent = String(day);
        btn.dataset.date = dateStr;
        btn.setAttribute('aria-label', formatDayLabel(dateStr));
        if (dateStr === todayStr) btn.dataset.today = 'true';

        if (dateStr < todayStr) {
          btn.disabled = true;
        } else {
          btn.addEventListener('click', () => onPickDay(dateStr));
          btn.addEventListener('mouseenter', () => {
            if (tempCheckIn) { hoverDate = dateStr; paintDays(); }
          });
        }
        frag.appendChild(btn);
      }
      calendarDaysGrid.appendChild(frag);
      paintDays();
    }

    // শুধু state/class আপডেট: re-render ছাড়া, তাই smooth
    function paintDays() {
      if (!calendarDaysGrid) return;
      const start = tempCheckIn ?? checkIn;
      const end = tempCheckIn
        ? (hoverDate && hoverDate > tempCheckIn ? hoverDate : null)
        : checkOut;

      calendarDaysGrid.querySelectorAll<HTMLButtonElement>('button[data-date]').forEach((btn) => {
        const d = btn.dataset.date as string;
        let state = '';
        if (d === start || (end && d === end)) state = 'edge';
        else if (end && d > start && d < end) state = 'range';
        if (state) btn.setAttribute('data-state', state);
        else btn.removeAttribute('data-state');
      });
      updateActiveField();
    }

    function onPickDay(dateStr: string) {
      if (!tempCheckIn || dateStr <= tempCheckIn) {
        // check-in বাছাই (বা আগের তারিখ ক্লিক করলে check-in নতুন করে)
        tempCheckIn = dateStr;
        hoverDate = null;
        paintDays();
        return;
      }
      checkIn = tempCheckIn;
      checkOut = dateStr;
      closeCalendar();
      updateSummary();
      updateAgodaLink();
      fetchLiveRates();
    }

    // ---------- Summary / guests ----------
    function syncGuestUI() {
      if (adultCountEl) adultCountEl.textContent = String(adults);
      if (childCountEl) childCountEl.textContent = String(children);
      if (roomCountEl) roomCountEl.textContent = String(rooms);
      if (adultMinus) adultMinus.disabled = adults <= Math.max(1, rooms);
      if (adultPlus) adultPlus.disabled = adults >= MAX_ADULTS;
      if (childMinus) childMinus.disabled = children <= 0;
      if (childPlus) childPlus.disabled = children >= MAX_CHILDREN;
      if (roomMinus) roomMinus.disabled = rooms <= 1;
      if (roomPlus) roomPlus.disabled = rooms >= MAX_ROOMS;
    }

    function updateSummary() {
      if (checkInText) checkInText.textContent = formatDayLabel(checkIn);
      if (checkOutText) checkOutText.textContent = formatDayLabel(checkOut);
      const nights = nightsBetween(checkIn, checkOut);
      checkOutBtn?.setAttribute('title', `${nights} ${nights === 1 ? 'night' : 'nights'}`);
      if (guestsSummaryText) {
        const guests = adults + children;
        guestsSummaryText.textContent =
          `${rooms} ${rooms === 1 ? 'Room' : 'Rooms'}, ${guests} ${guests === 1 ? 'Guest' : 'Guests'}`;
      }
      syncGuestUI();
    }

    // ---------- Deals list: sort + FLIP animation ----------
    function rowValue(r: HTMLElement): number {
      const n = parseFloat(r.dataset.price || '');
      return n > 0 ? n : Infinity;
    }

    function reorderRows(animate = true) {
      if (!listEl) return;
      const rows = Array.from(listEl.querySelectorAll<HTMLElement>('.hr-row'));
      const before = new Map(rows.map((r) => [r, r.getBoundingClientRect().top]));

      const sorted = rows
        .map((r, i) => ({ r, i, v: rowValue(r) }))
        .sort((a, b) => (a.v === b.v ? a.i - b.i : a.v - b.v));

      sorted.forEach(({ r, v }, idx) => {
        r.style.order = String(idx);
        r.dataset.best = String(idx === 0 && v !== Infinity);
      });

      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!animate || reduce) return;
      rows.forEach((r) => {
        const delta = (before.get(r) || 0) - r.getBoundingClientRect().top;
        if (Math.abs(delta) > 1) {
          r.animate(
            [{ transform: `translateY(${delta}px)` }, { transform: 'none' }],
            { duration: 300, easing: 'cubic-bezier(0.2, 0.8, 0.2, 1)' }
          );
        }
      });
    }

    function syncGlobalPrice() {
      if (!listEl) return;
      const best = Array.from(listEl.querySelectorAll<HTMLElement>('.hr-row'))
        .filter((r) => rowValue(r) !== Infinity)
        .sort((a, b) => rowValue(a) - rowValue(b))[0];
      const text = best?.dataset.priceText;
      if (!text) return;
      document.querySelectorAll('.hotel-live-price, [data-hotel-live-price]').forEach((el) => {
        el.textContent = text;
      });
    }

    function updateAgodaLink() {
      const a = agodaRow?.querySelector<HTMLAnchorElement>('a.hr-btn');
      if (!a || !agodaBaseUrl) return;
      try {
        const u = new URL(agodaBaseUrl);
        u.searchParams.set('checkin', checkIn);
        u.searchParams.set('checkout', checkOut);
        u.searchParams.set('adults', String(adults));
        u.searchParams.set('children', String(children));
        u.searchParams.set('rooms', String(rooms));
        a.href = u.toString();
      } catch {
        a.href = agodaBaseUrl;
      }
    }

    function setLoading(on: boolean) {
      if (agodaRow) agodaRow.dataset.loading = String(on);
    }

    // ---------- Live rates ----------
    async function fetchLiveRates() {
      if (!agodaRow) return;
      const cacheKey = `${hotelSlug || agodaId}_${checkIn}_${checkOut}_${adults}_${children}_${rooms}_${apiCurrency}`;
      if (ratesMemoryCache.has(cacheKey)) {
        applyRates(ratesMemoryCache.get(cacheKey));
        return;
      }

      ratesAbortCtrl?.abort();
      const ctrl = new AbortController();
      ratesAbortCtrl = ctrl;
      const { signal } = ctrl;

      setLoading(true);

      const queryParam = agodaId
        ? `id=${encodeURIComponent(agodaId)}`
        : `hotel=${encodeURIComponent(hotelSlug || hotelName)}`;
      const apiUrl =
        `${WORKER_ENDPOINT}?${queryParam}&checkIn=${checkIn}&checkOut=${checkOut}` +
        `&adults=${adults}&children=${children}&rooms=${rooms}&currency=${encodeURIComponent(apiCurrency)}`;

      try {
        const res = await fetch(apiUrl, { signal });
        if (!res.ok) {
          console.warn('[HotelRates] worker responded', res.status);
          return;
        }
        const json = await res.json();
        if (json && json.success && json.rates) {
          ratesMemoryCache.set(cacheKey, json.rates);
          applyRates(json.rates);
        } else {
          console.warn('[HotelRates] no rates in response');
        }
      } catch (e: any) {
        if (e?.name === 'AbortError') return;
        console.warn('[HotelRates] fetch failed', e);
      } finally {
        if (!signal.aborted) setLoading(false);
      }
    }

    function applyRates(rates: any) {
      if (!agodaRow) return;
      setLoading(false);

      const priceEl = agodaRow.querySelector<HTMLElement>('[data-price-el]');
      const origEl = agodaRow.querySelector<HTMLElement>('[data-orig]');
      const discEl = agodaRow.querySelector<HTMLElement>('[data-discount]');
      const noteEl = agodaRow.querySelector<HTMLElement>('[data-note]');

      const priceText = rates?.startingPrice ? String(rates.startingPrice) : '';
      const n = parsePrice(priceText);
      if (priceText && n > 0) {
        agodaRow.dataset.price = String(n);
        agodaRow.dataset.priceText = priceText;
        agodaRow.dataset.live = 'true';
        if (priceEl) priceEl.textContent = priceText;
      }

      if (origEl) {
        if (rates?.originalPrice) { origEl.textContent = String(rates.originalPrice); origEl.classList.remove('hidden'); }
        else origEl.classList.add('hidden');
      }
      if (discEl) {
        if (rates?.discountText) { discEl.textContent = String(rates.discountText); discEl.classList.remove('hidden'); }
        else discEl.classList.add('hidden');
      }
      if (noteEl && rates?.note) noteEl.textContent = String(rates.note);

      // [0] ধরে নেওয়া নয়: নাম/URL দিয়ে Agoda deal খোঁজা
      const list: any[] = Array.isArray(rates?.channelsList) ? rates.channelsList : [];
      const agodaDeal = list.find((c) => {
        const name = String(c?.provider_name || c?.providerName || c?.name || '');
        const url = String(c?.button_url || '');
        return /agoda/i.test(name) || /agoda\.com/i.test(url);
      });
      if (agodaDeal?.button_url) agodaBaseUrl = String(agodaDeal.button_url);
      updateAgodaLink();
      if (agodaBaseUrl) agodaRow.removeAttribute('data-pending');

      reorderRows(true);
      syncGlobalPrice();
    }

    // ---------- Events ----------
    checkInBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      if (isOpen(calendarDropdown) && !tempCheckIn) { closeCalendar(); return; }
      openCalendar('in');
    });

    checkOutBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      if (isOpen(calendarDropdown) && tempCheckIn) { closeCalendar(); return; }
      openCalendar('out');
    });

    prevMonthBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      if (prevMonthBtn.disabled) return;
      calMonth--;
      if (calMonth < 0) { calMonth = 11; calYear--; }
      renderCalendar();
    });

    nextMonthBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      calMonth++;
      if (calMonth > 11) { calMonth = 0; calYear++; }
      renderCalendar();
    });

    calendarDaysGrid?.addEventListener('mouseleave', () => {
      if (tempCheckIn) { hoverDate = null; paintDays(); }
    });

    closeCalBtn?.addEventListener('click', closeCalendar);

    guestsBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      if (isOpen(guestsDropdown)) closeGuests();
      else openGuests();
    });

    closeGuestsBtn?.addEventListener('click', () => {
      closeGuests();
      updateSummary();
      updateAgodaLink();
      fetchLiveRates();
    });

    adultPlus?.addEventListener('click', () => { if (adults < MAX_ADULTS) adults++; updateSummary(); });
    adultMinus?.addEventListener('click', () => { if (adults > Math.max(1, rooms)) adults--; updateSummary(); });
    childPlus?.addEventListener('click', () => { if (children < MAX_CHILDREN) children++; updateSummary(); });
    childMinus?.addEventListener('click', () => { if (children > 0) children--; updateSummary(); });
    roomPlus?.addEventListener('click', () => {
      if (rooms < MAX_ROOMS) { rooms++; if (adults < rooms) adults = rooms; }
      updateSummary();
    });
    roomMinus?.addEventListener('click', () => { if (rooms > 1) rooms--; updateSummary(); });

    document.addEventListener('click', (e) => {
      const t = e.target as Node;
      if (isOpen(calendarDropdown) && !calendarDropdown?.contains(t) && !checkInBtn?.contains(t) && !checkOutBtn?.contains(t)) {
        closeCalendar();
      }
      if (isOpen(guestsDropdown) && !guestsDropdown?.contains(t) && !guestsBtn?.contains(t)) {
        closeGuests();
      }
    }, { signal: lsig });

    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape') return;
      if (isOpen(calendarDropdown)) { closeCalendar(); checkInBtn?.focus(); }
      if (isOpen(guestsDropdown)) { closeGuests(); guestsBtn?.focus(); }
    }, { signal: lsig });

    // ---------- Init ----------
    updateSummary();
    updateAgodaLink();
    reorderRows(false);
    fetchLiveRates();
  }

  // ClientRouter (View Transitions) না থাকলে 'astro:page-load' কখনোই fire হয় না,
  // তাই DOM ready তে সরাসরি চালাও। প্রতিটি card এ শুধু একবারই init হবে।
  function initOnce() {
    const card = document.getElementById('rates-card');
    if (!card || card.dataset.hrInit === 'true') return;
    card.dataset.hrInit = 'true';
    initHotelRatesCard();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initOnce);
  } else {
    initOnce();
  }
  document.addEventListener('astro:page-load', initOnce); // ClientRouter থাকলে navigation এর পর

  document.addEventListener('astro:before-swap', () => {
    ratesAbortCtrl?.abort();
    listenersCtrl?.abort();
  });
</script>
