---
// src/components/hotel/HotelRates.astro (TripAdvisor-Grade Professional Rates & Date Widget)
interface Props {
  hotel: any;
}

const { hotel } = Astro.props;
const data = hotel?.data || {};

const hotelTitle = String(data.title || data.name || "").trim();
const rawSlug = String(data.slug || hotel?.slug || hotel?.id || "").trim();
const hotelSlug = rawSlug.replace(/\.(md|mdx)$/, '').split('/').pop()?.toLowerCase() || "";
const agodaId = String(data.agoda_id || data.agodaId || "").trim();

const whatsapp = String(data.whatsapp || "");
const phone = String(data.phone || "");

let cleanWhatsapp = whatsapp.replace(/[^0-9]/g, '');
if (cleanWhatsapp.startsWith('01')) cleanWhatsapp = '88' + cleanWhatsapp;
const cleanPhone = phone.replace(/[^0-9+]/g, '');
const hasContact = Boolean(cleanPhone || cleanWhatsapp);
const waMessage = 'Hi! I want to book a room at ' + hotelTitle;

const customChannels: any[] = Array.isArray(data.booking_channels) ? data.booking_channels : [];

// কারেন্সি ও প্রাইস হেল্পার
function detectCurrency(v: any): string | null {
  const s = String(v || "");
  if (s.includes('$')) return '$';
  if (s.includes('৳')) return '৳';
  return null;
}

const rawBasePrice = String(data.price || "").trim();
const mainCurrency =
  detectCurrency(rawBasePrice) ||
  customChannels.map((c) => detectCurrency(c?.price)).find(Boolean) ||
  '$';

function formatPrice(p: any): string {
  const s = String(p || "").trim();
  if (!s) return "";
  return detectCurrency(s) ? s : mainCurrency + s;
}

function extractNumericPrice(val: any): number | null {
  if (!val) return null;
  const str = String(val).replace(/,/g, '').trim();
  const match = str.match(/(\d+(?:\.\d+)?)/);
  return match ? parseFloat(match[1]) : null;
}

function safeUrl(u: string) {
  const v = String(u || "").trim();
  return /^(https?:|tel:|mailto:)/i.test(v) ? v : "#";
}

function sanitizeLink(rawUrl: any = "", preset: string = "", pName: string = "", hName: string = "") {
  const url = String(rawUrl || "").trim();
  if (!url || url === "#") return "#";
  const lowerName = String(pName).toLowerCase();
  const isPhone = preset === 'phone' || lowerName.includes('call');
  const isWhatsapp = preset === 'whatsapp' || lowerName.includes('whatsapp');

  if (isPhone && !/^(https?:|tel:)/i.test(url)) {
    const p = url.replace(/[^0-9+]/g, '');
    return p ? `tel:${p}` : "#";
  }
  if ((isWhatsapp || /^[0-9+\s\-()]+$/.test(url)) && !/^https?:/i.test(url)) {
    let digits = url.replace(/[^0-9]/g, '');
    if (!digits) return "#";
    if (digits.startsWith('01')) digits = '88' + digits;
    return `https://wa.me/${digits}?text=${encodeURIComponent('Hi! I want to book a room at ' + hName)}`;
  }
  if (!/^(https?:|tel:|mailto:)/i.test(url)) return safeUrl(`https://${url}`);
  return safeUrl(url);
}

function cleanSvgSSR(svg: string): string {
  return String(svg || '')
    .replace(/<script[\s\S]*?<\/script>/gi, '')
    .replace(/<foreignObject[\s\S]*?<\/foreignObject>/gi, '')
    .replace(/\son\w+\s*=\s*("[^"]*"|'[^']*'|[^\s>]+)/gi, '')
    .replace(/javascript:/gi, '');
}

const channels = customChannels
  .map((item: any) => {
    const providerName = String(item?.provider_name || "Booking Partner");
    const iconPreset = String(item?.icon_preset || "direct");
    const showPrice = item?.show_price !== false && item?.showPrice !== false;
    const customSvg = item?.custom_svg ? cleanSvgSSR(item.custom_svg) : "";
    return {
      providerName,
      iconPreset,
      customSvg,
      showPrice,
      rawPrice: item?.price,
      price: formatPrice(item?.price),
      buttonText: String(item?.button_text || "Book Now"),
      url: sanitizeLink(item?.button_url, iconPreset, providerName, hotelTitle),
    };
  })
  .filter((c) => c.url !== "#");

const hasChannels = channels.length > 0;

let lowestNumericPrice = Infinity;
const baseNum = extractNumericPrice(rawBasePrice);
if (baseNum !== null && baseNum > 0) lowestNumericPrice = baseNum;

channels.forEach((c) => {
  if (!c.showPrice) return;
  const n = extractNumericPrice(c.rawPrice);
  const cur = detectCurrency(c.rawPrice) ?? mainCurrency;
  if (n !== null && n > 0 && cur === mainCurrency && n < lowestNumericPrice) {
    lowestNumericPrice = n;
  }
});

const displayStartingPrice =
  lowestNumericPrice !== Infinity
    ? `${mainCurrency}${lowestNumericPrice.toLocaleString('en-US')}`
    : (formatPrice(rawBasePrice) || "Check Rates");

const presetSvgs: Record<string, string> = {
  agoda: `<div class="w-8 h-8 rounded-lg bg-[#1d3557] text-white font-bold text-[10px] flex items-center justify-center shrink-0 tracking-tight shadow-xs">agoda</div>`,
  booking: `<div class="w-8 h-8 rounded-lg bg-[#003580] text-white font-bold text-xs flex items-center justify-center shrink-0 shadow-xs">B.</div>`,
  tripadvisor: `<div class="w-8 h-8 rounded-lg bg-[#00af87] text-white flex items-center justify-center shrink-0 shadow-xs"><svg aria-hidden="true" class="w-4 h-4 fill-white" viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zm-4.5-9a2.5 2.5 0 100 5 2.5 2.5 0 000-5zm9 0a2.5 2.5 0 100 5 2.5 2.5 0 000-5z"/></svg></div>`,
  expedia: `<div class="w-8 h-8 rounded-lg bg-[#ffe600] flex items-center justify-center shrink-0 shadow-xs"><svg aria-hidden="true" class="w-4 h-4 fill-slate-950" viewBox="0 0 24 24"><path d="M21 16v-2l-8-5V3.5c0-.83-.67-1.5-1.5-1.5S10 2.67 10 3.5V9l-8 5v2l8-2.5V19l-2 1.5V22l3.5-1 3.5 1v-1.5L13 19v-5.5l8 2.5z"/></svg></div>`,
  whatsapp: `<div class="w-8 h-8 rounded-lg bg-[#25D366] text-white font-bold text-[10px] flex items-center justify-center shrink-0 shadow-xs">WA</div>`,
  phone: `<div class="w-8 h-8 rounded-lg bg-slate-100 flex items-center justify-center shrink-0 shadow-xs"><svg aria-hidden="true" class="w-4 h-4 fill-[#0d3b23]" viewBox="0 0 24 24"><path d="M6.62 10.79c1.44 2.83 2.62 4.2 5.45 5.64l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/></svg></div>`,
  direct: `<div class="w-8 h-8 rounded-lg bg-emerald-100 text-[#0d3b23] flex items-center justify-center shrink-0 shadow-xs"><svg aria-hidden="true" class="w-4 h-4 fill-[#0d3b23]" viewBox="0 0 24 24"><path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-7 3c1.66 0 3 1.34 3 3s-1.34 3-3 3-3-1.34-3-3 1.34-3 3-3zm3 10H9v-1c0-1 2-1.9 3-1.9s3 .9 3 1.9v1z"/></svg></div>`,
};
---

<div id="rates-card" class="bg-white rounded-3xl border border-slate-200 shadow-xl overflow-hidden text-left scroll-mt-20">

  <!-- Header: TripAdvisor / Luxury Meta-Search Style -->
  <div class="bg-gradient-to-r from-[#0a522c] to-[#043319] text-white p-5 sm:p-6 pb-6 text-left relative">
    <div class="flex items-center justify-between">
      <div>
        <span class="text-[10px] uppercase font-bold tracking-widest text-emerald-300 block mb-0.5">
          Live Partner Search
        </span>
        <h3 class="font-sans text-xl sm:text-2xl font-black tracking-tight text-white leading-tight">
          Find the Best Deal
        </h3>
      </div>
      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-white/10 backdrop-blur-md border border-white/20 text-[10px] font-bold text-emerald-200">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
        Live Prices
      </span>
    </div>
  </div>

  <!-- Body Container -->
  <div class="p-5 sm:p-6 space-y-4 pt-4">

    <!-- ================= 1. TRIPADVISOR-STYLE DATE & GUESTS SELECTOR ================= -->
    <div class="space-y-2">
      
      <!-- Check-in & Check-out Dual Box -->
      <div class="relative bg-white border-2 border-slate-200 hover:border-emerald-700/80 rounded-2xl overflow-hidden transition-colors shadow-2xs">
        
        <div class="grid grid-cols-2 divide-x divide-slate-200">
          
          <!-- Check-in Box -->
          <div class="relative p-3 hover:bg-slate-50 transition cursor-pointer group">
            <span class="block text-[9px] font-bold uppercase tracking-wider text-slate-400 group-hover:text-emerald-800">
              Check-in
            </span>
            <div class="flex items-center gap-1.5 mt-0.5">
              <svg aria-hidden="true" class="w-3.5 h-3.5 text-emerald-700 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
              </svg>
              <span id="checkInDisplay" class="font-sans font-bold text-xs sm:text-sm text-slate-900 truncate">
                Loading...
              </span>
            </div>
            <!-- লুকানো নেটিভ ইনপুট (ক্লিক করলে ক্যালেন্ডার খুলবে) -->
            <input 
              type="date" 
              id="checkInInput" 
              class="absolute inset-0 opacity-0 cursor-pointer w-full h-full z-10" 
              aria-label="Select check-in date"
            />
          </div>

          <!-- Check-out Box -->
          <div class="relative p-3 hover:bg-slate-50 transition cursor-pointer group">
            <span class="block text-[9px] font-bold uppercase tracking-wider text-slate-400 group-hover:text-emerald-800">
              Check-out
            </span>
            <div class="flex items-center gap-1.5 mt-0.5">
              <svg aria-hidden="true" class="w-3.5 h-3.5 text-emerald-700 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
              </svg>
              <span id="checkOutDisplay" class="font-sans font-bold text-xs sm:text-sm text-slate-900 truncate">
                Loading...
              </span>
            </div>
            <input 
              type="date" 
              id="checkOutInput" 
              class="absolute inset-0 opacity-0 cursor-pointer w-full h-full z-10" 
              aria-label="Select check-out date"
            />
          </div>

        </div>

        <!-- মাঝখানের নাইটস ব্যাজ (TripAdvisor Floating Night Badge) -->
        <div class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 z-0 pointer-events-none hidden sm:block">
          <span id="stayNightsBadge" class="bg-white border border-slate-200 text-slate-700 font-black text-[10px] px-2 py-0.5 rounded-full shadow-xs">
            1 night
          </span>
        </div>
      </div>

      <!-- Guests Bar (TripAdvisor Signature) -->
      <div class="flex items-center justify-between bg-slate-50 border border-slate-200/80 rounded-xl px-3.5 py-2 text-xs font-semibold text-slate-700">
        <div class="flex items-center gap-2">
          <svg aria-hidden="true" class="w-4 h-4 text-emerald-700 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
          </svg>
          <span>2 Guests · 1 Room</span>
        </div>
        <span class="text-[10px] uppercase font-bold text-slate-400">Standard</span>
      </div>

    </div>

    <!-- ================= 2. FEATURED PARTNER DEAL (TRIPADVISOR TOP DEAL BOX) ================= -->
    <div id="agodaFeaturedDealCard" class="hidden bg-emerald-50/50 border-2 border-emerald-600/30 rounded-2xl p-4 space-y-3 relative overflow-hidden transition-all shadow-xs">
      
      <div class="flex items-center justify-between">
        <span class="inline-flex items-center gap-1 text-[10px] font-black uppercase tracking-wider text-emerald-800 bg-emerald-100 px-2.5 py-0.5 rounded-md">
          <span>★</span>
          <span>Top Value Deal</span>
        </span>
        <span id="agodaDiscountBadge" class="hidden text-[10px] font-black uppercase tracking-wider text-rose-700 bg-rose-100 px-2 py-0.5 rounded-md animate-pulse">
        </span>
      </div>

      <div class="flex items-center justify-between gap-3">
        <div class="flex items-center gap-3">
          <Fragment set:html={presetSvgs.agoda} />
          <div>
            <h4 class="font-bold text-sm text-slate-900 leading-tight">Agoda Official</h4>
            <p class="text-[10px] text-slate-500 font-medium">Instant Confirmation · Best Rate</p>
          </div>
        </div>

        <div class="text-right">
          <span id="agodaOriginalPrice" class="hidden text-xs text-slate-400 line-through block leading-tight font-semibold"></span>
          <div class="flex items-baseline gap-1">
            <span id="agodaRowPrice" class="text-2xl font-black text-[#0d3b23] leading-none"></span>
            <span class="text-[10px] text-slate-500 font-semibold">/ night</span>
          </div>
        </div>
      </div>

      <a
        id="agodaRowBtn"
        href="#"
        target="_blank"
        rel="sponsored nofollow noopener"
        class="w-full bg-[#0d3b23] hover:bg-[#061e14] text-white font-bold text-xs sm:text-sm py-2.5 rounded-xl transition shadow-md hover:shadow-lg flex items-center justify-center gap-2 active:scale-98"
      >
        <span>View Deal</span>
        <svg aria-hidden="true" class="w-4 h-4 stroke-current fill-none stroke-2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
        </svg>
      </a>
    </div>

    <!-- Starting Price Overview (If Agoda deal is not loaded yet or for fallback) -->
    <div id="generalPriceRow" class="flex items-center justify-between border-b border-slate-100 pb-3">
      <div class="flex flex-col">
        <span class="text-[10px] text-slate-400 font-bold uppercase tracking-wider flex items-center gap-1.5 mb-0.5">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
          <span>Lowest Rate from Partners</span>
        </span>

        <div class="flex items-baseline gap-1.5">
          <span id="cardStartingPriceDisplay" class="hotel-live-price text-2xl sm:text-3xl font-black text-[#0d3b23] leading-none">
            {displayStartingPrice}
          </span>
          {displayStartingPrice !== "Check Rates" && (
            <span id="cardPerNightText" class="text-xs text-slate-500 font-semibold">per night</span>
          )}
        </div>
      </div>

      <span class="inline-flex items-center gap-1 bg-slate-100 text-slate-600 text-[11px] font-bold px-2.5 py-1 rounded-full">
        Direct & Partner Rates
      </span>
    </div>

    <!-- ================= 3. OTHER BOOKING CHANNELS ================= -->
    <div
      id="aboutRatesTableContainer"
      data-hotel-title={hotelTitle}
      data-hotel-slug={hotelSlug}
      data-agoda-id={agodaId}
      data-currency={mainCurrency}
      data-has-contact={hasContact ? 'true' : 'false'}
      class="divide-y divide-slate-100"
    >
      {channels.map((c) => {
        const isExternal = c.url.startsWith('http');
        return (
          <div class="flex items-center justify-between py-3 first:pt-1 last:pb-1">
            <div class="flex items-center gap-3 min-w-0">
              {c.customSvg ? (
                <div class="w-8 h-8 shrink-0 flex items-center justify-center [&_svg]:w-full [&_svg]:h-full [&_svg]:max-w-full [&_svg]:max-h-full">
                  <Fragment set:html={c.customSvg} />
                </div>
              ) : (
                <Fragment set:html={presetSvgs[c.iconPreset] || presetSvgs.direct} />
              )}
              <span class="text-sm font-bold text-slate-900 truncate">{c.providerName}</span>
            </div>

            <div class="flex items-center gap-3 shrink-0">
              {c.showPrice && c.price && (
                <span class="text-base font-black text-slate-900">{c.price}</span>
              )}
              <a
                href={c.url}
                target={isExternal ? "_blank" : "_self"}
                rel={isExternal ? "sponsored nofollow noopener" : undefined}
                aria-label={`${c.buttonText}: ${hotelTitle} on ${c.providerName}`}
                class="bg-slate-900 hover:bg-[#0d3b23] text-white font-bold text-xs px-4 py-2 rounded-xl transition shadow-xs hover:scale-105 active:scale-95 inline-flex items-center gap-1.5"
              >
                <span>{c.buttonText}</span>
                <svg aria-hidden="true" class="w-3.5 h-3.5 stroke-current fill-none stroke-2 shrink-0" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
                </svg>
              </a>
            </div>
          </div>
        );
      })}

      {!hasChannels && (
        <div id="ratesFallbackLoader" class="flex items-center justify-center py-6" role="status" aria-label="Loading room rates">
          <span class="inline-block w-5 h-5 border-2 border-[#0d3b23] border-t-transparent rounded-full animate-spin"></span>
        </div>
      )}
    </div>

    <!-- ================= 4. DIRECT RESERVATION (CALL / WHATSAPP) ================= -->
    {hasContact && (
      <div id="staticReservationChannels" class="pt-3 border-t border-slate-100 text-center space-y-2.5">
        <span class="text-[11px] font-bold text-slate-500 uppercase tracking-wider block">
          Or Contact Hotel Directly
        </span>

        <div class={`grid gap-2 ${cleanPhone && cleanWhatsapp ? 'grid-cols-2' : 'grid-cols-1'}`}>
          {cleanPhone && (
            <a
              href={`tel:${cleanPhone}`}
              class="w-full border-2 border-slate-200 bg-white hover:border-[#0d3b23] text-slate-800 hover:text-[#0d3b23] font-bold text-xs py-2 rounded-xl transition flex items-center justify-center gap-1.5 shadow-2xs"
            >
              <svg aria-hidden="true" class="w-3.5 h-3.5 text-emerald-700 shrink-0" fill="currentColor" viewBox="0 0 24 24">
                <path d="M6.62 10.79c1.44 2.83 2.62 4.2 5.45 5.64l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/>
              </svg>
              <span>Call</span>
            </a>
          )}

          {cleanWhatsapp && (
            <a
              href={`https://wa.me/${cleanWhatsapp}?text=${encodeURIComponent(waMessage)}`}
              target="_blank"
              rel="noopener noreferrer"
              class="w-full border-2 border-[#25D366]/40 bg-[#25D366]/5 hover:bg-[#25D366] text-[#0d3b23] hover:text-white font-bold text-xs py-2 rounded-xl transition flex items-center justify-center gap-1.5 shadow-2xs"
            >
              <svg aria-hidden="true" class="w-3.5 h-3.5 fill-[#25D366] group-hover:fill-white shrink-0" viewBox="0 0 24 24">
                <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0 0 12.04 2m.01 1.67c2.2 0 4.26.86 5.82 2.42a8.225 8.225 0 0 1 2.41 5.83c0 4.54-3.7 8.24-8.24 8.24-1.48 0-2.93-.4-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.196 8.196 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.24-8.24m4.52 11.66c-.25-.13-1.47-.72-1.7-.81-.23-.08-.39-.13-.56.13-.17.25-.64.81-.79.97-.14.17-.29.19-.54.06-.25-.13-1.06-.39-2.03-1.24-.75-.67-1.26-1.5-1.41-1.75-.14-.25-.02-.39.11-.51.11-.11.25-.29.37-.43.13-.15.17-.25.25-.42.08-.17.04-.31-.02-.44-.06-.13-.56-1.35-.77-1.85-.2-.49-.41-.42-.56-.43h-.48c-.17 0-.44.06-.67.31-.23.25-.87.85-.87 2.07 0 1.22.89 2.4 1.01 2.57.13.17 1.75 2.67 4.24 3.74.59.26 1.05.41 1.41.53.6.19 1.14.16 1.57.1.48-.07 1.47-.6 1.68-1.18.21-.58.21-1.07.15-1.18-.06-.12-.22-.19-.47-.32"/>
              </svg>
              <span>WhatsApp</span>
            </a>
          )}
        </div>
      </div>
    )}

    <!-- Transparent Affiliate Disclosure -->
    <p class="pt-1 text-center text-[10px] leading-snug text-slate-400 font-medium">
      Partner rates sync in real-time. We may earn a commission when you book, with zero extra cost to you.
    </p>

  </div>
</div>

<script>
  let aboutAbortCtrl: AbortController | null = null;

  function getDhakaDate(offsetDays = 0) {
    const now = new Date();
    const utcMillis = now.getTime() + (now.getTimezoneOffset() * 60000);
    const dhakaTime = new Date(utcMillis + (6 * 3600000));
    dhakaTime.setDate(dhakaTime.getDate() + offsetDays);
    return dhakaTime.toISOString().split("T")[0];
  }

  // TripAdvisor Style Friendly Date: e.g. "Sun, Nov 8"
  function formatTripAdvisorDate(dateStr: string): string {
    if (!dateStr) return '';
    const [year, month, day] = dateStr.split('-').map(Number);
    const d = new Date(year, month - 1, day);
    const days = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
    const months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
    return `${days[d.getDay()]}, ${months[d.getMonth()]} ${d.getDate()}`;
  }

  async function initHotelRatesCard() {
    const ratesContainer = document.getElementById('aboutRatesTableContainer');
    const startingPriceEl = document.getElementById('cardStartingPriceDisplay');
    const loaderEl = document.getElementById('ratesFallbackLoader');
    const perNightTextEl = document.getElementById('cardPerNightText');

    // TripAdvisor Elements
    const checkInInput = document.getElementById('checkInInput') as HTMLInputElement | null;
    const checkOutInput = document.getElementById('checkOutInput') as HTMLInputElement | null;
    const checkInDisplay = document.getElementById('checkInDisplay');
    const checkOutDisplay = document.getElementById('checkOutDisplay');
    const nightsBadge = document.getElementById('stayNightsBadge');

    // Featured Deal Card Elements
    const agodaDealCard = document.getElementById('agodaFeaturedDealCard');
    const agodaPriceEl = document.getElementById('agodaRowPrice');
    const agodaBtnEl = document.getElementById('agodaRowBtn') as HTMLAnchorElement | null;
    const agodaDiscountEl = document.getElementById('agodaDiscountBadge');
    const agodaOriginalPriceEl = document.getElementById('agodaOriginalPrice');

    if (!ratesContainer) return;

    const hotelSlug = (ratesContainer.getAttribute('data-hotel-slug') || '').trim();
    const hotelName = (ratesContainer.getAttribute('data-hotel-title') || '').trim();
    const agodaId = (ratesContainer.getAttribute('data-agoda-id') || '').trim();
    const WORKER_ENDPOINT = "https://gulshanhotels.rmollah394.workers.dev";

    // তারিখ ইনিশিয়ালাইজেশন
    const today = getDhakaDate(0);
    const tomorrow = getDhakaDate(1);

    if (checkInInput && !checkInInput.value) {
      checkInInput.value = today;
      checkInInput.min = today;
    }
    if (checkOutInput && !checkOutInput.value) {
      checkOutInput.value = tomorrow;
      checkOutInput.min = tomorrow;
    }

    // TripAdvisor টেক্সট ডিসপ্লে আপডেট
    function updateDateLabels() {
      if (checkInInput && checkInDisplay) {
        checkInDisplay.textContent = formatTripAdvisorDate(checkInInput.value);
      }
      if (checkOutInput && checkOutDisplay) {
        checkOutDisplay.textContent = formatTripAdvisorDate(checkOutInput.value);
      }
      if (checkInInput && checkOutInput && nightsBadge) {
        const d1 = new Date(checkInInput.value);
        const d2 = new Date(checkOutInput.value);
        const diffTime = d2.getTime() - d1.getTime();
        const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));
        if (diffDays > 0) {
          nightsBadge.textContent = `${diffDays} ${diffDays === 1 ? 'night' : 'nights'}`;
        }
      }
    }

    // লাইভ প্রাইস ফেচিং ফাংশন
    async function fetchLiveRates(checkIn: string, checkOut: string) {
      aboutAbortCtrl?.abort();
      aboutAbortCtrl = new AbortController();
      const { signal } = aboutAbortCtrl;

      if (startingPriceEl) startingPriceEl.style.opacity = '0.4';
      if (agodaPriceEl) agodaPriceEl.style.opacity = '0.4';

      const queryParam = agodaId ? `id=${encodeURIComponent(agodaId)}` : `hotel=${encodeURIComponent(hotelSlug || hotelName)}`;
      const apiUrl = `${WORKER_ENDPOINT}?${queryParam}&checkIn=${checkIn}&checkOut=${checkOut}&currency=USD`;

      try {
        const res = await fetch(apiUrl, { signal });
        if (res.ok) {
          const json = await res.json();
          if (json && json.success && json.rates) {
            const rates = json.rates;
            const livePriceStr = rates.startingPrice ? String(rates.startingPrice) : null;

            // স্টার্টিং প্রাইস আপডেট
            if (startingPriceEl) {
              startingPriceEl.textContent = livePriceStr || "Check Rates";
              startingPriceEl.style.opacity = '1';
            }

            if (perNightTextEl) {
              if (livePriceStr) perNightTextEl.classList.remove('hidden');
              else perNightTextEl.classList.add('hidden');
            }

            // TripAdvisor Featured Deal Box আপডেট
            const agodaDeal = Array.isArray(rates.channelsList) ? rates.channelsList[0] : null;
            if (agodaDealCard && agodaDeal && livePriceStr) {
              if (agodaPriceEl) {
                agodaPriceEl.textContent = livePriceStr;
                agodaPriceEl.style.opacity = '1';
              }
              if (agodaBtnEl && agodaDeal.button_url) {
                agodaBtnEl.href = agodaDeal.button_url; // ভিজিটরের তারিখসহ সরাসরি আগোডা বুকিং লিংক
              }
              if (agodaOriginalPriceEl) {
                if (rates.originalPrice) {
                  agodaOriginalPriceEl.textContent = rates.originalPrice;
                  agodaOriginalPriceEl.classList.remove('hidden');
                } else {
                  agodaOriginalPriceEl.classList.add('hidden');
                }
              }
              if (agodaDiscountEl) {
                if (rates.discountText) {
                  agodaDiscountEl.textContent = `SAVE ${rates.discountText.replace(/off/i, '').trim()}`;
                  agodaDiscountEl.classList.remove('hidden');
                } else {
                  agodaDiscountEl.classList.add('hidden');
                }
              }
              agodaDealCard.classList.remove('hidden');
            }

            // পেজের অন্যান্য লাইভ প্রাইস আপডেট
            if (livePriceStr) {
              document.querySelectorAll('.hotel-live-price, [data-hotel-live-price]').forEach((el) => {
                el.textContent = livePriceStr;
              });
            }

            if (loaderEl) loaderEl.remove();
          }
        }
      } catch (e: any) {
        if (startingPriceEl) startingPriceEl.style.opacity = '1';
        if (agodaPriceEl) agodaPriceEl.style.opacity = '1';
      } finally {
        if (loaderEl) loaderEl.remove();
      }
    }

    // ইনিশিয়াল লোড
    updateDateLabels();
    fetchLiveRates(checkInInput?.value || today, checkOutInput?.value || tomorrow);

    // তারিখ পরিবর্তন ইভেন্ট
    if (checkInInput && !checkInInput.dataset.bound) {
      checkInInput.dataset.bound = 'true';
      checkInInput.addEventListener('change', () => {
        const newIn = checkInInput.value;
        if (checkOutInput) {
          const nextDay = new Date(newIn);
          nextDay.setDate(nextDay.getDate() + 1);
          const nextDayStr = nextDay.toISOString().split("T")[0];
          checkOutInput.min = nextDayStr;
          if (checkOutInput.value <= newIn) {
            checkOutInput.value = nextDayStr;
          }
        }
        updateDateLabels();
        fetchLiveRates(checkInInput.value, checkOutInput?.value || tomorrow);
      });
    }

    if (checkOutInput && !checkOutInput.dataset.bound) {
      checkOutInput.dataset.bound = 'true';
      checkOutInput.addEventListener('change', () => {
        updateDateLabels();
        fetchLiveRates(checkInInput?.value || today, checkOutInput.value);
      });
    }
  }

  document.addEventListener('astro:before-swap', () => {
    aboutAbortCtrl?.abort();
  });

  document.addEventListener('DOMContentLoaded', initHotelRatesCard);
  document.addEventListener('astro:page-load', initHotelRatesCard);
</script>
