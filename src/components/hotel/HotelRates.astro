<!-- ================= SLEEK & AIRY RATES CARD ================= -->
<!-- data-* এখন root এ: "Other Options" না থাকলেও script কাজ করবে -->
<div
  id="rates-card"
  data-hotel-title={hotelTitle}
  data-hotel-slug={hotelSlug}
  data-agoda-id={agodaId}
  data-agoda-fallback={agodaFallbackUrl}
  data-currency={apiCurrency}
  class="bg-white rounded-3xl border border-slate-200/90 shadow-xl p-5 sm:p-6 text-left space-y-4 relative"
>

  <!-- ১. মেইন প্রাইস হেডার -->
  <div class="flex items-start justify-between border-b border-slate-100 pb-4">
    <div>
      <span id="agodaLiveIndicator" class="text-[10px] font-bold uppercase tracking-wider text-slate-400 flex items-center gap-1.5 mb-0.5">
        <span>Starting From</span>
      </span>
      <div class="flex items-baseline gap-2">
        <span id="agodaOriginalPrice" class="hidden text-xs text-slate-400 line-through font-semibold"></span>
        <span id="cardStartingPriceDisplay" class="hotel-live-price text-2xl sm:text-3xl font-black text-[#0d3b23] leading-none transition-opacity duration-200">
          {displayStartingPrice}
        </span>
        <span id="cardPerNightText" class="text-xs text-slate-500 font-medium">/ night</span>
      </div>
    </div>

    <div class="text-right">
      <span id="agodaDiscountBadge" class="hidden text-[10px] font-black uppercase text-rose-700 bg-rose-50 border border-rose-200 px-2 py-0.5 rounded-full mb-1">
      </span>
      <span class="inline-flex items-center gap-1 text-[10px] font-bold text-emerald-800 bg-emerald-50 px-2 py-0.5 rounded-md">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
        <span>Best Rates</span>
      </span>
    </div>
  </div>

  <!-- ২. ইন্টারেক্টিভ বুকিং কন্ট্রোলস -->
  <div class="space-y-2">

    <!-- (ক) চেক-ইন / চেক-আউট রেঞ্জ -->
    <div class="relative">
      <button
        type="button"
        id="dateRangeBtn"
        aria-haspopup="dialog"
        aria-expanded="false"
        aria-controls="calendarDropdown"
        class="w-full bg-slate-50 hover:bg-emerald-50/40 border border-slate-200/90 hover:border-emerald-700/60 rounded-xl p-2.5 px-3.5 flex items-center justify-between transition-all text-left group shadow-sm"
      >
        <div class="flex items-center gap-2.5 min-w-0">
          <svg aria-hidden="true" class="w-4 h-4 text-emerald-700 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
          </svg>
          <div class="truncate">
            <span class="block text-[8px] font-bold uppercase tracking-wider text-slate-400">Dates of Stay</span>
            <span id="dateRangeSummaryText" class="font-bold text-xs text-slate-800 block truncate">
              Select dates
            </span>
          </div>
        </div>
        <span id="stayNightsBadge" class="bg-white border border-slate-200 text-emerald-800 text-[10px] font-black px-2 py-0.5 rounded-md shrink-0 shadow-sm">
          1 night
        </span>
      </button>

      <div
        id="calendarDropdown"
        role="dialog"
        aria-label="Choose dates"
        class="hidden absolute left-0 right-0 top-full mt-2 z-50 bg-white border border-slate-200 rounded-2xl shadow-2xl p-4 space-y-3"
      >
        <div class="flex items-center justify-between border-b border-slate-100 pb-2">
          <button type="button" id="prevMonthBtn" class="p-1 hover:bg-slate-100 rounded-lg text-slate-600 transition disabled:opacity-30 disabled:pointer-events-none" aria-label="Previous month">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
          </button>
          <span id="calendarMonthYear" class="font-bold text-xs text-slate-800" aria-live="polite"></span>
          <button type="button" id="nextMonthBtn" class="p-1 hover:bg-slate-100 rounded-lg text-slate-600 transition" aria-label="Next month">
