                  href={c.url}
                  target={isExternal ? "_blank" : "_self"}
                  rel={isExternal ? "sponsored nofollow noopener" : undefined}
                  class="text-[11px] font-bold text-emerald-800 hover:underline"
                >
                  {c.buttonText} →
                </a>
              </div>
            </div>
          );
        })}
      </div>

      {hasContact && (
        <div class={`grid gap-1.5 pt-1 ${cleanPhone && cleanWhatsapp ? 'grid-cols-2' : 'grid-cols-1'}`}>
          {cleanPhone && (
            <a
              href={`tel:${cleanPhone}`}
              class="border border-slate-200 hover:border-[#0d3b23] text-slate-700 hover:text-[#0d3b23] font-bold text-[11px] py-1.5 rounded-lg transition text-center flex items-center justify-center gap-1"
            >
              <span>📞</span> Call Hotel
            </a>
          )}
          {cleanWhatsapp && (
            <a
              href={`https://wa.me/${cleanWhatsapp}?text=${encodeURIComponent(waMessage)}`}
              target="_blank"
              rel="noopener noreferrer"
              class="border border-[#25D366]/40 bg-[#25D366]/5 hover:bg-[#25D366] text-[#0d3b23] hover:text-white font-bold text-[11px] py-1.5 rounded-lg transition text-center flex items-center justify-center gap-1"
            >
              <span>💬</span> WhatsApp
            </a>
          )}
        </div>
      )}
    </div>
  )}

  <p class="text-center text-[9px] leading-tight text-slate-400">
    Partner rates sync live. We may earn a commission at no extra cost to you.
  </p>

</div>

<!-- ================= ULTRA-FAST VANILLA RANGE CALENDAR & GUEST SCRIPT ================= -->
<script>
  let ratesAbortCtrl: AbortController | null = null;
  const ratesMemoryCache = new Map<string, any>();

  // তারিখ ইউটিলিটিজ
  function getDhakaDateString(offsetDays = 0): string {
    const now = new Date();
    const utcMillis = now.getTime() + (now.getTimezoneOffset() * 60000);
    const dhakaTime = new Date(utcMillis + (6 * 3600000));
    dhakaTime.setDate(dhakaTime.getDate() + offsetDays);
    const y = dhakaTime.getFullYear();
    const m = String(dhakaTime.getMonth() + 1).padStart(2, '0');
    const d = String(dhakaTime.getDate()).padStart(2, '0');
    return `${y}-${m}-${d}`;
  }

  function formatShortDate(dateStr: string): string {
    if (!dateStr) return '';
    const [year, month, day] = dateStr.split('-').map(Number);
    const d = new Date(year, month - 1, day);
    const months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
    return `${months[d.getMonth()]} ${d.getDate()}`;
  }

  function calculateNights(inStr: string, outStr: string): number {
    const [y1, m1, d1] = inStr.split('-').map(Number);
    const [y2, m2, d2] = outStr.split('-').map(Number);
    const date1 = Date.UTC(y1, m1 - 1, d1);
    const date2 = Date.UTC(y2, m2 - 1, d2);
    const diff = Math.round((date2 - date1) / 86400000);
    return diff > 0 ? diff : 1;
  }

  function addDays(dateStr: string, days: number): string {
    const [y, m, d] = dateStr.split('-').map(Number);
    const date = new Date(y, m - 1, d + days);
    const pad = (n: number) => String(n).padStart(2, '0');
    return `${date.getFullYear()}-${pad(date.getMonth() + 1)}-${pad(date.getDate())}`;
  }

  async function initHotelRatesCard() {
    const ratesContainer = document.getElementById('aboutRatesTableContainer');
    const startingPriceEl = document.getElementById('cardStartingPriceDisplay');
    const liveIndicatorEl = document.getElementById('agodaLiveIndicator');
    const agodaOriginalPriceEl = document.getElementById('agodaOriginalPrice');
    const agodaDiscountEl = document.getElementById('agodaDiscountBadge');
    const agodaBtnEl = document.getElementById('agodaRowBtn') as HTMLAnchorElement | null;

    // Date Range UI
    const dateRangeBtn = document.getElementById('dateRangeBtn');
    const dateRangeSummaryText = document.getElementById('dateRangeSummaryText');
    const stayNightsBadge = document.getElementById('stayNightsBadge');
    const calendarDropdown = document.getElementById('calendarDropdown');
    const calendarDaysGrid = document.getElementById('calendarDaysGrid');
    const calendarMonthYear = document.getElementById('calendarMonthYear');
    const prevMonthBtn = document.getElementById('prevMonthBtn');
    const nextMonthBtn = document.getElementById('nextMonthBtn');
    const closeCalBtn = document.getElementById('closeCalBtn');

    // Guests UI
    const guestsBtn = document.getElementById('guestsBtn');
    const guestsDropdown = document.getElementById('guestsDropdown');
    const guestsSummaryText = document.getElementById('guestsSummaryText');
    const closeGuestsBtn = document.getElementById('closeGuestsBtn');

    const adultCountEl = document.getElementById('adultCount');
    const childCountEl = document.getElementById('childCount');
    const roomCountEl = document.getElementById('roomCount');
    const adultMinus = document.getElementById('adultMinus') as HTMLButtonElement | null;
    const adultPlus = document.getElementById('adultPlus') as HTMLButtonElement | null;
    const childMinus = document.getElementById('childMinus') as HTMLButtonElement | null;
    const childPlus = document.getElementById('childPlus') as HTMLButtonElement | null;
    const roomMinus = document.getElementById('roomMinus') as HTMLButtonElement | null;
    const roomPlus = document.getElementById('roomPlus') as HTMLButtonElement | null;

    if (!ratesContainer) return;

    const hotelSlug = (ratesContainer.getAttribute('data-hotel-slug') || '').trim();
    const hotelName = (ratesContainer.getAttribute('data-hotel-title') || '').trim();
    const agodaId = (ratesContainer.getAttribute('data-agoda-id') || '').trim();
    const WORKER_ENDPOINT = "https://gulshanhotels.rmollah394.workers.dev";

    // স্টেট
    let checkIn = getDhakaDateString(0);
    let checkOut = getDhakaDateString(1);
    let calViewDate = new Date();
    let tempCheckIn: string | null = null;

    let adults = 2;
    let children = 0;
    let rooms = 1;

    // ================= ১. রেঞ্জ ক্যালেন্ডার রেন্ডারিং ইঞ্জিন =================
    function renderCalendar() {
      if (!calendarDaysGrid || !calendarMonthYear) return;
      calendarDaysGrid.innerHTML = '';

      const y = calViewDate.getFullYear();
      const m = calViewDate.getMonth();
      const monthNames = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];
      calendarMonthYear.textContent = `${monthNames[m]} ${y}`;

      const firstDay = new Date(y, m, 1).getDay();
      const daysInMonth = new Date(y, m + 1, 0).getDate();
      const todayStr = getDhakaDateString(0);

      // ফাঁকা স্লট
      for (let i = 0; i < firstDay; i++) {
        const empty = document.createElement('div');
        calendarDaysGrid.appendChild(empty);
      }

      // দিনসমূহ
      for (let day = 1; day <= daysInMonth; day++) {
        const pad = (n: number) => String(n).padStart(2, '0');
        const thisDateStr = `${y}-${pad(m + 1)}-${pad(day)}`;
        const isPast = thisDateStr < todayStr;

        const dayBtn = document.createElement('button');
        dayBtn.type = 'button';
        dayBtn.textContent = String(day);
        dayBtn.className = 'h-8 w-8 mx-auto flex items-center justify-center rounded-lg text-xs font-semibold transition';

        if (isPast) {
          dayBtn.className += ' text-slate-300 cursor-not-allowed pointer-events-none';
        } else {
          // সিলেকশন স্টাইল
          const isStart = tempCheckIn ? thisDateStr === tempCheckIn : thisDateStr === checkIn;
          const isEnd = !tempCheckIn && thisDateStr === checkOut;
          const inRange = !tempCheckIn && thisDateStr > checkIn && thisDateStr < checkOut;

          if (isStart || isEnd) {
            dayBtn.className += ' bg-[#0d3b23] text-white font-bold shadow-xs';
          } else if (inRange) {
            dayBtn.className += ' bg-emerald-50 text-emerald-900 rounded-none';
          } else {
            dayBtn.className += ' hover:bg-slate-100 text-slate-700';
          }

          dayBtn.addEventListener('click', () => {
            if (!tempCheckIn) {
              // প্রথম ক্লিক = চেক-ইন
              tempCheckIn = thisDateStr;
              renderCalendar();
            } else {
              // দ্বিতীয় ক্লিক = চেক-আউট
              if (thisDateStr <= tempCheckIn) {
                tempCheckIn = thisDateStr;
                renderCalendar();
              } else {
                checkIn = tempCheckIn;
                checkOut = thisDateStr;
                tempCheckIn = null;
                updateSummary();
                if (calendarDropdown) calendarDropdown.classList.add('hidden');
                fetchLiveRates();
              }
            }
          });
        }

        calendarDaysGrid.appendChild(dayBtn);
      }
    }

    // ================= ২. গেস্ট ও তারিখ সামারি আপডেট =================
    function updateSummary() {
      if (dateRangeSummaryText) {
        dateRangeSummaryText.textContent = `${formatShortDate(checkIn)} — ${formatShortDate(checkOut)}`;
      }
      if (stayNightsBadge) {
        const nights = calculateNights(checkIn, checkOut);
        stayNightsBadge.textContent = `${nights} ${nights === 1 ? 'night' : 'nights'}`;
      }
      if (guestsSummaryText) {
        let text = `${adults} ${adults === 1 ? 'Adult' : 'Adults'}`;
        if (children > 0) text += `, ${children} ${children === 1 ? 'Child' : 'Children'}`;
        text += ` · ${rooms} ${rooms === 1 ? 'Room' : 'Rooms'}`;
        guestsSummaryText.textContent = text;
      }
    }

    // ================= ৩. ক্লাউডফ্লেয়ার আগোডা লাইভ প্রাইস ফেচ =================
    async function fetchLiveRates() {
      const cacheKey = `${hotelSlug || agodaId}_${checkIn}_${checkOut}_${adults}_${rooms}`;
      if (ratesMemoryCache.has(cacheKey)) {
        applyRates(ratesMemoryCache.get(cacheKey));
        return;
      }

      ratesAbortCtrl?.abort();
      ratesAbortCtrl = new AbortController();
      const { signal } = ratesAbortCtrl;

      if (startingPriceEl) startingPriceEl.style.opacity = '0.4';

      const queryParam = agodaId ? `id=${encodeURIComponent(agodaId)}` : `hotel=${encodeURIComponent(hotelSlug || hotelName)}`;
      const apiUrl = `${WORKER_ENDPOINT}?${queryParam}&checkIn=${checkIn}&checkOut=${checkOut}&adults=${adults}&children=${children}&rooms=${rooms}&currency=USD`;

      try {
        const res = await fetch(apiUrl, { signal });
        if (res.ok) {
          const json = await res.json();
          if (json && json.success && json.rates) {
            ratesMemoryCache.set(cacheKey, json.rates);
            applyRates(json.rates);
          }
        }
      } catch (e: any) {
        if (startingPriceEl) startingPriceEl.style.opacity = '1';
      }
    }

    function applyRates(rates: any) {
      const livePriceStr = rates?.startingPrice ? String(rates.startingPrice) : null;
      if (startingPriceEl) {
        if (livePriceStr) startingPriceEl.textContent = livePriceStr;
        startingPriceEl.style.opacity = '1';
      }

      if (agodaOriginalPriceEl) {
        if (rates?.originalPrice) {
          agodaOriginalPriceEl.textContent = rates.originalPrice;
          agodaOriginalPriceEl.classList.remove('hidden');
        } else {
          agodaOriginalPriceEl.classList.add('hidden');
        }
      }

      if (agodaDiscountEl) {
        if (rates?.discountText) {
          agodaDiscountEl.textContent = rates.discountText;
          agodaDiscountEl.classList.remove('hidden');
        } else {
          agodaDiscountEl.classList.add('hidden');
        }
      }

      if (liveIndicatorEl) {
        liveIndicatorEl.innerHTML = `
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
          <span class="text-emerald-700 font-bold">Live Agoda Price</span>
        `;
      }

      // বুকিং বাটন লিংক আপডেট (তারিখ ও গেস্ট সংখ্যা সহ সরাসরি আগোডায় যাবে)
      const agodaDeal = Array.isArray(rates?.channelsList) ? rates.channelsList[0] : null;
      if (agodaBtnEl && agodaDeal?.button_url) {
        try {
          const urlObj = new URL(agodaDeal.button_url);
          urlObj.searchParams.set('checkin', checkIn);
          urlObj.searchParams.set('checkout', checkOut);
          urlObj.searchParams.set('adults', String(adults));
          urlObj.searchParams.set('children', String(children));
          urlObj.searchParams.set('rooms', String(rooms));
          agodaBtnEl.href = urlObj.toString();
        } catch {
          agodaBtnEl.href = agodaDeal.button_url;
        }
      }

      if (livePriceStr) {
        document.querySelectorAll('.hotel-live-price, [data-hotel-live-price]').forEach((el) => {
          el.textContent = livePriceStr;
        });
      }
    }

    // ================= ৪. ইভেন্ট লিসেনার্স =================
    // ক্যালেন্ডার ওপেন / ক্লোজ
    dateRangeBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      guestsDropdown?.classList.add('hidden');
      calendarDropdown?.classList.toggle('hidden');
      tempCheckIn = null;
      renderCalendar();
    });

    prevMonthBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      calViewDate.setMonth(calViewDate.getMonth() - 1);
      renderCalendar();
    });

    nextMonthBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      calViewDate.setMonth(calViewDate.getMonth() + 1);
      renderCalendar();
    });

    closeCalBtn?.addEventListener('click', () => {
      calendarDropdown?.classList.add('hidden');
    });

    // গেস্ট ড্রপডাউন ওপেন / ক্লোজ
    guestsBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      calendarDropdown?.classList.add('hidden');
      guestsDropdown?.classList.toggle('hidden');
    });

    closeGuestsBtn?.addEventListener('click', () => {
      guestsDropdown?.classList.add('hidden');
      updateSummary();
      fetchLiveRates();
    });

    // গেস্ট +/- বাটনস
    adultPlus?.addEventListener('click', () => {
      if (adults < 8) { adults++; if (adultCountEl) adultCountEl.textContent = String(adults); }
      if (adultMinus) adultMinus.disabled = adults <= 1;
    });
    adultMinus?.addEventListener('click', () => {
      if (adults > 1) { adults--; if (adultCountEl) adultCountEl.textContent = String(adults); }
      if (adultMinus) adultMinus.disabled = adults <= 1;
    });

    childPlus?.addEventListener('click', () => {
      if (children < 6) { children++; if (childCountEl) childCountEl.textContent = String(children); }
      if (childMinus) childMinus.disabled = children <= 0;
    });
    childMinus?.addEventListener('click', () => {
      if (children > 0) { children--; if (childCountEl) childCountEl.textContent = String(children); }
      if (childMinus) childMinus.disabled = children <= 0;
    });

    roomPlus?.addEventListener('click', () => {
      if (rooms < 5) { rooms++; if (roomCountEl) roomCountEl.textContent = String(rooms); }
      if (roomMinus) roomMinus.disabled = rooms <= 1;
    });
    roomMinus?.addEventListener('click', () => {
      if (rooms > 1) { rooms--; if (roomCountEl) roomCountEl.textContent = String(rooms); }
      if (roomMinus) roomMinus.disabled = rooms <= 1;
    });

    // বাইরে ক্লিক করলে পপআপ ক্লোজ
    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (!calendarDropdown?.contains(target) && !dateRangeBtn?.contains(target)) {
        calendarDropdown?.classList.add('hidden');
      }
      if (!guestsDropdown?.contains(target) && !guestsBtn?.contains(target)) {
        guestsDropdown?.classList.add('hidden');
      }
    });

    // ইনিশিয়াল কল
    updateSummary();
    fetchLiveRates();
  }

  document.addEventListener('astro:before-swap', () => {
    ratesAbortCtrl?.abort();
  });

  document.addEventListener('DOMContentLoaded', initHotelRatesCard);
  document.addEventListener('astro:page-load', initHotelRatesCard);
</script>
