    <a
      id="agodaRowBtn"
      href="#"
      target="_blank"
      rel="sponsored nofollow noopener"
      class="w-full bg-[#0d3b23] hover:bg-[#124e30] text-white font-bold text-xs sm:text-sm py-3 rounded-xl transition shadow-md hover:shadow-lg flex items-center justify-center gap-2 active:scale-98"
