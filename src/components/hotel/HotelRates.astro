        <div class="grid grid-cols-7 text-center text-[10px] font-bold text-slate-400">
          <span>Su</span><span>Mo</span><span>Tu</span><span>We</span><span>Th</span><span>Fr</span><span>Sa</span>
        </div>

        <div id="calendarDaysGrid" class="grid grid-cols-7 gap-y-1 text-center text-xs"></div>

        <div class="flex items-center justify-between pt-2 border-t border-slate-100 text-[10px]">
          <span id="calendarHint" class="text-slate-400">Click Check-in, then Check-out</span>
          <button type="button" id="closeCalBtn" class="text-emerald-800 font-bold hover:underline">Close</button>
        </div>
      </div>
    </div>

    <!-- (খ) গেস্ট ও রুম -->
    <div class="relative">
      <button
        type="button"
        id="guestsBtn"
        aria-haspopup="dialog"
        aria-expanded="false"
        aria-controls="guestsDropdown"
        class="w-full bg-slate-50 hover:bg-emerald-50/40 border border-slate-200/90 hover:border-emerald-700/60 rounded-xl p-2.5 px-3.5 flex items-center justify-between transition-all text-left shadow-sm"
      >
        <div class="flex items-center gap-2.5">
          <svg aria-hidden="true" class="w-4 h-4 text-emerald-700 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
          </svg>
          <div>
            <span class="block text-[8px] font-bold uppercase tracking-wider text-slate-400">Occupancy</span>
            <span id="guestsSummaryText" class="font-bold text-xs text-slate-800 block">2 Adults · 1 Room</span>
          </div>
        </div>
        <span class="text-slate-400 text-xs" aria-hidden="true">▾</span>
      </button>

      <div
        id="guestsDropdown"
        role="dialog"
        aria-label="Choose guests and rooms"
        class="hidden absolute left-0 right-0 top-full mt-2 z-50 bg-white border border-slate-200 rounded-2xl shadow-2xl p-4 space-y-3 text-xs"
      >
        <div class="flex items-center justify-between">
          <div>
            <span class="font-bold text-slate-800 block leading-tight">Adults</span>
            <span class="text-[10px] text-slate-400">Ages 18+</span>
          </div>
          <div class="flex items-center gap-2.5">
            <button type="button" id="adultMinus" aria-label="Decrease adults" class="w-7 h-7 rounded-full border border-slate-200 hover:border-emerald-700 flex items-center justify-center font-black text-slate-600 transition disabled:opacity-30 disabled:pointer-events-none">−</button>
            <span id="adultCount" class="font-bold w-4 text-center">2</span>
            <button type="button" id="adultPlus" aria-label="Increase adults" class="w-7 h-7 rounded-full border border-slate-200 hover:border-emerald-700 flex items-center justify-center font-black text-slate-600 transition disabled:opacity-30 disabled:pointer-events-none">+</button>
          </div>
        </div>

        <div class="flex items-center justify-between border-t border-slate-100 pt-2">
          <div>
            <span class="font-bold text-slate-800 block leading-tight">Children</span>
            <span class="text-[10px] text-slate-400">Ages 0–17</span>
          </div>
          <div class="flex items-center gap-2.5">
            <button type="button" id="childMinus" aria-label="Decrease children" class="w-7 h-7 rounded-full border border-slate-200 hover:border-emerald-700 flex items-center justify-center font-black text-slate-600 transition disabled:opacity-30 disabled:pointer-events-none">−</button>
            <span id="childCount" class="font-bold w-4 text-center">0</span>
            <button type="button" id="childPlus" aria-label="Increase children" class="w-7 h-7 rounded-full border border-slate-200 hover:border-emerald-700 flex items-center justify-center font-black text-slate-600 transition disabled:opacity-30 disabled:pointer-events-none">+</button>
          </div>
        </div>

        <div class="flex items-center justify-between border-t border-slate-100 pt-2">
          <div>
            <span class="font-bold text-slate-800 block leading-tight">Rooms</span>
            <span class="text-[10px] text-slate-400">Total room count</span>
          </div>
          <div class="flex items-center gap-2.5">
            <button type="button" id="roomMinus" aria-label="Decrease rooms" class="w-7 h-7 rounded-full border border-slate-200 hover:border-emerald-700 flex items-center justify-center font-black text-slate-600 transition disabled:opacity-30 disabled:pointer-events-none">−</button>
            <span id="roomCount" class="font-bold w-4 text-center">1</span>
            <button type="button" id="roomPlus" aria-label="Increase rooms" class="w-7 h-7 rounded-full border border-slate-200 hover:border-emerald-700 flex items-center justify-center font-black text-slate-600 transition disabled:opacity-30 disabled:pointer-events-none">+</button>
          </div>
        </div>

        <button type="button" id="closeGuestsBtn" class="w-full bg-[#0d3b23] text-white font-bold py-1.5 rounded-lg text-xs mt-1 hover:bg-[#124e30] transition">
          Apply
        </button>
      </div>
    </div>

  </div>

  <!-- ৩. মেইন বুকিং বাটন -->
  <div>
    <a
      id="agodaRowBtn"
      href={agodaFallbackUrl}
      target="_blank"
      rel="sponsored nofollow noopener noreferrer"
      class="w-full bg-[#0d3b23] hover:bg-[#124e30] text-white font-bold text-xs sm:text-sm py-3 rounded-xl transition shadow-md hover:shadow-lg flex items-center justify-center gap-2 active:scale-[0.98]"
    >
      <span>Book Deal on Agoda</span>
      <svg class="w-3.5 h-3.5 stroke-current fill-none stroke-2" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
      </svg>
    </a>
  </div>

  <!-- ৪. সেকেন্ডারি বুকিং চ্যানেল ও ডিরেক্ট যোগাযোগ -->
  {(channels.length > 0 || hasContact) && (
    <div class="pt-3 border-t border-slate-100 space-y-2">
      <span class="text-[9px] font-bold text-slate-400 uppercase tracking-wider block text-center">
        Other Options
      </span>

      <div id="aboutRatesTableContainer" class="space-y-1.5">
        {channels.map((c) => {
          const isExternal = c.url.startsWith('http');
          return (
            <div class="flex items-center justify-between p-2 rounded-lg bg-slate-50 border border-slate-100 text-xs">
              <div class="flex items-center gap-2 min-w-0">
                <Fragment set:html={presetSvgs[c.iconPreset] || presetSvgs.direct} />
                <span class="font-bold text-slate-800 truncate">{c.providerName}</span>
              </div>
              <div class="flex items-center gap-2">
                {c.showPrice && c.price && <span class="font-extrabold text-slate-900">{c.price}</span>}
                <a
                  href={c.url}
                  target={isExternal ? "_blank" : "_self"}
                  rel={isExternal ? "sponsored nofollow noopener noreferrer" : undefined}
                  class="text-[11px] font-bold text-emerald-800 hover:underline"
                >
                  {c.buttonText} →
                </a>
              </div>
            </div>
          );
        })}
      </div>

      {hasContact && (
        <div class={`grid gap-1.5 pt-1 ${cleanPhone && cleanWhatsapp ? 'grid-cols-2' : 'grid-cols-1'}`}>
          {cleanPhone && (
            <a
              href={`tel:${cleanPhone}`}
              class="border border-slate-200 hover:border-[#0d3b23] text-slate-700 hover:text-[#0d3b23] font-bold text-[11px] py-1.5 rounded-lg transition text-center flex items-center justify-center gap-1"
            >
              <span aria-hidden="true">📞</span> Call Hotel
            </a>
          )}
          {cleanWhatsapp && (
            <a
              href={`https://wa.me/${cleanWhatsapp}?text=${encodeURIComponent(waMessage)}`}
              target="_blank"
              rel="noopener noreferrer"
              class="border border-[#25D366]/40 bg-[#25D366]/5 hover:bg-[#25D366] text-[#0d3b23] hover:text-white font-bold text-[11px] py-1.5 rounded-lg transition text-center flex items-center justify-center gap-1"
            >
              <span aria-hidden="true">💬</span> WhatsApp
            </a>
          )}
        </div>
      )}
    </div>
  )}

  <p class="text-center text-[9px] leading-tight text-slate-400">
    Partner rates sync live. We may earn a commission at no extra cost to you.
  </p>

</div>

<!-- ================= VANILLA RANGE CALENDAR & GUEST SCRIPT ================= -->
<script>
  let ratesAbortCtrl: AbortController | null = null;   // fetch cancel
  let listenersCtrl: AbortController | null = null;    // document-level listeners cleanup
  const ratesMemoryCache = new Map<string, any>();

  const WORKER_ENDPOINT = "https://gulshanhotels.rmollah394.workers.dev";
  const MONTH_NAMES = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];
  const MONTH_SHORT = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
  const pad = (n: number) => String(n).padStart(2, '0');

  // ---------- তারিখ ইউটিলিটিজ ----------
  function addDays(dateStr: string, days: number): string {
    const [y, m, d] = dateStr.split('-').map(Number);
    const date = new Date(y, m - 1, d + days);
    return `${date.getFullYear()}-${pad(date.getMonth() + 1)}-${pad(date.getDate())}`;
  }

  // Dhaka এর আজকের তারিখ (Intl দিয়ে, manual offset ছাড়া)
  function getDhakaDateString(offsetDays = 0): string {
    const base = new Intl.DateTimeFormat('en-CA', {
      timeZone: 'Asia/Dhaka',
      year: 'numeric',
      month: '2-digit',
      day: '2-digit',
    }).format(new Date()); // YYYY-MM-DD
    return offsetDays === 0 ? base : addDays(base, offsetDays);
  }

  function formatShortDate(dateStr: string): string {
    if (!dateStr) return '';
    const [, month, day] = dateStr.split('-').map(Number);
    return `${MONTH_SHORT[month - 1]} ${day}`;
  }

  function calculateNights(inStr: string, outStr: string): number {
    const [y1, m1, d1] = inStr.split('-').map(Number);
    const [y2, m2, d2] = outStr.split('-').map(Number);
    const diff = Math.round((Date.UTC(y2, m2 - 1, d2) - Date.UTC(y1, m1 - 1, d1)) / 86400000);
    return Math.max(diff, 1);
  }

  function initHotelRatesCard() {
    // আগের init এর document-level listener গুলো পরিষ্কার করো (duplicate/leak বন্ধ)
    listenersCtrl?.abort();
    listenersCtrl = new AbortController();
    const { signal: lsig } = listenersCtrl;

    const card = document.getElementById('rates-card');
    if (!card) return;

    const startingPriceEl = document.getElementById('cardStartingPriceDisplay');
    const liveIndicatorEl = document.getElementById('agodaLiveIndicator');
    const agodaOriginalPriceEl = document.getElementById('agodaOriginalPrice');
    const agodaDiscountEl = document.getElementById('agodaDiscountBadge');
    const agodaBtnEl = document.getElementById('agodaRowBtn') as HTMLAnchorElement | null;

    const dateRangeBtn = document.getElementById('dateRangeBtn');
    const dateRangeSummaryText = document.getElementById('dateRangeSummaryText');
    const stayNightsBadge = document.getElementById('stayNightsBadge');
    const calendarDropdown = document.getElementById('calendarDropdown');
    const calendarDaysGrid = document.getElementById('calendarDaysGrid');
    const calendarMonthYear = document.getElementById('calendarMonthYear');
    const calendarHint = document.getElementById('calendarHint');
    const prevMonthBtn = document.getElementById('prevMonthBtn') as HTMLButtonElement | null;
    const nextMonthBtn = document.getElementById('nextMonthBtn');
    const closeCalBtn = document.getElementById('closeCalBtn');

    const guestsBtn = document.getElementById('guestsBtn');
    const guestsDropdown = document.getElementById('guestsDropdown');
    const guestsSummaryText = document.getElementById('guestsSummaryText');
    const closeGuestsBtn = document.getElementById('closeGuestsBtn');

    const adultCountEl = document.getElementById('adultCount');
    const childCountEl = document.getElementById('childCount');
    const roomCountEl = document.getElementById('roomCount');
    const adultMinus = document.getElementById('adultMinus') as HTMLButtonElement | null;
    const adultPlus = document.getElementById('adultPlus') as HTMLButtonElement | null;
    const childMinus = document.getElementById('childMinus') as HTMLButtonElement | null;
    const childPlus = document.getElementById('childPlus') as HTMLButtonElement | null;
    const roomMinus = document.getElementById('roomMinus') as HTMLButtonElement | null;
    const roomPlus = document.getElementById('roomPlus') as HTMLButtonElement | null;

    const hotelSlug = (card.getAttribute('data-hotel-slug') || '').trim();
    const hotelName = (card.getAttribute('data-hotel-title') || '').trim();
    const agodaId = (card.getAttribute('data-agoda-id') || '').trim();
    const apiCurrency = (card.getAttribute('data-currency') || 'USD').trim();
    const agodaFallback = (card.getAttribute('data-agoda-fallback') || '').trim();

    // ---------- স্টেট ----------
    const MAX_ADULTS = 8, MAX_CHILDREN = 6, MAX_ROOMS = 5;
    let checkIn = getDhakaDateString(0);
    let checkOut = getDhakaDateString(1);
    let tempCheckIn: string | null = null;
    let adults = 2, children = 0, rooms = 1;
    let agodaBaseUrl = agodaFallback && agodaFallback !== '#' ? agodaFallback : '';

    // ক্যালেন্ডার ভিউ: মাসের ১ তারিখ ধরে (setMonth overflow bug এড়াতে year/month আলাদা)
    let calYear = Number(checkIn.slice(0, 4));
    let calMonth = Number(checkIn.slice(5, 7)) - 1;

    // ---------- Dropdown open/close + aria ----------
    function setOpen(dd: HTMLElement | null, btn: HTMLElement | null, open: boolean) {
      if (!dd) return;
      dd.classList.toggle('hidden', !open);
      btn?.setAttribute('aria-expanded', String(open));
    }
    function closeCalendar() {
      setOpen(calendarDropdown, dateRangeBtn, false);
      tempCheckIn = null; // stale state বন্ধ
    }
    function closeGuests() {
      setOpen(guestsDropdown, guestsBtn, false);
    }

    // ---------- Agoda লিংক আপডেট ----------
    function updateAgodaLink() {
      if (!agodaBtnEl || !agodaBaseUrl) return;
      try {
        const urlObj = new URL(agodaBaseUrl);
        urlObj.searchParams.set('checkin', checkIn);
        urlObj.searchParams.set('checkout', checkOut);
        urlObj.searchParams.set('adults', String(adults));
        urlObj.searchParams.set('children', String(children));
        urlObj.searchParams.set('rooms', String(rooms));
        agodaBtnEl.href = urlObj.toString();
      } catch {
        agodaBtnEl.href = agodaBaseUrl;
      }
    }

    // ---------- ১. ক্যালেন্ডার ----------
    function renderCalendar() {
      if (!calendarDaysGrid || !calendarMonthYear) return;
      calendarDaysGrid.innerHTML = '';
      calendarMonthYear.textContent = `${MONTH_NAMES[calMonth]} ${calYear}`;

      const todayStr = getDhakaDateString(0);
      const todayY = Number(todayStr.slice(0, 4));
      const todayM = Number(todayStr.slice(5, 7)) - 1;
      if (prevMonthBtn) prevMonthBtn.disabled = calYear < todayY || (calYear === todayY && calMonth <= todayM);

      if (calendarHint) {
        calendarHint.textContent = tempCheckIn ? 'Now choose Check-out' : 'Click Check-in, then Check-out';
      }

      const firstDay = new Date(calYear, calMonth, 1).getDay();
      const daysInMonth = new Date(calYear, calMonth + 1, 0).getDate();

      for (let i = 0; i < firstDay; i++) calendarDaysGrid.appendChild(document.createElement('div'));

      for (let day = 1; day <= daysInMonth; day++) {
        const thisDateStr = `${calYear}-${pad(calMonth + 1)}-${pad(day)}`;
        const isPast = thisDateStr < todayStr;

        const dayBtn = document.createElement('button');
        dayBtn.type = 'button';
        dayBtn.textContent = String(day);
        dayBtn.className = 'h-8 w-8 mx-auto flex items-center justify-center rounded-lg text-xs font-semibold transition';

        if (isPast) {
          dayBtn.disabled = true;
          dayBtn.className += ' text-slate-300 cursor-not-allowed pointer-events-none';
        } else {
          const isStart = tempCheckIn ? thisDateStr === tempCheckIn : thisDateStr === checkIn;
          const isEnd = !tempCheckIn && thisDateStr === checkOut;
          const inRange = !tempCheckIn && thisDateStr > checkIn && thisDateStr < checkOut;

          if (isStart || isEnd) {
            dayBtn.className += ' bg-[#0d3b23] text-white font-bold shadow-sm';
            dayBtn.setAttribute('aria-pressed', 'true');
          } else if (inRange) {
            dayBtn.className += ' bg-emerald-50 text-emerald-900 rounded-none';
          } else {
            dayBtn.className += ' hover:bg-slate-100 text-slate-700';
          }

          dayBtn.addEventListener('click', () => {
            if (!tempCheckIn) {
              tempCheckIn = thisDateStr; // প্রথম ক্লিক = চেক-ইন
              renderCalendar();
            } else if (thisDateStr <= tempCheckIn) {
              tempCheckIn = thisDateStr; // আগের/একই দিন = চেক-ইন নতুন করে
              renderCalendar();
            } else {
              checkIn = tempCheckIn; // দ্বিতীয় ক্লিক = চেক-আউট
              checkOut = thisDateStr;
              closeCalendar();
              updateSummary();
              updateAgodaLink();
              fetchLiveRates();
            }
          });
        }
        calendarDaysGrid.appendChild(dayBtn);
      }
    }

    // ---------- ২. সামারি + গেস্ট UI ----------
    function syncGuestUI() {
      if (adultCountEl) adultCountEl.textContent = String(adults);
      if (childCountEl) childCountEl.textContent = String(children);
      if (roomCountEl) roomCountEl.textContent = String(rooms);

      // rooms <= adults নিয়ম: adults কখনো rooms এর নিচে যাবে না
      if (adultMinus) adultMinus.disabled = adults <= Math.max(1, rooms);
      if (adultPlus) adultPlus.disabled = adults >= MAX_ADULTS;
      if (childMinus) childMinus.disabled = children <= 0;
      if (childPlus) childPlus.disabled = children >= MAX_CHILDREN;
      if (roomMinus) roomMinus.disabled = rooms <= 1;
      if (roomPlus) roomPlus.disabled = rooms >= MAX_ROOMS;
    }

    function updateSummary() {
      if (dateRangeSummaryText) {
        dateRangeSummaryText.textContent = `${formatShortDate(checkIn)} — ${formatShortDate(checkOut)}`;
      }
      if (stayNightsBadge) {
        const nights = calculateNights(checkIn, checkOut);
        stayNightsBadge.textContent = `${nights} ${nights === 1 ? 'night' : 'nights'}`;
      }
      if (guestsSummaryText) {
        let text = `${adults} ${adults === 1 ? 'Adult' : 'Adults'}`;
        if (children > 0) text += `, ${children} ${children === 1 ? 'Child' : 'Children'}`;
        text += ` · ${rooms} ${rooms === 1 ? 'Room' : 'Rooms'}`;
        guestsSummaryText.textContent = text;
      }
      syncGuestUI();
    }

    // ---------- ৩. লাইভ প্রাইস ফেচ ----------
    async function fetchLiveRates() {
      const cacheKey = `${hotelSlug || agodaId}_${checkIn}_${checkOut}_${adults}_${children}_${rooms}_${apiCurrency}`;
      if (ratesMemoryCache.has(cacheKey)) {
        applyRates(ratesMemoryCache.get(cacheKey));
        return;
      }

      ratesAbortCtrl?.abort();
      const ctrl = new AbortController();
      ratesAbortCtrl = ctrl;
      const { signal } = ctrl;

      if (startingPriceEl) startingPriceEl.style.opacity = '0.4';

      const queryParam = agodaId
        ? `id=${encodeURIComponent(agodaId)}`
        : `hotel=${encodeURIComponent(hotelSlug || hotelName)}`;
      const apiUrl =
        `${WORKER_ENDPOINT}?${queryParam}&checkIn=${checkIn}&checkOut=${checkOut}` +
        `&adults=${adults}&children=${children}&rooms=${rooms}&currency=${encodeURIComponent(apiCurrency)}`;

      try {
        const res = await fetch(apiUrl, { signal });
        if (!res.ok) {
          console.warn('[HotelRates] worker responded', res.status);
          return;
        }
        const json = await res.json();
        if (json && json.success && json.rates) {
          ratesMemoryCache.set(cacheKey, json.rates);
          applyRates(json.rates);
        } else {
          console.warn('[HotelRates] no rates in response');
        }
      } catch (e: any) {
        if (e?.name === 'AbortError') return; // নতুন request চলছে, কিছু করার নেই
        console.warn('[HotelRates] fetch failed', e);
      } finally {
        // abort না হলে (success/fail যাই হোক) opacity ফিরিয়ে দাও
        if (!signal.aborted && startingPriceEl) startingPriceEl.style.opacity = '1';
      }
    }

    function applyRates(rates: any) {
      const livePriceStr = rates?.startingPrice ? String(rates.startingPrice) : null;
      if (startingPriceEl) {
        if (livePriceStr) startingPriceEl.textContent = livePriceStr;
        startingPriceEl.style.opacity = '1';
      }

      if (agodaOriginalPriceEl) {
        if (rates?.originalPrice) {
          agodaOriginalPriceEl.textContent = rates.originalPrice;
          agodaOriginalPriceEl.classList.remove('hidden');
        } else {
          agodaOriginalPriceEl.classList.add('hidden');
        }
      }

      if (agodaDiscountEl) {
        if (rates?.discountText) {
          agodaDiscountEl.textContent = rates.discountText;
          agodaDiscountEl.classList.remove('hidden');
        } else {
          agodaDiscountEl.classList.add('hidden');
        }
      }

      if (liveIndicatorEl && livePriceStr) {
        liveIndicatorEl.innerHTML =
          '<span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>' +
          '<span class="text-emerald-700 font-bold">Live Agoda Price</span>';
      }

      // [0] ধরে নেওয়া নয়: নাম/URL দেখে Agoda deal খুঁজে বের করো
      const list: any[] = Array.isArray(rates?.channelsList) ? rates.channelsList : [];
      const agodaDeal = list.find((c) => {
        const name = String(c?.provider_name || c?.providerName || c?.name || '');
        const url = String(c?.button_url || '');
        return /agoda/i.test(name) || /agoda\.com/i.test(url);
      });
      if (agodaDeal?.button_url) agodaBaseUrl = String(agodaDeal.button_url);
      updateAgodaLink();

      if (livePriceStr) {
        document.querySelectorAll('.hotel-live-price, [data-hotel-live-price]').forEach((el) => {
          el.textContent = livePriceStr;
        });
      }
    }

    // ---------- ৪. ইভেন্ট লিসেনার্স ----------
    dateRangeBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      closeGuests();
      const willOpen = calendarDropdown?.classList.contains('hidden') ?? false;
      tempCheckIn = null;
      if (willOpen) {
        calYear = Number(checkIn.slice(0, 4));
        calMonth = Number(checkIn.slice(5, 7)) - 1;
        renderCalendar();
      }
      setOpen(calendarDropdown, dateRangeBtn, willOpen);
    });

    prevMonthBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      if (prevMonthBtn.disabled) return;
      calMonth--;
      if (calMonth < 0) { calMonth = 11; calYear--; }
      renderCalendar();
    });

    nextMonthBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      calMonth++;
      if (calMonth > 11) { calMonth = 0; calYear++; }
      renderCalendar();
    });

    closeCalBtn?.addEventListener('click', closeCalendar);

    guestsBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      closeCalendar();
      const willOpen = guestsDropdown?.classList.contains('hidden') ?? false;
      setOpen(guestsDropdown, guestsBtn, willOpen);
    });

    closeGuestsBtn?.addEventListener('click', () => {
      closeGuests();
      updateSummary();
      updateAgodaLink();
      fetchLiveRates();
    });

    adultPlus?.addEventListener('click', () => {
      if (adults < MAX_ADULTS) adults++;
      updateSummary();
    });
    adultMinus?.addEventListener('click', () => {
      if (adults > Math.max(1, rooms)) adults--;
      updateSummary();
    });

    childPlus?.addEventListener('click', () => {
      if (children < MAX_CHILDREN) children++;
      updateSummary();
    });
    childMinus?.addEventListener('click', () => {
      if (children > 0) children--;
      updateSummary();
    });

    roomPlus?.addEventListener('click', () => {
      if (rooms < MAX_ROOMS) {
        rooms++;
        if (adults < rooms) adults = rooms; // প্রতি রুমে অন্তত ১ adult
      }
      updateSummary();
    });
    roomMinus?.addEventListener('click', () => {
      if (rooms > 1) rooms--;
      updateSummary();
    });

    // Document-level listeners: signal দিয়ে বাঁধা, তাই পরের init এ নিজে থেকেই remove হবে
    document.addEventListener('click', (e) => {
      const target = e.target as Node;
      if (!calendarDropdown?.contains(target) && !dateRangeBtn?.contains(target)) {
        if (!calendarDropdown?.classList.contains('hidden')) closeCalendar();
      }
      if (!guestsDropdown?.contains(target) && !guestsBtn?.contains(target)) {
        closeGuests();
      }
    }, { signal: lsig });

    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape') return;
      if (!calendarDropdown?.classList.contains('hidden')) { closeCalendar(); dateRangeBtn?.focus(); }
      if (!guestsDropdown?.classList.contains('hidden')) { closeGuests(); guestsBtn?.focus(); }
    }, { signal: lsig });

    // ইনিশিয়াল
    updateSummary();
    updateAgodaLink();
    fetchLiveRates();
  }

  // শুধু astro:page-load: প্রথম লোড + প্রতিটি navigation এ একবারই চলে
  document.addEventListener('astro:page-load', initHotelRatesCard);

  document.addEventListener('astro:before-swap', () => {
    ratesAbortCtrl?.abort();
    listenersCtrl?.abort();
  });
</script>
