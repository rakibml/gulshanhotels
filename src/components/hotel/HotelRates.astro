// src/components/hotel/HotelRates.astro (Lightweight, Clean & Modern Rates Card)
interface Props {
  hotel: any;
}

const { hotel } = Astro.props;
const data = hotel?.data || {};

const hotelTitle = String(data.title || data.name || "").trim();
const rawSlug = String(data.slug || hotel?.slug || hotel?.id || "").trim();
const hotelSlug = rawSlug.replace(/\.(md|mdx)$/, '').split('/').pop()?.toLowerCase() || "";
const agodaId = String(data.agoda_id || data.agodaId || "").trim();

const whatsapp = String(data.whatsapp || "");
const phone = String(data.phone || "");

let cleanWhatsapp = whatsapp.replace(/[^0-9]/g, '');
if (cleanWhatsapp.startsWith('01')) cleanWhatsapp = '88' + cleanWhatsapp;
const cleanPhone = phone.replace(/[^0-9+]/g, '');
const hasContact = Boolean(cleanPhone || cleanWhatsapp);
const waMessage = 'Hi! I want to book a room at ' + hotelTitle;

const customChannels: any[] = Array.isArray(data.booking_channels) ? data.booking_channels : [];

function detectCurrency(v: any): string | null {
  const s = String(v || "");
  if (s.includes('$')) return '$';
  if (s.includes('৳')) return '৳';
  return null;
}

const rawBasePrice = String(data.price || "").trim();
const mainCurrency =
  detectCurrency(rawBasePrice) ||
  customChannels.map((c) => detectCurrency(c?.price)).find(Boolean) ||
  '$';

function formatPrice(p: any): string {
  const s = String(p || "").trim();
  if (!s) return "";
  return detectCurrency(s) ? s : mainCurrency + s;
}

function extractNumericPrice(val: any): number | null {
  if (!val) return null;
  const str = String(val).replace(/,/g, '').trim();
  const match = str.match(/(\d+(?:\.\d+)?)/);
  return match ? parseFloat(match[1]) : null;
}

function safeUrl(u: string) {
  const v = String(u || "").trim();
  return /^(https?:|tel:|mailto:)/i.test(v) ? v : "#";
}

function sanitizeLink(rawUrl: any = "", preset: string = "", pName: string = "", hName: string = "") {
  const url = String(rawUrl || "").trim();
  if (!url || url === "#") return "#";
  const lowerName = String(pName).toLowerCase();
  const isPhone = preset === 'phone' || lowerName.includes('call');
  const isWhatsapp = preset === 'whatsapp' || lowerName.includes('whatsapp');

  if (isPhone && !/^(https?:|tel:)/i.test(url)) {
    const p = url.replace(/[^0-9+]/g, '');
    return p ? `tel:${p}` : "#";
  }
  if ((isWhatsapp || /^[0-9+\s\-()]+$/.test(url)) && !/^https?:/i.test(url)) {
    let digits = url.replace(/[^0-9]/g, '');
    if (!digits) return "#";
    if (digits.startsWith('01')) digits = '88' + digits;
    return `https://wa.me/${digits}?text=${encodeURIComponent('Hi! I want to book a room at ' + hName)}`;
  }
  if (!/^(https?:|tel:|mailto:)/i.test(url)) return safeUrl(`https://${url}`);
  return safeUrl(url);
}

function cleanSvgSSR(svg: string): string {
  return String(svg || '')
    .replace(/<script[\s\S]*?<\/script>/gi, '')
    .replace(/<foreignObject[\s\S]*?<\/foreignObject>/gi, '')
    .replace(/\son\w+\s*=\s*("[^"]*"|'[^']*'|[^\s>]+)/gi, '')
    .replace(/javascript:/gi, '');
}

const channels = customChannels
  .map((item: any) => {
    const providerName = String(item?.provider_name || "Booking Partner");
    const iconPreset = String(item?.icon_preset || "direct");
    const showPrice = item?.show_price !== false && item?.showPrice !== false;
    const customSvg = item?.custom_svg ? cleanSvgSSR(item.custom_svg) : "";
    return {
      providerName,
      iconPreset,
      customSvg,
      showPrice,
      rawPrice: item?.price,
      price: formatPrice(item?.price),
      buttonText: String(item?.button_text || "Book Now"),
      url: sanitizeLink(item?.button_url, iconPreset, providerName, hotelTitle),
    };
  })
  .filter((c) => c.url !== "#");

let lowestNumericPrice = Infinity;
const baseNum = extractNumericPrice(rawBasePrice);
if (baseNum !== null && baseNum > 0) lowestNumericPrice = baseNum;

channels.forEach((c) => {
  if (!c.showPrice) return;
  const n = extractNumericPrice(c.rawPrice);
  const cur = detectCurrency(c.rawPrice) ?? mainCurrency;
  if (n !== null && n > 0 && cur === mainCurrency && n < lowestNumericPrice) {
    lowestNumericPrice = n;
  }
});

const displayStartingPrice =
  lowestNumericPrice !== Infinity
    ? `${mainCurrency}${lowestNumericPrice.toLocaleString('en-US')}`
    : (formatPrice(rawBasePrice) || "Check Rates");

const presetSvgs: Record<string, string> = {
  agoda: `<div class="w-6 h-6 rounded-md bg-[#1d3557] text-white font-bold text-[8px] flex items-center justify-center shrink-0">agoda</div>`,
  booking: `<div class="w-6 h-6 rounded-md bg-[#003580] text-white font-bold text-[10px] flex items-center justify-center shrink-0">B.</div>`,
  tripadvisor: `<div class="w-6 h-6 rounded-md bg-[#00af87] text-white flex items-center justify-center shrink-0"><svg class="w-3.5 h-3.5 fill-white" viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zm-4.5-9a2.5 2.5 0 100 5 2.5 2.5 0 000-5zm9 0a2.5 2.5 0 100 5 2.5 2.5 0 000-5z"/></svg></div>`,
  whatsapp: `<div class="w-6 h-6 rounded-md bg-[#25D366] text-white font-bold text-[9px] flex items-center justify-center shrink-0">WA</div>`,
  direct: `<div class="w-6 h-6 rounded-md bg-emerald-100 text-[#0d3b23] flex items-center justify-center shrink-0"><svg class="w-3.5 h-3.5 fill-[#0d3b23]" viewBox="0 0 24 24"><path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-7 3c1.66 0 3 1.34 3 3s-1.34 3-3 3-3-1.34-3-3 1.34-3 3-3zm3 10H9v-1c0-1 2-1.9 3-1.9s3 .9 3 1.9v1z"/></svg></div>`,
};
---

<!-- ================= SLEEK & AIRY RATES CARD ================= -->
<div id="rates-card" class="bg-white rounded-3xl border border-slate-200/90 shadow-xl p-5 sm:p-6 text-left space-y-4">

  <!-- ১. মেইন প্রাইস হেডার (একদম হালকা ও প্রিমিয়াম) -->
  <div class="flex items-start justify-between border-b border-slate-100 pb-4">
    <div>
      <span id="agodaLiveIndicator" class="text-[10px] font-bold uppercase tracking-wider text-slate-400 flex items-center gap-1.5 mb-0.5">
        <span>Starting From</span>
      </span>
      <div class="flex items-baseline gap-2">
        <span id="agodaOriginalPrice" class="hidden text-xs text-slate-400 line-through font-semibold"></span>
        <span id="cardStartingPriceDisplay" class="hotel-live-price text-2xl sm:text-3xl font-black text-[#0d3b23] leading-none">
          {displayStartingPrice}
        </span>
        <span id="cardPerNightText" class="text-xs text-slate-500 font-medium">/ night</span>
      </div>
    </div>

    <div class="text-right">
      <span id="agodaDiscountBadge" class="hidden text-[10px] font-black uppercase text-rose-700 bg-rose-50 border border-rose-200 px-2 py-0.5 rounded-full mb-1">
      </span>
      <span class="inline-flex items-center gap-1 text-[10px] font-bold text-emerald-800 bg-emerald-50 px-2 py-0.5 rounded-md">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
        <span>Best Rates</span>
      </span>
    </div>
  </div>

  <!-- ২. স্লিম ডেট সিলেক্টর (TripAdvisor Compact Pill) -->
  <div class="space-y-1.5">
    <div class="relative bg-slate-50 border border-slate-200/90 hover:border-emerald-700/60 rounded-xl overflow-hidden transition-colors shadow-2xs">
      <div class="grid grid-cols-2 divide-x divide-slate-200">
        
        <!-- Check-in -->
        <div class="relative p-2.5 px-3 hover:bg-slate-100/70 transition cursor-pointer">
          <span class="block text-[8px] font-bold uppercase tracking-wider text-slate-400">Check-in</span>
          <span id="checkInDisplay" class="font-bold text-xs text-slate-800 block truncate mt-0.5">Loading...</span>
          <input type="date" id="checkInInput" class="absolute inset-0 opacity-0 cursor-pointer w-full h-full z-10" aria-label="Check-in date" />
        </div>

        <!-- Check-out -->
        <div class="relative p-2.5 px-3 hover:bg-slate-100/70 transition cursor-pointer">
          <span class="block text-[8px] font-bold uppercase tracking-wider text-slate-400">Check-out</span>
          <span id="checkOutDisplay" class="font-bold text-xs text-slate-800 block truncate mt-0.5">Loading...</span>
          <input type="date" id="checkOutInput" class="absolute inset-0 opacity-0 cursor-pointer w-full h-full z-10" aria-label="Check-out date" />
        </div>

      </div>
    </div>

    <!-- রাতের হিসাব ও ২ গেস্ট ইন্ডিকেটর -->
    <div class="flex items-center justify-between text-[10px] font-semibold text-slate-500 px-1">
      <span>👥 2 Guests · 1 Room</span>
      <span id="stayNightsBadge" class="font-bold text-emerald-800 bg-emerald-50 px-1.5 py-0.5 rounded">1 night</span>
    </div>
  </div>

  <!-- ৩. মেইন লাইভ বুকিং বাটন (One-Click Agoda CTA) -->
  <div>
    <a
      id="agodaRowBtn"
      href="#"
      target="_blank"
      rel="sponsored nofollow noopener"
      class="w-full bg-[#0d3b23] hover:bg-[#124e30] text-white font-bold text-xs sm:text-sm py-3 rounded-xl transition shadow-md hover:shadow-lg flex items-center justify-center gap-2 active:scale-98"
    >
      <span>View Deal on Agoda</span>
      <svg class="w-3.5 h-3.5 stroke-current fill-none stroke-2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
      </svg>
    </a>
  </div>

  <!-- ৪. সেকেন্ডারি বুকিং চ্যানেল ও ডিরেক্ট যোগাযোগ (যদি থাকে) -->
  {(channels.length > 0 || hasContact) && (
    <div class="pt-3 border-t border-slate-100 space-y-2">
      <span class="text-[9px] font-bold text-slate-400 uppercase tracking-wider block text-center">
        Other Options
      </span>

      <!-- কাস্টম পার্টনার চ্যানেলসমূহ -->
      <div
        id="aboutRatesTableContainer"
        data-hotel-title={hotelTitle}
        data-hotel-slug={hotelSlug}
        data-agoda-id={agodaId}
        class="space-y-1.5"
      >
        {channels.map((c) => {
          const isExternal = c.url.startsWith('http');
          return (
            <div class="flex items-center justify-between p-2 rounded-lg bg-slate-50 border border-slate-100 text-xs">
              <div class="flex items-center gap-2 min-w-0">
                <Fragment set:html={presetSvgs[c.iconPreset] || presetSvgs.direct} />
                <span class="font-bold text-slate-800 truncate">{c.providerName}</span>
              </div>
              <div class="flex items-center gap-2">
                {c.showPrice && c.price && <span class="font-extrabold text-slate-900">{c.price}</span>}
                <a
                  href={c.url}
                  target={isExternal ? "_blank" : "_self"}
                  rel={isExternal ? "sponsored nofollow noopener" : undefined}
                  class="text-[11px] font-bold text-emerald-800 hover:underline"
                >
                  {c.buttonText} →
                </a>
              </div>
            </div>
          );
        })}
      </div>

      <!-- ডিরেক্ট কল ও হোয়াটসঅ্যাপ (স্লিম বাটন) -->
      {hasContact && (
        <div class={`grid gap-1.5 pt-1 ${cleanPhone && cleanWhatsapp ? 'grid-cols-2' : 'grid-cols-1'}`}>
          {cleanPhone && (
            <a
              href={`tel:${cleanPhone}`}
              class="border border-slate-200 hover:border-[#0d3b23] text-slate-700 hover:text-[#0d3b23] font-bold text-[11px] py-1.5 rounded-lg transition text-center flex items-center justify-center gap-1"
            >
              <span>📞</span> Call Hotel
            </a>
          )}
          {cleanWhatsapp && (
            <a
              href={`https://wa.me/${cleanWhatsapp}?text=${encodeURIComponent(waMessage)}`}
              target="_blank"
              rel="noopener noreferrer"
              class="border border-[#25D366]/40 bg-[#25D366]/5 hover:bg-[#25D366] text-[#0d3b23] hover:text-white font-bold text-[11px] py-1.5 rounded-lg transition text-center flex items-center justify-center gap-1"
            >
              <span>💬</span> WhatsApp
            </a>
          )}
        </div>
      )}
    </div>
  )}

  <!-- স্বচ্ছ গুগল এফিলিয়েট ডিসক্লোজার -->
  <p class="text-center text-[9px] leading-tight text-slate-400">
    Partner rates sync live. We may earn a commission at no extra cost to you.
  </p>

</div>

<!-- ================= CLIENT SCRIPT ================= -->
<script>
  let ratesAbortCtrl: AbortController | null = null;

  function getDhakaDate(offsetDays = 0) {
    const now = new Date();
    const utcMillis = now.getTime() + (now.getTimezoneOffset() * 60000);
    const dhakaTime = new Date(utcMillis + (6 * 3600000));
    dhakaTime.setDate(dhakaTime.getDate() + offsetDays);
    return dhakaTime.toISOString().split("T")[0];
  }

  function formatDisplayDate(dateStr: string): string {
    if (!dateStr) return '';
    const [year, month, day] = dateStr.split('-').map(Number);
    const d = new Date(year, month - 1, day);
    const days = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
    const months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
    return `${days[d.getDay()]}, ${months[d.getMonth()]} ${d.getDate()}`;
  }

  async function initHotelRatesCard() {
    const ratesContainer = document.getElementById('aboutRatesTableContainer');
    const startingPriceEl = document.getElementById('cardStartingPriceDisplay');
    const liveIndicatorEl = document.getElementById('agodaLiveIndicator');
    const agodaOriginalPriceEl = document.getElementById('agodaOriginalPrice');
    const agodaDiscountEl = document.getElementById('agodaDiscountBadge');
    const agodaBtnEl = document.getElementById('agodaRowBtn') as HTMLAnchorElement | null;

    const checkInInput = document.getElementById('checkInInput') as HTMLInputElement | null;
    const checkOutInput = document.getElementById('checkOutInput') as HTMLInputElement | null;
    const checkInDisplay = document.getElementById('checkInDisplay');
    const checkOutDisplay = document.getElementById('checkOutDisplay');
    const nightsBadge = document.getElementById('stayNightsBadge');

    const hotelSlug = (ratesContainer?.getAttribute('data-hotel-slug') || '').trim();
    const hotelName = (ratesContainer?.getAttribute('data-hotel-title') || '').trim();
    const agodaId = (ratesContainer?.getAttribute('data-agoda-id') || '').trim();
    const WORKER_ENDPOINT = "https://gulshanhotels.rmollah394.workers.dev";

    const today = getDhakaDate(0);
    const tomorrow = getDhakaDate(1);

    if (checkInInput && !checkInInput.value) {
      checkInInput.value = today;
      checkInInput.min = today;
    }
    if (checkOutInput && !checkOutInput.value) {
      checkOutInput.value = tomorrow;
      checkOutInput.min = tomorrow;
    }

    function updateLabels() {
      if (checkInInput && checkInDisplay) checkInDisplay.textContent = formatDisplayDate(checkInInput.value);
      if (checkOutInput && checkOutDisplay) checkOutDisplay.textContent = formatDisplayDate(checkOutInput.value);
      if (checkInInput && checkOutInput && nightsBadge) {
        const d1 = new Date(checkInInput.value);
        const d2 = new Date(checkOutInput.value);
        const diffDays = Math.ceil((d2.getTime() - d1.getTime()) / (1000 * 60 * 60 * 24));
        if (diffDays > 0) nightsBadge.textContent = `${diffDays} ${diffDays === 1 ? 'night' : 'nights'}`;
      }
    }

    async function fetchLiveRates(checkIn: string, checkOut: string) {
      ratesAbortCtrl?.abort();
      ratesAbortCtrl = new AbortController();
      const { signal } = ratesAbortCtrl;

      if (startingPriceEl) startingPriceEl.style.opacity = '0.35';

      const queryParam = agodaId ? `id=${encodeURIComponent(agodaId)}` : `hotel=${encodeURIComponent(hotelSlug || hotelName)}`;
      const apiUrl = `${WORKER_ENDPOINT}?${queryParam}&checkIn=${checkIn}&checkOut=${checkOut}&currency=USD`;

      try {
        const res = await fetch(apiUrl, { signal });
        if (res.ok) {
          const json = await res.json();
          if (json && json.success && json.rates) {
            const rates = json.rates;
            const livePriceStr = rates.startingPrice ? String(rates.startingPrice) : null;

            if (startingPriceEl && livePriceStr) {
              startingPriceEl.textContent = livePriceStr;
              startingPriceEl.style.opacity = '1';
            }

            if (agodaOriginalPriceEl) {
              if (rates.originalPrice) {
                agodaOriginalPriceEl.textContent = rates.originalPrice;
                agodaOriginalPriceEl.classList.remove('hidden');
              } else {
                agodaOriginalPriceEl.classList.add('hidden');
              }
            }

            if (agodaDiscountEl) {
              if (rates.discountText) {
                agodaDiscountEl.textContent = rates.discountText;
                agodaDiscountEl.classList.remove('hidden');
              } else {
                agodaDiscountEl.classList.add('hidden');
              }
            }

            if (liveIndicatorEl) {
              liveIndicatorEl.innerHTML = `
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
                <span class="text-emerald-700 font-bold">Live Agoda Price</span>
              `;
            }

            const agodaDeal = Array.isArray(rates.channelsList) ? rates.channelsList[0] : null;
            if (agodaBtnEl && agodaDeal?.button_url) {
              agodaBtnEl.href = agodaDeal.button_url;
            }

            // পেজের অন্যান্য লাইভ প্রাইস আপডেট
            if (livePriceStr) {
              document.querySelectorAll('.hotel-live-price, [data-hotel-live-price]').forEach((el) => {
                el.textContent = livePriceStr;
              });
            }
          }
        }
      } catch (e: any) {
        if (startingPriceEl) startingPriceEl.style.opacity = '1';
      }
    }

    updateLabels();
    fetchLiveRates(checkInInput?.value || today, checkOutInput?.value || tomorrow);

    if (checkInInput && !checkInInput.dataset.bound) {
      checkInInput.dataset.bound = 'true';
      checkInInput.addEventListener('change', () => {
        const newIn = checkInInput.value;
        if (checkOutInput) {
          const nextDay = new Date(newIn);
          nextDay.setDate(nextDay.getDate() + 1);
          const nextDayStr = nextDay.toISOString().split("T")[0];
          checkOutInput.min = nextDayStr;
          if (checkOutInput.value <= newIn) checkOutInput.value = nextDayStr;
        }
        updateLabels();
        fetchLiveRates(checkInInput.value, checkOutInput?.value || tomorrow);
      });
    }

    if (checkOutInput && !checkOutInput.dataset.bound) {
      checkOutInput.dataset.bound = 'true';
      checkOutInput.addEventListener('change', () => {
        updateLabels();
        fetchLiveRates(checkInInput?.value || today, checkOutInput.value);
      });
    }
  }

  document.addEventListener('astro:before-swap', () => {
    ratesAbortCtrl?.abort();
  });

  document.addEventListener('DOMContentLoaded', initHotelRatesCard);
  document.addEventListener('astro:page-load', initHotelRatesCard);
</script>
