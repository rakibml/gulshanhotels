---
// src/components/GulshanFaq.astro (Compact 2-Column Split Layout - 100% SEO Schema Ready)

interface Props {
  title?: string;
  subtitle?: string;
}

const { 
  title = "Frequently Asked Questions", 
  subtitle = "Everything international travelers, diplomats, and business visitors need to know before booking a hotel in Gulshan, Dhaka."
} = Astro.props;

const faqs = [
  {
    question: "Which are the best 5-star luxury hotels in Gulshan?",
    answer: "The premier international 5-star hotels in Gulshan are The Westin Dhaka (Gulshan 2), Renaissance Dhaka Gulshan Hotel (Gulshan 1), and Amari Dhaka (Gulshan 2). Other top-rated executive boutique properties include Lakeshore Hotel and The Midori by Lakeshore."
  },
  {
    question: "How far is Gulshan from Dhaka Airport (DAC)?",
    answer: "Gulshan is approximately 8 to 11 km from Hazrat Shahjalal International Airport. With the Dhaka Elevated Expressway, transit time takes only 15 to 20 minutes. Most luxury hotels offer private chauffeur airport pickups."
  },
  {
    question: "Which hotels are closest to the US Embassy & IVAC Visa Centre?",
    answer: "The Westin Dhaka, Amari Dhaka, and Ascott The Residence are just 3 to 5 minutes away from the US Embassy, Canadian High Commission, and Baridhara Diplomatic Enclave. For Indian Visa (IVAC) applicants, Gulshan 2 properties offer the easiest early-morning commute."
  },
  {
    question: "What is the average price range for hotels in Gulshan?",
    answer: "5-star international hotels typically range between USD 130 to USD 220+ (৳15,000 to ৳26,000) per night. Executive boutique stays and serviced suites generally cost between USD 60 to USD 110 (৳7,000 to ৳13,000) per night."
  },
  {
    question: "What are the ID requirements and couple policies for guests?",
    answer: "Foreign passport holders require a valid passport and Bangladesh visa stamp. Bangladeshi citizens need a government-issued NID. Established 5-star and international business hotels welcome verified adult guests and international couples without hassle."
  },
  {
    question: "Is Gulshan safe for international tourists & solo travelers?",
    answer: "Yes, Gulshan and Baridhara constitute the safest high-security zone in Bangladesh. The area is under 24/7 CCTV surveillance, round-the-clock Diplomatic Police patrols, and dedicated hotel security checkpoints."
  },
  {
    question: "Do Gulshan hotels offer early morning breakfast for visa slots?",
    answer: "Yes, top properties in Gulshan cater to embassy visa interview candidates with early bird breakfast buffets starting as early as 6:00 AM, alongside 24/7 business centres for urgent printing."
  }
];

const quickTags = [
  "Hotels with Rooftop Pool",
  "Near US Embassy",
  "Free Airport Shuttle",
  "Near United Hospital",
  "Serviced Apartments"
];

// গুগল এসইও এর জন্য অফিসিয়াল FAQPage JSON-LD স্কিমা
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(faq => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
};
---

<!-- GOOGLE FAQ SCHEMA INJECTION -->
<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

<!-- GULSHAN COMPACT FAQ SECTION -->
<section id="faq" class="w-full bg-white pt-10 pb-16 text-slate-900 border-b border-slate-100">
  <div class="max-w-[1550px] mx-auto px-4 sm:px-8 lg:px-12">
    
    <!-- 2-COLUMN BALANCED GRID (লম্বা স্ক্রোলিং বন্ধ করার জন্য) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-14 items-start text-left">
      
      <!-- LEFT COLUMN: হেডিং, ইনফো, ট্যাগ ও কন্টাক্ট কার্ড (lg:col-span-5) -->
      <div class="lg:col-span-5 space-y-6 lg:sticky lg:top-24">
        
        <div class="space-y-2">
          <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-50 text-emerald-800 text-[11px] font-black uppercase tracking-wider">
            <span>✓ Traveler Guide & FAQs</span>
          </div>
          
          <h2 class="text-3xl sm:text-4xl font-serif font-black text-slate-900 tracking-tight leading-tight">
            {title}
          </h2>
          
          <p class="text-xs sm:text-sm text-slate-500 font-medium leading-relaxed">
            {subtitle}
          </p>
        </div>

        <!-- Quick SEO Tags -->
        <div class="space-y-2 pt-2 border-t border-slate-100">
          <span class="text-[11px] font-bold text-slate-400 uppercase tracking-wider block">Popular Inquiries:</span>
          <div class="flex flex-wrap gap-1.5">
            {quickTags.map((tag) => (
              <a 
                href="/#hotels" 
                class="text-[11px] font-bold text-slate-600 bg-slate-50 hover:bg-emerald-50 hover:text-emerald-800 border border-slate-200 px-3 py-1 rounded-full transition-colors"
              >
                {tag}
              </a>
            ))}
          </div>
        </div>

        <!-- Compact Concierge Box -->
        <div class="p-5 rounded-2xl bg-slate-50 border border-slate-200/80 space-y-3">
          <div class="space-y-1">
            <span class="font-bold text-slate-900 block text-sm">Need help choosing a hotel?</span>
            <p class="text-xs text-slate-500 leading-relaxed">
              Our local concierge team verifies rates, embassy distances, and checkout policies daily.
            </p>
          </div>
          <a 
            href="/about" 
            class="inline-block bg-[#0d3b23] hover:bg-[#061e14] text-white font-extrabold px-4 py-2 rounded-xl transition text-[11px] uppercase tracking-wider"
          >
            Ask Our Concierge ➔
          </a>
        </div>

      </div>

      <!-- RIGHT COLUMN: কমপ্যাক্ট অ্যাকর্ডিয়ান লিস্ট (lg:col-span-7) -->
      <div class="lg:col-span-7 divide-y divide-slate-200/80 border-y border-slate-200/80">
        {faqs.map((faq, index) => (
          <details 
            class="group py-4 transition-colors cursor-pointer"
            open={index === 0}
          >
            <summary class="flex justify-between items-center list-none font-bold text-base sm:text-[17px] text-slate-900 group-hover:text-emerald-800 transition-colors select-none">
              <span class="pr-4 font-sans tracking-tight">{faq.question}</span>
              
              <!-- Indicator Button -->
              <span class="w-6 h-6 shrink-0 rounded-full bg-slate-100 border border-slate-200 flex items-center justify-center text-slate-600 group-hover:bg-[#0d3b23] group-hover:text-white transition-all text-xs font-bold">
                <span class="group-open:hidden">+</span>
                <span class="hidden group-open:inline">−</span>
              </span>
            </summary>

            <div class="pt-2.5 pr-6 text-xs sm:text-[13px] text-slate-600 font-normal leading-relaxed">
              <p>{faq.answer}</p>
            </div>
          </details>
        ))}
      </div>

    </div>

  </div>
</section>

<!-- Hide default details arrow in WebKit browsers -->
<style>
  details > summary::-webkit-details-marker {
    display: none;
  }
</style>
