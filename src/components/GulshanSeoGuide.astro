---
// src/components/GulshanFaq.astro

interface Props {
  title?: string;
  subtitle?: string;
  renderSchema?: boolean;
}

const {
  title = "Frequently Asked Questions About Hotels in Gulshan",
  subtitle = "Basic information for visitors planning a stay in Gulshan, Dhaka. Always confirm details with the hotel before booking.",
  renderSchema = true
} = Astro.props;

const faqs = [
  {
    question: "Which hotels are listed on this site?",
    answer: "This site is new and we are adding hotels in Gulshan one by one. Right now we list Amari Dhaka in Gulshan 2. More hotels will be added over time."
  },
  {
    question: "How far is Gulshan from Dhaka Airport (DAC)?",
    answer: "Gulshan is roughly 8 to 12 km from Hazrat Shahjalal International Airport, depending on the exact hotel. Travel time depends on traffic and can range from about 20 minutes to over an hour. Please check a live map for your travel time."
  },
  {
    question: "Are there hotels near embassies in Gulshan?",
    answer: "Gulshan and the nearby Baridhara area have many embassies and high commissions. If you have an appointment, check the exact distance from the hotel to the embassy address on a map before booking."
  },
  {
    question: "What is the usual price range for hotels in Gulshan?",
    answer: "Prices vary by hotel, season, and room type. Larger international hotels usually cost more than smaller business hotels. The prices shown on this site are approximate and may change, so please check the hotel's own website or booking page for the current rate."
  },
  {
    question: "What documents do I need to check in?",
    answer: "Hotels in Bangladesh usually ask for a valid ID at check-in. Bangladeshi guests commonly show a National ID card, and foreign guests show a passport and visa. Rules can differ between hotels, so please confirm with your hotel before you arrive."
  },
  {
    question: "Is Gulshan a good area to stay in?",
    answer: "Gulshan is a well-known central area of Dhaka with many hotels, restaurants, offices, and embassies. Like any big city area, it is wise to take normal travel precautions. Read recent guest reviews on trusted booking sites before you decide."
  },
  {
    question: "How are prices and details on this site collected?",
    answer: "Prices and details come from the hotels' own pages or public booking sites and may not be up to date. We do not take payment for bookings on this site. Always confirm the final price and policies with the hotel."
  }
];

const midPoint = Math.ceil(faqs.length / 2);
const leftColumnFaqs = faqs.slice(0, midPoint);
const rightColumnFaqs = faqs.slice(midPoint);

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(faq => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
};

const jsonLdString = JSON.stringify(faqSchema).replace(/</g, "\\u003c");
---
