---
// src/components/GulshanFaq.astro
// 2-column FAQ grid. Page text and JSON-LD schema come from the same `faqs` list, so they always match.

interface Props {
  title?: string;
  subtitle?: string;
  renderSchema?: boolean; // set false if the page already has FAQ schema
}

const {
  title = "Frequently Asked Questions About Hotels in Gulshan",
  subtitle = "Basic information for visitors planning a stay in Gulshan, Dhaka. Always confirm details with the hotel before booking.",
  renderSchema = true
} = Astro.props;

const faqs = [
  {
    question: "Which hotels are listed on this site?",
    answer: "This site is new and we are adding hotels in Gulshan one by one. Right now we list Amari Dhaka in Gulshan 2. More hotels will be added over time."
  },
  {
    question: "How far is Gulshan from Dhaka Airport (DAC)?",
    answer: "Gulshan is roughly 8 to 12 km from Hazrat Shahjalal International Airport, depending on the exact hotel. Travel time depends on traffic and can range from about 20 minutes to over an hour. Please check a live map for your travel time."
  },
  {
    question: "Are there hotels near embassies in Gulshan?",
    answer: "Gulshan and the nearby Baridhara area have many embassies and high commissions. If you have an appointment, check the exact distance from the hotel to the embassy address on a map before booking."
  },
  {
    question: "What is the usual price range for hotels in Gulshan?",
    answer: "Prices vary by hotel, season, and room type. Larger international hotels usually cost more than smaller business hotels. The prices shown on this site are approximate and may change, so please check the hotel's own website or booking page for the current rate."
  },
  {
    question: "What documents do I need to check in?",
    answer: "Hotels in Bangladesh usually ask for a valid ID at check-in. Bangladeshi guests commonly show a National ID card, and foreign guests show a passport and visa. Rules can differ between hotels, so please confirm with your hotel before you arrive."
  },
  {
    question: "Is Gulshan a good area to stay in?",
    answer: "Gulshan is a well-known central area of Dhaka with many hotels, restaurants, offices, and embassies. Like any big city area, it is wise to take normal travel precautions. Read recent guest reviews on trusted booking sites before you decide."
  },
  {
    question: "How are prices and details on this site collected?",
    answer: "Prices and details come from the hotels' own pages or public booking sites and may not be up to date. We do not take payment for bookings on this site. Always confirm the final price and policies with the hotel."
  }
];

const midPoint = Math.ceil(faqs.length / 2);
const leftColumnFaqs = faqs.slice(0, midPoint);
const rightColumnFaqs = faqs.slice(midPoint);

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(faq => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
};

const jsonLdString = JSON.stringify(faqSchema).replace(/</g, "\\u003c");
---

<!-- FAQ SCHEMA (matches the visible text above) -->
{renderSchema && <script type="application/ld+json" set:html={jsonLdString} />}

<section id="faq" class="w-full bg-white py-12 px-4 sm:px-6 lg:px-0 max-w-7xl mx-auto text-slate-900 border-b border-slate-200 scroll-mt-14 sm:scroll-mt-16 text-left">
  <div class="space-y-8">

    <!-- Section Header -->
    <div class="space-y-2 text-left">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-50 text-emerald-800 text-[10px] sm:text-xs font-bold uppercase tracking-wider mb-0.5 border border-emerald-200/80">
        <svg class="w-3.5 h-3.5 text-emerald-700" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
        </svg>
        <span>Traveler FAQs</span>
      </div>

      <h2 class="font-sans text-2xl sm:text-3xl lg:text-[32px] font-black text-[#002b11] tracking-tight leading-tight">
        {title}
      </h2>
      <p class="text-xs sm:text-sm text-slate-500 font-medium max-w-2xl">
        {subtitle}
      </p>
    </div>

    <!-- 2-COLUMN ACCORDION GRID -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-x-10 lg:gap-x-12 text-left items-start">

      <!-- LEFT COLUMN -->
      <div class="divide-y divide-slate-200 border-t border-b lg:border-b-0 border-slate-200">
        {leftColumnFaqs.map((faq, index) => (
          <details
            class="group py-4 sm:py-5 transition-colors cursor-pointer"
            open={index === 0}
          >
            <summary class="flex justify-between items-center list-none font-bold text-sm sm:text-base text-slate-900 group-hover:text-emerald-900 transition-colors select-none">
              <span class="pr-4 font-sans font-bold tracking-tight leading-snug">{faq.question}</span>

              <span class="w-6 h-6 shrink-0 rounded-full bg-slate-50 border border-slate-200 flex items-center justify-center text-slate-600 group-hover:bg-[#0d3b23] group-hover:text-white transition-all text-xs font-bold" aria-hidden="true">
                <span class="group-open:hidden">+</span>
                <span class="hidden group-open:inline font-bold">−</span>
              </span>
            </summary>

            <div class="pt-2.5 pr-6 text-xs sm:text-[13px] text-slate-600 font-normal leading-relaxed">
              <p>{faq.answer}</p>
            </div>
          </details>
        ))}
      </div>

      <!-- RIGHT COLUMN -->
      <div class="divide-y divide-slate-200 border-t border-slate-200">
        {rightColumnFaqs.map((faq) => (
          <details class="group py-4 sm:py-5 transition-colors cursor-pointer">
            <summary class="flex justify-between items-center list-none font-bold text-sm sm:text-base text-slate-900 group-hover:text-emerald-900 transition-colors select-none">
              <span class="pr-4 font-sans font-bold tracking-tight leading-snug">{faq.question}</span>

              <span class="w-6 h-6 shrink-0 rounded-full bg-slate-50 border border-slate-200 flex items-center justify-center text-slate-600 group-hover:bg-[#0d3b23] group-hover:text-white transition-all text-xs font-bold" aria-hidden="true">
                <span class="group-open:hidden">+</span>
                <span class="hidden group-open:inline font-bold">−</span>
              </span>
            </summary>

            <div class="pt-2.5 pr-6 text-xs sm:text-[13px] text-slate-600 font-normal leading-relaxed">
              <p>{faq.answer}</p>
            </div>
          </details>
        ))}
      </div>

    </div>

  </div>
</section>

<!-- Hide default marker in Safari/Chrome -->
<style>
  details > summary::-webkit-details-marker {
    display: none;
  }
</style>
