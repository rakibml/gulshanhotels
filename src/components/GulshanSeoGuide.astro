---
// src/components/GulshanFaq.astro (100% SEO Optimized Accordion with Google FAQPage Schema)

interface Props {
  title?: string;
  subtitle?: string;
}

const { 
  title = "Frequently Asked Questions About Gulshan Hotels", 
  subtitle = "Everything international travelers, diplomats, and business visitors need to know before booking in Gulshan, Dhaka."
} = Astro.props;

// প্রশ্ন ও উত্তরের তালিকা (গুগল সার্চ ও কি-ওয়ার্ড টার্গেটেড)
const faqs = [
  {
    question: "Which are the best 5-star luxury hotels in Gulshan, Dhaka?",
    answer: "The premier international 5-star hotels in Gulshan are The Westin Dhaka (Gulshan 2), Renaissance Dhaka Gulshan Hotel (Gulshan 1), and Amari Dhaka (Gulshan 2). Other top-rated executive boutique properties include Lakeshore Hotel Gulshan and The Midori by Lakeshore, all offering diplomatic-grade security, rooftop infinity pools, and world-class fine dining."
  },
  {
    question: "How far is Gulshan from Hazrat Shahjalal International Airport (DAC)?",
    answer: "Gulshan is approximately 8 to 11 kilometers from Dhaka Airport. With the modern Dhaka Elevated Expressway, transit time takes only 15 to 25 minutes depending on the time of day. Most 5-star and executive hotels in Gulshan provide dedicated private airport shuttle and chauffeur services upon request."
  },
  {
    question: "Which hotels in Gulshan are closest to the US Embassy and foreign visa centres?",
    answer: "The Westin Dhaka, Amari Dhaka, and Ascott The Residence are just 3 to 6 minutes away from the US Embassy, Canadian High Commission, and the Baridhara Diplomatic Enclave. For Indian Visa (IVAC) applicants and UK VFS Global, Gulshan 2 properties offer the most seamless early-morning commute."
  },
  {
    question: "What is the average price of luxury and boutique hotels in Gulshan?",
    answer: "Nightly rates in Gulshan vary by category: 5-star international hotels typically range between USD 130 to USD 220+ (৳15,000 to ৳26,000) per night. Premium executive boutique hotels and serviced suites generally cost between USD 60 to USD 110 (৳7,000 to ৳13,000) per night, often including complimentary breakfast."
  },
  {
    question: "What are the ID requirements and guest policies for staying in Gulshan?",
    answer: "International visitors and foreign passport holders must present a valid passport with a valid Bangladesh visa or arrival stamp during check-in. Local Bangladeshi citizens require a government-issued National ID (NID) or Smart Card. Most established 5-star and international business hotels welcome verified adult guests and international couples without hassle."
  },
  {
    question: "Is Gulshan safe for international tourists, expats, and female solo travelers?",
    answer: "Yes, Gulshan 1, Gulshan 2, and the Baridhara Enclave constitute the safest and most protected high-security zone in Bangladesh. The area is under 24/7 CCTV monitoring, round-the-clock Diplomatic Police patrols, and specialized private security at every major hotel entrance."
  },
  {
    question: "Do Gulshan hotels offer early morning breakfast for visa interview attendees?",
    answer: "Yes, top properties in Gulshan cater extensively to embassy visa candidates by offering early bird breakfast buffets starting as early as 6:00 AM, alongside 24-hour business centres for urgent document printing and express laundry."
  }
];

// কি-ওয়ার্ড টপিক পিলস (Quick SEO Silo Tags)
const quickTags = [
  "Hotels with Rooftop Pool",
  "Near US Embassy",
  "Free Airport Shuttle",
  "Near United Hospital",
  "Complimentary Breakfast",
  "Diplomatic Serviced Apartments"
];

// গুগল এসইও এর জন্য অফিসিয়াল FAQPage JSON-LD স্কিমা
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(faq => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
};
---

<!-- GOOGLE FAQ SCHEMA INJECTION (RICH SNIPPETS) -->
<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

<!-- GULSHAN SEO FAQ SECTION -->
<section id="faq" class="w-full bg-white pt-10 pb-16 text-slate-900 border-b border-slate-100">
  <div class="max-w-[1550px] mx-auto px-4 sm:px-8 lg:px-12">
    
    <div class="max-w-4xl mx-auto space-y-8 text-left">
      
      <!-- Section Title & Subtitle -->
      <div class="space-y-2 text-center sm:text-left">
        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-50 text-emerald-800 text-[11px] font-black uppercase tracking-wider">
          <span>✓ Traveler Guide & FAQs</span>
        </div>
        <h2 class="text-3xl sm:text-4xl font-serif font-black text-slate-900 tracking-tight leading-tight">
          {title}
        </h2>
        <p class="text-xs sm:text-sm text-slate-500 font-medium leading-relaxed max-w-2xl">
          {subtitle}
        </p>
      </div>

      <!-- Quick Topic Silo Tags (SEO Helper) -->
      <div class="flex flex-wrap gap-2 pt-1 border-t border-slate-100">
        {quickTags.map((tag) => (
          <a 
            href="/#hotels" 
            class="text-[11px] font-bold text-slate-600 bg-slate-50 hover:bg-emerald-50 hover:text-emerald-800 border border-slate-200/90 hover:border-emerald-300 px-3 py-1 rounded-full transition-colors"
          >
            {tag}
          </a>
        ))}
      </div>

      <!-- Semantic Native HTML5 Accordion List (Ultra-Fast & SEO Friendly) -->
      <div class="divide-y divide-slate-200/80 border-y border-slate-200/80 pt-1">
        {faqs.map((faq, index) => (
          <details 
            class="group py-5 transition-colors cursor-pointer"
            open={index === 0}
          >
            <summary class="flex justify-between items-center list-none font-bold text-base sm:text-lg text-slate-900 group-hover:text-emerald-800 transition-colors select-none">
              <span class="pr-6 font-sans tracking-tight">{faq.question}</span>
              
              <!-- Plus / Minus Indicator -->
              <span class="w-7 h-7 shrink-0 rounded-full bg-slate-50 border border-slate-200 flex items-center justify-center text-slate-600 group-hover:bg-[#0d3b23] group-hover:text-white transition-all text-xs font-bold">
                <span class="group-open:hidden">+</span>
                <span class="hidden group-open:inline">−</span>
              </span>
            </summary>

            <div class="pt-3 pr-8 text-xs sm:text-sm text-slate-600 font-normal leading-relaxed">
              <p>{faq.answer}</p>
            </div>
          </details>
        ))}
      </div>

      <!-- Direct Assistance Footer Line -->
      <div class="p-5 rounded-2xl bg-slate-50 border border-slate-200/80 flex flex-col sm:flex-row justify-between items-center gap-4 text-xs text-slate-600">
        <div>
          <span class="font-bold text-slate-900 block text-sm">Have more questions about staying in Gulshan?</span>
          <span>Our local hotel audit team verifies rates, embassy distances, and checkout policies daily.</span>
        </div>
        <a 
          href="/about" 
          class="shrink-0 bg-[#0d3b23] hover:bg-[#061e14] text-white font-extrabold px-5 py-2.5 rounded-xl transition text-[11px] uppercase tracking-wider"
        >
          Contact Our Concierge ➔
        </a>
      </div>

    </div>

  </div>
</section>

<!-- Hide default details arrow in WebKit browsers -->
<style>
  details > summary::-webkit-details-marker {
    display: none;
  }
</style>
