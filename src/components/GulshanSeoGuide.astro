---
// src/components/GulshanSeoGuide.astro (Crystal Clear & High-Contrast Luxury Edition)
interface Props {
  title?: string;
  buttonText?: string;
  buttonUrl?: string;
}

const {
  title = "Hotels in Gulshan, Dhaka",
  buttonText = "Explore All Hotels in Gulshan ➔",
  buttonUrl = "#hotels"
} = Astro.props;

// Crisp High-Contrast Vector SVG Icons
const icons = {
  location: `<svg class="w-6 h-6 text-emerald-300 stroke-current stroke-2 fill-none" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>`,
  connectivity: `<svg class="w-6 h-6 text-emerald-300 stroke-current stroke-2 fill-none" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8.111 16.404a5.5 5.5 0 017.778 0M12 20h.01m-7.08-7.071c3.904-3.905 10.236-3.905 14.141 0M1.394 9.393c5.857-5.857 15.355-5.857 21.213 0"/></svg>`,
  hotelChoice: `<svg class="w-6 h-6 text-emerald-300 stroke-current stroke-2 fill-none" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>`,
  safety: `<svg class="w-6 h-6 text-emerald-300 stroke-current stroke-2 fill-none" viewBox="0 0 24 24"><path d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>`
};
---

<!-- GULSHAN SEO OVERVIEW & WHY STAY SECTION -->
<section id="gulshan-seo-guide" class="bg-[#F8FAF9] py-12 sm:py-16 px-4 sm:px-8 lg:px-12 max-w-[1550px] mx-auto text-slate-900 border-b border-slate-200/80">
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-center">
    
    <!-- LEFT COLUMN: SEO CONTENT -->
    <div class="lg:col-span-5 space-y-4 text-left">
      <h2 class="text-2xl sm:text-3xl font-black font-sans text-slate-900 tracking-tight leading-tight">
        {title}
      </h2>

      <div class="space-y-3.5 text-xs sm:text-[13.5px] text-slate-600 leading-relaxed font-normal">
        <p>
          Gulshan is one of the most popular areas to stay in Dhaka, especially for business travelers, international visitors and travelers looking for upscale accommodation. The area is home to a wide range of hotels in Gulshan, from internationally recognized five-star properties to boutique hotels and more affordable guest houses.
        </p>

        <p>
          Gulshan 1 and Gulshan 2 are particularly popular because of their restaurants, shopping areas, offices, embassies and convenient access to other parts of Dhaka. Travelers staying in Gulshan can choose from luxury hotels, business-friendly properties, hotels near the US Embassy and accommodations suited to longer stays.
        </p>

        <p>
          Whether you're looking for a luxury hotel in Gulshan, a hotel near the US Embassy, or a more affordable place to stay, our guide helps you compare your options and find the right area and hotel for your trip.
        </p>
      </div>

      <div class="pt-2">
        <a 
          href={buttonUrl} 
          class="inline-flex items-center gap-2 bg-[#06331e] hover:bg-[#042013] text-white font-extrabold text-xs px-6 py-3.5 rounded-xl transition shadow-sm hover:shadow-md cursor-pointer active:scale-95"
        >
          <span>{buttonText}</span>
        </a>
      </div>
    </div>

    <!-- RIGHT COLUMN: CRYSTAL CLEAR "WHY STAY IN GULSHAN" CARD -->
    <div class="lg:col-span-7 relative rounded-3xl overflow-hidden shadow-2xl flex flex-col justify-center p-6 sm:p-8 md:p-10 min-h-[420px] bg-slate-950 text-white border border-slate-800">
      
      <!-- Vivid City Skyline Image (High Visibility) -->
      <img 
        src="https://images.unsplash.com/photo-1514565131-fce0801e5785?auto=format&fit=crop&w=1200&q=80" 
        alt="Gulshan Dhaka City Skyline Night Lights" 
        loading="lazy" 
        decoding="async" 
        class="absolute inset-0 w-full h-full object-cover opacity-60"
      />
      
      <!-- Balanced Gradient Overlay (Ensures Both Photo & Text are Perfectly Visible) -->
      <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/80 to-slate-900/60"></div>

      <!-- Card Content -->
      <div class="relative z-10 space-y-6 sm:space-y-8 text-center my-auto">
        
        <div>
          <h3 class="text-2xl sm:text-3xl md:text-4xl font-serif italic font-bold text-white tracking-wide drop-shadow-md">
            Why Stay in Gulshan?
          </h3>
          <p class="text-xs sm:text-sm text-emerald-200/90 font-medium mt-1">
            Dhaka's most prestigious diplomatic & business district
          </p>
        </div>

        <!-- 4 Grid Feature Items (With Frosted Glass Badges for 100% Readability) -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 sm:gap-4 text-center items-stretch">
          
          <!-- Feature 1: Location -->
          <div class="bg-white/10 hover:bg-white/15 backdrop-blur-md p-3.5 sm:p-4 rounded-2xl border border-white/15 flex flex-col items-center justify-between transition shadow-sm">
            <div class="w-11 h-11 rounded-full bg-emerald-500/20 border border-emerald-400/40 flex items-center justify-center mb-2.5 shadow-inner">
              <span set:html={icons.location} class="inline-flex"></span>
            </div>
            <div>
              <h4 class="font-extrabold text-xs sm:text-sm text-white block mb-1">Prime Location</h4>
              <p class="text-[11px] sm:text-xs text-slate-200 leading-snug font-normal">
                Close to business hubs, embassies & shopping.
              </p>
            </div>
          </div>

          <!-- Feature 2: Connectivity -->
          <div class="bg-white/10 hover:bg-white/15 backdrop-blur-md p-3.5 sm:p-4 rounded-2xl border border-white/15 flex flex-col items-center justify-between transition shadow-sm">
            <div class="w-11 h-11 rounded-full bg-emerald-500/20 border border-emerald-400/40 flex items-center justify-center mb-2.5 shadow-inner">
              <span set:html={icons.connectivity} class="inline-flex"></span>
            </div>
            <div>
              <h4 class="font-extrabold text-xs sm:text-sm text-white block mb-1">Great Connectivity</h4>
              <p class="text-[11px] sm:text-xs text-slate-200 leading-snug font-normal">
                Easy access to the airport and main Dhaka roads.
              </p>
            </div>
          </div>

          <!-- Feature 3: Hotel Choices -->
          <div class="bg-white/10 hover:bg-white/15 backdrop-blur-md p-3.5 sm:p-4 rounded-2xl border border-white/15 flex flex-col items-center justify-between transition shadow-sm">
            <div class="w-11 h-11 rounded-full bg-emerald-500/20 border border-emerald-400/40 flex items-center justify-center mb-2.5 shadow-inner">
              <span set:html={icons.hotelChoice} class="inline-flex"></span>
            </div>
            <div>
              <h4 class="font-extrabold text-xs sm:text-sm text-white block mb-1">Wide Hotel Choices</h4>
              <p class="text-[11px] sm:text-xs text-slate-200 leading-snug font-normal">
                From 5-star luxury to budget-friendly stays.
              </p>
            </div>
          </div>

          <!-- Feature 4: Safety -->
          <div class="bg-white/10 hover:bg-white/15 backdrop-blur-md p-3.5 sm:p-4 rounded-2xl border border-white/15 flex flex-col items-center justify-between transition shadow-sm">
            <div class="w-11 h-11 rounded-full bg-emerald-500/20 border border-emerald-400/40 flex items-center justify-center mb-2.5 shadow-inner">
              <span set:html={icons.safety} class="inline-flex"></span>
            </div>
            <div>
              <h4 class="font-extrabold text-xs sm:text-sm text-white block mb-1">Safe & Convenient</h4>
              <p class="text-[11px] sm:text-xs text-slate-200 leading-snug font-normal">
                Clean diplomatic zone with 24/7 security.
              </p>
            </div>
          </div>

        </div>

      </div>

    </div>

  </div>
</section>
