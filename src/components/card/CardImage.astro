---
interface Props {
  image: string | null;
  title: string;
  url: string;
  price: string;
}

const { image, title, url, price } = Astro.props;
---

<!-- কন্টেইনার: মোবাইলে w-full এবং aspect-ratio যোগ করা হয়েছে -->
<div class="card-img-box relative group w-full md:w-64 lg:w-72 aspect-[16/10] md:aspect-auto shrink-0 bg-slate-200 overflow-hidden rounded-t-xl md:rounded-t-none md:rounded-l-xl">
  
  <!-- Image Logic -->
  {image ? (
    <img 
      src={image} 
      alt={title} 
      loading="lazy" 
      decoding="async" 
      class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-110" 
    />
  ) : (
    <div class="absolute inset-0 w-full h-full flex flex-col items-center justify-center text-slate-400 bg-slate-100">
      <svg class="w-8 h-8 mb-1 opacity-50" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
      </svg>
      <span class="text-[10px] font-bold uppercase tracking-wider">No Photo Available</span>
    </div>
  )}

  <!-- Overlay -->
  <div class="absolute inset-0 bg-black/5 group-hover:bg-black/0 transition-colors duration-300"></div>

  <!-- Wishlist Button -->
  <button 
    type="button"
    class="wishlist-btn absolute top-3 right-3 w-8 h-8 rounded-full bg-white/90 backdrop-blur-sm text-slate-800 flex items-center justify-center shadow-sm transition-all duration-300 hover:bg-white hover:text-red-500 hover:scale-110 active:scale-95 z-20"
    data-title={title}
    data-image={image}
    data-url={url}
    data-price={price}
    aria-label="Add to wishlist"
  >
    <svg class="w-4 h-4 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path>
    </svg>
  </button>
</div>

<script>
  // Wishlist logic handle
  const initWishlist = () => {
    document.querySelectorAll('.wishlist-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        const icon = btn.querySelector('svg');
        btn.classList.toggle('text-red-500');
        if(icon) {
          const isFilled = icon.getAttribute('fill') === 'currentColor';
          icon.setAttribute('fill', isFilled ? 'none' : 'currentColor');
        }
      });
    });
  };
  initWishlist();
  document.addEventListener('astro:page-load', initWishlist);
</script>
