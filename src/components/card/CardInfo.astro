---
interface Props {
  title: string;
  url: string;
  stars: number;
  address: string;
  latestReview: any;
  fallbackAbout: string;
  rating: string | null;
  ratingLabel: string;
  reviewsCount: number; // প্যারেন্ট থেকে আসা সঠিক সংখ্যা
  amenities?: any[]; 
}

const {
  title,
  url,
  address,
  latestReview,
  fallbackAbout,
  rating,
  ratingLabel,
  reviewsCount,
  amenities = []
} = Astro.props;

// Review text processing (See more logic)
let reviewShort = '';
let reviewFull = '';
let hasMoreReview = false;

if (latestReview?.comment) {
  const cleanComment = latestReview.comment.replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim();
  const words = cleanComment.split(/\s+/).filter(Boolean);
  reviewFull = cleanComment;
  if (words.length > 20) {
    reviewShort = words.slice(0, 20).join(' ') + '...';
    hasMoreReview = true;
  } else {
    reviewShort = cleanComment;
  }
}

// Amenities: এক লাইনে দেখানোর জন্য ফিল্টার
const displayAmenities = amenities.slice(0, 5).map(item => {
  return typeof item === 'string' ? item : (item?.name || '');
}).filter(n => n !== '');

const reviewSuffix = reviewsCount === 1 ? 'review' : 'reviews';
---

<div class="hotel-info flex-1 min-w-0 flex flex-col justify-start text-left font-['Plus_Jakarta_Sans',sans-serif]">
  
  <!-- ১. টাইটেল -->
  <div class="leading-tight">
    <a href={url} class="block text-[18px] sm:text-[20px] font-[800] text-[#00224f] hover:text-[#006ce4] transition-all tracking-[-0.03em] line-clamp-1 uppercase">
      {title}
    </a>

    <!-- ২. সঠিক রেটিং এবং কাউন্ট (সরাসরি প্রপস থেকে) -->
    <div class="flex items-center gap-2 mt-0.5">
      <span class="text-[13px] font-[800] text-[#008234] tracking-tight">
        {rating || '5.0'}
      </span>
      <span class="text-[12px] text-slate-500 font-medium tracking-tight">
        ({reviewsCount} {reviewSuffix})
      </span>
    </div>
  </div>

  <!-- ৩. লোকেশন -->
  <div class="mt-1 flex items-center gap-1 text-[12px] text-slate-500 font-medium tracking-tight">
    <svg class="w-3.5 h-3.5 text-slate-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
    </svg>
    <span class="line-clamp-1">{address}</span>
  </div>

  <!-- ৪. অ্যামেনিটিস (এক লাইনে) -->
  {displayAmenities.length > 0 && (
    <div class="mt-1 flex items-center overflow-hidden whitespace-nowrap opacity-90">
      <div class="flex items-center gap-1.5 flex-nowrap">
        {displayAmenities.map((name, index) => (
          <div class="flex items-center gap-1.5">
            <span class="text-[10px] font-[700] text-[#008234] uppercase tracking-wide">{name}</span>
            {index < displayAmenities.length - 1 && (
              <span class="w-0.5 h-0.5 rounded-full bg-slate-300"></span>
            )}
          </div>
        ))}
      </div>
    </div>
  )}

  <!-- ৫. গেস্ট রিভিউ বক্স -->
  <div class="mt-2.5 relative border-l-[3px] border-slate-100 pl-3">
    <p class="text-[13px] text-slate-700 leading-[1.5] italic font-medium tracking-tight">
      <span class="review-short">“{reviewShort || fallbackAbout}”</span>
      {hasMoreReview && (
        <>
          <span class="review-full hidden">“{reviewFull}”</span>
          <button type="button" class="toggle-review-btn font-[800] text-[#006ce4] hover:underline ml-1 not-italic cursor-pointer">See more</button>
        </>
      )}
    </p>
  </div>

  <!-- ৬. মোবাইল ফুটার (Compact) -->
  <div class="md:hidden flex items-center justify-between mt-3 pt-2 border-t border-slate-50">
     <div class="flex items-center gap-2">
        <div class="bg-[#003580] text-white font-[800] text-[12px] px-1.5 py-0.5 rounded-sm shadow-sm leading-none">{rating || '5.0'}</div>
        <div class="flex flex-col leading-tight">
          <span class="text-[11px] font-[700] text-[#00224f] tracking-tight">{ratingLabel}</span>
          <span class="text-[9px] text-slate-400 font-bold uppercase">{reviewsCount} Reviews</span>
        </div>
     </div>
     <span class="text-[9px] font-black text-[#008234] uppercase tracking-widest bg-emerald-50 px-1.5 py-0.5 rounded border border-emerald-100">Verified</span>
  </div>
</div>

<script>
  // See more toggle logic
  const init = () => {
    document.querySelectorAll('.toggle-review-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        const container = (e.target as HTMLElement).closest('.hotel-info');
        const short = container?.querySelector('.review-short');
        const full = container?.querySelector('.review-full');
        if (full?.classList.contains('hidden')) {
          full.classList.remove('hidden');
          short?.classList.add('hidden');
          (e.target as HTMLElement).innerText = 'Show less';
        } else {
          full?.classList.add('hidden');
          short?.classList.remove('hidden');
          (e.target as HTMLElement).innerText = 'See more';
        }
      });
    });
  }
  init();
  document.addEventListener('astro:page-load', init);
</script>
