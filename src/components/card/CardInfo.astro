---
interface Props {
  title: string;
  url: string;
  stars: number;
  address: string;
  latestReview: any;
  fallbackAbout: string;
  rating: string | null;
  ratingLabel: string;
  reviewsCount: number;
}

const {
  title,
  url,
  stars,
  address,
  latestReview,
  fallbackAbout,
  rating,
  ratingLabel,
  reviewsCount
} = Astro.props;

// Review processing
let reviewShort = '';
let reviewFull = '';
let hasMoreReview = false;

if (latestReview?.comment) {
  const cleanComment = latestReview.comment.replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim();
  const words = cleanComment.split(/\s+/).filter(Boolean);
  reviewFull = cleanComment;

  // TripAdvisor style compact review (short and sweet)
  if (words.length > 20) {
    reviewShort = words.slice(0, 20).join(' ') + '...';
    hasMoreReview = true;
  } else {
    reviewShort = cleanComment;
  }
}

// TripAdvisor-style distance logic (Example: extract Area)
const isGulshan2 = address.toLowerCase().includes('gulshan 2') || address.toLowerCase().includes('gulshan-2');
const distanceLabel = isGulshan2 ? "Heart of Gulshan 2" : "Near Gulshan 1";
---

<div class="hotel-info flex-1 min-w-0 flex flex-col justify-between text-left">
  <div>
    <!-- TITLE & STARS (TripAdvisor Style) -->
    <div class="space-y-0.5">
      <div class="flex items-center justify-between gap-2">
        <a href={url} class="block text-[17px] sm:text-[19px] font-black text-[#00224f] hover:text-[#006ce4] transition-colors leading-tight line-clamp-1">
          {title}
        </a>
        
        {rating && Number(rating) >= 9.0 && (
          <span class="shrink-0 bg-emerald-600 text-white text-[9px] font-black px-1.5 py-0.5 rounded uppercase tracking-tighter shadow-sm">
            Top Rated
          </span>
        )}
      </div>

      <!-- Rating & Stars (Under title - TripAdvisor Style) -->
      <div class="flex items-center gap-2 mt-1">
        {stars > 0 && (
          <div class="flex text-[#febb02] text-[10px] sm:text-xs tracking-tighter">
            {'★'.repeat(stars)}
          </div>
        )}
        <div class="w-px h-3 bg-slate-200 hidden sm:block"></div>
        <div class="flex items-center gap-1">
           <span class="text-[11px] font-black text-slate-900">{rating || '5.0'}</span>
           <span class="text-[11px] text-slate-500 font-medium">({reviewsCount} reviews)</span>
        </div>
      </div>
    </div>

    <!-- LOCATION & DISTANCE (TripAdvisor Style) -->
    <div class="mt-2.5 space-y-1">
      <div class="flex items-start gap-1.5 text-[11px] sm:text-xs text-slate-600 font-medium leading-snug">
        <svg class="w-3.5 h-3.5 shrink-0 mt-0.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
        <span class="line-clamp-1">{address}</span>
      </div>
      
      <!-- Distance/Area Indicator (Trust Builder) -->
      <div class="flex items-center gap-1.5 ml-0.5">
        <div class="w-1 h-1 rounded-full bg-emerald-500"></div>
        <span class="text-[10px] font-bold text-emerald-700 uppercase tracking-wider">{distanceLabel}</span>
      </div>
    </div>

    <!-- COMPACT GUEST REVIEW (Booking.com Style) -->
    <div class="mt-4">
      {latestReview?.comment ? (
        <div class="review-box relative pl-3 border-l-2 border-slate-100 py-0.5">
          <div class="flex items-center gap-1.5 text-[10px] font-black uppercase text-slate-400 tracking-tight mb-1">
            <span class="text-emerald-600">“</span>
            <span>Guest Review</span>
          </div>
          
          <p class="text-[12px] sm:text-[13px] text-slate-700 leading-relaxed italic font-medium">
            <span class="review-short">“{reviewShort}”</span>
            {hasMoreReview && (
              <>
                <span class="review-full hidden">“{reviewFull}”</span>
                <button type="button" class="toggle-review-btn font-black text-[#006ce4] hover:underline not-italic ml-1 text-[11px]">See more</button>
              </>
            )}
          </p>

          <div class="mt-1 text-[10px] font-bold text-slate-400">— {latestReview.name}</div>
        </div>
      ) : (
        <p class="text-[11px] sm:text-xs text-slate-500 leading-relaxed line-clamp-2 border-l-2 border-slate-50 pl-3 italic opacity-80">
          {fallbackAbout}
        </p>
      )}
    </div>
  </div>

  <!-- MOBILE SCORE (Hidden on Desktop) -->
  <div class="md:hidden flex items-center justify-between mt-4 pt-3 border-t border-slate-50">
    <div class="flex items-center gap-2">
      <div class="bg-[#003580] text-white font-black text-xs px-2 py-1 rounded-sm leading-none shadow-sm">{rating || '5.0'}</div>
      <div class="flex flex-col">
        <span class="text-[11px] font-bold text-slate-900">{ratingLabel}</span>
        <span class="text-[9px] text-slate-400 font-bold uppercase">{reviewsCount} reviews</span>
      </div>
    </div>
    <span class="text-[10px] font-black text-emerald-700 uppercase tracking-tighter">Verified Stay</span>
  </div>
</div>

<script>
  const setupReviewToggles = () => {
    document.querySelectorAll('.toggle-review-btn').forEach(btn => {
      btn.onclick = (e) => {
        e.preventDefault();
        const box = (e.target as HTMLElement).closest('.review-box');
        const short = box?.querySelector('.review-short');
        const full = box?.querySelector('.review-full');
        
        if (full?.classList.contains('hidden')) {
          full.classList.remove('hidden');
          short?.classList.add('hidden');
          (e.target as HTMLElement).innerText = 'Show less';
        } else {
          full?.classList.add('hidden');
          short?.classList.remove('hidden');
          (e.target as HTMLElement).innerText = 'See more';
        }
      };
    });
  };
  setupReviewToggles();
  document.addEventListener('astro:page-load', setupReviewToggles);
</script>
