---
interface Props {
  title: string;
  url: string;
  stars: number;
  address: string;
  latestReview: any;
  fallbackAbout: string;
  rating: string | null;
  ratingLabel: string;
  reviewsCount: number;
}

const {
  title,
  url,
  stars,
  address,
  latestReview,
  fallbackAbout,
  rating,
  ratingLabel,
  reviewsCount
} = Astro.props;

// Review processing
let reviewShort = '';
let reviewFull = '';
let hasMoreReview = false;

if (latestReview?.comment) {
  const cleanComment = latestReview.comment
    .replace(/<[^>]+>/g, ' ')
    .replace(/\s+/g, ' ')
    .trim();

  const words = cleanComment.split(/\s+/).filter(Boolean);

  reviewFull = cleanComment;

  // Compact review = better card height
  if (words.length > 22) {
    reviewShort = words.slice(0, 22).join(' ') + '...';
    hasMoreReview = true;
  } else {
    reviewShort = cleanComment;
  }
}
---

<div class="hotel-info flex-1 min-w-0 flex flex-col justify-between text-left">

  <!-- HOTEL TITLE -->
  <div>

    <div class="flex items-start justify-between gap-2">

      <div class="min-w-0">
        <a
          href={url}
          class="card-hotel-link block text-[17px] sm:text-lg md:text-xl
                 font-extrabold text-[#0b1f3a]
                 hover:text-[#006ce4]
                 transition-colors duration-200
                 leading-tight line-clamp-2"
        >
          {title}
        </a>

        <!-- Stars -->
        {stars > 0 && (
          <div
            class="flex items-center gap-[2px] mt-1"
            aria-label={`${stars} star hotel`}
          >
            {'★'.repeat(stars)}
          </div>
        )}
      </div>

      <!-- TOP RATED -->
      {rating && Number(rating) >= 8.5 && (
        <span
          class="shrink-0 inline-flex items-center
                 rounded-md bg-emerald-50
                 border border-emerald-200
                 px-2 py-1
                 text-[9px] sm:text-[10px]
                 font-extrabold uppercase
                 tracking-wide text-emerald-700"
        >
          Top Rated
        </span>
      )}

    </div>


    <!-- LOCATION -->
    <div
      class="flex items-start gap-1.5 mt-2
             text-[11px] sm:text-xs
             text-slate-500 font-medium leading-snug"
    >

      <svg
        class="w-4 h-4 shrink-0 mt-[1px] text-[#64748b]"
        viewBox="0 0 24 24"
        fill="currentColor"
        aria-hidden="true"
      >
        <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5S10.62 6.5 12 6.5s2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
      </svg>

      <span
        class="card-hotel-address line-clamp-1"
      >
        {address}
      </span>

    </div>


    <!-- GUEST REVIEW -->
    <div class="mt-3">

      {latestReview?.comment ? (

        <div
          class="review-snippet-box
                 rounded-lg
                 bg-slate-50/80
                 border border-slate-100
                 px-3 py-2.5"
        >

          <!-- Label -->
          <div
            class="flex items-center gap-1.5
                   text-[9px] sm:text-[10px]
                   font-extrabold
                   uppercase tracking-wider
                   text-emerald-700
                   mb-1"
          >

            <span
              class="flex items-center justify-center
                     w-4 h-4 rounded-full
                     bg-emerald-100
                     text-emerald-700
                     text-[11px]"
            >
              ✓
            </span>

            <span>Guest says</span>

            {reviewsCount > 0 && (
              <span class="text-slate-400 normal-case tracking-normal">
                · {reviewsCount} reviews
              </span>
            )}

          </div>


          <!-- Review text -->
          <div
            class="text-[11px] sm:text-[12px]
                   text-slate-700
                   italic
                   leading-relaxed"
          >

            <span class="review-short">
              “{reviewShort}”
            </span>

            {hasMoreReview && (
              <>
                <span class="review-full hidden">
                  “{reviewFull}”
                </span>

                <button
                  type="button"
                  class="toggle-review-btn
                         ml-1
                         font-bold
                         text-[#006ce4]
                         hover:text-[#003b95]
                         hover:underline
                         not-italic
                         whitespace-nowrap"
                >
                  See more
                </button>
              </>
            )}

          </div>


          <!-- Reviewer -->
          {latestReview.name && (
            <div
              class="mt-1.5
                     text-[9px] sm:text-[10px]
                     font-semibold
                     text-slate-400"
            >
              {latestReview.name}

              {latestReview.date && (
                <span class="font-normal">
                  · {latestReview.date}
                </span>
              )}
            </div>
          )}

        </div>

      ) : (

        <div
          class="rounded-lg
                 bg-slate-50
                 border border-slate-100
                 px-3 py-2.5"
        >

          <div
            class="text-[9px]
                   font-extrabold
                   uppercase tracking-wider
                   text-slate-400
                   mb-1"
          >
            About this hotel
          </div>

          <p
            class="text-[11px] sm:text-xs
                   text-slate-600
                   leading-relaxed
                   line-clamp-2"
          >
            {fallbackAbout ||
              "Explore this property for your next stay. High-quality service and great amenities await."}
          </p>

        </div>

      )}

    </div>

  </div>


  <!-- RATING -->
  <div
    class="md:hidden
           flex items-center justify-between
           mt-3 pt-2.5
           border-t border-slate-100"
  >

    {rating ? (

      <div class="flex items-center gap-2">

        <!-- SCORE -->
        <div
          class="flex items-center justify-center
                 min-w-[38px] h-[30px]
                 rounded-md
                 bg-[#0b3b78]
                 text-white
                 font-extrabold
                 text-[12px]"
        >
          {rating}
        </div>


        <!-- LABEL -->
        <div class="leading-tight">

          <div
            class="text-[11px]
                   font-bold
                   text-[#0b1f3a]"
          >
            {ratingLabel}
          </div>

          <div
            class="text-[9px]
                   text-slate-500
                   font-medium"
          >
            {reviewsCount} {reviewsCount === 1 ? 'review' : 'reviews'}
          </div>

        </div>

      </div>

    ) : (

      <span
        class="inline-flex items-center
               rounded-md
               bg-slate-100
               px-2 py-1
               text-[10px]
               font-bold
               text-slate-500"
      >
        New to GulshanHotels
      </span>

    )}

  </div>

</div>


<script>
  const initReviewToggle = () => {
    document.querySelectorAll('.toggle-review-btn').forEach((btn) => {

      // Prevent duplicate listeners
      if (btn.hasAttribute('data-review-ready')) return;

      btn.setAttribute('data-review-ready', 'true');

      btn.addEventListener('click', (event) => {

        event.preventDefault();
        event.stopPropagation();

        const button = event.currentTarget as HTMLElement;
        const box = button.closest('.review-snippet-box');

        if (!box) return;

        const shortText = box.querySelector('.review-short');
        const fullText = box.querySelector('.review-full');

        if (!shortText || !fullText) return;

        const expanded = !fullText.classList.contains('hidden');

        if (expanded) {

          fullText.classList.add('hidden');
          shortText.classList.remove('hidden');

          button.textContent = 'See more';

        } else {

          shortText.classList.add('hidden');
          fullText.classList.remove('hidden');

          button.textContent = 'Show less';

        }

      });

    });
  };

  initReviewToggle();

  document.addEventListener('astro:page-load', initReviewToggle);
</script>