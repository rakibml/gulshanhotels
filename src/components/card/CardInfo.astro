---
interface Props {
  title: string;
  url: string;
  stars: number;
  address: string;
  latestReview: any;
  fallbackAbout: string;
  rating: string | null;
  ratingLabel: string;
  reviewsCount: number;
}

const {
  title,
  url,
  stars,
  address,
  latestReview,
  fallbackAbout,
  rating,
  ratingLabel,
  reviewsCount
} = Astro.props;

let reviewWordsShort = '';
let reviewWordsFull = '';
let isReviewLonger = false;

if (latestReview?.comment) {
  const cleanComment = latestReview.comment
    .replace(/<[^>]+>/g, ' ')
    .replace(/\s+/g, ' ')
    .trim();

  const words = cleanComment.split(/\s+/).filter(Boolean);

  reviewWordsFull = cleanComment;

  if (words.length > 22) {
    reviewWordsShort = words.slice(0, 22).join(' ') + '...';
    isReviewLonger = true;
  } else {
    reviewWordsShort = cleanComment;
  }
}
---

<div class="flex-1 min-w-0 pr-0 md:pr-3 text-left">

  <!-- TITLE -->
  <div class="flex items-center gap-1.5 min-w-0">

    <a
      href={url}
      class="
        card-hotel-link
        text-[17px] sm:text-lg md:text-xl
        font-black
        text-[#0b1f3a]
        hover:text-[#006ce4]
        transition
        line-clamp-1
        leading-tight
        min-w-0
      "
    >
      {title}
    </a>

    {stars > 0 && (
      <div
        class="
          flex shrink-0
          text-[#febb02]
          text-[10px] sm:text-xs
          leading-none
        "
      >
        {'★'.repeat(stars)}
      </div>
    )}

  </div>


  <!-- ADDRESS -->
  <div
    class="
      flex items-center
      gap-1
      mt-1
      text-[11px] sm:text-xs
      text-slate-500
      font-medium
      leading-tight
    "
  >

    <svg
      class="w-3.5 h-3.5 shrink-0 text-slate-500"
      viewBox="0 0 24 24"
      fill="currentColor"
      aria-hidden="true"
    >
      <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5S10.62 6.5 12 6.5s2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
    </svg>

    <span class="card-hotel-address line-clamp-1">
      {address}
    </span>

  </div>


  <!-- REVIEW -->
  <div class="mt-2.5">

    {latestReview?.comment ? (

      <div
        class="
          review-snippet-box
          rounded-lg
          bg-slate-50
          border border-slate-100
          px-2.5 py-2
        "
      >

        <!-- Review label -->
        <div
          class="
            flex items-center
            gap-1.5
            text-[9px]
            font-extrabold
            uppercase
            tracking-wide
            text-emerald-700
            mb-0.5
          "
        >

          <span
            class="
              flex items-center justify-center
              w-4 h-4
              rounded-full
              bg-emerald-100
              text-emerald-700
              text-[10px]
              shrink-0
            "
          >
            ✓
          </span>

          <span>Guest says</span>

          <span class="text-slate-400 normal-case tracking-normal">
            · {reviewsCount} reviews
          </span>

        </div>


        <!-- Review -->
        <div
          class="
            text-[11px] sm:text-[12px]
            text-slate-700
            italic
            leading-[1.45]
          "
        >

          <span class="review-short">
            “{reviewWordsShort}”
          </span>

          {isReviewLonger && (
            <>
              <span class="review-full hidden">
                “{reviewWordsFull}”
              </span>

              <button
                type="button"
                class="
                  toggle-review-btn
                  ml-1
                  text-[#006ce4]
                  font-bold
                  not-italic
                  whitespace-nowrap
                "
              >
                See more
              </button>
            </>
          )}

        </div>


        <!-- Reviewer -->
        {latestReview.name && (
          <div
            class="
              mt-1
              text-[9px]
              text-slate-400
              font-medium
              leading-none
            "
          >
            {latestReview.name}

            {latestReview.date && (
              <span> · {latestReview.date}</span>
            )}
          </div>
        )}

      </div>

    ) : (

      <p
        class="
          text-[11px] sm:text-xs
          text-slate-500
          leading-[1.45]
          line-clamp-2
          italic
        "
      >
        {fallbackAbout ||
          "Explore this property for your next stay. High-quality service and great amenities await."}
      </p>

    )}

  </div>


  <!-- MOBILE RATING -->
  <div
    class="
      md:hidden
      flex items-center
      gap-2
      mt-2
      pt-2
      border-t border-slate-100
    "
  >

    {rating ? (

      <div class="flex items-center gap-2">

        <div
          class="
            flex items-center justify-center
            min-w-[36px]
            h-[29px]
            rounded-md
            bg-[#0b3b78]
            text-white
            text-[11px]
            font-black
          "
        >
          {rating}
        </div>

        <div class="leading-none">

          <div
            class="
              text-[11px]
              font-bold
              text-[#0b1f3a]
            "
          >
            {ratingLabel}
          </div>

          <div
            class="
              text-[9px]
              text-slate-500
              mt-0.5
            "
          >
            {reviewsCount} reviews
          </div>

        </div>

      </div>

    ) : (

      <span
        class="
          text-[9px]
          font-bold
          text-slate-500
          bg-slate-100
          rounded-md
          px-2 py-1
        "
      >
        New to GulshanHotels
      </span>

    )}

  </div>

</div>


<script>
  const initToggle = () => {
    document.querySelectorAll('.toggle-review-btn').forEach((btn) => {

      if (btn.hasAttribute('data-ready')) return;

      btn.setAttribute('data-ready', 'true');

      btn.addEventListener('click', (e) => {

        e.preventDefault();
        e.stopPropagation();

        const button = e.currentTarget as HTMLElement;
        const box = button.closest('.review-snippet-box');

        if (!box) return;

        const shortEl = box.querySelector('.review-short');
        const fullEl = box.querySelector('.review-full');

        if (!shortEl || !fullEl) return;

        const expanded = !fullEl.classList.contains('hidden');

        if (expanded) {
          fullEl.classList.add('hidden');
          shortEl.classList.remove('hidden');
          button.textContent = 'See more';
        } else {
          shortEl.classList.add('hidden');
          fullEl.classList.remove('hidden');
          button.textContent = 'Show less';
        }

      });

    });
  };

  initToggle();
  document.addEventListener('astro:page-load', initToggle);
</script>