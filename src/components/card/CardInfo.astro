---
interface Props {
  title: string;
  url: string;
  stars: number;
  address: string;
  latestReview: any;
  fallbackAbout: string;
  rating: string | null;
  ratingLabel: string;
  reviewsCount: number;
}

const {
  title,
  url,
  stars,
  address,
  latestReview,
  fallbackAbout,
  rating,
  ratingLabel,
  reviewsCount
} = Astro.props;

// Review processing - Compact for professional look
let reviewShort = '';
let reviewFull = '';
let hasMoreReview = false;

if (latestReview?.comment) {
  const cleanComment = latestReview.comment.replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim();
  const words = cleanComment.split(/\s+/).filter(Boolean);
  reviewFull = cleanComment;

  if (words.length > 22) {
    reviewShort = words.slice(0, 22).join(' ') + '...';
    hasMoreReview = true;
  } else {
    reviewShort = cleanComment;
  }
}

// Location indicator logic
const isGulshan2 = address.toLowerCase().includes('gulshan 2') || address.toLowerCase().includes('gulshan-2');
const locationContext = isGulshan2 ? "Gulshan 2, Dhaka" : "Gulshan 1, Dhaka";
---

<div class="hotel-info flex-1 min-w-0 flex flex-col justify-between text-left font-['Plus_Jakarta_Sans',sans-serif]">
  <div>
    <!-- ১. টাইটেল এবং স্টারস (TripAdvisor Style) -->
    <div class="space-y-1">
      <div class="flex items-start justify-between gap-3">
        <a href={url} class="block text-[18px] sm:text-[20px] font-[800] text-[#00224f] hover:text-[#006ce4] transition-all leading-[1.2] tracking-[-0.03em] line-clamp-1">
          {title}
        </a>
        
        {rating && Number(rating) >= 9.0 && (
          <span class="shrink-0 bg-[#008234] text-white text-[9px] font-[800] px-2 py-0.5 rounded-sm uppercase tracking-widest shadow-sm">
            Top Rated
          </span>
        )}
      </div>

      <!-- ২. রেটিং স্কোর ও রিভিউ কাউন্ট (TripAdvisor Style Dots) -->
      <div class="flex items-center gap-2 mt-1.5">
        <div class="flex items-center gap-1">
          <!-- TripAdvisor Style Score Color -->
          <span class="text-[13px] font-[800] text-[#008234] tracking-tight">{rating || '5.0'}</span>
          <div class="flex text-[#008234] text-[10px] tracking-[-1px]">
            {'●'.repeat(5)}
          </div>
        </div>
        <span class="text-[12px] text-slate-500 font-medium tracking-tight">({reviewsCount} reviews)</span>
        
        {stars > 0 && (
          <>
            <span class="text-slate-300">•</span>
            <div class="flex text-[#febb02] text-[10px] tracking-[-1px]">
               {'★'.repeat(stars)}
            </div>
          </>
        )}
      </div>
    </div>

    <!-- ৩. লোকেশন এবং দূরত্ব (Proximity Indicator) -->
    <div class="mt-3.5 space-y-1.5">
      <div class="flex items-center gap-1.5 text-[12px] text-slate-600 font-medium tracking-tight">
        <svg class="w-4 h-4 text-slate-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
        </svg>
        <span class="line-clamp-1">{address}</span>
      </div>
      
      <!-- TripAdvisor-style Badge -->
      <div class="flex items-center gap-2">
        <div class="w-1.5 h-1.5 rounded-full bg-[#008234]"></div>
        <span class="text-[11px] font-[700] text-[#008234] uppercase tracking-wide">Best Value in {locationContext}</span>
      </div>
    </div>

    <!-- ৪. গেস্ট রিভিউ (Booking.com Style Bordered Snippet) -->
    <div class="mt-4 relative pl-3.5 border-l-[3px] border-slate-100 py-0.5">
      <div class="flex items-center gap-2 text-[10px] font-[800] uppercase text-slate-400 tracking-widest mb-1.5">
        <span class="text-[#008234] text-xs">“</span>
        <span>Latest Guest Review</span>
      </div>
      
      <p class="text-[13px] text-slate-700 leading-[1.6] italic font-medium tracking-tight">
        <span class="review-short">“{reviewShort}”</span>
        {hasMoreReview && (
          <>
            <span class="review-full hidden">“{reviewFull}”</span>
            <button type="button" class="toggle-review-btn font-[800] text-[#006ce4] hover:underline ml-1 not-italic cursor-pointer">See more</button>
          </>
        )}
      </p>
      
      {latestReview?.name && (
        <div class="mt-1.5 text-[11px] font-bold text-slate-400">— {latestReview.name}</div>
      )}
    </div>
  </div>

  <!-- ৫. মোবাইল স্কোর (ডেক্সটপে হাইড করা হয়েছে) -->
  <div class="md:hidden flex items-center justify-between mt-4 pt-3.5 border-t border-slate-100">
     <div class="flex items-center gap-2.5">
        <div class="bg-[#003580] text-white font-[800] text-[13px] px-2 py-1 rounded-sm shadow-sm leading-none">{rating || '5.0'}</div>
        <div class="flex flex-col">
          <span class="text-[12px] font-[700] text-[#00224f] tracking-tight">{ratingLabel}</span>
          <span class="text-[10px] text-slate-400 font-bold uppercase tracking-tighter">{reviewsCount} Reviews</span>
        </div>
     </div>
     <span class="text-[10px] font-black text-[#008234] uppercase tracking-widest bg-emerald-50 px-2 py-1 rounded border border-emerald-100">Verified Stay</span>
  </div>
</div>

<script>
  const initReviewToggle = () => {
    document.querySelectorAll('.toggle-review-btn').forEach(btn => {
      // Prevent multiple listeners
      if (btn.hasAttribute('data-initialized')) return;
      btn.setAttribute('data-initialized', 'true');

      btn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        
        const currentBtn = e.currentTarget as HTMLElement;
        const box = currentBtn.closest('.hotel-info');
        const short = box?.querySelector('.review-short');
        const full = box?.querySelector('.review-full');
        
        if (full?.classList.contains('hidden')) {
          full.classList.remove('hidden');
          short?.classList.add('hidden');
          currentBtn.innerText = 'Show less';
        } else {
          full?.classList.add('hidden');
          short?.classList.remove('hidden');
          currentBtn.innerText = 'See more';
        }
      });
    });
  };

  // Run on initial load and view transitions
  initReviewToggle();
  document.addEventListener('astro:page-load', initReviewToggle);
</script>

<style>
  /* এভাটার এবং টাইটেলের জন্য কাস্টম ট্র্যাকিং */
  .hotel-info a {
    font-feature-settings: "clig" 0, "calt" 0;
  }
</style>
