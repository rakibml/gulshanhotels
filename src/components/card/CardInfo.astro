---
interface Props {
  title: string;
  url: string;
  stars: number;
  address: string;
  latestReview: any;
  fallbackAbout: string;
  rating: string | null;
  ratingLabel: string;
  reviewsCount: number;
}

const {
  title,
  url,
  address,
  latestReview,
  fallbackAbout,
  rating,
  ratingLabel,
  reviewsCount
} = Astro.props;

// Review processing
let reviewShort = '';
let reviewFull = '';
let hasMoreReview = false;

if (latestReview?.comment) {
  const cleanComment = latestReview.comment.replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim();
  const words = cleanComment.split(/\s+/).filter(Boolean);
  reviewFull = cleanComment;

  if (words.length > 22) {
    reviewShort = words.slice(0, 22).join(' ') + '...';
    hasMoreReview = true;
  } else {
    reviewShort = cleanComment;
  }
}

const isGulshan2 = address.toLowerCase().includes('gulshan 2') || address.toLowerCase().includes('gulshan-2');
const locationContext = isGulshan2 ? "GULSHAN 2, DHAKA" : "GULSHAN 1, DHAKA";
---

<div class="hotel-info flex-1 min-w-0 flex flex-col justify-start text-left font-['Plus_Jakarta_Sans',sans-serif]">
  
  <!-- ১. টাইটেল (Top Rated badge বাদ দেওয়া হয়েছে) -->
  <div class="leading-tight">
    <a href={url} class="block text-[18px] sm:text-[20px] font-[800] text-[#00224f] hover:text-[#006ce4] transition-all tracking-[-0.03em] line-clamp-1">
      {title}
    </a>

    <!-- ২. রেটিং স্কোর ও রিভিউ কাউন্ট (Stars এবং Dots বাদ দেওয়া হয়েছে) -->
    <div class="flex items-center gap-2 mt-0.5">
      <span class="text-[13px] font-[800] text-[#008234] tracking-tight">{rating || '5.0'}</span>
      <span class="text-[12px] text-slate-500 font-medium tracking-tight">({reviewsCount} reviews)</span>
    </div>
  </div>

  <!-- ৩. লোকেশন এবং বেস্ট ভ্যালু (Green dot বাদ দেওয়া হয়েছে এবং স্পেস কমানো হয়েছে) -->
  <div class="mt-1.5 space-y-0.5">
    <div class="flex items-center gap-1 text-[12px] text-slate-600 font-medium tracking-tight">
      <svg class="w-3.5 h-3.5 text-slate-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
      </svg>
      <span class="line-clamp-1">{address}</span>
    </div>
    
    <div class="text-[11px] font-[700] text-[#008234] uppercase tracking-wide">
      Best Value in {locationContext}
    </div>
  </div>

  <!-- ৪. গেস্ট রিভিউ (Review Label এবং Name বাদ দেওয়া হয়েছে) -->
  <div class="mt-2 relative">
    <p class="text-[13px] text-slate-700 leading-[1.5] italic font-medium tracking-tight border-l-[3px] border-slate-100 pl-3">
      <span class="review-short">“{reviewShort || fallbackAbout}”</span>
      {hasMoreReview && (
        <>
          <span class="review-full hidden">“{reviewFull}”</span>
          <button type="button" class="toggle-review-btn font-[800] text-[#006ce4] hover:underline ml-1 not-italic cursor-pointer">See more</button>
        </>
      )}
    </p>
  </div>

  <!-- ৫. মোবাইল স্কোর (স্পেসিং অ্যাডজাস্ট করা হয়েছে) -->
  <div class="md:hidden flex items-center justify-between mt-3 pt-2 border-t border-slate-50">
     <div class="flex items-center gap-2">
        <div class="bg-[#003580] text-white font-[800] text-[12px] px-1.5 py-0.5 rounded-sm shadow-sm leading-none">{rating || '5.0'}</div>
        <div class="flex flex-col leading-tight">
          <span class="text-[11px] font-[700] text-[#00224f] tracking-tight">{ratingLabel}</span>
          <span class="text-[9px] text-slate-400 font-bold uppercase">{reviewsCount} Reviews</span>
        </div>
     </div>
     <span class="text-[9px] font-black text-[#008234] uppercase tracking-widest bg-emerald-50 px-1.5 py-0.5 rounded border border-emerald-100">Verified</span>
  </div>
</div>

<script>
  const initReviewToggle = () => {
    document.querySelectorAll('.toggle-review-btn').forEach(btn => {
      if (btn.hasAttribute('data-initialized')) return;
      btn.setAttribute('data-initialized', 'true');

      btn.addEventListener('click', (e) => {
        e.preventDefault();
        const currentBtn = e.currentTarget as HTMLElement;
        const box = currentBtn.closest('.hotel-info');
        const short = box?.querySelector('.review-short');
        const full = box?.querySelector('.review-full');
        
        if (full?.classList.contains('hidden')) {
          full.classList.remove('hidden');
          short?.classList.add('hidden');
          currentBtn.innerText = 'Show less';
        } else {
          full?.classList.add('hidden');
          short?.classList.remove('hidden');
          currentBtn.innerText = 'See more';
        }
      });
    });
  };

  initReviewToggle();
  document.addEventListener('astro:page-load', initReviewToggle);
</script>
