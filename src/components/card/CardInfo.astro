---
interface Props {
  image: string;
  title: string;
  url: string;
  stars: number;
  address: string;
  latestReview: any;
  displayPrice: string;
  displayOriginalPrice: string;
  discountPercent: number;
  rating: string | null;
  ratingLabel: string;
  reviewsCount: number;
}

const { 
  image, title, url, stars, address, latestReview, 
  displayPrice, displayOriginalPrice, discountPercent, 
  rating, ratingLabel, reviewsCount 
} = Astro.props;
---

<div class="group flex flex-col md:flex-row bg-white rounded-2xl border border-slate-200 overflow-hidden shadow-sm hover:shadow-md transition-all duration-300 mb-4">
  
  <!-- ১. ইমেজ সেকশন: মোবাইলে উপরে থাকবে, ডেক্সটপে বামে -->
  <div class="relative w-full md:w-64 lg:w-72 shrink-0 aspect-[16/10] md:aspect-auto overflow-hidden bg-slate-100">
    <img 
      src={image} 
      alt={title} 
      class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
    />
    
    <!-- উইশলিস্ট বাটন -->
    <button class="absolute top-3 right-3 w-8 h-8 rounded-full bg-white/90 backdrop-blur shadow flex items-center justify-center text-slate-700 hover:text-red-500 transition-colors z-10">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path></svg>
    </button>

    <!-- ডিসকাউন্ট ব্যাজ (ইমেজের ওপর) -->
    {discountPercent > 0 && (
      <div class="absolute bottom-3 left-3 bg-red-600 text-white text-[10px] font-black px-2 py-1 rounded shadow-lg uppercase tracking-wider">
        {discountPercent}% OFF
      </div>
    )}
  </div>

  <!-- ২. মেইন ইনফরমেশন সেকশন -->
  <div class="flex-1 p-4 sm:p-5 flex flex-col justify-between">
    <div class="space-y-1">
      <!-- টাইটেল এবং স্টার -->
      <div class="flex items-center gap-2 flex-wrap">
        <a href={url} class="text-base sm:text-xl font-black text-[#006ce4] hover:underline leading-tight">
          {title}
        </a>
        {stars > 0 && (
          <div class="flex text-[#febb02] text-[10px] sm:text-xs">
            {'★'.repeat(stars)}
          </div>
        )}
      </div>

      <!-- অ্যাড্রেস -->
      <p class="text-[11px] sm:text-sm text-slate-500 font-medium line-clamp-1">{address}</p>

      <!-- রিভিউ স্নাইপেট -->
      {latestReview && (
        <div class="mt-3 bg-slate-50 p-3 rounded-xl border border-slate-100">
          <p class="text-xs sm:text-sm text-slate-600 leading-relaxed italic line-clamp-2">
            "{latestReview.comment}"
          </p>
          <span class="block text-[10px] text-slate-400 mt-2 font-bold">— {latestReview.name}</span>
        </div>
      )}
    </div>

    <!-- ৩. প্রাইসিং এবং রেটিং (মোবাইলে এটি একটি সুন্দর ফুটারে থাকবে) -->
    <div class="mt-5 pt-4 border-t border-slate-100 flex items-center justify-between gap-4">
      
      <!-- রেটিং ব্যাজ -->
      <div class="flex items-center gap-2">
        <div class="bg-[#003b95] text-white font-black text-sm px-2 py-1 rounded-t-lg rounded-br-lg shadow-sm">
          {rating}
        </div>
        <div class="flex flex-col">
          <span class="text-[11px] font-black text-slate-900 leading-none">{ratingLabel}</span>
          <span class="text-[9px] text-slate-400 font-bold uppercase mt-1">{reviewsCount} reviews</span>
        </div>
      </div>

      <!-- প্রাইস এবং বাটন -->
      <div class="flex items-center gap-3">
        <div class="text-right">
          {displayOriginalPrice && (
            <span class="text-[10px] sm:text-xs text-slate-400 line-through font-bold block leading-none">
              {displayOriginalPrice}
            </span>
          )}
          <span class="text-xl sm:text-2xl font-black text-[#008234] block leading-none mt-1">
            {displayPrice}
          </span>
        </div>

        <a 
          href={url}
          class="bg-[#006ce4] hover:bg-[#0057b8] text-white text-xs sm:text-sm font-black py-2.5 px-5 rounded-xl transition-all active:scale-95 shadow-lg shadow-blue-100 uppercase tracking-wider"
        >
          View
        </a>
      </div>
    </div>
  </div>

</div>
