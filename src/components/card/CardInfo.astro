---
interface Props {
  title: string;
  url: string;
  stars: number;
  address: string;
  latestReview: any;
  fallbackAbout: string;
  rating: string | null;
  ratingLabel: string;
  reviewsCount: number;
}

const { title, url, stars, address, latestReview, fallbackAbout, rating, ratingLabel, reviewsCount } = Astro.props;

// 35-Word Review Truncation Logic
let reviewWordsShort = '';
let reviewWordsFull = '';
let isReviewLongerThan35 = false;

if (latestReview && latestReview.comment) {
  const cleanComment = latestReview.comment.replace(/<[^>]+>/g, ' ').replace(/[#*`_~]/g, '').trim();
  const words = cleanComment.split(/\s+/).filter(Boolean);
  reviewWordsFull = cleanComment;
  if (words.length > 35) {
    reviewWordsShort = words.slice(0, 35).join(' ') + '...';
    isReviewLongerThan35 = true;
  } else {
    reviewWordsShort = cleanComment;
    isReviewLongerThan35 = false;
  }
}

const svgPin = `<svg class="w-4 h-4 fill-slate-600 shrink-0 mt-0.5" viewBox="0 0 24 24"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>`;
---

<div class="flex-1 flex flex-col justify-between min-w-0 pr-1 md:pr-3 text-left">
  <div>
    <!-- Title & Stars -->
    <div class="flex items-center gap-1.5 flex-wrap">
      <a href={url} class="card-hotel-link text-sm sm:text-lg md:text-xl font-extrabold text-[#006ce4] hover:text-[#003b95] hover:underline transition line-clamp-1 sm:line-clamp-none leading-snug">
        {title}
      </a>
      
      {stars > 0 && (
        <span class="text-[#febb02] text-xs sm:text-sm md:text-base tracking-tight shrink-0">
          {'★'.repeat(stars)}
        </span>
      )}
    </div>

    <!-- Address -->
    <div class="flex items-start gap-1.5 text-xs sm:text-sm text-slate-600 font-medium mt-1 sm:mt-1.5 leading-snug">
      <span set:html={svgPin} class="inline-flex shrink-0"></span>
      <span class="card-hotel-address hover:underline cursor-pointer line-clamp-1">{address}</span>
    </div>

    <!-- Latest Review or About Fallback -->
    {latestReview && latestReview.comment ? (
      <div class="review-snippet-box mt-2 sm:mt-2.5 text-xs sm:text-sm text-slate-700 leading-relaxed font-normal bg-transparent">
        <div class="flex items-center gap-1.5 text-[11px] sm:text-xs font-bold text-slate-700 mb-1">
          <span class="text-amber-500">★</span>
          <span>Latest Guest Experience:</span>
        </div>
        
        <p class="text-slate-600 leading-relaxed">
          <span class="review-short italic">“{reviewWordsShort}”</span>
          {isReviewLongerThan35 && (
            <span class="review-full italic hidden">“{reviewWordsFull}”</span>
          )}
          {isReviewLongerThan35 && (
            <button 
              type="button" 
              class="font-bold text-[#006ce4] hover:text-[#003b95] hover:underline ml-1 cursor-pointer inline-block"
              onclick="
                const box = this.closest('.review-snippet-box');
                const s = box.querySelector('.review-short');
                const f = box.querySelector('.review-full');
                if (f.classList.contains('hidden')) {
                  f.classList.remove('hidden');
                  s.classList.add('hidden');
                  this.textContent = 'Show less';
                } else {
                  f.classList.add('hidden');
                  s.classList.remove('hidden');
                  this.textContent = 'See more';
                }
              "
            >
              See more
            </button>
          )}
        </p>

        <span class="block text-[10px] sm:text-[11px] font-medium text-slate-400 mt-1">
          — {latestReview.name} {latestReview.date ? `(${latestReview.date})` : ''}
        </span>
      </div>
    ) : (
      <p class="text-xs sm:text-sm text-slate-600 mt-2 sm:mt-2.5 leading-relaxed line-clamp-2 md:line-clamp-3 hidden sm:block">
        {fallbackAbout}
      </p>
    )}
  </div>

  <!-- Mobile Inline Review Score Badge -->
  <div class="md:hidden flex items-center gap-1.5 mt-1.5">
    {rating ? (
      <>
        <div class="bg-[#003b95] text-white font-bold text-xs px-2 py-0.5 rounded leading-none shadow-2xs">
          {rating}
        </div>
        <span class="text-xs font-bold text-slate-800">{ratingLabel}</span>
        <span class="text-[11px] text-slate-500">({reviewsCount})</span>
      </>
    ) : (
      <span class="bg-slate-100 text-slate-600 text-[10px] font-bold px-2 py-0.5 rounded">
        New to site
      </span>
    )}
  </div>
</div>
