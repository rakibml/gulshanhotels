---
interface Props {
  displayPrice: string;
  displayOriginalPrice: string;
  discountPercent: number;
  rating: string | null;
  ratingLabel: string;
  reviewsCount: number;
  title: string;
}

const {
  displayPrice,
  displayOriginalPrice,
  discountPercent,
  title
} = Astro.props;
---

<div
  class="
    w-full md:w-52 lg:w-60
    shrink-0
    md:border-l md:border-slate-100
    md:pl-4
    pt-1.5 md:pt-0
    mt-1.5 md:mt-0
    border-t md:border-t-0
    flex flex-row md:flex-col
    justify-between
    items-center md:items-end
    gap-3
  "
>
  <!-- উপরের রেটিং সেকশনটি সম্পূর্ণ বাদ দেওয়া হয়েছে -->

  <!-- PRICE SECTION -->
  <div class="flex-1 md:w-full">
    <div
      class="
        flex items-center
        gap-2
        flex-wrap
        md:justify-end
      "
    >
      <div class="flex items-baseline gap-1">
        <span
          class="
            text-[26px] sm:text-3xl
            font-black
            text-[#087f3f]
            leading-none
            tracking-tight
          "
        >
          {displayPrice}
        </span>

        <span
          class="
            text-[10px]
            text-slate-400
            font-bold
          "
        >
          /night
        </span>
      </div>

      {displayOriginalPrice && (
        <span
          class="
            text-[12px]
            text-slate-400
            line-through
            font-bold
          "
        >
          {displayOriginalPrice}
        </span>
      )}

      {displayOriginalPrice && discountPercent > 0 && (
        <span
          class="
            rounded-md
            bg-red-50
            border border-red-100
            px-2 py-1
            text-[10px]
            font-black
            text-red-600
          "
        >
          {discountPercent}% OFF
        </span>
      )}
    </div>

    <!-- BEST RATE BADGE -->
    <div
      class="
        flex items-center
        gap-1
        mt-1
        md:justify-end
      "
    >
      <svg
        class="w-3.5 h-3.5 text-[#087f3f]"
        viewBox="0 0 24 24"
        fill="currentColor"
      >
        <path d="M12 2 4 5v6c0 5.25 3.41 10.17 8 11 4.59-.83 8-5.75 8-11V5l-8-3zm-1 14-3-3 1.41-1.41L11 13.17l3.59-3.58L16 11l-5 5z"/>
      </svg>
      <span
        class="
          text-[10px]
          font-bold
          text-[#087f3f]
          uppercase
          tracking-wider
        "
      >
        Best rate found
      </span>
    </div>
  </div>

  <!-- ACTION BUTTON (CTA) -->
  <button
    type="button"
    aria-label={`View ${title}`}
    class="
      open-quick-view-btn
      shrink-0
      bg-[#006ce4]
      hover:bg-[#0057b8]
      active:scale-[0.96]
      text-white
      text-[11px] sm:text-xs
      font-black
      py-2.5
      px-5
      sm:py-3.5
      rounded-xl
      transition-all
      whitespace-nowrap
      flex items-center
      justify-center
      gap-2
      shadow-lg shadow-blue-100
      uppercase
      tracking-widest
      md:w-full
    "
  >
    <span class="hidden sm:inline">VIEW HOTEL</span>
    <span class="sm:hidden">VIEW</span>
    <span class="text-sm">→</span>
  </button>
</div>

<style>
  /* ডেস্কটপে বাটনের উইডথ যাতে সুন্দর থাকে */
  @media (min-width: 768px) {
    .open-quick-view-btn {
      width: 100%;
    }
  }
</style>
