---
interface Props {
  displayPrice: string;
  displayOriginalPrice: string;
  discountPercent: number;
  rating: string | null;
  ratingLabel: string;
  reviewsCount: number;
  title: string;
}

const { 
  displayPrice, 
  displayOriginalPrice, 
  discountPercent, 
  rating, 
  ratingLabel, 
  reviewsCount, 
  title 
} = Astro.props;
---

<div class="w-full md:w-52 lg:w-60 shrink-0 md:border-l border-slate-100 md:pl-4 pt-3 md:pt-0 mt-3 md:mt-0 border-t md:border-t-0 flex flex-row md:flex-col justify-between items-end md:items-end gap-3">
  
  <!-- Rating Section (Desktop & Mobile) -->
  <div class="flex flex-col items-start md:items-end w-full md:w-auto">
    {rating ? (
      <div class="flex items-center gap-2">
        <div class="text-right hidden sm:block">
          <div class="text-xs sm:text-sm font-bold text-slate-900 leading-tight">{ratingLabel}</div>
          <div class="text-[10px] sm:text-xs text-slate-500 leading-tight">{reviewsCount} reviews</div>
        </div>
        <div class="bg-[#003b95] text-white font-bold text-sm sm:text-base px-2 py-1 rounded-t-lg rounded-br-lg shadow-sm">
          {rating}
        </div>
      </div>
    ) : (
      <div class="bg-slate-100 text-slate-600 text-[10px] font-bold px-2 py-1 rounded">
        New to site
      </div>
    )}

    <!-- Price Info (Visible on Mobile inside this flex) -->
    <div class="mt-2 md:mt-4 text-left md:text-right">
        {displayOriginalPrice && (
          <div class="flex items-center gap-1.5 justify-start md:justify-end leading-none mb-1">
            <span class="text-xs text-slate-400 line-through font-medium">
              {displayOriginalPrice}
            </span>
            {discountPercent > 0 && (
              <span class="text-[10px] font-bold text-white bg-red-600 px-1.5 py-0.5 rounded">
                -{discountPercent}%
              </span>
            )}
          </div>
        )}
    
        <span class="card-final-price text-xl sm:text-2xl font-black text-[#008234] block leading-tight">
          {displayPrice}
        </span>
        
        <span class="text-[10px] text-slate-500 font-medium block mt-1">
          Best rate found
        </span>
      </div>
  </div>

  <!-- Action Button -->
  <div class="flex flex-col justify-end h-full">
    <button 
      type="button" 
      class="open-quick-view-btn w-auto md:w-full bg-[#006ce4] hover:bg-[#0057b8] text-white text-xs sm:text-sm font-bold py-2.5 px-4 rounded-lg transition-all duration-200 inline-flex items-center justify-center gap-2 shadow-sm active:scale-95 whitespace-nowrap"
      aria-label={`Quick view of ${title}`}
    >
      <svg class="w-4 h-4 shrink-0 fill-current" viewBox="0 0 24 24">
        <path d="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"/>
      </svg>
      <span>Quick View</span>
    </button>
  </div>

</div>

<script>
  // Quick View Button logic (Example)
  const buttons = document.querySelectorAll('.open-quick-view-btn');
  buttons.forEach(button => {
    button.addEventListener('click', () => {
      console.log('Quick view clicked');
      // আপনার লজিক এখানে লিখুন
    });
  });
</script>
