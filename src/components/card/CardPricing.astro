---
interface Props {
  displayPrice: string;
  displayOriginalPrice: string;
  discountPercent: number;
  title: string;
}
const { displayPrice, displayOriginalPrice, discountPercent, title } = Astro.props;
---

<div class="flex flex-row md:flex-col justify-between items-center md:items-end gap-3 w-full">
  
  <!-- প্রাইস এরিয়া -->
  <div class="flex flex-col items-start md:items-end">
    
    <div class="flex items-center gap-2 flex-wrap md:justify-end">
      {displayOriginalPrice && (
        <span class="text-[13px] font-bold text-slate-400 line-through">{displayOriginalPrice}</span>
      )}
      {discountPercent > 0 && (
        <span class="bg-red-600 text-white text-[10px] font-black px-1.5 py-0.5 rounded-sm">-{discountPercent}%</span>
      )}
    </div>

    <div class="flex items-baseline gap-1 mt-1">
      <span class="text-2xl lg:text-3xl font-[800] text-[#008234] leading-none tracking-tighter">{displayPrice}</span>
      <span class="text-[10px] font-bold text-slate-400 uppercase">/night</span>
    </div>

    <div class="mt-2 flex items-center gap-1">
      <svg class="w-3.5 h-3.5 text-[#008234]" fill="currentColor" viewBox="0 0 24 24">
        <path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm-2 16l-4-4 1.41-1.41L10 14.17l6.59-6.59L18 9l-8 8z"/>
      </svg>
      <span class="text-[10px] font-bold text-[#008234] uppercase tracking-wider">Best rate found</span>
    </div>
  </div>

  <!-- বাটন এরিয়া -->
  <div class="md:w-full md:mt-4">
    <button class="open-quick-view-btn group bg-[#006ce4] hover:bg-[#0057b8] text-white py-3 px-5 md:w-full rounded-2xl transition-all shadow-md active:scale-95 flex items-center justify-center gap-2">
      <span class="text-[11px] font-bold uppercase tracking-widest">View Hotel</span>
      <svg class="w-4 h-4 transform group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="3">
        <path d="M13 7l5 5m0 0l-5 5m5-5H6" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>
  </div>

</div>

<style>
  /* সংখ্যাগুলোকে সুন্দরভাবে এলাইন করার জন্য */
  span {
    font-variant-numeric: tabular-nums;
    font-feature-settings: "lnum" 1;
  }

  /* ডেক্সটপে সাইডবার হিসেবে কাজ করার জন্য অতিরিক্ত স্টাইল */
  @media (min-width: 768px) {
    .open-quick-view-btn {
      min-height: 52px;
    }
  }
</style>
