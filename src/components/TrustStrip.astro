---
// src/components/TrustStrip.astro (High-Credibility Diplomatic & Booking Trust Strip)

const trustPillars = [
  {
    title: "Diplomatic-Grade Security",
    desc: "Dhaka's highest protected zone with 24/7 armed police patrols & CCTV surveillance.",
    icon: `<svg class="w-5 h-5 fill-emerald-800" viewBox="0 0 24 24"><path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm-2 16l-4-4 1.41-1.41L10 14.17l6.59-6.59L18 9l-8 8z"/></svg>`
  },
  {
    title: "18-Min Airport Link",
    desc: "Rapid direct transit via Dhaka Elevated Expressway with private hotel pickups.",
    icon: `<svg class="w-5 h-5 fill-emerald-800" viewBox="0 0 24 24"><path d="M21 16v-2l-8-5V3.5c0-.83-.67-1.5-1.5-1.5S10 2.67 10 3.5V9l-8 5v2l8-2.5V19l-2 1.5V22l3.5-1 3.5 1v-1.5L13 19v-5.5l8 2.5z"/></svg>`
  },
  {
    title: "100% Verified Local Rates",
    desc: "Direct hotel rates and verified partner deals with zero hidden checkout fees.",
    icon: `<svg class="w-5 h-5 fill-emerald-800" viewBox="0 0 24 24"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41L9 16.17z"/></svg>`
  },
  {
    title: "24/7 Local Concierge",
    desc: "Immediate WhatsApp assistance for embassy distances, airport cars & bookings.",
    icon: `<svg class="w-5 h-5 fill-emerald-800" viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12c0 1.82.49 3.53 1.34 5.01L2 22l5.13-1.32c1.44.78 3.08 1.23 4.87 1.23 5.52 0 10-4.48 10-10S17.52 2 12 2zm1 14h-2v-2h2v2zm0-4h-2V7h2v5z"/></svg>`
  }
];
---

<!-- QUICK TRUST STRIP -->
<section class="w-full bg-white py-8 border-b border-slate-100 text-slate-900">
  <div class="max-w-[1550px] mx-auto px-4 sm:px-8 lg:px-12">
    
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 lg:gap-8 items-start text-left">
      {trustPillars.map((item) => (
        <div class="flex items-start gap-4">
          <!-- Icon Container -->
          <div class="w-12 h-12 rounded-2xl bg-emerald-50 border border-emerald-100 flex items-center justify-center shrink-0">
            <Fragment set:html={item.icon} />
          </div>

          <!-- Text Details -->
          <div class="space-y-1">
            <h3 class="font-bold text-slate-900 text-sm sm:text-base leading-tight">
              {item.title}
            </h3>
            <p class="text-xs text-slate-500 font-normal leading-relaxed">
              {item.desc}
            </p>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
