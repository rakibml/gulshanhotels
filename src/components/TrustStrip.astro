---
// src/components/TrustStrip.astro
// Only claims that are true and easy to check.

const trustPillars = [
  {
    title: "Central Gulshan Location",
    shortTitle: "Central Location",
    desc: "Near restaurants, offices and embassies",
    fullDesc: "Gulshan is a well-known central area of Dhaka with many hotels, restaurants, offices, and embassies close by.",
    icon: `<svg aria-hidden="true" class="w-4 h-4 sm:w-5 sm:h-5 fill-emerald-800 shrink-0" viewBox="0 0 24 24"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>`
  },
  {
    title: "Close to the Airport",
    shortTitle: "Near the Airport",
    desc: "About 8-12 km from DAC",
    fullDesc: "Gulshan is roughly 8 to 12 km from Hazrat Shahjalal International Airport. Travel time depends on traffic, so check a live map.",
    icon: `<svg aria-hidden="true" class="w-4 h-4 sm:w-5 sm:h-5 fill-emerald-800 shrink-0" viewBox="0 0 24 24"><path d="M21 16v-2l-8-5V3.5c0-.83-.67-1.5-1.5-1.5S10 2.67 10 3.5V9l-8 5v2l8-2.5V19l-2 1.5V22l3.5-1 3.5 1v-1.5L13 19v-5.5l8 2.5z"/></svg>`
  },
  {
    title: "Approximate Prices",
    shortTitle: "Price Guide",
    desc: "Check the hotel for the final rate",
    fullDesc: "Prices come from the hotels' own pages or public booking sites and can change. Always confirm the final price with the hotel.",
    icon: `<svg aria-hidden="true" class="w-4 h-4 sm:w-5 sm:h-5 fill-emerald-800 shrink-0" viewBox="0 0 24 24"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>`
  },
  {
    title: "Questions? Contact Us",
    shortTitle: "Contact Us",
    desc: "Send us a message",
    fullDesc: "Have a question about a hotel listed here? Send us a message from the contact page.",
    icon: `<svg aria-hidden="true" class="w-4 h-4 sm:w-5 sm:h-5 fill-emerald-800 shrink-0" viewBox="0 0 24 24"><path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/></svg>`
  }
];
---

<section class="w-full bg-white py-4 sm:py-6 border-b border-slate-200/80 text-slate-900" aria-labelledby="trust-strip-title">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-0">

    <div class="text-left mb-3">
      <h2 id="trust-strip-title" class="text-[11px] sm:text-xs font-black uppercase tracking-widest text-emerald-800 flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-emerald-600 inline-block shrink-0" aria-hidden="true"></span>
        <span>A Quick Guide to Staying in Gulshan</span>
      </h2>
    </div>

    <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4 lg:gap-6 items-stretch text-left">
      {trustPillars.map((item) => (
        <div class="flex items-start gap-2.5 sm:gap-3.5 p-3 sm:p-4 rounded-2xl bg-slate-50/80 border border-slate-200/90 transition-all duration-200 group">

          <div class="w-8 h-8 sm:w-10 sm:h-10 rounded-xl bg-white border border-slate-200 flex items-center justify-center shrink-0 shadow-2xs">
            <Fragment set:html={item.icon} />
          </div>

          <div class="min-w-0 flex-1">
            <h3 class="font-black text-slate-900 text-xs sm:text-sm leading-snug">
              <span class="hidden sm:inline">{item.title}</span>
              <span class="inline sm:hidden">{item.shortTitle}</span>
            </h3>

            <p class="text-[10px] sm:text-xs text-slate-600 font-medium leading-tight mt-1 sm:hidden">
              {item.desc}
            </p>

            <p class="text-xs text-slate-600 font-normal leading-relaxed mt-1 hidden sm:block">
              {item.fullDesc}
            </p>
          </div>

        </div>
      ))}
    </div>

  </div>
</section>
