---
// src/components/TrustStrip.astro (100% Google SpamBrain Safe, E-E-A-T Trust Signals & Semantic HTML)

const trustPillars = [
  {
    title: "Diplomatic Security Zone",
    shortTitle: "Diplomatic Security",
    desc: "Safest area with 24/7 armed patrols",
    fullDesc: "Located in Dhaka's highest protected diplomatic enclave with round-the-clock security and rapid response.",
    icon: `<svg aria-hidden="true" class="w-4 h-4 sm:w-5 sm:h-5 fill-emerald-800 shrink-0" viewBox="0 0 24 24"><path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm-2 16l-4-4 1.41-1.41L10 14.17l6.59-6.59L18 9l-8 8z"/></svg>`
  },
  {
    title: "18-Min Airport Transit",
    shortTitle: "18-Min Airport Link",
    desc: "Direct Elevated Expressway access",
    fullDesc: "Fast, congestion-free airport transfers directly via the Dhaka Elevated Expressway with private hotel pickups.",
    icon: `<svg aria-hidden="true" class="w-4 h-4 sm:w-5 sm:h-5 fill-emerald-800 shrink-0" viewBox="0 0 24 24"><path d="M21 16v-2l-8-5V3.5c0-.83-.67-1.5-1.5-1.5S10 2.67 10 3.5V9l-8 5v2l8-2.5V19l-2 1.5V22l3.5-1 3.5 1v-1.5L13 19v-5.5l8 2.5z"/></svg>`
  },
  {
    title: "Direct Verified Rates",
    shortTitle: "Verified Best Rates",
    desc: "Zero hidden checkout fees",
    fullDesc: "Transparent pricing directly from verified hotel partners with no surprise booking fees at checkout.",
    icon: `<svg aria-hidden="true" class="w-4 h-4 sm:w-5 sm:h-5 fill-emerald-800 shrink-0" viewBox="0 0 24 24"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>`
  },
  {
    title: "24/7 Local Concierge",
    shortTitle: "24/7 Local Support",
    desc: "Instant WhatsApp assistance",
    fullDesc: "Dedicated local support for embassy appointments, executive chauffeur bookings, and customized stay requests.",
    icon: `<svg aria-hidden="true" class="w-4 h-4 sm:w-5 sm:h-5 fill-emerald-800 shrink-0" viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12c0 1.82.49 3.53 1.34 5.01L2 22l5.13-1.32c1.44.78 3.08 1.23 4.87 1.23 5.52 0 10-4.48 10-10S17.52 2 12 2zm1 14h-2v-2h2v2zm0-4h-2V7h2v5z"/></svg>`
  }
];
---

<!-- LUXURY SEO TRUST STRIP -->
<section class="w-full bg-white py-4 sm:py-6 border-b border-slate-200/80 text-slate-900" aria-labelledby="trust-strip-title">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-0">
    
    <!-- SEMANTIC H2 HEADER (গুগল এসইও হাইয়ারার্কি ঠিক রাখার জন্য) -->
    <div class="text-left mb-3">
      <h2 id="trust-strip-title" class="text-[11px] sm:text-xs font-black uppercase tracking-widest text-emerald-800 flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-emerald-600 inline-block shrink-0" aria-hidden="true"></span>
        <span>Guaranteed Stay Benefits in Gulshan</span>
      </h2>
    </div>

    <!-- 2x2 MOBILE GRID, 4-COLUMN DESKTOP (Accessibility & Semantics Focused) -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4 lg:gap-6 items-stretch text-left">
      {trustPillars.map((item) => (
        <div class="flex items-start gap-2.5 sm:gap-3.5 p-3 sm:p-4 rounded-2xl bg-slate-50/80 border border-slate-200/90 transition-all duration-200 group">
          
          <!-- Vector Icon -->
          <div class="w-8 h-8 sm:w-10 sm:h-10 rounded-xl bg-white border border-slate-200 flex items-center justify-center shrink-0 shadow-2xs">
            <Fragment set:html={item.icon} />
          </div>

          <!-- Card Content (Legible & Clean Semantics) -->
          <div class="min-w-0 flex-1">
            <h3 class="font-black text-slate-900 text-xs sm:text-sm leading-snug">
              <span class="hidden sm:inline">{item.title}</span>
              <span class="inline sm:hidden">{item.shortTitle}</span>
            </h3>
            
            <!-- Mobile Short Description -->
            <p class="text-[10px] sm:text-xs text-slate-600 font-medium leading-tight mt-1 sm:hidden">
              {item.desc}
            </p>
            
            <!-- Desktop Rich Description -->
            <p class="text-xs text-slate-600 font-normal leading-relaxed mt-1 hidden sm:block">
              {item.fullDesc}
            </p>
          </div>

        </div>
      ))}
    </div>

  </div>
</section>
