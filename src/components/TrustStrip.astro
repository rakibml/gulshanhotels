---
// src/components/TrustStrip.astro (Keyword-Optimized for "Gulshan Hotel", "Gulshan Hotels", "Hotels in Gulshan")

const trustPillars = [
  {
    title: "Diplomatic Gulshan Hotels",
    shortTitle: "Diplomatic Hotels",
    desc: "Safest zone & 24/7 armed patrol",
    fullDesc: "Dhaka's highest protected diplomatic zone. Book verified luxury hotels in Gulshan with 24/7 armed police patrols.",
    link: "#hotels",
    icon: `<svg class="w-4 h-4 sm:w-5 sm:h-5 fill-emerald-800" viewBox="0 0 24 24"><path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm-2 16l-4-4 1.41-1.41L10 14.17l6.59-6.59L18 9l-8 8z"/></svg>`
  },
  {
    title: "18-Min to Gulshan Hotels",
    shortTitle: "18-Min Airport Link",
    desc: "Direct Elevated Expressway transit",
    fullDesc: "Rapid airport transit directly to your Gulshan hotel via Dhaka Elevated Expressway with private hotel pickups.",
    link: "#hotels",
    icon: `<svg class="w-4 h-4 sm:w-5 sm:h-5 fill-emerald-800" viewBox="0 0 24 24"><path d="M21 16v-2l-8-5V3.5c0-.83-.67-1.5-1.5-1.5S10 2.67 10 3.5V9l-8 5v2l8-2.5V19l-2 1.5V22l3.5-1 3.5 1v-1.5L13 19v-5.5l8 2.5z"/></svg>`
  },
  {
    title: "Best Gulshan Hotel Rates",
    shortTitle: "Verified Hotel Rates",
    desc: "Zero hidden checkout fees",
    fullDesc: "Direct verified rates for top hotels in Gulshan with 100% price transparency and zero hidden booking fees.",
    link: "#hotels",
    icon: `<svg class="w-4 h-4 sm:w-5 sm:h-5 fill-emerald-800" viewBox="0 0 24 24"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>`
  },
  {
    title: "24/7 Gulshan Concierge",
    shortTitle: "24/7 Local Support",
    desc: "Instant WhatsApp assistance",
    fullDesc: "Immediate local concierge assistance for embassy routes, airport cars, and booking the right Gulshan hotel.",
    link: "#hotels",
    icon: `<svg class="w-4 h-4 sm:w-5 sm:h-5 fill-emerald-800" viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12c0 1.82.49 3.53 1.34 5.01L2 22l5.13-1.32c1.44.78 3.08 1.23 4.87 1.23 5.52 0 10-4.48 10-10S17.52 2 12 2zm1 14h-2v-2h2v2zm0-4h-2V7h2v5z"/></svg>`
  }
];
---

<!-- LUXURY SEO TRUST STRIP -->
<section class="w-full bg-white py-3 sm:py-6 border-b border-slate-200/80 text-slate-900" aria-label="Why Book Gulshan Hotels">
  <div class="max-w-[1550px] mx-auto px-3 sm:px-8 lg:px-12">
    
    <!-- SUBTLE SEO CONTEXT HEADER (গুগলকে টার্গেট কি-ওয়ার্ড সিগন্যাল দেওয়ার জন্য) -->
    <div class="text-left mb-2.5 sm:mb-3">
      <span class="text-[9px] sm:text-[11px] font-black uppercase tracking-widest text-emerald-800 flex items-center gap-1.5">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-600 inline-block"></span>
        <span>Guaranteed Perks for All Hotels in Gulshan</span>
      </span>
    </div>

    <!-- COMPACT 2x2 MOBILE GRID, 4-COLUMN DESKTOP -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-2.5 sm:gap-4 lg:gap-6 items-stretch text-left">
      {trustPillars.map((item) => (
        <a 
          href={item.link} 
          class="flex items-start gap-2.5 sm:gap-3.5 p-2.5 sm:p-3.5 rounded-2xl bg-slate-50/70 border border-slate-200/80 hover:border-emerald-600/40 hover:bg-emerald-50/20 transition-all duration-200 group cursor-pointer"
        >
          <!-- Vector Icon -->
          <div class="w-8 h-8 sm:w-10 sm:h-10 rounded-xl bg-white border border-slate-200/90 flex items-center justify-center shrink-0 shadow-2xs group-hover:scale-105 transition-transform duration-200">
            <Fragment set:html={item.icon} />
          </div>

          <!-- SEO Keywords in Title & Description -->
          <div class="min-w-0 flex-1">
            <h3 class="font-black text-slate-900 text-[11px] sm:text-xs lg:text-sm leading-tight truncate group-hover:text-emerald-800 transition-colors">
              <span class="hidden xs:inline">{item.title}</span>
              <span class="inline xs:hidden">{item.shortTitle}</span>
            </h3>
            
            <!-- Mobile Short Description with Local Keywords -->
            <p class="text-[9px] sm:text-[11px] text-slate-500 font-medium leading-tight mt-0.5 truncate block sm:hidden">
              {item.desc}
            </p>
            
            <!-- Desktop Rich Description with Target Keywords -->
            <p class="text-xs text-slate-500 font-normal leading-relaxed mt-1 hidden sm:block">
              {item.fullDesc}
            </p>
          </div>
        </a>
      ))}
    </div>

  </div>
</section>
