---
// src/components/CustomSection.astro
import { getCollection } from 'astro:content';

let customSections = [];
try {
  const sections = await getCollection('homepage_sections');
  customSections = sections.map((item: any) => item.data).filter((item: any) => item.enable !== false && item.title);
} catch (e) {
  customSections = [];
}
---

{customSections.map((sec: any) => (
  <section class="py-12 px-4 sm:px-8 max-w-[1550px] mx-auto text-slate-800">
    <div class="bg-white rounded-3xl p-6 sm:p-10 border border-slate-200 shadow-sm space-y-4">
      <h2 class="text-2xl sm:text-4xl font-black font-serif text-[#0d3b23] border-b border-slate-100 pb-3">
        {sec.title}
      </h2>
      <div class="prose prose-slate text-sm sm:text-base leading-relaxed text-slate-700" set:html={sec.content} />
    </div>
  </section>
))}
