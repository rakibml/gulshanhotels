---
// src/components/EditorSpotlight.astro (Ultra-Optimized for Core Web Vitals & PageSpeed)
import { getCollection } from 'astro:content';

let spotlightHotel: any = null;
try {
  const allHotels = await getCollection('hotels');
  if (Array.isArray(allHotels) && allHotels.length > 0) {
    spotlightHotel = allHotels.find(h => (h.data?.title || h.data?.name || '').toLowerCase().includes('westin')) || allHotels[0];
  }
} catch (e) {}

const hData = spotlightHotel?.data || {};
const rawTitle = (hData.title || hData.name || "The Westin Dhaka").trim();
const hotelSlug = (hData.slug || spotlightHotel?.slug || spotlightHotel?.id || "the-westin-dhaka").replace(/\.md$/, '').trim();
const hotelLocation = "Main Gulshan Avenue, Gulshan 2 Circle, Dhaka";

// ক্লিন প্রাইস
const rawPrice = String(hData.price || "185").replace(/[^0-9.]/g, '');
const priceNum = parseFloat(rawPrice) || 185;
const currencySymbol = String(hData.price || '').includes('৳') ? '৳' : '$';

// আনস্প্ল্যাশ অপটিমাইজড অটো-ওয়েবপি ও রেসপনসিভ ইউআরএল
const baseImg = "https://images.unsplash.com/photo-1582719478250-c89cae4dc85b?auto=format&fit=crop&q=75";
const img600 = `${baseImg}&w=600`;
const img900 = `${baseImg}&w=900`;
const img1200 = `${baseImg}&w=1200`;
---

<!-- LUXURY EDITORIAL SHOWCASE (PERFORMANCE OPTIMIZED) -->
<section 
  id="spotlight" 
  class="w-full bg-white py-10 sm:py-14 text-slate-900 border-b border-slate-100"
  style="content-visibility: auto; contain-intrinsic-size: 1px 500px;"
>
  <div class="max-w-[1550px] mx-auto px-4 sm:px-8 lg:px-12">
    
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-14 items-center text-left">
      
      <!-- 1. LEFT: 100% CORE WEB VITALS OPTIMIZED IMAGE -->
      <div class="lg:col-span-7 relative group">
        <div class="relative aspect-[16/10] w-full rounded-3xl overflow-hidden bg-slate-100">
          
          <img 
            src={img1200}
            srcset={`${img600} 600w, ${img900} 900w, ${img1200} 1200w`}
            sizes="(max-width: 768px) 100vw, (max-width: 1200px) 60vw, 750px"
            alt="The Westin Dhaka Luxury Suite and Rooftop View" 
            loading="lazy"
            decoding="async" 
            fetchpriority="low"
            width="1200"
            height="750"
            class="w-full h-full object-cover group-hover:scale-103 transition-transform duration-700 ease-out" 
          />

          <div class="absolute inset-0 bg-gradient-to-t from-black/50 via-transparent to-transparent pointer-events-none"></div>
          
          <div class="absolute bottom-4 left-4 z-10">
            <span class="text-white text-xs font-bold bg-black/50 backdrop-blur-md px-3 py-1 rounded-full border border-white/20">
              📍 Gulshan 2 Diplomatic Enclave
            </span>
          </div>
        </div>
      </div>

      <!-- 2. RIGHT: MINIMALIST LUXURY EDITORIAL -->
      <div class="lg:col-span-5 space-y-5">
        
        <div class="space-y-2">
          <span class="text-[10px] font-black uppercase tracking-[0.25em] text-emerald-800 block">
            ★ CURATOR'S CHOICE OF THE MONTH
          </span>
          
          <!-- Capitalized Proper Title -->
          <h2 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-normal text-slate-900 tracking-tight capitalize leading-tight">
            {rawTitle}
          </h2>
          
          <p class="text-xs sm:text-sm text-slate-500 font-medium">
            {hotelLocation}
          </p>
        </div>

        <!-- Editorial Text -->
        <p class="text-xs sm:text-sm text-slate-600 font-normal leading-relaxed">
          Commanding the skyline of Gulshan 2, this iconic property stands as Dhaka’s benchmark for diplomatic security, renowned Heavenly® bedding comfort, and world-class rooftop dining over the Gulshan Lake.
        </p>

        <!-- Clean Bullet Highlights -->
        <div class="space-y-1.5 text-xs text-slate-700 font-semibold pt-1">
          <div class="flex items-center gap-2">
            <span class="text-emerald-800 font-black">✓</span>
            <span>Heated outdoor rooftop swimming pool & Italian dining at Prego</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="text-emerald-800 font-black">✓</span>
            <span>Round-the-clock armed diplomatic security and private access</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="text-emerald-800 font-black">✓</span>
            <span>18-minute express airport connection via Dhaka Elevated Expressway</span>
          </div>
        </div>

        <!-- Clean Pricing & Action Button -->
        <div class="pt-4 border-t border-slate-100 flex items-center justify-between gap-4">
          <div>
            <span class="text-[11px] text-slate-400 font-medium block">Starting from</span>
            <span class="text-2xl font-black text-slate-900 leading-tight">
              {currencySymbol}{priceNum} <span class="text-xs text-slate-500 font-normal">/ night</span>
            </span>
          </div>

          <a 
            href={`/${hotelSlug}`} 
            class="bg-[#0d3b23] hover:bg-[#061e14] text-white font-extrabold text-xs px-6 py-3.5 rounded-xl transition duration-200 uppercase tracking-wider shrink-0 cursor-pointer shadow-xs active:scale-95"
          >
            Explore Property ➔
          </a>
        </div>

      </div>

    </div>

  </div>
</section>
