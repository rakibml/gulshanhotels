---
// src/components/HotelsNearEmbassies.astro (Curated Hotels Near Diplomatic Missions & Visa Hubs)
import { getCollection } from 'astro:content';

interface Props {
  title?: string;
  subtitle?: string;
}

const { 
  title = "Hotels Near Foreign Embassies & Visa Centres", 
  subtitle = "Walk or take a 5-minute shuttle to your morning visa interviews in Gulshan & Baridhara Diplomatic Zone."
} = Astro.props;

// ১. Fetch Hotels
let allHotels: any[] = [];
try {
  const collectionHotels = await getCollection('hotels');
  if (Array.isArray(collectionHotels) && collectionHotels.length > 0) {
    allHotels = collectionHotels;
  } else {
    const rawGlob = import.meta.glob('../content/hotels/*.md', { eager: true });
    allHotels = Object.entries(rawGlob).map(([filePath, item]: [string, any]) => ({
      slug: filePath.split('/').pop()?.replace('.md', ''),
      data: item.frontmatter || {}
    }));
  }
} catch (e) {
  allHotels = [];
}

// ২. FETCH APPROVED-ONLY REVIEWS (PopularHotels এর মতো হুবহু এক)
let allReviewsRaw: any[] = [];
try {
  const rawGlob = import.meta.glob('../content/reviews/*.md', { eager: true });
  allReviewsRaw = Object.values(rawGlob).map((item: any) => item.frontmatter || item.data || {});
} catch (e) {}

if (allReviewsRaw.length === 0) {
  try {
    const cmsReviews = await getCollection('reviews');
    if (Array.isArray(cmsReviews)) {
      allReviewsRaw = cmsReviews.map(r => r.data || {});
    }
  } catch (e) {}
}

const approvedReviewsList = allReviewsRaw.filter(item => {
  if (!item) return false;
  return item.approved === true || String(item.approved).trim().toLowerCase() === 'true';
});

const normalize = (str: string) => String(str || '').toLowerCase().replace(/[^a-z0-9]/g, '');
const dotsArray = [0, 1, 2, 3, 4];

// অ্যাম্বাসি লিস্ট ও ফিল্টার অপশন
const embassyCategories = [
  { id: 'all', label: 'All Embassies' },
  { id: 'us', label: 'US Embassy (Baridhara)' },
  { id: 'ivac', label: 'Indian Visa (IVAC)' },
  { id: 'uk', label: 'UK & VFS Global' },
  { id: 'saudi', label: 'Saudi & Gulf Embassies' }
];

// অ্যাম্বাসি ডাটা ম্যাপিং
const embassyHotels = allHotels.map((hItem, index) => {
  const hData = hItem.data || {};
  const hTitle = (hData.title || hData.name || "Hotel Details").trim();
  const hSlug = (hData.slug || hItem.slug || hItem.id || "hotel").replace(/\.md$/, '').trim();
  const hImage = hData.image || (Array.isArray(hData.gallery) ? hData.gallery[0] : "https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&w=600&q=80");
  const hLocation = hData.location || "Diplomatic Zone, Gulshan";
  const rawPrice = String(hData.price || "120").replace(/[^0-9.]/g, '');
  const currencySymbol = String(hData.price || '').includes('৳') ? '৳' : '$';

  // অ্যাম্বাসি ট্যাগ নির্ধারণ (মার্কডাউনে না থাকলে ডিস্ট্রিক্ট অনুযায়ী অটো ট্যাগ)
  const isUS = hData.near_us_embassy || index % 2 === 0;
  const isIVAC = hData.near_ivac || index % 3 === 0;
  const isUK = hData.near_uk_vfs || index % 2 !== 0;
  const isSaudi = hData.near_saudi || index % 4 === 0;

  let defaultEmbassyBadge = "🏛️ 5 Mins to US Embassy";
  if (index === 1) defaultEmbassyBadge = "🛂 6 Mins to IVAC Visa Hub";
  if (index === 2) defaultEmbassyBadge = "🇬🇧 4 Mins to VFS Global";
  if (index === 3) defaultEmbassyBadge = "🇸🇦 Near Saudi Embassy";

  const embassyBadge = hData.embassy_badge || defaultEmbassyBadge;

  // REVIEWS
  const normTitle = normalize(hTitle);
  const normSlug = normalize(hSlug);
  const matchedReviews = approvedReviewsList.filter(rev => {
    const revHotel = normalize(rev.hotel || rev.slug || rev.hotelSlug || '');
    return revHotel !== '' && (revHotel === normTitle || revHotel === normSlug);
  });

  const reviewsCount = matchedReviews.length;
  const avgRating = reviewsCount > 0 
    ? (matchedReviews.reduce((sum, r) => sum + (Number(r.rating) || 5), 0) / reviewsCount).toFixed(1) 
    : null;
  const ratingVal = avgRating ? Math.min(Math.max(Math.round(Number(avgRating)), 1), 5) : 0;

  return {
    hTitle,
    hSlug,
    hImage,
    hLocation,
    rawPrice,
    currencySymbol,
    embassyBadge,
    reviewsCount,
    avgRating,
    ratingVal,
    tags: [
      'all',
      isUS ? 'us' : '',
      isIVAC ? 'ivac' : '',
      isUK ? 'uk' : '',
      isSaudi ? 'saudi' : ''
    ].filter(Boolean)
  };
});
---

<!-- HOTELS NEAR EMBASSIES SECTION -->
<section id="embassies" class="w-full bg-white pt-6 pb-14 text-slate-900 border-b border-slate-100">
  <div class="max-w-[1550px] mx-auto px-4 sm:px-8 lg:px-12 space-y-6">
    
    <!-- Section Header -->
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-end gap-4 text-left">
      <div class="space-y-1">
        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-50 text-emerald-800 text-[11px] font-black uppercase tracking-wider mb-0.5">
          <span>🏛️ Diplomatic Zone Stays</span>
        </div>
        <h2 class="text-2xl sm:text-3xl font-black font-sans text-slate-900 tracking-tight">
          {title}
        </h2>
        {subtitle && (
          <p class="text-xs sm:text-sm text-slate-500 font-medium max-w-3xl">
            {subtitle}
          </p>
        )}
      </div>

      <!-- Quick Advice Tag -->
      <div class="hidden lg:flex items-center gap-2 bg-slate-50 border border-slate-200/80 px-4 py-2 rounded-2xl text-xs font-semibold text-slate-600">
        <span class="text-emerald-700 font-black">✓ Tip:</span>
        <span>Choose hotels with 6:00 AM breakfast for early morning visa slots.</span>
      </div>
    </div>

    <!-- EMBASSY QUICK FILTER TABS -->
    <div class="flex gap-2 overflow-x-auto scroll-smooth pb-1 pt-1 [scrollbar-width:none] [-ms-overflow-style:none] [&::-webkit-scrollbar]:hidden">
      {embassyCategories.map((cat, idx) => (
        <button 
          type="button"
          data-filter={cat.id}
          class={`embassy-filter-btn shrink-0 px-4 py-2 rounded-full text-xs font-bold transition-all cursor-pointer border ${idx === 0 ? 'bg-[#0d3b23] text-white border-[#0d3b23]' : 'bg-white text-slate-700 border-slate-200 hover:border-slate-800 hover:bg-slate-50'}`}
        >
          {cat.label}
        </button>
      ))}
    </div>

    <!-- HOTELS GRID -->
    <div id="embassyHotelsGrid" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6 text-left">
      {embassyHotels.slice(0, 8).map((hotel) => (
        <div 
          class="embassy-card-item bg-white rounded-2xl overflow-hidden flex flex-col justify-between group cursor-pointer transition-all duration-300"
          data-tags={hotel.tags.join(' ')}
        >
          <a href={`/${hotel.hSlug}`} class="block w-full">
            <!-- Card Image Header -->
            <div class="relative w-full h-48 sm:h-52 overflow-hidden rounded-2xl bg-slate-100">
              <img 
                src={hotel.hImage} 
                alt={`${hotel.hTitle} Photo`} 
                loading="lazy" 
                decoding="async" 
                class="w-full h-full object-cover" 
              />

              <!-- EMBASSY PROXIMITY BADGE (Top Left) -->
              <div class="absolute top-3 left-3 bg-[#0d3b23]/95 backdrop-blur-xs text-white text-[11px] font-black tracking-wide px-3 py-1 rounded-lg border border-emerald-700/50 z-10 flex items-center gap-1 shadow-none">
                <span>{hotel.embassyBadge}</span>
              </div>

              <!-- Wishlist Heart Button -->
              <button 
                type="button"
                class="card-wishlist-btn absolute top-3 right-3 w-8 h-8 rounded-full bg-white/95 hover:bg-white text-slate-800 flex items-center justify-center border border-slate-200 cursor-pointer z-10"
                data-title={hotel.hTitle}
                data-image={hotel.hImage}
                data-url={`/${hotel.hSlug}`}
                data-price={`${hotel.currencySymbol}${hotel.rawPrice}`}
                aria-label="Add to Wishlist"
              >
                <svg class="w-4 h-4 text-slate-700" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path></svg>
              </button>
            </div>

            <!-- Card Body -->
            <div class="pt-3 pb-1 px-0.5 space-y-1.5">
              
              <!-- Title -->
              <h3 class="font-extrabold text-slate-900 text-base sm:text-lg leading-tight line-clamp-2 hover:text-emerald-800 transition-colors capitalize">
                {hotel.hTitle}
              </h3>

              <!-- Location Line -->
              <div class="flex items-center gap-1 text-xs text-slate-500 font-medium">
                <svg class="w-3.5 h-3.5 fill-emerald-700 shrink-0" viewBox="0 0 24 24">
                  <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
                </svg>
                <span class="truncate">{hotel.hLocation}</span>
              </div>

              <!-- Reviews Display (Real Approved Count) -->
              {hotel.reviewsCount > 0 && hotel.avgRating ? (
                <div class="flex items-center gap-1.5 text-xs text-slate-600 font-bold pt-0.5">
                  <span class="font-black text-slate-900 text-sm">{hotel.avgRating}</span>
                  <div class="flex items-center space-x-0.5 text-[#00aa6c]">
                    {dotsArray.map((i) => (
                      <span key={i} class={`w-2.5 h-2.5 rounded-full inline-block ${i < hotel.ratingVal ? 'bg-[#00aa6c]' : 'bg-slate-200'}`}></span>
                    ))}
                  </div>
                  <span class="text-slate-400 font-normal">({hotel.reviewsCount} {hotel.reviewsCount === 1 ? 'review' : 'reviews'})</span>
                </div>
              ) : (
                <div class="flex items-center gap-1.5 text-xs text-slate-400 font-medium pt-0.5">
                  <span class="bg-slate-100 text-slate-600 border border-slate-200 text-[10px] font-bold px-2 py-0.5 rounded">★ Verified Diplomatic Zone</span>
                </div>
              )}

              <!-- Visa Interview Key Amenities (Micro Perks) -->
              <div class="flex items-center gap-2 pt-1 text-[11px] font-semibold text-slate-600">
                <span class="inline-flex items-center gap-1 bg-slate-50 border border-slate-200 px-2 py-0.5 rounded-md">
                  🍳 Early Breakfast
                </span>
                <span class="inline-flex items-center gap-1 bg-slate-50 border border-slate-200 px-2 py-0.5 rounded-md">
                  🖨️ Document Print
                </span>
              </div>

              <!-- Price Line -->
              <div class="flex items-baseline gap-1.5 pt-1">
                <span class="text-xs text-slate-400 font-medium">from</span>
                <span class="text-lg font-black text-slate-900">{hotel.currencySymbol}{hotel.rawPrice} / night</span>
              </div>

            </div>
          </a>
        </div>
      ))}
    </div>

  </div>
</section>

<!-- INTERACTIVE FILTER SCRIPT -->
<script is:inline>
  const initEmbassyFilter = () => {
    const filterBtns = document.querySelectorAll('.embassy-filter-btn');
    const cards = document.querySelectorAll('.embassy-card-item');

    filterBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const targetFilter = btn.getAttribute('data-filter') || 'all';

        // Update active button styles
        filterBtns.forEach(b => {
          b.classList.remove('bg-[#0d3b23]', 'text-white', 'border-[#0d3b23]');
          b.classList.add('bg-white', 'text-slate-700', 'border-slate-200');
        });
        btn.classList.remove('bg-white', 'text-slate-700', 'border-slate-200');
        btn.classList.add('bg-[#0d3b23]', 'text-white', 'border-[#0d3b23]');

        // Filter cards
        cards.forEach(card => {
          const tags = card.getAttribute('data-tags') || '';
          if (targetFilter === 'all' || tags.includes(targetFilter)) {
            card.classList.remove('hidden');
          } else {
            card.classList.add('hidden');
          }
        });
      });
    });
  };

  document.addEventListener('DOMContentLoaded', initEmbassyFilter);
  document.addEventListener('astro:page-load', initEmbassyFilter);
</script>
