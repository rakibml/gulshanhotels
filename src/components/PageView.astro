---
// src/components/PageView.astro (Universal Luxury Page Template - About, Privacy, Terms, Disclaimer)
import Layout from '../layouts/Layout.astro';

interface Props {
  entry: any;
}

const { entry } = Astro.props;
const pData = entry?.data || {};

const pageTitle = (pData.title || entry?.title || "Page Details").trim();
const pageDescription = (pData.description || pData.seo_description || entry?.description || "").trim();
const pageBody = entry?.body || "";
const updatedDate = pData.last_updated || pData.updatedDate || pData.date || "Recent";

// স্লাগ ও ক্যানোনিকাল ইউআরএল
const rawSlug = String(entry?.slug || entry?.id || "").trim();
const cleanSlug = rawSlug.replace(/\.(md|mdx)$/, '').split('/').pop()?.toLowerCase() || "";

const siteOrigin = "https://gulshanhotels.com";
const pageUrl = `${siteOrigin}/${cleanSlug}`;

// পেজের বিষয়বস্তু বুঝে স্বয়ংক্রিয় প্রফেশনাল ব্যাজ নির্বাচন
const isLegalPage = cleanSlug.includes('privacy') || cleanSlug.includes('terms') || cleanSlug.includes('disclaimer') || cleanSlug.includes('policy') || cleanSlug.includes('cookies');
const isAboutPage = cleanSlug.includes('about') || pageTitle.toLowerCase().includes('about');
const defaultBadge = isLegalPage ? "Official Policy & Transparency" : (isAboutPage ? "Mission & Hospitality Standard" : "Information");
const badgeText = pData.badge || pData.category || defaultBadge;

// Content Renderer
let PageContent = null;
if (typeof entry?.render === 'function') {
  try {
    const rendered = await entry.render();
    PageContent = rendered.Content;
  } catch (e) {}
} else if (entry?.Content) {
  PageContent = entry.Content;
}

// GOOGLE & AI RICH SCHEMA
const pageSchema = {
  "@context": "https://schema.org",
  "@type": isAboutPage ? "AboutPage" : "WebPage",
  "@id": `${pageUrl}#webpage`,
  "url": pageUrl,
  "name": pageTitle,
  ...(pageDescription ? { "description": pageDescription } : {}),
  "isPartOf": {
    "@type": "WebSite",
    "@id": `${siteOrigin}/#website`,
    "name": "GulshanHotels.com",
    "url": `${siteOrigin}/`
  },
  "breadcrumb": {
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": `${siteOrigin}/`
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": pageTitle
      }
    ]
  }
};
---

<Layout 
  title={`${pageTitle} — GulshanHotels.com`}
  description={pageDescription || `Official guidance, policies and information for ${pageTitle} on GulshanHotels.com.`}
  image={pData.hero_image || undefined}
>

  <!-- GOOGLE SCHEMA INJECTION -->
  <script type="application/ld+json" set:html={JSON.stringify(pageSchema)} />

  <main class="w-full bg-white text-slate-900 pt-6 pb-20">
    
    <!-- ================= 1. LUXURY HERO COVER IMAGE ================= -->
    {pData.hero_image && (
      <div class="w-full max-w-[1550px] mx-auto px-4 sm:px-8 lg:px-12 mb-6">
        <div class="relative aspect-[21/9] sm:aspect-[24/9] w-full rounded-3xl overflow-hidden bg-slate-900 border border-slate-200/90 shadow-sm">
          <img 
            src={pData.hero_image} 
            alt={pageTitle} 
            width="1550" 
            height="660" 
            fetchpriority="high"
            decoding="async" 
            class="w-full h-full object-cover" 
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-transparent"></div>
        </div>
      </div>
    )}

    <!-- ================= 2. BREADCRUMBS ================= -->
    <div class="w-full max-w-[1550px] mx-auto px-4 sm:px-8 lg:px-12 mb-6">
      <nav aria-label="Breadcrumb" class="flex items-center gap-2 text-xs font-semibold text-slate-400 text-left">
        <a href="/" class="hover:text-emerald-800 transition">Home</a>
        <span>/</span>
        <span class="text-slate-800 capitalize truncate" aria-current="page">{pageTitle}</span>
      </nav>
    </div>

    <!-- ================= 3. EDITORIAL READING COLUMN (max-w-[920px]) ================= -->
    <div class="max-w-[920px] mx-auto px-4 sm:px-6 space-y-8 text-left">

      <!-- HEADER WITH BADGES & LAST UPDATED -->
      <header class="space-y-3.5 pb-6 border-b border-slate-200 text-left">
        <div class="flex flex-wrap items-center gap-2.5">
          <span class="bg-emerald-50 text-emerald-800 text-[10px] sm:text-[11px] font-black uppercase tracking-wider px-3 py-1 rounded-full border border-emerald-200">
            {badgeText}
          </span>
          <span class="text-xs text-slate-400 font-medium">
            Effective Date: <strong class="text-slate-700">{updatedDate}</strong>
          </span>
        </div>

        <h1 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-black text-slate-900 tracking-tight leading-tight capitalize">
          {pageTitle}
        </h1>

        {pageDescription && (
          <p class="text-base sm:text-lg text-slate-600 font-normal leading-relaxed">
            {pageDescription}
          </p>
        )}
      </header>

      <!-- ================= 4. LUXURY STATS CARDS (FIXED TAILWIND JIT) ================= -->
      {Array.isArray(pData.stats) && pData.stats.length > 0 && (
        <div class="my-8">
          <div class="grid grid-cols-2 md:grid-cols-4 gap-3 sm:gap-4 text-center">
            {pData.stats.map((st: any) => (
              <div class="p-4 sm:p-5 rounded-2xl bg-slate-50 border border-slate-200 shadow-2xs space-y-1">
                <span class="font-serif text-2xl sm:text-3xl font-black text-slate-900 block tracking-tight">
                  {st.value}
                </span>
                <span class="text-[10px] sm:text-xs font-bold text-slate-500 uppercase tracking-wider block">
                  {st.label}
                </span>
              </div>
            ))}
          </div>
        </div>
      )}

      <!-- ================= 5. FEATURED PILLARS (ABOUT / VALUES) ================= -->
      {Array.isArray(pData.features) && pData.features.length > 0 && (
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 my-8">
          {pData.features.map((feat: any) => (
            <div class="p-5 sm:p-6 rounded-2xl bg-white border border-slate-200 hover:border-emerald-600/40 hover:shadow-md transition-all duration-200 space-y-2">
              <div class="w-9 h-9 rounded-xl bg-emerald-50 text-emerald-800 border border-emerald-200 flex items-center justify-center font-black">
                <svg class="w-4 h-4 fill-none stroke-current stroke-2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              </div>
              <h3 class="font-bold text-slate-900 text-base leading-snug">{feat.title}</h3>
              <p class="text-xs sm:text-sm text-slate-600 leading-relaxed font-normal">{feat.desc}</p>
            </div>
          ))}
        </div>
      )}

      <!-- ================= 6. PROSE CONTENT (HIGH-CONTRAST AUTO-LINKS) ================= -->
      {(PageContent || pageBody) && (
        <div 
          id="pageBodyContent" 
          class="prose prose-slate max-w-none text-[16px] sm:text-[18px] leading-[1.8] font-normal text-slate-700
                 prose-headings:font-serif prose-headings:font-black prose-headings:text-slate-900 prose-headings:tracking-tight 
                 prose-h2:text-2xl sm:prose-h2:text-3xl prose-h2:mt-10 prose-h2:mb-4 
                 prose-h3:text-lg sm:prose-h3:text-xl prose-h3:mt-8 prose-h3:mb-3 
                 prose-p:mb-5 
                 prose-ul:my-5 prose-ul:list-disc prose-ul:pl-6
                 prose-ol:my-5 prose-ol:list-decimal prose-ol:pl-6
                 prose-li:my-1.5
                 prose-table:w-full prose-table:my-6 prose-table:border-collapse prose-table:text-left prose-table:text-sm
                 prose-th:border-b-2 prose-th:border-slate-300 prose-th:py-2.5 prose-th:font-bold prose-th:text-slate-900
                 prose-td:border-b prose-td:border-slate-100 prose-td:py-2.5 prose-td:text-slate-600
                 prose-blockquote:border-l-4 prose-blockquote:border-emerald-600 prose-blockquote:bg-slate-50 prose-blockquote:p-4 prose-blockquote:rounded-r-2xl prose-blockquote:italic
                 [&_a]:text-emerald-800 [&_a]:font-bold [&_a]:underline [&_a]:decoration-emerald-500/80 [&_a]:underline-offset-4 
                 hover:[&_a]:text-emerald-950 hover:[&_a]:decoration-emerald-800 transition-colors"
        >
          {PageContent ? <PageContent /> : <div set:html={pageBody} />}
        </div>
      )}

      <!-- ================= 7. ACCORDION FAQS WITH ANIMATED VECTOR CHEVRON ================= -->
      {Array.isArray(pData.faqs) && pData.faqs.length > 0 && (
        <div class="space-y-4 pt-10 border-t border-slate-200">
          <h3 class="font-serif text-2xl font-black text-slate-900">Frequently Asked Questions</h3>
          <div class="space-y-2.5">
            {pData.faqs.map((faq: any, i: number) => (
              <details class="group bg-slate-50 rounded-2xl border border-slate-200 p-4 transition-all duration-200 cursor-pointer" open={i === 0}>
                <summary class="flex justify-between items-center list-none font-bold text-sm sm:text-base text-slate-900 group-hover:text-emerald-800 transition select-none">
                  <span class="pr-2">{faq.question}</span>
                  <svg class="w-4 h-4 text-slate-400 group-open:rotate-180 transition-transform duration-200 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M6 9l6 6 6-6"/>
                  </svg>
                </summary>
                <p class="pt-3 text-xs sm:text-sm text-slate-600 leading-relaxed font-normal border-t border-slate-200/60 mt-3">{faq.answer}</p>
              </details>
            ))}
          </div>
        </div>
      )}

      <!-- ================= 8. DIRECT CONCIERGE CTA BANNER ================= -->
      {pData.show_cta !== false && (
        <div class="bg-[#0d3b23] text-white p-6 sm:p-8 rounded-3xl space-y-3 mt-12 shadow-sm">
          <span class="text-emerald-300 text-[10px] font-black uppercase tracking-widest block">Direct Concierge</span>
          <h3 class="font-serif text-xl sm:text-2xl font-black">Need Guidance for Your Gulshan Visit?</h3>
          <p class="text-xs sm:text-sm text-emerald-100 font-normal leading-relaxed">
            Our local desk verifies rates, security protocols, and luxury amenities daily. Contact us for personalized recommendations.
          </p>
          <div class="pt-2">
            <a href="/#hotels" class="inline-flex items-center gap-1.5 bg-white hover:bg-emerald-50 text-slate-950 font-black text-xs px-5 py-3 rounded-xl uppercase tracking-wider transition">
              <span>Explore Verified Hotels</span>
              <span>➔</span>
            </a>
          </div>
        </div>
      )}

    </div>
  </main>
</Layout>

<!-- CLIENT SCRIPT: AUTO OPEN MARKDOWN LINKS IN NEW TAB -->
<script is:inline>
  const initPageInteractions = () => {
    const pageLinks = document.querySelectorAll('#pageBodyContent a');
    pageLinks.forEach(link => {
      const href = link.getAttribute('href');
      if (href && !href.startsWith('#')) {
        link.setAttribute('target', '_blank');
        link.setAttribute('rel', 'noopener noreferrer');
      }
    });
  };

  document.addEventListener('DOMContentLoaded', initPageInteractions);
  document.addEventListener('astro:page-load', initPageInteractions);
</script>
