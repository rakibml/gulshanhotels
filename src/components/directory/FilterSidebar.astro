---
// src/components/directory/FilterSidebar.astro
interface Props {
  totalCount: number;
  hotelCount: number;
  guestHouseCount: number;
  g1Count: number;
  g2Count: number;
  nearCount: number;
  star5Count: number;
  star4Count: number;
}

const {
  totalCount,
  hotelCount,
  guestHouseCount,
  g1Count,
  g2Count,
  nearCount,
  star5Count,
  star4Count
} = Astro.props;
---

<aside class="hidden lg:block lg:col-span-3 bg-white p-5 rounded-2xl border border-slate-200 shadow-sm space-y-6 sticky top-24 h-fit max-h-[90vh] overflow-y-auto custom-scrollbar text-left">
  
  <!-- Header & Reset -->
  <div class="flex items-center justify-between border-b border-slate-100 pb-4">
    <div>
      <h3 class="text-sm font-black text-slate-900 uppercase tracking-tight">Filters</h3>
      <p class="text-[10px] text-slate-500 font-medium">Showing <span id="sidebarCountDisplay">{totalCount}</span> options</p>
    </div>
    <button type="button" id="resetFiltersBtn" class="text-xs font-bold text-[#006ce4] hover:text-[#0057b8] transition-colors cursor-pointer flex items-center gap-1 group">
      <svg class="w-3 h-3 group-hover:rotate-180 transition-transform duration-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
      </svg>
      Reset
    </button>
  </div>

  <!-- SEARCH -->
  <div class="space-y-2">
    <label class="text-[11px] font-black uppercase text-slate-400 tracking-wider block">Search Property</label>
    <div class="relative group">
      <input type="text" id="sidebarSearchInput" placeholder="e.g. Radisson Blu" class="w-full bg-slate-50 focus:bg-white text-xs font-semibold rounded-xl pl-9 pr-3 py-2.5 border border-slate-200 focus:border-[#006ce4] focus:outline-none transition-all" />
      <svg class="w-4 h-4 text-slate-400 absolute left-3 top-1/2 -translate-y-1/2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </div>
  </div>

  <!-- SORT BY -->
  <div class="space-y-2 pt-2">
    <label class="text-[11px] font-black uppercase text-slate-400 tracking-wider block">Sort By</label>
    <select id="sidebarSortSelect" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3 py-2.5 text-xs font-bold text-slate-800 focus:outline-none focus:border-[#006ce4] cursor-pointer transition-all">
      <option value="featured">Recommended</option>
      <option value="price-asc">Price: Low to High</option>
      <option value="price-desc">Price: High to Low</option>
      <option value="rating-desc">Guest Rating</option>
    </select>
  </div>

  <!-- NEIGHBORHOOD -->
  <div class="space-y-3 pt-4 border-t border-slate-100">
    <span class="text-[11px] font-black uppercase text-slate-400 tracking-wider block">Neighborhood</span>
    <div class="space-y-1">
      { [
        { id: 'area-all', val: 'all', label: 'All Gulshan', count: totalCount },
        { id: 'area-g1', val: 'gulshan-1', label: 'Gulshan 1', count: g1Count },
        { id: 'area-g2', val: 'gulshan-2', label: 'Gulshan 2', count: g2Count },
        { id: 'area-near', val: 'near', label: 'Near Gulshan', count: nearCount }
      ].map((area) => (
        <label class="flex items-center justify-between p-1.5 -mx-1.5 rounded-lg hover:bg-slate-50 cursor-pointer group">
          <span class="flex items-center gap-2.5">
            <input type="radio" name="areaFilter" value={area.val} checked={area.val === 'all'} class="area-radio w-4 h-4 accent-[#006ce4]" id={area.id} />
            <span class="text-xs font-bold text-slate-700 group-hover:text-[#006ce4]">{area.label}</span>
          </span>
          <span class="text-[10px] bg-slate-100 px-1.5 py-0.5 rounded-md font-bold text-slate-500">{area.count}</span>
        </label>
      ))}
    </div>
  </div>

  <!-- PROPERTY RATING (Stars) -->
  <div class="space-y-3 pt-2">
    <span class="text-[11px] font-black uppercase text-slate-400 tracking-wider block">Star Rating</span>
    <div class="space-y-1">
      <label class="flex items-center justify-between p-1.5 -mx-1.5 rounded-lg hover:bg-slate-50 cursor-pointer group">
        <span class="flex items-center gap-2.5">
          <input type="checkbox" value="5" class="star-check w-4 h-4 accent-[#006ce4] rounded" />
          <span class="text-xs font-bold text-slate-700">5 Stars</span>
        </span>
        <span class="text-[10px] font-bold text-slate-400">{star5Count}</span>
      </label>
      <label class="flex items-center justify-between p-1.5 -mx-1.5 rounded-lg hover:bg-slate-50 cursor-pointer group">
        <span class="flex items-center gap-2.5">
          <input type="checkbox" value="4" class="star-check w-4 h-4 accent-[#006ce4] rounded" />
          <span class="text-xs font-bold text-slate-700">4 Stars</span>
        </span>
        <span class="text-[10px] font-bold text-slate-400">{star4Count}</span>
      </label>
    </div>
  </div>

  <!-- PROPERTY TYPE -->
  <div class="space-y-3 pt-4 border-t border-slate-100">
    <span class="text-[11px] font-black uppercase text-slate-400 tracking-wider block">Property Type</span>
    <div class="space-y-1">
      <label class="flex items-center justify-between p-1.5 -mx-1.5 rounded-lg hover:bg-slate-50 cursor-pointer group">
        <span class="flex items-center gap-2.5">
          <input type="checkbox" value="hotel" class="type-check w-4 h-4 accent-[#006ce4] rounded" />
          <span class="text-xs font-bold text-slate-700">Hotels</span>
        </span>
        <span class="text-[10px] font-bold text-slate-400">{hotelCount}</span>
      </label>
      <label class="flex items-center justify-between p-1.5 -mx-1.5 rounded-lg hover:bg-slate-50 cursor-pointer group">
        <span class="flex items-center gap-2.5">
          <input type="checkbox" value="guesthouse" class="type-check w-4 h-4 accent-[#006ce4] rounded" />
          <span class="text-xs font-bold text-slate-700">Guest Houses</span>
        </span>
        <span class="text-[10px] font-bold text-slate-400">{guestHouseCount}</span>
      </label>
    </div>
  </div>

</aside>

<script>
  function applyFilters() {
    console.log("Filter engine initialized...");

    const searchInput = document.getElementById('sidebarSearchInput') as HTMLInputElement;
    const sortSelect = document.getElementById('sidebarSortSelect') as HTMLSelectElement;
    const countDisplay = document.getElementById('sidebarCountDisplay');
    const resetBtn = document.getElementById('resetFiltersBtn');
    
    // মেইন লিস্ট কন্টেইনার এবং কার্ডগুলো সিলেক্ট করা
    const hotelCards = document.querySelectorAll('.directory-card-item') as NodeListOf<HTMLElement>;
    
    // কার্ডগুলো যদি না পাওয়া যায় তবে রিটার্ন
    if (hotelCards.length === 0) {
      console.warn("No hotel cards found with class .directory-card-item");
      return;
    }

    const hotelContainer = hotelCards[0].parentElement;

    const runFiltering = () => {
      const searchTerm = searchInput?.value.toLowerCase().trim() || "";
      const selectedArea = (document.querySelector('input[name="areaFilter"]:checked') as HTMLInputElement)?.value || "all";
      
      const selectedStars = Array.from(document.querySelectorAll('.star-check:checked')).map((el: any) => el.value);
      const selectedTypes = Array.from(document.querySelectorAll('.type-check:checked')).map((el: any) => el.value);

      let visibleCount = 0;

      hotelCards.forEach((card) => {
        // কার্ডের ভেতর থাকা ডাটা এট্রিবিউটগুলো পড়া
        const title = (card.getAttribute('data-title') || "").toLowerCase();
        const stars = card.getAttribute('data-stars') || "";
        const area = card.getAttribute('data-area') || "";
        const isGuestHouse = card.getAttribute('data-guesthouse') === 'true';
        const type = isGuestHouse ? 'guesthouse' : 'hotel';

        // লজিক চেক
        const matchesSearch = searchTerm === "" || title.includes(searchTerm);
        const matchesArea = selectedArea === 'all' || area === selectedArea;
        const matchesStars = selectedStars.length === 0 || selectedStars.includes(stars);
        const matchesType = selectedTypes.length === 0 || selectedTypes.includes(type);

        if (matchesSearch && matchesArea && matchesStars && matchesType) {
          card.style.display = 'block'; // অথবা আপনার লেআউট অনুযায়ী flex
          visibleCount++;
        } else {
          card.style.display = 'none';
        }
      });

      if (countDisplay) countDisplay.textContent = visibleCount.toString();
      
      // সর্টিং কল করা
      runSorting();
    };

    const runSorting = () => {
      if (!hotelContainer) return;
      const sortBy = sortSelect?.value || "featured";
      
      // শুধুমাত্র দৃশ্যমান কার্ডগুলোকে অ্যারেতে নেওয়া
      const cardsArray = Array.from(hotelCards);

      cardsArray.sort((a, b) => {
        const priceA = parseFloat(a.getAttribute('data-numeric-price') || "0");
        const priceB = parseFloat(b.getAttribute('data-numeric-price') || "0");
        const ratingA = parseFloat(a.getAttribute('data-numeric-rating') || "0");
        const ratingB = parseFloat(b.getAttribute('data-numeric-rating') || "0");

        if (sortBy === 'price-asc') return priceA - priceB;
        if (sortBy === 'price-desc') return priceB - priceA;
        if (sortBy === 'rating-desc') return ratingB - ratingA;
        return 0; // Default
      });

      // ডম এলিমেন্টগুলোকে নতুন সিরিয়ালে সাজানো
      cardsArray.forEach(card => hotelContainer.appendChild(card));
    };

    // ইভেন্ট লিসেনারগুলো যোগ করা
    searchInput?.addEventListener('input', runFiltering);
    sortSelect?.addEventListener('change', runFiltering);
    
    document.querySelectorAll('.area-radio, .star-check, .type-check').forEach(input => {
      input.addEventListener('change', runFiltering);
    });

    // রিসেট বাটন লজিক
    resetBtn?.addEventListener('click', () => {
      if (searchInput) searchInput.value = "";
      if (sortSelect) sortSelect.value = "featured";
      const allRadio = document.getElementById('area-all') as HTMLInputElement;
      if (allRadio) allRadio.checked = true;
      document.querySelectorAll('input[type="checkbox"]').forEach((cb: any) => cb.checked = false);
      runFiltering();
    });
  };

  // Astro page loads (Navigation safe)
  document.addEventListener('astro:page-load', applyFilters);
  // First time load
  applyFilters();
</script>

<style>
  .custom-scrollbar::-webkit-scrollbar { width: 4px; }
  .custom-scrollbar::-webkit-scrollbar-thumb { background: #e2e8f0; border-radius: 10px; }
  /* ফাস্ট ফিল্টারিংয়ের জন্য ট্রানজিশন বন্ধ রাখা ভালো */
  .directory-card-item { transition: none !important; }
</style>
