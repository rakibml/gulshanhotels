---
// src/components/directory/MobileFilterDrawer.astro
---

<div id="mobileDrawerOverlay" class="fixed inset-0 z-50 bg-slate-950/70 backdrop-blur-xs hidden transition-opacity">
  <div class="fixed inset-y-0 right-0 max-w-xs w-full bg-white shadow-2xl p-5 flex flex-col justify-between overflow-y-auto">
    <div class="space-y-6 text-left">
      <div class="flex items-center justify-between border-b border-slate-100 pb-3">
        <h3 class="text-base font-black text-slate-900">Filter Hotels</h3>
        <button type="button" id="closeMobileDrawerBtn" class="text-2xl font-bold text-slate-400 hover:text-slate-900 cursor-pointer p-1">&times;</button>
      </div>

      <!-- Area Selection -->
      <div>
        <h4 class="text-xs font-black uppercase text-slate-400 mb-2">Area</h4>
        <div class="flex flex-wrap gap-1.5 text-xs font-bold">
          <button type="button" class="m-area-btn px-3 py-1.5 rounded-lg border border-slate-200 bg-[#006ce4] text-white" data-area="all">All</button>
          <button type="button" class="m-area-btn px-3 py-1.5 rounded-lg border border-slate-200 bg-slate-100" data-area="gulshan-1">Gulshan 1</button>
          <button type="button" class="m-area-btn px-3 py-1.5 rounded-lg border border-slate-200 bg-slate-100" data-area="gulshan-2">Gulshan 2</button>
        </div>
      </div>
    </div>

    <button type="button" id="applyMobileFiltersBtn" class="w-full bg-[#006ce4] hover:bg-[#0057b8] text-white font-bold text-xs py-3 rounded-xl shadow cursor-pointer transition">
      Apply Filters
    </button>
  </div>
</div>
