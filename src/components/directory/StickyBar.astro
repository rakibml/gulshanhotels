---
// src/components/directory/StickyBar.astro
---

<header class="sticky top-0 z-40 bg-white/80 backdrop-blur-md border-b border-slate-200 shadow-sm transition-all duration-300">
  <div class="max-w-[1280px] mx-auto px-4 py-2.5 flex items-center justify-between gap-3 sm:gap-6">
    
    <!-- Search Input Group -->
    <div class="relative flex-1 max-w-lg group">
      <div class="absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 group-focus-within:text-[#006ce4] transition-colors">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
        </svg>
      </div>
      <input 
        type="text" 
        id="hotelSearchInput" 
        placeholder="Search hotel name, location..." 
        class="w-full bg-slate-100 hover:bg-slate-200/50 focus:bg-white text-xs sm:text-sm font-bold rounded-xl pl-10 pr-4 py-2.5 border-transparent focus:border-[#006ce4] focus:ring-4 focus:ring-blue-50 focus:outline-none transition-all placeholder:text-slate-500"
      />
    </div>

    <!-- Quick Filters (Desktop) -->
    <nav class="hidden md:flex items-center gap-2 p-1 bg-slate-100 rounded-xl border border-slate-200">
      <button 
        type="button" 
        class="area-quick-btn active-area px-4 py-1.5 rounded-lg text-xs font-black transition-all cursor-pointer bg-[#006ce4] text-white shadow-sm" 
        data-area="all"
      >
        All Areas
      </button>
      <button 
        type="button" 
        class="area-quick-btn px-4 py-1.5 rounded-lg text-xs font-black text-slate-600 hover:text-slate-900 hover:bg-white transition-all cursor-pointer" 
        data-area="gulshan-1"
      >
        Gulshan 1
      </button>
      <button 
        type="button" 
        class="area-quick-btn px-4 py-1.5 rounded-lg text-xs font-black text-slate-600 hover:text-slate-900 hover:bg-white transition-all cursor-pointer" 
        data-area="gulshan-2"
      >
        Gulshan 2
      </button>
    </nav>

    <!-- Mobile Filter Trigger -->
    <button 
      type="button" 
      id="openMobileDrawerBtn" 
      class="md:hidden flex items-center gap-2 bg-[#006ce4] hover:bg-[#0057b8] text-white text-[11px] font-black uppercase tracking-wider px-4 py-2.5 rounded-xl shadow-lg shadow-blue-100 shrink-0 transition-all active:scale-95"
    >
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4" />
      </svg>
      <span>Filters</span>
    </button>

  </div>
</header>

<script>
  function initStickyBar() {
    const searchInput = document.getElementById('hotelSearchInput') as HTMLInputElement;
    const areaButtons = document.querySelectorAll('.area-quick-btn');
    const hotelCards = document.querySelectorAll('.directory-card-item') as NodeListOf<HTMLElement>;
    const sidebarCount = document.getElementById('sidebarCountDisplay'); // সাইডবারের কাউন্ট আপডেট করার জন্য

    if (!hotelCards.length) return;

    // মেইন ফিল্টার ফাংশন
    const runStickyFilter = () => {
      const searchTerm = searchInput.value.toLowerCase().trim();
      const activeBtn = document.querySelector('.area-quick-btn.active-area') as HTMLElement;
      const selectedArea = activeBtn?.dataset.area || 'all';

      let visibleCount = 0;

      hotelCards.forEach(card => {
        const title = (card.getAttribute('data-title') || "").toLowerCase();
        const area = card.getAttribute('data-area') || "";

        const matchesSearch = searchTerm === "" || title.includes(searchTerm);
        const matchesArea = selectedArea === 'all' || area === selectedArea;

        if (matchesSearch && matchesArea) {
          card.style.display = 'block';
          visibleCount++;
        } else {
          card.style.display = 'none';
        }
      });

      // কাউন্ট আপডেট করা (যদি সাইডবার থাকে)
      if (sidebarCount) {
        sidebarCount.textContent = visibleCount.toString();
      }
    };

    // সার্চ ইনপুট ইভেন্ট
    searchInput?.addEventListener('input', runStickyFilter);

    // এরিয়া বাটন ইভেন্ট
    areaButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        // UI আপডেট (Active class swap)
        areaButtons.forEach(b => {
          b.classList.remove('bg-[#006ce4]', 'text-white', 'shadow-sm', 'active-area');
          b.classList.add('text-slate-600', 'hover:bg-white');
        });

        btn.classList.add('bg-[#006ce4]', 'text-white', 'shadow-sm', 'active-area');
        btn.classList.remove('text-slate-600', 'hover:bg-white');

        runStickyFilter();
      });
    });

    // মোবাইল ড্রয়ার ট্রিগার
    const openDrawerBtn = document.getElementById('openMobileDrawerBtn');
    openDrawerBtn?.addEventListener('click', () => {
      if (typeof (window as any).openFilterDrawer === 'function') {
        (window as any).openFilterDrawer();
      }
    });

    // স্ক্রল ইফেক্ট
    const handleScroll = () => {
      const header = document.querySelector('header');
      if (window.scrollY > 10) {
        header?.classList.add('shadow-md', 'py-1');
      } else {
        header?.classList.remove('shadow-md', 'py-1');
      }
    };
    window.addEventListener('scroll', handleScroll);
  }

  // Astro page loads (View Transitions এর জন্য জরুরি)
  document.addEventListener('astro:page-load', initStickyBar);
  // প্রথমবার লোডের জন্য
  initStickyBar();
</script>

<style>
  header {
    will-change: padding, shadow;
    font-family: 'Plus Jakarta Sans', sans-serif;
  }
  /* মসৃণ এনিমেশনের জন্য */
  .directory-card-item {
    transition: opacity 0.2s ease-in-out;
  }
</style>
