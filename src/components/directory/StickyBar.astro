---
// src/components/directory/StickyBar.astro
---

<header class="sticky top-0 z-[70] bg-white/95 backdrop-blur-md border-b border-slate-200 font-['Plus_Jakarta_Sans',sans-serif]">
  <div class="max-w-[1280px] mx-auto px-4 py-2.5">
    
    <!-- ১. সার্চ ইনপুট -->
    <div class="relative group mb-3">
      <div class="absolute left-3 top-1/2 -translate-y-1/2 text-slate-400">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" stroke-width="2.5" stroke-linecap="round"/></svg>
      </div>
      <input type="text" id="hotelSearchInput" placeholder="Search hotel name..." class="w-full bg-slate-100 focus:bg-white text-sm font-bold rounded-full pl-10 pr-4 py-2.5 outline-none border border-transparent focus:border-blue-500 transition-all shadow-inner" />
    </div>

    <!-- ২. পিল ফিল্টার বাটনসমূহ -->
    <div class="flex items-center gap-2 overflow-x-auto no-scrollbar relative">
      
      <!-- PRICE PILL -->
      <div class="relative pill-group">
        <button type="button" class="pill-btn" data-popup="pricePopup">
          <svg class="w-3.5 h-3.5 text-emerald-600" fill="currentColor" viewBox="0 0 24 24"><path d="M12.5 3H7.8a2 2 0 0 0-1.4.6l-3.8 3.8a2 2 0 0 0 0 2.8l8.2 8.2a2 2 0 0 0 2.8 0l3.8-3.8c.4-.4.6-.9.6-1.4V8.5a5.5 5.5 0 0 0-5.5-5.5z"/></svg>
          <span>Price</span>
          <svg class="w-3 h-3 text-slate-400 arrow transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M19 9l-7 7-7-7" stroke-width="2" stroke-linecap="round"/></svg>
        </button>
        <!-- Price Popup -->
        <div id="pricePopup" class="popup-box hidden">
          <h4 class="text-[11px] font-black uppercase text-slate-400 mb-3">Budget per night</h4>
          <div class="space-y-2">
             <label class="flex items-center gap-2 cursor-pointer"><input type="radio" name="price" value="0-50" class="accent-blue-600"> <span class="text-sm font-bold text-slate-700">Under $50</span></label>
             <label class="flex items-center gap-2 cursor-pointer"><input type="radio" name="price" value="50-150" class="accent-blue-600"> <span class="text-sm font-bold text-slate-700">$50 - $150</span></label>
             <label class="flex items-center gap-2 cursor-pointer"><input type="radio" name="price" value="150+" class="accent-blue-600"> <span class="text-sm font-bold text-slate-700">$150+</span></label>
          </div>
        </div>
      </div>

      <!-- RATING PILL -->
      <div class="relative pill-group">
        <button type="button" class="pill-btn" data-popup="ratingPopup">
          <svg class="w-3.5 h-3.5 text-amber-500" fill="currentColor" viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
          <span>Rating</span>
          <svg class="w-3 h-3 text-slate-400 arrow transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M19 9l-7 7-7-7" stroke-width="2" stroke-linecap="round"/></svg>
        </button>
        <!-- Rating Popup -->
        <div id="ratingPopup" class="popup-box hidden">
          <h4 class="text-[11px] font-black uppercase text-slate-400 mb-3">Guest Rating</h4>
          <div class="space-y-2">
             <label class="flex items-center gap-2 cursor-pointer"><input type="checkbox" value="9" class="accent-blue-600"> <span class="text-sm font-bold text-slate-700">Wonderful: 9+</span></label>
             <label class="flex items-center gap-2 cursor-pointer"><input type="checkbox" value="8" class="accent-blue-600"> <span class="text-sm font-bold text-slate-700">Very Good: 8+</span></label>
          </div>
        </div>
      </div>

      <!-- AREA PILL -->
      <div class="relative pill-group">
        <button type="button" class="pill-btn" data-popup="areaPopup">
          <svg class="w-3.5 h-3.5 text-blue-600" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2C8.1 2 5 5.1 5 9c0 5.2 7 13 7 13s7-7.8 7-13c0-3.9-3.1-7-7-7z"/></svg>
          <span>Area</span>
          <svg class="w-3 h-3 text-slate-400 arrow transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M19 9l-7 7-7-7" stroke-width="2" stroke-linecap="round"/></svg>
        </button>
        <!-- Area Popup -->
        <div id="areaPopup" class="popup-box hidden">
          <h4 class="text-[11px] font-black uppercase text-slate-400 mb-3">Select Neighborhood</h4>
          <div class="space-y-2">
             <label class="flex items-center gap-2 cursor-pointer"><input type="radio" name="area" value="gulshan-1" class="accent-blue-600"> <span class="text-sm font-bold text-slate-700">Gulshan 1</span></label>
             <label class="flex items-center gap-2 cursor-pointer"><input type="radio" name="area" value="gulshan-2" class="accent-blue-600"> <span class="text-sm font-bold text-slate-700">Gulshan 2</span></label>
          </div>
        </div>
      </div>

      <!-- SORT PILL -->
      <div class="relative pill-group">
        <button type="button" class="pill-btn" data-popup="sortPopup">
          <svg class="w-3.5 h-3.5 text-slate-700" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5"><path d="M7 16V4m0 0L3 8m4-4l4 4m6-4v12m0 0l4-4m-4 4l-4-4"/></svg>
          <span>Sort</span>
        </button>
        <!-- Sort Popup -->
        <div id="sortPopup" class="popup-box hidden">
          <div class="space-y-1">
             <button class="w-full text-left p-2 hover:bg-blue-50 rounded-lg text-sm font-bold text-slate-700">Price: Low to High</button>
             <button class="w-full text-left p-2 hover:bg-blue-50 rounded-lg text-sm font-bold text-slate-700">Price: High to Low</button>
             <button class="w-full text-left p-2 hover:bg-blue-50 rounded-lg text-sm font-bold text-slate-700">Top Rated</button>
          </div>
        </div>
      </div>

      <!-- DEALS (Instant Toggle) -->
      <button type="button" id="quickDealsBtn" class="pill-btn border-red-100 text-red-600 hover:bg-red-50">
        <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M21.41 11.58l-9-9C12.05 2.22 11.55 2 11 2H4c-1.1 0-2 .9-2 2v7c0 .55.22 1.05.59 1.42l9 9c.36.36.86.58 1.41.58.55 0 1.05-.22 1.41-.59l7-7c.37-.36.59-.86.59-1.41 0-.55-.23-1.06-.59-1.42z"/></svg>
        <span>Deals</span>
      </button>

    </div>
  </div>
</header>

<style>
  /* পিল বাটন স্টাইল */
  .pill-btn {
    @apply shrink-0 flex items-center gap-1.5 px-4 py-2 rounded-full border border-slate-200 bg-white text-[13px] font-bold text-slate-700 transition-all active:scale-95 hover:border-slate-300 hover:shadow-sm cursor-pointer whitespace-nowrap outline-none;
  }
  
  /* পপআপ বক্স স্টাইল */
  .popup-box {
    @apply absolute top-full left-0 mt-2 w-[220px] bg-white border border-slate-200 rounded-2xl shadow-2xl p-4 z-[80] animate-in fade-in slide-in-from-top-2 duration-200;
  }

  /* মোবাইলে পপআপ বক্সকে নিচ থেকে আনা (Bottom Sheet) */
  @media (max-width: 768px) {
    .popup-box {
      @apply fixed top-auto bottom-0 left-0 right-0 w-full mt-0 rounded-t-3xl rounded-b-none border-t border-slate-200 animate-in slide-in-from-bottom-full;
    }
  }

  .no-scrollbar::-webkit-scrollbar { display: none; }
  .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
</style>

<script is:inline>
  function setupStickyFilters() {
    const pills = document.querySelectorAll('.pill-btn[data-popup]');
    const popups = document.querySelectorAll('.popup-box');

    // পপআপ খোলা/বন্ধ করার ফাংশন
    pills.forEach(pill => {
      pill.onclick = (e) => {
        e.stopPropagation();
        const popupId = pill.getAttribute('data-popup');
        const targetPopup = document.getElementById(popupId);
        
        // অন্য সব খোলা পপআপ বন্ধ করা
        const isAlreadyOpen = !targetPopup.classList.contains('hidden');
        popups.forEach(p => p.classList.add('hidden'));
        document.querySelectorAll('.pill-btn .arrow').forEach(a => a.classList.remove('rotate-180'));

        if (!isAlreadyOpen) {
          targetPopup.classList.remove('hidden');
          pill.querySelector('.arrow')?.classList.add('rotate-180');
        }
      };
    });

    // পপআপের বাইরে ক্লিক করলে বন্ধ করা
    document.addEventListener('click', (e) => {
      if (!e.target.closest('.pill-group')) {
        popups.forEach(p => p.classList.add('hidden'));
        document.querySelectorAll('.pill-btn .arrow').forEach(a => a.classList.remove('rotate-180'));
      }
    });

    // সার্চ লজিক
    const searchInput = document.getElementById('hotelSearchInput');
    const hotelCards = document.querySelectorAll('.directory-card-item');

    searchInput?.addEventListener('input', (e) => {
      const term = e.target.value.toLowerCase().trim();
      hotelCards.forEach(card => {
        const title = card.getAttribute('data-title') || "";
        card.style.display = title.includes(term) ? 'flex' : 'none';
      });
    });

    // ডিলস লজিক
    const dealsBtn = document.getElementById('quickDealsBtn');
    let dealsActive = false;
    dealsBtn.onclick = () => {
      dealsActive = !dealsActive;
      dealsBtn.classList.toggle('bg-red-600', dealsActive);
      dealsBtn.classList.toggle('text-white', dealsActive);
      hotelCards.forEach(card => {
        const hasDiscount = card.querySelector('.bg-red-600');
        card.style.display = dealsActive ? (hasDiscount ? 'flex' : 'none') : 'flex';
      });
    };
  }

  document.addEventListener('astro:page-load', setupStickyFilters);
  setupStickyFilters();
</script>
