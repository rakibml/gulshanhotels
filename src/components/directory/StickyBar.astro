---
// src/components/directory/StickyBar.astro
---

<header class="sticky top-0 z-[500] bg-white/95 border-b border-slate-200 font-['Plus_Jakarta_Sans',sans-serif]">
  <div class="max-w-[1280px] mx-auto px-4 py-3 relative">
    
    <!-- ১. পিল বাটন কন্টেইনার (শুধুমাত্র বাটনগুলো স্ক্রল করবে) -->
    <div class="flex items-center gap-2 overflow-x-auto no-scrollbar relative z-10">
      
      <!-- Price Button -->
      <button type="button" class="pill-trigger shrink-0 flex items-center gap-1.5 px-4 py-2 rounded-full border border-slate-200 bg-white text-[13px] font-bold text-slate-700 active:scale-95 transition-all" data-target="priceBox">
        <svg class="w-3.5 h-3.5 text-emerald-600" fill="currentColor" viewBox="0 0 24 24"><path d="M12.5 3H7.8a2 2 0 0 0-1.4.6l-3.8 3.8a2 2 0 0 0 0 2.8l8.2 8.2a2 2 0 0 0 2.8 0l3.8-3.8c.4-.4.6-.9.6-1.4V8.5a5.5 5.5 0 0 0-5.5-5.5z"/></svg>
        <span>Price</span>
        <svg class="w-3 h-3 text-slate-400 arrow transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M19 9l-7 7-7-7" stroke-width="2.5" stroke-linecap="round"/></svg>
      </button>

      <!-- Rating Button -->
      <button type="button" class="pill-trigger shrink-0 flex items-center gap-1.5 px-4 py-2 rounded-full border border-slate-200 bg-white text-[13px] font-bold text-slate-700 active:scale-95 transition-all" data-target="ratingBox">
        <svg class="w-3.5 h-3.5 text-amber-500" fill="currentColor" viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
        <span>Rating</span>
        <svg class="w-3 h-3 text-slate-400 arrow transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M19 9l-7 7-7-7" stroke-width="2.5" stroke-linecap="round"/></svg>
      </button>

      <!-- Area Button -->
      <button type="button" class="pill-trigger shrink-0 flex items-center gap-1.5 px-4 py-2 rounded-full border border-slate-200 bg-white text-[13px] font-bold text-slate-700 active:scale-95 transition-all" data-target="areaBox">
        <svg class="w-3.5 h-3.5 text-blue-600" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2C8.1 2 5 5.1 5 9c0 5.2 7 13 7 13s7-7.8 7-13c0-3.9-3.1-7-7-7z"/></svg>
        <span>Area</span>
        <svg class="w-3 h-3 text-slate-400 arrow transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M19 9l-7 7-7-7" stroke-width="2.5" stroke-linecap="round"/></svg>
      </button>

      <!-- Deals Button -->
      <button type="button" id="quickDealsBtn" class="shrink-0 flex items-center gap-1.5 px-4 py-2 rounded-full border border-red-100 bg-white text-[13px] font-[800] text-red-600 transition-all active:scale-95">
        <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M21.41 11.58l-9-9C12.05 2.22 11.55 2 11 2H4c-1.1 0-2 .9-2 2v7c0 .55.22 1.05.59 1.42l9 9c.36.36.86.58 1.41.58.55 0 1.05-.22 1.41-.59l7-7c.37-.36.59-.86.59-1.41 0-.55-.23-1.06-.59-1.42z"/></svg>
        <span>Deals</span>
      </button>
    </div>

    <!-- ২. একটিভ চিপস -->
    <div id="activeFiltersContainer" class="flex flex-wrap items-center gap-2 mt-2 hidden">
       <span class="text-[10px] font-black uppercase text-slate-400">Active:</span>
       <div id="chipsList" class="flex flex-wrap gap-2"></div>
       <button id="clearAllFiltersBtn" class="text-[10px] font-black text-blue-600 hover:underline uppercase">Clear</button>
    </div>

    <!-- ৩. পপআপ পোর্টাল (হেডারের ভেতরে কিন্তু বাটনের বাইরে) -->
    <div id="popupPortal" class="relative">
      
      <!-- Price Popup -->
      <div id="priceBox" class="filter-popup hidden fixed md:absolute top-auto bottom-0 md:bottom-auto md:top-[12px] left-0 md:left-0 w-full md:w-[260px] bg-white border border-slate-200 rounded-t-[24px] md:rounded-[20px] shadow-2xl p-6 z-[1000]">
        <h4 class="text-[12px] font-black uppercase text-slate-400 mb-4 tracking-widest">Budget</h4>
        <div class="space-y-4">
           <label class="flex items-center justify-between cursor-pointer"><span class="text-sm font-bold text-slate-700">All Prices</span><input type="radio" name="price" value="all" checked class="w-5 h-5 accent-blue-600"></label>
           <label class="flex items-center justify-between cursor-pointer"><span class="text-sm font-bold text-slate-700">Budget Friendly</span><input type="radio" name="price" value="low" class="w-5 h-5 accent-blue-600"></label>
           <label class="flex items-center justify-between cursor-pointer"><span class="text-sm font-bold text-slate-700">Premium Stays</span><input type="radio" name="price" value="high" class="w-5 h-5 accent-blue-600"></label>
        </div>
      </div>

      <!-- Rating Popup -->
      <div id="ratingBox" class="filter-popup hidden fixed md:absolute top-auto bottom-0 md:bottom-auto md:top-[12px] left-0 md:left-[110px] w-full md:w-[240px] bg-white border border-slate-200 rounded-t-[24px] md:rounded-[20px] shadow-2xl p-6 z-[1000]">
        <h4 class="text-[12px] font-black uppercase text-slate-400 mb-4 tracking-widest">Guest Rating</h4>
        <div class="space-y-4">
           <label class="flex items-center gap-3 cursor-pointer"><input type="checkbox" name="rating_score" value="9" class="w-5 h-5 accent-blue-600"><span class="text-sm font-bold text-slate-700">Wonderful 9+</span></label>
           <label class="flex items-center gap-3 cursor-pointer"><input type="checkbox" name="rating_score" value="8" class="w-5 h-5 accent-blue-600"><span class="text-sm font-bold text-slate-700">Very Good 8+</span></label>
        </div>
      </div>

      <!-- Area Popup -->
      <div id="areaBox" class="filter-popup hidden fixed md:absolute top-auto bottom-0 md:bottom-auto md:top-[12px] left-0 md:left-[210px] w-full md:w-[240px] bg-white border border-slate-200 rounded-t-[24px] md:rounded-[20px] shadow-2xl p-6 z-[1000]">
        <h4 class="text-[12px] font-black uppercase text-slate-400 mb-4 tracking-widest">Neighborhood</h4>
        <div class="space-y-4">
           <label class="flex items-center justify-between cursor-pointer"><span class="text-sm font-bold text-slate-700">All Gulshan</span><input type="radio" name="area" value="all" checked class="w-5 h-5 accent-blue-600"></label>
           <label class="flex items-center justify-between cursor-pointer"><span class="text-sm font-bold text-slate-700">Gulshan 1</span><input type="radio" name="area" value="gulshan-1" class="w-5 h-5 accent-blue-600"></label>
           <label class="flex items-center justify-between cursor-pointer"><span class="text-sm font-bold text-slate-700">Gulshan 2</span><input type="radio" name="area" value="gulshan-2" class="w-5 h-5 accent-blue-600"></label>
        </div>
      </div>

    </div>
  </div>

  <!-- ৪. ওভারলে (হেডারের ভেতরে রাখা হয়েছে যেন z-index কন্ট্রোল করা যায়) -->
  <div id="filterOverlay" class="fixed inset-0 bg-slate-900/40 backdrop-blur-[2px] z-[900] hidden"></div>
</header>

<style>
  .no-scrollbar::-webkit-scrollbar { display: none; }
  .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
  
  @media (max-width: 768px) {
    .filter-popup {
      z-index: 2000 !important; /* ওভারলে থেকে বেশি */
      animation: slideUp 0.3s ease-out;
    }
  }
  @keyframes slideUp { from { transform: translateY(100%); } to { transform: translateY(0); } }
</style>

<script is:inline>
  function setupStickyFilters() {
    const triggers = document.querySelectorAll('.pill-trigger');
    const popups = document.querySelectorAll('.filter-popup');
    const overlay = document.getElementById('filterOverlay');
    const dealsBtn = document.getElementById('quickDealsBtn');
    const chipsList = document.getElementById('chipsList');
    const chipsContainer = document.getElementById('activeFiltersContainer');
    const clearAllBtn = document.getElementById('clearAllFiltersBtn');
    
    let dealsActive = false;

    const closePopups = () => {
      popups.forEach(p => p.classList.add('hidden'));
      overlay.classList.add('hidden');
      document.body.style.overflow = '';
      document.querySelectorAll('.arrow').forEach(a => a.classList.remove('rotate-180'));
    };

    const runFiltering = () => {
      const hotelCards = document.querySelectorAll('.directory-card-item');
      const selectedPrice = document.querySelector('input[name="price"]:checked')?.value || "all";
      const selectedArea = document.querySelector('input[name="area"]:checked')?.value || "all";
      const selectedRatings = Array.from(document.querySelectorAll('input[name="rating_score"]:checked')).map(cb => parseFloat(cb.value));

      hotelCards.forEach(card => {
        const area = card.getAttribute('data-area') || "";
        const price = parseFloat(card.getAttribute('data-numeric-price') || "0");
        const rating = parseFloat(card.getAttribute('data-numeric-rating') || "0");
        const hasDiscount = card.querySelector('.bg-red-600') || card.querySelector('span[class*="red"]');

        const matchesArea = (selectedArea === "all" || area === selectedArea);
        let matchesPrice = true;
        if (selectedPrice === "low") matchesPrice = price < 5000;
        else if (selectedPrice === "high") matchesPrice = price >= 5000;
        let matchesRating = true;
        if (selectedRatings.length > 0) matchesRating = selectedRatings.some(r => rating >= r);
        let matchesDeals = dealsActive ? !!hasDiscount : true;

        card.style.display = (matchesArea && matchesPrice && matchesRating && matchesDeals) ? 'flex' : 'none';
      });

      updateChips();
    };

    const updateChips = () => {
      chipsList.innerHTML = '';
      let activeCount = 0;
      document.querySelectorAll('.filter-popup input').forEach(input => {
        if ((input.type === 'radio' && input.checked && input.value !== 'all') || (input.type === 'checkbox' && input.checked)) {
          activeCount++;
          const chip = document.createElement('div');
          chip.className = "bg-blue-50 text-blue-600 border border-blue-100 px-2 py-0.5 rounded-lg text-[11px] font-bold flex items-center gap-1";
          chip.innerHTML = `${input.closest('label').innerText} <button class="font-black">&times;</button>`;
          chip.querySelector('button').onclick = () => {
             if(input.type === 'radio') document.querySelector(`input[name="${input.name}"][value="all"]`).checked = true;
             else input.checked = false;
             runFiltering();
          };
          chipsList.appendChild(chip);
        }
      });
      if(dealsActive) {
        activeCount++;
        const chip = document.createElement('div');
        chip.className = "bg-red-50 text-red-600 border border-red-100 px-2 py-0.5 rounded-lg text-[11px] font-bold flex items-center gap-1";
        chip.innerHTML = `Deals Active <button class="font-black">&times;</button>`;
        chip.querySelector('button').onclick = () => dealsBtn.click();
        chipsList.appendChild(chip);
      }
      chipsContainer.classList.toggle('hidden', activeCount === 0);
    };

    document.querySelectorAll('.filter-popup input').forEach(i => i.onchange = () => {
      runFiltering();
      if(i.type === 'radio') setTimeout(closePopups, 200);
    });

    triggers.forEach(btn => btn.onclick = (e) => {
      e.stopPropagation();
      const target = document.getElementById(btn.dataset.target);
      const isHidden = target.classList.contains('hidden');
      closePopups();
      if(isHidden) {
        target.classList.remove('hidden');
        overlay.classList.remove('hidden');
        if(window.innerWidth < 768) document.body.style.overflow = 'hidden';
        btn.querySelector('.arrow')?.classList.add('rotate-180');
      }
    });

    overlay.onclick = closePopups;
    dealsBtn.onclick = () => {
      dealsActive = !dealsActive;
      dealsBtn.classList.toggle('bg-red-600', dealsActive);
      dealsBtn.classList.toggle('text-white', dealsActive);
      runFiltering();
    };
    clearAllBtn.onclick = () => {
      document.querySelectorAll('input[value="all"]').forEach(i => i.checked = true);
      document.querySelectorAll('input[type="checkbox"]').forEach(i => i.checked = false);
      if(dealsActive) dealsBtn.click();
      runFiltering();
    };
  }

  setupStickyFilters();
  document.addEventListener('astro:after-swap', setupStickyFilters);
</script>
