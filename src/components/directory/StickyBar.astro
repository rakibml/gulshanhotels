---
// src/components/directory/StickyBar.astro
---

<header class="sticky top-0 z-30 bg-white border-b border-slate-200/90 shadow-xs">
  <div class="max-w-[1200px] mx-auto px-3 sm:px-4 py-2.5 sm:py-3 flex items-center justify-between gap-2 sm:gap-4">
    
    <!-- Search Input -->
    <div class="relative flex-1 max-w-md">
      <input 
        type="text" 
        id="hotelSearchInput" 
        placeholder="Search hotel name, location..." 
        class="w-full bg-slate-100 hover:bg-slate-50 focus:bg-white text-xs sm:text-sm font-semibold rounded-xl pl-8 sm:pl-9 pr-3 py-2 border border-slate-200 focus:border-[#006ce4] focus:outline-none transition"
      />
      <svg class="w-4 h-4 text-slate-400 absolute left-2.5 top-1/2 -translate-y-1/2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
      </svg>
    </div>

    <!-- Quick Filters (Desktop) -->
    <div class="hidden md:flex items-center gap-2 text-xs font-bold text-slate-700">
      <button type="button" class="area-quick-btn px-3 py-1.5 rounded-lg border border-slate-200 bg-[#006ce4] text-white transition cursor-pointer" data-area="all">All Areas</button>
      <button type="button" class="area-quick-btn px-3 py-1.5 rounded-lg border border-slate-200 bg-white hover:bg-slate-50 transition cursor-pointer" data-area="gulshan-1">Gulshan 1</button>
      <button type="button" class="area-quick-btn px-3 py-1.5 rounded-lg border border-slate-200 bg-white hover:bg-slate-50 transition cursor-pointer" data-area="gulshan-2">Gulshan 2</button>
    </div>

    <!-- Mobile Filter Drawer Trigger Button -->
    <button 
      type="button" 
      id="openMobileDrawerBtn" 
      class="md:hidden flex items-center gap-1.5 bg-[#006ce4] hover:bg-[#0057b8] text-white text-xs font-bold px-3 py-2 rounded-xl shadow-xs shrink-0 cursor-pointer transition active:scale-95"
    >
      <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M10 18h4v-2h-4v2zM3 6v2h18V6H3zm3 7h12v-2H6v2z"/></svg>
      <span>Filters</span>
    </button>

  </div>
</header>
