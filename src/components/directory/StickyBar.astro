---
// src/components/directory/StickyBar.astro (Smart Synonym Matcher for Amenities)
---

<header class="sticky top-0 z-[500] bg-white border-b border-slate-200 font-['Plus_Jakarta_Sans',sans-serif] shadow-xs">
  <div class="max-w-[1280px] mx-auto px-3 sm:px-4 py-2.5 relative">
    
    <!-- ১. অনুভূমিক স্ক্রলযোগ্য পিল বার -->
    <div class="flex items-center gap-2 overflow-x-auto no-scrollbar relative z-10 py-0.5">
      
      <!-- Instant Search Pill -->
      <div class="relative shrink-0 w-36 sm:w-48">
        <input 
          type="text" 
          id="stickySearchInput" 
          placeholder="Search hotel..." 
          class="w-full bg-slate-100 focus:bg-white text-xs font-semibold rounded-full pl-7 pr-2.5 py-2 border border-slate-200 focus:border-[#006ce4] focus:outline-none transition"
        />
        <svg class="w-3.5 h-3.5 text-slate-400 absolute left-2.5 top-1/2 -translate-y-1/2 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
        </svg>
      </div>

      <!-- Price Pill -->
      <button type="button" class="pill-trigger shrink-0 flex items-center gap-1.5 px-3.5 py-2 rounded-full border border-slate-200 bg-white text-xs font-bold text-slate-700 hover:border-slate-300 active:scale-95 transition-all cursor-pointer" data-target="priceBox">
        <svg class="w-3.5 h-3.5 text-emerald-600 shrink-0" fill="currentColor" viewBox="0 0 24 24"><path d="M12.5 3H7.8a2 2 0 0 0-1.4.6l-3.8 3.8a2 2 0 0 0 0 2.8l8.2 8.2a2 2 0 0 0 2.8 0l3.8-3.8c.4-.4.6-.9.6-1.4V8.5a5.5 5.5 0 0 0-5.5-5.5z"/></svg>
        <span>Price</span>
        <span class="pill-badge hidden bg-[#006ce4] text-white text-[10px] w-4 h-4 rounded-full items-center justify-center font-black"></span>
        <svg class="w-3 h-3 text-slate-400 arrow transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M19 9l-7 7-7-7" stroke-width="2.5" stroke-linecap="round"/></svg>
      </button>

      <!-- Hotel Stars Pill -->
      <button type="button" class="pill-trigger shrink-0 flex items-center gap-1.5 px-3.5 py-2 rounded-full border border-slate-200 bg-white text-xs font-bold text-slate-700 hover:border-slate-300 active:scale-95 transition-all cursor-pointer" data-target="starsBox">
        <span class="text-[#febb02] text-xs">★</span>
        <span>Stars</span>
        <span class="pill-badge hidden bg-[#006ce4] text-white text-[10px] w-4 h-4 rounded-full items-center justify-center font-black"></span>
        <svg class="w-3 h-3 text-slate-400 arrow transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M19 9l-7 7-7-7" stroke-width="2.5" stroke-linecap="round"/></svg>
      </button>

      <!-- Rating Pill -->
      <button type="button" class="pill-trigger shrink-0 flex items-center gap-1.5 px-3.5 py-2 rounded-full border border-slate-200 bg-white text-xs font-bold text-slate-700 hover:border-slate-300 active:scale-95 transition-all cursor-pointer" data-target="ratingBox">
        <svg class="w-3.5 h-3.5 text-amber-500 shrink-0" fill="currentColor" viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
        <span>Rating</span>
        <span class="pill-badge hidden bg-[#006ce4] text-white text-[10px] w-4 h-4 rounded-full items-center justify-center font-black"></span>
        <svg class="w-3 h-3 text-slate-400 arrow transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M19 9l-7 7-7-7" stroke-width="2.5" stroke-linecap="round"/></svg>
      </button>

      <!-- Area Pill -->
      <button type="button" class="pill-trigger shrink-0 flex items-center gap-1.5 px-3.5 py-2 rounded-full border border-slate-200 bg-white text-xs font-bold text-slate-700 hover:border-slate-300 active:scale-95 transition-all cursor-pointer" data-target="areaBox">
        <svg class="w-3.5 h-3.5 text-blue-600 shrink-0" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2C8.1 2 5 5.1 5 9c0 5.2 7 13 7 13s7-7.8 7-13c0-3.9-3.1-7-7-7z"/></svg>
        <span>Area</span>
        <span class="pill-badge hidden bg-[#006ce4] text-white text-[10px] w-4 h-4 rounded-full items-center justify-center font-black"></span>
        <svg class="w-3 h-3 text-slate-400 arrow transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M19 9l-7 7-7-7" stroke-width="2.5" stroke-linecap="round"/></svg>
      </button>

      <!-- Amenities Pill (Smart Filtering) -->
      <button type="button" class="pill-trigger shrink-0 flex items-center gap-1.5 px-3.5 py-2 rounded-full border border-slate-200 bg-white text-xs font-bold text-slate-700 hover:border-slate-300 active:scale-95 transition-all cursor-pointer" data-target="amenitiesBox">
        <svg class="w-3.5 h-3.5 text-teal-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
        <span>Amenities</span>
        <span class="pill-badge hidden bg-[#006ce4] text-white text-[10px] w-4 h-4 rounded-full items-center justify-center font-black"></span>
        <svg class="w-3 h-3 text-slate-400 arrow transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M19 9l-7 7-7-7" stroke-width="2.5" stroke-linecap="round"/></svg>
      </button>

      <!-- Property Type Pill -->
      <button type="button" class="pill-trigger shrink-0 flex items-center gap-1.5 px-3.5 py-2 rounded-full border border-slate-200 bg-white text-xs font-bold text-slate-700 hover:border-slate-300 active:scale-95 transition-all cursor-pointer" data-target="propertyTypeBox">
        <svg class="w-3.5 h-3.5 text-indigo-600 shrink-0" fill="currentColor" viewBox="0 0 24 24"><path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-7 3c1.66 0 3 1.34 3 3s-1.34 3-3 3-3-1.34-3-3 1.34-3 3-3zm3 10H9v-1c0-1 2-1.9 3-1.9s3 .9 3 1.9v1z"/></svg>
        <span>Type</span>
        <span class="pill-badge hidden bg-[#006ce4] text-white text-[10px] w-4 h-4 rounded-full items-center justify-center font-black"></span>
        <svg class="w-3 h-3 text-slate-400 arrow transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M19 9l-7 7-7-7" stroke-width="2.5" stroke-linecap="round"/></svg>
      </button>

      <!-- Deals Pill -->
      <button type="button" id="quickDealsBtn" class="shrink-0 flex items-center gap-1.5 px-3.5 py-2 rounded-full border border-rose-200 bg-rose-50/50 hover:bg-rose-50 text-xs font-black text-rose-600 transition-all active:scale-95 cursor-pointer">
        <svg class="w-3.5 h-3.5 fill-current shrink-0" viewBox="0 0 24 24"><path d="M21.41 11.58l-9-9C12.05 2.22 11.55 2 11 2H4c-1.1 0-2 .9-2 2v7c0 .55.22 1.05.59 1.42l9 9c.36.36.86.58 1.41.58.55 0 1.05-.22 1.41-.59l7-7c.37-.36.59-.86.59-1.41 0-.55-.23-1.06-.59-1.42z"/></svg>
        <span>Deals</span>
      </button>

      <!-- Sort By Pill -->
      <button type="button" class="pill-trigger shrink-0 flex items-center gap-1.5 px-3.5 py-2 rounded-full border border-slate-200 bg-white text-xs font-bold text-slate-700 hover:border-slate-300 active:scale-95 transition-all cursor-pointer ml-auto" data-target="sortBox">
        <svg class="w-3.5 h-3.5 text-slate-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 4h18M3 8h12m-12 4h6m8 2l4 4m0 0l-4 4m4-4H11"/></svg>
        <span id="sortPillLabel">Sort</span>
        <svg class="w-3 h-3 text-slate-400 arrow transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M19 9l-7 7-7-7" stroke-width="2.5" stroke-linecap="round"/></svg>
      </button>

    </div>

    <!-- ২. অ্যাক্টিভ ফিল্টার চিপস -->
    <div id="activeFiltersContainer" class="flex flex-wrap items-center gap-2 mt-2 pt-2 border-t border-slate-100 hidden text-left">
       <span class="text-[10px] font-black uppercase text-slate-400 tracking-wider">Active:</span>
       <div id="chipsList" class="flex flex-wrap gap-1.5"></div>
       <button type="button" id="clearAllFiltersBtn" class="text-[11px] font-bold text-[#006ce4] hover:underline cursor-pointer ml-auto">
         Reset all
       </button>
    </div>

    <!-- ৩. পপআপ পোর্টাল -->
    <div id="popupPortal">
      
      <!-- Price Popup -->
      <div id="priceBox" class="filter-popup hidden fixed md:absolute bottom-0 md:bottom-auto md:top-[10px] left-0 md:left-[110px] right-0 md:right-auto w-full md:w-[280px] bg-white border border-slate-200 rounded-t-[28px] md:rounded-[20px] shadow-2xl p-5 z-[2000] text-left">
        <div class="md:hidden w-10 h-1 bg-slate-300 rounded-full mx-auto mb-3"></div>
        <div class="flex items-center justify-between border-b border-slate-100 pb-2 mb-3">
          <h4 class="text-xs font-black uppercase text-slate-900 tracking-wider">Budget (per night)</h4>
          <button type="button" class="close-popup-btn text-slate-400 hover:text-slate-900 text-lg font-bold p-1 cursor-pointer">&times;</button>
        </div>
        <div class="space-y-2.5">
           <label class="flex items-center justify-between cursor-pointer p-2 rounded-xl hover:bg-slate-50 transition"><span class="text-xs font-bold text-slate-700">All Prices</span><input type="radio" name="sticky_price" value="all" checked class="w-4 h-4 accent-[#006ce4]"></label>
           <label class="flex items-center justify-between cursor-pointer p-2 rounded-xl hover:bg-slate-50 transition"><span class="text-xs font-bold text-slate-700">Budget (&lt; ৳6,000)</span><input type="radio" name="sticky_price" value="low" class="w-4 h-4 accent-[#006ce4]"></label>
           <label class="flex items-center justify-between cursor-pointer p-2 rounded-xl hover:bg-slate-50 transition"><span class="text-xs font-bold text-slate-700">Mid-Range (৳6,000 - ৳15,000)</span><input type="radio" name="sticky_price" value="mid" class="w-4 h-4 accent-[#006ce4]"></label>
           <label class="flex items-center justify-between cursor-pointer p-2 rounded-xl hover:bg-slate-50 transition"><span class="text-xs font-bold text-slate-700">Luxury (&gt; ৳15,000)</span><input type="radio" name="sticky_price" value="high" class="w-4 h-4 accent-[#006ce4]"></label>
        </div>
      </div>

      <!-- Hotel Stars Popup -->
      <div id="starsBox" class="filter-popup hidden fixed md:absolute bottom-0 md:bottom-auto md:top-[10px] left-0 md:left-[200px] right-0 md:right-auto w-full md:w-[260px] bg-white border border-slate-200 rounded-t-[28px] md:rounded-[20px] shadow-2xl p-5 z-[2000] text-left">
        <div class="md:hidden w-10 h-1 bg-slate-300 rounded-full mx-auto mb-3"></div>
        <div class="flex items-center justify-between border-b border-slate-100 pb-2 mb-3">
          <h4 class="text-xs font-black uppercase text-slate-900 tracking-wider">Hotel Class</h4>
          <button type="button" class="close-popup-btn text-slate-400 hover:text-slate-900 text-lg font-bold p-1 cursor-pointer">&times;</button>
        </div>
        <div class="space-y-2">
           <label class="flex items-center justify-between cursor-pointer p-2 rounded-xl hover:bg-slate-50 transition">
             <span class="text-xs font-bold text-slate-700 flex items-center gap-1.5"><span class="text-[#febb02]">★★★★★</span> 5 Stars</span>
             <input type="checkbox" name="sticky_stars" value="5" class="w-4 h-4 accent-[#006ce4] rounded">
           </label>
           <label class="flex items-center justify-between cursor-pointer p-2 rounded-xl hover:bg-slate-50 transition">
             <span class="text-xs font-bold text-slate-700 flex items-center gap-1.5"><span class="text-[#febb02]">★★★★</span> 4 Stars</span>
             <input type="checkbox" name="sticky_stars" value="4" class="w-4 h-4 accent-[#006ce4] rounded">
           </label>
           <label class="flex items-center justify-between cursor-pointer p-2 rounded-xl hover:bg-slate-50 transition">
             <span class="text-xs font-bold text-slate-700 flex items-center gap-1.5"><span class="text-[#febb02]">★★★</span> 3 Stars</span>
             <input type="checkbox" name="sticky_stars" value="3" class="w-4 h-4 accent-[#006ce4] rounded">
           </label>
        </div>
        <div class="pt-3 mt-2 border-t border-slate-100 flex items-center justify-between">
          <button type="button" class="clear-section-btn text-xs font-bold text-slate-400 hover:text-slate-700" data-group="sticky_stars">Clear</button>
          <button type="button" class="apply-action-btn bg-[#006ce4] hover:bg-[#0057b8] text-white text-xs font-bold px-4 py-1.5 rounded-lg shadow-xs transition">Apply</button>
        </div>
      </div>

      <!-- Rating Popup -->
      <div id="ratingBox" class="filter-popup hidden fixed md:absolute bottom-0 md:bottom-auto md:top-[10px] left-0 md:left-[280px] right-0 md:right-auto w-full md:w-[250px] bg-white border border-slate-200 rounded-t-[28px] md:rounded-[20px] shadow-2xl p-5 z-[2000] text-left">
        <div class="md:hidden w-10 h-1 bg-slate-300 rounded-full mx-auto mb-3"></div>
        <div class="flex items-center justify-between border-b border-slate-100 pb-2 mb-3">
          <h4 class="text-xs font-black uppercase text-slate-900 tracking-wider">Guest Rating</h4>
          <button type="button" class="close-popup-btn text-slate-400 hover:text-slate-900 text-lg font-bold p-1 cursor-pointer">&times;</button>
        </div>
        <div class="space-y-2">
           <label class="flex items-center justify-between cursor-pointer p-2 rounded-xl hover:bg-slate-50 transition"><span class="text-xs font-bold text-slate-700">Wonderful 9.0+</span><input type="checkbox" name="sticky_rating" value="9" class="w-4 h-4 accent-[#006ce4] rounded"></label>
           <label class="flex items-center justify-between cursor-pointer p-2 rounded-xl hover:bg-slate-50 transition"><span class="text-xs font-bold text-slate-700">Very Good 8.0+</span><input type="checkbox" name="sticky_rating" value="8" class="w-4 h-4 accent-[#006ce4] rounded"></label>
           <label class="flex items-center justify-between cursor-pointer p-2 rounded-xl hover:bg-slate-50 transition"><span class="text-xs font-bold text-slate-700">Good 7.0+</span><input type="checkbox" name="sticky_rating" value="7" class="w-4 h-4 accent-[#006ce4] rounded"></label>
        </div>
        <div class="pt-3 mt-2 border-t border-slate-100 flex items-center justify-between">
          <button type="button" class="clear-section-btn text-xs font-bold text-slate-400 hover:text-slate-700" data-group="sticky_rating">Clear</button>
          <button type="button" class="apply-action-btn bg-[#006ce4] hover:bg-[#0057b8] text-white text-xs font-bold px-4 py-1.5 rounded-lg shadow-xs transition">Apply</button>
        </div>
      </div>

      <!-- Area Popup -->
      <div id="areaBox" class="filter-popup hidden fixed md:absolute bottom-0 md:bottom-auto md:top-[10px] left-0 md:left-[360px] right-0 md:right-auto w-full md:w-[250px] bg-white border border-slate-200 rounded-t-[28px] md:rounded-[20px] shadow-2xl p-5 z-[2000] text-left">
        <div class="md:hidden w-10 h-1 bg-slate-300 rounded-full mx-auto mb-3"></div>
        <div class="flex items-center justify-between border-b border-slate-100 pb-2 mb-3">
          <h4 class="text-xs font-black uppercase text-slate-900 tracking-wider">Neighborhood</h4>
          <button type="button" class="close-popup-btn text-slate-400 hover:text-slate-900 text-lg font-bold p-1 cursor-pointer">&times;</button>
        </div>
        <div class="space-y-2.5">
           <label class="flex items-center justify-between cursor-pointer p-2 rounded-xl hover:bg-slate-50 transition"><span class="text-xs font-bold text-slate-700">All Gulshan</span><input type="radio" name="sticky_area" value="all" checked class="w-4 h-4 accent-[#006ce4]"></label>
           <label class="flex items-center justify-between cursor-pointer p-2 rounded-xl hover:bg-slate-50 transition"><span class="text-xs font-bold text-slate-700">Gulshan 1</span><input type="radio" name="sticky_area" value="gulshan-1" class="w-4 h-4 accent-[#006ce4]"></label>
           <label class="flex items-center justify-between cursor-pointer p-2 rounded-xl hover:bg-slate-50 transition"><span class="text-xs font-bold text-slate-700">Gulshan 2</span><input type="radio" name="sticky_area" value="gulshan-2" class="w-4 h-4 accent-[#006ce4]"></label>
           <label class="flex items-center justify-between cursor-pointer p-2 rounded-xl hover:bg-slate-50 transition"><span class="text-xs font-bold text-slate-700">Near Gulshan</span><input type="radio" name="sticky_area" value="near" class="w-4 h-4 accent-[#006ce4]"></label>
        </div>
      </div>

      <!-- Amenities Popup (Smart Match for WiFi, Pool, Breakfast, Gym) -->
      <div id="amenitiesBox" class="filter-popup hidden fixed md:absolute bottom-0 md:bottom-auto md:top-[10px] left-0 md:left-[430px] right-0 md:right-auto w-full md:w-[270px] bg-white border border-slate-200 rounded-t-[28px] md:rounded-[20px] shadow-2xl p-5 z-[2000] text-left">
        <div class="md:hidden w-10 h-1 bg-slate-300 rounded-full mx-auto mb-3"></div>
        <div class="flex items-center justify-between border-b border-slate-100 pb-2 mb-3">
          <h4 class="text-xs font-black uppercase text-slate-900 tracking-wider">Key Facilities</h4>
          <button type="button" class="close-popup-btn text-slate-400 hover:text-slate-900 text-lg font-bold p-1 cursor-pointer">&times;</button>
        </div>
        <div class="space-y-2">
           <label class="flex items-center justify-between cursor-pointer p-2 rounded-xl hover:bg-slate-50 transition"><span class="text-xs font-bold text-slate-700">📶 Free Wi-Fi</span><input type="checkbox" name="sticky_amenity" value="wifi" class="w-4 h-4 accent-[#006ce4] rounded"></label>
           <label class="flex items-center justify-between cursor-pointer p-2 rounded-xl hover:bg-slate-50 transition"><span class="text-xs font-bold text-slate-700">🏊 Swimming Pool</span><input type="checkbox" name="sticky_amenity" value="pool" class="w-4 h-4 accent-[#006ce4] rounded"></label>
           <label class="flex items-center justify-between cursor-pointer p-2 rounded-xl hover:bg-slate-50 transition"><span class="text-xs font-bold text-slate-700">🍳 Free Breakfast</span><input type="checkbox" name="sticky_amenity" value="breakfast" class="w-4 h-4 accent-[#006ce4] rounded"></label>
           <label class="flex items-center justify-between cursor-pointer p-2 rounded-xl hover:bg-slate-50 transition"><span class="text-xs font-bold text-slate-700">🏋️ Fitness / Gym</span><input type="checkbox" name="sticky_amenity" value="gym" class="w-4 h-4 accent-[#006ce4] rounded"></label>
           <label class="flex items-center justify-between cursor-pointer p-2 rounded-xl hover:bg-slate-50 transition"><span class="text-xs font-bold text-slate-700">✈️ Airport Shuttle</span><input type="checkbox" name="sticky_amenity" value="shuttle" class="w-4 h-4 accent-[#006ce4] rounded"></label>
        </div>
        <div class="pt-3 mt-2 border-t border-slate-100 flex items-center justify-between">
          <button type="button" class="clear-section-btn text-xs font-bold text-slate-400 hover:text-slate-700" data-group="sticky_amenity">Clear</button>
          <button type="button" class="apply-action-btn bg-[#006ce4] hover:bg-[#0057b8] text-white text-xs font-bold px-4 py-1.5 rounded-lg shadow-xs transition">Apply</button>
        </div>
      </div>

      <!-- Property Type Popup -->
      <div id="propertyTypeBox" class="filter-popup hidden fixed md:absolute bottom-0 md:bottom-auto md:top-[10px] left-0 md:left-[510px] right-0 md:right-auto w-full md:w-[250px] bg-white border border-slate-200 rounded-t-[28px] md:rounded-[20px] shadow-2xl p-5 z-[2000] text-left">
        <div class="md:hidden w-10 h-1 bg-slate-300 rounded-full mx-auto mb-3"></div>
        <div class="flex items-center justify-between border-b border-slate-100 pb-2 mb-3">
          <h4 class="text-xs font-black uppercase text-slate-900 tracking-wider">Property Type</h4>
          <button type="button" class="close-popup-btn text-slate-400 hover:text-slate-900 text-lg font-bold p-1 cursor-pointer">&times;</button>
        </div>
        <div class="space-y-2.5">
           <label class="flex items-center justify-between cursor-pointer p-2 rounded-xl hover:bg-slate-50 transition"><span class="text-xs font-bold text-slate-700">All Accommodations</span><input type="radio" name="sticky_type" value="all" checked class="w-4 h-4 accent-[#006ce4]"></label>
           <label class="flex items-center justify-between cursor-pointer p-2 rounded-xl hover:bg-slate-50 transition"><span class="text-xs font-bold text-slate-700">Hotels Only</span><input type="radio" name="sticky_type" value="hotel" class="w-4 h-4 accent-[#006ce4]"></label>
           <label class="flex items-center justify-between cursor-pointer p-2 rounded-xl hover:bg-slate-50 transition"><span class="text-xs font-bold text-slate-700">Guest Houses Only</span><input type="radio" name="sticky_type" value="guesthouse" class="w-4 h-4 accent-[#006ce4]"></label>
        </div>
      </div>

      <!-- Sort By Popup -->
      <div id="sortBox" class="filter-popup hidden fixed md:absolute bottom-0 md:bottom-auto md:top-[10px] right-0 left-0 md:left-auto w-full md:w-[260px] bg-white border border-slate-200 rounded-t-[28px] md:rounded-[20px] shadow-2xl p-5 z-[2000] text-left">
        <div class="md:hidden w-10 h-1 bg-slate-300 rounded-full mx-auto mb-3"></div>
        <div class="flex items-center justify-between border-b border-slate-100 pb-2 mb-3">
          <h4 class="text-xs font-black uppercase text-slate-900 tracking-wider">Sort Results</h4>
          <button type="button" class="close-popup-btn text-slate-400 hover:text-slate-900 text-lg font-bold p-1 cursor-pointer">&times;</button>
        </div>
        <div class="space-y-2.5">
           <label class="flex items-center justify-between cursor-pointer p-2 rounded-xl hover:bg-slate-50 transition"><span class="text-xs font-bold text-slate-700">Recommended / Top picks</span><input type="radio" name="sticky_sort" value="featured" checked class="w-4 h-4 accent-[#006ce4]"></label>
           <label class="flex items-center justify-between cursor-pointer p-2 rounded-xl hover:bg-slate-50 transition"><span class="text-xs font-bold text-slate-700">Price: Low to High</span><input type="radio" name="sticky_sort" value="price-asc" class="w-4 h-4 accent-[#006ce4]"></label>
           <label class="flex items-center justify-between cursor-pointer p-2 rounded-xl hover:bg-slate-50 transition"><span class="text-xs font-bold text-slate-700">Price: High to Low</span><input type="radio" name="sticky_sort" value="price-desc" class="w-4 h-4 accent-[#006ce4]"></label>
           <label class="flex items-center justify-between cursor-pointer p-2 rounded-xl hover:bg-slate-50 transition"><span class="text-xs font-bold text-slate-700">Guest Rating: High to Low</span><input type="radio" name="sticky_sort" value="rating-desc" class="w-4 h-4 accent-[#006ce4]"></label>
        </div>
      </div>

    </div>
  </div>

  <!-- ৪. ওভারলে -->
  <div id="filterOverlay" class="fixed inset-0 bg-slate-950/60 backdrop-blur-xs z-[1900] hidden transition-opacity"></div>
</header>

<style>
  .no-scrollbar::-webkit-scrollbar { display: none; }
  .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
  
  @media (max-width: 767px) {
    .filter-popup {
      position: fixed !important;
      bottom: 0 !important;
      left: 0 !important;
      right: 0 !important;
      width: 100% !important;
      max-height: 82vh !important;
      overflow-y: auto !important;
      animation: modalSlideUp 0.25s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }
  }

  @keyframes modalSlideUp {
    from { transform: translateY(100%); }
    to { transform: translateY(0); }
  }
</style>

<!-- ================= CLIENT JAVASCRIPT ================= -->
<script is:inline>
  function setupStickyFilters() {
    const triggers = document.querySelectorAll('.pill-trigger');
    const popups = document.querySelectorAll('.filter-popup');
    const overlay = document.getElementById('filterOverlay');
    const dealsBtn = document.getElementById('quickDealsBtn');
    const searchInput = document.getElementById('stickySearchInput');
    const chipsList = document.getElementById('chipsList');
    const chipsContainer = document.getElementById('activeFiltersContainer');
    const clearAllBtn = document.getElementById('clearAllFiltersBtn');
    const sortPillLabel = document.getElementById('sortPillLabel');
    
    let dealsActive = false;

    // স্মার্ট সিনোনিম ডিকশনারি (যে বানানই থাকুক—১০০% ম্যাচ করবে)
    const amenitySynonyms = {
      wifi: ['wifi', 'wi-fi', 'wi fi', 'internet', 'wireless'],
      pool: ['pool', 'swimming'],
      breakfast: ['breakfast', 'dining', 'restaurant', 'meal', 'buffet'],
      gym: ['gym', 'fitness', 'workout', 'health club'],
      shuttle: ['shuttle', 'airport', 'transfer', 'pickup']
    };

    const closePopups = () => {
      popups.forEach(p => p.classList.add('hidden'));
      if (overlay) overlay.classList.add('hidden');
      document.body.style.overflow = '';
      document.documentElement.style.overflow = '';
      document.querySelectorAll('.arrow').forEach(a => a.classList.remove('rotate-180'));
    };

    // মাস্টার ফিল্টারিং ফাংশন
    const runFiltering = () => {
      const hotelCards = Array.from(document.querySelectorAll('.directory-card-item'));
      const container = document.getElementById('hotelCardsContainer');

      const searchQuery = (searchInput ? searchInput.value : '').trim().toLowerCase();
      const selectedPrice = document.querySelector('input[name="sticky_price"]:checked')?.value || "all";
      const selectedArea = document.querySelector('input[name="sticky_area"]:checked')?.value || "all";
      const selectedType = document.querySelector('input[name="sticky_type"]:checked')?.value || "all";
      const selectedStars = Array.from(document.querySelectorAll('input[name="sticky_stars"]:checked')).map(cb => cb.value);
      const selectedRatings = Array.from(document.querySelectorAll('input[name="sticky_rating"]:checked')).map(cb => parseFloat(cb.value));
      const selectedAmenities = Array.from(document.querySelectorAll('input[name="sticky_amenity"]:checked')).map(cb => cb.value.toLowerCase());
      const selectedSort = document.querySelector('input[name="sticky_sort"]:checked')?.value || "featured";

      let visibleCount = 0;

      hotelCards.forEach(card => {
        const title = (card.getAttribute('data-title') || '').toLowerCase();
        const area = card.getAttribute('data-area') || '';
        const stars = card.getAttribute('data-stars') || '0';
        const isGuest = card.getAttribute('data-guesthouse') === 'true';
        const price = parseFloat(card.getAttribute('data-numeric-price') || '0');
        const rating = parseFloat(card.getAttribute('data-numeric-rating') || '0');
        const rawAmenities = (card.getAttribute('data-amenities') || '').toLowerCase();
        const hasDiscount = card.querySelector('.line-through') || card.querySelector('span[class*="rose"]') || card.querySelector('span[class*="red"]');

        // ১. সার্চ
        const matchesSearch = !searchQuery || title.includes(searchQuery);

        // ২. এরিয়া
        const matchesArea = (selectedArea === "all" || area === selectedArea);

        // ৩. বাজেট
        let matchesPrice = true;
        if (selectedPrice === "low") matchesPrice = price < 6000;
        else if (selectedPrice === "mid") matchesPrice = (price >= 6000 && price <= 15000);
        else if (selectedPrice === "high") matchesPrice = price > 15000;

        // ৪. স্টার
        const matchesStars = (selectedStars.length === 0 || selectedStars.includes(stars));

        // ৫. গেস্ট রেটিং
        let matchesRating = true;
        if (selectedRatings.length > 0) matchesRating = selectedRatings.some(r => rating >= r);

        // ৬. প্রপার্টি টাইপ
        let matchesType = true;
        if (selectedType === "hotel") matchesType = !isGuest;
        else if (selectedType === "guesthouse") matchesType = isGuest;

        // ৭. স্মার্ট অ্যামেনিটিস ফিল্টার (Synonym Matching)
        let matchesAmenities = true;
        if (selectedAmenities.length > 0) {
          matchesAmenities = selectedAmenities.every(selKey => {
            const keywords = amenitySynonyms[selKey] || [selKey];
            return keywords.some(kw => rawAmenities.includes(kw));
          });
        }

        // ৮. ডিলস
        let matchesDeals = dealsActive ? !!hasDiscount : true;

        const isVisible = matchesSearch && matchesArea && matchesPrice && matchesStars && matchesRating && matchesType && matchesAmenities && matchesDeals;
        
        card.style.display = isVisible ? 'flex' : 'none';
        if (isVisible) visibleCount++;
      });

      // সর্টিং
      if (container && selectedSort !== 'featured') {
        const sorted = hotelCards.filter(c => c.style.display !== 'none').sort((a, b) => {
          const pA = parseFloat(a.getAttribute('data-numeric-price') || '0');
          const pB = parseFloat(b.getAttribute('data-numeric-price') || '0');
          const rA = parseFloat(a.getAttribute('data-numeric-rating') || '0');
          const rB = parseFloat(b.getAttribute('data-numeric-rating') || '0');

          if (selectedSort === 'price-asc') return pA - pB;
          if (selectedSort === 'price-desc') return pB - pA;
          if (selectedSort === 'rating-desc') return rB - rA;
          return 0;
        });
        sorted.forEach(c => container.appendChild(c));
      }

      // কাউন্টার
      const countEl = document.getElementById('propertiesFoundCount');
      if (countEl) countEl.innerHTML = `Gulshan: <strong class="text-slate-900 font-black">${visibleCount} properties found</strong>`;

      updateBadgesAndChips();
    };

    // ব্যাজ ও চিপস আপডেট
    const updateBadgesAndChips = () => {
      if (!chipsList) return;
      chipsList.innerHTML = '';
      let activeFilterCount = 0;

      triggers.forEach(btn => {
        const targetId = btn.dataset.target;
        const target = document.getElementById(targetId);
        if (!target) return;

        let pillCount = 0;
        target.querySelectorAll('input').forEach(input => {
          if ((input.type === 'radio' && input.checked && input.value !== 'all' && input.value !== 'featured') || 
              (input.type === 'checkbox' && input.checked)) {
            pillCount++;
            activeFilterCount++;

            const labelText = input.closest('label')?.innerText?.trim() || input.value;
            const chip = document.createElement('div');
            chip.className = "bg-blue-50 text-[#006ce4] border border-blue-200/80 px-2 py-0.5 rounded-lg text-[11px] font-bold flex items-center gap-1.5 shadow-2xs";
            chip.innerHTML = `<span>${labelText}</span><button type="button" class="text-xs font-black hover:text-red-500 cursor-pointer">&times;</button>`;
            
            chip.querySelector('button').onclick = () => {
              if (input.type === 'radio') {
                const defaultRadio = target.querySelector('input[value="all"], input[value="featured"]');
                if (defaultRadio) defaultRadio.checked = true;
              } else {
                input.checked = false;
              }
              runFiltering();
            };
            chipsList.appendChild(chip);
          }
        });

        const badge = btn.querySelector('.pill-badge');
        if (badge) {
          if (pillCount > 0) {
            badge.textContent = pillCount;
            badge.classList.remove('hidden');
            badge.classList.add('flex');
            btn.classList.add('border-[#006ce4]', 'bg-blue-50/50', 'text-[#006ce4]');
          } else {
            badge.classList.add('hidden');
            badge.classList.remove('flex');
            btn.classList.remove('border-[#006ce4]', 'bg-blue-50/50', 'text-[#006ce4]');
          }
        }
      });

      // সর্ট লেবেল
      const activeSortRadio = document.querySelector('input[name="sticky_sort"]:checked');
      if (sortPillLabel && activeSortRadio) {
        if (activeSortRadio.value === 'price-asc') sortPillLabel.textContent = "Price ↑";
        else if (activeSortRadio.value === 'price-desc') sortPillLabel.textContent = "Price ↓";
        else if (activeSortRadio.value === 'rating-desc') sortPillLabel.textContent = "Rating";
        else sortPillLabel.textContent = "Sort";
      }

      // ডিল চিপ
      if (dealsActive) {
        activeFilterCount++;
        const chip = document.createElement('div');
        chip.className = "bg-rose-50 text-rose-600 border border-rose-200 px-2 py-0.5 rounded-lg text-[11px] font-bold flex items-center gap-1.5 shadow-2xs";
        chip.innerHTML = `<span>🔥 Deals Active</span><button type="button" class="text-xs font-black hover:text-rose-800 cursor-pointer">&times;</button>`;
        chip.querySelector('button').onclick = () => dealsBtn.click();
        chipsList.appendChild(chip);
      }

      if (chipsContainer) chipsContainer.classList.toggle('hidden', activeFilterCount === 0);
    };

    // রেডিও সিলেক্ট করলে ১৮০ms পর অটোমেটিক ক্লোজ
    document.querySelectorAll('.filter-popup input[type="radio"]').forEach(radio => {
      radio.onchange = () => {
        runFiltering();
        setTimeout(closePopups, 180);
      };
    });

    // চেকবাক্স ফিল্টার
    document.querySelectorAll('.filter-popup input[type="checkbox"]').forEach(check => {
      check.onchange = () => {
        runFiltering();
      };
    });

    // Apply ও Clear বাটন
    document.querySelectorAll('.apply-action-btn').forEach(btn => {
      btn.onclick = closePopups;
    });

    document.querySelectorAll('.clear-section-btn').forEach(btn => {
      btn.onclick = () => {
        const groupName = btn.dataset.group;
        if (groupName) {
          document.querySelectorAll(`input[name="${groupName}"]`).forEach(cb => cb.checked = false);
          runFiltering();
        }
      };
    });

    if (searchInput) {
      searchInput.oninput = () => runFiltering();
    }

    // পিল টগল
    triggers.forEach(btn => {
      btn.onclick = (e) => {
        e.stopPropagation();
        const target = document.getElementById(btn.dataset.target);
        if (!target) return;

        const isHidden = target.classList.contains('hidden');
        closePopups();

        if (isHidden) {
          target.classList.remove('hidden');
          if (overlay) overlay.classList.remove('hidden');
          if (window.innerWidth < 768) {
            document.body.style.overflow = 'hidden';
            document.documentElement.style.overflow = 'hidden';
          }
          btn.querySelector('.arrow')?.classList.add('rotate-180');
        }
      };
    });

    document.querySelectorAll('.close-popup-btn').forEach(btn => {
      btn.onclick = (e) => {
        e.stopPropagation();
        closePopups();
      };
    });

    if (overlay) overlay.onclick = closePopups;

    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closePopups();
    });

    if (dealsBtn) {
      dealsBtn.onclick = () => {
        dealsActive = !dealsActive;
        dealsBtn.classList.toggle('bg-rose-600', dealsActive);
        dealsBtn.classList.toggle('text-white', dealsActive);
        dealsBtn.classList.toggle('border-rose-600', dealsActive);
        runFiltering();
      };
    }

    if (clearAllBtn) {
      clearAllBtn.onclick = () => {
        if (searchInput) searchInput.value = '';
        document.querySelectorAll('.filter-popup input[type="radio"][value="all"], .filter-popup input[type="radio"][value="featured"]').forEach(i => i.checked = true);
        document.querySelectorAll('.filter-popup input[type="checkbox"]').forEach(i => i.checked = false);
        if (dealsActive) dealsBtn.click();
        else runFiltering();
      };
    }
  }

  setupStickyFilters();
  document.addEventListener('astro:page-load', setupStickyFilters);
</script>
