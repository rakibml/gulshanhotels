---
// src/components/directory/StickyBar.astro
---

<header class="sticky top-0 z-40 bg-white/90 backdrop-blur-md border-b border-slate-200 shadow-sm transition-all duration-300">
  <div class="max-w-[1280px] mx-auto px-4 py-2">
    
    <!-- Search Bar Row -->
    <div class="flex items-center gap-3 mb-2">
      <div class="relative flex-1 group">
        <div class="absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 group-focus-within:text-[#006ce4] transition-colors">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
          </svg>
        </div>
        <input 
          type="text" 
          id="hotelSearchInput" 
          placeholder="Search hotels in Gulshan..." 
          class="w-full bg-slate-100 focus:bg-white text-xs sm:text-sm font-bold rounded-full pl-10 pr-4 py-2.5 border-transparent focus:border-[#006ce4] focus:ring-4 focus:ring-blue-50 focus:outline-none transition-all"
        />
      </div>
    </div>

    <!-- Pill Filters Row (Horizontal Scroll on Mobile) -->
    <div class="flex items-center gap-2 overflow-x-auto no-scrollbar pb-1">
      
      {/* কমন ক্লাসের জন্য একটি ভেরিয়েবল (বিল্ড সেফ) */}
      {
        (() => {
          const pillClass = "sticky-pill shrink-0 flex items-center gap-1.5 px-4 py-2 rounded-full border border-slate-200 bg-white text-[13px] font-bold text-slate-700 transition-all active:scale-95 hover:border-slate-300 hover:shadow-sm cursor-pointer whitespace-nowrap";
          
          return (
            <>
              <!-- Price -->
              <button type="button" class={pillClass} data-action="filter-modal">
                <svg class="w-3.5 h-3.5 text-emerald-600" fill="currentColor" viewBox="0 0 24 24"><path d="M12.5 3H7.8a2 2 0 0 0-1.4.6l-3.8 3.8a2 2 0 0 0 0 2.8l8.2 8.2a2 2 0 0 0 2.8 0l3.8-3.8c.4-.4.6-.9.6-1.4V8.5a5.5 5.5 0 0 0-5.5-5.5zm1.5 5.5a1.5 1.5 0 1 1 3 0 1.5 1.5 0 0 1-3 0z"/></svg>
                <span>Price</span>
                <svg class="w-3 h-3 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M19 9l-7 7-7-7" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </button>

              <!-- Rating -->
              <button type="button" class={pillClass} data-action="filter-modal">
                <svg class="w-3.5 h-3.5 text-amber-500" fill="currentColor" viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
                <span>Rating</span>
                <svg class="w-3 h-3 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M19 9l-7 7-7-7" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </button>

              <!-- Area -->
              <button type="button" class={pillClass} id="stickyAreaBtn">
                <svg class="w-3.5 h-3.5 text-blue-600" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2C8.1 2 5 5.1 5 9c0 5.2 7 13 7 13s7-7.8 7-13c0-3.9-3.1-7-7-7zm0 9.5c-1.4 0-2.5-1.1-2.5-2.5s1.1-2.5 2.5-2.5 2.5 1.1 2.5 2.5-1.1 2.5-2.5 2.5z"/></svg>
                <span>Area</span>
                <svg class="w-3 h-3 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M19 9l-7 7-7-7" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </button>

              <!-- Sort -->
              <button type="button" class={pillClass} id="stickySortBtn">
                <svg class="w-3.5 h-3.5 text-slate-700" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5"><path d="M7 16V4m0 0L3 8m4-4l4 4m6-4v12m0 0l4-4m-4 4l-4-4"/></svg>
                <span>Sort</span>
              </button>

              <!-- Deals -->
              <button type="button" id="stickyDealsBtn" class={`${pillClass} border-red-100 hover:bg-red-50 text-red-600`}>
                <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M21.41 11.58l-9-9C12.05 2.22 11.55 2 11 2H4c-1.1 0-2 .9-2 2v7c0 .55.22 1.05.59 1.42l9 9c.36.36.86.58 1.41.58.55 0 1.05-.22 1.41-.59l7-7c.37-.36.59-.86.59-1.41 0-.55-.23-1.06-.59-1.42zM5.5 7C4.67 7 4 6.33 4 5.5S4.67 4 5.5 4 7 4.67 7 5.5 6.33 7 5.5 7z"/></svg>
                <span>Deals</span>
              </button>
            </>
          );
        })()
      }

    </div>
  </div>
</header>

<style>
  .no-scrollbar::-webkit-scrollbar { display: none; }
  .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
  header { font-family: 'Plus Jakarta Sans', sans-serif; }
</style>

<script is:inline>
  function initStickyBar() {
    const searchInput = document.getElementById('hotelSearchInput');
    const hotelCards = document.querySelectorAll('.directory-card-item');
    const dealsBtn = document.getElementById('stickyDealsBtn');

    // ১. সার্চ লজিক
    searchInput?.addEventListener('input', (e) => {
      const term = e.target.value.toLowerCase().trim();
      hotelCards.forEach(card => {
        const title = card.getAttribute('data-title') || "";
        card.style.display = title.includes(term) ? 'block' : 'none';
      });
    });

    // ২. ড্রয়ার খোলা
    document.querySelectorAll('[data-action="filter-modal"], #stickyAreaBtn, #stickySortBtn').forEach(btn => {
      btn.addEventListener('click', () => {
        if (typeof window.openFilterDrawer === 'function') {
          window.openFilterDrawer();
        }
      });
    });

    // ৩. ডিলস ফিল্টার
    let dealsActive = false;
    dealsBtn?.addEventListener('click', () => {
      dealsActive = !dealsActive;
      dealsBtn.classList.toggle('bg-red-600', dealsActive);
      dealsBtn.classList.toggle('text-white', dealsActive);
      dealsBtn.classList.toggle('text-red-600', !dealsActive);

      hotelCards.forEach(card => {
        const hasDiscount = card.querySelector('.bg-red-600');
        if (dealsActive) {
          card.style.display = hasDiscount ? 'block' : 'none';
        } else {
          card.style.display = 'block';
        }
      });
    });
  }

  // Astro page lifecycle
  document.addEventListener('astro:page-load', initStickyBar);
  initStickyBar();
</script>
