---
// src/components/directory/TopPillsBar.astro
interface Props {
  totalCount: number;
  hotelCount: number;
  guestHouseCount: number;
  nearCount: number;
}

const { totalCount, hotelCount, guestHouseCount, nearCount } = Astro.props;
---

<div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-2.5 bg-white p-2.5 sm:p-3 rounded-2xl border border-slate-200/80 shadow-2xs">
  
  <!-- Quick Filter Pill Tabs -->
  <div class="flex flex-wrap items-center gap-1.5 text-xs font-bold">
    <button type="button" class="top-pill-btn bg-[#003b95] text-white px-3 py-1.5 rounded-lg transition flex items-center gap-1.5 cursor-pointer active-pill" data-type="all">
      <span>All Stays</span>
      <span class="bg-white/20 text-white text-[10px] px-1.5 py-0.2 rounded">{totalCount}</span>
    </button>
    <button type="button" class="top-pill-btn bg-slate-100 text-slate-700 hover:bg-slate-200 px-3 py-1.5 rounded-lg transition flex items-center gap-1.5 cursor-pointer" data-type="hotel">
      <span>Hotels</span>
      <span class="bg-slate-200 text-slate-600 text-[10px] px-1.5 py-0.2 rounded">{hotelCount}</span>
    </button>
    <button type="button" class="top-pill-btn bg-slate-100 text-slate-700 hover:bg-slate-200 px-3 py-1.5 rounded-lg transition flex items-center gap-1.5 cursor-pointer" data-type="guesthouse">
      <span>Guest Houses</span>
      <span class="bg-slate-200 text-slate-600 text-[10px] px-1.5 py-0.2 rounded">{guestHouseCount}</span>
    </button>
    <button type="button" class="top-pill-btn bg-slate-100 text-slate-700 hover:bg-slate-200 px-3 py-1.5 rounded-lg transition flex items-center gap-1.5 cursor-pointer" data-type="near">
      <span>Near Gulshan</span>
      <span class="bg-slate-200 text-slate-600 text-[10px] px-1.5 py-0.2 rounded">{nearCount}</span>
    </button>
  </div>

  <!-- Properties Found Text -->
  <span id="propertiesFoundCount" class="text-xs font-bold text-slate-600 shrink-0">
    Gulshan: <strong class="text-slate-900 font-black">{totalCount} properties found</strong>
  </span>

</div>
