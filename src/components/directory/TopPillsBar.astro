---
// src/components/directory/TopPillsBar.astro
interface Props {
  totalCount: number;
  hotelCount: number;
  guestHouseCount: number;
  nearCount: number;
}

const { totalCount, hotelCount, guestHouseCount, nearCount } = Astro.props;
---

<div class="flex flex-col lg:flex-row items-start lg:items-center justify-between gap-4 bg-white p-3 sm:p-4 rounded-2xl border border-slate-200 shadow-sm">
  
  <!-- Quick Filter Pill Tabs (Horizontal scroll on mobile) -->
  <div class="flex items-center gap-2 overflow-x-auto pb-2 lg:pb-0 no-scrollbar w-full lg:w-auto">
    <div class="flex items-center gap-2 flex-nowrap">
      
      <!-- All Stays -->
      <button 
        type="button" 
        class="top-pill-btn group flex items-center gap-2 px-4 py-2 rounded-xl text-xs font-bold transition-all duration-200 cursor-pointer whitespace-nowrap bg-[#003b95] text-white shadow-md shadow-blue-100 active:scale-95" 
        data-type="all"
      >
        <span>All Stays</span>
        <span class="bg-white/20 text-white text-[10px] px-2 py-0.5 rounded-full min-w-[20px] text-center">
          {totalCount}
        </span>
      </button>

      <!-- Hotels -->
      <button 
        type="button" 
        class="top-pill-btn group flex items-center gap-2 px-4 py-2 rounded-xl text-xs font-bold transition-all duration-200 cursor-pointer whitespace-nowrap bg-slate-100 text-slate-600 hover:bg-slate-200 hover:text-slate-900 active:scale-95" 
        data-type="hotel"
      >
        <span>Hotels</span>
        <span class="bg-slate-200 text-slate-500 group-hover:bg-slate-300 group-hover:text-slate-700 text-[10px] px-2 py-0.5 rounded-full min-w-[20px] text-center transition-colors">
          {hotelCount}
        </span>
      </button>

      <!-- Guest Houses -->
      <button 
        type="button" 
        class="top-pill-btn group flex items-center gap-2 px-4 py-2 rounded-xl text-xs font-bold transition-all duration-200 cursor-pointer whitespace-nowrap bg-slate-100 text-slate-600 hover:bg-slate-200 hover:text-slate-900 active:scale-95" 
        data-type="guesthouse"
      >
        <span>Guest Houses</span>
        <span class="bg-slate-200 text-slate-500 group-hover:bg-slate-300 group-hover:text-slate-700 text-[10px] px-2 py-0.5 rounded-full min-w-[20px] text-center transition-colors">
          {guestHouseCount}
        </span>
      </button>

      <!-- Near Gulshan -->
      <button 
        type="button" 
        class="top-pill-btn group flex items-center gap-2 px-4 py-2 rounded-xl text-xs font-bold transition-all duration-200 cursor-pointer whitespace-nowrap bg-slate-100 text-slate-600 hover:bg-slate-200 hover:text-slate-900 active:scale-95" 
        data-type="near"
      >
        <span>Near Gulshan</span>
        <span class="bg-slate-200 text-slate-500 group-hover:bg-slate-300 group-hover:text-slate-700 text-[10px] px-2 py-0.5 rounded-full min-w-[20px] text-center transition-colors">
          {nearCount}
        </span>
      </button>

    </div>
  </div>

  <!-- Properties Found Info -->
  <div class="hidden sm:flex items-center gap-2 shrink-0 bg-blue-50/50 px-3 py-1.5 rounded-lg border border-blue-100/50">
    <svg class="w-4 h-4 text-[#003b95]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
    </svg>
    <span id="propertiesFoundCount" class="text-xs font-medium text-slate-600">
      Gulshan: <strong class="text-slate-900 font-bold">{totalCount} properties found</strong>
    </span>
  </div>

</div>

<style>
  /* পিল বাটনগুলোর নিচের স্ক্রলবার লুকানোর জন্য */
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .no-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>

<script>
  const pillButtons = document.querySelectorAll('.top-pill-btn');

  pillButtons.forEach(button => {
    button.addEventListener('click', () => {
      // সবার আগে সব বাটনকে ইন-একটিভ (Default) করুন
      pillButtons.forEach(btn => {
        btn.classList.remove('bg-[#003b95]', 'text-white', 'shadow-md', 'shadow-blue-100');
        btn.classList.add('bg-slate-100', 'text-slate-600');
        
        // ব্যাজ কালার রিসেট
        const badge = btn.querySelector('span:last-child');
        badge?.classList.remove('bg-white/20', 'text-white');
        badge?.classList.add('bg-slate-200', 'text-slate-500');
      });

      // ক্লিক করা বাটনকে একটিভ করুন
      button.classList.add('bg-[#003b95]', 'text-white', 'shadow-md', 'shadow-blue-100');
      button.classList.remove('bg-slate-100', 'text-slate-600');

      // ক্লিক করা বাটনের ব্যাজ কালার পরিবর্তন
      const activeBadge = button.querySelector('span:last-child');
      activeBadge?.classList.add('bg-white/20', 'text-white');
      activeBadge?.classList.remove('bg-slate-200', 'text-slate-500');

      // ফিল্টারিং লজিক এখানে লিখুন
      const filterType = button.getAttribute('data-type');
      console.log('Filtering by:', filterType);
    });
  });
</script>
