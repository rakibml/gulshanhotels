---
// src/components/Hero.astro (LateRooms Purple & Gold Theme with Clear Video)
---

<!-- CINEMATIC HERO SECTION (LateRooms Signature Deep Purple Base) -->
<section class="relative bg-[#410987] min-h-[460px] sm:min-h-[520px] lg:min-h-[560px] flex flex-col justify-between text-left overflow-visible">
  
  <!-- ================= 1. VIDEO BACKGROUND WITH LATEROOMS PURPLE TINT ================= -->
  <div class="absolute inset-0 w-full h-full overflow-hidden pointer-events-none">
    <video 
      id="heroBgVideo"
      autoplay 
      loop 
      muted 
      playsinline 
      preload="auto"
      poster="/hero-gulshan.jpg.webp"
      class="w-full h-full object-cover object-center scale-105 opacity-90 transition-opacity duration-700"
    >
      <source src="/hero-video.mp4.mp4" type="video/mp4" />
      <source src="https://commondatastorage.googleapis.com/gtv-videos-bucket/sample/ForBiggerBlazes.mp4" type="video/mp4" />
    </video>

    <!-- LateRooms Signature Rich Purple Gradient Overlay (ভিডিও পরিষ্কার রাখবে কিন্তু ব্র্যান্ড কালার ফুটিয়ে তুলবে) -->
    <div class="absolute inset-0 bg-gradient-to-b from-[#2A0060]/70 via-[#410987]/30 to-[#410987]/90 pointer-events-none"></div>

    <!-- LateRooms Style Subtle Clock Watermark (সময় ও লাস্ট-মিনিট ডিলের প্রতীক) -->
    <div class="absolute top-8 right-8 lg:right-24 w-64 h-64 lg:w-96 lg:h-96 opacity-10 pointer-events-none stroke-white">
      <svg viewBox="0 0 100 100" fill="none" class="w-full h-full animate-[spin_120s_linear_infinite]">
        <circle cx="50" cy="50" r="46" stroke="currentColor" stroke-width="2" stroke-dasharray="4 4" />
        <line x1="50" y1="50" x2="50" y2="20" stroke="currentColor" stroke-width="3" stroke-linecap="round" />
        <line x1="50" y1="50" x2="72" y2="50" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" />
        <circle cx="50" cy="50" r="3" fill="currentColor" />
      </svg>
    </div>
  </div>

  <!-- ================= 2. HEADLINE & TAGLINE (LATEROOMS TYPOGRAPHY STYLE) ================= -->
  <div class="relative z-10 max-w-[1240px] mx-auto w-full px-4 sm:px-6 lg:px-8 pt-20 sm:pt-28 pb-12 text-center my-auto">
    <!-- Top Pill Badge (LateRooms App / Deal Tag Style) -->
    <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-[#2A0060]/80 border border-[#794e65] text-[#fdd55f] text-xs font-bold uppercase tracking-wider mb-3 backdrop-blur-sm">
      <span>⏰ Book Late, Save Great</span>
    </div>

    <h1 
      class="font-sans text-3xl sm:text-5xl md:text-6xl font-black text-white tracking-tight leading-[1.15] max-w-4xl mx-auto"
      style="text-shadow: 0 4px 20px rgba(42, 0, 96, 0.8);"
    >
      Hotels in Gulshan, <span class="text-[#fdd55f]">Dhaka</span>
    </h1>

    <p class="text-[#d8c8f8] text-xs sm:text-sm font-semibold tracking-widest uppercase mt-3">
      The best last-minute hotel deals in Gulshan
    </p>
  </div>

  <!-- ================= 3. SEARCH CONSOLE (LATEROOMS WHITE BOX + YELLOW CTA) ================= -->
  <div class="relative z-30 max-w-4xl mx-auto w-full px-3 sm:px-6 lg:px-8 translate-y-1/2">
    <div class="bg-white rounded-2xl shadow-2xl p-2.5 sm:p-3 md:p-3.5 border border-slate-200 text-left">
      <form action="/hotels" method="GET" class="grid grid-cols-2 lg:grid-cols-12 gap-2 items-center">
        
        <!-- Module A: Location (LateRooms Style #F5F4F3 Container) -->
        <div class="col-span-1 lg:col-span-4 p-2 sm:px-3 bg-[#F5F4F3] rounded-xl border border-slate-200 hover:border-[#410987] transition">
          <label class="text-[9px] font-black uppercase text-[#410987] tracking-wider block leading-none mb-1">
            Location
          </label>
          <div class="flex items-center gap-2">
            <!-- Purple Icon -->
            <svg class="w-3.5 h-3.5 text-[#410987] shrink-0" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
            </svg>
            <select name="area" class="w-full text-xs font-bold text-[#410987] bg-transparent outline-none cursor-pointer truncate">
              <option value="all">All Gulshan</option>
              <option value="gulshan-1">Gulshan 1</option>
              <option value="gulshan-2">Gulshan 2</option>
              <option value="near">Near Gulshan</option>
            </select>
          </div>
        </div>

        <!-- Module B: Category -->
        <div class="col-span-1 lg:col-span-4 p-2 sm:px-3 bg-[#F5F4F3] rounded-xl border border-slate-200 hover:border-[#410987] transition">
          <label class="text-[9px] font-black uppercase text-[#410987] tracking-wider block leading-none mb-1">
            Category
          </label>
          <div class="flex items-center gap-2">
            <!-- Purple Icon -->
            <svg class="w-3.5 h-3.5 text-[#410987] shrink-0" viewBox="0 0 24 24" fill="currentColor">
              <path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-7 3c1.66 0 3 1.34 3 3s-1.34 3-3 3-3-1.34-3-3 1.34-3 3-3zm3 10H9v-1c0-1 2-1.9 3-1.9s3 .9 3 1.9v1z"/>
            </svg>
            <select name="type" class="w-full text-xs font-bold text-[#410987] bg-transparent outline-none cursor-pointer truncate">
              <option value="all">All Properties</option>
              <option value="hotel">5-Star Hotels</option>
              <option value="guesthouse">Guest Houses</option>
            </select>
          </div>
        </div>

        <!-- Module C: LateRooms Signature Yellow CTA Button -->
        <div class="col-span-2 lg:col-span-4 flex items-center">
          <button 
            type="submit" 
            class="w-full bg-[#fdd55f] hover:bg-[#5B23A1] text-[#410987] hover:text-white font-extrabold text-xs sm:text-sm py-3 sm:py-3.5 px-4 rounded-xl shadow-md transition-all duration-200 flex items-center justify-center gap-2 cursor-pointer active:scale-95 tracking-wide"
          >
            <span>Search Properties</span>
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
              <path d="M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z"/>
            </svg>
          </button>
        </div>

      </form>
    </div>
  </div>

</section>

<!-- ================= 4. AUTOPLAY SCRIPT ================= -->
<script is:inline>
  const playHeroVideo = () => {
    const video = document.getElementById('heroBgVideo');
    if (video) {
      video.muted = true;
      const playPromise = video.play();
      if (playPromise !== undefined) {
        playPromise.catch(() => {
          const triggerPlay = () => {
            video.play();
            window.removeEventListener('scroll', triggerPlay);
            window.removeEventListener('touchstart', triggerPlay);
          };
          window.addEventListener('scroll', triggerPlay, { passive: true });
          window.addEventListener('touchstart', triggerPlay, { passive: true });
        });
      }
    }
  };

  document.addEventListener('DOMContentLoaded', playHeroVideo);
  document.addEventListener('astro:page-load', playHeroVideo);
</script>
