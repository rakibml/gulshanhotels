---
// src/components/Hero.astro (Mobile-first rewrite: clean dark overlay on mobile, original luxury layout preserved on desktop)
---

<section class="relative bg-slate-950 overflow-visible">

  <!-- ================= HERO BLOCK ================= -->
  <div class="relative min-h-[60dvh] sm:min-h-[70dvh] lg:min-h-screen flex flex-col justify-center lg:justify-between text-left overflow-hidden">

    <!-- ================= 1. BACKGROUND VIDEO ================= -->
    <div class="absolute inset-0 w-full h-full overflow-hidden pointer-events-none">
      <video
        id="heroBgVideo"
        autoplay
        loop
        muted
        playsinline
        preload="auto"
        poster="/hero-gulshan.jpg.webp"
        class="w-full h-full object-cover object-center scale-105 opacity-100"
      >
        <source src="/hero-video.mp4.mp4" type="video/mp4" />
        <source src="https://commondatastorage.googleapis.com/gtv-videos-bucket/sample/ForBiggerBlazes.mp4" type="video/mp4" />
      </video>

      <!--
        MOBILE (default -> sm): flat dark bottom-to-top overlay across the WHOLE video.
        This guarantees text contrast no matter what's happening in the video frame,
        instead of relying on a side-gradient that only covers part of a narrow screen.
      -->
      <div class="absolute inset-0 bg-gradient-to-t from-slate-950/90 via-slate-950/55 to-slate-950/20 md:hidden"></div>

      <!--
        DESKTOP (md and up): your original left-side white shade, unchanged.
      -->
      <div class="hidden md:block absolute inset-y-0 left-0 w-3/5 lg:w-1/2 bg-gradient-to-r from-white via-white/90 to-transparent pointer-events-none z-[5]"></div>

      <!-- soft bottom shade, all breakpoints -->
      <div class="absolute inset-x-0 bottom-0 h-20 bg-gradient-to-t from-slate-950/50 to-transparent pointer-events-none"></div>
    </div>

    <!-- ================= 2. CONTENT ================= -->
    <div class="relative z-10 max-w-[1550px] mx-auto w-full px-5 sm:px-8 lg:px-12 pt-16 sm:pt-24 pb-10 md:pb-8 md:my-auto">
      <div class="max-w-xl text-left space-y-4 sm:space-y-5">

        <!-- Top Red Eyebrow Badge -->
        <div class="inline-flex items-center gap-1.5 text-[#ff5257] md:text-[#e52429] font-black text-xs sm:text-sm tracking-wider uppercase">
          <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4 fill-current shrink-0" viewBox="0 0 24 24">
            <path d="M20 6h-4V4c0-1.11-.89-2-2-2h-4c-1.11 0-2 .89-2 2v2H4c-1.11 0-1.99.89-1.99 2L2 19c0 1.11.89 2 2 2h16c1.11 0 2-.89 2-2V8c0-1.11-.89-2-2-2zm-6 0h-4V4h4v2z"/>
          </svg>
          <span>Explore Without Limits</span>
        </div>

        <!-- Main Headline: white on mobile (sits on dark overlay), dark on desktop (sits on white shade) -->
        <h1
          class="font-serif text-3xl sm:text-4xl lg:text-6xl font-black tracking-tight leading-[1.15] text-white md:text-slate-950"
        >
          Hotels in Gulshan, Dhaka
        </h1>

        <!-- Subtitle -->
        <p class="text-sm sm:text-base leading-relaxed max-w-lg text-slate-200 md:text-slate-800 font-medium">
          Experience world-class luxury suites, diplomatic security, and verified rates in Gulshan 1, Gulshan 2, and the Diplomatic Zone.
        </p>

        <!-- Red Action Button -->
        <div class="pt-1">
          <a
            href="/hotels"
            class="inline-flex items-center gap-2 bg-[#e52429] hover:bg-[#c91d22] text-white font-extrabold text-xs sm:text-sm px-6 py-3 sm:py-3.5 rounded-full shadow-lg active:scale-95 transition-all"
          >
            <span>Explore Hotels</span>
            <span class="text-sm">➔</span>
          </a>
        </div>

        <!-- Three Circular Photo Badges: hidden on mobile to reduce clutter, shown from sm up -->
        <div class="hidden sm:flex items-center gap-2.5 pt-1">
          <a href="/hotels" title="Lakefront Hotels" class="w-12 h-12 sm:w-14 sm:h-14 rounded-full overflow-hidden border-2 border-white ring-2 ring-slate-300/80 shadow-md hover:scale-110 transition-transform shrink-0">
            <img src="https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&w=150&q=80" alt="Gulshan Lakefront Stays" class="w-full h-full object-cover" />
          </a>
          <a href="/hotels?stars=5" title="5-Star Luxury Suites" class="w-12 h-12 sm:w-14 sm:h-14 rounded-full overflow-hidden border-2 border-white ring-2 ring-slate-300/80 shadow-md hover:scale-110 transition-transform shrink-0">
            <img src="https://images.unsplash.com/photo-1618773928121-c32242e63f39?auto=format&fit=crop&w=150&q=80" alt="Luxury Hotel Rooms" class="w-full h-full object-cover" />
          </a>
          <a href="/hotels?area=gulshan-2" title="Rooftop Pool & Spa" class="w-12 h-12 sm:w-14 sm:h-14 rounded-full overflow-hidden border-2 border-white ring-2 ring-slate-300/80 shadow-md hover:scale-110 transition-transform shrink-0">
            <img src="https://images.unsplash.com/photo-1582719478250-c89cae4dc85b?auto=format&fit=crop&w=150&q=80" alt="Rooftop Pool & Dining" class="w-full h-full object-cover" />
          </a>
        </div>

      </div>
    </div>
  </div>

  <!-- ================= 3. SEARCH CONSOLE =================
       MOBILE: sits in NORMAL flow right after the hero (own bg, no overlap, no translate).
       DESKTOP (lg+): switches to your original overlapping card via lg:absolute + translate. -->
  <div class="relative z-30 bg-slate-100 md:bg-transparent px-4 py-5 md:py-0
              lg:absolute lg:left-0 lg:right-0 lg:bottom-0 lg:translate-y-1/2 lg:px-0 lg:bg-transparent">
    <div class="max-w-4xl mx-auto w-full lg:px-6">
      <div class="bg-white rounded-2xl shadow-2xl p-2.5 sm:p-3 border border-slate-200/90 text-left">
        <form action="/hotels" method="GET" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-12 gap-2 items-center">

          <!-- Location Dropdown -->
          <div class="lg:col-span-4 p-2 px-3 bg-slate-50/90 rounded-xl border border-slate-200 hover:border-slate-300 transition">
            <label class="text-[9px] font-black uppercase text-slate-400 tracking-wider block leading-none mb-1 truncate">
              Location
            </label>
            <div class="flex items-center gap-2">
              <svg class="w-3.5 h-3.5 text-[#006ce4] shrink-0" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 2C8.13 2 5 5.13 5 9c0 5.2 7 13 7 13s7-7.8 7-13c0-3.9-3.1-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
              </svg>
              <select name="area" class="w-full text-xs font-bold text-slate-800 bg-transparent outline-none truncate">
                <option value="all">All Gulshan</option>
                <option value="gulshan-1">Gulshan 1</option>
                <option value="gulshan-2">Gulshan 2</option>
                <option value="near">Near Gulshan</option>
              </select>
            </div>
          </div>

          <!-- Category Dropdown -->
          <div class="lg:col-span-4 p-2 px-3 bg-slate-50/90 rounded-xl border border-slate-200 hover:border-slate-300 transition">
            <label class="text-[9px] font-black uppercase text-slate-400 tracking-wider block leading-none mb-1 truncate">
              Category
            </label>
            <div class="flex items-center gap-2">
              <svg class="w-3.5 h-3.5 text-emerald-700 shrink-0" viewBox="0 0 24 24" fill="currentColor">
                <path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-7 3c1.66 0 3 1.34 3 3s-1.34 3-3 3-3-1.34-3-3 1.34-3 3-3zm3 10H9v-1c0-1 2-1.9 3-1.9s3 .9 3 1.9v1z"/>
              </svg>
              <select name="type" class="w-full text-xs font-bold text-slate-800 bg-transparent outline-none truncate">
                <option value="all">All Properties</option>
                <option value="hotel">5-Star Hotels</option>
                <option value="guesthouse">Guest Houses</option>
              </select>
            </div>
          </div>

          <!-- Search Button -->
          <div class="lg:col-span-4 flex items-center">
            <button
              type="submit"
              class="w-full bg-[#003b95] hover:bg-[#002b6e] text-white font-black text-sm py-3 sm:py-3.5 px-4 rounded-xl shadow-md transition-all flex items-center justify-center gap-1.5 active:scale-98 tracking-wide"
            >
              <span>Search Properties</span>
              <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                <path d="M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z"/>
              </svg>
            </button>
          </div>

        </form>
      </div>
    </div>
  </div>

  <!-- spacer so desktop's absolutely-positioned overlapping search card doesn't collide with the next section -->
  <div class="hidden lg:block h-14"></div>

</section>

<!-- ================= 4. AUTOPLAY SCRIPT ================= -->
<script is:inline>
  const playHeroVideo = () => {
    const video = document.getElementById('heroBgVideo');
    if (video) {
      video.muted = true;
      const playPromise = video.play();
      if (playPromise !== undefined) {
        playPromise.catch(() => {
          const triggerPlay = () => {
            video.play();
            window.removeEventListener('scroll', triggerPlay);
            window.removeEventListener('touchstart', triggerPlay);
          };
          window.addEventListener('scroll', triggerPlay, { passive: true });
          window.addEventListener('touchstart', triggerPlay, { passive: true });
        });
      }
    }
  };

  document.addEventListener('DOMContentLoaded', playHeroVideo);
  document.addEventListener('astro:page-load', playHeroVideo);
</script>
