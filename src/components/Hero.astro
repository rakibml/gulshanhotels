---
// src/components/Hero.astro
---
<!-- HERO BANNER WITH WAVY CURVE -->
<section class="relative bg-slate-900 overflow-hidden min-h-[350px] sm:min-h-[480px] flex items-center justify-center">
  
  <!-- Background Image -->
  <div class="absolute inset-0 w-full h-full">
    <img 
      src="/hero-gulshan.jpg.webp" 
      onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1512917774080-9991f1c4c750?auto=format&fit=crop&w=2000&q=85';"
      alt="Gulshan Dhaka City Skyline" 
      class="w-full h-full object-cover object-center opacity-80" 
    />
    <div class="absolute inset-0 bg-gradient-to-t from-slate-950/90 via-slate-900/40 to-transparent"></div>
  </div>

  <!-- Overlay Text -->
  <div class="relative z-10 text-center px-4 sm:px-8 lg:px-12 max-w-[1550px] mx-auto w-full pt-10 pb-20 sm:pb-28 space-y-3">
    <span class="text-[11px] sm:text-xs font-black uppercase tracking-[0.25em] text-emerald-300 drop-shadow block">
      GULSHAN HOTELS GUIDE
    </span>
    <h1 class="font-serif text-3xl sm:text-6xl font-extrabold text-white tracking-tight drop-shadow-md leading-tight">
      Welcome to Gulshan, Dhaka
    </h1>
  </div>

  <!-- Seamless SVG Wave Divider -->
  <div class="absolute -bottom-1 left-0 right-0 w-full overflow-hidden leading-none z-20">
    <svg class="relative block w-full h-10 sm:h-20 text-white fill-current" viewBox="0 0 1200 120" preserveAspectRatio="none">
      <path d="M0,0 C150,90 350,-40 500,60 C650,160 900,10 1200,40 L1200,120 L0,120 Z"></path>
    </svg>
  </div>
</section>
