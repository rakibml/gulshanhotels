---
// src/components/Hero.astro (Ultra-Smooth 60FPS Video Hero with Integrated Search Bar)
---

<!-- Google Fonts: Bebas Neue & Montserrat -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Montserrat:wght@800;900&display=swap" rel="stylesheet">

<!-- HERO BANNER WRAPPER -->
<div class="relative w-full">

  <!-- ================= 1. HERO VIDEO SECTION ================= -->
  <section
    class="relative w-full overflow-hidden bg-slate-950 min-h-[50vh] sm:min-h-[500px] lg:min-h-[560px] flex items-center justify-center text-center"
    style="contain: layout paint style;"
  >

    <!-- GPU ACCELERATED SMOOTH VIDEO -->
    <div class="absolute inset-0 w-full h-full overflow-hidden pointer-events-none">
      <video
        id="heroBgVideo"
        autoplay
        loop
        muted
        playsinline
        preload="metadata"
        poster="/hero-gulshan.jpg.webp"
        disablepictureinpicture
        disableremoteplayback
        class="w-full h-full object-cover object-center opacity-100 [transform:translateZ(0)]"
      >
        <source src="/hero-video.mp4.mp4" type="video/mp4" />
      </video>
    </div>

    <!-- CRISP & LIGHTWEIGHT TYPOGRAPHY -->
    <div class="relative z-10 flex flex-col items-center justify-center select-none px-6 py-6 pb-14 sm:pb-16">

      <div class="flex flex-col items-center leading-none">

        <!-- লাইন ১: HOTELS -->
        <span
          class="font-['Bebas_Neue',sans-serif] text-6xl sm:text-8xl md:text-9xl lg:text-[130px] tracking-wider text-white"
          style="text-shadow: 0 3px 12px rgba(0,0,0,0.9);"
        >
          HOTELS
        </span>

        <!-- লাইন ২: [ ~ IN ~ ] GULSHAN -->
        <div class="flex items-center justify-center gap-2.5 sm:gap-5 -mt-2 sm:-mt-5">

          <!-- সোয়াশ সহ "IN" ব্যাজ -->
          <div class="flex flex-col items-center justify-center px-1">
            <svg
              class="w-10 sm:w-16 md:w-20 h-2.5 sm:h-3.5 text-white fill-none stroke-current stroke-[4] sm:stroke-[4.5] stroke-linecap-round"
              viewBox="0 0 60 10"
            >
              <path d="M 4 8 Q 28 1 56 6" />
            </svg>

            <span
              class="font-['Bebas_Neue',sans-serif] text-2xl sm:text-4xl md:text-5xl text-white italic tracking-widest leading-none -my-0.5 sm:-my-1"
              style="text-shadow: 0 2px 8px rgba(0,0,0,0.95);"
            >
              IN
            </span>

            <svg
              class="w-10 sm:w-16 md:w-20 h-2.5 sm:h-3.5 text-white fill-none stroke-current stroke-[4] sm:stroke-[4.5] stroke-linecap-round"
              viewBox="0 0 60 10"
            >
              <path d="M 4 3 Q 32 9 56 3" />
            </svg>
          </div>

          <!-- GULSHAN -->
          <span
            class="font-['Bebas_Neue',sans-serif] text-6xl sm:text-8xl md:text-9xl lg:text-[130px] tracking-wider text-white"
            style="text-shadow: 0 3px 12px rgba(0,0,0,0.9);"
          >
            GULSHAN
          </span>
        </div>

        <!-- লাইন ৩: DHAKA -->
        <div class="flex items-center gap-2 sm:gap-4 mt-3 sm:mt-5">
          <span class="h-[2px] w-6 sm:w-14 bg-white/90"></span>
          <span
            class="font-['Montserrat',sans-serif] text-xs sm:text-sm md:text-base font-black tracking-[0.4em] sm:tracking-[0.5em] text-white uppercase"
            style="text-shadow: 0 2px 8px rgba(0,0,0,0.95);"
          >
            DHAKA
          </span>
          <span class="h-[2px] w-6 sm:w-14 bg-white/90"></span>
        </div>

      </div>

    </div>

    <!-- MINIMAL PROFESSIONAL FRAME -->
    <div class="absolute inset-0 pointer-events-none z-20">
      <div class="absolute top-0 left-0 w-full h-16 sm:h-24 lg:h-28 bg-gradient-to-b from-black/45 to-transparent"></div>
      <div class="absolute bottom-0 left-0 w-full h-20 sm:h-28 lg:h-32 bg-gradient-to-t from-black/60 to-transparent"></div>

      <!-- চার কোণে হালকা ব্র্যাকেট ফ্রেম -->
      <div class="absolute top-4 left-4 sm:top-6 sm:left-6 lg:top-8 lg:left-8 w-8 sm:w-10 lg:w-12 h-8 sm:h-10 lg:h-12 border-t border-l border-white/55"></div>
      <div class="absolute top-4 right-4 sm:top-6 sm:right-6 lg:top-8 lg:right-8 w-8 sm:w-10 lg:w-12 h-8 sm:h-10 lg:h-12 border-t border-r border-white/55"></div>
      <div class="absolute bottom-4 left-4 sm:bottom-6 sm:left-6 lg:bottom-8 lg:left-8 w-8 sm:w-10 lg:w-12 h-8 sm:h-10 lg:h-12 border-b border-l border-white/55"></div>
      <div class="absolute bottom-4 right-4 sm:bottom-6 sm:right-6 lg:bottom-8 lg:right-8 w-8 sm:w-10 lg:w-12 h-8 sm:h-10 lg:h-12 border-b border-r border-white/55"></div>
    </div>

  </section>

  <!-- ================= 2. FLOATING HOTEL SEARCH & FILTER BAR ================= -->
  <div class="relative z-30 max-w-[1550px] mx-auto px-4 sm:px-8 lg:px-12 -mt-10 sm:-mt-12 mb-6">
    <div class="bg-white rounded-3xl p-4 sm:p-5 border border-slate-200/90 shadow-xl">
      
      <form id="heroHotelSearchForm" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-12 gap-3 items-center text-left">
        
        <!-- 1. LOCATION / AREA -->
        <div class="lg:col-span-4 p-3 rounded-2xl bg-slate-50 border border-slate-200/80 hover:border-slate-400 transition-colors">
          <label for="searchArea" class="block text-[10px] font-black uppercase tracking-wider text-slate-400">
            📍 Location / Area
          </label>
          <select 
            id="searchArea" 
            name="area" 
            class="w-full bg-transparent font-bold text-slate-900 text-xs sm:text-sm outline-none cursor-pointer pt-1"
          >
            <option value="all">All Gulshan & Diplomatic Zone</option>
            <option value="gulshan-2">Gulshan 2 (Diplomatic Zone)</option>
            <option value="gulshan-1">Gulshan 1 (Commercial Hub)</option>
            <option value="banani">Banani (Road 11 & Cafes)</option>
            <option value="baridhara">Baridhara Diplomatic Enclave</option>
          </select>
        </div>

        <!-- 2. PROPERTY TYPE -->
        <div class="lg:col-span-3 p-3 rounded-2xl bg-slate-50 border border-slate-200/80 hover:border-slate-400 transition-colors">
          <label for="searchType" class="block text-[10px] font-black uppercase tracking-wider text-slate-400">
            🏨 Property Type
          </label>
          <select 
            id="searchType" 
            name="type" 
            class="w-full bg-transparent font-bold text-slate-900 text-xs sm:text-sm outline-none cursor-pointer pt-1"
          >
            <option value="all">All Property Types</option>
            <option value="5-star">5-Star Luxury Hotels</option>
            <option value="boutique">Boutique Executive Stays</option>
            <option value="guest-house">Guest Houses & Studios</option>
            <option value="apartment">Serviced Apartments</option>
          </select>
        </div>

        <!-- 3. BUDGET -->
        <div class="lg:col-span-3 p-3 rounded-2xl bg-slate-50 border border-slate-200/80 hover:border-slate-400 transition-colors">
          <label for="searchBudget" class="block text-[10px] font-black uppercase tracking-wider text-slate-400">
            💰 Budget (Per Night)
          </label>
          <select 
            id="searchBudget" 
            name="budget" 
            class="w-full bg-transparent font-bold text-slate-900 text-xs sm:text-sm outline-none cursor-pointer pt-1"
          >
            <option value="any">Any Price</option>
            <option value="luxury">Luxury ($150+ / ৳18,000+)</option>
            <option value="mid">Mid-Range ($80 - $150)</option>
            <option value="budget">Budget Friendly (Under $80)</option>
          </select>
        </div>

        <!-- 4. FIND BUTTON -->
        <div class="lg:col-span-2">
          <button 
            type="submit" 
            class="w-full bg-[#0d3b23] hover:bg-[#061e14] text-white font-extrabold text-xs sm:text-sm py-4 rounded-2xl transition duration-200 flex items-center justify-center gap-2 cursor-pointer shadow-md uppercase tracking-wider"
          >
            <span>Find Hotels</span>
            <span class="text-xs">➔</span>
          </button>
        </div>

      </form>

      <!-- Popular Fast-Filter Tags -->
      <div class="pt-3.5 mt-3 border-t border-slate-100 flex flex-wrap items-center gap-2 text-left">
        <span class="text-[11px] font-bold text-slate-400">Popular Inquiries:</span>
        <a href="/#hotels" class="text-[11px] font-bold text-slate-700 bg-slate-100 hover:bg-emerald-50 hover:text-emerald-800 px-3 py-1 rounded-full transition-colors">
          🏊 Rooftop Pool
        </a>
        <a href="/#hotels" class="text-[11px] font-bold text-slate-700 bg-slate-100 hover:bg-emerald-50 hover:text-emerald-800 px-3 py-1 rounded-full transition-colors">
          🏛️ Near US Embassy
        </a>
        <a href="/#hotels" class="text-[11px] font-bold text-slate-700 bg-slate-100 hover:bg-emerald-50 hover:text-emerald-800 px-3 py-1 rounded-full transition-colors">
          🍳 Free Breakfast
        </a>
        <a href="/#hotels" class="text-[11px] font-bold text-slate-700 bg-slate-100 hover:bg-emerald-50 hover:text-emerald-800 px-3 py-1 rounded-full transition-colors">
          ✈️ Airport Shuttle
        </a>
      </div>

    </div>
  </div>

</div>

<!-- ================= 3. SCRIPT (SMOOTH PLAY & SCROLL) ================= -->
<script is:inline>
  (() => {
    // 1. Video Autoplay Logic
    const video = document.getElementById('heroBgVideo');
    if (video) {
      let started = false;

      const playHeroVideo = () => {
        if (started) return;
        video.muted = true;
        const playPromise = video.play();
        if (playPromise !== undefined) {
          playPromise
            .then(() => { started = true; })
            .catch(() => {
              const triggerPlay = () => {
                video.play();
                started = true;
                window.removeEventListener('scroll', triggerPlay);
                window.removeEventListener('touchstart', triggerPlay);
              };
              window.addEventListener('scroll', triggerPlay, { passive: true, once: true });
              window.addEventListener('touchstart', triggerPlay, { passive: true, once: true });
            });
        } else {
          started = true;
        }
      };

      if ('IntersectionObserver' in window) {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                if (started) video.play().catch(() => {});
              } else {
                video.pause();
              }
            });
          },
          { threshold: 0.01 }
        );
        observer.observe(video);
      }

      document.addEventListener('visibilitychange', () => {
        if (document.hidden) {
          video.pause();
        } else if (started) {
          video.play().catch(() => {});
        }
      });

      if (document.readyState === 'complete') {
        playHeroVideo();
      } else {
        window.addEventListener('load', playHeroVideo, { passive: true, once: true });
      }
      document.addEventListener('astro:page-load', playHeroVideo);
    }

    // 2. Search Form Smooth Scroll Logic
    const initSearchScroll = () => {
      const searchForm = document.getElementById('heroHotelSearchForm');
      if (searchForm && !searchForm.dataset.bound) {
        searchForm.dataset.bound = 'true';
        searchForm.addEventListener('submit', (e) => {
          e.preventDefault();
          const target = document.getElementById('hotels') || document.querySelector('section');
          if (target) {
            target.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }
        });
      }
    };

    document.addEventListener('DOMContentLoaded', initSearchScroll);
    document.addEventListener('astro:page-load', initSearchScroll);
  })();
</script>
