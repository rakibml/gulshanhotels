---
// src/components/Hero.astro (Cinematic Mobile-First Hero & Instant Fast Autocomplete)
import { getCollection } from 'astro:content';

let searchableHotels: any[] = [];

try {
  const collection = await getCollection('hotels');
  if (Array.isArray(collection) && collection.length > 0) {
    searchableHotels = collection.map(h => {
      const rawSlug = String(h.data?.slug || h.slug || h.id || "hotel").trim();
      const cleanSlug = rawSlug.replace(/\.(md|mdx)$/, '').split('/').pop()?.toLowerCase() || "";
      return {
        title: (h.data?.title || h.data?.name || "Hotel").trim(),
        slug: cleanSlug,
        location: (h.data?.location || h.data?.category || "Gulshan, Dhaka").trim(),
        price: (h.data?.price || "$120").trim(),
        image: h.data?.image || (Array.isArray(h.data?.gallery) ? h.data?.gallery[0] : "https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&w=150&q=75")
      };
    });
  }
} catch (e) {}

if (searchableHotels.length === 0) {
  try {
    const rawGlob = import.meta.glob(['/src/content/hotels/*.{md,mdx}', '../content/hotels/*.{md,mdx}'], { eager: true });
    searchableHotels = Object.entries(rawGlob).map(([filePath, item]: [string, any]) => {
      const cleanSlug = filePath.split('/').pop()?.replace(/\.(md|mdx)$/, '').trim().toLowerCase() || "";
      const frontmatter = item?.frontmatter || item?.data || {};
      return {
        title: (frontmatter.title || frontmatter.name || "Hotel").trim(),
        slug: cleanSlug,
        location: (frontmatter.location || "Gulshan, Dhaka").trim(),
        price: (frontmatter.price || "$120").trim(),
        image: frontmatter.image || "https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&w=150&q=75"
      };
    });
  } catch (e) {}
}
---

<div class="relative w-full bg-white">

  <!-- ================= 1. CINEMATIC HERO BANNER ================= -->
  <section
    class="relative w-full overflow-hidden bg-slate-950 min-h-[380px] sm:min-h-[440px] lg:min-h-[490px] flex items-center justify-center text-center"
    style="contain: layout paint;"
  >

    <!-- GPU ACCELERATED BACKGROUND -->
    <div class="absolute inset-0 w-full h-full overflow-hidden pointer-events-none">
      
      <!-- ১. অপটিমাইজড LCP ইমেজ (মোবাইলে ০ সেকেন্ডে রেন্ডার হবে) -->
      <img 
        src="https://media.gulshanhotels.com/34884184.jpg" 
        alt="Luxury Hotels in Gulshan Dhaka" 
        width="1920"
        height="1080"
        fetchpriority="high"
        decoding="async"
        class="w-full h-full object-cover object-center absolute inset-0 scale-105"
      />

      <!-- ২. সিনেমাটিক ডার্ক ওভারলে (লেখা স্পষ্ট ফুটিয়ে তোলার জন্য) -->
      <div class="absolute inset-0 bg-gradient-to-b from-black/65 via-black/45 to-black/80"></div>

      <!-- ৩. ৬০FPS ভিডিও (শুধুমাত্র ডেক্সটপের জন্য) -->
      <video
        id="heroBgVideo"
        autoplay
        loop
        muted
        playsinline
        preload="none"
        disablepictureinpicture
        disableremoteplayback
        class="hidden sm:block w-full h-full object-cover object-center opacity-85 will-change-transform"
      >
        <source src="https://media.gulshanhotels.com/hero-video.mp4.mp4" type="video/mp4" />
      </video>
    </div>

    <!-- ================= TYPOGRAPHY (PERFECT SEO H1) ================= -->
    <div class="relative z-10 flex flex-col items-center justify-center select-none px-4 pt-6 pb-12 sm:pb-14">
      <h1 class="flex flex-col items-center leading-none text-white drop-shadow-lg">
        
        <!-- লাইন ১: HOTELS -->
        <span class="font-['Bebas_Neue',sans-serif] text-5xl sm:text-7xl md:text-8xl lg:text-[105px] tracking-wider block">
          HOTELS
        </span>

        <!-- লাইন ২: IN GULSHAN -->
        <span class="flex items-center justify-center gap-2 sm:gap-4 -mt-1 sm:-mt-4">
          <span class="flex flex-col items-center justify-center px-1">
            <svg class="w-6 sm:w-12 h-1.5 sm:h-3 text-emerald-400 fill-none stroke-current stroke-[3] sm:stroke-[4] stroke-linecap-round" viewBox="0 0 60 10">
              <path d="M 4 8 Q 28 1 56 6" />
            </svg>
            <span class="font-['Bebas_Neue',sans-serif] text-xl sm:text-3xl md:text-4xl text-emerald-300 italic tracking-widest leading-none -my-0.5">
              IN
            </span>
            <svg class="w-6 sm:w-12 h-1.5 sm:h-3 text-emerald-400 fill-none stroke-current stroke-[3] sm:stroke-[4] stroke-linecap-round" viewBox="0 0 60 10">
              <path d="M 4 3 Q 32 9 56 3" />
            </svg>
          </span>

          <span class="font-['Bebas_Neue',sans-serif] text-5xl sm:text-7xl md:text-8xl lg:text-[105px] tracking-wider text-white">
            GULSHAN
          </span>
        </span>

        <!-- লাইন ৩: DHAKA • BANGLADESH -->
        <span class="flex items-center gap-2 sm:gap-3 mt-2 sm:mt-3">
          <span class="h-[1.5px] w-6 sm:w-12 bg-white/70"></span>
          <span class="font-['Montserrat',sans-serif] text-[10px] sm:text-xs md:text-sm font-black tracking-[0.35em] text-slate-200 uppercase">
            DHAKA • BANGLADESH
          </span>
          <span class="h-[1.5px] w-6 sm:w-12 bg-white/70"></span>
        </span>

      </h1>
    </div>

  </section>

  <!-- ================= 2. LIVE AUTOCOMPLETE SEARCH BAR ================= -->
  <div id="heroSearchWrapper" class="relative z-40 max-w-2xl mx-auto px-4 -mt-6 sm:-mt-7 mb-6">
    <div class="relative">
      
      <form id="heroHotelSearchForm" class="bg-white rounded-full p-1.5 pl-4 sm:pl-5 border border-slate-200/90 shadow-xl flex items-center justify-between gap-2" onsubmit="return false;">
        
        <div class="flex-1 flex items-center gap-2 min-w-0">
          <svg class="w-4 h-4 text-emerald-800 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          <input 
            type="text" 
            id="liveHotelSearchInput"
            placeholder="Search hotel (e.g. Westin, Amari)..." 
            class="w-full bg-transparent text-xs sm:text-sm font-bold text-slate-900 placeholder-slate-400 outline-none truncate"
            autocomplete="off"
          />
        </div>

        <button 
          id="clearSearchBtn"
          type="button" 
          aria-label="Clear Search"
          class="hidden text-slate-400 hover:text-slate-700 text-xs font-bold p-1 cursor-pointer"
        >
          ✕
        </button>

        <button 
          id="triggerSearchBtn"
          type="button" 
          class="bg-[#0d3b23] hover:bg-[#061e14] text-white font-black text-xs sm:text-sm px-4 sm:px-5 py-2.5 rounded-full transition shrink-0 flex items-center gap-1.5 cursor-pointer active:scale-95 shadow-sm"
        >
          <span>Search</span>
          <svg class="w-3.5 h-3.5 fill-current shrink-0" viewBox="0 0 24 24">
            <path d="M5 12h14M12 5l7 7-7 7" stroke="currentColor" stroke-width="2.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
      </form>

      <!-- AUTOCOMPLETE DROPDOWN -->
      <div 
        id="liveSearchDropdown" 
        class="hidden absolute top-full left-0 right-0 mt-2 bg-white rounded-3xl border border-slate-200 shadow-2xl overflow-hidden z-50 text-left max-h-[340px] overflow-y-auto"
      >
        <div class="p-3 bg-slate-50 border-b border-slate-100 flex items-center justify-between text-[11px] font-black uppercase tracking-wider text-slate-500">
          <span id="dropdownHeaderTitle">Matching Hotels</span>
          <span id="dropdownMatchCount" class="text-emerald-800 font-extrabold">0 found</span>
        </div>

        <div id="dropdownResultsList" class="divide-y divide-slate-100"></div>

        <div class="p-2.5 bg-slate-50 border-t border-slate-100 flex flex-wrap items-center gap-1.5 text-xs">
          <span class="text-[9px] font-bold text-slate-400 uppercase">Popular:</span>
          <button type="button" class="quick-area-tag text-[10px] font-bold text-slate-700 bg-white border border-slate-200 hover:border-emerald-600 px-2 py-0.5 rounded-full cursor-pointer">Gulshan 2</button>
          <button type="button" class="quick-area-tag text-[10px] font-bold text-slate-700 bg-white border border-slate-200 hover:border-emerald-600 px-2 py-0.5 rounded-full cursor-pointer">Gulshan 1</button>
          <button type="button" class="quick-area-tag text-[10px] font-bold text-slate-700 bg-white border border-slate-200 hover:border-emerald-600 px-2 py-0.5 rounded-full cursor-pointer">Banani</button>
        </div>
      </div>
    </div>
  </div>

</div>

<!-- DATA ISLAND -->
<script id="hotelsDataStore" type="application/json" set:html={JSON.stringify(searchableHotels)} />

<!-- CLIENT SCRIPT -->
<script is:inline>
  (() => {
    // 1. NON-BLOCKING VIDEO PLAY (DESKTOP)
    const video = document.getElementById('heroBgVideo');
    if (video && window.innerWidth >= 640) {
      const playVideo = () => {
        video.muted = true;
        video.preload = 'auto';
        video.play().catch(() => {});
      };

      if ('requestIdleCallback' in window) requestIdleCallback(playVideo);
      else setTimeout(playVideo, 600);

      if ('IntersectionObserver' in window) {
        new IntersectionObserver((entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) video.play().catch(() => {});
            else video.pause();
          });
        }, { threshold: 0.01 }).observe(video);
      }
    }

    // 2. AUTOCOMPLETE ENGINE
    const initAutocomplete = () => {
      const input = document.getElementById('liveHotelSearchInput');
      const dropdown = document.getElementById('liveSearchDropdown');
      const resultsContainer = document.getElementById('dropdownResultsList');
      const countEl = document.getElementById('dropdownMatchCount');
      const headerTitle = document.getElementById('dropdownHeaderTitle');
      const clearBtn = document.getElementById('clearSearchBtn');
      const triggerBtn = document.getElementById('triggerSearchBtn');
      const dataScript = document.getElementById('hotelsDataStore');
      const searchWrapper = document.getElementById('heroSearchWrapper');

      if (!input || !dropdown || !resultsContainer || !dataScript || input.dataset.ready) return;
      input.dataset.ready = 'true';

      let hotels = [];
      try { hotels = JSON.parse(dataScript.textContent || '[]'); } catch { hotels = []; }

      let currentMatches = [];

      const renderList = (matches, isTrending = false) => {
        currentMatches = matches;
        if (headerTitle) headerTitle.textContent = isTrending ? 'Popular Stays in Gulshan' : 'Matching Hotels';

        if (matches.length === 0) {
          if (countEl) countEl.textContent = '0 found';
          resultsContainer.innerHTML = `
            <div class="p-5 text-center text-slate-500 space-y-1">
              <div class="w-8 h-8 mx-auto rounded-full bg-slate-100 flex items-center justify-center text-slate-400">
                <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                  <path d="M15.5 14h-.79l-.28-.27A6.471 6.471 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/>
                </svg>
              </div>
              <p class="text-xs font-bold text-slate-700">No hotels found matching "${input.value}".</p>
            </div>
          `;
          dropdown.classList.remove('hidden');
          return;
        }

        if (countEl) countEl.textContent = `${matches.length} found`;

        resultsContainer.innerHTML = matches.map(h => `
          <a 
            href="/${h.slug}" 
            class="flex items-center justify-between p-3 hover:bg-slate-50 transition-colors group cursor-pointer"
          >
            <div class="flex items-center gap-2.5 min-w-0">
              <img src="${h.image}" alt="${h.title}" width="40" height="40" loading="lazy" decoding="async" class="w-10 h-10 rounded-xl object-cover shrink-0 border border-slate-200" />
              <div class="min-w-0">
                <h4 class="font-bold text-slate-900 text-xs group-hover:text-emerald-800 transition-colors capitalize truncate">
                  ${h.title}
                </h4>
                <div class="flex items-center gap-1 text-[10px] text-slate-500 font-medium truncate mt-0.5">
                  <svg class="w-3 h-3 fill-emerald-600 shrink-0" viewBox="0 0 24 24"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>
                  <span>${h.location}</span>
                </div>
              </div>
            </div>

            <div class="text-right shrink-0 pl-2">
              <span class="text-xs font-black text-slate-900 block">${h.price.startsWith('$') || h.price.startsWith('৳') ? h.price : '$' + h.price}</span>
              <span class="text-[9px] text-emerald-800 font-extrabold group-hover:underline">View ➔</span>
            </div>
          </a>
        `).join('');

        dropdown.classList.remove('hidden');
      };

      const handleSearch = () => {
        const q = input.value.trim().toLowerCase();
        if (clearBtn) {
          if (q.length > 0) clearBtn.classList.remove('hidden');
          else clearBtn.classList.add('hidden');
        }

        if (!q) {
          renderList(hotels.slice(0, 4), true);
          return;
        }

        const filtered = hotels.filter(h => {
          const t = h.title.toLowerCase();
          const l = h.location.toLowerCase();
          const s = h.slug.toLowerCase();
          return t.includes(q) || l.includes(q) || s.includes(q);
        });

        renderList(filtered, false);
      };

      const executeTopSearch = () => {
        if (currentMatches.length > 0 && currentMatches[0].slug) {
          window.location.href = `/${currentMatches[0].slug}`;
        }
      };

      input.addEventListener('input', handleSearch, { passive: true });
      input.addEventListener('focus', handleSearch, { passive: true });

      input.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
          e.preventDefault();
          executeTopSearch();
        }
      });

      triggerBtn?.addEventListener('click', executeTopSearch);

      clearBtn?.addEventListener('click', () => {
        input.value = '';
        clearBtn.classList.add('hidden');
        renderList(hotels.slice(0, 4), true);
        input.focus();
      });

      document.querySelectorAll('.quick-area-tag').forEach(tag => {
        tag.addEventListener('click', (e) => {
          input.value = e.target.textContent || '';
          handleSearch();
          input.focus();
        });
      });

      document.addEventListener('click', (e) => {
        if (searchWrapper && !searchWrapper.contains(e.target)) {
          dropdown.classList.add('hidden');
        }
      });
    };

    document.addEventListener('DOMContentLoaded', initAutocomplete);
    document.addEventListener('astro:page-load', initAutocomplete);
  })();
</script>
