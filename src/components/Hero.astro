---
// src/components/Hero.astro (Official Metropolitan Hospitality Portal Standard)
---

<!-- OFFICIAL HERO BANNER SECTION -->
<section class="relative bg-slate-950 min-h-[520px] lg:min-h-[580px] flex items-center justify-center border-b border-slate-200/80 overflow-hidden text-left">
  
  <!-- High-Resolution Backdrop with Deep Cinematic Overlay -->
  <div class="absolute inset-0 w-full h-full">
    <img 
      src="/hero-gulshan.jpg.webp" 
      onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1512917774080-9991f1c4c750?auto=format&fit=crop&w=2000&q=85';"
      alt="Official Hotels in Gulshan Dhaka - Diplomatic District" 
      fetchpriority="high"
      loading="eager"
      decoding="async"
      class="w-full h-full object-cover object-center opacity-45 scale-100" 
    />
    <!-- Deep Royal Navy & Slate Overlay -->
    <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/70 to-slate-900/50"></div>
  </div>

  <!-- Main Content & Search Console Container -->
  <div class="relative z-10 max-w-[1240px] mx-auto w-full px-4 sm:px-6 lg:px-8 py-14 sm:py-20 text-center space-y-6 sm:space-y-8">
    
    <!-- 1. Institutional Authority Crest / Badge -->
    <div class="inline-flex items-center gap-2 bg-slate-900/90 border border-slate-700/80 px-4 py-1.5 rounded-full shadow-lg backdrop-blur-md">
      <svg class="w-3.5 h-3.5 text-amber-400 shrink-0" viewBox="0 0 24 24" fill="currentColor">
        <path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm-2 16l-4-4 1.41-1.41L10 14.17l6.59-6.59L18 9l-8 8z"/>
      </svg>
      <span class="text-[10px] sm:text-[11px] font-black uppercase tracking-[0.25em] text-slate-200">
        Dhaka Diplomatic District • Official Portal
      </span>
    </div>

    <!-- 2. High-Authority H1 Headline (Exact SEO Keyword Match) -->
    <div class="space-y-3 max-w-4xl mx-auto">
      <h1 class="font-serif text-3xl sm:text-5xl lg:text-6xl font-black text-white tracking-tight leading-[1.12] drop-shadow-sm">
        Hotels & Luxury Suites in Gulshan, Dhaka
      </h1>
      <p class="text-xs sm:text-base text-slate-300 max-w-2xl mx-auto font-normal leading-relaxed">
        The verified accommodation directory for <strong>Gulshan 1, Gulshan 2</strong>, and the Diplomatic Zone. Compare genuine rates and book with confidence.
      </p>
    </div>

    <!-- 3. Structured Official Search Console (Booking.com / Institutional Style) -->
    <div class="max-w-4xl mx-auto w-full bg-white rounded-2xl shadow-2xl p-2.5 sm:p-3 border border-slate-200/90 text-left">
      <form action="/hotels" method="GET" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-12 gap-2 items-center">
        
        <!-- Module A: Zone / Location (4 Columns) -->
        <div class="lg:col-span-4 p-2 sm:px-3 bg-slate-50/80 rounded-xl border border-slate-100 hover:border-slate-300 transition">
          <label class="text-[9px] font-black uppercase text-slate-400 tracking-wider block leading-none mb-1">
            Zone / Location
          </label>
          <div class="flex items-center gap-2">
            <svg class="w-3.5 h-3.5 text-[#006ce4] shrink-0" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
            </svg>
            <select name="area" class="w-full text-xs font-bold text-slate-800 bg-transparent outline-none cursor-pointer">
              <option value="all">All Gulshan District</option>
              <option value="gulshan-1">Gulshan 1 (Commercial Hub)</option>
              <option value="gulshan-2">Gulshan 2 (Diplomatic Enclave)</option>
              <option value="near">Near Gulshan / Banani</option>
            </select>
          </div>
        </div>

        <!-- Module B: Property Category (4 Columns) -->
        <div class="lg:col-span-4 p-2 sm:px-3 bg-slate-50/80 rounded-xl border border-slate-100 hover:border-slate-300 transition">
          <label class="text-[9px] font-black uppercase text-slate-400 tracking-wider block leading-none mb-1">
            Property Category
          </label>
          <div class="flex items-center gap-2">
            <svg class="w-3.5 h-3.5 text-emerald-700 shrink-0" viewBox="0 0 24 24" fill="currentColor">
              <path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-7 3c1.66 0 3 1.34 3 3s-1.34 3-3 3-3-1.34-3-3 1.34-3 3-3zm3 10H9v-1c0-1 2-1.9 3-1.9s3 .9 3 1.9v1z"/>
            </svg>
            <select name="type" class="w-full text-xs font-bold text-slate-800 bg-transparent outline-none cursor-pointer">
              <option value="all">All Properties</option>
              <option value="hotel">5-Star & Luxury Hotels</option>
              <option value="guesthouse">Boutique Guest Houses</option>
            </select>
          </div>
        </div>

        <!-- Module C: Search Button (4 Columns) -->
        <div class="sm:col-span-2 lg:col-span-4 flex items-center">
          <button 
            type="submit" 
            class="w-full bg-[#003b95] hover:bg-[#002b6e] text-white font-black text-xs sm:text-sm py-3.5 px-6 rounded-xl shadow-md transition-all flex items-center justify-center gap-2 cursor-pointer active:scale-98 tracking-wide"
          >
            <span>Search Properties</span>
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
              <path d="M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z"/>
            </svg>
          </button>
        </div>

      </form>
    </div>

    <!-- 4. Official Trust Credentials Bar (4 Pillars) -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-3 max-w-4xl mx-auto pt-2 text-left">
      
      <div class="flex items-center gap-2.5 p-2 rounded-xl bg-slate-900/60 border border-slate-800/80 backdrop-blur-xs">
        <div class="w-7 h-7 rounded-lg bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center shrink-0">
          <svg class="w-3.5 h-3.5 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
        </div>
        <div>
          <span class="text-[11px] font-black text-white block leading-tight">100% Verified</span>
          <span class="text-[9px] text-slate-400 font-semibold block leading-tight">Authentic properties</span>
        </div>
      </div>

      <div class="flex items-center gap-2.5 p-2 rounded-xl bg-slate-900/60 border border-slate-800/80 backdrop-blur-xs">
        <div class="w-7 h-7 rounded-lg bg-blue-500/10 border border-blue-500/20 flex items-center justify-center shrink-0">
          <svg class="w-3.5 h-3.5 text-blue-400" viewBox="0 0 24 24" fill="currentColor"><path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4z"/></svg>
        </div>
        <div>
          <span class="text-[11px] font-black text-white block leading-tight">Diplomatic Zone</span>
          <span class="text-[9px] text-slate-400 font-semibold block leading-tight">Highest safety standards</span>
        </div>
      </div>

      <div class="flex items-center gap-2.5 p-2 rounded-xl bg-slate-900/60 border border-slate-800/80 backdrop-blur-xs">
        <div class="w-7 h-7 rounded-lg bg-amber-500/10 border border-amber-500/20 flex items-center justify-center shrink-0">
          <svg class="w-3.5 h-3.5 text-amber-400" viewBox="0 0 24 24" fill="currentColor"><path d="M21.41 11.58l-9-9C12.05 2.22 11.55 2 11 2H4c-1.1 0-2 .9-2 2v7c0 .55.22 1.05.59 1.42l9 9c.36.36.86.58 1.41.58.55 0 1.05-.22 1.41-.59l7-7c.37-.36.59-.86.59-1.41 0-.55-.23-1.06-.59-1.42z"/></svg>
        </div>
        <div>
          <span class="text-[11px] font-black text-white block leading-tight">Rate Comparison</span>
          <span class="text-[9px] text-slate-400 font-semibold block leading-tight">Best rate found</span>
        </div>
      </div>

      <div class="flex items-center gap-2.5 p-2 rounded-xl bg-slate-900/60 border border-slate-800/80 backdrop-blur-xs">
        <div class="w-7 h-7 rounded-lg bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center shrink-0">
          <svg class="w-3.5 h-3.5 text-emerald-400" viewBox="0 0 24 24" fill="currentColor"><path d="M12.012 2c-5.506 0-9.989 4.478-9.99 9.984 0 1.763.459 3.48 1.332 5.001l-1.416 5.163 5.281-1.388c1.464.798 3.118 1.22 4.79 1.22h.004c5.506 0 9.989-4.478 9.99-9.984 0-2.668-1.038-5.176-2.923-7.062a9.923 9.923 0 0 0-7.058-2.934z"/></svg>
        </div>
        <div>
          <span class="text-[11px] font-black text-white block leading-tight">Direct WhatsApp</span>
          <span class="text-[9px] text-slate-400 font-semibold block leading-tight">Zero commission fee</span>
        </div>
      </div>

    </div>

  </div>
</section>
