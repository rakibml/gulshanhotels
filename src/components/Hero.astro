---
// src/components/Hero.astro (70% Mobile Height [2.8/4] + Soft Natural Left Shade + Clean Text)
---

<!-- 
  - মোবাইলে ৪ ভাগের ২.৮ ভাগ উচ্চতা: min-h-[70dvh] 
  - ডেসটপে ফুলস্ক্রিন লাক্সারি হাইট: lg:min-h-screen
-->
<section class="relative bg-slate-950 min-h-[70dvh] sm:min-h-[75dvh] lg:min-h-screen flex flex-col justify-between text-left overflow-visible">
  
  <!-- ================= 1. BACKGROUND VIDEO ================= -->
  <div class="absolute inset-0 w-full h-full overflow-hidden pointer-events-none">
    <video 
      id="heroBgVideo"
      autoplay 
      loop 
      muted 
      playsinline 
      preload="auto"
      poster="/hero-gulshan.jpg.webp"
      class="w-full h-full object-cover object-center scale-105 opacity-100"
    >
      <source src="/hero-video.mp4.mp4" type="video/mp4" />
      <source src="https://commondatastorage.googleapis.com/gtv-videos-bucket/sample/ForBiggerBlazes.mp4" type="video/mp4" />
    </video>

    <!-- 
      🌟 স্মার্ট হোয়াইট শেড: 
      - মোবাইলে খুব হালকা (from-white/70 via-white/35) যাতে ভিডিওর রঙ ও লাইটিং পুরো স্পষ্ট থাকে
      - ডেসটপে আগের মতো প্রফেশনাল ফেড (md:from-white md:via-white/90)
    -->
    <div class="absolute inset-y-0 left-0 w-full sm:w-3/4 md:w-3/5 lg:w-1/2 bg-gradient-to-r from-white/70 via-white/35 to-transparent md:from-white md:via-white/90 md:to-transparent pointer-events-none z-[5]"></div>

    <!-- হালকা বটম শেড -->
    <div class="absolute inset-x-0 bottom-0 h-20 bg-gradient-to-t from-slate-950/40 to-transparent pointer-events-none"></div>
  </div>

  <!-- ================= 2. CLEAN EDITORIAL CONTENT (NO BOX, DIRECT TEXT) ================= -->
  <div class="relative z-10 max-w-[1550px] mx-auto w-full px-4 sm:px-8 lg:px-12 pt-14 sm:pt-24 pb-8 my-auto">
    <div class="max-w-xl text-left space-y-3.5 sm:space-y-5">
      
      <!-- Top Red Eyebrow Badge -->
      <div class="inline-flex items-center gap-1.5 text-[#e52429] font-black text-xs sm:text-sm tracking-wider uppercase drop-shadow-xs">
        <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4 fill-current shrink-0" viewBox="0 0 24 24">
          <path d="M20 6h-4V4c0-1.11-.89-2-2-2h-4c-1.11 0-2 .89-2 2v2H4c-1.11 0-1.99.89-1.99 2L2 19c0 1.11.89 2 2 2h16c1.11 0 2-.89 2-2V8c0-1.11-.89-2-2-2zm-6 0h-4V4h4v2z"/>
        </svg>
        <span>Explore Without Limits</span>
      </div>

      <!-- Main Headline -->
      <h1 
        class="font-serif text-3xl sm:text-5xl lg:text-6xl font-black text-slate-950 tracking-tight leading-[1.14]"
        style="text-shadow: 0 1px 10px rgba(255,255,255,0.7);"
      >
        Hotels in Gulshan, Dhaka
      </h1>

      <!-- Subtitle Paragraph -->
      <p class="text-xs sm:text-base text-slate-800 font-medium leading-relaxed max-w-lg">
        Experience world-class luxury suites, diplomatic security, and verified rates in Gulshan 1, Gulshan 2, and the Diplomatic Zone.
      </p>

      <!-- Red Action Button -->
      <div class="pt-0.5">
        <a 
          href="/hotels" 
          class="inline-flex items-center gap-2 bg-[#e52429] hover:bg-[#c91d22] text-white font-extrabold text-xs sm:text-sm px-6 py-2.5 sm:py-3.5 rounded-full shadow-lg hover:shadow-xl hover:scale-105 active:scale-95 transition-all cursor-pointer"
        >
          <span>Explore Hotels</span>
          <span class="text-sm">➔</span>
        </a>
      </div>

      <!-- Three Circular Photo Badges -->
      <div class="flex items-center gap-2.5 pt-1">
        <a href="/hotels" title="Lakefront Hotels" class="w-11 h-11 sm:w-14 sm:h-14 rounded-full overflow-hidden border-2 border-white ring-2 ring-slate-300/80 shadow-md hover:scale-110 transition-transform cursor-pointer shrink-0">
          <img 
            src="https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&w=150&q=80" 
            alt="Gulshan Lakefront Stays" 
            class="w-full h-full object-cover" 
          />
        </a>

        <a href="/hotels?stars=5" title="5-Star Luxury Suites" class="w-11 h-11 sm:w-14 sm:h-14 rounded-full overflow-hidden border-2 border-white ring-2 ring-slate-300/80 shadow-md hover:scale-110 transition-transform cursor-pointer shrink-0">
          <img 
            src="https://images.unsplash.com/photo-1618773928121-c32242e63f39?auto=format&fit=crop&w=150&q=80" 
            alt="Luxury Hotel Rooms" 
            class="w-full h-full object-cover" 
          />
        </a>

        <a href="/hotels?area=gulshan-2" title="Rooftop Pool & Spa" class="w-11 h-11 sm:w-14 sm:h-14 rounded-full overflow-hidden border-2 border-white ring-2 ring-slate-300/80 shadow-md hover:scale-110 transition-transform cursor-pointer shrink-0">
          <img 
            src="https://images.unsplash.com/photo-1582719478250-c89cae4dc85b?auto=format&fit=crop&w=150&q=80" 
            alt="Rooftop Pool & Dining" 
            class="w-full h-full object-cover" 
          />
        </a>
      </div>

    </div>
  </div>

  <!-- ================= 3. OVERLAPPING SEARCH CONSOLE ================= -->
  <div class="relative z-30 max-w-4xl mx-auto w-full px-3 sm:px-6 lg:px-8 translate-y-1/2">
    <div class="bg-white rounded-2xl shadow-2xl p-2 sm:p-2.5 md:p-3 border border-slate-200/90 text-left">
      <form action="/hotels" method="GET" class="grid grid-cols-2 lg:grid-cols-12 gap-1.5 sm:gap-2 items-center">
        
        <!-- Location Dropdown -->
        <div class="col-span-1 lg:col-span-4 p-1.5 sm:p-2 sm:px-3 bg-slate-50/90 rounded-xl border border-slate-200 hover:border-slate-300 transition">
          <label class="text-[8px] sm:text-[9px] font-black uppercase text-slate-400 tracking-wider block leading-none mb-0.5 sm:mb-1 truncate">
            Location
          </label>
          <div class="flex items-center gap-1 sm:gap-2">
            <svg class="w-3 h-3 sm:w-3.5 sm:h-3.5 text-[#006ce4] shrink-0" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 2C8.13 2 5 5.13 5 9c0 5.2 7 13 7 13s7-7.8 7-13c0-3.9-3.1-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
            </svg>
            <select name="area" class="w-full text-[11px] sm:text-xs font-bold text-slate-800 bg-transparent outline-none cursor-pointer truncate">
              <option value="all">All Gulshan</option>
              <option value="gulshan-1">Gulshan 1</option>
              <option value="gulshan-2">Gulshan 2</option>
              <option value="near">Near Gulshan</option>
            </select>
          </div>
        </div>

        <!-- Category Dropdown -->
        <div class="col-span-1 lg:col-span-4 p-1.5 sm:p-2 sm:px-3 bg-slate-50/90 rounded-xl border border-slate-200 hover:border-slate-300 transition">
          <label class="text-[8px] sm:text-[9px] font-black uppercase text-slate-400 tracking-wider block leading-none mb-0.5 sm:mb-1 truncate">
            Category
          </label>
          <div class="flex items-center gap-1 sm:gap-2">
            <svg class="w-3.5 h-3.5 text-emerald-700 shrink-0" viewBox="0 0 24 24" fill="currentColor">
              <path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-7 3c1.66 0 3 1.34 3 3s-1.34 3-3 3-3-1.34-3-3 1.34-3 3-3zm3 10H9v-1c0-1 2-1.9 3-1.9s3 .9 3 1.9v1z"/>
            </svg>
            <select name="type" class="w-full text-[11px] sm:text-xs font-bold text-slate-800 bg-transparent outline-none cursor-pointer truncate">
              <option value="all">All Properties</option>
              <option value="hotel">5-Star Hotels</option>
              <option value="guesthouse">Guest Houses</option>
            </select>
          </div>
        </div>

        <!-- Search Button -->
        <div class="col-span-2 lg:col-span-4 flex items-center">
          <button 
            type="submit" 
            class="w-full bg-[#003b95] hover:bg-[#002b6e] text-white font-black text-xs sm:text-sm py-2.5 sm:py-3.5 px-4 rounded-xl shadow-md transition-all flex items-center justify-center gap-1.5 cursor-pointer active:scale-98 tracking-wide"
          >
            <span>Search Properties</span>
            <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4 fill-current" viewBox="0 0 24 24">
              <path d="M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z"/>
            </svg>
          </button>
        </div>

      </form>
    </div>
  </div>

</section>

<!-- ================= 4. AUTOPLAY SCRIPT ================= -->
<script is:inline>
  const playHeroVideo = () => {
    const video = document.getElementById('heroBgVideo');
    if (video) {
      video.muted = true;
      const playPromise = video.play();
      if (playPromise !== undefined) {
        playPromise.catch(() => {
          const triggerPlay = () => {
            video.play();
            window.removeEventListener('scroll', triggerPlay);
            window.removeEventListener('touchstart', triggerPlay);
          };
          window.addEventListener('scroll', triggerPlay, { passive: true });
          window.addEventListener('touchstart', triggerPlay, { passive: true });
        });
      }
    }
  };

  document.addEventListener('DOMContentLoaded', playHeroVideo);
  document.addEventListener('astro:page-load', playHeroVideo);
</script>
