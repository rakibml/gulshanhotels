---
// src/components/Hero.astro - 100% LateRooms Replica (Background, Clock & Search Bar)
---

<section class="relative w-full overflow-hidden bg-[#160136] text-left pt-12 pb-14 sm:pt-16 sm:pb-16 lg:pt-20 lg:pb-20">
  
  <!-- ================= 1. EXACT LATEROOMS BACKGROUND & LIGHTING ================= -->
  <!-- বেস ডিপ গ্রাডিয়েন্ট (বামে ভায়োলেট, মাঝে ডিপ মিডনাইট, ডানে পার্পল) -->
  <div 
    class="absolute inset-0 pointer-events-none"
    style="background: radial-gradient(circle at 12% 40%, rgba(110, 56, 188, 0.45) 0%, transparent 45%), radial-gradient(circle at 92% 50%, rgba(132, 41, 158, 0.35) 0%, transparent 40%), linear-gradient(105deg, #4f158c 0%, #200244 32%, #120036 58%, #2d0452 82%, #681585 100%);"
  ></div>

  <!-- বাম পাশের ডায়াগনাল সফট লাইট বিম (LateRooms Signature Diagonal Ray) -->
  <div class="absolute -top-24 -left-20 w-[480px] h-[480px] bg-[#7c2fd3]/20 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute bottom-0 -left-10 w-72 h-72 bg-[#57199c]/30 rounded-full blur-2xl pointer-events-none"></div>

  <!-- ডান পাশের বোকেহ গ্লোব -->
  <div class="absolute top-1/4 right-0 w-80 h-80 bg-[#a232b8]/20 rounded-full blur-3xl pointer-events-none"></div>

  <!-- ================= 2. EXACT LATEROOMS CLOCK (NO OUTER RING + PINK HANDS) ================= -->
  <div class="absolute top-4 sm:top-6 lg:top-8 right-1/2 translate-x-1/2 sm:translate-x-0 sm:right-10 lg:right-32 w-[340px] h-[340px] sm:w-[420px] sm:h-[420px] lg:w-[480px] lg:h-[480px] pointer-events-none opacity-40 sm:opacity-55 lg:opacity-65 select-none">
    <svg viewBox="0 0 400 400" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full h-full">
      <!-- ১২টি আওয়ার টিক্স (Capsule Pills) -->
      <!-- 12 o'clock -->
      <line x1="200" y1="40" x2="200" y2="72" stroke="#a38ce0" stroke-width="11" stroke-linecap="round" opacity="0.45" />
      <!-- 1 o'clock -->
      <line x1="280" y1="61" x2="264" y2="89" stroke="#a38ce0" stroke-width="11" stroke-linecap="round" opacity="0.45" />
      <!-- 2 o'clock -->
      <line x1="339" y1="120" x2="311" y2="136" stroke="#a38ce0" stroke-width="11" stroke-linecap="round" opacity="0.45" />
      <!-- 3 o'clock -->
      <line x1="360" y1="200" x2="328" y2="200" stroke="#a38ce0" stroke-width="11" stroke-linecap="round" opacity="0.45" />
      <!-- 4 o'clock -->
      <line x1="339" y1="280" x2="311" y2="264" stroke="#a38ce0" stroke-width="11" stroke-linecap="round" opacity="0.45" />
      <!-- 5 o'clock -->
      <line x1="280" y1="339" x2="264" y2="311" stroke="#a38ce0" stroke-width="11" stroke-linecap="round" opacity="0.45" />
      <!-- 6 o'clock -->
      <line x1="200" y1="360" x2="200" y2="328" stroke="#a38ce0" stroke-width="11" stroke-linecap="round" opacity="0.45" />
      <!-- 7 o'clock -->
      <line x1="120" y1="339" x2="136" y2="311" stroke="#a38ce0" stroke-width="11" stroke-linecap="round" opacity="0.45" />
      <!-- 8 o'clock -->
      <line x1="61" y1="280" x2="89" y2="264" stroke="#a38ce0" stroke-width="11" stroke-linecap="round" opacity="0.45" />
      <!-- 9 o'clock -->
      <line x1="40" y1="200" x2="72" y2="200" stroke="#a38ce0" stroke-width="11" stroke-linecap="round" opacity="0.45" />
      <!-- 10 o'clock -->
      <line x1="61" y1="120" x2="89" y2="136" stroke="#a38ce0" stroke-width="11" stroke-linecap="round" opacity="0.45" />
      <!-- 11 o'clock -->
      <line x1="120" y1="61" x2="136" y2="89" stroke="#a38ce0" stroke-width="11" stroke-linecap="round" opacity="0.45" />

      <!-- ঘণ্টার কাঁটা (Short Pink Hand - pointing at 10:20) -->
      <line x1="184" y1="184" x2="148" y2="148" stroke="#de3a68" stroke-width="13" stroke-linecap="round" />

      <!-- মিনিটের কাঁটা (Long Pink Hand - pointing at 1:45) -->
      <line x1="214" y1="186" x2="268" y2="132" stroke="#de3a68" stroke-width="13" stroke-linecap="round" />

      <!-- সেন্টারের পিঙ্ক ডট -->
      <circle cx="200" cy="200" r="8" fill="#de3a68" />
    </svg>
  </div>

  <!-- ================= 3. CONTENT CONTAINER ================= -->
  <div class="relative z-10 max-w-6xl mx-auto w-full px-4 sm:px-6 lg:px-8">
    
    <!-- HEADLINE (Left Aligned & Dual Tone) -->
    <div class="mb-6 sm:mb-8 max-w-2xl">
      <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-[54px] font-black tracking-tight leading-tight text-[#a38ce0]">
        Hotels in Gulshan, <span class="text-[#de3a68]">Dhaka</span>
      </h1>
      <p class="text-white text-xs sm:text-sm font-semibold italic tracking-[0.14em] uppercase mt-2 opacity-90">
        THE PLACE TO BOOK LAST-MINUTE HOTEL DEALS
      </p>
    </div>

    <!-- ================= 4. SEARCH CONSOLE (NOT CUT OFF) ================= -->
    <div class="bg-white rounded-xl shadow-2xl p-3 sm:p-4 border border-slate-200">
      <form action="/hotels" method="GET" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-12 gap-2 sm:gap-2.5 items-center">
        
        <!-- Field 1: Location -->
        <div class="col-span-1 lg:col-span-4 p-2 sm:px-3 bg-[#F5F4F3] rounded-md border border-[#d8d8d8] hover:border-[#410987] transition">
          <label class="text-[9px] font-bold uppercase text-[#410987] tracking-wider block leading-none mb-1">
            Location
          </label>
          <div class="flex items-center gap-2">
            <!-- Search Icon -->
            <svg class="w-4 h-4 text-[#410987] shrink-0" viewBox="0 0 24 24" fill="currentColor">
              <path d="M15.5 14h-.79l-.28-.27A6.471 6.471 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/>
            </svg>
            <select name="area" class="w-full text-xs sm:text-sm font-bold text-[#410987] bg-transparent outline-none cursor-pointer truncate">
              <option value="all">Location, Area (Gulshan)</option>
              <option value="gulshan-1">Gulshan 1</option>
              <option value="gulshan-2">Gulshan 2</option>
              <option value="near">Near Gulshan</option>
            </select>
          </div>
        </div>

        <!-- Field 2: Dates (Check-in & Check-out) -->
        <div class="col-span-1 lg:col-span-4 grid grid-cols-2 gap-1 bg-[#F5F4F3] rounded-md border border-[#d8d8d8] hover:border-[#410987] transition p-1">
          <div class="p-1 px-2 border-r border-[#d8d8d8]">
            <label class="text-[8px] sm:text-[9px] font-bold text-[#410987] block leading-none mb-0.5">Check-in</label>
            <div class="flex items-center gap-1">
              <svg class="w-3.5 h-3.5 text-[#410987] shrink-0" viewBox="0 0 24 24" fill="currentColor">
                <path d="M19 4h-1V2h-2v2H8V2H6v2H5c-1.11 0-1.99.9-1.99 2L3 20a2 2 0 0 0 2 2h14c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 16H5V9h14v11z"/>
              </svg>
              <span class="text-[11px] sm:text-xs text-slate-500 font-medium">Add dates</span>
            </div>
          </div>
          <div class="p-1 px-2">
            <label class="text-[8px] sm:text-[9px] font-bold text-[#410987] block leading-none mb-0.5">Check-out</label>
            <div class="flex items-center gap-1">
              <svg class="w-3.5 h-3.5 text-[#410987] shrink-0" viewBox="0 0 24 24" fill="currentColor">
                <path d="M19 4h-1V2h-2v2H8V2H6v2H5c-1.11 0-1.99.9-1.99 2L3 20a2 2 0 0 0 2 2h14c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 16H5V9h14v11z"/>
              </svg>
              <span class="text-[11px] sm:text-xs text-slate-500 font-medium">Add dates</span>
            </div>
          </div>
        </div>

        <!-- Field 3: Category / Guests -->
        <div class="col-span-1 lg:col-span-2 p-2 sm:px-3 bg-[#F5F4F3] rounded-md border border-[#d8d8d8] hover:border-[#410987] transition">
          <label class="text-[9px] font-bold uppercase text-[#410987] tracking-wider block leading-none mb-1">
            Category
          </label>
          <div class="flex items-center gap-1.5">
            <svg class="w-3.5 h-3.5 text-[#410987] shrink-0" viewBox="0 0 24 24" fill="currentColor">
              <path d="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z"/>
            </svg>
            <select name="type" class="w-full text-xs font-bold text-[#410987] bg-transparent outline-none cursor-pointer truncate">
              <option value="all">All Properties</option>
              <option value="hotel">5-Star Hotels</option>
              <option value="guesthouse">Guest Houses</option>
            </select>
          </div>
        </div>

        <!-- Button: LateRooms Golden Yellow Button -->
        <div class="col-span-1 lg:col-span-2 flex items-center">
          <button 
            type="submit" 
            class="w-full bg-[#fdd55f] hover:bg-[#eab308] text-[#410987] font-black text-sm py-3 sm:py-3.5 px-4 rounded-md shadow-sm transition-all duration-150 flex items-center justify-center cursor-pointer active:scale-98 tracking-wide"
          >
            Search
          </button>
        </div>

      </form>

      <!-- Bottom Meta Row: Compare deals & Trust Badge -->
      <div class="mt-3 pt-2.5 border-t border-slate-100 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-2 text-xs text-[#410987]">
        <label class="flex items-center gap-2 cursor-pointer font-medium select-none">
          <input type="checkbox" checked class="w-3.5 h-3.5 rounded text-[#410987] accent-[#410987] cursor-pointer" />
          <span>Compare deals on Booking.com</span>
        </label>
        <div class="flex items-center gap-1.5 text-xs">
          <!-- Shield Icon -->
          <svg class="w-4 h-4 text-[#410987]" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 1.944A11.954 11.954 0 012.166 5C2.056 5.649 2 6.319 2 7c0 5.225 3.34 9.67 8 11.317C14.66 16.67 18 12.225 18 7c0-.682-.057-1.35-.166-2.001A11.954 11.954 0 0110 1.944zM11 14a1 1 0 11-2 0 1 1 0 012 0zm0-7a1 1 0 10-2 0v3a1 1 0 102 0V7z" clip-rule="evenodd"/>
          </svg>
          <span class="text-slate-600">
            <b class="text-[#410987]">Trusted</b> by over <b class="text-[#410987]">100,000 guests</b> every year
          </span>
        </div>
      </div>

    </div>

  </div>

</section>

<!-- ================= 4. AUTOPLAY SCRIPT ================= -->
<script is:inline>
  const playHeroVideo = () => {
    const video = document.getElementById('heroBgVideo');
    if (video) {
      video.muted = true;
      const playPromise = video.play();
      if (playPromise !== undefined) {
        playPromise.catch(() => {
          const triggerPlay = () => {
            video.play();
            window.removeEventListener('scroll', triggerPlay);
            window.removeEventListener('touchstart', triggerPlay);
          };
          window.addEventListener('scroll', triggerPlay, { passive: true });
          window.addEventListener('touchstart', triggerPlay, { passive: true });
        });
      }
    }
  };

  document.addEventListener('DOMContentLoaded', playHeroVideo);
  document.addEventListener('astro:page-load', playHeroVideo);
</script>
