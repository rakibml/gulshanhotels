---
// src/components/Hero.astro (SEO Supercharged for "Gulshan Hotels" Keyword + Booking Search Widget)
---

<!-- HERO BANNER WITH SEO & SEARCH WIDGET -->
<section class="relative bg-slate-950 overflow-hidden min-h-[480px] sm:min-h-[580px] flex items-center justify-center text-left">
  
  <!-- Background Image with High-Priority SEO & LCP Loading -->
  <div class="absolute inset-0 w-full h-full">
    <img 
      src="/hero-gulshan.jpg.webp" 
      onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1512917774080-9991f1c4c750?auto=format&fit=crop&w=2000&q=85';"
      alt="Best Gulshan Hotels Dhaka - Luxury Stays & Suites" 
      fetchpriority="high"
      loading="eager"
      decoding="async"
      class="w-full h-full object-cover object-center opacity-40 scale-105 transition-transform duration-1000" 
    />
    <!-- Deep Gradient for High Contrast Readability -->
    <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/60 to-slate-900/30"></div>
  </div>

  <!-- Hero Content & Search Container -->
  <div class="relative z-10 max-w-[1280px] mx-auto w-full px-4 sm:px-6 lg:px-8 pt-12 pb-24 sm:pb-32 text-center space-y-6">
    
    <!-- Top SEO Keyword Badge -->
    <div class="inline-flex items-center gap-2 bg-emerald-500/10 border border-emerald-500/30 px-3.5 py-1.5 rounded-full backdrop-blur-md">
      <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
      <span class="text-[10px] sm:text-xs font-black uppercase tracking-[0.2em] text-emerald-400">
        Official Gulshan Hotels Directory
      </span>
    </div>

    <!-- Targeted H1 (Exact Keyword Match for Google #1 Rank) -->
    <h1 class="font-serif text-3xl sm:text-5xl md:text-6xl font-black text-white tracking-tight leading-[1.15] max-w-4xl mx-auto drop-shadow-sm">
      Find & Book the Best <span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 to-teal-200">Gulshan Hotels</span> in Dhaka
    </h1>

    <!-- SEO LSI Paragraph with Core Semantic Keywords -->
    <p class="text-xs sm:text-base text-slate-300 max-w-2xl mx-auto font-normal leading-relaxed">
      Compare verified rates for luxury 5-star hotels, boutique suites, and executive guest houses in <strong>Gulshan 1, Gulshan 2</strong>, and the Diplomatic Zone.
    </p>

    <!-- ================= BOOKING.COM STYLE HERO SEARCH WIDGET ================= -->
    <div class="max-w-3xl mx-auto bg-white p-2.5 sm:p-3 rounded-2xl sm:rounded-full shadow-2xl border border-slate-200/80">
      <form action="/hotels" method="GET" class="flex flex-col sm:flex-row items-center gap-2">
        
        <!-- Search Input -->
        <div class="flex-1 flex items-center gap-2 px-4 py-2 w-full">
          <svg class="w-4 h-4 text-slate-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
          </svg>
          <input 
            type="text" 
            name="search" 
            placeholder="Search hotel name or landmark..." 
            class="w-full text-xs sm:text-sm font-semibold text-slate-900 bg-transparent outline-none placeholder:text-slate-400"
          />
        </div>

        <!-- Area Selector Dropdown -->
        <div class="flex items-center gap-2 border-t sm:border-t-0 sm:border-l border-slate-200 px-4 py-2 w-full sm:w-auto">
          <svg class="w-4 h-4 text-emerald-700 shrink-0" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
          </svg>
          <select name="area" class="text-xs sm:text-sm font-bold text-slate-700 bg-transparent outline-none cursor-pointer w-full">
            <option value="all">All Gulshan</option>
            <option value="gulshan-1">Gulshan 1</option>
            <option value="gulshan-2">Gulshan 2</option>
            <option value="near">Near Gulshan</option>
          </select>
        </div>

        <!-- Submit Button -->
        <button 
          type="submit" 
          class="w-full sm:w-auto bg-[#006ce4] hover:bg-[#0057b8] text-white font-extrabold text-xs sm:text-sm px-6 py-3 rounded-xl sm:rounded-full shadow-md transition flex items-center justify-center gap-1.5 cursor-pointer shrink-0 active:scale-95"
        >
          <span>Find Hotels</span>
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z"/></svg>
        </button>

      </form>
    </div>

    <!-- Quick Filter Shortcut Pills (Reduces Bounce Rate) -->
    <div class="flex flex-wrap items-center justify-center gap-2 pt-1 text-xs font-bold text-slate-300">
      <span class="text-slate-400 text-[11px] uppercase tracking-wider font-semibold">Popular:</span>
      <a href="/hotels?stars=5" class="bg-white/10 hover:bg-white/20 px-3 py-1 rounded-full border border-white/10 transition backdrop-blur-xs flex items-center gap-1">
        <span class="text-[#febb02]">★</span> 5-Star Hotels
      </a>
      <a href="/hotels?area=gulshan-2" class="bg-white/10 hover:bg-white/20 px-3 py-1 rounded-full border border-white/10 transition backdrop-blur-xs">
        Gulshan 2 Diplomatic Zone
      </a>
      <a href="/hotels?type=guesthouse" class="bg-white/10 hover:bg-white/20 px-3 py-1 rounded-full border border-white/10 transition backdrop-blur-xs">
        Guest Houses
      </a>
    </div>

  </div>

  <!-- Seamless Wave Transition to Next White Section -->
  <div class="absolute -bottom-1 left-0 right-0 w-full overflow-hidden leading-none z-20 pointer-events-none">
    <svg class="relative block w-full h-8 sm:h-16 text-white fill-current" viewBox="0 0 1200 120" preserveAspectRatio="none">
      <path d="M0,0 C150,90 350,-40 500,60 C650,160 900,10 1200,40 L1200,120 L0,120 Z"></path>
    </svg>
  </div>
</section>
