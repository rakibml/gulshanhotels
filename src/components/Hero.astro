---
// src/components/Hero.astro (LateRooms Authentic Purple & Clock Visual Theme)
---

<!-- LATEROOMS STYLE HERO SECTION -->
<section class="relative bg-[#410987] overflow-hidden min-h-[480px] sm:min-h-[520px] lg:min-h-[560px] flex flex-col justify-between text-left">

  <!-- ================= 1. BACKGROUND CLOCK & GRAPHIC MOTIF ================= -->
  <div class="absolute inset-0 w-full h-full pointer-events-none overflow-hidden select-none">
    
    <!-- সূক্ষ্ম রেডিয়াল গ্রেডিয়েন্ট গ্লো -->
    <div class="absolute -top-32 -left-32 w-96 h-96 bg-[#5B23A1]/40 rounded-full blur-3xl"></div>
    <div class="absolute top-1/2 -right-24 w-80 h-80 bg-[#2A0060]/60 rounded-full blur-2xl"></div>

    <!-- LateRooms Signature Clock Dial (ঘড়ির ডায়াল ও কাটা মোটিফ) -->
    <div class="absolute top-6 left-1/2 -translate-x-1/2 sm:translate-x-0 sm:left-auto sm:right-12 lg:right-28 opacity-15 sm:opacity-20 pointer-events-none">
      <svg class="w-48 h-48 sm:w-72 sm:h-72 lg:w-96 lg:h-96 text-white" viewBox="0 0 200 200" fill="none" xmlns="http://www.w3.org/2000/svg">
        <!-- ঘড়ির বর্ডার ও দাগ -->
        <circle cx="100" cy="100" r="90" stroke="currentColor" stroke-width="3" stroke-dasharray="6 8" />
        <circle cx="100" cy="100" r="82" stroke="currentColor" stroke-width="1" opacity="0.4" />
        <!-- ঘণ্টার দাগসমূহ -->
        <line x1="100" y1="18" x2="100" y2="28" stroke="currentColor" stroke-width="3" stroke-linecap="round" />
        <line x1="100" y1="172" x2="100" y2="182" stroke="currentColor" stroke-width="3" stroke-linecap="round" />
        <line x1="18" y1="100" x2="28" y2="100" stroke="currentColor" stroke-width="3" stroke-linecap="round" />
        <line x1="172" y1="100" x2="182" y2="100" stroke="currentColor" stroke-width="3" stroke-linecap="round" />
        <!-- ঘড়ির কাঁটা (Time ticking / Last-minute vibe) -->
        <line x1="100" y1="100" x2="100" y2="45" stroke="currentColor" stroke-width="5" stroke-linecap="round" />
        <line x1="100" y1="100" x2="140" y2="80" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" />
        <circle cx="100" cy="100" r="6" fill="currentColor" />
      </svg>
    </div>
  </div>

  <!-- ================= 2. HEADLINE & TAGLINE (LATEROOMS DUAL-TONE) ================= -->
  <div class="relative z-10 max-w-[1240px] mx-auto w-full px-4 sm:px-6 lg:px-8 pt-16 sm:pt-24 pb-8 text-center sm:text-left my-auto">
    
    <!-- মূল শিরোনাম: #a38ce0 (ল্যাভেন্ডার) + #de3a68 (রাস্পবেরি পিঙ্ক) -->
    <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-black tracking-tight leading-[1.15] text-[#a38ce0]">
      Hotels in Gulshan, <span class="text-[#de3a68]">Dhaka</span>
    </h1>

    <!-- LateRooms Signature Sub-heading / Slogan -->
    <p class="text-white text-[11px] sm:text-xs md:text-sm font-semibold tracking-[0.18em] uppercase mt-2.5 sm:mt-3 opacity-95">
      THE PLACE TO BOOK LAST-MINUTE HOTEL DEALS
    </p>
  </div>

  <!-- ================= 3. LATEROOMS STYLE SEARCH WIDGET ================= -->
  <div class="relative z-30 max-w-4xl mx-auto w-full px-3 sm:px-6 lg:px-8 translate-y-1/2">
    <div class="bg-white rounded-2xl shadow-2xl p-3 sm:p-4 border border-[#d8d8d8] text-left">
      <form action="/hotels" method="GET" class="grid grid-cols-2 lg:grid-cols-12 gap-2 sm:gap-2.5 items-center">
        
        <!-- Module A: Location (LateRooms #F5F4F3 Input) -->
        <div class="col-span-1 lg:col-span-4 p-2 sm:p-2.5 sm:px-3 bg-[#F5F4F3] rounded-md border border-[#d8d8d8] hover:border-[#410987] transition">
          <label class="text-[9px] sm:text-[10px] font-bold uppercase text-[#410987] tracking-wider block leading-none mb-1 truncate">
            Location
          </label>
          <div class="flex items-center gap-1.5 sm:gap-2">
            <!-- Search Icon in LateRooms Purple -->
            <svg class="w-3.5 h-3.5 text-[#410987] shrink-0" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
            </svg>
            <select name="area" class="w-full text-[11px] sm:text-xs font-bold text-[#410987] bg-transparent outline-none cursor-pointer truncate">
              <option value="all">All Gulshan</option>
              <option value="gulshan-1">Gulshan 1</option>
              <option value="gulshan-2">Gulshan 2</option>
              <option value="near">Near Gulshan</option>
            </select>
          </div>
        </div>

        <!-- Module B: Category -->
        <div class="col-span-1 lg:col-span-4 p-2 sm:p-2.5 sm:px-3 bg-[#F5F4F3] rounded-md border border-[#d8d8d8] hover:border-[#410987] transition">
          <label class="text-[9px] sm:text-[10px] font-bold uppercase text-[#410987] tracking-wider block leading-none mb-1 truncate">
            Category
          </label>
          <div class="flex items-center gap-1.5 sm:gap-2">
            <svg class="w-3.5 h-3.5 text-[#410987] shrink-0" viewBox="0 0 24 24" fill="currentColor">
              <path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-7 3c1.66 0 3 1.34 3 3s-1.34 3-3 3-3-1.34-3-3 1.34-3 3-3zm3 10H9v-1c0-1 2-1.9 3-1.9s3 .9 3 1.9v1z"/>
            </svg>
            <select name="type" class="w-full text-[11px] sm:text-xs font-bold text-[#410987] bg-transparent outline-none cursor-pointer truncate">
              <option value="all">All Properties</option>
              <option value="hotel">5-Star Hotels</option>
              <option value="guesthouse">Guest Houses</option>
            </select>
          </div>
        </div>

        <!-- Module C: Search Button (LateRooms Yellow CTA) -->
        <div class="col-span-2 lg:col-span-4 flex items-center">
          <button 
            type="submit" 
            class="w-full bg-[#fdd55f] hover:bg-[#5B23A1] text-[#410987] hover:text-white font-black text-xs sm:text-sm py-3 sm:py-3.5 px-4 rounded-md shadow-sm transition-all duration-200 flex items-center justify-center gap-2 cursor-pointer active:scale-98 tracking-wide"
          >
            <span>Search</span>
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
              <path d="M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z"/>
            </svg>
          </button>
        </div>

      </form>

      <!-- LateRooms Extra Row: Comparison & Trust Factor -->
      <div class="mt-2.5 pt-2 border-t border-slate-100 flex flex-wrap items-center justify-between gap-2 text-[10px] sm:text-xs text-[#410987]">
        <label class="flex items-center gap-1.5 cursor-pointer font-medium hover:underline">
          <input type="checkbox" checked class="rounded text-[#410987] focus:ring-0 cursor-pointer" />
          <span>Compare deals on Booking.com</span>
        </label>
        <div class="hidden sm:flex items-center gap-1 text-slate-500">
          <svg class="w-3.5 h-3.5 text-[#410987]" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 1.944A11.954 11.954 0 012.166 5C2.056 5.649 2 6.319 2 7c0 5.225 3.34 9.67 8 11.317C14.66 16.67 18 12.225 18 7c0-.682-.057-1.35-.166-2.001A11.954 11.954 0 0110 1.944zM11 14a1 1 0 11-2 0 1 1 0 012 0zm0-7a1 1 0 10-2 0v3a1 1 0 102 0V7z" clip-rule="evenodd"/>
          </svg>
          <span>Trusted by <b>100,000+</b> guests</span>
        </div>
      </div>

    </div>
  </div>

</section>

<!-- ================= 4. AUTOPLAY SCRIPT ================= -->
<script is:inline>
  const playHeroVideo = () => {
    const video = document.getElementById('heroBgVideo');
    if (video) {
      video.muted = true;
      const playPromise = video.play();
      if (playPromise !== undefined) {
        playPromise.catch(() => {
          const triggerPlay = () => {
            video.play();
            window.removeEventListener('scroll', triggerPlay);
            window.removeEventListener('touchstart', triggerPlay);
          };
          window.addEventListener('scroll', triggerPlay, { passive: true });
          window.addEventListener('touchstart', triggerPlay, { passive: true });
        });
      }
    }
  };

  document.addEventListener('DOMContentLoaded', playHeroVideo);
  document.addEventListener('astro:page-load', playHeroVideo);
</script>
