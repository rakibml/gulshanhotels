---
// src/components/Hero.astro (Cinematic Video Background + Clean Minimalist Hero)
---

<!-- CINEMATIC HERO SECTION (ONLY H1 & SEARCH CONSOLE) -->
<section class="relative bg-slate-950 min-h-[520px] sm:min-h-[600px] lg:min-h-[640px] flex items-center justify-center overflow-hidden text-left">
  
  <!-- ================= 1. CINEMATIC BACKGROUND VIDEO ================= -->
  <div class="absolute inset-0 w-full h-full overflow-hidden pointer-events-none">
    <video 
      autoplay 
      loop 
      muted 
      playsinline 
      preload="auto"
      poster="/hero-gulshan.jpg.webp"
      class="w-full h-full object-cover object-center scale-105"
    >
      <!-- আপনার প্রজেক্টের public ফোল্ডারের ভিডিও ফাইল -->
      <source src="/hero-video.mp4" type="video/mp4" />
      <!-- প্রিভিউ/ব্যাকআপ সিনেমাটিক ভিডিও -->
      <source src="https://assets.mixkit.co/videos/preview/mixkit-city-traffic-and-buildings-at-night-4228-large.mp4" type="video/mp4" />
    </video>

    <!-- Deep Cinematic Overlay for High-Contrast Text Readability -->
    <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/60 to-slate-900/50"></div>
  </div>

  <!-- ================= 2. CLEAN HERO CONTENT (ONLY H1 & SEARCH BAR) ================= -->
  <div class="relative z-10 max-w-[1240px] mx-auto w-full px-4 sm:px-6 lg:px-8 py-16 sm:py-24 text-center space-y-6 sm:space-y-8">
    
    <!-- Bold, Royal H1 Headline -->
    <h1 class="font-serif text-3xl sm:text-5xl lg:text-6xl font-black text-white tracking-tight leading-[1.12] max-w-4xl mx-auto drop-shadow-xl">
      Hotels & Luxury Suites in Gulshan, Dhaka
    </h1>

    <!-- Structured Luxury Search Console -->
    <div class="max-w-4xl mx-auto w-full bg-white/95 backdrop-blur-md rounded-2xl shadow-2xl p-2.5 sm:p-3 border border-white/20 text-left">
      <form action="/hotels" method="GET" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-12 gap-2 items-center">
        
        <!-- Zone / Location -->
        <div class="lg:col-span-4 p-2 sm:px-3 bg-slate-50/90 rounded-xl border border-slate-200 hover:border-slate-300 transition">
          <label class="text-[9px] font-black uppercase text-slate-400 tracking-wider block leading-none mb-1">
            Zone / Location
          </label>
          <div class="flex items-center gap-2">
            <svg class="w-3.5 h-3.5 text-[#006ce4] shrink-0" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 2C8.13 2 5 5.13 5 9c0 5.2 7 13 7 13s7-7.8 7-13c0-3.9-3.1-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
            </svg>
            <select name="area" class="w-full text-xs font-bold text-slate-800 bg-transparent outline-none cursor-pointer">
              <option value="all">All Gulshan District</option>
              <option value="gulshan-1">Gulshan 1 (Commercial Hub)</option>
              <option value="gulshan-2">Gulshan 2 (Diplomatic Enclave)</option>
              <option value="near">Near Gulshan / Banani</option>
            </select>
          </div>
        </div>

        <!-- Property Category -->
        <div class="lg:col-span-4 p-2 sm:px-3 bg-slate-50/90 rounded-xl border border-slate-200 hover:border-slate-300 transition">
          <label class="text-[9px] font-black uppercase text-slate-400 tracking-wider block leading-none mb-1">
            Property Category
          </label>
          <div class="flex items-center gap-2">
            <svg class="w-3.5 h-3.5 text-emerald-700 shrink-0" viewBox="0 0 24 24" fill="currentColor">
              <path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-7 3c1.66 0 3 1.34 3 3s-1.34 3-3 3-3-1.34-3-3 1.34-3 3-3zm3 10H9v-1c0-1 2-1.9 3-1.9s3 .9 3 1.9v1z"/>
            </svg>
            <select name="type" class="w-full text-xs font-bold text-slate-800 bg-transparent outline-none cursor-pointer">
              <option value="all">All Properties</option>
              <option value="hotel">5-Star & Luxury Hotels</option>
              <option value="guesthouse">Boutique Guest Houses</option>
            </select>
          </div>
        </div>

        <!-- Search Button -->
        <div class="sm:col-span-2 lg:col-span-4 flex items-center">
          <button 
            type="submit" 
            class="w-full bg-[#003b95] hover:bg-[#002b6e] text-white font-black text-xs sm:text-sm py-3.5 px-6 rounded-xl shadow-md transition-all flex items-center justify-center gap-2 cursor-pointer active:scale-98 tracking-wide"
          >
            <span>Search Properties</span>
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
              <path d="M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z"/>
            </svg>
          </button>
        </div>

      </form>
    </div>

  </div>
</section>
