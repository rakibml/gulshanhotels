---
// src/components/Hero.astro
// Concept: Gulshan is known by its numbered roads and its lake — this hero leans into
// that local geography instead of a generic luxury-hotel video banner.
// A hand-drawn line-map of the lake + road markers replaces the video.
// The search bar is a "concierge ticket" (perforated stub) instead of a floating card.
---

<section class="relative bg-[#0B1B29] overflow-hidden">
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Piazzolla:ital,wght@0,400;0,500;0,600;1,400&family=Work+Sans:wght@400;500;600&display=swap" rel="stylesheet" />

  <div class="relative min-h-[68dvh] md:min-h-[78dvh] lg:min-h-[88vh] flex flex-col">

    <!-- ================= brass hairline, top ================= -->
    <div class="max-w-[1400px] mx-auto w-full px-5 sm:px-10 pt-6">
      <div class="h-px w-full bg-[#B08D57]/40"></div>
    </div>

    <!-- ================= LINE-MAP MOTIF ================= -->
    <!-- Mobile: compact horizontal band behind the headline area.
         Desktop (lg+): full-height panel bleeding off the right edge. -->
    <div class="pointer-events-none absolute inset-x-0 top-14 h-40 sm:h-48 lg:top-0 lg:h-full lg:inset-x-auto lg:right-0 lg:w-[52%] opacity-[0.55] lg:opacity-100">
      <svg viewBox="0 0 800 500" preserveAspectRatio="xMidYMid slice" class="w-full h-full">
        <path d="M60 250 C 160 120, 300 90, 420 160 C 540 230, 520 340, 400 380 C 280 420, 140 380, 100 300 C 80 260, 70 250, 60 250 Z"
              fill="none" stroke="#B08D57" stroke-width="2" stroke-opacity="0.55" />
        <path d="M0 40 L 800 40" stroke="#B08D57" stroke-width="1" stroke-opacity="0.25" stroke-dasharray="2 10" />
        <path d="M0 460 L 800 460" stroke="#B08D57" stroke-width="1" stroke-opacity="0.25" stroke-dasharray="2 10" />
        <path d="M180 0 L 180 500" stroke="#B08D57" stroke-width="1" stroke-opacity="0.2" stroke-dasharray="2 10" />
        <path d="M560 0 L 560 500" stroke="#B08D57" stroke-width="1" stroke-opacity="0.2" stroke-dasharray="2 10" />

        <circle cx="220" cy="180" r="5" fill="#B08D57" />
        <text x="234" y="184" fill="#D9C6A3" font-family="Work Sans, sans-serif" font-size="15">Road 11</text>

        <circle cx="470" cy="150" r="5" fill="#B08D57" />
        <text x="484" y="154" fill="#D9C6A3" font-family="Work Sans, sans-serif" font-size="15">Road 90</text>

        <circle cx="230" cy="330" r="5" fill="#B08D57" />
        <text x="244" y="334" fill="#D9C6A3" font-family="Work Sans, sans-serif" font-size="15">Lake front</text>

        <circle cx="410" cy="330" r="5" fill="#B08D57" />
        <text x="424" y="334" fill="#D9C6A3" font-family="Work Sans, sans-serif" font-size="15">Diplomatic zone</text>
      </svg>
    </div>

    <!-- ================= CONTENT ================= -->
    <div class="relative z-10 max-w-[1400px] mx-auto w-full px-5 sm:px-10 flex-1 flex flex-col justify-center pt-8 pb-10 lg:py-16">
      <div class="max-w-xl">

        <p class="text-sm sm:text-[15px] text-[#B08D57] font-medium mb-4">
          A guide to staying in Gulshan
        </p>

        <h1 class="font-serif text-[2.35rem] sm:text-5xl lg:text-[3.6rem] leading-[1.12] text-white mb-5" style="font-family: 'Piazzolla', serif; font-weight: 500;">
          Hotels along Gulshan's numbered roads
        </h1>

        <p class="text-[15px] sm:text-base leading-relaxed max-w-md text-[#AEB9C2] mb-8" style="font-family: 'Work Sans', sans-serif;">
          From Road 11 to the Diplomatic Zone, we track verified rates at every stay near the embassies and the lake.
        </p>

        <!-- ================= CONCIERGE TICKET SEARCH ================= -->
        <div class="relative">
          <div class="bg-[#F5F1E6] rounded-lg shadow-[0_20px_40px_-15px_rgba(0,0,0,0.5)]">
            <form action="/hotels" method="GET" class="flex flex-col sm:flex-row">

              <div class="flex-1 flex flex-col sm:flex-row divide-y sm:divide-y-0 sm:divide-x divide-[#0B1B29]/10">
                <label class="flex-1 px-5 py-4">
                  <span class="block text-[11px] text-[#0B1B29]/50 mb-1" style="font-family: 'Work Sans', sans-serif;">Where in Gulshan</span>
                  <select name="area" class="w-full bg-transparent text-[15px] font-medium text-[#0B1B29] outline-none" style="font-family: 'Work Sans', sans-serif;">
                    <option value="all">All Gulshan</option>
                    <option value="gulshan-1">Gulshan 1</option>
                    <option value="gulshan-2">Gulshan 2</option>
                    <option value="near">Near Gulshan</option>
                  </select>
                </label>

                <label class="flex-1 px-5 py-4">
                  <span class="block text-[11px] text-[#0B1B29]/50 mb-1" style="font-family: 'Work Sans', sans-serif;">Property type</span>
                  <select name="type" class="w-full bg-transparent text-[15px] font-medium text-[#0B1B29] outline-none" style="font-family: 'Work Sans', sans-serif;">
                    <option value="all">All properties</option>
                    <option value="hotel">5-star hotels</option>
                    <option value="guesthouse">Guest houses</option>
                  </select>
                </label>
              </div>

              <!-- perforation -->
              <div class="relative hidden sm:block w-0 border-l border-dashed border-[#0B1B29]/25 my-3">
                <span class="absolute -top-3 -left-2 w-4 h-4 rounded-full bg-[#0B1B29]"></span>
                <span class="absolute -bottom-3 -left-2 w-4 h-4 rounded-full bg-[#0B1B29]"></span>
              </div>
              <div class="relative block sm:hidden h-0 border-t border-dashed border-[#0B1B29]/25 mx-3">
                <span class="absolute -left-3 -top-2 w-4 h-4 rounded-full bg-[#0B1B29]"></span>
                <span class="absolute -right-3 -top-2 w-4 h-4 rounded-full bg-[#0B1B29]"></span>
              </div>

              <button type="submit" class="sm:w-44 px-6 py-4 bg-[#0B1B29] hover:bg-[#132C41] text-[#F5F1E6] font-medium text-[15px] transition-colors rounded-b-lg sm:rounded-b-none sm:rounded-r-lg" style="font-family: 'Work Sans', sans-serif;">
                Search hotels
              </button>
            </form>
          </div>
        </div>

      </div>
    </div>

    <!-- ================= brass hairline, bottom ================= -->
    <div class="max-w-[1400px] mx-auto w-full px-5 sm:px-10 pb-6">
      <div class="h-px w-full bg-[#B08D57]/40"></div>
    </div>

  </div>
</section>
