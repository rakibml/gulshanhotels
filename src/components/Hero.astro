---
// src/components/Hero.astro (Clean Video Background - No LateRooms Theme)
---

<section class="relative bg-slate-950 min-h-[420px] sm:min-h-[480px] lg:min-h-[520px] flex items-center justify-center text-center overflow-hidden">
  
  <!-- ================= 1. CRYSTAL CLEAR BACKGROUND VIDEO ================= -->
  <div class="absolute inset-0 w-full h-full overflow-hidden pointer-events-none">
    <video 
      id="heroBgVideo"
      autoplay 
      loop 
      muted 
      playsinline 
      preload="auto"
      poster="/hero-gulshan.jpg.webp"
      class="w-full h-full object-cover object-center scale-105 opacity-90 transition-opacity duration-700"
    >
      <source src="/hero-video.mp4.mp4" type="video/mp4" />
      <source src="/hero-video.mp4" type="video/mp4" />
      <source src="https://commondatastorage.googleapis.com/gtv-videos-bucket/sample/ForBiggerBlazes.mp4" type="video/mp4" />
    </video>

    <!-- টেক্সট সহজে পড়ার জন্য হালকা সিনেমাটিক ডার্ক ভাইনেট -->
    <div class="absolute inset-0 bg-black/40 pointer-events-none"></div>
    <div class="absolute inset-x-0 bottom-0 h-28 bg-gradient-to-t from-slate-950/80 to-transparent pointer-events-none"></div>
  </div>

  <!-- ================= 2. HEADLINE & SUBTITLE ================= -->
  <div class="relative z-10 max-w-4xl mx-auto w-full px-4 sm:px-6 lg:px-8 py-16">
    <h1 
      class="text-3xl sm:text-5xl md:text-6xl font-black text-white tracking-tight leading-[1.15]"
      style="text-shadow: 0 2px 16px rgba(0,0,0,0.9), 0 4px 30px rgba(0,0,0,0.7);"
    >
      Hotels in Gulshan, Dhaka
    </h1>
    <p 
      class="text-slate-200 text-xs sm:text-sm md:text-base font-medium tracking-wide mt-3 max-w-xl mx-auto"
      style="text-shadow: 0 1px 8px rgba(0,0,0,0.8);"
    >
      Luxury stays, 5-star hotels & guest houses in the diplomatic zone
    </p>
  </div>

</section>

<!-- ================= 3. AUTOPLAY SCRIPT ================= -->
<script is:inline>
  const playHeroVideo = () => {
    const video = document.getElementById('heroBgVideo');
    if (video) {
      video.muted = true;
      const playPromise = video.play();
      if (playPromise !== undefined) {
        playPromise.catch(() => {
          const triggerPlay = () => {
            video.play();
            window.removeEventListener('scroll', triggerPlay);
            window.removeEventListener('touchstart', triggerPlay);
          };
          window.addEventListener('scroll', triggerPlay, { passive: true });
          window.addEventListener('touchstart', triggerPlay, { passive: true });
        });
      }
    }
  };

  document.addEventListener('DOMContentLoaded', playHeroVideo);
  document.addEventListener('astro:page-load', playHeroVideo);
</script>
