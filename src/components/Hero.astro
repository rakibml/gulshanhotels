---
// src/components/Hero.astro (Real-Time Live Hotel Filter Engine)
---

<!-- Google Fonts: Bebas Neue & Montserrat -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Montserrat:wght@800;900&display=swap" rel="stylesheet">

<div class="relative w-full">

  <!-- ================= 1. HERO VIDEO SECTION ================= -->
  <section
    class="relative w-full overflow-hidden bg-slate-950 min-h-[48vh] sm:min-h-[460px] lg:min-h-[520px] flex items-center justify-center text-center"
    style="contain: layout paint style;"
  >

    <!-- GPU ACCELERATED VIDEO -->
    <div class="absolute inset-0 w-full h-full overflow-hidden pointer-events-none">
      <video
        id="heroBgVideo"
        autoplay
        loop
        muted
        playsinline
        preload="metadata"
        poster="/hero-gulshan.jpg.webp"
        disablepictureinpicture
        disableremoteplayback
        class="w-full h-full object-cover object-center opacity-100 [transform:translateZ(0)]"
      >
        <source src="/hero-video.mp4.mp4" type="video/mp4" />
      </video>
    </div>

    <!-- TYPOGRAPHY -->
    <div class="relative z-10 flex flex-col items-center justify-center select-none px-6 py-6 pb-12 sm:pb-14">
      <div class="flex flex-col items-center leading-none">

        <!-- লাইন ১: HOTELS -->
        <span
          class="font-['Bebas_Neue',sans-serif] text-6xl sm:text-8xl md:text-9xl lg:text-[120px] tracking-wider text-white"
          style="text-shadow: 0 3px 12px rgba(0,0,0,0.9);"
        >
          HOTELS
        </span>

        <!-- লাইন ২: [ ~ IN ~ ] GULSHAN -->
        <div class="flex items-center justify-center gap-2.5 sm:gap-5 -mt-2 sm:-mt-5">
          <div class="flex flex-col items-center justify-center px-1">
            <svg class="w-10 sm:w-16 md:w-20 h-2.5 sm:h-3.5 text-white fill-none stroke-current stroke-[4] sm:stroke-[4.5] stroke-linecap-round" viewBox="0 0 60 10">
              <path d="M 4 8 Q 28 1 56 6" />
            </svg>
            <span class="font-['Bebas_Neue',sans-serif] text-2xl sm:text-4xl md:text-5xl text-white italic tracking-widest leading-none -my-0.5 sm:-my-1" style="text-shadow: 0 2px 8px rgba(0,0,0,0.95);">
              IN
            </span>
            <svg class="w-10 sm:w-16 md:w-20 h-2.5 sm:h-3.5 text-white fill-none stroke-current stroke-[4] sm:stroke-[4.5] stroke-linecap-round" viewBox="0 0 60 10">
              <path d="M 4 3 Q 32 9 56 3" />
            </svg>
          </div>

          <span class="font-['Bebas_Neue',sans-serif] text-6xl sm:text-8xl md:text-9xl lg:text-[120px] tracking-wider text-white" style="text-shadow: 0 3px 12px rgba(0,0,0,0.9);">
            GULSHAN
          </span>
        </div>

        <!-- লাইন ৩: DHAKA -->
        <div class="flex items-center gap-2 sm:gap-4 mt-3 sm:mt-4">
          <span class="h-[2px] w-6 sm:w-14 bg-white/90"></span>
          <span class="font-['Montserrat',sans-serif] text-xs sm:text-sm md:text-base font-black tracking-[0.4em] sm:tracking-[0.5em] text-white uppercase" style="text-shadow: 0 2px 8px rgba(0,0,0,0.95);">
            DHAKA
          </span>
          <span class="h-[2px] w-6 sm:w-14 bg-white/90"></span>
        </div>

      </div>
    </div>

    <!-- VIGNETTE & FRAMES -->
    <div class="absolute inset-0 pointer-events-none z-20">
      <div class="absolute top-0 left-0 w-full h-16 sm:h-24 bg-gradient-to-b from-black/45 to-transparent"></div>
      <div class="absolute bottom-0 left-0 w-full h-20 sm:h-28 bg-gradient-to-t from-black/60 to-transparent"></div>

      <div class="absolute top-4 left-4 sm:top-6 sm:left-6 w-8 sm:w-10 h-8 sm:h-10 border-t border-l border-white/55"></div>
      <div class="absolute top-4 right-4 sm:top-6 sm:right-6 w-8 sm:w-10 h-8 sm:h-10 border-t border-r border-white/55"></div>
      <div class="absolute bottom-4 left-4 sm:bottom-6 sm:left-6 w-8 sm:w-10 h-8 sm:h-10 border-b border-l border-white/55"></div>
      <div class="absolute bottom-4 right-4 sm:bottom-6 sm:right-6 w-8 sm:w-10 h-8 sm:h-10 border-b border-r border-white/55"></div>
    </div>

  </section>

  <!-- ================= 2. MINIMALIST CAPSULE SEARCH BAR ================= -->
  <div class="relative z-30 max-w-3xl mx-auto px-4 -mt-7 sm:-mt-8 mb-6">
    <form 
      id="heroHotelSearchForm" 
      class="bg-white rounded-full p-2 pl-5 sm:pl-6 border border-slate-200/90 shadow-lg flex items-center justify-between gap-3 transition-all hover:border-slate-400 text-left"
    >
      
      <!-- 1. Search Query Input -->
      <div class="flex-1 flex items-center gap-3 min-w-0">
        <svg class="w-4 h-4 text-emerald-800 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
        <div class="flex flex-col min-w-0 flex-1">
          <span class="text-[9px] font-black uppercase tracking-wider text-slate-400 hidden sm:block">Destination / Hotel</span>
          <input 
            type="text" 
            id="searchHotelInput"
            placeholder="Search hotel name, Gulshan 1, Gulshan 2..." 
            class="w-full bg-transparent text-xs sm:text-sm font-bold text-slate-900 placeholder-slate-400 outline-none truncate"
            autocomplete="off"
          />
        </div>
      </div>

      <!-- Subtle Divider -->
      <div class="hidden sm:block w-px h-7 bg-slate-200 shrink-0"></div>

      <!-- 2. Clean Type Selector -->
      <div class="hidden sm:flex flex-col shrink-0 pr-2">
        <span class="text-[9px] font-black uppercase tracking-wider text-slate-400">Property</span>
        <select id="searchTypeSelect" class="bg-transparent text-xs sm:text-sm font-bold text-slate-800 outline-none cursor-pointer">
          <option value="all">All Stays</option>
          <option value="luxury">5-Star Luxury</option>
          <option value="boutique">Boutique Stays</option>
          <option value="guest-house">Guest Houses</option>
        </select>
      </div>

      <!-- 3. Minimal Round Search Button -->
      <button 
        type="submit" 
        class="bg-[#0d3b23] hover:bg-[#061e14] text-white font-extrabold text-xs sm:text-sm px-5 sm:px-6 py-3 rounded-full transition shrink-0 flex items-center gap-2 cursor-pointer shadow-xs active:scale-95"
      >
        <span>Search</span>
        <span class="text-xs">➔</span>
      </button>

    </form>
  </div>

</div>

<!-- ================= 3. CLIENT SCRIPT (REAL-TIME LIVE HOTEL FILTER) ================= -->
<script is:inline>
  (() => {
    // 1. Video Autoplay Logic
    const video = document.getElementById('heroBgVideo');
    if (video) {
      let started = false;
      const playHeroVideo = () => {
        if (started) return;
        video.muted = true;
        const playPromise = video.play();
        if (playPromise !== undefined) {
          playPromise
            .then(() => { started = true; })
            .catch(() => {
              const triggerPlay = () => {
                video.play();
                started = true;
                window.removeEventListener('scroll', triggerPlay);
                window.removeEventListener('touchstart', triggerPlay);
              };
              window.addEventListener('scroll', triggerPlay, { passive: true, once: true });
              window.addEventListener('touchstart', triggerPlay, { passive: true, once: true });
            });
        } else {
          started = true;
        }
      };

      if ('IntersectionObserver' in window) {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                if (started) video.play().catch(() => {});
              } else {
                video.pause();
              }
            });
          },
          { threshold: 0.01 }
        );
        observer.observe(video);
      }

      document.addEventListener('visibilitychange', () => {
        if (document.hidden) {
          video.pause();
        } else if (started) {
          video.play().catch(() => {});
        }
      });

      if (document.readyState === 'complete') {
        playHeroVideo();
      } else {
        window.addEventListener('load', playHeroVideo, { passive: true, once: true });
      }
      document.addEventListener('astro:page-load', playHeroVideo);
    }

    // 2. REAL LIVE HOTEL FILTER LOGIC
    const setupLiveFilter = () => {
      const form = document.getElementById('heroHotelSearchForm');
      const input = document.getElementById('searchHotelInput');
      const typeSelect = document.getElementById('searchTypeSelect');

      if (!form || form.dataset.filterReady) return;
      form.dataset.filterReady = 'true';

      const performSearch = (e) => {
        if (e) e.preventDefault();

        const query = (input?.value || '').trim().toLowerCase();
        const propertyType = (typeSelect?.value || 'all').toLowerCase();

        // PopularHotels এবং TopDeals-এর সব হোটেল কার্ড ধরা হচ্ছে
        const hotelCards = document.querySelectorAll('.popular-card-item, .deal-card-item');
        let matchedCount = 0;

        hotelCards.forEach(card => {
          const cardText = (card.textContent || '').toLowerCase();
          const cardTitle = (card.querySelector('h3')?.textContent || '').toLowerCase();

          // ১. টেক্সট ম্যাচিং (নাম বা লোকেশন)
          const matchesQuery = !query || cardTitle.includes(query) || cardText.includes(query);

          // ২. প্রপার্টি টাইপ ম্যাচিং
          let matchesType = true;
          if (propertyType === 'luxury') {
            matchesType = cardTitle.includes('westin') || cardTitle.includes('amari') || cardTitle.includes('renaissance') || cardText.includes('5-star') || cardText.includes('luxury');
          } else if (propertyType === 'boutique') {
            matchesType = cardTitle.includes('midori') || cardTitle.includes('lakeshore') || cardText.includes('boutique');
          } else if (propertyType === 'guest-house') {
            matchesType = cardTitle.includes('guest') || cardTitle.includes('house') || cardText.includes('guest house');
          }

          if (matchesQuery && matchesType) {
            card.style.display = 'flex';
            matchedCount++;
          } else {
            card.style.display = 'none';
          }
        });

        // রেজাল্ট ফিডব্যাক বার দেখানো
        let feedbackBanner = document.getElementById('liveSearchBanner');
        const track = document.getElementById('popularHotelsTrack') || document.getElementById('hotels');

        if (!feedbackBanner && track) {
          feedbackBanner = document.createElement('div');
          feedbackBanner.id = 'liveSearchBanner';
          feedbackBanner.className = 'w-full max-w-[1550px] mx-auto px-4 sm:px-8 lg:px-12 my-3';
          track.parentNode.insertBefore(feedbackBanner, track);
        }

        if (feedbackBanner) {
          if (query || propertyType !== 'all') {
            feedbackBanner.innerHTML = `
              <div class="bg-emerald-50 border border-emerald-200 p-3 sm:p-3.5 rounded-2xl flex items-center justify-between text-xs sm:text-sm text-emerald-950 font-bold">
                <span>
                  Found <strong class="text-emerald-900">${matchedCount} hotel(s)</strong> matching "${query || propertyType}"
                </span>
                <button 
                  id="resetSearchBtn" 
                  type="button" 
                  class="bg-white hover:bg-emerald-100 text-emerald-900 border border-emerald-300 px-3 py-1.5 rounded-xl text-xs font-black uppercase transition cursor-pointer"
                >
                  Clear Search ✕
                </button>
              </div>
            `;
            feedbackBanner.classList.remove('hidden');

            document.getElementById('resetSearchBtn')?.addEventListener('click', () => {
              if (input) input.value = '';
              if (typeSelect) typeSelect.value = 'all';
              feedbackBanner.classList.add('hidden');
              hotelCards.forEach(c => c.style.display = 'flex');
            });
          } else {
            feedbackBanner.classList.add('hidden');
          }
        }

        // মসৃণ স্ক্রোলিং
        const targetSection = document.getElementById('hotels');
        if (targetSection) {
          targetSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      };

      form.addEventListener('submit', performSearch);
      
      // অপশন পরিবর্তন করলে স্বয়ংক্রিয় ফিল্টার
      if (typeSelect) {
        typeSelect.addEventListener('change', performSearch);
      }
    };

    document.addEventListener('DOMContentLoaded', setupLiveFilter);
    document.addEventListener('astro:page-load', setupLiveFilter);
  })();
</script>
