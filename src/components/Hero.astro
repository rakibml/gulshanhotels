---
// src/components/Hero.astro (LateRooms Theme + Subtle Video + No Search Bar)
---

<section class="relative w-full overflow-hidden bg-[#160136] text-left flex items-center min-h-[380px] sm:min-h-[440px] lg:min-h-[500px]">
  
  <!-- ================= 1. SUBTLE BACKGROUND VIDEO & LATEROOMS GRADIENT ================= -->
  <div class="absolute inset-0 w-full h-full overflow-hidden pointer-events-none">
    <!-- ব্যাকগ্রাউন্ডে হালকা ভিডিও -->
    <video 
      id="heroBgVideo"
      autoplay 
      loop 
      muted 
      playsinline 
      preload="auto"
      poster="/hero-gulshan.jpg.webp"
      class="w-full h-full object-cover object-center scale-105 opacity-30 mix-blend-screen transition-opacity duration-700"
    >
      <source src="/hero-video.mp4.mp4" type="video/mp4" />
      <source src="/hero-video.mp4" type="video/mp4" />
      <source src="https://commondatastorage.googleapis.com/gtv-videos-bucket/sample/ForBiggerBlazes.mp4" type="video/mp4" />
    </video>

    <!-- LateRooms Signature Deep Gradient Overlay -->
    <div 
      class="absolute inset-0 pointer-events-none"
      style="background: radial-gradient(circle at 12% 40%, rgba(110, 56, 188, 0.5) 0%, transparent 45%), radial-gradient(circle at 92% 50%, rgba(132, 41, 158, 0.4) 0%, transparent 40%), linear-gradient(105deg, rgba(79, 21, 140, 0.92) 0%, rgba(32, 2, 68, 0.88) 35%, rgba(18, 0, 54, 0.85) 60%, rgba(45, 4, 82, 0.9) 85%, rgba(104, 21, 133, 0.92) 100%);"
    ></div>

    <!-- বাম পাশের ডায়াগনাল সফট লাইট গ্লো -->
    <div class="absolute -top-24 -left-20 w-[480px] h-[480px] bg-[#7c2fd3]/25 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute bottom-0 -left-10 w-72 h-72 bg-[#57199c]/30 rounded-full blur-2xl pointer-events-none"></div>

    <!-- ডান পাশের বোকেহ লাইট -->
    <div class="absolute top-1/4 right-0 w-80 h-80 bg-[#a232b8]/25 rounded-full blur-3xl pointer-events-none"></div>
  </div>

  <!-- ================= 2. LATEROOMS CLOCK MOTIF (PINK HANDS) ================= -->
  <div class="absolute top-1/2 -translate-y-1/2 right-1/2 translate-x-1/2 sm:translate-x-0 sm:right-10 lg:right-28 w-[320px] h-[320px] sm:w-[420px] sm:h-[420px] lg:w-[500px] lg:h-[500px] pointer-events-none opacity-40 sm:opacity-55 lg:opacity-65 select-none">
    <svg viewBox="0 0 400 400" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full h-full">
      <!-- ১২টি আওয়ার ক্যাপসুল দাগ -->
      <line x1="200" y1="40" x2="200" y2="72" stroke="#a38ce0" stroke-width="11" stroke-linecap="round" opacity="0.45" />
      <line x1="280" y1="61" x2="264" y2="89" stroke="#a38ce0" stroke-width="11" stroke-linecap="round" opacity="0.45" />
      <line x1="339" y1="120" x2="311" y2="136" stroke="#a38ce0" stroke-width="11" stroke-linecap="round" opacity="0.45" />
      <line x1="360" y1="200" x2="328" y2="200" stroke="#a38ce0" stroke-width="11" stroke-linecap="round" opacity="0.45" />
      <line x1="339" y1="280" x2="311" y2="264" stroke="#a38ce0" stroke-width="11" stroke-linecap="round" opacity="0.45" />
      <line x1="280" y1="339" x2="264" y2="311" stroke="#a38ce0" stroke-width="11" stroke-linecap="round" opacity="0.45" />
      <line x1="200" y1="360" x2="200" y2="328" stroke="#a38ce0" stroke-width="11" stroke-linecap="round" opacity="0.45" />
      <line x1="120" y1="339" x2="136" y2="311" stroke="#a38ce0" stroke-width="11" stroke-linecap="round" opacity="0.45" />
      <line x1="61" y1="280" x2="89" y2="264" stroke="#a38ce0" stroke-width="11" stroke-linecap="round" opacity="0.45" />
      <line x1="40" y1="200" x2="72" y2="200" stroke="#a38ce0" stroke-width="11" stroke-linecap="round" opacity="0.45" />
      <line x1="61" y1="120" x2="89" y2="136" stroke="#a38ce0" stroke-width="11" stroke-linecap="round" opacity="0.45" />
      <line x1="120" y1="61" x2="136" y2="89" stroke="#a38ce0" stroke-width="11" stroke-linecap="round" opacity="0.45" />

      <!-- ঘণ্টার কাঁটা (১০:২০ বরাবর) -->
      <line x1="184" y1="184" x2="148" y2="148" stroke="#de3a68" stroke-width="13" stroke-linecap="round" />

      <!-- মিনিটের কাঁটা (১:৪৫ বরাবর) -->
      <line x1="214" y1="186" x2="268" y2="132" stroke="#de3a68" stroke-width="13" stroke-linecap="round" />

      <!-- সেন্টারের পিঙ্ক ডট -->
      <circle cx="200" cy="200" r="8" fill="#de3a68" />
    </svg>
  </div>

  <!-- ================= 3. HEADLINE CONTENT ================= -->
  <div class="relative z-10 max-w-6xl mx-auto w-full px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
    <div class="max-w-2xl text-center sm:text-left">
      <h1 class="text-3xl sm:text-5xl md:text-6xl font-black tracking-tight leading-tight text-[#a38ce0]">
        Hotels in Gulshan, <span class="text-[#de3a68]">Dhaka</span>
      </h1>
      <p class="text-white text-xs sm:text-sm font-semibold italic tracking-[0.16em] uppercase mt-3 opacity-95">
        THE PLACE TO BOOK LAST-MINUTE HOTEL DEALS
      </p>
    </div>
  </div>

</section>

<!-- ================= 4. AUTOPLAY SCRIPT ================= -->
<script is:inline>
  const playHeroVideo = () => {
    const video = document.getElementById('heroBgVideo');
    if (video) {
      video.muted = true;
      const playPromise = video.play();
      if (playPromise !== undefined) {
        playPromise.catch(() => {
          const triggerPlay = () => {
            video.play();
            window.removeEventListener('scroll', triggerPlay);
            window.removeEventListener('touchstart', triggerPlay);
          };
          window.addEventListener('scroll', triggerPlay, { passive: true });
          window.addEventListener('touchstart', triggerPlay, { passive: true });
        });
      }
    }
  };

  document.addEventListener('DOMContentLoaded', playHeroVideo);
  document.addEventListener('astro:page-load', playHeroVideo);
</script>
