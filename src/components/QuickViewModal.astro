---
// src/components/QuickViewModal.astro (Floating Animated Scroll-Cue Pill & Dynamic Policies)
---

<!-- QUICK VIEW GLOBAL MODAL OVERLAY -->
<div 
  id="globalQuickViewModal" 
  role="dialog" 
  aria-modal="true" 
  class="fixed inset-0 z-[99999] bg-slate-950/80 backdrop-blur-sm hidden flex items-center justify-center p-3 sm:p-4 pt-8 sm:pt-10 overflow-y-auto"
  style="z-index: 99999 !important;"
>
  <!-- MODAL DIALOG CONTAINER -->
  <div 
    id="quickViewDialog"
    class="bg-white rounded-2xl sm:rounded-3xl border border-slate-200/90 w-full max-w-xl md:max-w-2xl shadow-2xl my-auto relative text-left flex flex-col max-h-[88vh] transition-all duration-300 scale-95 opacity-0 overflow-visible"
    style="z-index: 100000 !important;"
  >
    <!-- ================= 1. TOP-CENTER HIGHLIGHTED CLOSE BUTTON ================= -->
    <button 
      type="button" 
      id="closeQvModalBtn" 
      class="absolute -top-5 sm:-top-6 left-1/2 -translate-x-1/2 z-50 w-11 h-11 sm:w-12 sm:h-12 rounded-full bg-white text-slate-900 hover:bg-rose-600 hover:text-white border-2 border-slate-300 hover:border-rose-600 shadow-2xl flex items-center justify-center transition-all cursor-pointer hover:scale-110 active:scale-95"
      aria-label="Close Quick View"
    >
      <svg class="w-5 h-5 sm:w-6 sm:h-6 stroke-current" fill="none" viewBox="0 0 24 24" stroke-width="2.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>

    <!-- ================= SCROLLABLE BODY ================= -->
    <div id="qvScrollBody" class="overflow-y-auto flex-1 p-4 sm:p-6 space-y-4 sm:space-y-5 rounded-2xl sm:rounded-3xl scroll-smooth">
      
      <!-- 2. 5-IMAGE CAROUSEL SLIDER -->
      <div class="relative w-full h-52 sm:h-64 rounded-xl sm:rounded-2xl overflow-hidden bg-slate-900 shrink-0 shadow-inner group">
        <img 
          id="qvModalImg" 
          src="" 
          alt="Hotel Preview" 
          class="w-full h-full object-cover transition duration-300"
        />

        <!-- Controls -->
        <button 
          type="button" 
          id="qvPrevImgBtn" 
          class="absolute left-2.5 top-1/2 -translate-y-1/2 w-8 h-8 rounded-full bg-slate-950/70 hover:bg-slate-950 text-white text-sm font-black flex items-center justify-center backdrop-blur-md transition cursor-pointer shadow opacity-90 hover:scale-105"
          aria-label="Previous Photo"
        >
          ❮
        </button>
        <button 
          type="button" 
          id="qvNextImgBtn" 
          class="absolute right-2.5 top-1/2 -translate-y-1/2 w-8 h-8 rounded-full bg-slate-950/70 hover:bg-slate-950 text-white text-sm font-black flex items-center justify-center backdrop-blur-md transition cursor-pointer shadow opacity-90 hover:scale-105"
          aria-label="Next Photo"
        >
          ❯
        </button>

        <!-- Counter Badge -->
        <span 
          id="qvImgBadge" 
          class="absolute bottom-2.5 right-3 bg-slate-950/80 backdrop-blur-md text-white text-[10px] font-extrabold px-2.5 py-0.5 rounded-full border border-white/20 tracking-wider pointer-events-none"
        >
          1 / 1
        </span>
      </div>

      <!-- 3. HOTEL NAME & RATING -->
      <div class="space-y-1">
        <div class="flex items-start justify-between gap-3">
          <div>
            <h3 id="qvHotelTitle" class="text-lg sm:text-2xl font-black text-slate-900 leading-tight">
              Hotel Title
            </h3>
            <div id="qvStarsContainer" class="text-[#febb02] text-xs sm:text-sm tracking-tight mt-0.5"></div>
          </div>
          <div id="qvRatingBox" class="shrink-0 text-right"></div>
        </div>

        <div class="flex items-start gap-1.5 text-xs text-slate-600 font-medium pt-1">
          <svg class="w-3.5 h-3.5 fill-slate-700 shrink-0 mt-0.5" viewBox="0 0 24 24"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>
          <span id="qvAddress" class="leading-snug">Address</span>
        </div>
      </div>

      <!-- 4. 100% DYNAMIC HOTEL POLICIES & ESSENTIAL INFO -->
      <div id="qvPoliciesSection" class="pt-3 border-t border-slate-100 space-y-2.5 hidden">
        <h4 class="text-[11px] font-black uppercase tracking-wider text-slate-500">
          Hotel Policies & Essential Info
        </h4>

        <div id="qvPoliciesGrid" class="grid grid-cols-2 sm:grid-cols-3 gap-2.5 sm:gap-3 text-left">
          <!-- Dynamically Injected from Card Data -->
        </div>
      </div>

      <!-- 5. PRICING & BOOKING CHANNELS -->
      <div id="qvBookingSection" class="pt-2 border-t border-slate-100 space-y-3">
        <div class="flex items-center justify-between">
          <span class="text-xs sm:text-sm font-black text-slate-900">Where can you book this hotel?</span>
          <div class="text-right">
            <span class="text-[10px] text-slate-400 uppercase font-bold block leading-none">Starting from</span>
            <span id="qvPrice" class="text-base sm:text-lg font-black text-[#008234]">৳ 0</span>
          </div>
        </div>

        <div id="qvChannelsContainer" class="space-y-2 pb-2"></div>
      </div>

    </div>

    <!-- ================= SOFT BOTTOM FADE SHADOW ================= -->
    <div 
      id="qvScrollFade" 
      class="absolute bottom-[66px] sm:bottom-[72px] inset-x-0 h-12 bg-gradient-to-t from-white via-white/80 to-transparent pointer-events-none z-30 transition-opacity duration-300"
    ></div>

    <!-- ================= FLOATING ANIMATED 'SCROLL FOR MORE' PILL ================= -->
    <button 
      type="button" 
      id="qvScrollCueBtn" 
      class="absolute bottom-[76px] sm:bottom-[82px] left-1/2 -translate-x-1/2 z-40 bg-slate-900/90 hover:bg-slate-950 text-white text-[11px] sm:text-xs font-black py-1.5 px-3.5 rounded-full shadow-2xl border border-white/20 backdrop-blur-md flex items-center gap-1.5 transition-all duration-300 animate-bounce cursor-pointer hover:scale-105 active:scale-95"
      aria-label="Scroll down for booking channels"
    >
      <span>Scroll for booking options</span>
      <svg class="w-3.5 h-3.5 fill-current shrink-0" viewBox="0 0 24 24">
        <path d="M7.41 8.59L12 13.17l4.59-4.58L18 10l-6 6-6-6 1.41-1.41z"/>
      </svg>
    </button>

    <!-- ================= 6. VIEW FULL DETAILS FOOTER BUTTON ================= -->
    <div class="p-3.5 sm:p-4 bg-slate-50 border-t border-slate-200/80 shrink-0 rounded-b-2xl sm:rounded-b-3xl relative z-40">
      <a 
        id="qvFullDetailsBtn" 
        href="#" 
        class="w-full bg-[#006ce4] hover:bg-[#0057b8] text-white font-bold text-xs sm:text-sm py-2.5 sm:py-3 px-4 rounded-xl transition flex items-center justify-center gap-2 shadow-xs hover:shadow text-center"
      >
        <span>View Full Hotel Details & Photos</span>
        <span class="text-base font-bold">➔</span>
      </a>
    </div>

  </div>
</div>

<!-- ================= CLIENT JAVASCRIPT ================= -->
<script is:inline>
  const setupQuickViewSystem = () => {
    const modal = document.getElementById('globalQuickViewModal');
    const dialog = document.getElementById('quickViewDialog');
    const closeBtn = document.getElementById('closeQvModalBtn');
    const scrollBody = document.getElementById('qvScrollBody');
    const scrollCueBtn = document.getElementById('qvScrollCueBtn');
    const scrollFade = document.getElementById('qvScrollFade');

    if (!modal || !dialog) return;

    const imgEl = document.getElementById('qvModalImg');
    const prevBtn = document.getElementById('qvPrevImgBtn');
    const nextBtn = document.getElementById('qvNextImgBtn');
    const badgeEl = document.getElementById('qvImgBadge');
    
    const titleEl = document.getElementById('qvHotelTitle');
    const starsEl = document.getElementById('qvStarsContainer');
    const ratingBox = document.getElementById('qvRatingBox');
    const addressEl = document.getElementById('qvAddress');

    // Dynamic Policy Elements
    const policiesSection = document.getElementById('qvPoliciesSection');
    const policiesGrid = document.getElementById('qvPoliciesGrid');

    const priceEl = document.getElementById('qvPrice');
    const channelsContainer = document.getElementById('qvChannelsContainer');
    const fullDetailsBtn = document.getElementById('qvFullDetailsBtn');

    let currentImages = [];
    let currentImgIdx = 0;
    let isModalOpen = false;

    // Smart Policy Icon Generator (Auto-Icon Matcher)
    const getPolicyIcon = (label) => {
      const l = (label || '').toLowerCase();
      if (l.includes('check-in') || l.includes('arrival') || l.includes('time')) {
        return `<svg class="w-3.5 h-3.5 fill-slate-800" viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67z"/></svg>`;
      }
      if (l.includes('check-out') || l.includes('departure')) {
        return `<svg class="w-3.5 h-3.5 fill-slate-700" viewBox="0 0 24 24"><path d="M19 3H5c-1.11 0-2 .9-2 2v14c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16H5V5h14v14zm-5-7h-3v3H9v-3H6v-2h3V7h2v3h3z"/></svg>`;
      }
      if (l.includes('reception') || l.includes('front desk') || l.includes('desk') || l.includes('open until')) {
        return `<svg class="w-3.5 h-3.5 fill-slate-800" viewBox="0 0 24 24"><path d="M12 2a1 1 0 0 1 1 1v1.07A7.002 7.002 0 0 1 19 11v1a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1v-1a7.002 7.002 0 0 1 6-6.93V3a1 1 0 0 1 1-1zm-7 13h14a1 1 0 0 1 1 1v2a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1v-2a1 1 0 0 1 1-1z"/></svg>`;
      }
      if (l.includes('voltage') || l.includes('plug') || l.includes('socket') || l.includes('220')) {
        return `<svg class="w-3.5 h-3.5 fill-slate-800" viewBox="0 0 24 24"><path d="M16 7V3h-2v4h-4V3H8v4a6 6 0 0 0 5 5.91V19h-2v2h6v-2h-2v-6.09A6 6 0 0 0 16 7z"/></svg>`;
      }
      if (l.includes('power') || l.includes('generator') || l.includes('electricity') || l.includes('backup')) {
        return `<svg class="w-3.5 h-3.5 fill-emerald-800" viewBox="0 0 24 24"><path d="M7 2v11h3v9l7-12h-4l4-8z"/></svg>`;
      }
      if (l.includes('smoke') || l.includes('smoking')) {
        return `<svg class="w-3.5 h-3.5 fill-slate-700" viewBox="0 0 24 24"><path d="M14.5 9H18c.83 0 1.5.67 1.5 1.5v2c0 .83-.67 1.5-1.5 1.5h-3.5V9zM2 10h11.5v3H2v-3zm18 0c.28 0 .5.22.5.5v2c0 .28-.22.5-.5.5s-.5-.22-.5-.5v-2c0-.28.22-.5.5-.5z"/></svg>`;
      }
      if (l.includes('couple') || l.includes('guest') || l.includes('id') || l.includes('marriage')) {
        return `<svg class="w-3.5 h-3.5 fill-slate-800" viewBox="0 0 24 24"><path d="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z"/></svg>`;
      }
      if (l.includes('pay') || l.includes('bkash') || l.includes('card') || l.includes('cash')) {
        return `<svg class="w-3.5 h-3.5 fill-emerald-800" viewBox="0 0 24 24"><path d="M20 4H4c-1.11 0-1.99.89-1.99 2L2 18c0 1.11.89 2 2 2h16c1.11 0 2-.89 2-2V6c0-1.11-.89-2-2-2zm0 14H4v-6h16v6zm0-10H4V6h16v2z"/></svg>`;
      }
      if (l.includes('cancel') || l.includes('refund')) {
        return `<svg class="w-3.5 h-3.5 fill-emerald-800" viewBox="0 0 24 24"><path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm-2 16l-4-4 1.41-1.41L10 14.17l6.59-6.59L18 9l-8 8z"/></svg>`;
      }
      if (l.includes('pet')) {
        return `<svg class="w-3.5 h-3.5 fill-slate-700" viewBox="0 0 24 24"><path d="M4.5 11c1.38 0 2.5-1.12 2.5-2.5S5.88 6 4.5 6 2 7.12 2 8.5 3.12 11 4.5 11zm15 0c1.38 0 2.5-1.12 2.5-2.5S20.88 6 19.5 6 17 7.12 17 8.5s1.12 2.5 2.5 2.5zm-6.5-3c1.38 0 2.5-1.12 2.5-2.5S14.38 3 13 3s-2.5 1.12-2.5 2.5S11.62 8 13 8zm-5 0c1.38 0 2.5-1.12 2.5-2.5S9.38 3 8 3 5.5 4.12 5.5 5.5 6.62 8 8 8zm4 3.5c-2.33 0-4.31 1.46-5.11 3.5h10.22c-.8-2.04-2.78-3.5-5.11-3.5zM12 18.5c-1.38 0-2.5-1.12-2.5-2.5h5c0 1.38-1.12 2.5-2.5 2.5z"/></svg>`;
      }
      return `<svg class="w-3.5 h-3.5 fill-slate-700" viewBox="0 0 24 24"><path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-7 3c1.66 0 3 1.34 3 3s-1.34 3-3 3-3-1.34-3-3 1.34-3 3-3zm3 10H9v-1c0-1 2-1.9 3-1.9s3 .9 3 1.9v1z"/></svg>`;
    };

    const presetSvgs = {
      agoda: `<div class="w-7 h-7 rounded-lg bg-[#1d3557] text-white font-black text-[9px] flex items-center justify-center shrink-0 tracking-tighter"><span class="text-rose-400 font-serif italic text-xs">a</span>goda</div>`,
      booking: `<div class="w-7 h-7 rounded-lg bg-[#003580] text-white font-black text-[10px] flex items-center justify-center shrink-0 shadow-xs">B.</div>`,
      expedia: `<div class="w-7 h-7 rounded-lg bg-[#ffe600] text-slate-950 font-black text-xs flex items-center justify-center shrink-0"><svg class="w-3.5 h-3.5 fill-slate-950" viewBox="0 0 24 24"><path d="M21 16v-2l-8-5V3.5c0-.83-.67-1.5-1.5-1.5S10 2.67 10 3.5V9l-8 5v2l8-2.5V19l-2 1.5V22l3.5-1 3.5 1v-1.5L13 19v-5.5l8 2.5z"/></svg></div>`,
      direct: `<div class="w-7 h-7 rounded-lg bg-emerald-100 text-emerald-900 flex items-center justify-center shrink-0"><svg class="w-3.5 h-3.5 fill-emerald-800" viewBox="0 0 24 24"><path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-7 3c1.66 0 3 1.34 3 3s-1.34 3-3 3-3-1.34-3-3 1.34-3 3-3zm3 10H9v-1c0-1 2-1.9 3-1.9s3 .9 3 1.9v1z"/></svg></div>`,
      whatsapp: `<div class="w-7 h-7 rounded-lg bg-[#25D366] text-white flex items-center justify-center shrink-0 shadow-xs"><svg class="w-3.5 h-3.5 fill-white" viewBox="0 0 24 24"><path d="M12.012 2c-5.506 0-9.989 4.478-9.99 9.984 0 1.763.459 3.48 1.332 5.001l-1.416 5.163 5.281-1.388c1.464.798 3.118 1.22 4.79 1.22h.004c5.506 0 9.989-4.478 9.99-9.984 0-2.668-1.038-5.176-2.923-7.062a9.923 9.923 0 0 0-7.058-2.934z"/></svg></div>`,
      phone: `<div class="w-7 h-7 rounded-lg bg-slate-800 text-white flex items-center justify-center shrink-0"><svg class="w-3.5 h-3.5 fill-white" viewBox="0 0 24 24"><path d="M6.62 10.79c1.44 2.83 2.62 4.2 5.45 5.64l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/></svg></div>`
    };

    function showPhoto(idx) {
      if (!currentImages.length) return;
      currentImgIdx = (idx + currentImages.length) % currentImages.length;
      imgEl.src = currentImages[currentImgIdx];
      badgeEl.textContent = `${currentImgIdx + 1} / ${currentImages.length}`;
    }

    if (prevBtn) prevBtn.onclick = () => showPhoto(currentImgIdx - 1);
    if (nextBtn) nextBtn.onclick = () => showPhoto(currentImgIdx + 1);

    // ================= DYNAMIC SCROLL CUE HANDLER =================
    function updateScrollCue() {
      if (!scrollBody || !scrollCueBtn) return;
      
      const distanceToBottom = scrollBody.scrollHeight - scrollBody.scrollTop - scrollBody.clientHeight;
      const canScroll = scrollBody.scrollHeight > scrollBody.clientHeight + 40;

      // যদি স্ক্রল করার মতো তথ্য থাকে এবং ইউজার এখনও নিচে না গিয়ে থাকে
      if (canScroll && distanceToBottom > 45) {
        scrollCueBtn.classList.remove('opacity-0', 'pointer-events-none');
        scrollCueBtn.classList.add('opacity-100');
        if (scrollFade) {
          scrollFade.classList.remove('opacity-0');
          scrollFade.classList.add('opacity-100');
        }
      } else {
        // নিচে নামার সাথে সাথেই বাটন ও ছায়া ফেড-আউট হয়ে যাবে
        scrollCueBtn.classList.remove('opacity-100');
        scrollCueBtn.classList.add('opacity-0', 'pointer-events-none');
        if (scrollFade) {
          scrollFade.classList.remove('opacity-100');
          scrollFade.classList.add('opacity-0');
        }
      }
    }

    if (scrollBody) {
      scrollBody.addEventListener('scroll', updateScrollCue, { passive: true });
    }

    // স্ক্রল বাটনে চাপ দিলে অটোমেটিক নিচে বুকিং অপশনে নিয়ে যাবে
    if (scrollCueBtn) {
      scrollCueBtn.addEventListener('click', () => {
        const bookingSection = document.getElementById('qvBookingSection');
        if (bookingSection) {
          bookingSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
        } else if (scrollBody) {
          scrollBody.scrollBy({ top: 250, behavior: 'smooth' });
        }
      });
    }

    // ================= OPEN MODAL FUNCTION =================
    function openModal(cardEl) {
      if (!cardEl) return;
      isModalOpen = true;

      if (window.location.hash !== '#quick-view') {
        window.history.pushState({ modalOpen: true }, '', '#quick-view');
      }

      // 1. Title & Address
      const titleLink = cardEl.querySelector('.card-hotel-link') || cardEl.querySelector('a[href]');
      let rawTitle = cardEl.getAttribute('data-hotel-name') || (titleLink ? titleLink.textContent.trim() : '');
      if (!rawTitle && cardEl.getAttribute('data-title')) {
        rawTitle = cardEl.getAttribute('data-title').split(' ').map(w => w.charAt(0).toUpperCase() + w.slice(1)).join(' ');
      }
      const title = rawTitle || 'Hotel Details';

      const addressSpan = cardEl.querySelector('.card-hotel-address') || cardEl.querySelector('.line-clamp-1');
      const address = cardEl.getAttribute('data-hotel-address') || (addressSpan ? addressSpan.textContent.trim() : 'Gulshan, Dhaka');
      const url = cardEl.getAttribute('data-hotel-url') || (titleLink ? titleLink.getAttribute('href') : '#');
      const stars = parseInt(cardEl.getAttribute('data-stars') || '0', 10);

      // Price Formatting
      const rawPriceStr = cardEl.getAttribute('data-md-price') || cardEl.getAttribute('data-official-price') || 'Contact for Rates';
      const isDollar = rawPriceStr.includes('$');
      const basePriceNum = parseFloat(rawPriceStr.replace(/[^0-9.]/g, '')) || 0;
      const cleanStartingPrice = basePriceNum > 0 
        ? (isDollar ? `$${basePriceNum} / night` : `৳ ${basePriceNum.toLocaleString()} / night`)
        : rawPriceStr;

      // Contacts
      const whatsapp = cardEl.getAttribute('data-whatsapp') || '';
      const phone = cardEl.getAttribute('data-phone') || '';

      titleEl.textContent = title;
      starsEl.textContent = stars > 0 ? '★'.repeat(stars) : '';
      addressEl.textContent = address;
      fullDetailsBtn.href = url;
      priceEl.textContent = cleanStartingPrice;

      // Rating Score
      const numRating = cardEl.getAttribute('data-numeric-rating') || '0';
      if (parseFloat(numRating) > 0) {
        ratingBox.innerHTML = `
          <div class="bg-[#003b95] text-white font-bold text-xs px-2 py-1 rounded-md inline-block shadow-2xs leading-none">
            ${numRating}
          </div>
          <div class="text-[10px] font-bold text-slate-800 mt-0.5">Very Good</div>
        `;
      } else {
        ratingBox.innerHTML = `<span class="bg-slate-100 text-slate-600 text-[10px] font-bold px-2 py-0.5 rounded">New</span>`;
      }

      // ================= 2. DYNAMIC POLICIES WITH CUSTOM SVG SUPPORT =================
      let policiesList = [];
      try {
        policiesList = JSON.parse(cardEl.getAttribute('data-policies') || '[]');
      } catch (e) {
        policiesList = [];
      }

      if (policiesList.length > 0 && policiesSection && policiesGrid) {
        policiesSection.classList.remove('hidden');
        policiesGrid.innerHTML = policiesList.map(item => {
          const iconHtml = item.custom_svg 
            ? `<div class="w-3.5 h-3.5 flex items-center justify-center shrink-0 [&_svg]:w-full [&_svg]:h-full [&_svg]:fill-slate-800">${item.custom_svg}</div>`
            : `<span class="inline-flex shrink-0">${getPolicyIcon(item.label)}</span>`;

          return `
            <div class="flex items-center gap-2.5 p-2 rounded-xl bg-slate-50 border border-slate-200/80">
              <div class="w-8 h-8 rounded-lg bg-white border border-slate-200 flex items-center justify-center shrink-0 shadow-xs">
                ${iconHtml}
              </div>
              <div class="min-w-0">
                <span class="text-slate-500 text-[10px] block font-extrabold uppercase leading-none mb-0.5 truncate">${item.label}</span>
                <span class="font-black text-slate-900 text-xs truncate block">${item.value}</span>
              </div>
            </div>
          `;
        }).join('');
      } else if (policiesSection) {
        policiesSection.classList.add('hidden');
      }

      // Photos
      let imagesList = [];
      try {
        imagesList = JSON.parse(cardEl.getAttribute('data-gallery') || '[]');
      } catch (e) {
        imagesList = [];
      }
      const imgTag = cardEl.querySelector('img');
      if (!imagesList.length && imgTag && imgTag.src) {
        imagesList = [imgTag.src];
      }
      currentImages = imagesList.length > 0 ? imagesList : ['https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&w=800&q=80'];
      showPhoto(0);

      // OTA Channels with Best Deal Badge
      let otaChannels = [];
      try {
        otaChannels = JSON.parse(cardEl.getAttribute('data-booking-channels') || '[]');
      } catch (e) {
        otaChannels = [];
      }

      let minChannelPrice = Infinity;
      otaChannels.forEach(ch => {
        const p = parseFloat(String(ch?.price || '').replace(/[^0-9.]/g, '')) || 0;
        if (p > 0 && p < minChannelPrice) {
          minChannelPrice = p;
        }
      });

      let chHtml = '';

      if (whatsapp && otaChannels.length === 0) {
        const cleanWa = whatsapp.replace(/[^0-9]/g, '');
        const waNum = cleanWa.startsWith('01') ? '88' + cleanWa : cleanWa;
        chHtml += `
          <div class="flex items-center justify-between p-2.5 rounded-xl border border-emerald-200 bg-emerald-50/50">
            <div class="flex items-center gap-2.5">
              ${presetSvgs.whatsapp}
              <div>
                <span class="text-xs font-bold text-emerald-950 block">WhatsApp Booking</span>
                <span class="text-[10px] text-emerald-700 font-semibold">Instant confirmation</span>
              </div>
            </div>
            <a href="https://wa.me/${waNum}?text=${encodeURIComponent('Hi! I want to book a stay at ' + title)}" target="_blank" rel="noopener noreferrer" class="bg-[#25D366] hover:bg-[#1ebd59] text-white text-[11px] font-black px-3.5 py-1.5 rounded-lg shadow-xs transition">
              Chat Now
            </a>
          </div>
        `;
      }

      if (phone && otaChannels.length === 0) {
        const cleanPh = phone.replace(/[^0-9+]/g, '');
        chHtml += `
          <div class="flex items-center justify-between p-2.5 rounded-xl border border-slate-200 bg-slate-50/70">
            <div class="flex items-center gap-2.5">
              ${presetSvgs.phone}
              <div>
                <span class="text-xs font-bold text-slate-900 block">Call Hotel Direct</span>
                <span class="text-[10px] text-slate-500 font-semibold">${phone}</span>
              </div>
            </div>
            <a href="tel:${cleanPh}" class="bg-slate-800 hover:bg-slate-900 text-white text-[11px] font-black px-3.5 py-1.5 rounded-lg shadow-xs transition">
              Call Direct
            </a>
          </div>
        `;
      }

      if (otaChannels.length > 0) {
        otaChannels.forEach(ch => {
          const pName = ch.provider_name || ch.name || 'Booking Partner';
          const pNum = parseFloat(String(ch?.price || '').replace(/[^0-9.]/g, '')) || 0;
          const cleanPrice = pNum > 0 ? (isDollar ? `$${pNum}` : `৳ ${pNum.toLocaleString()}`) : '';

          const isBestDeal = (pNum > 0 && pNum === minChannelPrice);
          let savingsText = '';
          if (basePriceNum > pNum && pNum > 0) {
            const savedAmount = Math.round(basePriceNum - pNum);
            savingsText = isDollar ? `Save $${savedAmount}` : `Save ৳${savedAmount.toLocaleString()}`;
          }

          const pLower = pName.toLowerCase();
          let preset = ch.icon_preset || '';
          if (!preset || preset === 'whatsapp') {
            if (pLower.includes('booking')) preset = 'booking';
            else if (pLower.includes('agoda')) preset = 'agoda';
            else if (pLower.includes('expedia')) preset = 'expedia';
            else if (pLower.includes('whatsapp')) preset = 'whatsapp';
            else if (pLower.includes('call') || pLower.includes('phone')) preset = 'phone';
            else preset = 'direct';
          }

          const icon = ch.custom_svg ? `<div class="w-7 h-7 flex items-center justify-center [&_svg]:w-full [&_svg]:h-full">${ch.custom_svg}</div>` : (presetSvgs[preset] || presetSvgs.direct);
          const btnUrl = ch.button_url || url || '#';

          const cardBorderClass = isBestDeal 
            ? 'border-emerald-300 bg-emerald-50/40 shadow-xs' 
            : 'border-slate-200/80 bg-white hover:bg-slate-50';

          chHtml += `
            <div class="flex items-center justify-between p-2.5 rounded-xl border ${cardBorderClass} transition">
              <div class="flex items-center gap-2.5">
                ${icon}
                <div>
                  <div class="flex items-center gap-1.5">
                    <span class="text-xs font-bold text-slate-900">${pName}</span>
                    ${isBestDeal ? `
                      <span class="inline-flex items-center gap-0.5 text-[9px] font-black text-emerald-800 bg-emerald-100 border border-emerald-300 px-1.5 py-0.2 rounded-full leading-tight">
                        🔥 Best Value${savingsText ? ` • ${savingsText}` : ''}
                      </span>
                    ` : ''}
                  </div>
                  <span class="text-[10px] text-slate-500 block leading-tight">Instant confirmation</span>
                </div>
              </div>

              <div class="flex items-center gap-2.5 sm:gap-3">
                ${cleanPrice ? `
                  <div class="text-right">
                    <span class="text-xs sm:text-sm font-black text-slate-900 block leading-tight">${cleanPrice}</span>
                    <span class="text-[9px] text-slate-400 block leading-none">per night</span>
                  </div>
                ` : ''}
                <a href="${btnUrl}" target="_blank" rel="noopener noreferrer" class="bg-[#e52429] hover:bg-[#c91d22] text-white text-[11px] font-black px-3.5 py-1.5 rounded-lg shadow-xs transition active:scale-95 whitespace-nowrap">
                  ${ch.button_text || 'Book Now ➔'}
                </a>
              </div>
            </div>
          `;
        });
      }

      channelsContainer.innerHTML = chHtml || `
        <div class="p-3 bg-slate-50 border border-slate-200 rounded-xl text-center text-xs text-slate-600 font-medium">
          Click below to view all room rates and contact hotel directly.
        </div>
      `;

      modal.classList.remove('hidden');
      document.body.classList.add('overflow-hidden');
      
      // ডায়ালগ ওপেন এবং স্ক্রল বাটনের অবস্থা চেক
      requestAnimationFrame(() => {
        dialog.classList.remove('scale-95', 'opacity-0');
        dialog.classList.add('scale-100', 'opacity-100');
        if (scrollBody) scrollBody.scrollTop = 0;
        setTimeout(updateScrollCue, 100);
      });
    }

    function hideModalDOM() {
      if (!isModalOpen) return;
      isModalOpen = false;
      dialog.classList.remove('scale-100', 'opacity-100');
      dialog.classList.add('scale-95', 'opacity-0');
      setTimeout(() => {
        modal.classList.add('hidden');
        document.body.classList.remove('overflow-hidden');
      }, 200);
    }

    function closeModal() {
      if (window.location.hash === '#quick-view') {
        window.history.back();
      } else {
        hideModalDOM();
      }
    }

    window.addEventListener('popstate', () => {
      if (isModalOpen) hideModalDOM();
    });

    if (closeBtn) closeBtn.onclick = closeModal;
    modal.onclick = (e) => {
      if (e.target === modal) closeModal();
    };

    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isModalOpen) closeModal();
    });

    // Global Event Delegation
    document.addEventListener('click', (e) => {
      const target = e.target;
      const qvBtn = target?.closest ? target.closest('.open-quick-view-btn') : null;
      if (!qvBtn) return;

      e.preventDefault();
      e.stopPropagation();

      const card = qvBtn.closest('.directory-card-item');
      if (card) openModal(card);
    });
  };

  document.addEventListener('DOMContentLoaded', setupQuickViewSystem);
  document.addEventListener('astro:page-load', setupQuickViewSystem);
  if (document.readyState === 'complete' || document.readyState === 'interactive') {
    setupQuickViewSystem();
  }
</script>
