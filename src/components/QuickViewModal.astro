---
// src/components/QuickViewModal.astro
---

<!-- ১. মোডাল কন্টেইনার -->
<div 
  id="globalQuickViewModal" 
  class="fixed inset-0 z-[10001] bg-slate-950/80 backdrop-blur-sm hidden flex items-center justify-center p-3 sm:p-4 overflow-y-auto"
>
  <div 
    id="quickViewDialog"
    class="bg-white rounded-3xl w-full max-w-xl md:max-w-2xl shadow-2xl my-auto relative flex flex-col max-h-[90vh] transition-all duration-300 scale-95 opacity-0"
  >
    <!-- ক্লোজ বাটন -->
    <button 
      type="button" 
      id="closeQvModalBtn" 
      class="absolute -top-5 left-1/2 -translate-x-1/2 z-[10002] w-10 h-10 rounded-full bg-white text-slate-900 border-2 border-slate-200 shadow-xl flex items-center justify-center cursor-pointer hover:bg-rose-600 hover:text-white transition-all"
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="3"><path d="M6 18L18 6M6 6l12 12" /></svg>
    </button>

    <div class="overflow-y-auto p-4 sm:p-6 space-y-5">
      <!-- ইমেজ -->
      <div class="relative w-full h-52 sm:h-72 rounded-2xl overflow-hidden bg-slate-100">
        <img id="qvModalImg" src="" alt="Hotel" class="w-full h-full object-cover" />
      </div>

      <!-- তথ্য -->
      <div class="flex justify-between items-start">
        <div>
          <h3 id="qvHotelTitle" class="text-xl sm:text-2xl font-black text-slate-900 uppercase">Hotel Name</h3>
          <div id="qvStarsContainer" class="text-amber-500 text-sm"></div>
          <p id="qvAddress" class="text-xs text-slate-500 font-bold mt-1 uppercase">Address</p>
        </div>
        <div id="qvRatingBox"></div>
      </div>

      <!-- প্রাইস -->
      <div class="pt-4 border-t border-slate-100 flex justify-between items-end">
        <div>
          <span class="text-[10px] font-black text-slate-400 uppercase">Starting From</span>
          <p id="qvPrice" class="text-2xl font-black text-[#008234]">৳ 0</p>
        </div>
        <a id="qvFullDetailsBtn" href="#" class="bg-[#006ce4] text-white px-6 py-3 rounded-xl font-bold text-sm hover:bg-[#0057b8] transition">
          Full Details ➔
        </a>
      </div>
    </div>
  </div>
</div>

<script is:inline>
  function setupQuickView() {
    const modal = document.getElementById('globalQuickViewModal');
    const dialog = document.getElementById('quickViewDialog');
    const closeBtn = document.getElementById('closeQvModalBtn');

    if (!modal) return;

    function openModal(card) {
      console.log("Opening Modal for:", card); // চেক করার জন্য

      // ডাটা স্ক্র্যাপ করা (সবচেয়ে সেফ ওয়েতে)
      const title = card.querySelector('h3')?.innerText || "Hotel Details";
      const image = card.querySelector('img')?.src || "";
      const address = card.querySelector('.card-hotel-address')?.innerText || card.querySelector('svg + span')?.innerText || "Gulshan, Dhaka";
      const price = card.querySelector('.text-\\[\\#008234\\]')?.innerText || "Check Rates";
      const stars = card.getAttribute('data-stars') || "3";
      const rating = card.getAttribute('data-numeric-rating') || "5.0";
      const link = card.querySelector('a')?.href || "#";

      // মোডাল ফিল্ড আপডেট
      document.getElementById('qvHotelTitle').innerText = title;
      document.getElementById('qvModalImg').src = image;
      document.getElementById('qvAddress').innerText = address;
      document.getElementById('qvPrice').innerText = price;
      document.getElementById('qvFullDetailsBtn').href = link;
      document.getElementById('qvStarsContainer').innerText = "★".repeat(parseInt(stars));
      
      document.getElementById('qvRatingBox').innerHTML = `
        <div class="bg-[#003580] text-white font-bold px-2 py-1 rounded text-sm">${rating}</div>
      `;

      // শো মোডাল
      modal.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
      setTimeout(() => {
        dialog.classList.remove('scale-95', 'opacity-0');
        dialog.classList.add('scale-100', 'opacity-100');
      }, 10);
    }

    function closeModal() {
      dialog.classList.remove('scale-100', 'opacity-100');
      dialog.classList.add('scale-95', 'opacity-0');
      setTimeout(() => {
        modal.classList.add('hidden');
        document.body.style.overflow = '';
      }, 200);
    }

    // গ্লোবাল ক্লিক হ্যান্ডলার (সবচেয়ে নির্ভরযোগ্য পদ্ধতি)
    document.addEventListener('click', function(e) {
      // চেক করা হচ্ছে ক্লিক করা এলিমেন্ট বা তার প্যারেন্ট 'open-quick-view-btn' কি না
      const btn = e.target.closest('.open-quick-view-btn');
      if (btn) {
        e.preventDefault();
        e.stopPropagation();
        const card = btn.closest('.directory-card-item');
        if (card) {
          openModal(card);
        } else {
          console.error("Could not find parent .directory-card-item");
        }
      }
    });

    if (closeBtn) closeBtn.onclick = closeModal;
    modal.onclick = (e) => { if (e.target === modal) closeModal(); };
  }

  // রান ফাংশন
  setupQuickView();

  // Astro ট্রানজিশন ব্যবহার করলে নিচের লাইনগুলো জরুরি
  document.addEventListener('astro:page-load', setupQuickView);
  document.addEventListener('astro:after-swap', setupQuickView);
</script>
