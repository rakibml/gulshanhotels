---
// src/components/QuickViewModal.astro
---

<!-- ১. মোডাল কন্টেইনার -->
<div 
  id="globalQuickViewModal" 
  role="dialog" 
  aria-modal="true" 
  class="fixed inset-0 z-[10001] bg-slate-950/80 backdrop-blur-sm hidden flex items-center justify-center p-3 sm:p-4 pt-10 sm:pt-12 overflow-y-auto"
>
  <div 
    id="quickViewDialog"
    class="bg-white rounded-2xl sm:rounded-3xl border border-slate-200/90 w-full max-w-xl md:max-w-2xl shadow-2xl my-auto relative text-left flex flex-col max-h-[90vh] transition-all duration-300 scale-95 opacity-0 overflow-visible"
  >
    <!-- ২. ক্লোজ বাটন (Top Center) -->
    <button 
      type="button" 
      id="closeQvModalBtn" 
      class="absolute -top-6 left-1/2 -translate-x-1/2 z-[10002] w-12 h-12 rounded-full bg-white text-slate-900 hover:bg-rose-600 hover:text-white border-2 border-slate-200 shadow-2xl flex items-center justify-center transition-all cursor-pointer hover:scale-110 active:scale-95"
    >
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
        <path d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>

    <!-- ৩. বডি সেকশন -->
    <div class="overflow-y-auto flex-1 p-4 sm:p-6 space-y-5">
      
      <!-- ইমেজ প্রিভিউ -->
      <div class="relative w-full h-52 sm:h-72 rounded-2xl overflow-hidden bg-slate-100 shadow-inner">
        <img id="qvModalImg" src="" alt="Hotel" class="w-full h-full object-cover" />
        <span id="qvImgBadge" class="absolute bottom-3 right-4 bg-black/70 backdrop-blur-md text-white text-[10px] font-black px-2.5 py-1 rounded-full border border-white/20">
          Preview Image
        </span>
      </div>

      <!-- টাইটেল ও ইনফো -->
      <div class="flex items-start justify-between gap-4">
        <div class="space-y-1">
          <h3 id="qvHotelTitle" class="text-xl sm:text-2xl font-black text-slate-900 leading-tight uppercase tracking-tight">Hotel Title</h3>
          <div id="qvStarsContainer" class="text-amber-500 text-sm"></div>
          <div class="flex items-center gap-1.5 text-xs text-slate-500 font-bold mt-2">
            <svg class="w-3.5 h-3.5 fill-slate-400" viewBox="0 0 24 24"><path d="M12 2C8.1 2 5 5.1 5 9c0 5.2 7 13 7 13s7-7.8 7-13c0-3.9-3.1-7-7-7zm0 9.5c-1.4 0-2.5-1.1-2.5-2.5s1.1-2.5 2.5-2.5 2.5 1.1 2.5 2.5-1.1 2.5-2.5 2.5z"/></svg>
            <span id="qvAddress">Address Loading...</span>
          </div>
        </div>
        <div id="qvRatingBox" class="shrink-0 text-right"></div>
      </div>

      <!-- ফেসিলিটিজ (অটো-জেনারেটেড) -->
      <div class="pt-4 border-t border-slate-100">
        <span class="text-[11px] font-black uppercase text-slate-400 tracking-widest block mb-3">Hotel Amenities</span>
        <div id="qvAmenitiesGrid" class="grid grid-cols-2 sm:grid-cols-3 gap-2">
            <!-- জাভাস্ক্রিপ্ট দিয়ে এখানে ডেটা বসবে -->
        </div>
      </div>

      <!-- বুকিং অপশন -->
      <div class="pt-4 border-t border-slate-100">
        <div class="flex items-center justify-between mb-2">
          <span class="text-xs font-black text-slate-900 uppercase">Live Rate</span>
          <div class="text-right">
            <span id="qvPrice" class="text-2xl font-black text-[#008234]">৳ 0</span>
            <span class="text-[10px] text-slate-400 font-bold block">per night</span>
          </div>
        </div>
      </div>

    </div>

    <!-- ৪. ফুটার বাটন -->
    <div class="p-4 bg-slate-50 border-t border-slate-200 rounded-b-3xl">
      <a id="qvFullDetailsBtn" href="#" class="w-full bg-[#006ce4] hover:bg-[#0057b8] text-white font-bold text-sm py-4 rounded-xl transition flex items-center justify-center gap-2 shadow-lg active:scale-95">
        Check Availability & Full Details ➔
      </a>
    </div>

  </div>
</div>

<script is:inline>
  function initQuickView() {
    const modal = document.getElementById('globalQuickViewModal');
    const dialog = document.getElementById('quickViewDialog');
    const closeBtn = document.getElementById('closeQvModalBtn');

    if (!modal || !dialog) return;

    // মেইন ফাংশন: কার্ড থেকে ডেটা স্ক্র্যাপ (Scrape) করা
    function openQuickView(cardEl) {
      // ১. কার্ডের ভেতর থেকে সব তথ্য খুঁজে বের করা
      const title = cardEl.querySelector('h3')?.innerText || "Hotel Details";
      const image = cardEl.querySelector('img')?.src || "";
      const address = cardEl.querySelector('[class*="location"], [class*="address"]')?.innerText || cardEl.querySelector('svg + span')?.innerText || "Gulshan, Dhaka";
      
      // গ্রিন প্রাইসটি খুঁজে বের করা
      const price = cardEl.querySelector('.text-[#008234]')?.innerText || "Contact for Rates";
      
      // রেটিং (data-numeric-rating অ্যাট্রিবিউট থেকে, যা ফিল্টারে ছিল)
      const rating = cardEl.getAttribute('data-numeric-rating') || "5.0";
      const stars = cardEl.getAttribute('data-stars') || "3";
      
      // লিংক খুঁজে বের করা
      const link = cardEl.querySelector('a')?.href || "#";

      // ২. মোডালে ডেটা বসানো
      document.getElementById('qvHotelTitle').innerText = title;
      document.getElementById('qvModalImg').src = image;
      document.getElementById('qvAddress').innerText = address;
      document.getElementById('qvPrice').innerText = price;
      document.getElementById('qvStarsContainer').innerText = "★".repeat(parseInt(stars));
      document.getElementById('qvFullDetailsBtn').href = link;

      // রেটিং বক্স আপডেট
      const ratingBox = document.getElementById('qvRatingBox');
      ratingBox.innerHTML = `
        <div class="bg-[#003580] text-white font-black text-sm px-2 py-1 rounded-lg inline-block">${rating}</div>
        <div class="text-[10px] font-bold text-slate-800 mt-1">Rating</div>
      `;

      // অ্যামেনিটিস (কার্ডে যদি থাকে তবে নিবে, নাহলে ডিফল্ট দেখাবে)
      const amenitiesGrid = document.getElementById('qvAmenitiesGrid');
      let amenities = ['Free Wi-Fi', 'Swimming Pool', 'Air Conditioned', 'Restaurant', 'Gym', 'Parking'];
      
      // কার্ডে যদি স্পেশাল কোন লিস্ট থাকে তা নেওয়ার চেষ্টা করবে
      const foundAmenities = Array.from(cardEl.querySelectorAll('.amenity-tag, .card-amenity')).map(el => el.innerText);
      if (foundAmenities.length > 0) amenities = foundAmenities;

      amenitiesGrid.innerHTML = amenities.slice(0, 6).map(item => `
        <div class="flex items-center gap-2 p-2 rounded-xl bg-slate-50 border border-slate-100 text-[10px] font-bold text-slate-600">
          <svg class="w-3 h-3 text-emerald-600" fill="currentColor" viewBox="0 0 24 24"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
          <span class="truncate">${item}</span>
        </div>
      `).join('');

      // ৩. মোডাল শো করা
      modal.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
      setTimeout(() => {
        dialog.classList.remove('scale-95', 'opacity-0');
        dialog.classList.add('scale-100', 'opacity-100');
      }, 10);

      // ব্যাক বাটন ফিক্স
      window.history.pushState({ modalOpen: true }, '', '#view');
    }

    const closeModal = () => {
      dialog.classList.remove('scale-100', 'opacity-100');
      dialog.classList.add('scale-95', 'opacity-0');
      setTimeout(() => {
        modal.classList.add('hidden');
        document.body.style.overflow = '';
      }, 200);
      if (window.location.hash === '#view') window.history.back();
    };

    // ইভেন্ট লিসেনার: "View Hotel" বাটনে ক্লিক করলে
    document.addEventListener('click', (e) => {
      const btn = e.target.closest('.open-quick-view-btn');
      if (btn) {
        e.preventDefault();
        const card = btn.closest('.directory-card-item');
        if (card) openQuickView(card);
      }
    });

    closeBtn.onclick = closeModal;
    modal.onclick = (e) => { if (e.target === modal) closeModal(); };
    window.addEventListener('popstate', () => { if (!modal.classList.contains('hidden')) closeModal(); });
  }

  // ইনিশিয়ালাইজেশন
  initQuickView();
  document.addEventListener('astro:after-swap', initQuickView);
  document.addEventListener('astro:page-load', initQuickView);
</script>
