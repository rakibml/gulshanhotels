---
// src/components/QuickViewModal.astro (Bulletproof Click Listener, Instant Modal)
---

<!-- QUICK VIEW GLOBAL MODAL OVERLAY -->
<div 
  id="globalQuickViewModal" 
  role="dialog" 
  aria-modal="true" 
  class="fixed inset-0 z-50 bg-slate-950/80 backdrop-blur-sm hidden flex items-center justify-center p-3 sm:p-4 md:p-6 overflow-y-auto"
>
  <!-- MODAL DIALOG CONTAINER -->
  <div 
    id="quickViewDialog"
    class="bg-white rounded-2xl sm:rounded-3xl border border-slate-200/90 w-full max-w-xl md:max-w-2xl shadow-2xl overflow-hidden my-auto relative text-left flex flex-col max-h-[92vh] transition-all duration-300 scale-95 opacity-0"
  >
    <!-- HIGHLIGHTED EYE-CATCHING CLOSE BUTTON -->
    <button 
      type="button" 
      id="closeQvModalBtn" 
      class="absolute top-3 right-3 z-30 w-9 h-9 sm:w-10 sm:h-10 rounded-full bg-white text-slate-800 hover:bg-rose-50 hover:text-rose-600 border border-slate-200 shadow-xl flex items-center justify-center transition cursor-pointer hover:scale-110 active:scale-95"
      aria-label="Close Quick View"
    >
      <svg class="w-4 h-4 sm:w-5 sm:h-5 stroke-current" fill="none" viewBox="0 0 24 24" stroke-width="2.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>

    <!-- SCROLLABLE BODY -->
    <div class="overflow-y-auto flex-1 p-4 sm:p-6 space-y-4 sm:space-y-5">
      
      <!-- ================= 1. 5-IMAGE CAROUSEL SLIDER ================= -->
      <div class="relative w-full h-52 sm:h-64 rounded-xl sm:rounded-2xl overflow-hidden bg-slate-900 shrink-0 shadow-inner group">
        <img 
          id="qvModalImg" 
          src="" 
          alt="Hotel Preview" 
          class="w-full h-full object-cover transition duration-300"
        />

        <!-- Prev / Next Controls -->
        <button 
          type="button" 
          id="qvPrevImgBtn" 
          class="absolute left-2.5 top-1/2 -translate-y-1/2 w-8 h-8 rounded-full bg-slate-950/70 hover:bg-slate-950 text-white text-sm font-black flex items-center justify-center backdrop-blur-md transition cursor-pointer shadow opacity-90 hover:scale-105"
          aria-label="Previous Photo"
        >
          ❮
        </button>
        <button 
          type="button" 
          id="qvNextImgBtn" 
          class="absolute right-2.5 top-1/2 -translate-y-1/2 w-8 h-8 rounded-full bg-slate-950/70 hover:bg-slate-950 text-white text-sm font-black flex items-center justify-center backdrop-blur-md transition cursor-pointer shadow opacity-90 hover:scale-105"
          aria-label="Next Photo"
        >
          ❯
        </button>

        <!-- 1/5 Photo Badge -->
        <span 
          id="qvImgBadge" 
          class="absolute bottom-2.5 right-3 bg-slate-950/80 backdrop-blur-md text-white text-[10px] font-extrabold px-2.5 py-0.5 rounded-full border border-white/20 tracking-wider pointer-events-none"
        >
          1 / 1
        </span>
      </div>

      <!-- ================= 2. HOTEL NAME & RATING ================= -->
      <div class="space-y-1">
        <div class="flex items-start justify-between gap-3">
          <div>
            <h3 id="qvHotelTitle" class="text-lg sm:text-2xl font-black text-slate-900 leading-tight">
              Hotel Title
            </h3>
            <div id="qvStarsContainer" class="text-[#febb02] text-xs sm:text-sm tracking-tight mt-0.5"></div>
          </div>

          <!-- Rating Score Badge -->
          <div id="qvRatingBox" class="shrink-0 text-right"></div>
        </div>

        <!-- Location -->
        <div class="flex items-start gap-1.5 text-xs text-slate-600 font-medium pt-1">
          <svg class="w-3.5 h-3.5 fill-slate-700 shrink-0 mt-0.5" viewBox="0 0 24 24"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>
          <span id="qvAddress" class="leading-snug">Address</span>
        </div>
      </div>

      <!-- ================= 3. KEY AMENITIES & HIGHLIGHTS ================= -->
      <div id="qvAmenitiesSection" class="pt-2 border-t border-slate-100 space-y-2">
        <span class="text-[11px] font-black uppercase text-slate-400 tracking-wider block">
          Key Facilities & Highlights
        </span>
        <div id="qvAmenitiesGrid" class="grid grid-cols-2 sm:grid-cols-3 gap-2"></div>
      </div>

      <!-- ================= 4. PRICING & BOOKING CHANNELS ================= -->
      <div class="pt-2 border-t border-slate-100 space-y-3">
        <div class="flex items-center justify-between">
          <span class="text-xs sm:text-sm font-black text-slate-900">Where can you book this hotel?</span>
          <div class="text-right">
            <span class="text-[10px] text-slate-400 uppercase font-bold block leading-none">Starting from</span>
            <span id="qvPrice" class="text-base sm:text-lg font-black text-[#008234]">৳ 0</span>
          </div>
        </div>

        <!-- Channels & Direct Contacts (WhatsApp/Call/Agoda/Booking) -->
        <div id="qvChannelsContainer" class="space-y-2"></div>
      </div>

    </div>

    <!-- ================= 5. VIEW FULL DETAILS FOOTER BUTTON ================= -->
    <div class="p-3.5 sm:p-4 bg-slate-50 border-t border-slate-200/80 shrink-0">
      <a 
        id="qvFullDetailsBtn" 
        href="#" 
        class="w-full bg-[#006ce4] hover:bg-[#0057b8] text-white font-bold text-xs sm:text-sm py-2.5 sm:py-3 px-4 rounded-xl transition flex items-center justify-center gap-2 shadow-xs hover:shadow text-center"
      >
        <span>View Full Hotel Details & Photos</span>
        <span class="text-base font-bold">➔</span>
      </a>
    </div>

  </div>
</div>

<!-- CLIENT JAVASCRIPT WITH GLOBAL CLICK EVENT DELEGATION -->
<script is:inline>
  const setupQuickViewSystem = () => {
    const modal = document.getElementById('globalQuickViewModal');
    const dialog = document.getElementById('quickViewDialog');
    const closeBtn = document.getElementById('closeQvModalBtn');

    if (!modal || !dialog) return;

    // UI Elements
    const imgEl = document.getElementById('qvModalImg');
    const prevBtn = document.getElementById('qvPrevImgBtn');
    const nextBtn = document.getElementById('qvNextImgBtn');
    const badgeEl = document.getElementById('qvImgBadge');
    
    const titleEl = document.getElementById('qvHotelTitle');
    const starsEl = document.getElementById('qvStarsContainer');
    const ratingBox = document.getElementById('qvRatingBox');
    const addressEl = document.getElementById('qvAddress');
    const amenitiesSection = document.getElementById('qvAmenitiesSection');
    const amenitiesGrid = document.getElementById('qvAmenitiesGrid');
    const priceEl = document.getElementById('qvPrice');
    const channelsContainer = document.getElementById('qvChannelsContainer');
    const fullDetailsBtn = document.getElementById('qvFullDetailsBtn');

    let currentImages = [];
    let currentImgIdx = 0;
    let isModalOpen = false;

    // Vector SVGs
    const iconSvgs = {
      pool: `<svg class="w-4 h-4 fill-emerald-600 shrink-0" viewBox="0 0 24 24"><path d="M22 17c-1.1 0-2 .12-.3-3-.83-.88.53-1.9.83-3 .83s-2.12-.3-3-.83c-.88.53-1.9.83-3 .83s-2.12-.3-3-.83c-.88.53-1.9.83-3 .83v-2c.67 0 1.3-.19 1.83-.53.88-.53 1.9-.83 3-.83s2.12.3 3 .83c.88.53 1.9.83 3 .83s2.12-.3 3-.83c-.88-.53 1.9-.83 3-.83s2.12.3 3 .83c.53.34 1.16.53 1.83.53v2zM15 7.5a2.5 2.5 0 1 0-5 0 2.5 2.5 0 0 0 5 0z"/></svg>`,
      gym: `<svg class="w-4 h-4 fill-emerald-600 shrink-0" viewBox="0 0 24 24"><path d="M20.57 14.86L22 13.43 20.57 12 17 15.57 8.43 7 12 3.43 10.57 2 9.14 3.43 7.71 2 6.29 3.43 7.71 4.86 3.43 9.14 2 7.71 0.57 0.57 9.14 2 10.57 0.57 12 2 13.43 3.43 12 12 20.57 15.57 17 17 18.43 18.43 17 17 15.57 20.57 12z"/></svg>`,
      wifi: `<svg class="w-4 h-4 fill-emerald-600 shrink-0" viewBox="0 0 24 24"><path d="M12 3C7.95 3 4.21 4.34 1.2 6.6L3 8.8C5.46 6.81 8.58 5.7 12 5.7c3.42 0 6.54 1.11 9 3.1l1.8-2.2C19.79 4.34 16.05 3 12 3zm0 5c-2.92 0-5.61.96-7.8 2.58l1.8 2.22C7.62 11.53 9.71 10.7 12 10.7c2.29 0 4.38.83 6 2.1l1.8-2.22C17.61 8.96 14.92 8 12 8zm0 5c-1.87 0-3.58.62-4.98 1.67L12 21l4.98-6.33C15.58 13.62 13.87 13 12 13z"/></svg>`,
      restaurant: `<svg class="w-4 h-4 fill-emerald-600 shrink-0" viewBox="0 0 24 24"><path d="M11 9H9V2H7v7H5V2H3v7c0 2.12 1.55 3.87 3.56 4.17L6 22h2l-.56-8.83C9.45 12.87 11 11.12 11 9zm9-7h-2c-1.1 0-2 .9-2 2v7h2v13h2V2z"/></svg>`,
      parking: `<svg class="w-4 h-4 fill-emerald-600 shrink-0" viewBox="0 0 24 24"><path d="M13.2 11H10V7h3.2c1.1 0 2 .9-2 2s-.9 2-2 2zM19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-5.8 10H10v4H8V5h5.2c2.2 0 4 1.8 4 4s-1.8 4-4 4z"/></svg>`,
      checkmark: `<svg class="w-4 h-4 fill-emerald-600 shrink-0" viewBox="0 0 24 24"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>`
    };

    const presetSvgs = {
      agoda: `<div class="w-7 h-7 rounded-lg bg-[#1d3557] text-white font-black text-[9px] flex items-center justify-center shrink-0 tracking-tighter"><span class="text-rose-400 font-serif italic text-xs">a</span>goda</div>`,
      booking: `<div class="w-7 h-7 rounded-lg bg-[#003580] text-white font-black text-[10px] flex items-center justify-center shrink-0 shadow-xs">B.</div>`,
      expedia: `<div class="w-7 h-7 rounded-lg bg-[#ffe600] text-slate-950 font-black text-xs flex items-center justify-center shrink-0"><svg class="w-3.5 h-3.5 fill-slate-950" viewBox="0 0 24 24"><path d="M21 16v-2l-8-5V3.5c0-.83-.67-1.5-1.5-1.5S10 2.67 10 3.5V9l-8 5v2l8-2.5V19l-2 1.5V22l3.5-1 3.5 1v-1.5L13 19v-5.5l8 2.5z"/></svg></div>`,
      direct: `<div class="w-7 h-7 rounded-lg bg-emerald-100 text-emerald-900 flex items-center justify-center shrink-0"><svg class="w-3.5 h-3.5 fill-emerald-800" viewBox="0 0 24 24"><path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-7 3c1.66 0 3 1.34 3 3s-1.34 3-3 3-3-1.34-3-3 1.34-3 3-3zm3 10H9v-1c0-1 2-1.9 3-1.9s3 .9 3 1.9v1z"/></svg></div>`,
      whatsapp: `<div class="w-7 h-7 rounded-lg bg-[#25D366] text-white flex items-center justify-center shrink-0 shadow-xs"><svg class="w-3.5 h-3.5 fill-white" viewBox="0 0 24 24"><path d="M12.012 2c-5.506 0-9.989 4.478-9.99 9.984 0 1.763.459 3.48 1.332 5.001l-1.416 5.163 5.281-1.388c1.464.798 3.118 1.22 4.79 1.22h.004c5.506 0 9.989-4.478 9.99-9.984 0-2.668-1.038-5.176-2.923-7.062a9.923 9.923 0 0 0-7.058-2.934z"/></svg></div>`,
      phone: `<div class="w-7 h-7 rounded-lg bg-slate-800 text-white flex items-center justify-center shrink-0"><svg class="w-3.5 h-3.5 fill-white" viewBox="0 0 24 24"><path d="M6.62 10.79c1.44 2.83 2.62 4.2 5.45 5.64l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/></svg></div>`
    };

    function showPhoto(idx) {
      if (!currentImages.length) return;
      currentImgIdx = (idx + currentImages.length) % currentImages.length;
      imgEl.src = currentImages[currentImgIdx];
      badgeEl.textContent = `${currentImgIdx + 1} / ${currentImages.length}`;
    }

    if (prevBtn) prevBtn.onclick = () => showPhoto(currentImgIdx - 1);
    if (nextBtn) nextBtn.onclick = () => showPhoto(currentImgIdx + 1);

    // OPEN MODAL FUNCTION
    function openModal(data, cardEl) {
      if (!data) return;
      isModalOpen = true;

      if (window.location.hash !== '#quick-view') {
        window.history.pushState({ modalOpen: true }, '', '#quick-view');
      }

      titleEl.textContent = data.title || 'Hotel Details';
      starsEl.textContent = data.stars > 0 ? '★'.repeat(data.stars) : '';
      addressEl.textContent = data.address || 'Gulshan, Dhaka';
      fullDetailsBtn.href = data.url || '#';
      priceEl.textContent = data.price || 'Contact for Rates';

      // RATING BADGE
      if (data.rating) {
        ratingBox.innerHTML = `
          <div class="bg-[#003b95] text-white font-bold text-xs px-2 py-1 rounded-md inline-block shadow-2xs leading-none">
            ${data.rating}
          </div>
          <div class="text-[10px] font-bold text-slate-800 mt-0.5">${data.ratingLabel || 'Very Good'}</div>
        `;
      } else {
        ratingBox.innerHTML = `<span class="bg-slate-100 text-slate-600 text-[10px] font-bold px-2 py-0.5 rounded">New</span>`;
      }

      // CAROUSEL IMAGES
      currentImages = Array.isArray(data.images) && data.images.length > 0 ? data.images : ['https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&w=800&q=80'];
      showPhoto(0);

      // AMENITIES READ (From Card Dataset)
      let parsedAmenities = [];
      try {
        const rawAttr = cardEl ? cardEl.getAttribute('data-amenities') : '[]';
        parsedAmenities = JSON.parse(rawAttr || '[]');
      } catch(e) {
        parsedAmenities = [];
      }

      if (!parsedAmenities || parsedAmenities.length === 0) {
        parsedAmenities = ['Free Wi-Fi', 'Air Conditioning', '24/7 Power', 'Room Service', 'Security'];
      }

      const top6 = parsedAmenities.slice(0, 6);
      amenitiesSection.classList.remove('hidden');
      amenitiesGrid.innerHTML = top6.map(item => {
        const nameStr = typeof item === 'string' ? item : (item?.name || 'Amenity');
        const aLower = nameStr.toLowerCase();
        let icon = iconSvgs.checkmark;
        if (aLower.includes('pool')) icon = iconSvgs.pool;
        else if (aLower.includes('gym') || aLower.includes('fitness')) icon = iconSvgs.gym;
        else if (aLower.includes('wifi') || aLower.includes('wi-fi')) icon = iconSvgs.wifi;
        else if (aLower.includes('restaurant') || aLower.includes('breakfast') || aLower.includes('dining')) icon = iconSvgs.restaurant;
        else if (aLower.includes('park')) icon = iconSvgs.parking;

        return `
          <div class="flex items-center gap-2 p-2 rounded-xl bg-slate-50 border border-slate-100 text-xs font-semibold text-slate-800">
            ${icon}
            <span class="truncate">${nameStr}</span>
          </div>
        `;
      }).join('');

      // BOOKING CHANNELS
      let channelsHtml = '';

      if (data.whatsapp) {
        const cleanWa = data.whatsapp.replace(/[^0-9]/g, '');
        const waNum = cleanWa.startsWith('01') ? '88' + cleanWa : cleanWa;
        channelsHtml += `
          <div class="flex items-center justify-between p-2.5 rounded-xl border border-emerald-200 bg-emerald-50/50">
            <div class="flex items-center gap-2.5">
              ${presetSvgs.whatsapp}
              <div>
                <span class="text-xs font-bold text-emerald-950 block">WhatsApp Booking</span>
                <span class="text-[10px] text-emerald-700 font-semibold">Instant confirmation</span>
              </div>
            </div>
            <a href="https://wa.me/${waNum}?text=${encodeURIComponent('Hi! I want to book a stay at ' + data.title)}" target="_blank" rel="noopener noreferrer" class="bg-[#25D366] hover:bg-[#1ebd59] text-white text-[11px] font-black px-3.5 py-1.5 rounded-lg shadow-xs transition">
              Chat Now
            </a>
          </div>
        `;
      }

      if (data.phone) {
        const cleanPh = data.phone.replace(/[^0-9+]/g, '');
        channelsHtml += `
          <div class="flex items-center justify-between p-2.5 rounded-xl border border-slate-200 bg-slate-50/70">
            <div class="flex items-center gap-2.5">
              ${presetSvgs.phone}
              <div>
                <span class="text-xs font-bold text-slate-900 block">Call Hotel Direct</span>
                <span class="text-[10px] text-slate-500 font-semibold">${data.phone}</span>
              </div>
            </div>
            <a href="tel:${cleanPh}" class="bg-slate-800 hover:bg-slate-900 text-white text-[11px] font-black px-3.5 py-1.5 rounded-lg shadow-xs transition">
              Call Direct
            </a>
          </div>
        `;
      }

      if (Array.isArray(data.channels) && data.channels.length > 0) {
        data.channels.forEach(ch => {
          const pName = ch.provider_name || 'Booking Partner';
          const pPrice = ch.price ? (ch.price.startsWith('$') || ch.price.startsWith('৳') ? ch.price : '$' + ch.price) : '';
          
          const pLower = pName.toLowerCase();
          let preset = ch.icon_preset || '';
          if (!preset || preset === 'whatsapp') {
            if (pLower.includes('booking')) preset = 'booking';
            else if (pLower.includes('agoda')) preset = 'agoda';
            else if (pLower.includes('expedia')) preset = 'expedia';
            else if (pLower.includes('whatsapp')) preset = 'whatsapp';
            else if (pLower.includes('call') || pLower.includes('phone')) preset = 'phone';
            else preset = 'direct';
          }

          const icon = ch.custom_svg ? `<div class="w-7 h-7 flex items-center justify-center [&_svg]:w-full [&_svg]:h-full">${ch.custom_svg}</div>` : (presetSvgs[preset] || presetSvgs.direct);
          const btnUrl = ch.button_url || data.url || '#';

          channelsHtml += `
            <div class="flex items-center justify-between p-2.5 rounded-xl border border-slate-200/80 bg-white hover:bg-slate-50 transition">
              <div class="flex items-center gap-2.5">
                ${icon}
                <span class="text-xs font-bold text-slate-900">${pName}</span>
              </div>
              <div class="flex items-center gap-3">
                ${pPrice ? `<span class="text-xs sm:text-sm font-black text-slate-900">${pPrice}</span>` : ''}
                <a href="${btnUrl}" target="_blank" rel="noopener noreferrer" class="bg-[#e52429] hover:bg-[#c91d22] text-white text-[11px] font-black px-3.5 py-1.5 rounded-lg shadow-xs transition">
                  ${ch.button_text || 'Book Now'}
                </a>
              </div>
            </div>
          `;
        });
      }

      channelsContainer.innerHTML = channelsHtml || `<div class="p-3 bg-slate-50 border border-slate-200 rounded-xl text-center text-xs text-slate-600 font-medium">Please click below to view complete rates and contact info.</div>`;

      modal.classList.remove('hidden');
      document.body.classList.add('overflow-hidden');
      requestAnimationFrame(() => {
        dialog.classList.remove('scale-95', 'opacity-0');
        dialog.classList.add('scale-100', 'opacity-100');
      });
    }

    // CLOSE MODAL
    function hideModalDOM() {
      if (!isModalOpen) return;
      isModalOpen = false;
      dialog.classList.remove('scale-100', 'opacity-100');
      dialog.classList.add('scale-95', 'opacity-0');
      setTimeout(() => {
        modal.classList.add('hidden');
        document.body.classList.remove('overflow-hidden');
      }, 200);
    }

    function closeModal() {
      if (window.location.hash === '#quick-view') {
        window.history.back();
      } else {
        hideModalDOM();
      }
    }

    window.addEventListener('popstate', () => {
      if (isModalOpen) hideModalDOM();
    });

    if (closeBtn) closeBtn.onclick = closeModal;
    modal.onclick = (e) => {
      if (e.target === modal) closeModal();
    };

    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isModalOpen) closeModal();
    });

    // ================= GLOBAL EVENT DELEGATION (GUARANTEED CLICK WORK) =================
    // বাটন বা বাটনের ভেতরে থাকা আইকন/লেখা যেখানেই ক্লিক পড়ুক, এটা সাথে সাথে কাজ করবে!
    document.addEventListener('click', (e) => {
      const qvBtn = e.target.closest('.open-quick-view-btn');
      if (!qvBtn) return;

      e.preventDefault();
      e.stopPropagation();

      const card = qvBtn.closest('.directory-card-item');
      if (!card) return;

      // নতুন ও পুরোনো উভয় ধরনের ডেটা সিলেক্টর সাপোর্ট
      const payloadEl = card.querySelector('.hotel-quickview-data, .hotel-quickview-json');
      let data = null;

      if (payloadEl) {
        const raw = payloadEl.getAttribute('data-payload') || payloadEl.textContent || '{}';
        try {
          data = JSON.parse(raw);
        } catch (err) {
          data = null;
        }
      }

      // যদি কোনো কারণে পে-লোড নাও পায়, কার্ডের DOM থেকেই সরাসরি ব্যাকআপ ডাটা তৈরি করে নিবে!
      if (!data) {
        const titleLink = card.querySelector('a');
        const imgTag = card.querySelector('img');
        data = {
          title: titleLink ? titleLink.textContent.trim() : 'Hotel Details',
          address: card.getAttribute('data-area') || 'Gulshan, Dhaka',
          price: card.querySelector('.text-emerald-700, .text-\\[\\#008234\\]')?.textContent?.trim() || 'Contact for Rates',
          images: imgTag && imgTag.src ? [imgTag.src] : [],
          url: titleLink ? titleLink.getAttribute('href') : '#'
        };
      }

      openModal(data, card);
    });
  };

  document.addEventListener('DOMContentLoaded', setupQuickViewSystem);
  document.addEventListener('astro:page-load', setupQuickViewSystem);
  // Fail-safe immediate run
  if (document.readyState === 'complete' || document.readyState === 'interactive') {
    setupQuickViewSystem();
  }
</script>
