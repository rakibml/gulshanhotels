---
// src/components/QuickViewModal.astro
---

<div 
  id="globalQuickViewModal" 
  class="fixed inset-0 z-[10001] bg-slate-950/80 backdrop-blur-sm hidden flex items-center justify-center p-3 sm:p-4 overflow-y-auto"
>
  <div 
    id="quickViewDialog"
    class="bg-white rounded-[32px] w-full max-w-xl md:max-w-2xl shadow-2xl my-auto relative flex flex-col max-h-[92vh] transition-all duration-300 scale-95 opacity-0 overflow-hidden"
  >
    <!-- TOP-CENTER CLOSE BUTTON -->
    <button 
      type="button" 
      id="closeQvModalBtn" 
      class="absolute -top-5 left-1/2 -translate-x-1/2 z-[10002] w-12 h-12 rounded-full bg-white text-slate-900 border-2 border-slate-200 shadow-2xl flex items-center justify-center cursor-pointer hover:bg-rose-600 hover:text-white transition-all"
    >
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5"><path d="M6 18L18 6M6 6l12 12" /></svg>
    </button>

    <div class="overflow-y-auto flex-1 p-0">
      
      <!-- 1. IMAGE CAROUSEL SECTION -->
      <div class="relative w-full h-64 sm:h-80 bg-slate-100 overflow-hidden group">
        <img id="qvModalImg" src="" alt="Hotel" class="w-full h-full object-cover transition-all duration-500" />
        
        <!-- Navigation Arrows -->
        <button id="qvPrevImg" class="absolute left-4 top-1/2 -translate-y-1/2 w-10 h-10 rounded-full bg-black/30 hover:bg-black/60 text-white backdrop-blur-md flex items-center justify-center transition-all opacity-0 group-hover:opacity-100 cursor-pointer">❮</button>
        <button id="qvNextImg" class="absolute right-4 top-1/2 -translate-y-1/2 w-10 h-10 rounded-full bg-black/30 hover:bg-black/60 text-white backdrop-blur-md flex items-center justify-center transition-all opacity-0 group-hover:opacity-100 cursor-pointer">❯</button>
        
        <!-- Image Badge -->
        <div class="absolute bottom-4 right-6 bg-black/60 backdrop-blur-md text-white text-[10px] font-black px-3 py-1 rounded-full border border-white/20 uppercase tracking-widest">
            <span id="qvImgIdx">1</span> / <span id="qvTotalImg">1</span> Photos
        </div>
      </div>

      <div class="p-5 sm:p-8 space-y-6">
        
        <!-- 2. HEADER INFO -->
        <div class="flex justify-between items-start gap-4">
          <div class="space-y-1.5">
            <h3 id="qvHotelTitle" class="text-2xl sm:text-3xl font-black text-slate-900 leading-tight uppercase tracking-tight">Hotel Name</h3>
            <div id="qvStarsContainer" class="text-amber-500 text-sm flex gap-0.5"></div>
            <div class="flex items-start gap-1.5 text-[11px] text-slate-500 font-bold uppercase tracking-wider pt-1">
              <svg class="w-4 h-4 text-slate-400 shrink-0" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2C8.1 2 5 5.1 5 9c0 5.2 7 13 7 13s7-7.8 7-13c0-3.9-3.1-7-7-7z"/></svg>
              <span id="qvAddress" class="leading-relaxed">Address Loading...</span>
            </div>
          </div>
          <div id="qvRatingBox" class="shrink-0 text-center">
             <!-- Rating Badge Here -->
          </div>
        </div>

        <!-- 3. KEY FACILITIES GRID -->
        <div class="space-y-3">
          <span class="text-[11px] font-black uppercase text-slate-400 tracking-[0.2em] block">Key Facilities</span>
          <div id="qvAmenitiesGrid" class="grid grid-cols-2 sm:grid-cols-3 gap-2.5">
              <!-- Amenities Tags Here -->
          </div>
        </div>

        <!-- 4. DIRECT BOOKING CHANNELS (The Professional Part) -->
        <div class="space-y-3 pt-2">
          <span class="text-[11px] font-black uppercase text-slate-400 tracking-[0.2em] block">Direct Booking Options</span>
          <div id="qvBookingChannels" class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <!-- WhatsApp and Call Buttons Here -->
          </div>
        </div>

      </div>
    </div>

    <!-- 5. FIXED FOOTER ACTION -->
    <div class="p-5 bg-slate-50 border-t border-slate-100 flex items-center justify-between gap-4 rounded-b-[32px]">
      <div>
        <span class="text-[10px] font-black text-slate-400 uppercase tracking-widest block mb-1">Starting From</span>
        <p id="qvPrice" class="text-2xl font-black text-[#008234] leading-none">৳ 0</p>
      </div>
      <a id="qvFullDetailsBtn" href="#" class="bg-[#006ce4] hover:bg-[#0057b8] text-white px-8 py-4 rounded-2xl font-black text-sm transition-all shadow-xl shadow-blue-100 active:scale-95 flex items-center gap-2">
        Full Details <span>➔</span>
      </a>
    </div>

  </div>
</div>

<script is:inline>
  function setupQuickView() {
    const modal = document.getElementById('globalQuickViewModal');
    const dialog = document.getElementById('quickViewDialog');
    const closeBtn = document.getElementById('closeQvModalBtn');

    if (!modal) return;

    let gallery = [];
    let currentIdx = 0;

    function updateImage() {
        const img = document.getElementById('qvModalImg');
        img.src = gallery[currentIdx];
        document.getElementById('qvImgIdx').innerText = currentIdx + 1;
        document.getElementById('qvTotalImg').innerText = gallery.length;
    }

    function openModal(card) {
      // Data Scraper
      const title = card.querySelector('h3')?.innerText || "Hotel Details";
      const mainImg = card.querySelector('img')?.src || "";
      const address = card.querySelector('.p-5 div span.truncate')?.innerText || "Gulshan, Dhaka";
      
      // Smart Price Scraper
      let price = "Check Rates";
      card.querySelectorAll('span').forEach(s => {
          if ((s.innerText.includes('৳') || s.innerText.includes('$')) && s.innerText.length < 15) price = s.innerText;
      });

      // Gallery Logic (Try to find more images from card if available, else use main)
      gallery = [mainImg]; 
      // If you have data-gallery attribute on card, use it
      const rawGallery = card.getAttribute('data-gallery');
      if(rawGallery) {
          try { gallery = JSON.parse(rawGallery); } catch(e) {}
      }

      const stars = parseInt(card.getAttribute('data-stars') || "3");
      const rating = card.getAttribute('data-numeric-rating') || "5.0";
      const link = card.querySelector('a')?.href || "#";
      const whatsapp = card.getAttribute('data-whatsapp') || "8801700000000";
      const phone = card.getAttribute('data-phone') || "01700000000";

      // UI Populate
      document.getElementById('qvHotelTitle').innerText = title;
      document.getElementById('qvAddress').innerText = address;
      document.getElementById('qvPrice').innerText = price;
      document.getElementById('qvFullDetailsBtn').href = link;
      document.getElementById('qvStarsContainer').innerHTML = "★".repeat(stars);
      
      document.getElementById('qvRatingBox').innerHTML = `
        <div class="bg-[#003580] text-white font-black px-3 py-1.5 rounded-xl text-lg shadow-lg leading-none">${rating}</div>
        <p class="text-[9px] font-black uppercase text-slate-400 mt-1">Score</p>
      `;

      // Amenities Logic (Filter out garbage)
      const foundAmenities = Array.from(card.querySelectorAll('.p-5 span')).map(el => el.innerText.trim()).filter(t => t.length > 3 && t.length < 20 && isNaN(t.split('.')[0]));
      const grid = document.getElementById('qvAmenitiesGrid');
      grid.innerHTML = foundAmenities.slice(0, 6).map(text => `
        <div class="flex items-center gap-2 p-2.5 rounded-xl bg-slate-50 border border-slate-100 text-[10px] font-black text-slate-600 uppercase tracking-tight">
          <div class="w-1.5 h-1.5 rounded-full bg-emerald-500"></div>
          <span class="truncate">${text}</span>
        </div>
      `).join('');

      // Booking Channels Logic
      const bookingArea = document.getElementById('qvBookingChannels');
      bookingArea.innerHTML = `
        <a href="https://wa.me/${whatsapp.replace(/\D/g,'')}" target="_blank" class="flex items-center justify-between p-3 rounded-2xl bg-[#25D366]/10 border border-[#25D366]/20 hover:bg-[#25D366]/20 transition-all group">
            <span class="text-xs font-black text-[#128C7E] uppercase">WhatsApp</span>
            <div class="w-8 h-8 rounded-full bg-[#25D366] flex items-center justify-center text-white shadow-lg">
                <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M12.012 2c-5.506 0-9.989 4.478-9.99 9.984 0 1.763.459 3.48 1.332 5.001l-1.416 5.163 5.281-1.388c1.464.798 3.118 1.22 4.79 1.22h.004c5.506 0 9.989-4.478 9.99-9.984 0-2.668-1.038-5.176-2.923-7.062a9.923 9.923 0 0 0-7.058-2.934z"/></svg>
            </div>
        </a>
        <a href="tel:${phone}" class="flex items-center justify-between p-3 rounded-2xl bg-slate-100 border border-slate-200 hover:bg-slate-200 transition-all group">
            <span class="text-xs font-black text-slate-800 uppercase">Call Hotel</span>
            <div class="w-8 h-8 rounded-full bg-slate-800 flex items-center justify-center text-white shadow-lg">
                <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M6.62 10.79c1.44 2.83 2.62 4.2 5.45 5.64l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/></svg>
            </div>
        </a>
      `;

      currentIdx = 0;
      updateImage();

      // Show
      modal.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
      setTimeout(() => {
        dialog.classList.remove('scale-95', 'opacity-0');
        dialog.classList.add('scale-100', 'opacity-100');
      }, 10);
    }

    function closeModal() {
      dialog.classList.remove('scale-100', 'opacity-100');
      dialog.classList.add('scale-95', 'opacity-0');
      setTimeout(() => {
        modal.classList.add('hidden');
        document.body.style.overflow = '';
      }, 200);
    }

    // Image Nav
    document.getElementById('qvNextImg').onclick = (e) => { e.stopPropagation(); currentIdx = (currentIdx + 1) % gallery.length; updateImage(); };
    document.getElementById('qvPrevImg').onclick = (e) => { e.stopPropagation(); currentIdx = (currentIdx - 1 + gallery.length) % gallery.length; updateImage(); };

    document.addEventListener('click', (e) => {
      const btn = e.target.closest('.open-quick-view-btn');
      if (btn) { e.preventDefault(); const card = btn.closest('.directory-card-item'); if (card) openModal(card); }
    });

    closeBtn.onclick = closeModal;
    modal.onclick = (e) => { if (e.target === modal) closeModal(); };
  }

  setupQuickView();
  document.addEventListener('astro:page-load', setupQuickView);
  document.addEventListener('astro:after-swap', setupQuickView);
</script>
