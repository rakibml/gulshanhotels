---
// src/components/Header.astro
import Logo from './Logo.astro';

interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;
---

<header id="main-header" class="fixed top-0 left-0 right-0 z-40 transition-transform duration-300 ease-in-out px-4 sm:px-8 pt-3 pb-2">
  <!-- Micro Top Pill (Quick Zones indicator) -->
  <div class="max-w-[1440px] mx-auto hidden lg:flex items-center justify-between text-[11px] font-medium text-stone-500 px-4 pb-2">
    <div class="flex items-center gap-4">
      <span class="flex items-center gap-1.5"><span class="w-1.5 h-1.5 rounded-full bg-emerald-600"></span> Diplomatic Zone Hotel Index</span>
      <span>•</span>
      <span>Gulshan 1 & 2 • Banani • Baridhara</span>
    </div>
    <div class="flex items-center gap-3 text-stone-600">
      <a href="/#hotels" class="hover:text-[#071910] transition">US Embassy Area Stays</a>
      <span>/</span>
      <a href="/about" class="hover:text-[#071910] transition">Concierge Support</a>
    </div>
  </div>

  <!-- Floating Island Navbar -->
  <div class="max-w-[1440px] mx-auto bg-white/90 backdrop-blur-md border border-stone-200/90 shadow-[0_8px_30px_rgb(0,0,0,0.06)] rounded-2xl px-5 py-3 flex items-center justify-between">
    
    <!-- Logo -->
    <a href="/" aria-label="GulshanHotels Home" class="flex items-center">
      <Logo uid="hd" size={38} />
    </a>

    <!-- Center Nav links -->
    <nav class="hidden md:flex items-center gap-7 text-xs font-bold text-stone-700 tracking-wide uppercase">
      <a href="/#hotels" class="hover:text-emerald-800 transition">Hotels</a>
      <a href="/#hotels" class="hover:text-emerald-800 transition">Gulshan 1</a>
      <a href="/#hotels" class="hover:text-emerald-800 transition">Gulshan 2</a>
      <a href="/#hotels" class="hover:text-emerald-800 transition">Banani</a>
      <a href="/about" class="hover:text-emerald-800 transition">About</a>
    </nav>

    <!-- Right Actions: Wishlist + CTA -->
    <div class="flex items-center gap-3">
      <!-- Shortlist Button -->
      <button 
        id="wishlist-btn" 
        class="relative p-2.5 rounded-xl hover:bg-stone-100 text-stone-700 transition cursor-pointer"
        aria-label="View Favorites"
      >
        <svg class="w-5 h-5 fill-none stroke-current stroke-2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
        </svg>
        <span id="wishlist-count" class="hidden absolute -top-1 -right-1 bg-rose-500 text-white text-[10px] font-black w-4 h-4 rounded-full flex items-center justify-center">0</span>
      </button>

      <!-- Explore Button -->
      <a href="/#hotels" class="hidden sm:inline-block bg-[#071910] hover:bg-emerald-900 text-white font-bold text-xs uppercase tracking-wider px-5 py-2.5 rounded-xl transition shadow-sm active:scale-95">
        Explore Stays
      </a>

      <!-- Mobile Menu Toggle Button -->
      <button id="mobile-menu-btn" class="md:hidden p-2 text-stone-800" aria-label="Open Navigation">
        <svg class="w-6 h-6 stroke-current" fill="none" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
      </button>
    </div>
  </div>

  <!-- Mobile Dropdown -->
  <div id="mobile-menu" class="hidden md:hidden max-w-[1440px] mx-auto mt-2 bg-white border border-stone-200 rounded-2xl p-5 shadow-xl space-y-3 text-xs font-bold uppercase tracking-wider text-stone-800">
    <a href="/#hotels" class="block py-2 border-b border-stone-100 hover:text-emerald-800">All Gulshan Hotels</a>
    <a href="/#hotels" class="block py-2 border-b border-stone-100 hover:text-emerald-800">Gulshan 1 Circle</a>
    <a href="/#hotels" class="block py-2 border-b border-stone-100 hover:text-emerald-800">Gulshan 2 Diplomatic</a>
    <a href="/#hotels" class="block py-2 border-b border-stone-100 hover:text-emerald-800">Banani 11 Luxury</a>
    <a href="/about" class="block py-2 hover:text-emerald-800">About & Contact</a>
  </div>
</header>
